  7783                                  ; ==================================================================
  7784                                  ;  RTL8139 NIC driver + base network stack (Milestone B)
  7785                                  ;  Polled, no IRQs. Inbound frames land in a DMA RX ring; the shell
  7786                                  ;  loop calls netpoll to drain and dispatch them (ARP / IPv4 / ICMP /
  7787                                  ;  UDP-DNS). Outbound frames are built in nic_tx_buf and pushed out
  7788                                  ;  TSAD0/TSD0 by nic_send_raw. Static IP config lives in nic_ip /
  7789                                  ;  nic_mask / nic_gw / nic_dns (defaults are the QEMU slirp values).
  7790                                  ;  All register discipline: every function in this section saves and
  7791                                  ;  restores every register it uses, so the polling loops (bounce /
  7792                                  ;  monitor / dns) can hold state in r12/r13/r14/r15 across calls.
  7793                                  ; ==================================================================
  7794                                  NIC_VENDOR_ID   equ 0x10EC
  7795                                  NIC_DEVICE_ID   equ 0x8139
  7796                                  NIC_PCI_CMD     equ 0x04
  7797                                  NIC_PCI_BAR0    equ 0x10
  7798                                  
  7799                                  NIC_IO_IDR0     equ 0x00
  7800                                  NIC_IO_TSD0     equ 0x10
  7801                                  NIC_IO_TSAD0    equ 0x20
  7802                                  NIC_IO_RBSTART  equ 0x30
  7803                                  NIC_IO_CBR      equ 0x34
  7804                                  NIC_IO_CAPR     equ 0x38
  7805                                  NIC_IO_CMD      equ 0x37
  7806                                  NIC_IO_IMR      equ 0x3C
  7807                                  NIC_IO_ISR      equ 0x3E
  7808                                  NIC_IO_TCR      equ 0x40
  7809                                  NIC_IO_RCR      equ 0x44
  7810                                  NIC_IO_CFG1     equ 0x52
  7811                                  
  7812                                  NIC_RX_RING_SIZE equ 0x2000        ; 8KB ring (fits the boot budget)
  7813                                  NIC_RX_RING_MASK equ 0x1FFF
  7814                                  NIC_TX_BUF_SIZE  equ 0x800         ; 2KB frame build/DMA buffer
  7815                                  ETH_TYPE_ARP_W   equ 0x0608        ; "08 06" as a little-endian memory word
  7816                                  ETH_TYPE_IP_W    equ 0x0008        ; "08 00" as a little-endian memory word
  7817                                  IP_PROTO_ICMP    equ 0x01
  7818                                  IP_PROTO_TCP     equ 0x06
  7819                                  IP_PROTO_UDP     equ 0x11
