 14969 0000BB60 4831D2                      xor rdx, rdx
 14970 0000BB63 4D31C0                      xor r8, r8
 14971 0000BB66 8A1E                        mov bl, [rsi]
 14972 0000BB68 80FB2D                      cmp bl, '-'
 14973 0000BB6B 7508                        jne .pi_loop
 14974 0000BB6D BA01000000                  mov rdx, 1
 14975 0000BB72 48FFC6                      inc rsi
 14976                                  .pi_loop:
 14977 0000BB75 8A1E                        mov bl, [rsi]
 14978 0000BB77 80FB00                      cmp bl, 0
 14979 0000BB7A 7421                        je .pi_end
 14980 0000BB7C 80FB30                      cmp bl, '0'
 14981 0000BB7F 722F                        jb .pi_bad
 14982 0000BB81 80FB39                      cmp bl, '9'
 14983 0000BB84 772A                        ja .pi_bad
 14984 0000BB86 486BC00A                    imul rax, rax, 10
 14985 0000BB8A 4C0FB6CB                    movzx r9, bl
 14986 0000BB8E 4983E930                    sub r9, '0'
 14987 0000BB92 4C01C8                      add rax, r9
 14988 0000BB95 49FFC0                      inc r8
 14989 0000BB98 48FFC6                      inc rsi
 14990 0000BB9B EBD8                        jmp .pi_loop
 14991                                  .pi_end:
 14992 0000BB9D 4983F800                    cmp r8, 0
 14993 0000BBA1 740D                        je .pi_bad
 14994 0000BBA3 4883FA01                    cmp rdx, 1
 14995 0000BBA7 7503                        jne .pi_ok
 14996 0000BBA9 48F7D8                      neg rax
 14997                                  .pi_ok:
 14998 0000BBAC B101                        mov cl, 1
 14999 0000BBAE EB05                        jmp .pi_out
 15000                                  .pi_bad:
 15001 0000BBB0 4831C0                      xor rax, rax
 15002 0000BBB3 B100                        mov cl, 0
 15003                                  .pi_out:
 15004 0000BBB5 4159                        pop r9
 15005 0000BBB7 4158                        pop r8
 15006 0000BBB9 5A                          pop rdx
 15007 0000BBBA 5B                          pop rbx
 15008 0000BBBB C3                          ret
