   163                                      .shell_loop:
   164 000000A9 E8D3610000                      call print_prompt
   165                                      
   166 000000AE 48BF-                           mov rdi, line_buf
   166 000000B0 [E0B8010000000000] 
   167 000000B8 B9DB000000                      mov rcx, LINE_MAX-1
   168 000000BD E8F4670000                      call read_line
   169                                      
   170                                          ; skip $ comments (lines starting with $)
   171 000000C2 803C25[E0B80100]24              cmp byte [line_buf], '$'
   172 000000CA 74DD                            je .shell_loop
   173                                  
   174                                          ; "ali <name> <commands>" defines an alias. This has to be
   175                                          ; intercepted here, before ; chaining/tokenizing get anywhere
   176                                          ; near the line, so that a body like "calc 5 + 5 ~ = a ; show a"
   177                                          ; is stored verbatim instead of being split on ; or ~ right now.
   178 000000CC E8AF3D0000                      call try_handle_ali_line
   179 000000D1 3C01                            cmp al, 1
   180 000000D3 74D4                            je .shell_loop
   181                                      
   182                                          ; process ;-chained commands (tokenize + dispatch each segment)
   183 000000D5 E802000000                      call process_chain
   184 000000DA EBCD                            jmp .shell_loop
   185                                  
   186                                  ; ------------------------------------------------------------
   187                                  ; process_chain: splits line_buf on ; (respecting double quotes),
   188                                  ; copies each segment to line_buf, then tokenizes and dispatches.
   189                                  ; This lets users write: show hello ; show world
   190                                  process_chain:
   191 000000DC 53                          push rbx
   192 000000DD 4154                        push r12
   193 000000DF 4155                        push r13
   194 000000E1 4156                        push r14
   195 000000E3 4157                        push r15
   196                                  
   197 000000E5 C60425[F8BB0100]00          mov byte [chain_is_rr], 0
   198                                  
