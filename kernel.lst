  3735                              <1> ; ------------------------------------------------------------
  3736                              <1> ; party_parse_call: parses a function call. In: r13 = '(' following
  3737                              <1> ; the function-name token (name text already in party_ident_buf).
  3738                              <1> ; Evaluates args (pushing each), checks arity, invokes the function,
  3739                              <1> ; and leaves the result value on the value stack with r13 just past
  3740                              <1> ; the closing ')'. Clobbers rax, rbx, r8-r14.
  3741                              <1> ; ------------------------------------------------------------
  3742                              <1> party_parse_call:
  3743 00028BE9 803C25[01B30200]00  <1>     cmp byte [party_exec_ok], 0
  3744 00028BF1 0F84FF000000        <1>     je .out
  3745 00028BF7 4154                <1>     push r12
  3746 00028BF9 4156                <1>     push r14
  3747 00028BFB 4157                <1>     push r15
  3748 00028BFD 56                  <1>     push rsi
  3749 00028BFE 57                  <1>     push rdi
  3750 00028BFF 51                  <1>     push rcx
  3751 00028C00 50                  <1>     push rax
  3752 00028C01 488D3425[0FB30200]  <1>     lea rsi, [party_ident_buf]
  3753 00028C09 488D3C25[37B30200]  <1>     lea rdi, [party_call_name_buf]
  3754 00028C11 E893F1FFFF          <1>     call party_strcpy_save
  3755 00028C16 58                  <1>     pop rax
  3756 00028C17 59                  <1>     pop rcx
  3757 00028C18 5F                  <1>     pop rdi
  3758 00028C19 5E                  <1>     pop rsi
  3759                              <1>     ; party_call_name_buf is a single global, but an argument can itself
  3760                              <1>     ; be a call (e.g. randseed(time())) - parsing it below recurses into
  3761                              <1>     ; party_parse_call, which overwrites party_call_name_buf with the
  3762                              <1>     ; nested call's name before we get a chance to dispatch on ours.
  3763                              <1>     ; Stash our own name in a private stack copy now, and restore it
  3764                              <1>     ; from there right before dispatch (past .ppc_args_done) so a
  3765                              <1>     ; clobber from any nested call in our argument list can't leak into
  3766                              <1>     ; our own lookup.
  3767 00028C1A 4883EC28            <1>     sub rsp, PARTY_IDENT_MAX
  3768 00028C1E 488D3425[37B30200]  <1>     lea rsi, [party_call_name_buf]
  3769 00028C26 4889E7              <1>     mov rdi, rsp
  3770 00028C29 B928000000          <1>     mov rcx, PARTY_IDENT_MAX
  3771 00028C2E F3A4                <1>     rep movsb
  3772 00028C30 49FFC5              <1>     inc r13                        ; past '('
  3773 00028C33 4D31F6              <1>     xor r14, r14                   ; arg count
  3774                              <1> .ppc_arg_loop:
  3775 00028C36 E8001F0000          <1>     call party_tok_ptr
  3776 00028C3B 0FB603              <1>     movzx eax, byte [rbx]
  3777 00028C3E 83F812              <1>     cmp eax, TOK_RPAREN
  3778 00028C41 7435                <1>     je .ppc_args_done
  3779 00028C43 E8A2F7FFFF          <1>     call party_parse_expr
  3780 00028C48 803C25[01B30200]01  <1>     cmp byte [party_exec_ok], 1
  3781 00028C50 0F8596000000        <1>     jne .ppc_out
  3782 00028C56 49FFC6              <1>     inc r14
  3783 00028C59 E8DD1E0000          <1>     call party_tok_ptr
  3784 00028C5E 0FB603              <1>     movzx eax, byte [rbx]
  3785 00028C61 83F81E              <1>     cmp eax, TOK_COMMA
  3786 00028C64 7505                <1>     jne .ppc_expect_rparen
  3787 00028C66 49FFC5              <1>     inc r13
  3788 00028C69 EBCB                <1>     jmp .ppc_arg_loop
  3789                              <1> .ppc_expect_rparen:
  3790 00028C6B E8CB1E0000          <1>     call party_tok_ptr
  3791 00028C70 0FB603              <1>     movzx eax, byte [rbx]
  3792 00028C73 83F812              <1>     cmp eax, TOK_RPAREN
  3793 00028C76 7549                <1>     jne .ppc_err_rparen
  3794                              <1> .ppc_args_done:
  3795 00028C78 49FFC5              <1>     inc r13                        ; past ')'
  3796                              <1>     ; Restore our own name from the private stack copy - argument
  3797                              <1>     ; parsing above may have recursed into party_parse_call for a
  3798                              <1>     ; nested call and left party_call_name_buf holding *its* name
  3799                              <1>     ; instead of ours.
  3800 00028C7B 488D3C25[37B30200]  <1>     lea rdi, [party_call_name_buf]
  3801 00028C83 4889E6              <1>     mov rsi, rsp
  3802 00028C86 B928000000          <1>     mov rcx, PARTY_IDENT_MAX
  3803 00028C8B F3A4                <1>     rep movsb
  3804                              <1>     ; Builtins (fopen/fread/fwrite/fclose/fexists/fdelete - Phase 3)
  3805                              <1>     ; are checked before user-defined functions, so a script can't
  3806                              <1>     ; shadow them. party_call_builtin clobbers r8-r13 on a match (see
  3807                              <1>     ; its header comment), so r13 - the token cursor, which must
  3808                              <1>     ; survive past this call either way - is saved/restored around it.
  3809 00028C8D 4155                <1>     push r13
  3810 00028C8F E863000000          <1>     call party_call_builtin
  3811 00028C94 415D                <1>     pop r13
  3812 00028C96 3C01                <1>     cmp al, 1
  3813 00028C98 7452                <1>     je .ppc_out                    ; builtin handled everything (result
  3814                              <1>                                     ; pushed, or exec_ok cleared on error)
  3815 00028C9A 488D3425[37B30200]  <1>     lea rsi, [party_call_name_buf]
  3816 00028CA2 E8601C0000          <1>     call party_func_find
  3817 00028CA7 4983FFFF            <1>     cmp r15, -1
  3818 00028CAB 7423                <1>     je .ppc_err_nofunc
  3819 00028CAD 410FB687[98500300]  <1>     movzx eax, byte [party_func_nparams+r15]
  3820 00028CB5 4439F0              <1>     cmp eax, r14d
  3821 00028CB8 7525                <1>     jne .ppc_err_arity
  3822 00028CBA E8831C0000          <1>     call party_invoke_func
  3823 00028CBF EB2B                <1>     jmp .ppc_out
  3824                              <1> .ppc_err_rparen:
  3825 00028CC1 488D3425[FC220300]  <1>     lea rsi, [msg_party_rparen]
  3826 00028CC9 E8A4F0FFFF          <1>     call party_set_err
  3827 00028CCE EB1C                <1>     jmp .ppc_out
  3828                              <1> .ppc_err_nofunc:
  3829 00028CD0 488D3425[23230300]  <1>     lea rsi, [msg_party_undef_func]
  3830 00028CD8 E895F0FFFF          <1>     call party_set_err
  3831 00028CDD EB0D                <1>     jmp .ppc_out
  3832                              <1> .ppc_err_arity:
  3833 00028CDF 488D3425[34230300]  <1>     lea rsi, [msg_party_arg_count]
  3834 00028CE7 E886F0FFFF          <1>     call party_set_err
  3835                              <1> .ppc_out:
  3836 00028CEC 4883C428            <1>     add rsp, PARTY_IDENT_MAX
  3837 00028CF0 415F                <1>     pop r15
  3838 00028CF2 415E                <1>     pop r14
  3839 00028CF4 415C                <1>     pop r12
