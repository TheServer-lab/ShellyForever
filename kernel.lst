 12475 00009A06 486BDB02                    imul rbx, rbx, 2              ; column -> byte offset
 12476 00009A0A 488DBB00800B00              lea rdi, [VGA_BASE + rbx]
 12477 00009A11 488D3425[A3AD0100]          lea rsi, [wig_str_buf]
