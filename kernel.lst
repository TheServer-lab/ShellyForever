  4773                                  ; ------------------------------------------------------------
  4774                                  ; cmd_mount: attach a formatted drive to the filesystem tree.
  4775                                  ;   mount <label>
  4776                                  ; Loads the volume whose superblock label matches <label>, remaps its
  4777                                  ; node table into a free mount slice, and roots it as /<label>/ under
  4778                                  ; /home. Then 'cf <label>' (or 'cf /<label>') enters it.
  4779                                  cmd_mount:
  4780 000145BD 803C25[B8E60600]00          cmp byte [arg1_buf], 0
