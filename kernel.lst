   403                              <1> ; ============================================================
   404                              <1> ;  HMAC-SHA256
   405                              <1> ;  hmac_sha256: rdi = key ptr, rcx = key len, rsi = msg ptr,
   406                              <1> ;               rdx = msg len, r8 = 32-byte output ptr
   407                              <1> ; ============================================================
   408                              <1> hmac_sha256:
   409 0003897D 50                  <1>     push rax
   410 0003897E 53                  <1>     push rbx
   411 0003897F 51                  <1>     push rcx
   412 00038980 52                  <1>     push rdx
   413 00038981 56                  <1>     push rsi
   414 00038982 57                  <1>     push rdi
   415 00038983 4150                <1>     push r8
   416 00038985 4151                <1>     push r9
   417 00038987 4154                <1>     push r12
   418 00038989 4155                <1>     push r13
   419 0003898B 4156                <1>     push r14
   420 0003898D 4157                <1>     push r15
   421                              <1> 
   422 0003898F 4989FC              <1>     mov r12, rdi                  ; key ptr
   423 00038992 4989CD              <1>     mov r13, rcx                  ; key len
   424 00038995 4989F6              <1>     mov r14, rsi                  ; msg ptr
   425 00038998 4989D7              <1>     mov r15, rdx                  ; msg len
   426 0003899B 4C89C3              <1>     mov rbx, r8                   ; out ptr
