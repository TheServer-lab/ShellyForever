 18920 00098684 00000000                rtl_tx_idx:      dd 0             ; next TX descriptor slot to use
 18921 00098688 00000000                nic_hwver_raw:   dd 0             ; raw TxConfig value captured right after
 18922                                                                     ; reset, before our own TCR write - used
 18923                                                                     ; to identify the exact chip revision
 18924 0009868C 00                      nic_tx_wait_start:   db 0         ; CMOS seconds value when the current TX
 18925                                                                     ; wait began (nic_send_raw_rtl8168)
 18926 0009868D 00                      nic_tx_wait_elapsed: db 0         ; real wall-clock seconds actually spent
 18927                                                                     ; waiting before the last TX failure was
 18928                                                                     ; declared - objective proof of whether the
 18929                                                                     ; wait budget genuinely ran out or something
 18930                                                                     ; failed fast, instead of guessing from
 18931                                                                     ; how long a failure "felt" on screen
 18932 0009868E 00                      nic_tx_wait_end:     db 0         ; raw rtc_sec_now() reading at the moment
 18933                                                                     ; .rtks_err fires - printed alongside
 18934                                                                     ; nic_tx_wait_start so a bad elapsed
 18935                                                                     ; computation can be told apart from a
 18936                                                                     ; genuinely-fast failure, instead of
 18937                                                                     ; trusting the subtracted value alone
 18938 0009868F 00                      nic_tx_wait_ticks:   db 0         ; number of real second-boundary ticks
 18939                                                                     ; actually observed by the wait loop
 18940                                                                     ; before giving up (should be ~budget+1
 18941                                                                     ; on a real timeout; a low number here
 18942                                                                     ; means the loop exited some other way)
 18943                                  
 18944                                  ; rtl_dev_ids: PCI device ids (vendor 0x10EC) pci_find_rtl8168 matches
 18945                                  ; against - the RTL8169-compatible C+ descriptor interface shared by the
 18946                                  ; common real-hardware gigabit Realtek chips. Deliberately doesn't include
 18947                                  ; the 2.5GbE RTL8125, which uses a different descriptor/register layout.
 18948                                  rtl_dev_ids:
 18949 00098690 6881698161813681            dw 0x8168, 0x8169, 0x8161, 0x8136
 18950                                  RTL_DEV_ID_COUNT equ ($ - rtl_dev_ids) / 2
