  1666                              <1> ; ============================================================
  1667                              <1> ;  Poly1305 one-time MAC (RFC 8439 section 2.5)
  1668                              <1> ;  Ported from poly1305.asm (standalone scratch, verified against RFC
  1669                              <1> ;  8439 2.5.2 -- see phases.txt Phase 2). Uses a 3x64-bit-limb (192-bit
  1670                              <1> ;  capacity) bignum rather than the classic 5x26-bit-limb scheme, and
  1671                              <1> ;  does the per-block "acc = (acc+n)*r mod p" step via MSB->LSB binary
  1672                              <1> ;  double-and-add modmul (see the original scratch file's header for
  1673                              <1> ;  the full reasoning -- unchanged here).
  1674                              <1> ;
  1675                              <1> ;  poly_sub_p_cond / poly_double_mod / poly_add_mod / poly_mulmod_r are
  1676                              <1> ;  internal, register-passed helpers (same pattern as sha256_compress
  1677                              <1> ;  in this file: r12-r15 carry pointer state across calls instead of
  1678                              <1> ;  the stack, and each documents its own clobber list rather than
  1679                              <1> ;  saving everything -- their callers already account for this).
  1680                              <1> ;  poly1305_mac itself, the public entry point, now saves/restores
  1681                              <1> ;  every register it touches, per this file's convention -- the
  1682                              <1> ;  scratch version only saved rbx/rbp/r12-r15, not the rax/rcx/rdx/
  1683                              <1> ;  rsi/rdi/r8/r9/r10 it also uses internally.
  1684                              <1> ;
  1685                              <1> ;  p = 2^130 - 5, as 3 little-endian 64-bit limbs.
  1686                              <1> ; ============================================================
  1687                              <1> 
  1688                              <1> POLY_P0 equ 0xFFFFFFFFFFFFFFFB
  1689                              <1> POLY_P1 equ 0xFFFFFFFFFFFFFFFF
  1690                              <1> POLY_P2 equ 0x0000000000000003
  1691                              <1> 
  1692                              <1> ; ---- poly_sub_p_cond: X_ptr in r14. If X>=p, X-=p; else unchanged.
  1693                              <1> ; Clobbers rax,rbx,rcx. Preserves r14. ----
  1694                              <1> poly_sub_p_cond:
  1695 00039961 498B06              <1>     mov rax, [r14+0]
  1696 00039964 498B5E08            <1>     mov rbx, [r14+8]
  1697 00039968 498B4E10            <1>     mov rcx, [r14+16]
  1698 0003996C 4883E8FB            <1>     sub rax, POLY_P0
  1699 00039970 4883DBFF            <1>     sbb rbx, POLY_P1
  1700 00039974 4883D903            <1>     sbb rcx, POLY_P2
  1701 00039978 720B                <1>     jc .skip                 ; borrow => X was < p, leave X unchanged
  1702 0003997A 498906              <1>     mov [r14+0], rax
  1703 0003997D 49895E08            <1>     mov [r14+8], rbx
  1704 00039981 49894E10            <1>     mov [r14+16], rcx
  1705                              <1> .skip:
  1706 00039985 C3                  <1>     ret
  1707                              <1> 
  1708                              <1> ; ---- poly_double_mod: X_ptr in r14. X = (X*2) mod p. Clobbers
  1709                              <1> ; rax,rbx,rcx (via poly_sub_p_cond). ----
  1710                              <1> poly_double_mod:
  1711 00039986 498B06              <1>     mov rax, [r14+0]
  1712 00039989 498B5E08            <1>     mov rbx, [r14+8]
  1713 0003998D 498B4E10            <1>     mov rcx, [r14+16]
  1714 00039991 48D1E0              <1>     shl rax, 1
  1715 00039994 48D1D3              <1>     rcl rbx, 1
  1716 00039997 48D1D1              <1>     rcl rcx, 1
  1717 0003999A 498906              <1>     mov [r14+0], rax
  1718 0003999D 49895E08            <1>     mov [r14+8], rbx
  1719 000399A1 49894E10            <1>     mov [r14+16], rcx
  1720 000399A5 E8B7FFFFFF          <1>     call poly_sub_p_cond
  1721 000399AA C3                  <1>     ret
  1722                              <1> 
  1723                              <1> ; ---- poly_add_mod: X_ptr in r14, A_ptr in r13. X = (X+A) mod p.
  1724                              <1> ; Clobbers rax,rbx,rcx. ----
  1725                              <1> poly_add_mod:
  1726 000399AB 498B06              <1>     mov rax, [r14+0]
  1727 000399AE 498B5E08            <1>     mov rbx, [r14+8]
  1728 000399B2 498B4E10            <1>     mov rcx, [r14+16]
  1729 000399B6 49034500            <1>     add rax, [r13+0]
  1730 000399BA 49135D08            <1>     adc rbx, [r13+8]
  1731 000399BE 49134D10            <1>     adc rcx, [r13+16]
  1732 000399C2 498906              <1>     mov [r14+0], rax
  1733 000399C5 49895E08            <1>     mov [r14+8], rbx
  1734 000399C9 49894E10            <1>     mov [r14+16], rcx
  1735 000399CD E88FFFFFFF          <1>     call poly_sub_p_cond
  1736 000399D2 C3                  <1>     ret
  1737                              <1> 
  1738                              <1> ; ---- poly_mulmod_r: acc_ptr in r15 (in/out), r_ptr in r12 (in, limb2
  1739                              <1> ; assumed 0, since clamped r < 2^124). acc = (acc * r) mod p, via
  1740                              <1> ; MSB->LSB binary double-and-add over r's 128 low bits. Saves/restores
  1741                              <1> ; everything it touches (rbx,r8-r15) since it's called from
  1742                              <1> ; poly1305_mac's block loop with live state around it. ----
  1743                              <1> poly_mulmod_r:
  1744 000399D3 53                  <1>     push rbx
  1745 000399D4 4150                <1>     push r8
  1746 000399D6 4151                <1>     push r9
  1747 000399D8 4152                <1>     push r10
  1748 000399DA 4153                <1>     push r11
  1749 000399DC 4154                <1>     push r12
  1750 000399DE 4155                <1>     push r13
  1751 000399E0 4156                <1>     push r14
  1752 000399E2 4157                <1>     push r15
  1753                              <1> 
  1754 000399E4 4883EC30            <1>     sub rsp, 48               ; [rsp+0..23]=A, [rsp+24..47]=X
  1755 000399E8 4C8D2C24            <1>     lea r13, [rsp]             ; A ptr
  1756 000399EC 4C8D742418          <1>     lea r14, [rsp+24]          ; X ptr
  1757                              <1> 
  1758                              <1>     ; A = copy of acc
  1759 000399F1 498B07              <1>     mov rax, [r15+0]
  1760 000399F4 49894500            <1>     mov [r13+0], rax
  1761 000399F8 498B4708            <1>     mov rax, [r15+8]
  1762 000399FC 49894508            <1>     mov [r13+8], rax
  1763 00039A00 498B4710            <1>     mov rax, [r15+16]
  1764 00039A04 49894510            <1>     mov [r13+16], rax
  1765                              <1> 
  1766                              <1>     ; X = 0
  1767 00039A08 49C70600000000      <1>     mov qword [r14+0], 0
  1768 00039A0F 49C7460800000000    <1>     mov qword [r14+8], 0
  1769 00039A17 49C7461000000000    <1>     mov qword [r14+16], 0
  1770                              <1> 
  1771                              <1>     ; whi:wlo = r's 128 bits
  1772 00039A1F 4D8B542408          <1>     mov r10, [r12+8]           ; whi
  1773 00039A24 4D8B1C24            <1>     mov r11, [r12+0]           ; wlo
  1774                              <1> 
  1775 00039A28 41B980000000        <1>     mov r9, 128                ; bit counter
  1776                              <1> .bitloop:
  1777 00039A2E E853FFFFFF          <1>     call poly_double_mod        ; X = 2X mod p  (uses r14)
  1778 00039A33 490FBAE23F          <1>     bt r10, 63
  1779 00039A38 7305                <1>     jnc .no_add
  1780 00039A3A E86CFFFFFF          <1>     call poly_add_mod           ; X = X+A mod p (uses r14,r13)
  1781                              <1> .no_add:
  1782 00039A3F 4D0FA4DA01          <1>     shld r10, r11, 1
  1783 00039A44 49D1E3              <1>     shl r11, 1
  1784 00039A47 49FFC9              <1>     dec r9
  1785 00039A4A 75E2                <1>     jnz .bitloop
  1786                              <1> 
  1787                              <1>     ; acc = X
  1788 00039A4C 498B06              <1>     mov rax, [r14+0]
  1789 00039A4F 498907              <1>     mov [r15+0], rax
  1790 00039A52 498B4608            <1>     mov rax, [r14+8]
  1791 00039A56 49894708            <1>     mov [r15+8], rax
  1792 00039A5A 498B4610            <1>     mov rax, [r14+16]
  1793 00039A5E 49894710            <1>     mov [r15+16], rax
  1794                              <1> 
  1795 00039A62 4883C430            <1>     add rsp, 48
  1796 00039A66 415F                <1>     pop r15
  1797 00039A68 415E                <1>     pop r14
  1798 00039A6A 415D                <1>     pop r13
  1799 00039A6C 415C                <1>     pop r12
  1800 00039A6E 415B                <1>     pop r11
  1801 00039A70 415A                <1>     pop r10
  1802 00039A72 4159                <1>     pop r9
  1803 00039A74 4158                <1>     pop r8
  1804 00039A76 5B                  <1>     pop rbx
  1805 00039A77 C3                  <1>     ret
  1806                              <1> 
  1807                              <1> ; poly1305_mac(rdi=tag_out16, rsi=msg, rdx=msglen, rcx=key32)
  1808                              <1> ; Computes the 16-byte Poly1305 tag of msg under key (r||s, 16+16
  1809                              <1> ; bytes) and writes it to tag_out16. Saves/restores every register it
  1810                              <1> ; touches.
  1811                              <1> poly1305_mac:
  1812 00039A78 50                  <1>     push rax
  1813 00039A79 53                  <1>     push rbx
  1814 00039A7A 51                  <1>     push rcx
  1815 00039A7B 52                  <1>     push rdx
  1816 00039A7C 56                  <1>     push rsi
  1817 00039A7D 57                  <1>     push rdi
  1818 00039A7E 55                  <1>     push rbp
  1819 00039A7F 4150                <1>     push r8
  1820 00039A81 4151                <1>     push r9
  1821 00039A83 4152                <1>     push r10
  1822 00039A85 4154                <1>     push r12
  1823 00039A87 4155                <1>     push r13
  1824 00039A89 4156                <1>     push r14
  1825 00039A8B 4157                <1>     push r15
  1826                              <1> 
  1827 00039A8D 4889FD              <1>     mov rbp, rdi              ; tag out ptr
  1828 00039A90 4889F3              <1>     mov rbx, rsi              ; msg ptr, advances
  1829 00039A93 4989D7              <1>     mov r15, rdx              ; acc ptr later (see below)
  1830 00039A96 4989D0              <1>     mov r8, rdx               ; remaining len (working copy)
  1831 00039A99 4989C9              <1>     mov r9, rcx               ; key ptr
  1832                              <1> 
  1833 00039A9C 4883EC60            <1>     sub rsp, 96                ; [0..23]=r(clamped,3 limbs) [24..47]=acc(3 limbs) [48..71]=n(3 limbs as 24B) [72..95]=spare/tag-scratch
  1834                              <1> 
  1835                              <1>     ; ---- clamp r from key[0:16] ----
  1836 00039AA0 498B01              <1>     mov rax, [r9+0]
  1837 00039AA3 498B4908            <1>     mov rcx, [r9+8]
  1838 00039AA7 49BAFFFFFF0FFCFFFF- <1>     mov r10, 0x0ffffffc0fffffff   ; mask for r's low limb (key bytes 0-7)
  1838 00039AB0 0F                  <1>
  1839 00039AB1 4C21D0              <1>     and rax, r10
  1840 00039AB4 49BAFCFFFF0FFCFFFF- <1>     mov r10, 0x0ffffffc0ffffffc   ; mask for r's high limb (key bytes 8-15)
  1840 00039ABD 0F                  <1>
  1841 00039ABE 4C21D1              <1>     and rcx, r10
  1842 00039AC1 48890424            <1>     mov [rsp+0], rax
  1843 00039AC5 48894C2408          <1>     mov [rsp+8], rcx
  1844 00039ACA 48C744241000000000  <1>     mov qword [rsp+16], 0      ; r's limb2 is always 0 after clamp
  1845                              <1> 
  1846                              <1>     ; ---- acc = 0 ----
  1847 00039AD3 48C744241800000000  <1>     mov qword [rsp+24], 0
  1848 00039ADC 48C744242000000000  <1>     mov qword [rsp+32], 0
  1849 00039AE5 48C744242800000000  <1>     mov qword [rsp+40], 0
  1850                              <1> 
  1851                              <1>     ; ---- process 16-byte blocks (last one may be shorter) ----
  1852                              <1> .block_loop:
  1853 00039AEE 4D85C0              <1>     test r8, r8
  1854 00039AF1 0F84B1000000        <1>     jz .blocks_done
  1855                              <1> 
  1856 00039AF7 41BA10000000        <1>     mov r10, 16
  1857 00039AFD 4D39D0              <1>     cmp r8, r10
  1858 00039B00 4D0F42D0            <1>     cmovb r10, r8              ; r10 = min(16, remaining) = this block's length L
  1859                              <1> 
  1860                              <1>     ; zero the 24-byte n scratch, copy L bytes from msg, set byte[L]=1
  1861 00039B04 48C744243000000000  <1>     mov qword [rsp+48], 0
  1862 00039B0D 48C744243800000000  <1>     mov qword [rsp+56], 0
  1863 00039B16 48C744244000000000  <1>     mov qword [rsp+64], 0
  1864 00039B1F 4831C9              <1>     xor rcx, rcx
