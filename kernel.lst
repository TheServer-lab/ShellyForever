   604                                  ; ------------------------------------------------------------
   605                                  ; expand_identity_map: extends boot.asm's minimal 0-64MB identity map to
   606                                  ; a full 0-4GB identity map using 2MB pages.
   607                                  ;
   608                                  ; Bug this fixes: "sdown" was rebooting the machine instead of shutting
   609                                  ; it down. Root cause: boot.asm's page tables only identity-map the
   610                                  ; first 64MB of physical memory (PML4@0x1000 -> PDPT@0x2000 -> a single
   611                                  ; PD@0x3000 with 32 entries). acpi_shutdown later walks the firmware's
   612                                  ; RSDT/XSDT/FADT/DSDT tables to find the real ACPI power-off port/value,
   613                                  ; and those tables are NOT guaranteed to live under 64MB - confirmed by
   614                                  ; tracing this exact machine: the FADT/DSDT land around 127MB with a
   615                                  ; 128MB guest. Touching that unmapped memory takes a page fault, and
   616                                  ; since there's no IDT installed yet, it escalates straight to a triple
   617                                  ; fault - which looks exactly like a reboot from the user's perspective.
   618                                  ;
   619                                  ; Fix: before anything else runs, reuse boot.asm's existing PML4/PDPT
   620                                  ; (no need to touch those) and add 3 more PD tables (PD1-PD3 at
   621                                  ; 0x4000/0x5000/0x6000, alongside boot.asm's PD0 at 0x3000), wiring all
   622                                  ; 4 into PDPT[0..3]. Then refill all 4 PDs (contiguous in memory) with
   623                                  ; 2048 sequential 2MB pages, giving a full 4GB identity map - enough
   624                                  ; headroom for any RAM size/firmware table placement QEMU, Bochs,
   625                                  ; VirtualBox, or real hardware is likely to use.
   626                                  expand_identity_map:
   627 00000599 50                          push rax
   628 0000059A 51                          push rcx
   629 0000059B 57                          push rdi
   630                                  
   631                                      ; PDPT[1..3] -> PD1/PD2/PD3 (present+rw). PDPT[0] already points at
   632                                      ; boot.asm's PD0 @ 0x3000.
   633 0000059C C70425082000000340-         mov dword [0x2000 + 1*8], 0x4000 | 0x3
   633 000005A5 0000               
   634 000005A7 C704250C2000000000-         mov dword [0x2000 + 1*8 + 4], 0
   634 000005B0 0000               
   635 000005B2 C70425102000000350-         mov dword [0x2000 + 2*8], 0x5000 | 0x3
   635 000005BB 0000               
   636 000005BD C70425142000000000-         mov dword [0x2000 + 2*8 + 4], 0
   636 000005C6 0000               
   637 000005C8 C70425182000000360-         mov dword [0x2000 + 3*8], 0x6000 | 0x3
   637 000005D1 0000               
   638 000005D3 C704251C2000000000-         mov dword [0x2000 + 3*8 + 4], 0
   638 000005DC 0000               
   639                                  
   640                                      ; PD0..PD3 are contiguous (0x3000..0x6FFF = 16KB = 2048 qwords).
   641                                      ; Refill them all with sequential 2MB pages 0, 2MB, ... 4094MB,
   642                                      ; replacing boot.asm's partial PD0 (only entries 0-31 were valid)
   643                                      ; with a complete map.
   644 000005DE BF00300000                  mov rdi, 0x3000
   645 000005E3 B883000000                  mov rax, 0x83                  ; present+rw+PS(2MB), base 0
   646 000005E8 B900080000                  mov rcx, 512 * 4               ; 512 entries/PD * 4 PDs = 4GB total
   647                                  .fill:
   648 000005ED 488907                      mov [rdi], rax
   649 000005F0 480500002000                add rax, 0x200000
   650 000005F6 4883C708                    add rdi, 8
   651 000005FA E2F1                        loop .fill
   652                                  
   653 000005FC 0F20D8                      mov rax, cr3                   ; reload CR3 to flush any stale TLB
   654 000005FF 0F22D8                      mov cr3, rax                   ; entries from the old partial map
   655                                  
   656 00000602 5F                          pop rdi
   657 00000603 59                          pop rcx
   658 00000604 58                          pop rax
   659 00000605 C3                          ret
