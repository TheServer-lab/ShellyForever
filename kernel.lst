 14044 0001ADD2 7714                        ja .pur_done
 14045 0001ADD4 486BC00A                    imul rax, rax, 10
 14046 0001ADD8 4C0FB6CB                    movzx r9, bl
 14047 0001ADDC 4983E930                    sub r9, '0'
 14048 0001ADE0 4C01C8                      add rax, r9
 14049 0001ADE3 48FFC6                      inc rsi
 14050 0001ADE6 EBE0                        jmp .pur_loop
 14051                                  .pur_done:
 14052 0001ADE8 4159                        pop r9
 14053 0001ADEA 5B                          pop rbx
 14054 0001ADEB C3                          ret
 14055                                  
 14056                                  ; parse_ident_run: reads [a-zA-Z0-9]* starting at [rsi] (caller has
