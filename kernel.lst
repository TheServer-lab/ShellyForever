 11524 000096EC E8B0F3FFFF                  call pci_read32
 11525 000096F1 440FB6D8                    movzx r11d, al                 ; r11 = offset of first capability
 11526                                  .pmw_walk:
 11527 000096F5 4585DB                      test r11d, r11d
 11528 000096F8 0F8497000000                jz .pmw_done                   ; end of list: no PM capability, nothing to do
 11529 000096FE 0FB61C25[3DCA0800]          movzx ebx, byte [nic_pci_bus]
 11530 00009706 0FB60C25[3ECA0800]          movzx ecx, byte [nic_pci_dev]
 11531 0000970E 0FB61425[3FCA0800]          movzx edx, byte [nic_pci_func]
 11532 00009716 4589D8                      mov r8d, r11d
 11533 00009719 4181E0FC000000              and r8d, 0xFC
 11534 00009720 E87CF3FFFF                  call pci_read32                ; al=cap id, ah=next ptr (bits 8:15 of eax)
