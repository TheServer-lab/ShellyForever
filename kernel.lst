  1509                              <1> ; ------------------------------------------------------------
  1510                              <1> ; party_set_err: records an interpreter error. rsi = message pointer.
  1511                              <1> ; Sets party_exec_ok=0, party_err_msg_ptr=rsi, and party_error_line
  1512                              <1> ; from the token at the current cursor r13. Clobbers rax, rbx, rsi,
  1513                              <1> ; rcx.
  1514                              <1> ; ------------------------------------------------------------
  1515                              <1> party_set_err:
