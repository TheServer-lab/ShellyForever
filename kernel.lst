 13534 0001A913 E8F4200100                  call print_string_attr
 13535 0001A918 488D3425[B4A40600]          lea rsi, [nic_rx_frame+14+14]
 13536 0001A920 E840010000                  call print_ip4
 13537 0001A925 E9D9000000                  jmp .ndf_nl
 13538                                  .ndf_ip:
 13539 0001A92A 48BE-                       mov rsi, msg_diag_proto
 13539 0001A92C [2C48030000000000] 
