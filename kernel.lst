 14098                                  ; ============================================================
 14099                                  ;  CALC EXPRESSION EVALUATOR
 14100                                  ;  Supports +, -, *, / with standard precedence (* / before + -),
 14101                                  ;  unary minus, decimal literals, and variable names as operands.
 14102                                  ;  eval_expr: rsi = expression text (null-terminated) -> rax=result,
 14103                                  ;  cl=1 if valid else cl=0. Does not preserve rcx (return flag).
 14104                                  ; ============================================================
 14105                                  eval_expr:
 14106 0001AE3B 53                          push rbx
 14107 0001AE3C 52                          push rdx
 14108 0001AE3D 4150                        push r8
 14109 0001AE3F 4151                        push r9
 14110 0001AE41 4152                        push r10
 14111 0001AE43 4153                        push r11
 14112 0001AE45 4154                        push r12
 14113 0001AE47 4155                        push r13
 14114 0001AE49 4156                        push r14
 14115 0001AE4B 4157                        push r15
 14116                                  
 14117 0001AE4D 4D31C0                      xor r8, r8            ; count of parsed values so far
 14118 0001AE50 41B901000000                mov r9, 1             ; expect_operand flag
 14119 0001AE56 4D31D2                      xor r10, r10          ; pending unary-negate flag
 14120                                  
 14121                                  .ee_loop:
 14122 0001AE59 8A06                        mov al, [rsi]
 14123 0001AE5B 3C00                        cmp al, 0
 14124 0001AE5D 0F84B8000000                je .ee_endloop
 14125 0001AE63 3C20                        cmp al, ' '
 14126 0001AE65 7408                        je .ee_skip_space
 14127 0001AE67 4983F901                    cmp r9, 1
 14128 0001AE6B 7407                        je .ee_operand
 14129 0001AE6D EB7C                        jmp .ee_operator
 14130                                  .ee_skip_space:
 14131 0001AE6F 48FFC6                      inc rsi
 14132 0001AE72 EBE5                        jmp .ee_loop
 14133                                  
 14134                                  .ee_operand:
 14135 0001AE74 3C2D                        cmp al, '-'
 14136 0001AE76 7509                        jne .ee_o_notminus
 14137 0001AE78 4983F201                    xor r10, 1
 14138 0001AE7C 48FFC6                      inc rsi
 14139 0001AE7F EBD8                        jmp .ee_loop
 14140                                  .ee_o_notminus:
 14141 0001AE81 3C2B                        cmp al, '+'
 14142 0001AE83 7505                        jne .ee_o_notplus
 14143 0001AE85 48FFC6                      inc rsi
 14144 0001AE88 EBCF                        jmp .ee_loop
 14145                                  .ee_o_notplus:
 14146 0001AE8A 3C30                        cmp al, '0'
 14147 0001AE8C 720B                        jb .ee_o_ident
 14148 0001AE8E 3C39                        cmp al, '9'
 14149 0001AE90 7707                        ja .ee_o_ident
 14150 0001AE92 E82BFFFFFF                  call parse_uint_run
 14151 0001AE97 EB26                        jmp .ee_have_val
 14152                                  .ee_o_ident:
 14153 0001AE99 3C61                        cmp al, 'a'
 14154 0001AE9B 7204                        jb .ee_o_upper
 14155 0001AE9D 3C7A                        cmp al, 'z'
 14156 0001AE9F 7610                        jbe .ee_o_doident
 14157                                  .ee_o_upper:
 14158 0001AEA1 3C41                        cmp al, 'A'
