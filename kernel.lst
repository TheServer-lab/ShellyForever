  6817 000063B3 48891C25[28890C00]          mov [bg_cur_slot], rbx
  6818 000063BB 48892425[20890C00]          mov [bg_shell_rsp], rsp          ; scheduler's return address is on top
  6819                                  
  6820                                      ; restore the process's parked interpreter state
  6821 000063C3 488D3425[943A0B00]          lea rsi, [proc_bg_ctx]
  6822 000063CB 4869C346A70000              imul rax, rbx, PARTY_CTX_SIZE
  6823 000063D2 4801C6                      add rsi, rax
  6824 000063D5 E8FD0E0200                  call party_ctx_restore
  6825                                  
  6826                                      ; point putchar's capture at this process's output ring
  6827 000063DA 488D0425[945A0A00]          lea rax, [proc_bg_ring]
  6828 000063E2 4869CB00100000              imul rcx, rbx, BG_RING_CAP
  6829 000063E9 4801C8                      add rax, rcx
  6830 000063EC 48890425[36890C00]          mov [bg_capture_base], rax
