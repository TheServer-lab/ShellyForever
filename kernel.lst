 13570 000149D9 488DB8[709B0100]            lea rdi, [history_buf + rax]
 13571 000149E0 4C89CE                      mov rsi, r9
 13572 000149E3 E8B6F7FFFF                  call str_copy
 13573 000149E8 480FB60425-                 movzx rax, byte [history_next]
 13573 000149ED [4A4D0100]         
