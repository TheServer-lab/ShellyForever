  4516                              <1> 
  4517                              <1> ; ============================================================
  4518                              <1> ;  IN-LANGUAGE ARRAYS (Phase 4)
  4519                              <1> ;
  4520                              <1> ; Surface (PARTY_SPEC.md section 10): builtin functions, the same
  4521                              <1> ; function-call-shaped "cannot be shadowed by a user func" mechanism
  4522                              <1> ; Phase 3's file API uses - no new syntax, no TOK_LBRACKET/RBRACKET,
  4523                              <1> ; no postfix-indexing parser work. This was a deliberate scope call
  4524                              <1> ; (see phases.txt for the tradeoff): `a[i]` / `a[i] = x` / `[1,2,3]`
  4525                              <1> ; literal syntax is real parser work (a new expression production,
  4526                              <1> ; and a new assignment-target grammar alongside the existing
  4527                              <1> ; ident-only `.pes_assign`) that a later phase can add on top of this
  4528                              <1> ; one without touching the underlying storage below.
  4529                              <1> ;
  4530                              <1> ;     vars a = arr_new(3)     ; new array, 3 elements, each int 0
  4531                              <1> ;     arr_set(a, 0, "hi")     ; statement only, like fwrite
  4532                              <1> ;     display arr_get(a, 0)  ; "hi"
  4533                              <1> ;     display arr_len(a)     ; 3
  4534                              <1> ;     arr_free(a)             ; releases the slot
  4535                              <1> ;
  4536                              <1> ; Storage: a fixed pool of PARTY_ARR_MAX array "slots", each holding
  4537                              <1> ; up to PARTY_ARR_CAP elements (ordinary 32-byte Party values, so an
  4538                              <1> ; array can hold any type, including nested arrays - nothing in the
  4539                              <1> ; value model prevents it, it just wasn't a design goal this phase).
  4540                              <1> ; A PV_ARRAY value's [+8] field is the slot index - the same
  4541                              <1> ; handle-into-a-fixed-table shape PARTY_FH_* already uses for file
  4542                              <1> ; handles - so copying a PV_ARRAY value (assignment, passing it as a
  4543                              <1> ; function argument, returning it) copies the handle only: arrays
  4544                              <1> ; are reference types, every alias sees the same underlying storage.
  4545                              <1> ; This was the OTHER locked-in scope decision (avoids needing a deep
  4546                              <1> ; -copy pass through party_val_copy, which stays a flat 32-byte copy
  4547                              <1> ; for every value type, arrays included).
  4548                              <1> ;
  4549                              <1> ; PARTY_ARR_MAX=4 / PARTY_ARR_CAP=16 are deliberately small - see the
  4550                              <1> ; sizing note by the equ's below. No arr_grow/append: an array's size
  4551                              <1> ; is fixed at arr_new and never changes, matching "fixed-size" from
  4552                              <1> ; the two options phases.txt raised as the very first open design
  4553                              <1> ; question (growable was the other option; not done here).
  4554                              <1> ; ============================================================
  4555                              <1> 
  4556                              <1> PARTY_ARR_MAX equ 4     ; concurrently-alive arrays. Kept deliberately
  4557                              <1>                          ; tiny: this table gets copied into EVERY
  4558                              <1>                          ; party_ctx_table save/restore (background
  4559                              <1>                          ; processes), which is itself replicated
  4560                              <1>                          ; MAX_PROCESSES times in kernel.asm's
  4561                              <1>                          ; proc_bg_ctx - and kernel.asm already trimmed
  4562                              <1>                          ; MAX_PROCESSES from 4 to 2 "to fit the
  4563                              <1>                          ; kernel's BSS under 0xA0000" (kernel.asm
  4564                              <1>                          ; ~18343). A bigger array table here directly
  4565                              <1>                          ; eats into that same tight budget. 4 arrays x
  4566                              <1>                          ; 16 elements was picked to keep the total
  4567                              <1>                          ; addition small (see party_arr_data below);
  4568                              <1>                          ; raise it only after confirming real
  4569                              <1>                          ; link-time BSS headroom in the full dev tree
  4570                              <1>                          ; ("nasm party.asm standalone" only checks
  4571                              <1>                          ; syntax, not final image size) - not done
  4572                              <1>                          ; this session, no boot/link environment here.
  4573                              <1> PARTY_ARR_CAP equ 80    ; elements per array - was 16, too small for
  4574                              <1>                          ; scripts that size an array to the screen
  4575                              <1>                          ; width (e.g. matrix_rain.pa's per-column
  4576                              <1>                          ; state arrays need cols=79 elements); raised
  4577                              <1>                          ; to 80 for a one-element margin. See the
  4578                              <1>                          ; BSS-budget caution on PARTY_ARR_MAX above -
  4579                              <1>                          ; this raises party_arr_data's footprint from
  4580                              <1>                          ; 2048 to 10240 bytes (+8192), which also
  4581                              <1>                          ; grows the party_ctx_table entry below and
  4582                              <1>                          ; PARTY_CTX_SIZE by the same amount, and that
  4583                              <1>                          ; growth is replicated per background-process
  4584                              <1>                          ; slot in kernel.asm's proc_bg_ctx - not
  4585                              <1>                          ; verified against real link-time BSS headroom
  4586                              <1>                          ; this session, same as the MAX_PROCESSES
  4587                              <1>                          ; trim already noted above.
  4588                              <1> 
  4589                              <1> ; party_arr_alloc: finds a free array slot. Out: rax = slot index, or
  4590                              <1> ; -1 if the table is full (msg_party_arr_full via party_set_err).
  4591                              <1> ; Clobbers rax, rcx. Mirrors party_fh_alloc exactly.
  4592                              <1> party_arr_alloc:
  4593 00029693 4831C9              <1>     xor rcx, rcx
  4594                              <1> .paa_loop:
  4595 00029696 4883F904            <1>     cmp rcx, PARTY_ARR_MAX
  4596 0002969A 7319                <1>     jae .paa_full
  4597 0002969C 80B9[FDB40200]00    <1>     cmp byte [party_arr_used+rcx], 0
  4598 000296A3 7405                <1>     je .paa_found
  4599 000296A5 48FFC1              <1>     inc rcx
  4600 000296A8 EBEC                <1>     jmp .paa_loop
  4601                              <1> .paa_found:
  4602 000296AA C681[FDB40200]01    <1>     mov byte [party_arr_used+rcx], 1
  4603 000296B1 4889C8              <1>     mov rax, rcx
  4604 000296B4 C3                  <1>     ret
  4605                              <1> .paa_full:
  4606 000296B5 488D3425[A3260300]  <1>     lea rsi, [msg_party_arr_full]
  4607 000296BD E8B0E6FFFF          <1>     call party_set_err
  4608 000296C2 48C7C0FFFFFFFF      <1>     mov rax, -1
  4609 000296C9 C3                  <1>     ret
  4610                              <1> 
  4611                              <1> ; party_arr_check: rax = handle value (a PV_ARRAY value's [+8] field).
  4612                              <1> ; Validates it's in range and currently allocated.
  4613                              <1> ; Out: on success, rbx = pointer to the array's element-0 slot inside
  4614                              <1> ; party_arr_data, rcx = handle/slot index, al = 1. On failure, sets
  4615                              <1> ; party_exec_ok = 0 via party_set_err (msg_party_arr_invalid) and
  4616                              <1> ; al = 0. Clobbers rax, rbx, rcx, rdx, rsi.
  4617                              <1> party_arr_check:
  4618 000296CA 4883F800            <1>     cmp rax, 0
  4619 000296CE 7C2A                <1>     jl .pac_bad
  4620 000296D0 4883F804            <1>     cmp rax, PARTY_ARR_MAX
  4621 000296D4 7324                <1>     jae .pac_bad
  4622 000296D6 4889C1              <1>     mov rcx, rax
  4623 000296D9 80B9[FDB40200]00    <1>     cmp byte [party_arr_used+rcx], 0
  4624 000296E0 7418                <1>     je .pac_bad
  4625 000296E2 4889CB              <1>     mov rbx, rcx
  4626 000296E5 4869DB000A0000      <1>     imul rbx, PARTY_ARR_CAP*32
  4627 000296EC 488D1425[28B50200]  <1>     lea rdx, [party_arr_data]
  4628 000296F4 4801D3              <1>     add rbx, rdx
  4629 000296F7 B001                <1>     mov al, 1
  4630 000296F9 C3                  <1>     ret
  4631                              <1> .pac_bad:
  4632 000296FA 488D3425[B8260300]  <1>     lea rsi, [msg_party_arr_invalid]
  4633 00029702 E86BE6FFFF          <1>     call party_set_err
  4634 00029707 30C0                <1>     xor al, al
  4635 00029709 C3                  <1>     ret
  4636                              <1> 
  4637                              <1> ; ---- arr_new(n) -> array; n elements, each initialized to int 0 ----
  4638                              <1> party_bi_arr_new:
  4639 0002970A 4983FE01            <1>     cmp r14, 1
  4640 0002970E 740E                <1>     je .ban_argc_ok
  4641 00029710 488D3425[34230300]  <1>     lea rsi, [msg_party_arg_count]
  4642 00029718 E855E6FFFF          <1>     call party_set_err
  4643 0002971D C3                  <1>     ret
  4644                              <1> .ban_argc_ok:
  4645 0002971E 488D3C25[98270300]  <1>     lea rdi, [party_scratch1]
  4646 00029726 E84FE9FFFF          <1>     call party_pop_val
  4647 0002972B 803C25[01B30200]01  <1>     cmp byte [party_exec_ok], 1
  4648 00029733 0F85C2000000        <1>     jne .ban_out
  4649 00029739 803C25[98270300]01  <1>     cmp byte [party_scratch1], PV_INT
  4650 00029741 0F8598000000        <1>     jne .ban_err_type
  4651 00029747 488B0425[A0270300]  <1>     mov rax, [party_scratch1+8]
  4652 0002974F 4883F800            <1>     cmp rax, 0
  4653 00029753 0F8C95000000        <1>     jl .ban_err_range
  4654 00029759 4883F850            <1>     cmp rax, PARTY_ARR_CAP
