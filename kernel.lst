 12655                                  
 12656                                  ; next_token: rsi = pointer into source line, rdi = dest buffer
 12657                                  ; advances rsi; writes null-terminated token (may be empty) to rdi
 12658                                  ; supports "quoted strings with spaces"
 12659                                  next_token:
 12660 00014150 50                          push rax
 12661                                  .skip:
 12662 00014151 8A06                        mov al, [rsi]
 12663 00014153 3C00                        cmp al, 0
 12664 00014155 7442                        je .empty
 12665 00014157 3C20                        cmp al, ' '
 12666 00014159 7505                        jne .check_quote
 12667 0001415B 48FFC6                      inc rsi
 12668 0001415E EBF1                        jmp .skip
 12669                                  .check_quote:
 12670 00014160 3C22                        cmp al, '"'
 12671 00014162 751C                        jne .plain
 12672 00014164 48FFC6                      inc rsi
 12673                                  .qloop:
 12674 00014167 8A06                        mov al, [rsi]
 12675 00014169 3C00                        cmp al, 0
 12676 0001416B 7427                        je .term
 12677 0001416D 3C22                        cmp al, '"'
 12678 0001416F 740A                        je .qend
 12679 00014171 8807                        mov [rdi], al
 12680 00014173 48FFC7                      inc rdi
 12681 00014176 48FFC6                      inc rsi
 12682 00014179 EBEC                        jmp .qloop
 12683                                  .qend:
 12684 0001417B 48FFC6                      inc rsi
 12685 0001417E EB14                        jmp .term
 12686                                  .plain:
 12687                                  .ploop:
 12688 00014180 8A06                        mov al, [rsi]
 12689 00014182 3C00                        cmp al, 0
 12690 00014184 740E                        je .term
 12691 00014186 3C20                        cmp al, ' '
 12692 00014188 740A                        je .term
 12693 0001418A 8807                        mov [rdi], al
 12694 0001418C 48FFC7                      inc rdi
 12695 0001418F 48FFC6                      inc rsi
 12696 00014192 EBEC                        jmp .ploop
 12697                                  .term:
 12698 00014194 C60700                      mov byte [rdi], 0
 12699 00014197 58                          pop rax
 12700 00014198 C3                          ret
 12701                                  .empty:
 12702 00014199 C60700                      mov byte [rdi], 0
 12703 0001419C 58                          pop rax
 12704 0001419D C3                          ret
