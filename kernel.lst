 10745 00018B78 E958070000                  jmp .ndone
 10746                                  .nreset_done:
 10747                                  
 10748                                      ; CONFIG1=0, interrupt mask off, clear ISR
 10749 00018B7D 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10750 00018B84 83C752                      add edi, NIC_IO_CFG1
 10751 00018B87 30C0                        xor al, al
 10752 00018B89 E810FAFFFF                  call nic_io_write8
 10753 00018B8E 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10754 00018B95 83C73C                      add edi, NIC_IO_IMR
 10755 00018B98 6631C0                      xor ax, ax
 10756 00018B9B E803FAFFFF                  call nic_io_write16
 10757 00018BA0 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10758 00018BA7 83C73E                      add edi, NIC_IO_ISR
 10759 00018BAA 66B8FFFF                    mov ax, 0xFFFF
 10760 00018BAE E8F0F9FFFF                  call nic_io_write16
 10761                                  
 10762                                      ; point the 8KB RX ring at our DMA buffer (identity-mapped)
 10763 00018BB3 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10764 00018BBA 83C730                      add edi, NIC_IO_RBSTART
 10765 00018BBD 8D0425[40E90500]            lea eax, [nic_rx_ring]
 10766 00018BC4 E8E0F9FFFF                  call nic_io_write32
 10767                                  
 10768                                      ; RCR = AB|AM|APM|AAP (accept everything), TCR = 0, CAPR/CBR = 0
 10769 00018BC9 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10770 00018BD0 83C744                      add edi, NIC_IO_RCR
 10771 00018BD3 B80F000000                  mov eax, 0x0000000F
 10772 00018BD8 E8CCF9FFFF                  call nic_io_write32
 10773 00018BDD 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10774 00018BE4 83C740                      add edi, NIC_IO_TCR
 10775 00018BE7 31C0                        xor eax, eax
 10776 00018BE9 E8BBF9FFFF                  call nic_io_write32
 10777                                      ; seed CAPR = ring - 16 (the chip trails the read position by 16), CBR = 0
 10778 00018BEE 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10779 00018BF5 83C738                      add edi, NIC_IO_CAPR
 10780 00018BF8 66B8F01F                    mov ax, NIC_RX_RING_SIZE - 16
