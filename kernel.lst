 12777 000141F6 E883E2FFFF                  call mouse_sel_clear
 12778 000141FB BF00800B00                  mov rdi, VGA_BASE
 12779 00014200 B9D0070000                  mov rcx, VGA_COLS*VGA_ROWS
 12780 00014205 66B82007                    mov ax, 0x0720           ; space, light grey
 12781                                  .loop:
 12782 00014209 668907                      mov [rdi], ax
 12783 0001420C 4883C702                    add rdi, 2
 12784 00014210 E2F7                        loop .loop
 12785 00014212 C60425[384D0100]00          mov byte [cursor_row], 0
 12786 0001421A C60425[394D0100]00          mov byte [cursor_col], 0
