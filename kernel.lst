 13508 00014937 52                          push rdx
 13509 00014938 480FB60425-                 movzx rax, byte [history_next]
 13509 0001493D [4A4D0100]         
 13510 00014941 4883C014                    add rax, HISTORY_MAX
 13511 00014945 480FB61C25-                 movzx rbx, byte [history_nav]
 13511 0001494A [4C4D0100]         
 13512 0001494E 4829D8                      sub rax, rbx
 13513 00014951 4831D2                      xor rdx, rdx
 13514 00014954 BB14000000                  mov rbx, HISTORY_MAX
 13515 00014959 48F7F3                      div rbx
 13516 0001495C 4889D0                      mov rax, rdx
 13517 0001495F 5A                          pop rdx
 13518 00014960 5B                          pop rbx
 13519 00014961 C3                          ret
 13520                                  
 13521                                  ; .load_entry: rsi = null-terminated source string. Erases the currently
 13522                                  ; displayed/buffered line and replaces it with the source string.
 13523                                  .load_entry:
 13524 00014962 50                          push rax
 13525 00014963 51                          push rcx
 13526 00014964 4C89C1                      mov rcx, r8
 13527                                  .le_erase:
 13528 00014967 4883F900                    cmp rcx, 0
 13529 0001496B 740A                        je .le_erase_done
 13530 0001496D E854030000                  call do_backspace
 13531 00014972 48FFC9                      dec rcx
 13532 00014975 EBF0                        jmp .le_erase
 13533                                  .le_erase_done:
 13534 00014977 4D31C0                      xor r8, r8
 13535                                  .le_copy:
 13536 0001497A 428A0406                    mov al, [rsi + r8]
 13537 0001497E 3C00                        cmp al, 0
 13538 00014980 740E                        je .le_copy_done
 13539 00014982 4D39D0                      cmp r8, r10
 13540 00014985 7309                        jae .le_copy_done
 13541 00014987 43880401                    mov [r9 + r8], al
 13542 0001498B 49FFC0                      inc r8
 13543 0001498E EBEA                        jmp .le_copy
 13544                                  .le_copy_done:
 13545 00014990 43C6040100                  mov byte [r9 + r8], 0
 13546 00014995 4831C9                      xor rcx, rcx
 13547                                  .le_echo:
 13548 00014998 4C39C1                      cmp rcx, r8
 13549 0001499B 7317                        jae .le_echo_done
 13550 0001499D 418A0409                    mov al, [r9 + rcx]
 13551 000149A1 53                          push rbx
 13552 000149A2 8A1C25[444D0100]            mov bl, [cur_normal_attr]
 13553 000149A9 E829F9FFFF                  call putchar
 13554 000149AE 5B                          pop rbx
 13555 000149AF 48FFC1                      inc rcx
 13556 000149B2 EBE4                        jmp .le_echo
 13557                                  .le_echo_done:
 13558 000149B4 59                          pop rcx
 13559 000149B5 58                          pop rax
 13560 000149B6 C3                          ret
