 13234                                  .no_wrap:
 13235 00014650 880425[484D0100]            mov [sb_write_idx], al
 13236                                  
 13237 00014657 803C25[494D0100]64          cmp byte [sb_count], SCROLLBACK_LINES
 13238 0001465F 7407                        je .out
 13239 00014661 FE0425[494D0100]            inc byte [sb_count]
 13240                                  .out:
 13241 00014668 5F                          pop rdi
 13242 00014669 5E                          pop rsi
 13243 0001466A 59                          pop rcx
 13244 0001466B 58                          pop rax
 13245 0001466C C3                          ret
