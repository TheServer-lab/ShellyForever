 14981                                  
 14982                                  ; update_cursor: programs the VGA CRTC hardware cursor (the blinking block)
 14983                                  ; to match cursor_row/cursor_col, via the index/data port pair 0x3D4/0x3D5.
 14984                                  ; Without this the blinking cursor never moves from wherever the BIOS left
 14985                                  ; it, even though text is being printed elsewhere.
 14986                                  update_cursor:
 14987 0002C965 50                          push rax
 14988 0002C966 51                          push rcx
 14989 0002C967 52                          push rdx
 14990 0002C968 480FB60C25-                 movzx rcx, byte [cursor_row]
 14990 0002C96D [B8D70200]         
 14991 0002C971 486BC950                    imul rcx, VGA_COLS
 14992 0002C975 480FB61425-                 movzx rdx, byte [cursor_col]
 14992 0002C97A [B9D70200]         
 14993 0002C97E 4801D1                      add rcx, rdx                 ; rcx = linear cursor position
 14994                                  
 14995 0002C981 66BAD403                    mov dx, 0x3D4
 14996 0002C985 B00F                        mov al, 0x0F                 ; cursor location low byte
 14997 0002C987 EE                          out dx, al
 14998 0002C988 66BAD503                    mov dx, 0x3D5
 14999 0002C98C 88C8                        mov al, cl
 15000 0002C98E EE                          out dx, al
 15001                                  
 15002 0002C98F 66BAD403                    mov dx, 0x3D4
 15003 0002C993 B00E                        mov al, 0x0E                 ; cursor location high byte
 15004 0002C995 EE                          out dx, al
 15005 0002C996 66BAD503                    mov dx, 0x3D5
 15006 0002C99A 88E8                        mov al, ch
 15007 0002C99C EE                          out dx, al
 15008                                  
 15009 0002C99D 5A                          pop rdx
 15010 0002C99E 59                          pop rcx
 15011 0002C99F 58                          pop rax
 15012 0002C9A0 C3                          ret
 15013                                  
 15014                                  ; cursor_step_left / cursor_step_right: move the hardware cursor one cell
 15015                                  ; back/forward across cursor_row/cursor_col (wrapping at row edges), without
 15016                                  ; touching VGA content. Used by read_line for Left/Right/Home/End so moving
 15017                                  ; the cursor over already-echoed text doesn't erase or retype anything.
 15018                                  ; cursor_step_left is a no-op at row 0, col 0 (nothing further left to go).
 15019                                  ; cursor_step_right does not scroll - callers only step it across text that
 15020                                  ; has already been drawn (and therefore already fits on screen).
 15021                                  cursor_step_left:
 15022 0002C9A1 50                          push rax
 15023 0002C9A2 803C25[B9D70200]00          cmp byte [cursor_col], 0
 15024 0002C9AA 751B                        jne .left_dec
 15025 0002C9AC 803C25[B8D70200]00          cmp byte [cursor_row], 0
 15026 0002C9B4 741D                        je .left_out          ; already at top-left; nothing to do
 15027 0002C9B6 FE0C25[B8D70200]            dec byte [cursor_row]
 15028 0002C9BD C60425[B9D70200]4F          mov byte [cursor_col], VGA_COLS-1
 15029 0002C9C5 EB07                        jmp .left_upd
 15030                                  .left_dec:
 15031 0002C9C7 FE0C25[B9D70200]            dec byte [cursor_col]
 15032                                  .left_upd:
 15033 0002C9CE E892FFFFFF                  call update_cursor
 15034                                  .left_out:
 15035 0002C9D3 58                          pop rax
 15036 0002C9D4 C3                          ret
 15037                                  
 15038                                  cursor_step_right:
 15039 0002C9D5 50                          push rax
 15040 0002C9D6 FE0425[B9D70200]            inc byte [cursor_col]
 15041 0002C9DD 803C25[B9D70200]50          cmp byte [cursor_col], VGA_COLS
 15042 0002C9E5 750F                        jne .right_upd
 15043 0002C9E7 C60425[B9D70200]00          mov byte [cursor_col], 0
 15044 0002C9EF FE0425[B8D70200]            inc byte [cursor_row]
 15045                                  .right_upd:
 15046 0002C9F6 E86AFFFFFF                  call update_cursor
 15047 0002C9FB 58                          pop rax
 15048 0002C9FC C3                          ret
