    44 00024122 09D0                <1>     or eax, edx
    45 00024124 C1E008              <1>     shl eax, 8
    46 00024127 0FB65602            <1>     movzx edx, byte [rsi+2]
    47 0002412B 09D0                <1>     or eax, edx
