   465 00038A09 488D3C25[B0ED0300]  <1>     lea rdi, [hmac_scratch_ctx]
   466 00038A11 488D3425[60EE0300]  <1>     lea rsi, [hmac_ipad]
   467 00038A19 B940000000          <1>     mov rcx, 64
   468 00038A1E E8D0FDFFFF          <1>     call sha256_update
