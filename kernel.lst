 16172                                  .tk_done:
 16173 0002D4C7 4C89C3                      mov rbx, r8                  ; rbx = token length = r8 - r13
 16174 0002D4CA 4C29EB                      sub rbx, r13
 16175                                  
 16176                                      ; ---- mode: r11 = 1 if this is not the first token ----
