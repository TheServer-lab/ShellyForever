   647 0003FB8C 0FB65601            <1>     movzx edx, byte [rsi+1]
   648 0003FB90 09D0                <1>     or eax, edx
   649 0003FB92 4883C602            <1>     add rsi, 2
   650 0003FB96 4C8D0406            <1>     lea r8, [rsi + rax]              ; end of ext block
   651                              <1>     ; scan for key_share (0x0033)
