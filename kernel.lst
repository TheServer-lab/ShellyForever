  5459                                  ; ============================================================
  5460                                  ;  DISK PERSISTENCE  (ATA PIO driver, primary bus, LBA28, polling)
  5461                                  ; ============================================================
  5462                                  ; Ports (primary ATA channel):
  5463                                  ;   0x1F0 data, 0x1F1 features/error, 0x1F2 sector count,
  5464                                  ;   0x1F3/4/5 LBA low/mid/high, 0x1F6 drive/head, 0x1F7 status/command.
  5465                                  ; No IRQs are used anywhere in this kernel, so these routines just
  5466                                  ; poll BSY/DRQ in the status register, matching the polled keyboard
  5467                                  ; driver's style.
  5468                                  
  5469                                  ; ata_wait_bsy: block until BSY (bit 7) clears, or give up after a timeout.
  5470                                  ; returns CF=0 on success, CF=1 on timeout (no device responding at all,
  5471                                  ; e.g. real hardware with no legacy IDE controller / booting off USB).
  5472                                  ATA_TIMEOUT equ 0x400000
  5473                                  ; ata_wait_bsy: block until BSY (bit 7) clears, or give up after a timeout.
  5474                                  ; returns CF=0 on success, CF=1 on timeout (no device responding at all,
  5475                                  ; e.g. real hardware with no legacy IDE controller / booting off USB).
  5476                                  ATA_TIMEOUT equ 0x400000
