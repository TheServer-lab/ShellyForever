  7180 00005D06 5B                          pop rbx
  7181 00005D07 C3                          ret
  7182                                  
  7183                                  ; rtc_update: reads seconds/minutes/hours/day/month/year (+ century, if the
  7184                                  ; chip provides one) into the rtc_* variables, normalized to 24-hour binary.
