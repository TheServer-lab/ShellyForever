   373                              <1> ; ---- sha256_hash: one-shot. rdi=data ptr, rcx=len, rsi=32-byte out ----
   374                              <1> ; Uses sha256_scratch_ctx -- not reentrant; fine for isolated one-off
   375                              <1> ; hashes but NOT for a running transcript hash held open across other
   376                              <1> ; hash calls (Phase 3's transcript hash must keep its own ctx and call
   377                              <1> ; init/update/final directly).
   378                              <1> sha256_hash:
   379 0003893F 50                  <1>     push rax
   380 00038940 51                  <1>     push rcx
   381 00038941 56                  <1>     push rsi
   382 00038942 57                  <1>     push rdi
   383 00038943 4154                <1>     push r12
   384 00038945 4989F4              <1>     mov r12, rsi                  ; save out ptr
   385 00038948 57                  <1>     push rdi
   386 00038949 51                  <1>     push rcx
   387 0003894A 488D3C25[40ED0300]  <1>     lea rdi, [sha256_scratch_ctx]
   388 00038952 E81CFCFFFF          <1>     call sha256_init
   389 00038957 59                  <1>     pop rcx
   390 00038958 5E                  <1>     pop rsi                       ; data ptr back into rsi
   391 00038959 488D3C25[40ED0300]  <1>     lea rdi, [sha256_scratch_ctx]
   392 00038961 E88DFEFFFF          <1>     call sha256_update
   393 00038966 488D3C25[40ED0300]  <1>     lea rdi, [sha256_scratch_ctx]
   394 0003896E 4C89E6              <1>     mov rsi, r12
   395 00038971 E825FFFFFF          <1>     call sha256_final
   396 00038976 415C                <1>     pop r12
   397 00038978 5F                  <1>     pop rdi
   398 00038979 5E                  <1>     pop rsi
   399 0003897A 59                  <1>     pop rcx
   400 0003897B 58                  <1>     pop rax
   401 0003897C C3                  <1>     ret
