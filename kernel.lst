   145 0000005C 743A                        je .say_no_disk
   146 0000005E 803C25[E09E0100]01          cmp byte [fs_loaded_from_disk], 1
   147 00000066 7418                        je .say_loaded
   148 00000068 48BE-                       mov rsi, msg_fresh_fs
