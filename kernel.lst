 16908                                  ; read_line: rdi=buffer, rcx=max chars. Echoes to screen, handles
 16909                                  ; backspace/Delete, Left/Right/Home/End in-line cursor movement, Up/Down
 16910                                  ; command history, and terminates on Enter. Buffer is null terminated.
 16911                                  ; r8 = current line length, r9 = buffer ptr, r10 = max chars, r11 = the
 16912                                  ; cursor's position within the line (0..r8) - everything below that
 16913                                  ; isn't a straight end-of-line append goes through r11 instead of r8.
 16914                                  ; read_char_or_step: like get_char but non-blocking from the shell's
 16915                                  ; point of view: if no keyboard byte is waiting, steps the background
 16916                                  ; processes for one quantum and returns al = 0 (never returned by
 16917                                  ; get_char, which maps every zero table entry to "wait"). Preserves
 16918                                  ; every register so read_line's r8-r11 line state survives a step.
 16919                                  read_char_or_step:
 16920 00071311 53                          push rbx
 16921 00071312 51                          push rcx
 16922 00071313 52                          push rdx
 16923 00071314 56                          push rsi
 16924 00071315 57                          push rdi
 16925 00071316 4150                        push r8
 16926 00071318 4151                        push r9
 16927 0007131A 4152                        push r10
 16928 0007131C 4153                        push r11
 16929 0007131E 4154                        push r12
 16930 00071320 4155                        push r13
 16931 00071322 4156                        push r14
 16932 00071324 4157                        push r15
