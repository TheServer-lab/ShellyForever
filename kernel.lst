  9631 00018174 B900010000                  mov rcx, VOL_NODES
  9632 00018179 66F3A5                      rep movsw
  9633 0001817C EB14                        jmp .next_loaded
  9634                                  .next_v2:
  9635 0001817E 4B8DBC00[50D60500]          lea rdi, [node_next + r8*2]
  9636 00018186 B900010000                  mov rcx, VOL_NODES
