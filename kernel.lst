   200 000000ED 48BE-                       mov rsi, line_buf
   200 000000EF [E0B8010000000000] 
   201 000000F7 48BF-                       mov rdi, chain_scan_buf
   201 000000F9 [BCB9010000000000] 
   202 00000101 E85C620000                  call str_copy
   203                                  
   204 00000106 49BC-                       mov r12, chain_scan_buf   ; r12 = start of current segment
   204 00000108 [BCB9010000000000] 
   205 00000110 49BD-                       mov r13, chain_scan_buf   ; r13 = scan pointer
   205 00000112 [BCB9010000000000] 
   206 0000011A 41B600                      mov r14b, 0               ; r14b = quote state (0=outside, 1=inside)
   207                                  
   208                                  .chain_scan:
   209 0000011D 418A4500                    mov al, [r13]
   210 00000121 84C0                        test al, al
   211 00000123 744B                        jz .chain_done            ; end of string, process last segment
   212                                  
   213 00000125 3C22                        cmp al, '"'
   214 00000127 7409                        je .toggle_quotes
   215                                  
   216 00000129 3C3B                        cmp al, ';'
   217 0000012B 740E                        je .chain_break
   218                                  
   219 0000012D 49FFC5                      inc r13
   220 00000130 EBEB                        jmp .chain_scan
   221                                  
   222                                  .toggle_quotes:
   223 00000132 4180F601                    xor r14b, 1               ; toggle quote state
   224 00000136 49FFC5                      inc r13
   225 00000139 EBE2                        jmp .chain_scan
   226                                  
   227                                  .chain_break:
   228                                      ; Found ; at r13 (outside quotes)
   229                                      ; Copy segment [r12 .. r13) into line_buf
   230 0000013B 4155                        push r13                  ; save scan pointer
   231 0000013D 4C89E6                      mov rsi, r12
   232 00000140 48BF-                       mov rdi, line_buf
   232 00000142 [E0B8010000000000] 
   233                                  .chain_copy:
   234 0000014A 8A06                        mov al, [rsi]
   235 0000014C 3C3B                        cmp al, ';'
   236 0000014E 740E                        je .chain_copy_done
   237 00000150 84C0                        test al, al
   238 00000152 740A                        je .chain_copy_done
   239 00000154 8807                        mov [rdi], al
   240 00000156 48FFC7                      inc rdi
   241 00000159 48FFC6                      inc rsi
   242 0000015C EBEC                        jmp .chain_copy
   243                                  .chain_copy_done:
   244 0000015E C60700                      mov byte [rdi], 0         ; null-terminate line_buf
   245                                  
   246                                      ; Tokenize (and, if a "~" pipe is present, split/capture/rejoin) and
   247                                      ; dispatch the segment - see process_segment below.
   248 00000161 E8F9000000                  call process_segment
   249                                  
   250                                  .chain_skip:
   251 00000166 415D                        pop r13                   ; restore scan pointer (points to ;)
   252 00000168 49FFC5                      inc r13                   ; advance past ;
   253 0000016B 4D89EC                      mov r12, r13              ; r12 = start of next segment
   254 0000016E EBAD                        jmp .chain_scan
   255                                  
   256                                  .chain_done:
