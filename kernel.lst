   631                              <1> ; ------------------------------------------------------------
   632                              <1> ; party_exec: walks the token stream produced by party_lex and runs
   633                              <1> ; it. v0.1-of-v0.1: `display <literal>` statements (string/int/float/
   634                              <1> ; true/false, optional leading unary minus on a number) and `while
   635                              <1> ; (true|false) { ... }` loops with a bare boolean-literal condition
   636                              <1> ; are runnable now. vars/if/func are next - hitting one right now
   637                              <1> ; reports it as an unsupported-statement error rather than silently
   638                              <1> ; doing nothing, so scripts fail loudly instead of quietly.
   639                              <1> ; Out: party_exec_ok = 1 success, 0 failure (+ party_error_line set).
   640                              <1> ; ------------------------------------------------------------
   641                              <1> party_exec:
   642 0000A2C3 53                  <1>     push rbx
   643 0000A2C4 4154                <1>     push r12
   644 0000A2C6 4155                <1>     push r13
   645 0000A2C8 4156                <1>     push r14
   646 0000A2CA 4157                <1>     push r15
   647 0000A2CC 4D31ED              <1>     xor r13, r13                  ; token cursor
   648 0000A2CF C60425[01A90000]01  <1>     mov byte [party_exec_ok], 1
   649 0000A2D7 C60425[02A90000]00  <1>     mov byte [party_killed], 0
   650 0000A2DF C60425[37A50300]00  <1>     mov byte [kill_flag], 0
   651                              <1> 
   652 0000A2E7 41BE00000000        <1>     mov r14, TOK_EOF               ; top level runs until EOF
   653 0000A2ED E80A000000          <1>     call party_exec_stmts
   654                              <1> 
