   591 00038B90 83F820              <1>     cmp eax, 32
   592 00038B93 7605                <1>     jbe .hk_copylen_ok
   593 00038B95 B820000000          <1>     mov eax, 32
   594                              <1> .hk_copylen_ok:
   595 00038B9A 488D3425[00EF0300]  <1>     lea rsi, [hkdf_t]
   596 00038BA2 4889DF              <1>     mov rdi, rbx
   597 00038BA5 4C01CF              <1>     add rdi, r9
   598 00038BA8 89C1                <1>     mov ecx, eax
   599 00038BAA F3A4                <1>     rep movsb
   600 00038BAC 4101C1              <1>     add r9d, eax
   601                              <1> 
   602 00038BAF FF0425[24EF0300]    <1>     inc dword [hkdf_counter]
   603 00038BB6 E932FFFFFF          <1>     jmp .hk_round
   604                              <1> .hk_done:
   605 00038BBB 415F                <1>     pop r15
   606 00038BBD 415E                <1>     pop r14
   607 00038BBF 415D                <1>     pop r13
   608 00038BC1 415C                <1>     pop r12
   609 00038BC3 4159                <1>     pop r9
   610 00038BC5 4158                <1>     pop r8
   611 00038BC7 5F                  <1>     pop rdi
   612 00038BC8 5E                  <1>     pop rsi
   613 00038BC9 5A                  <1>     pop rdx
   614 00038BCA 59                  <1>     pop rcx
   615 00038BCB 5B                  <1>     pop rbx
   616 00038BCC 58                  <1>     pop rax
