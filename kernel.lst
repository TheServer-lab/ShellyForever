  9395                                  ; --- scancode set 1 -> ascii tables (index = scancode, 0..0x39) ---
  9396 000100C2 90<rep 6h>              ALIGN 8
  9397                                  kbd_unshift:
  9398 000100C8 001B31323334353637-         db 0,27,'1','2','3','4','5','6','7','8'      ; 0x00-0x09
  9398 000100D1 38                 
  9399 000100D2 39302D3D0809                db '9','0','-','=',8,9                        ; 0x0A-0x0F
  9400 000100D8 71776572747975696F-         db 'q','w','e','r','t','y','u','i','o','p'    ; 0x10-0x19
  9400 000100E1 70                 
  9401 000100E2 5B5D0D00                    db '[',']',13,0                                ; 0x1A-0x1D
  9402 000100E6 6173646667686A6B6C-         db 'a','s','d','f','g','h','j','k','l',';'    ; 0x1E-0x27
  9402 000100EF 3B                 
  9403 000100F0 2760005C                    db 39,'`',0,'\'                                ; 0x28-0x2B
  9404 000100F4 7A786376626E6D2C2E-         db 'z','x','c','v','b','n','m',',','.','/'    ; 0x2C-0x35
  9404 000100FD 2F                 
  9405 000100FE 002A0020                    db 0,'*',0,' '                                 ; 0x36-0x39
  9406                                  
  9407                                  kbd_shift:
  9408 00010102 001B21402324255E26-         db 0,27,'!','@','#','$','%','^','&','*'       ; 0x00-0x09
  9408 0001010B 2A                 
  9409 0001010C 28295F2B0809                db '(',')','_','+',8,9                         ; 0x0A-0x0F
  9410 00010112 51574552545955494F-         db 'Q','W','E','R','T','Y','U','I','O','P'    ; 0x10-0x19
  9410 0001011B 50                 
  9411 0001011C 7B7D0D00                    db '{','}',13,0                                ; 0x1A-0x1D
  9412 00010120 4153444647484A4B4C-         db 'A','S','D','F','G','H','J','K','L',':'    ; 0x1E-0x27
  9412 00010129 3A                 
  9413 0001012A 227E007C                    db 34,'~',0,'|'                                ; 0x28-0x2B
  9414 0001012E 5A584356424E4D3C3E-         db 'Z','X','C','V','B','N','M','<','>','?'    ; 0x2C-0x35
  9414 00010137 3F                 
  9415 00010138 002A0020                    db 0,'*',0,' '                                 ; 0x36-0x39
  9416                                  
  9417                                  ; --- filesystem storage ---
  9418                                  ; One flat node table shared by every mounted volume. The OS volume lives
  9419                                  ; in nodes 0..OS_NODES; mount slot k owns nodes VOL_NODES*(k+1)..VOL_NODES*(k+2)-1.
  9420                                  ; Each volume is persisted separately (superblock + node arrays) to its own
  9421                                  ; device - see the SFFS v2 layout notes near the top of this file.
  9422                                  ;
  9423                                  ; IMPORTANT: ata_read_sector/ata_write_sector always move a full 512-byte
  9424                                  ; sector, so every buffer a sector is staged in/out of must hold 512 bytes.
  9425                                  ; node_type and fs_parent_scratch are exactly that: the type/parent reads
  9426                                  ; in vol_read/vol_write go straight at a whole sector each, and anything
  9427                                  ; smaller would silently overflow into the adjacent arrays (which showed up
  9428                                  ; as a black screen after 'mount' corrupted the node table).
  9429 0001013C 90<rep 4h>              ALIGN 8
  9430 00010140 00<rep 200h>            fs_super_buf:   times 512 db 0        ; scratch for reading/building superblocks
  9431 00010340 00<rep 28h>             fmt_new_label:      times 40 db 0     ; label being applied by the current 'fmt'
  9432 00010368 00<rep 28h>             orig_label_buf:      times 40 db 0    ; scratch: a device's generated "diskN" label
  9433 00010390 00<rep Ch>              orig_label_num_tmp:  times 12 db 0    ; scratch: decimal digits for gen_orig_label
  9434 0001039C 00<rep 200h>            fs_parent_scratch: times 512 db 0     ; staging for one full parent sector (512B)
  9435 0001059C 00<rep 40h>             mount_label:   times MAX_MOUNTS*32 db 0     ; label of each mounted volume
  9436 000105DC 00<rep 2h>              mount_device:  times MAX_MOUNTS db 0        ; device id each volume came from
  9437 000105DE 00<rep 2h>              mount_used:    times MAX_MOUNTS db 0        ; 1 = slot in use
  9438                                  ; type sector = 512B per volume (base 0/64/128), so this must span the max
  9439                                  ; extent of a sector write: base + 512. node indices still index it by node
  9440                                  ; (1 byte per node); the per-volume padding holds whatever the sector has.
  9441 000105E0 00<rep 600h>            node_type:    times 512 * (1 + MAX_MOUNTS) db 0
  9442 00010BE0 0000<rep C0h>           node_parent:  times MAX_NODES dw 0
  9443 00010D60 00<rep 1800h>           node_name:    times MAX_NODES*NAME_LEN db 0
  9444 00012560 00<rep 7800h>           node_content: times MAX_NODES*CONTENT_LEN db 0
  9445 00019D60 FFFF<rep C0h>           node_next:    times MAX_NODES dw 0xFFFF   ; 0xFFFF = end of chain (or no chain)
  9446                                  
  9447 00019EE0 00                      fs_loaded_from_disk: db 0
  9448 00019EE1 01                      fs_disk_available:   db 1     ; optimistic default; cleared on first ATA failure
  9449 00019EE2 00                      fs_name_too_long:    db 0     ; set by fs_create_node when a name won't fit
  9450 00019EE3 00                      fs_layout_v3:        db 0     ; set by vol_read: 1 = on-disk v3 (has node_next sector)
  9451                                  
  9452 00019EE4 00                      mkfl_test_flag:      db 0     ; set by cmd_mkfl when -test appears in arg2/3/4
  9453 00019EE5 90<rep 3h>              ALIGN 8
  9454 00019EE8 0000000000000000        mkfl_content_ptr:     dq 0     ; points at the effective content string for -test reporting
  9455                                  
  9456                                  ALIGN 8
  9457 00019EF0 F001                    ata_port_base: dw 0x1F0        ; 0x1F0 primary channel, 0x170 secondary
  9458 00019EF2 E0                      ata_drive_sel: db 0xE0         ; 0xE0 master, 0xF0 slave
  9459                                  
  9460                                  ; --- AHCI (SATA) driver state ---
  9461 00019EF3 00                      pci_scratch_hdrtype: db 0
  9462 00019EF4 00                      ahci_pci_bus:     db 0
  9463 00019EF5 00                      ahci_pci_dev:     db 0
  9464 00019EF6 00                      ahci_pci_func:    db 0
  9465 00019EF7 90                      ALIGN 4
  9466 00019EF8 00000000                ahci_abar:        dd 0             ; physical base of the AHCI MMIO register window
  9467 00019EFC 00000000                ahci_ports_impl:  dd 0             ; PI bitmap read from the HBA at boot
  9468 00019F00 00                      ahci_port_count:  db 0             ; how many of ahci_port_num/base are valid
  9469 00019F01 00000000<rep 4h>        ahci_port_num:    times AHCI_MAX_PORTS dd 0   ; slot -> real HBA port number
  9470 00019F11 90<rep 7h>              ALIGN 8
  9471 00019F18 0000000000000000-       ahci_port_base:   times AHCI_MAX_PORTS dq 0   ; slot -> port register base ptr
  9471 00019F18 <rep 4h>           
  9472 00019F38 00                      disk_use_ahci:    db 0             ; set by disk_select_device: 0=ATA, 1=AHCI
  9473 00019F39 00                      ahci_cur_slot:    db 0             ; which AHCI slot is currently selected
  9474 00019F3A 00                      ahci_op_cmd:      db 0             ; pending ATA command byte (read vs write)
  9475 00019F3B 00                      ahci_op_write:    db 0             ; 1 if the pending op is a write
  9476                                  
  9477                                  ; Command list (1KB/port, must be 1KB-aligned), FIS receive area (256B/port,
  9478                                  ; must be 256B-aligned), and command table (256B/port, must be 128B-aligned,
  9479                                  ; and big enough for a 20-byte Reg H2D FIS plus one 16-byte PRDT entry) for
  9480                                  ; each AHCI port slot we bring up. Identity-mapped, so these labels' linked
  9481                                  ; addresses double as the physical addresses the HBA needs - same trick the
  9482                                  ; rest of this file already relies on for fs_super_buf and friends.
  9483 00019F3C 90<rep C4h>             ALIGN 1024
  9484 0001A000 00<rep 1000h>           ahci_clb:    times AHCI_MAX_PORTS*1024 db 0
  9485                                  ALIGN 256
  9486 0001B000 00<rep 400h>            ahci_fis:    times AHCI_MAX_PORTS*256 db 0
  9487                                  ALIGN 128
  9488 0001B400 00<rep 400h>            ahci_cmdtbl: times AHCI_MAX_PORTS*256 db 0
  9489                                  
  9490 0001B800 0000<rep 10h>           path_stack:   times 16 dw 0
  9491                                  
  9492                                  ; --- scratch for fs_resolve_path ---
  9493 0001B820 00<rep 40h>             path_comp_buf: times 64 db 0     ; one path component at a time
  9494 0001B860 00<rep 40h>             leaf1_buf:      times 64 db 0    ; resolved leaf name for arg1_buf paths
  9495 0001B8A0 00<rep 40h>             leaf2_buf:      times 64 db 0    ; resolved leaf name for arg2_buf paths
  9496                                  
  9497                                  ; --- line editing buffers ---
  9498 0001B8E0 00<rep DCh>             line_buf: times LINE_MAX db 0
  9499 0001B9BC 00<rep DCh>             chain_scan_buf: times LINE_MAX db 0  ; scratch copy for ; chaining
  9500 0001BA98 00<rep 20h>             cmd_buf:  times 32  db 0
  9501 0001BAB8 00<rep 60h>             arg1_buf: times 96  db 0
  9502 0001BB18 00<rep A0h>             arg2_buf: times 160 db 0
  9503 0001BBB8 00<rep 20h>             arg3_buf: times 32  db 0             ; for flags (-force, -silent, -info)
  9504 0001BBD8 00<rep 20h>             arg4_buf: times 32  db 0             ; for additional flags
  9505                                  
  9506                                  ; --- "~" pipe scratch (see process_segment) ---
  9507 0001BBF8 00                      chain_is_rr:       db 0             ; 0 = process_chain, 1 = process_chain_rr
  9508 0001BBF9 00<rep DCh>             pipe_left_buf:     times LINE_MAX db 0
  9509 0001BCD5 00<rep DCh>             pipe_right_buf:    times LINE_MAX db 0
  9510 0001BDB1 00                      pipe_capture_on:   db 0
  9511 0001BDB2 90<rep 6h>              ALIGN 8
  9512 0001BDB8 0000000000000000        pipe_capture_len:  dq 0
  9513 0001BDC0 00<rep C0h>             pipe_capture_buf:  times PIPE_CAP_MAX db 0
  9514 0001BE80 2200                    pipe_quote_str:       db '"', 0
  9515 0001BE82 202200                  pipe_space_quote_str: db ' ', '"', 0
  9516                                  
  9517                                  ; --- variables table (used by assignment, show, and calc) ---
  9518 0001BE85 90<rep 3h>              ALIGN 8
  9519 0001BE88 00<rep 200h>            var_name:  times MAX_VARS*VAR_NAME_LEN db 0
  9520 0001C088 0000000000000000-       var_value: times MAX_VARS dq 0
  9520 0001C088 <rep 10h>          
  9521 0001C108 00<rep 10h>             var_used:  times MAX_VARS db 0
  9522                                  
  9523 0001C118 00<rep 180h>            alias_names:  times MAX_ALIASES*ALIAS_NAME_LEN db 0
  9524 0001C298 00<rep A50h>            alias_bodies: times MAX_ALIASES*ALIAS_BODY_LEN db 0
  9525 0001CCE8 00<rep Ch>              alias_used:   times MAX_ALIASES db 0
  9526 0001CCF4 00<rep 20h>             ali_name_tmp: times ALIAS_NAME_LEN db 0   ; scratch: name parsed by try_handle_ali_line
  9527 0001CD14 00<rep DCh>             ali_body_tmp: times ALIAS_BODY_LEN db 0   ; scratch: body parsed by try_handle_ali_line
  9528 0001CDF0 00                      alias_match_idx: db 0                     ; set by dispatch before jmp cmd_alias_invoke
  9529 0001CDF1 00                      alias_depth:     db 0                     ; nested alias-invocation depth (recursion guard)
  9530                                  
  9531                                  ; --- calc evaluator scratch ---
  9532 0001CDF2 90<rep 6h>              ALIGN 8
  9533 0001CDF8 0000000000000000-       calc_vals:  times MAX_CALC_TOKENS dq 0
  9533 0001CDF8 <rep 20h>          
  9534 0001CEF8 0000000000000000-       calc_vals2: times MAX_CALC_TOKENS dq 0
  9534 0001CEF8 <rep 20h>          
  9535 0001CFF8 00<rep 20h>             calc_ops:   times MAX_CALC_TOKENS db 0
  9536 0001D018 00<rep 20h>             calc_ops2:  times MAX_CALC_TOKENS db 0
  9537 0001D038 00<rep 18h>             calc_out_buf: times 24 db 0
  9538 0001D050 00<rep 18h>             show_num_buf: times 24 db 0
  9539 0001D068 00<rep 18h>             dev_name_num_buf: times 24 db 0
  9540 0001D080 00<rep 28h>             ident_buf:  times 40 db 0
  9541                                  
  9542                                  ; --- process table for rush scripts ---
  9543                                  MAX_PROCESSES equ 4
  9544 0001D0A8 0000<rep 4h>            proc_id:       times MAX_PROCESSES dw 0
  9545 0001D0B0 00<rep 80h>             proc_name:     times MAX_PROCESSES*32 db 0
  9546 0001D130 00<rep 4h>              proc_state:    times MAX_PROCESSES db 0    ; 0=free, 1=running, 2=killed
  9547 0001D134 0100                    proc_next_pid: dw 1
  9548 0001D136 00                      proc_cur_slot: db 0                         ; slot index of currently running script
  9549 0001D137 00                      kill_flag:     db 0                         ; set by Esc key or prs kill
  9550 0001D138 0000000000000000        rr_content_ptr: dq 0                         ; cursor into script file content
  9551                                  
  9552                                  ; --- large staging buffers. A file can span a whole 64-node volume slice, so
  9553                                  ; these are sized to hold a full file's content (EDIT_MAX). Declared at the
  9554                                  ; very end of the file, after all code, so any growth doesn't move anything. ---
  9555 0001D140 00<rep 200h>            fs_next_scratch: times 512 db 0     ; staging for one full node_next sector
  9556 0001D340 00<rep 2800h>           fs_io_buf:  times EDIT_MAX db 0     ; editor + view/read/copy staging for multi-block files
