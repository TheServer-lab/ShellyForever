 16262 00070C8F B080                        mov al, 0x80               ; DLAB = 1
 16263 00070C91 EE                          out dx, al
 16264 00070C92 66BAF803                    mov dx, 0x3F8
 16265 00070C96 B001                        mov al, 0x01               ; divisor 1 -> 115200 baud
 16266 00070C98 EE                          out dx, al
 16267 00070C99 66BAF903                    mov dx, 0x3F9
 16268 00070C9D 30C0                        xor al, al
 16269 00070C9F EE                          out dx, al
 16270 00070CA0 66BAFB03                    mov dx, 0x3FB
 16271 00070CA4 B003                        mov al, 0x03               ; 8N1, DLAB = 0
 16272 00070CA6 EE                          out dx, al
 16273 00070CA7 66BAFA03                    mov dx, 0x3FA
