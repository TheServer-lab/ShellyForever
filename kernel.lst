 10106                                  ; ---- I/O helpers -------------------------------------------------
 10107                                  ; nic_io_read8/16/32: edi = port -> al/ax/eax
 10108                                  nic_io_read8:
 10109 0001858E 6689FA                      mov dx, di
 10110 00018591 EC                          in al, dx
 10111 00018592 C3                          ret
 10112                                  nic_io_read16:
 10113 00018593 6689FA                      mov dx, di
 10114 00018596 66ED                        in ax, dx
 10115 00018598 C3                          ret
 10116                                  nic_io_read32:
 10117 00018599 6689FA                      mov dx, di
 10118 0001859C ED                          in eax, dx
 10119 0001859D C3                          ret
 10120                                  ; nic_io_write8/16/32: edi = port, data in al/ax/eax
 10121                                  nic_io_write8:
 10122 0001859E 6689FA                      mov dx, di
 10123 000185A1 EE                          out dx, al
 10124 000185A2 C3                          ret
 10125                                  nic_io_write16:
 10126 000185A3 6689FA                      mov dx, di
 10127 000185A6 66EF                        out dx, ax
 10128 000185A8 C3                          ret
 10129                                  nic_io_write32:
 10130 000185A9 6689FA                      mov dx, di
 10131 000185AC EF                          out dx, eax
 10132 000185AD C3                          ret
 10133                                  ; nic_io_read_block: edi = start port, rsi = dst, rcx = byte count
 10134                                  nic_io_read_block:
 10135 000185AE 50                          push rax
 10136 000185AF 51                          push rcx
 10137 000185B0 57                          push rdi
 10138 000185B1 56                          push rsi
 10139                                  .bloop:
 10140 000185B2 6689FA                      mov dx, di
 10141 000185B5 EC                          in al, dx
 10142 000185B6 8806                        mov [rsi], al
 10143 000185B8 FFC7                        inc edi
 10144 000185BA 48FFC6                      inc rsi
 10145 000185BD 48FFC9                      dec rcx
 10146 000185C0 75F0                        jnz .bloop
 10147 000185C2 5E                          pop rsi
 10148 000185C3 5F                          pop rdi
 10149 000185C4 59                          pop rcx
 10150 000185C5 58                          pop rax
 10151 000185C6 C3                          ret
 10152                                  
 10153                                  ; rtc_sec_now: eax = current RTC seconds (0..59), zero-extended. Used for
 10154                                  ; coarse 1s-granularity timeouts in the ARP / ICMP / DNS wait loops.
 10155                                  rtc_sec_now:
 10156 000185C7 53                          push rbx
 10157 000185C8 52                          push rdx
 10158                                  .rsn_retry:
 10159 000185C9 E8852A0000                  call rtc_wait_uip            ; don't read while the RTC is mid-update
 10160 000185CE B000                        mov al, 0x00
 10161 000185D0 E8692A0000                  call cmos_read
 10162 000185D5 88C3                        mov bl, al                   ; first reading
 10163 000185D7 E8772A0000                  call rtc_wait_uip            ; guard again in case an update started
 10164                                                                    ; between our address-select and data read
 10165 000185DC B000                        mov al, 0x00
 10166 000185DE E85B2A0000                  call cmos_read
 10167 000185E3 38D8                        cmp al, bl
 10168 000185E5 75E2                        jne .rsn_retry                ; two reads disagree - torn/transient, retry
 10169                                      ; BUGFIX: this used to return the raw CMOS byte unconverted. Real
 10170                                      ; hardware defaults to BCD mode (status B bit2 clear), same as
 10171                                      ; rtc_update already accounts for - so a seconds value of "10" comes
 10172                                      ; back as the byte 0x10 (16 decimal), "20" as 0x20 (32 decimal), etc.
 10173                                      ; Tick DETECTION (a plain inequality compare against the previous
 10174                                      ; reading) still fired correctly every real second regardless, so the
 10175                                      ; wait loop's actual budget was never shortened by this - but the
 10176                                      ; elapsed-time SUBTRACTION in the error path assumes plain binary
 10177                                      ; 0..59 seconds, so once start/end straddle a tens-digit boundary the
 10178                                      ; math comes out wrong (this is why a real ~5-6s wait was being
 10179                                      ; reported as "elapsed: 0" in netdiag_dump_tx). Mirror rtc_update's
 10180                                      ; own check of status register B bit2 rather than assuming BCD
 10181                                      ; unconditionally - only convert if the chip is actually in BCD mode.
 10182 000185E7 50                          push rax
 10183 000185E8 B00B                        mov al, 0x0B
 10184 000185EA E84F2A0000                  call cmos_read
 10185 000185EF A804                        test al, 0x04
 10186 000185F1 750D                        jnz .rsn_binary               ; bit2 set = already binary, nothing to do
 10187 000185F3 58                          pop rax
 10188 000185F4 88D8                        mov al, bl
 10189 000185F6 E8662A0000                  call bcd_to_bin
 10190 000185FB 0FB6C0                      movzx eax, al
 10191 000185FE EB04                        jmp .rsn_done
 10192                                  .rsn_binary:
 10193 00018600 58                          pop rax
 10194 00018601 0FB6C3                      movzx eax, bl
 10195                                  .rsn_done:
 10196 00018604 5A                          pop rdx
 10197 00018605 5B                          pop rbx
 10198 00018606 C3                          ret
 10199                                  
 10200                                  ; ---- PCI ---------------------------------------------------------
 10201                                  ; pci_find_nic: scans bus 0 for vendor 10EC device 8139. Returns CF=0 and
 10202                                  ; nic_pci_bus/dev/func set, or CF=1.
 10203                                  ; pci_find_nic: brute-force scan of every PCI bus (0..255), every device
 10204                                  ; (0..31), function 0 first and then functions 1..7 if the header-type byte
 10205                                  ; says the device is multi-function - matching vendor 0x10EC/device 0x8139.
 10206                                  ; A bus-0-only scan (the original version of this routine) finds nothing on
 10207                                  ; real hardware, where the NIC typically sits behind a PCIe root port on a
 10208                                  ; non-zero bus; QEMU's flat topology just happened to put it on bus 0.
 10209                                  ; Returns CF=0 and nic_pci_bus/dev/func set, or CF=1.
 10210                                  pci_find_nic:
 10211 00018607 50                          push rax
 10212 00018608 53                          push rbx
 10213 00018609 51                          push rcx
 10214 0001860A 52                          push rdx
 10215 0001860B 4150                        push r8
 10216 0001860D 4151                        push r9
 10217 0001860F 4153                        push r11
 10218 00018611 31DB                        xor ebx, ebx                     ; bus
 10219                                  .pbus_loop:
 10220 00018613 81FB00010000                cmp ebx, 256
 10221 00018619 7371                        jae .pnot_found
 10222 0001861B 31C9                        xor ecx, ecx                     ; device
 10223                                  .pdev_loop:
 10224 0001861D 83F920                      cmp ecx, 32
 10225 00018620 7366                        jae .pnext_bus
 10226 00018622 31D2                        xor edx, edx                     ; try function 0 first
 10227 00018624 4D31C0                      xor r8, r8
 10228 00018627 E818F5FFFF                  call pci_read32
 10229 0001862C 83F8FF                      cmp eax, 0xFFFFFFFF
 10230 0001862F 7453                        je .pnext_dev                    ; nothing at this slot at all
 10231 00018631 663DEC10                    cmp ax, NIC_VENDOR_ID
 10232 00018635 7509                        jne .pf0_no_match
 10233 00018637 C1E810                      shr eax, 16
 10234 0001863A 663D3981                    cmp ax, NIC_DEVICE_ID
 10235 0001863E 7458                        je .pfound
 10236                                  .pf0_no_match:
 10237 00018640 31D2                        xor edx, edx
 10238 00018642 41B80C000000                mov r8, 0x0C                     ; header-type dword
 10239 00018648 E8F7F4FFFF                  call pci_read32
 10240 0001864D C1E810                      shr eax, 16
 10241 00018650 A880                        test al, 0x80                    ; multi-function bit
 10242 00018652 7430                        jz .pnext_dev                    ; single-function: nothing more here
 10243 00018654 41BB01000000                mov r11d, 1
 10244                                  .pfunc_loop:
 10245 0001865A 4183FB08                    cmp r11d, 8
 10246 0001865E 7324                        jae .pnext_dev
 10247 00018660 4489DA                      mov edx, r11d
 10248 00018663 4D31C0                      xor r8, r8
 10249 00018666 E8D9F4FFFF                  call pci_read32
 10250 0001866B 83F8FF                      cmp eax, 0xFFFFFFFF
 10251 0001866E 740F                        je .pfunc_next
 10252 00018670 663DEC10                    cmp ax, NIC_VENDOR_ID
 10253 00018674 7509                        jne .pfunc_next
 10254 00018676 C1E810                      shr eax, 16
 10255 00018679 663D3981                    cmp ax, NIC_DEVICE_ID
 10256 0001867D 7419                        je .pfound
 10257                                  .pfunc_next:
 10258 0001867F 41FFC3                      inc r11d
 10259 00018682 EBD6                        jmp .pfunc_loop
 10260                                  .pnext_dev:
 10261 00018684 FFC1                        inc ecx
 10262 00018686 EB95                        jmp .pdev_loop
 10263                                  .pnext_bus:
 10264 00018688 FFC3                        inc ebx
 10265 0001868A EB87                        jmp .pbus_loop
 10266                                  .pnot_found:
 10267 0001868C 415B                        pop r11
 10268 0001868E 4159                        pop r9
 10269 00018690 4158                        pop r8
 10270 00018692 5A                          pop rdx
 10271 00018693 59                          pop rcx
 10272 00018694 5B                          pop rbx
 10273 00018695 58                          pop rax
 10274 00018696 F9                          stc
 10275 00018697 C3                          ret
 10276                                  .pfound:
 10277 00018698 881C25[ADE80500]            mov [nic_pci_bus], bl
 10278 0001869F 880C25[AEE80500]            mov [nic_pci_dev], cl
 10279 000186A6 881425[AFE80500]            mov [nic_pci_func], dl
 10280 000186AD 415B                        pop r11
 10281 000186AF 4159                        pop r9
 10282 000186B1 4158                        pop r8
 10283 000186B3 5A                          pop rdx
 10284 000186B4 59                          pop rcx
 10285 000186B5 5B                          pop rbx
 10286 000186B6 58                          pop rax
 10287 000186B7 F8                          clc
 10288 000186B8 C3                          ret
