  9816 0000883E 415D                        pop r13
  9817 00008840 415C                        pop r12
  9818 00008842 415A                        pop r10
  9819 00008844 4159                        pop r9
  9820 00008846 4158                        pop r8
  9821 00008848 5A                          pop rdx
  9822 00008849 59                          pop rcx
  9823 0000884A 5B                          pop rbx
  9824 0000884B C3                          ret
