  9751 000182E3 4D89C1                      mov r9, r8
  9752 000182E6 4901C9                      add r9, rcx
  9753 000182E9 41C681[508A0300]00          mov byte [node_type + r9], 0
  9754 000182F1 6643C78409-                 mov word [node_parent + r9*2], 0
  9754 000182F6 [50900300]0000     
  9755 000182FC 6643C78409-                 mov word [node_next + r9*2], 0xFFFF
  9755 00018301 [50D60500]FFFF     
  9756 00018307 4C89CF                      mov rdi, r9
