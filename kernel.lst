  3602                                                                        ; (r10 isn't guaranteed to survive print calls)
  3603 000134B3 C1E810                      shr eax, 16
  3604 000134B6 48BE-                       mov rsi, msg_diag_pcists
  3604 000134B8 [CC48030000000000] 
  3605 000134C0 50                          push rax
  3606 000134C1 8A0425[C4D70200]            mov al, [cur_normal_attr]
  3607 000134C8 E83F950100                  call print_string_attr
  3608 000134CD 58                          pop rax
