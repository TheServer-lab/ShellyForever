   399                                  
   400                                  ; ------------------------------------------------------------
   401                                  ; process_segment: called with a single ;-delimited command segment
   402                                  ; sitting null-terminated in line_buf (chain_is_rr says whether this
   403                                  ; came from process_chain or process_chain_rr, which changes how
   404                                  ; do_dispatch_call below wraps dispatch). Looks for a "~" outside
   405                                  ; double quotes:
   406                                  ;
   407                                  ;   left ~ right
   408                                  ;
   409                                  ; If none is found, this is exactly the original behaviour: tokenize
   410                                  ; line_buf and dispatch it.
   411                                  ;
   412                                  ; If one is found, "left" is run with its output captured instead of
   413                                  ; printed (e.g. calc's printed result, a variable's show'd value, a
   414                                  ; file's view'd content). "right" is then either:
   415                                  ;   - "= name" or "=name"  -> the captured text is parsed as a decimal
   416                                  ;     integer and stored into that variable (same rules as ordinary
   417                                  ;     "name = value" assignment).
   418                                  ;   - any other command    -> the captured text is appended to it as
   419                                  ;     one extra quoted argument and the whole thing is dispatched, e.g.
   420                                  ;     "calc 2+2 ~ show" becomes "show 4".
   421                                  ;
   422                                  ; Example: calc 1 + 1 * 5 ~ = a ; show a   -->  prints 6
   423                                  process_segment:
   424 00000289 53                          push rbx
   425 0000028A 4154                        push r12
   426 0000028C 4156                        push r14
   427                                  
   428                                      ; --- scan line_buf for '~' outside double quotes ---
   429 0000028E 48BE-                       mov rsi, line_buf
   429 00000290 [E08C030000000000] 
   430 00000298 4D31F6                      xor r14, r14              ; r14b = quote state (0=outside, 1=inside)
   431 0000029B 4D31E4                      xor r12, r12               ; r12 = pointer to '~' (0 = none found)
   432                                  .pseg_scan:
   433 0000029E 8A06                        mov al, [rsi]
