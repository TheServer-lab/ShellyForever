 17636 00071A15 90<rep 3h>              ALIGN 8
 17637 00071A18 00                      cursor_row:   db 0
 17638 00071A19 00                      cursor_col:   db 0
 17639 00071A1A 00                      shift_state:  db 0
 17640 00071A1B 0000000000000000        cur_dir:      dq 0
 17641 00071A23 00                      auth_valid:   db 0                   ; set by 'auth' command, checked by dangerous commands
 17642 00071A24 0A                      cur_normal_attr: db ATTR_NORMAL      ; foreground color used for normal output; changed by 'color'
 17643                                  
 17644                                  ; --- keyboard/scrollback/history state ---
 17645 00071A25 00                      ctrl_state:    db 0                  ; 1 while either Ctrl key is held
 17646 00071A26 00                      edit_active:   db 0                  ; 1 while cmd_edit's editor loop owns the keyboard -
 17647                                                                        ; makes plain Up/Down scroll the view instead of
 17648                                                                        ; being treated as shell command history
 17649                                  
 17650                                  ; --- cmd_edit .ce_render scratch: the render pass streams fs_io_buf through
 17651                                  ; putchar (which is the only thing allowed to touch cursor_row/cursor_col
 17652                                  ; and trigger wraps), so it can't just compute the cursor's screen position
 17653                                  ; ahead of time - it captures cursor_row/cursor_col live, the instant the
 17654                                  ; render reaches the cursor's buffer index, into these, then restores them
 17655                                  ; once the whole visible page has been drawn. ---
 17656 00071A27 00                      ce_cursor_captured: db 0
 17657 00071A28 00                      ce_saved_row:       db 0
 17658 00071A29 00                      ce_saved_col:       db 0
 17659 00071A2A 00                      kbd_ext_flag:  db 0                  ; 1 while waiting for the byte after an 0xE0 prefix
 17660 00071A2B 00                      scroll_offset: db 0                  ; 0 = live view, N = N lines scrolled back
 17661 00071A2C 00                      sb_write_idx:  db 0                  ; next slot to write in scrollback_buf (ring)
 17662 00071A2D 00                      sb_count:      db 0                  ; valid lines currently stored in scrollback_buf
 17663 00071A2E 00                      history_next:  db 0                  ; next slot to write in history_buf (ring)
 17664 00071A2F 00                      history_count: db 0                  ; valid entries currently stored in history_buf
 17665 00071A30 00                      history_nav:   db 0                  ; 0 = not browsing history, else 1..history_count deep
 17666                                  
 17667 00071A31 90<rep 7h>              ALIGN 8
 17668 00071A38 00<rep 3E80h>           scrollback_buf:     times SCROLLBACK_LINES*VGA_COLS*2 db 0
 17669 000758B8 00<rep FA0h>            live_snapshot:       times VGA_ROWS*VGA_COLS*2 db 0
 17670 00076858 00<rep 1130h>           history_buf:         times HISTORY_MAX*LINE_MAX db 0
 17671 00077988 00<rep DCh>             history_saved_line:  times LINE_MAX db 0
