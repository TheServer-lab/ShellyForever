  1500 0002708A B904000000          <1>     mov rcx, PARTY_ARR_MAX
  1501 0002708F E8E70D0000          <1>     call party_memzero
  1502                              <1> 
  1503 00027094 E8FF020000          <1>     call party_collect_funcs
