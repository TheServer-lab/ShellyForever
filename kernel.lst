   776                                  ; ------------------------------------------------------------
   777                                  ; expand_identity_map: extends boot.asm's minimal 0-64MB identity map to
   778                                  ; a full 0-4GB identity map using 2MB pages.
   779                                  ;
   780                                  ; Bug this fixes: "sdown" was rebooting the machine instead of shutting
   781                                  ; it down. Root cause: boot.asm's page tables only identity-map the
   782                                  ; first 64MB of physical memory (PML4@0x1000 -> PDPT@0x2000 -> a single
   783                                  ; PD@0x3000 with 32 entries). acpi_shutdown later walks the firmware's
   784                                  ; RSDT/XSDT/FADT/DSDT tables to find the real ACPI power-off port/value,
   785                                  ; and those tables are NOT guaranteed to live under 64MB - confirmed by
   786                                  ; tracing this exact machine: the FADT/DSDT land around 127MB with a
   787                                  ; 128MB guest. Touching that unmapped memory takes a page fault, and
   788                                  ; since there's no IDT installed yet, it escalates straight to a triple
   789                                  ; fault - which looks exactly like a reboot from the user's perspective.
   790                                  ;
   791                                  ; Fix: before anything else runs, reuse boot.asm's existing PML4/PDPT
   792                                  ; (no need to touch those) and add 3 more PD tables (PD1-PD3 at
   793                                  ; 0x4000/0x5000/0x6000, alongside boot.asm's PD0 at 0x3000), wiring all
   794                                  ; 4 into PDPT[0..3]. Then refill all 4 PDs (contiguous in memory) with
   795                                  ; 2048 sequential 2MB pages, giving a full 4GB identity map - enough
   796                                  ; headroom for any RAM size/firmware table placement QEMU, Bochs,
   797                                  ; VirtualBox, or real hardware is likely to use.
   798                                  expand_identity_map:
   799 00000644 50                          push rax
   800 00000645 51                          push rcx
   801 00000646 57                          push rdi
   802                                  
   803                                      ; PDPT[1..3] -> PD1/PD2/PD3 (present+rw). PDPT[0] already points at
   804                                      ; boot.asm's PD0 @ 0x3000.
   805 00000647 C70425082000000340-         mov dword [0x2000 + 1*8], 0x4000 | 0x3
   805 00000650 0000               
   806 00000652 C704250C2000000000-         mov dword [0x2000 + 1*8 + 4], 0
   806 0000065B 0000               
   807 0000065D C70425102000000350-         mov dword [0x2000 + 2*8], 0x5000 | 0x3
   807 00000666 0000               
   808 00000668 C70425142000000000-         mov dword [0x2000 + 2*8 + 4], 0
   808 00000671 0000               
   809 00000673 C70425182000000360-         mov dword [0x2000 + 3*8], 0x6000 | 0x3
   809 0000067C 0000               
   810 0000067E C704251C2000000000-         mov dword [0x2000 + 3*8 + 4], 0
   810 00000687 0000               
   811                                  
   812                                      ; PD0..PD3 are contiguous (0x3000..0x6FFF = 16KB = 2048 qwords).
   813                                      ; Refill them all with sequential 2MB pages 0, 2MB, ... 4094MB,
   814                                      ; replacing boot.asm's partial PD0 (only entries 0-31 were valid)
   815                                      ; with a complete map.
   816 00000689 BF00300000                  mov rdi, 0x3000
   817 0000068E B883000000                  mov rax, 0x83                  ; present+rw+PS(2MB), base 0
   818 00000693 B900080000                  mov rcx, 512 * 4               ; 512 entries/PD * 4 PDs = 4GB total
   819                                  .fill:
   820 00000698 488907                      mov [rdi], rax
   821 0000069B 480500002000                add rax, 0x200000
   822 000006A1 4883C708                    add rdi, 8
   823 000006A5 E2F1                        loop .fill
   824                                  
   825 000006A7 0F20D8                      mov rax, cr3                   ; reload CR3 to flush any stale TLB
   826 000006AA 0F22D8                      mov cr3, rax                   ; entries from the old partial map
   827                                  
   828 000006AD 5F                          pop rdi
   829 000006AE 59                          pop rcx
   830 000006AF 58                          pop rax
   831 000006B0 C3                          ret
