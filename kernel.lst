 11431                                  ; rtl_phy_power_up_and_renegotiate: mirrors the real-hardware PHY bring-up
 11432                                  ; sequence used by Realtek's own driver source (register page select via
 11433                                  ; 0x1F, clear the power-down bit at 0x0E, then force BMCR reset + enable +
 11434                                  ; restart-autonegotiation at register 0x00). Purely additive - if the PHY
 11435                                  ; was already fine this just makes it renegotiate again, which is harmless.
 11436                                  rtl_phy_power_up_and_renegotiate:
 11437 00019459 50                          push rax
 11438 0001945A 52                          push rdx
 11439                                  
 11440 0001945B B21F                        mov dl, 0x1F
 11441 0001945D 31C0                        xor eax, eax
 11442 0001945F E8A0FFFFFF                  call mdio_write_rtl        ; select PHY register page 0
 11443                                  
 11444 00019464 B20E                        mov dl, 0x0E
 11445 00019466 31C0                        xor eax, eax
 11446 00019468 E897FFFFFF                  call mdio_write_rtl        ; clear power-down bit (page-specific reg)
 11447                                  
 11448 0001946D B200                        mov dl, 0x00                ; BMCR
 11449 0001946F B800920000                  mov eax, 0x9200              ; RESET | ANENABLE | ANRESTART
 11450 00019474 E88BFFFFFF                  call mdio_write_rtl
 11451                                  
 11452 00019479 5A                          pop rdx
 11453 0001947A 58                          pop rax
 11454 0001947B C3                          ret
 11455                                  
 11456                                  ; nic_send_raw: rcx = byte length of the frame already built in nic_tx_buf.
 11457                                  ; Loads TSAD0 with the buffer address, writes the length to TSD0 to trigger
 11458                                  ; the DMA+transmit, then waits for TxStatOk (bit15) in TSD0. Returns CF=0 on
 11459                                  ; success. Callers always wait for completion, so no in-flight TX precedes us.
 11460                                  ;
 11461                                  ; Pad undersized frames up to the Ethernet minimum (60 bytes, before the
 11462                                  ; 4-byte FCS the NIC appends) before handing off to any backend. QEMU's
 11463                                  ; device models are lenient about short frames, but real hardware is not
 11464                                  ; guaranteed to be - this is exactly what was going on with the RTL8168
 11465                                  ; "TX error" on ARP broadcasts (42 bytes): no PCI bus error, no stuck NPQ,
 11466                                  ; the frame eventually completes, just unreliably/late relative to our
 11467                                  ; completion-wait budget. DHCP frames never showed this because they're
 11468                                  ; already well over 60 bytes. Doing this once, here, covers every backend
 11469                                  ; (rtl8139/e1000/rtl8168) instead of patching each short-frame caller.
 11470                                  nic_send_raw:
 11471 0001947C 83F93C                      cmp ecx, 60
 11472 0001947F 7323                        jae .nsr_no_pad
 11473 00019481 50                          push rax
 11474 00019482 51                          push rcx
 11475 00019483 52                          push rdx
 11476 00019484 57                          push rdi
 11477 00019485 89CA                        mov edx, ecx                 ; edx = original frame length (pad start offset)
 11478 00019487 B83C000000                  mov eax, 60
 11479 0001948C 29D0                        sub eax, edx                 ; eax = number of zero pad bytes needed
 11480 0001948E 488DBA[40090600]            lea rdi, [nic_tx_buf + rdx]
 11481 00019495 89C1                        mov ecx, eax
 11482 00019497 30C0                        xor al, al
 11483 00019499 F3AA                        rep stosb
 11484 0001949B 5F                          pop rdi
 11485 0001949C 5A                          pop rdx
 11486 0001949D 59                          pop rcx
 11487 0001949E 58                          pop rax
 11488 0001949F B93C000000                  mov ecx, 60                  ; frame length is now the Ethernet minimum
 11489                                  .nsr_no_pad:
 11490 000194A4 803C25[B4E80500]01          cmp byte [nic_driver_type], 1
 11491 000194AC 0F84A3000000                je nic_send_raw_e1000
 11492 000194B2 803C25[B4E80500]02          cmp byte [nic_driver_type], 2
 11493 000194BA 0F8419010000                je nic_send_raw_rtl8168
 11494 000194C0 50                          push rax
 11495 000194C1 51                          push rcx
 11496 000194C2 52                          push rdx
 11497 000194C3 57                          push rdi
 11498 000194C4 4150                        push r8
 11499 000194C6 4151                        push r9
 11500                                      ; Round-robin the 4 C-mode TX descriptors: QEMU's rtl8139 model only
 11501                                      ; transmits the descriptor at its internal currTxDesc (which advances
 11502                                      ; after every successful TX), so the driver must keep writing the
 11503                                      ; descriptor the chip currently expects. nic_tx_desc tracks that.
 11504                                      ; NOTE: desc*4 lives in r8 because nic_io_write32/read32 clobber dx.
 11505 000194C8 440FB60425-                 movzx r8d, byte [nic_tx_desc]
 11505 000194CD [09E90500]         
 11506 000194D1 41C1E002                    shl r8d, 2
 11507 000194D5 8B3C25[B0E80500]            mov edi, [nic_io_base]
 11508 000194DC 4401C7                      add edi, r8d
 11509 000194DF 83C720                      add edi, NIC_IO_TSAD0
 11510 000194E2 8D0425[40090600]            lea eax, [nic_tx_buf]
 11511 000194E9 E8BBF0FFFF                  call nic_io_write32
 11512 000194EE 8B3C25[B0E80500]            mov edi, [nic_io_base]
 11513 000194F5 4401C7                      add edi, r8d
 11514 000194F8 83C710                      add edi, NIC_IO_TSD0
 11515 000194FB 89C8                        mov eax, ecx
 11516 000194FD 25FFFF0000                  and eax, 0xFFFF
 11517 00019502 E8A2F0FFFF                  call nic_io_write32
 11518 00019507 41B900002000                mov r9, 0x200000
 11519                                  .tsr_wait_done:
 11520 0001950D 8B3C25[B0E80500]            mov edi, [nic_io_base]
 11521 00019514 4401C7                      add edi, r8d
 11522 00019517 83C710                      add edi, NIC_IO_TSD0
