     1                              <1> ; ============================================================
     2                              <1> ; tcp.asm -- minimal polled TCP engine (Milestone C)
     3                              <1> ;
     4                              <1> ; A deliberately tiny TCP client: 3-way handshake (SYN -> SYN-ACK ->
     5                              <1> ; ACK), seq/ack tracking, one retransmit per wait phase, a single
     6                              <1> ; send + receive of up to TCP_PAYLOAD_MAX bytes, and Esc-cancellable
     7                              <1> ; waits. This is the foundation for Milestone D's HTTP take/give.
     8                              <1> ;
     9                              <1> ; Entry points:
    10                              <1> ; tcp_send_segment build + transmit one segment (seq/ack from
    11                              <1> ; tcp_cur_seq / tcp_cur_ack)
    12                              <1> ; tcp_handle_segment called from handle_ipv4 for IP_PROTO_TCP;
    13                              <1> ; rsi = TCP header ptr inside nic_rx_frame
    14                              <1> ; cmd_tcp "tcp <host> <port> [payload]" shell command
    15                              <1> ;
    16                              <1> ; All state lives in the data area at the end of kernel.asm (tcp_*),
    17                              <1> ; declared separately so the module here stays pure code.
    18                              <1> ; ============================================================
    19                              <1> TCP_PAYLOAD_MAX equ 1536 ; fits inside net_build_buf (4096 build area) and
    20                              <1>                               ; nic_tx_buf (2KB): frame = 34 + 20 + 1536 = 1590 < 2048.
    21                              <1>                               ; This is a SEND-side limit only (one segment has to
    22                              <1>                               ; fit in one Ethernet frame) - see TCP_RX_BUF_SIZE
    23                              <1>                               ; below for why the receive side can't reuse it.
    24                              <1> ; TCP_RX_BUF_SIZE -- capacity of tcp_rx_buf, the landing buffer tcp_handle_segment
    25                              <1> ; appends incoming payload into before tls_pump drains it into tls_rx_buf (16KB).
    26                              <1> ; This used to just be TCP_PAYLOAD_MAX (1536), which is fine for cmd_tcp's small
    27                              <1> ; test replies but not for a real TLS handshake: netpoll() drains every frame
    28                              <1> ; currently queued from the NIC in one call, invoking tcp_handle_segment for
    29                              <1> ; each, and tls_pump only runs once *after* netpoll returns. A server's
    30                              <1> ; encrypted flight (EncryptedExtensions + Certificate + CertificateVerify +
    31                              <1> ; Finished - routinely several KB for a real cert chain) commonly arrives as a
    32                              <1> ; burst of several back-to-back segments before we ever get a chance to pump.
    33                              <1> ; Once more than TCP_PAYLOAD_MAX-1 bytes piled up, tcp_handle_segment's
    34                              <1> ; "buffer full" path silently dropped the remainder while STILL acknowledging
    35                              <1> ; it as received (see the ack-anyway comment below) - the server believed we
    36                              <1> ; got everything and never resent it, so the truncated TLS record could never
    37                              <1> ; complete and tls_wait_for_record spun until the final timeout. Give the
    38                              <1> ; landing buffer the same headroom as tls_rx_buf so a whole flight fits
    39                              <1> ; between polls.
    40                              <1> TCP_RX_BUF_SIZE equ 16384
    41                              <1> ; Wait budget for SYN-ACK / reply waits. A SYN (or a data segment) has to
    42                              <1> ; make a real round trip to a host out past the gateway - unlike ARP/DHCP,
    43                              <1> ; which only ever talk to something on the local segment. The old code gave
    44                              <1> ; up after one whole-second tick plus a single immediate retransmit (~1-2s
    45                              <1> ; total), which is nowhere near enough for a real WAN round trip and made
    46                              <1> ; perfectly healthy connections report "timed out" before a reply had any
    47                              <1> ; chance to arrive. Mirror nic_arp_resolve's fix: a multi-second budget per
    48                              <1> ; round, several resend rounds before finally giving up.
    49                              <1> TCP_ROUND_SECS equ 5 ; ~5-6s of continuous polling per round
    50                              <1> TCP_MAX_RETRIES equ 3 ; up to 3 retransmits (4 sends total) per phase
    51                              <1> TCP_FLAG_FIN equ 0x01
    52                              <1> TCP_FLAG_SYN equ 0x02
    53                              <1> TCP_FLAG_RST equ 0x04
    54                              <1> TCP_FLAG_PSH equ 0x08
    55                              <1> TCP_FLAG_ACK equ 0x10
    56                              <1> ; ---- 32-bit big-endian (wire order) helpers ----
    57                              <1> ; tcp_load_be32: rsi = ptr -> eax = big-endian dword as a host value.
    58                              <1> tcp_load_be32:
    59 00036DE4 0FB606              <1>     movzx eax, byte [rsi]
    60 00036DE7 C1E008              <1>     shl eax, 8
