   660 0003FBAF C1E008              <1>     shl eax, 8
   661 0003FBB2 0FB65601            <1>     movzx edx, byte [rsi+1]
   662 0003FBB6 09D0                <1>     or eax, edx
   663 0003FBB8 0FB64E02            <1>     movzx ecx, byte [rsi+2]
