  3843                              <1> ; ============================================================
  3844                              <1> ;  IN-LANGUAGE FILE ACCESS API (Phase 3)
  3845                              <1> ;
  3846                              <1> ; fopen/fread/fwrite/fclose/fexists/fdelete: real file I/O without
  3847                              <1> ; shelling out via `rush`. These are the first "builtin functions" -
  3848                              <1> ; before this phase every call name went straight to party_func_find
  3849                              <1> ; (user-defined functions only); party_call_builtin below is checked
  3850                              <1> ; first and, on a name match, handles arg-count checking, argument
  3851                              <1> ; popping, and pushing exactly one result value itself (matching
  3852                              <1> ; party_invoke_func's contract), the same way a user function call
  3853                              <1> ; leaves one value on the stack whether or not the caller uses it.
  3854                              <1> ; A user script cannot redefine these names - the builtin check runs
  3855                              <1> ; before party_func_find ever sees them.
  3856                              <1> ;
  3857                              <1> ; All routed straight to the fs_* primitives (kernel.asm ~8251+) -
  3858                              <1> ; the same calls cmd_cat/cmd_mkfl/cmd_edit/cmd_rm already use, not
  3859                              <1> ; reimplemented and not shelled out to `rush`.
  3860                              <1> ; ============================================================
  3861                              <1> 
  3862                              <1> PARTY_FH_MAX equ 12          ; open-file-handle table capacity
  3863                              <1> PARTY_PATH_MAX equ 200       ; NUL-terminated path staging buffer size
  3864                              <1> 
  3865                              <1> ; party_call_builtin: dispatches to a builtin function if
  3866                              <1> ; party_call_name_buf names one. In: r14 = evaluated arg count (args
  3867                              <1> ; already pushed onto party_vstack, first arg first - same
  3868                              <1> ; convention party_invoke_func documents).
  3869                              <1> ; Out: al = 1 if the name matched a builtin - whether it then
  3870                              <1> ; succeeded or errored, check party_exec_ok either way, and exactly
  3871                              <1> ; one value (a real result, or PV_NONE) has been pushed on success.
  3872                              <1> ; al = 0 if the name isn't a builtin; args are left untouched on the
  3873                              <1> ; stack for the normal user-function path.
  3874                              <1> ; Clobbers rax, rbx, rcx, rdx, rsi, rdi, r8-r13 when al=1; untouched
  3875                              <1> ; when al=0 (no builtin matched, nothing was done).
  3876                              <1> party_call_builtin:
  3877 00028CF7 488D3425[37B30200]  <1>     lea rsi, [party_call_name_buf]
  3878 00028CFF 488D3C25[5FB30200]  <1>     lea rdi, [str_fn_fopen]
