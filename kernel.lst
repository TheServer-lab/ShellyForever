 12294                                  
 12295                                  ; nic_arp_resolve: eax = IP -> CF=0 and rdi = MAC ptr (cached or just
 12296                                  ; resolved via broadcast + wait), or CF=1 after retries/timeout. On CF=1,
 12297                                  ; nic_last_fail_reason tells the caller which of two very different things
 12298                                  ; happened: 0 = the raw broadcast itself never got out (hardware/TX-level
 12299                                  ; problem - see nic_send_raw_rtl8168), 1 = the broadcast went out fine but
 12300                                  ; no ARP reply ever came back (peer/gateway didn't answer in time). These
 12301                                  ; used to be reported identically, which is how a plain "nobody answered"
 12302                                  ; timeout ended up being diagnosed as a NIC hardware fault.
 12303                                  nic_arp_resolve:
 12304 00019CA8 53                          push rbx
 12305 00019CA9 51                          push rcx
 12306 00019CAA 52                          push rdx
 12307 00019CAB 56                          push rsi
 12308 00019CAC 4151                        push r9
 12309 00019CAE 4152                        push r10
 12310 00019CB0 4154                        push r12
 12311 00019CB2 4155                        push r13
 12312 00019CB4 4156                        push r14
 12313 00019CB6 4157                        push r15
 12314 00019CB8 4989C4                      mov r12, rax
 12315 00019CBB 4531FF                      xor r15d, r15d           ; ARP-broadcast raw-TX retry counter - separate from
 12316                                                                ; the reply-wait retry below. This covers the NIC
 12317                                                                ; itself failing to get the broadcast frame out
 12318                                                                ; (nic_send_raw_rtl8168 timeout/race), not the peer
 12319                                                                ; failing to answer it. Previously a single failed
 12320                                                                ; TX here killed the whole resolve/connect attempt
 12321                                                                ; instantly, even though the same class of failure
 12322                                                                ; is known to be a transient completion-detection
 12323                                                                ; race on this chip (see nic_send_raw_rtl8168).
 12324 00019CBE 31DB                        xor ebx, ebx              ; ARP-reply resend-round counter (separate axis from
 12325                                                                ; r15d above: this counts full "resend + wait again"
 12326                                                                ; rounds after a genuinely-sent broadcast got no
 12327                                                                ; reply, not raw TX failures).
 12328                                  .ares:
 12329 00019CC0 4489E0                      mov eax, r12d
 12330 00019CC3 E8A8FFFFFF                  call nic_arp_lookup
 12331 00019CC8 7351                        jnc .ares_have
 12332                                  .ares_send:
 12333 00019CCA 4489E0                      mov eax, r12d
 12334 00019CCD E86FFEFFFF                  call nic_arp_request
 12335 00019CD2 730B                        jnc .ares_sent
 12336 00019CD4 4183FF03                    cmp r15d, 3
 12337 00019CD8 7344                        jae .ares_fail_tx
 12338 00019CDA 41FFC7                      inc r15d
 12339 00019CDD EBEB                        jmp .ares_send
 12340                                  .ares_sent:
 12341                                      ; Wait for a reply using the same wall-clock-tick pattern as the raw TX
 12342                                      ; wait: up to ~5-6s of continuous polling per round (budget in whole-
 12343                                      ; second ticks; the current partial second is "free", same reasoning as
 12344                                      ; nic_send_raw_rtl8168's js fix - see there for why `js` instead of `jz`).
 12345                                      ; The old code gave up after at most a single, possibly sub-1-second,
 12346                                      ; tick - nowhere near enough time for a real ARP reply, especially right
 12347                                      ; after DHCP when the gateway/switch may not have us in its table yet.
 12348 00019CDF E8E3E8FFFF                  call rtc_sec_now
 12349 00019CE4 4189C5                      mov r13d, eax
 12350 00019CE7 41BE05000000                mov r14d, 5               ; ~5-6s per round
 12351                                  .ares_wait:
 12352 00019CED E8B8FCFFFF                  call netpoll
 12353 00019CF2 4489E0                      mov eax, r12d
 12354 00019CF5 E876FFFFFF                  call nic_arp_lookup
 12355 00019CFA 731F                        jnc .ares_have
 12356 00019CFC E8C6E8FFFF                  call rtc_sec_now
 12357 00019D01 4439E8                      cmp eax, r13d
 12358 00019D04 7502                        jne .ares_tick
 12359 00019D06 EBE5                        jmp .ares_wait
 12360                                  .ares_tick:
 12361 00019D08 4189C5                      mov r13d, eax
 12362 00019D0B 41FFCE                      dec r14d
 12363 00019D0E 7802                        js .ares_round_done        ; budget for this round exhausted
 12364 00019D10 EBDB                        jmp .ares_wait
 12365                                  .ares_round_done:
 12366                                      ; Up to 3 resend rounds total (~15-18s of real reply-wait time) before
 12367                                      ; giving up, instead of the old single near-instant attempt.
 12368 00019D12 83FB02                      cmp ebx, 2
 12369 00019D15 7312                        jae .ares_fail_noreply
 12370 00019D17 FFC3                        inc ebx
 12371 00019D19 EBAF                        jmp .ares_send              ; resend the broadcast, then wait again
 12372                                  .ares_have:
 12373 00019D1B F8                          clc
 12374 00019D1C EB14                        jmp .ares_out
 12375                                  .ares_fail_tx:
 12376 00019D1E C60425[07E90500]00          mov byte [nic_last_fail_reason], 0
 12377 00019D26 F9                          stc
 12378 00019D27 EB09                        jmp .ares_out
 12379                                  .ares_fail_noreply:
 12380 00019D29 C60425[07E90500]01          mov byte [nic_last_fail_reason], 1
 12381 00019D31 F9                          stc
 12382                                  .ares_out:
 12383 00019D32 415F                        pop r15
 12384 00019D34 415E                        pop r14
 12385 00019D36 415D                        pop r13
 12386 00019D38 415C                        pop r12
 12387 00019D3A 415A                        pop r10
 12388 00019D3C 4159                        pop r9
 12389 00019D3E 5E                          pop rsi
 12390 00019D3F 5A                          pop rdx
 12391 00019D40 59                          pop rcx
 12392 00019D41 5B                          pop rbx
 12393 00019D42 C3                          ret
 12394                                  
