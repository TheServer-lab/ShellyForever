 13488                                  ; netdiag_dump_frame: prints a one-line summary of the frame currently in
 13489                                  ; nic_rx_frame - EtherType, and for IPv4, protocol + src/dst IP, and for
 13490                                  ; UDP, src/dst port. Only called when nic_diag_verbose is set (during the
 13491                                  ; dhcp wait loop) so normal shell use isn't spammed by background ARP/ICMP
 13492                                  ; traffic. This exists to answer "what is actually arriving" directly,
 13493                                  ; instead of continuing to infer it from the send-side code.
 13494                                  netdiag_dump_frame:
 13495 0001A86B 50                          push rax
 13496 0001A86C 51                          push rcx
 13497 0001A86D 52                          push rdx
 13498 0001A86E 56                          push rsi
 13499 0001A86F 57                          push rdi
 13500                                  
 13501 0001A870 48BE-                       mov rsi, msg_diag_type
 13501 0001A872 [1E48030000000000] 
 13502 0001A87A 8A0425[C4D70200]            mov al, [cur_normal_attr]
 13503 0001A881 E886210100                  call print_string_attr
 13504 0001A886 8A0425[A4A40600]            mov al, [nic_rx_frame+12]
 13505 0001A88D E8BFFFFFFF                  call print_hex8
 13506 0001A892 8A0425[A5A40600]            mov al, [nic_rx_frame+13]
 13507 0001A899 E8B3FFFFFF                  call print_hex8
 13508                                  
 13509 0001A89E 8A0425[A4A40600]            mov al, [nic_rx_frame+12]
 13510 0001A8A5 3C08                        cmp al, 0x08
 13511 0001A8A7 750D                        jne .ndf_arp
 13512 0001A8A9 8A0425[A5A40600]            mov al, [nic_rx_frame+13]
 13513 0001A8B0 3C00                        cmp al, 0x00
 13514 0001A8B2 7502                        jne .ndf_arp
 13515 0001A8B4 EB74                        jmp .ndf_ip
 13516                                  .ndf_arp:
 13517 0001A8B6 8A0425[A4A40600]            mov al, [nic_rx_frame+12]
 13518 0001A8BD 3C08                        cmp al, 0x08
 13519 0001A8BF 0F853E010000                jne .ndf_nl
 13520 0001A8C5 8A0425[A5A40600]            mov al, [nic_rx_frame+13]
 13521 0001A8CC 3C06                        cmp al, 0x06
 13522 0001A8CE 0F852F010000                jne .ndf_nl
 13523                                      ; ARP payload starts at offset 14. op is a big-endian word at +6/+7;
 13524                                      ; spa (sender protocol address, i.e. sender's IP) is 4 bytes at +14.
 13525 0001A8D4 48BE-                       mov rsi, msg_diag_arp_op
 13525 0001A8D6 [5648030000000000] 
