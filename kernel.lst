   561 00038B22 89C1                <1>     mov ecx, eax
   562 00038B24 F3A4                <1>     rep movsb
   563                              <1> .hk_noprev:
   564 00038B26 488D3C25[28EF0300]  <1>     lea rdi, [hkdf_msg_buf]
   565 00038B2E 8B0425[20EF0300]    <1>     mov eax, [hkdf_t_len]
   566 00038B35 4801C7              <1>     add rdi, rax
   567 00038B38 4C89EE              <1>     mov rsi, r13
   568 00038B3B 4489F1              <1>     mov ecx, r14d
   569 00038B3E F3A4                <1>     rep movsb
   570 00038B40 8A0425[24EF0300]    <1>     mov al, byte [hkdf_counter]
   571 00038B47 8807                <1>     mov [rdi], al
   572 00038B49 48FFC7              <1>     inc rdi
   573                              <1> 
   574 00038B4C 488D0425[28EF0300]  <1>     lea rax, [hkdf_msg_buf]
   575 00038B54 8B0C25[20EF0300]    <1>     mov ecx, [hkdf_t_len]
   576 00038B5B 4401F1              <1>     add ecx, r14d
   577 00038B5E FFC1                <1>     inc ecx                       ; total msg len = t_len + info_len + 1
   578                              <1> 
   579 00038B60 4C89E7              <1>     mov rdi, r12                  ; key = prk
   580 00038B63 51                  <1>     push rcx
