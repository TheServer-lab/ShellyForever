  6209                                  ;  PROCESS TABLE HELPERS
  6210                                  ; ============================================================
  6211                                  ; proc_alloc: finds a free slot, assigns a PID, sets state=running.
  6212                                  ; Returns rax = slot index, or -1 if full.
  6213                                  proc_alloc:
  6214 00015944 51                          push rcx
  6215 00015945 4831C9                      xor rcx, rcx
  6216                                  .palloc_loop:
  6217 00015948 4883F902                    cmp rcx, MAX_PROCESSES
  6218 0001594C 7339                        jae .palloc_fail
  6219 0001594E 80B9[24090700]00            cmp byte [proc_state + rcx], 0
  6220 00015955 7405                        je .palloc_found
  6221 00015957 48FFC1                      inc rcx
  6222 0001595A EBEC                        jmp .palloc_loop
  6223                                  .palloc_found:
  6224 0001595C 880C25[28090700]            mov [proc_cur_slot], cl
  6225 00015963 C681[24090700]01            mov byte [proc_state + rcx], 1    ; running
  6226 0001596A 488B0425[26090700]          mov rax, [proc_next_pid]
  6227 00015972 66898409[E0080700]          mov [proc_id + rcx*2], ax
  6228 0001597A 66FF0425[26090700]          inc word [proc_next_pid]
  6229 00015982 4889C8                      mov rax, rcx
  6230 00015985 EB07                        jmp .palloc_out
  6231                                  .palloc_fail:
  6232 00015987 48C7C0FFFFFFFF              mov rax, -1
  6233                                  .palloc_out:
  6234 0001598E 59                          pop rcx
  6235 0001598F C3                          ret
  6236                                  
  6237                                  ; proc_free_slot: rdi = slot index. Frees the slot.
  6238                                  proc_free_slot:
