  1787 0001CCA9 00000000            <1>
  1788 0001CCAD 48C70425[B0FA0100]- <1>     mov qword [party_func_count], 0
  1788 0001CCB5 00000000            <1>
  1789 0001CCB9 48C70425[90FA0100]- <1>     mov qword [party_err_msg_ptr], 0
  1789 0001CCC1 00000000            <1>
  1790                              <1> 
  1791 0001CCC5 488D3C25[60030200]  <1>     lea rdi, [party_var_used]
  1792 0001CCCD B920000000          <1>     mov rcx, MAXVARS
