 17377                                  ; --- filesystem storage ---
 17378                                  ; One flat node table shared by every mounted volume. The OS volume lives
 17379                                  ; in nodes 0..OS_NODES; mount slot k owns nodes VOL_NODES*(k+1)..VOL_NODES*(k+2)-1.
 17380                                  ; Each volume is persisted separately (superblock + node arrays) to its own
 17381                                  ; device - see the SFFS v2 layout notes near the top of this file.
 17382                                  ;
 17383                                  ; IMPORTANT: ata_read_sector/ata_write_sector always move a full 512-byte
 17384                                  ; sector, so every buffer a sector is staged in/out of must hold 512 bytes.
 17385                                  ; node_type and fs_parent_scratch are exactly that: the type/parent reads
 17386                                  ; in vol_read/vol_write go straight at a whole sector each, and anything
 17387                                  ; smaller would silently overflow into the adjacent arrays (which showed up
 17388                                  ; as a black screen after 'mount' corrupted the node table).
 17389                                  ALIGN 8
 17390 00038588 00<rep 200h>            fs_super_buf:   times 512 db 0        ; scratch for reading/building superblocks
 17391 00038788 00<rep 28h>             fmt_new_label:      times 40 db 0     ; label being applied by the current 'fmt'
 17392 000387B0 00<rep 28h>             sys_reset_label_tmp: times 40 db 0    ; root label preserved across 'sys reset'
 17393 000387D8 00<rep 28h>             orig_label_buf:      times 40 db 0    ; scratch: a device's generated "diskN" label
 17394 00038800 00<rep Ch>              orig_label_num_tmp:  times 12 db 0    ; scratch: decimal digits for gen_orig_label
 17395 0003880C 00<rep 200h>            fs_parent_scratch: times 512 db 0     ; staging for one full parent sector (512B)
 17396 00038A0C 00<rep 40h>             mount_label:   times MAX_MOUNTS*32 db 0     ; label of each mounted volume
 17397 00038A4C 00<rep 2h>              mount_device:  times MAX_MOUNTS db 0        ; device id each volume came from
 17398 00038A4E 00<rep 2h>              mount_used:    times MAX_MOUNTS db 0        ; 1 = slot in use
 17399                                  ; type sector = 512B per volume (base 0/256/512 with VOL_NODES=256), so this
 17400                                  ; must span the max extent of a sector write: base + 512. node indices still
 17401                                  ; index it by node (1 byte per node); the per-volume padding holds whatever
 17402                                  ; the sector has. 512*(1+MAX_MOUNTS) stays comfortably >= MAX_NODES either way.
 17403 00038A50 00<rep 600h>            node_type:    times 512 * (1 + MAX_MOUNTS) db 0
 17404 00039050 0000<rep 300h>          node_parent:  times MAX_NODES dw 0
 17405 00039650 00<rep 6000h>           node_name:    times MAX_NODES*NAME_LEN db 0
 17406 0003F650 00<rep 1E000h>          node_content: times MAX_NODES*CONTENT_LEN db 0
 17407 0005D650 FFFF<rep 300h>          node_next:    times MAX_NODES dw 0xFFFF   ; 0xFFFF = end of chain (or no chain)
 17408                                  ; node_bin_len: exact byte count for files written via fs_write_binary_file,
 17409                                  ; recorded on the file's head node only. Lets fs_read_binary_file copy back
 17410                                  ; the precise length instead of guessing from NUL bytes (which real binary
 17411                                  ; content - e.g. compiled .run programs - can legitimately contain).
 17412                                  ; NOTE: not part of the on-disk SFFS format yet, so this resets on
 17413                                  ; remount/reboot - a freshly compiled .run works immediately, but won't
 17414                                  ; survive a reboot until this is added to the persisted layout too.
 17415 0005DC50 00000000<rep 300h>      node_bin_len: times MAX_NODES dd 0
