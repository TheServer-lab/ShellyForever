  5530                                  ; ------------------------------------------------------------
  5531                                  ; acpi_shutdown: real ACPI power-off, the mechanism real hardware
  5532                                  ; actually needs (the hardcoded emulator ports above are debug
  5533                                  ; shortcuts that only exist in software, not on physical machines).
  5534                                  ;
  5535                                  ; Steps (see the ACPI spec / OSDev wiki "Shutdown" page for the
  5536                                  ; equivalent C version of this):
  5537                                  ;   1) find the RSDP by scanning the EBDA and 0xE0000-0xFFFFF for the
  5538                                  ;      "RSD PTR " signature
  5539                                  ;   2) walk the RSDT (or XSDT on ACPI 2.0+) to find the FADT ("FACP")
  5540                                  ;   3) from the FADT, get the DSDT pointer and the PM1a/PM1b control
  5541                                  ;      ports, and enable ACPI mode via SMI_CMD if it isn't already on
  5542                                  ;   4) scan the DSDT's AML bytecode for the "_S5_" package, which
  5543                                  ;      encodes the SLP_TYPa/SLP_TYPb sleep-state values for power-off
  5544                                  ;   5) write (SLP_TYP | SLP_EN) to the PM1 control port(s)
  5545                                  ;
  5546                                  ; If any step fails (table missing, signature doesn't check out, etc)
  5547                                  ; this just returns and the caller falls back to the legacy ports.
  5548                                  ; Requires boot.asm's identity map to cover wherever these tables land
  5549                                  ; in physical memory - see the 64MB mapping in pm_entry.
  5550                                  acpi_shutdown:
  5551 00015147 50                          push rax
  5552 00015148 53                          push rbx
  5553 00015149 51                          push rcx
  5554 0001514A 52                          push rdx
  5555 0001514B 56                          push rsi
  5556 0001514C 57                          push rdi
  5557 0001514D 4150                        push r8
  5558 0001514F 4151                        push r9
  5559 00015151 4152                        push r10
  5560 00015153 4153                        push r11
  5561 00015155 4154                        push r12
  5562 00015157 4155                        push r13
  5563 00015159 4156                        push r14
  5564 0001515B 4157                        push r15
  5565                                  
  5566 0001515D E806020000                  call acpi_find_rsdp
  5567 00015162 4885C0                      test rax, rax
  5568 00015165 0F84E6010000                jz .out
  5569 0001516B 4989C7                      mov r15, rax                  ; r15 = RSDP address
  5570                                  
  5571                                      ; prefer the XSDT (8-byte pointers) on ACPI 2.0+, else the RSDT
  5572                                      ; (4-byte pointers)
  5573 0001516E 410FB6470F                  movzx eax, byte [r15+15]      ; RSDP revision
  5574 00015173 3C02                        cmp al, 2
  5575 00015175 7214                        jb .use_rsdt
  5576 00015177 498B4718                    mov rax, [r15+24]             ; XSDT address
  5577 0001517B 4885C0                      test rax, rax
  5578 0001517E 740B                        jz .use_rsdt
  5579 00015180 4989C5                      mov r13, rax
  5580 00015183 41BC08000000                mov r12, 8                    ; pointer size in this table
  5581 00015189 EB18                        jmp .have_sdt
  5582                                  .use_rsdt:
  5583 0001518B 31C0                        xor eax, eax
  5584 0001518D 418B4710                    mov eax, [r15+16]             ; RSDT address (32-bit)
  5585 00015191 4885C0                      test rax, rax
  5586 00015194 0F84B7010000                jz .out
  5587 0001519A 4989C5                      mov r13, rax
  5588 0001519D 41BC04000000                mov r12, 4
  5589                                  .have_sdt:
  5590 000151A3 418B4504                    mov eax, [r13+4]              ; table Length
  5591 000151A7 83E824                      sub eax, 36
  5592 000151AA 0F8EA1010000                jle .out
  5593 000151B0 31D2                        xor edx, edx
  5594 000151B2 4489E3                      mov ebx, r12d
  5595 000151B5 F7F3                        div ebx                       ; eax = number of table pointers
  5596 000151B7 4889C1                      mov rcx, rax
  5597 000151BA 498D5D24                    lea rbx, [r13+36]             ; cursor into the pointer array
  5598 000151BE 4D31D2                      xor r10, r10                  ; r10 = FADT address once found
  5599                                  .find_fadt:
  5600 000151C1 4883F900                    cmp rcx, 0
  5601 000151C5 743C                        je .fadt_done
  5602 000151C7 4983FC04                    cmp r12, 4
  5603 000151CB 7506                        jne .ptr8
  5604 000151CD 31C0                        xor eax, eax
  5605 000151CF 8B03                        mov eax, [rbx]
  5606 000151D1 EB03                        jmp .have_ptr
  5607                                  .ptr8:
  5608 000151D3 488B03                      mov rax, [rbx]
  5609                                  .have_ptr:
  5610 000151D6 50                          push rax
  5611 000151D7 4889C6                      mov rsi, rax
  5612 000151DA 488D3C25[5C540100]          lea rdi, [facp_sig]
  5613 000151E2 B904000000                  mov rcx, 4
  5614 000151E7 E844020000                  call bytes_eq
  5615 000151EC 4188C6                      mov r14b, al                 ; stash match result - 'pop rax' below would clobber al
  5616 000151EF 58                          pop rax
  5617 000151F0 4180FE01                    cmp r14b, 1
  5618 000151F4 7505                        jne .fadt_next
  5619 000151F6 4989C2                      mov r10, rax
  5620 000151F9 EB08                        jmp .fadt_done
  5621                                  .fadt_next:
  5622 000151FB 4C01E3                      add rbx, r12
  5623 000151FE 48FFC9                      dec rcx
  5624 00015201 EBBE                        jmp .find_fadt
  5625                                  .fadt_done:
  5626 00015203 4D85D2                      test r10, r10
  5627 00015206 0F8445010000                jz .out                       ; no FADT -> can't do a real ACPI shutdown
  5628                                  
  5629 0001520C 418B4240                    mov eax, [r10 + FADT_PM1a_CNT_BLK]
  5630 00015210 85C0                        test eax, eax
  5631 00015212 0F8439010000                jz .out                       ; no PM1a control port, give up
  5632 00015218 890425[68540100]            mov [acpi_pm1a_port], eax
  5633 0001521F 418B4244                    mov eax, [r10 + FADT_PM1b_CNT_BLK]
  5634 00015223 890425[6C540100]            mov [acpi_pm1b_port], eax
  5635                                  
  5636                                      ; enable ACPI mode (SCI_EN, bit 0 of PM1a control) if not already on
  5637 0001522A 668B1425[68540100]          mov dx, word [acpi_pm1a_port]
  5638 00015232 66ED                        in ax, dx
  5639 00015234 66A90100                    test ax, 1
  5640 00015238 752D                        jnz .have_acpi_mode
  5641 0001523A 418B5230                    mov edx, [r10 + FADT_SMI_CMD]
  5642 0001523E 85D2                        test edx, edx
  5643 00015240 7425                        jz .have_acpi_mode            ; no SMI_CMD -> assume already usable
  5644 00015242 410FB64234                  movzx eax, byte [r10 + FADT_ACPI_ENABLE]
  5645 00015247 85C0                        test eax, eax
  5646 00015249 741C                        jz .have_acpi_mode            ; 0 means "n/a" per spec
  5647 0001524B EE                          out dx, al
  5648 0001524C 41B840420F00                mov r8, 1000000                ; bounded poll, never hang forever
  5649                                  .poll_acpi:
  5650 00015252 668B1425[68540100]          mov dx, word [acpi_pm1a_port]
  5651 0001525A 66ED                        in ax, dx
  5652 0001525C 66A90100                    test ax, 1
  5653 00015260 7505                        jnz .have_acpi_mode
  5654 00015262 49FFC8                      dec r8
  5655 00015265 75EB                        jnz .poll_acpi
  5656                                      ; timed out - try the shutdown write anyway; some firmwares still
  5657                                      ; honor it
  5658                                  .have_acpi_mode:
  5659                                  
  5660                                      ; locate and validate the DSDT
  5661 00015267 418B4228                    mov eax, [r10 + FADT_DSDT]
  5662 0001526B 85C0                        test eax, eax
  5663 0001526D 0F84DE000000                jz .out
  5664 00015273 4D31ED                      xor r13, r13
  5665 00015276 4189C5                      mov r13d, eax                 ; r13 = DSDT address
  5666 00015279 4C89EE                      mov rsi, r13
  5667 0001527C 488D3C25[60540100]          lea rdi, [dsdt_sig]
  5668 00015284 B904000000                  mov rcx, 4
  5669 00015289 E8A2010000                  call bytes_eq
  5670 0001528E 3C01                        cmp al, 1
  5671 00015290 0F85BB000000                jne .out
  5672                                  
  5673 00015296 418B4504                    mov eax, [r13+4]               ; DSDT length
  5674 0001529A 4D89EE                      mov r14, r13
  5675 0001529D 4901C6                      add r14, rax                   ; r14 = end of table
  5676 000152A0 4983EE04                    sub r14, 4                     ; leave room for a 4-byte compare
  5677 000152A4 4983C524                    add r13, 36                    ; r13 = AML scan cursor, past the header
  5678                                  
  5679                                  .find_s5:
  5680 000152A8 4D39F5                      cmp r13, r14
  5681 000152AB 0F83A0000000                jae .out                       ; _S5_ not found -> give up
  5682 000152B1 4C89EE                      mov rsi, r13
  5683 000152B4 488D3C25[64540100]          lea rdi, [s5_sig]
  5684 000152BC B904000000                  mov rcx, 4
  5685 000152C1 E86A010000                  call bytes_eq
  5686 000152C6 3C01                        cmp al, 1
  5687 000152C8 7405                        je .found_s5
  5688 000152CA 49FFC5                      inc r13
  5689 000152CD EBD9                        jmp .find_s5
  5690                                  .found_s5:
  5691                                      ; classic decode of the AML PackageOp following "_S5_" to pull out
  5692                                      ; SLP_TYPa / SLP_TYPb without a full AML parser
  5693 000152CF 4983C505                    add r13, 5                     ; skip "_S5_" (4 bytes) + PackageOp (1)
  5694 000152D3 410FB64500                  movzx eax, byte [r13]
  5695 000152D8 89C1                        mov ecx, eax
  5696 000152DA C1E906                      shr ecx, 6                     ; top 2 bits of PkgLength lead byte
  5697 000152DD 83C102                      add ecx, 2                     ; + the lead byte + NumElements byte
  5698 000152E0 4901CD                      add r13, rcx                   ; now at the first package element
  5699                                  
  5700 000152E3 41807D000A                  cmp byte [r13], 0x0A           ; AML ByteConst prefix
  5701 000152E8 7503                        jne .have_typa
  5702 000152EA 49FFC5                      inc r13
  5703                                  .have_typa:
  5704 000152ED 410FB64500                  movzx eax, byte [r13]
  5705 000152F2 880425[70540100]            mov [acpi_slp_typa], al
  5706 000152F9 49FFC5                      inc r13
  5707 000152FC 41807D000A                  cmp byte [r13], 0x0A
  5708 00015301 7503                        jne .have_typb
  5709 00015303 49FFC5                      inc r13
  5710                                  .have_typb:
  5711 00015306 410FB64500                  movzx eax, byte [r13]
  5712 0001530B 880425[71540100]            mov [acpi_slp_typb], al
  5713                                  
  5714 00015312 0FB60425[70540100]          movzx eax, byte [acpi_slp_typa]
  5715 0001531A C1E00A                      shl eax, 10
  5716 0001531D 0D00200000                  or eax, 1 << 13                ; SLP_EN
  5717 00015322 668B1425[68540100]          mov dx, word [acpi_pm1a_port]
  5718 0001532A 66EF                        out dx, ax                     ; if this is really ACPI, we never return
  5719                                  
  5720 0001532C 8B0425[6C540100]            mov eax, [acpi_pm1b_port]
  5721 00015333 85C0                        test eax, eax
  5722 00015335 741A                        jz .out
  5723 00015337 0FB60425[71540100]          movzx eax, byte [acpi_slp_typb]
  5724 0001533F C1E00A                      shl eax, 10
  5725 00015342 0D00200000                  or eax, 1 << 13
  5726 00015347 668B1425[6C540100]          mov dx, word [acpi_pm1b_port]
  5727 0001534F 66EF                        out dx, ax
  5728                                  
  5729                                  .out:
  5730 00015351 415F                        pop r15
  5731 00015353 415E                        pop r14
  5732 00015355 415D                        pop r13
  5733 00015357 415C                        pop r12
  5734 00015359 415B                        pop r11
  5735 0001535B 415A                        pop r10
  5736 0001535D 4159                        pop r9
  5737 0001535F 4158                        pop r8
  5738 00015361 5F                          pop rdi
  5739 00015362 5E                          pop rsi
  5740 00015363 5A                          pop rdx
  5741 00015364 59                          pop rcx
  5742 00015365 5B                          pop rbx
  5743 00015366 58                          pop rax
  5744 00015367 C3                          ret
  5745                                  
  5746                                  ; acpi_find_rsdp: scans the EBDA, then 0xE0000-0xFFFFF, 16 bytes at a
  5747                                  ; time, for the 8-byte "RSD PTR " signature with a valid checksum.
  5748                                  ; Returns rax = RSDP address, or 0 if not found.
  5749                                  acpi_find_rsdp:
  5750 00015368 53                          push rbx
  5751 00015369 51                          push rcx
  5752 0001536A 52                          push rdx
  5753 0001536B 56                          push rsi
  5754 0001536C 57                          push rdi
  5755 0001536D 4150                        push r8
  5756 0001536F 4151                        push r9
  5757                                  
  5758 00015371 31C0                        xor eax, eax
  5759 00015373 668B04250E040000            mov ax, [0x40E]                ; EBDA segment, BIOS data area
  5760 0001537B C1E004                      shl eax, 4
  5761 0001537E 85C0                        test eax, eax
  5762 00015380 7442                        jz .pass2
  5763 00015382 4989C0                      mov r8, rax
  5764 00015385 4989C1                      mov r9, rax
  5765 00015388 4981C100040000              add r9, 1024
  5766                                  .ebda_loop:
  5767 0001538F 4D39C8                      cmp r8, r9
  5768 00015392 7330                        jae .pass2
  5769 00015394 4C89C6                      mov rsi, r8
  5770 00015397 488D3C25[54540100]          lea rdi, [rsdp_sig]
  5771 0001539F B908000000                  mov rcx, 8
  5772 000153A4 E887000000                  call bytes_eq
  5773 000153A9 3C01                        cmp al, 1
  5774 000153AB 7511                        jne .ebda_next
  5775 000153AD 4C89C6                      mov rsi, r8
  5776 000153B0 E85C000000                  call acpi_rsdp_checksum_ok
  5777 000153B5 3C01                        cmp al, 1
  5778 000153B7 7505                        jne .ebda_next
  5779 000153B9 4C89C0                      mov rax, r8
  5780 000153BC EB49                        jmp .found
  5781                                  .ebda_next:
  5782 000153BE 4983C010                    add r8, 16
  5783 000153C2 EBCB                        jmp .ebda_loop
  5784                                  .pass2:
  5785 000153C4 41B800000E00                mov r8, 0xE0000
  5786 000153CA 41B900001000                mov r9, 0x100000
  5787                                  .main_loop:
  5788 000153D0 4D39C8                      cmp r8, r9
  5789 000153D3 7330                        jae .notfound
  5790 000153D5 4C89C6                      mov rsi, r8
  5791 000153D8 488D3C25[54540100]          lea rdi, [rsdp_sig]
  5792 000153E0 B908000000                  mov rcx, 8
  5793 000153E5 E846000000                  call bytes_eq
  5794 000153EA 3C01                        cmp al, 1
  5795 000153EC 7511                        jne .main_next
  5796 000153EE 4C89C6                      mov rsi, r8
  5797 000153F1 E81B000000                  call acpi_rsdp_checksum_ok
  5798 000153F6 3C01                        cmp al, 1
  5799 000153F8 7505                        jne .main_next
  5800 000153FA 4C89C0                      mov rax, r8
  5801 000153FD EB08                        jmp .found
  5802                                  .main_next:
  5803 000153FF 4983C010                    add r8, 16
  5804 00015403 EBCB                        jmp .main_loop
  5805                                  .notfound:
  5806 00015405 31C0                        xor eax, eax
  5807                                  .found:
  5808 00015407 4159                        pop r9
  5809 00015409 4158                        pop r8
  5810 0001540B 5F                          pop rdi
  5811 0001540C 5E                          pop rsi
  5812 0001540D 5A                          pop rdx
  5813 0001540E 59                          pop rcx
  5814 0001540F 5B                          pop rbx
  5815 00015410 C3                          ret
  5816                                  
  5817                                  ; acpi_rsdp_checksum_ok: rsi = candidate RSDP address. Returns al=1 if
  5818                                  ; the first 20 bytes (the ACPI 1.0 fixed part, present in all versions)
  5819                                  ; sum to 0 mod 256, else al=0.
  5820                                  acpi_rsdp_checksum_ok:
  5821 00015411 56                          push rsi
  5822 00015412 51                          push rcx
  5823 00015413 53                          push rbx
  5824 00015414 30DB                        xor bl, bl
  5825 00015416 B914000000                  mov rcx, 20
  5826                                  .loop:
  5827 0001541B 021E                        add bl, [rsi]
  5828 0001541D 48FFC6                      inc rsi
  5829 00015420 E2F9                        loop .loop
  5830 00015422 84DB                        test bl, bl
  5831 00015424 7504                        jnz .bad
  5832 00015426 B001                        mov al, 1
  5833 00015428 EB02                        jmp .out
  5834                                  .bad:
  5835 0001542A 30C0                        xor al, al
  5836                                  .out:
  5837 0001542C 5B                          pop rbx
  5838 0001542D 59                          pop rcx
  5839 0001542E 5E                          pop rsi
  5840 0001542F C3                          ret
  5841                                  
  5842                                  ; bytes_eq: rsi, rdi = buffers, rcx = length. Returns al=1 if equal.
  5843                                  bytes_eq:
  5844 00015430 56                          push rsi
  5845 00015431 57                          push rdi
  5846 00015432 51                          push rcx
  5847                                  .loop:
  5848 00015433 4883F900                    cmp rcx, 0
  5849 00015437 7411                        je .eq
  5850 00015439 8A06                        mov al, [rsi]
  5851 0001543B 3A07                        cmp al, [rdi]
  5852 0001543D 750F                        jne .neq
  5853 0001543F 48FFC6                      inc rsi
  5854 00015442 48FFC7                      inc rdi
  5855 00015445 48FFC9                      dec rcx
  5856 00015448 EBE9                        jmp .loop
  5857                                  .eq:
  5858 0001544A B001                        mov al, 1
  5859 0001544C EB02                        jmp .out
  5860                                  .neq:
  5861 0001544E 30C0                        xor al, al
  5862                                  .out:
  5863 00015450 59                          pop rcx
  5864 00015451 5F                          pop rdi
  5865 00015452 5E                          pop rsi
  5866 00015453 C3                          ret
  5867                                  
  5868                                  FADT_SMI_CMD       equ 48
  5869                                  FADT_ACPI_ENABLE   equ 52
  5870                                  FADT_PM1a_CNT_BLK  equ 64
  5871                                  FADT_PM1b_CNT_BLK  equ 68
  5872                                  FADT_DSDT          equ 40
  5873                                  
  5874 00015454 5253442050545220        rsdp_sig: db "RSD PTR "
  5875 0001545C 46414350                facp_sig: db "FACP"
  5876 00015460 44534454                dsdt_sig: db "DSDT"
  5877 00015464 5F53355F                s5_sig:   db "_S5_"
  5878 00015468 00000000                acpi_pm1a_port: dd 0
  5879 0001546C 00000000                acpi_pm1b_port: dd 0
  5880 00015470 00                      acpi_slp_typa:  db 0
  5881 00015471 00                      acpi_slp_typb:  db 0
  5882                                  
  5883                                  ; ------------------------------------------------------------
  5884                                  ; cmd_rname: rename a file or folder in the current folder
  5885                                  cmd_rname:
  5886 00015472 803C25[B8E60600]00          cmp byte [arg1_buf], 0
