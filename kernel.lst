 12265                                  ; nic_arp_lookup: eax = IP -> CF=0 and rdi = MAC ptr if cached, else CF=1.
 12266                                  nic_arp_lookup:
 12267 00019C70 53                          push rbx
 12268 00019C71 51                          push rcx
 12269 00019C72 4151                        push r9
 12270 00019C74 4D31C9                      xor r9, r9
 12271                                  .lloop:
 12272 00019C77 4983F904                    cmp r9, NIC_ARP_CACHE_ENTRIES
 12273 00019C7B 7325                        jae .lmiss
 12274 00019C7D 496BD90A                    imul rbx, r9, 10
 12275 00019C81 488DBB[E3E80500]            lea rdi, [nic_arp_cache + rbx + 6]
 12276 00019C88 3B07                        cmp eax, [rdi]
