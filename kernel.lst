  3007 00012A43 [28090700]         
  3008 00012A47 4D89E6                      mov r14, r12
  3009 00012A4A 4983C60E                    add r14, 14                         ; embedded Party source (past the stub)
  3010                                  
  3011                                      ; Name the process "run", same as a foreground run.
  3012 00012A4E 4C89E8                      mov rax, r13
  3013 00012A51 486BC020                    imul rax, 32
  3014 00012A55 488DB8[E4080700]            lea rdi, [proc_name + rax]
  3015 00012A5C 48BE-                       mov rsi, str_run_procname
  3015 00012A5E [E939030000000000] 
  3016 00012A66 E8689E0100                  call str_copy
  3017                                  
  3018                                      ; Copy the embedded source into the process's own source buffer.
  3019 00012A6B 4C8D3C25[54290700]          lea r15, [proc_bg_src]
  3020 00012A73 4969C500400000              imul rax, r13, BG_SRC_MAX
  3021 00012A7A 4901C7                      add r15, rax
  3022 00012A7D 4831C9                      xor rcx, rcx
  3023                                  .crb_copy:
  3024 00012A80 418A040E                    mov al, [r14+rcx]
  3025 00012A84 3C00                        cmp al, 0
