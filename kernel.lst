   710                              <1> ; ================================================================
   711                              <1> ; PHASE 2 -- X25519, ChaCha20, Poly1305, ChaCha20-Poly1305 AEAD, RNG
   712                              <1> ; Cipher suite decision (final): TLS_CHACHA20_POLY1305_SHA256.
   713                              <1> ; All five pieces below were verified standalone before landing here
   714                              <1> ; (RFC 7748 vectors for X25519 cross-checked against the `cryptography`
   715                              <1> ; library; ChaCha20/Poly1305/AEAD cross-checked against pycryptodome-
   716                              <1> ; derived vectors incl. block-boundary and AAD edge cases; RNG run
   717                              <1> ; across 5 independent processes exercising both the RDRAND and
   718                              <1> ; retry-exhausted/fallback paths) -- see phases.txt Phase 2 for the
   719                              <1> ; full verification record. Ported into this file's kernel
   720                              <1> ; conventions (no `section` directives, callee-saves-everything,
   721                              <1> ; CF=0/1 where applicable) with zero label/constant/macro collisions
   722                              <1> ; against the rest of crypto.asm.
   723                              <1> ; ================================================================
   724                              <1> 
   725                              <1> ; ============================================================
   726                              <1> ;  X25519 / fe25519 field arithmetic mod 2^255-19, 4x64-bit limbs LE.
   727                              <1> ;  Ported from fe25519_core.asm (standalone scratch, RFC 7748 vectors
   728                              <1> ;  verified against an independent Python oracle -- see phases.txt
   729                              <1> ;  Phase 2). Algorithmically unchanged; the only differences from the
   730                              <1> ;  scratch version are: no `section` directive (kernel.asm has none),
   731                              <1> ;  and the scratch file's Linux-syscall debug helpers (print_hex64/
   732                              <1> ;  print_fe/hexbuf/nl) are dropped since this kernel has no syscalls
   733                              <1> ;  -- crypto self-test output goes through print_string/print_hex8
   734                              <1> ;  via cmd_cryptotest instead, same as Phase 1.
   735                              <1> ;
   736                              <1> ;  All fixed-width carry/borrow chains (add/sub of 4 limbs) are fully
   737                              <1> ;  unrolled: NOTHING that touches flags is allowed between chained
   738                              <1> ;  adc/sbb instructions, since that clobbers the carry flag the next
   739                              <1> ;  adc/sbb needs (a loop-counter `cmp` between adc steps was tried
   740                              <1> ;  first during Phase 2 scratch work and silently injected a spurious
   741                              <1> ;  +1 -- caught by diffing against the Python oracle).
   742                              <1> ; ============================================================
   743                              <1> 
   744                              <1> ; ---- fe_ucmp: rsi=a, rdx=b (4 limbs each) -> eax = 1 if a>=b, 0 if a<b ----
   745                              <1> fe_ucmp:
   746 00038C77 51                  <1>     push rcx
   747 00038C78 53                  <1>     push rbx
   748 00038C79 B903000000          <1>     mov rcx, 3
   749                              <1> .loop:
   750 00038C7E 488B04CE            <1>     mov rax, [rsi+rcx*8]
   751 00038C82 488B1CCA            <1>     mov rbx, [rdx+rcx*8]
   752 00038C86 4839D8              <1>     cmp rax, rbx
   753 00038C89 770E                <1>     ja .ge
   754 00038C8B 7213                <1>     jb .lt
   755 00038C8D 48FFC9              <1>     dec rcx
   756 00038C90 79EC                <1>     jns .loop
   757 00038C92 B801000000          <1>     mov eax, 1
   758 00038C97 EB0C                <1>     jmp .done
   759                              <1> .ge:
   760 00038C99 B801000000          <1>     mov eax, 1
   761 00038C9E EB05                <1>     jmp .done
   762                              <1> .lt:
   763 00038CA0 B800000000          <1>     mov eax, 0
   764                              <1> .done:
   765 00038CA5 5B                  <1>     pop rbx
   766 00038CA6 59                  <1>     pop rcx
   767 00038CA7 C3                  <1>     ret
   768                              <1> 
   769                              <1> ; ---- fe_sub_p_if_ge: rdi=x (4 limbs) -- if x >= p, x -= p, in place. ----
   770                              <1> fe_sub_p_if_ge:
   771 00038CA8 50                  <1>     push rax
   772 00038CA9 56                  <1>     push rsi
   773 00038CAA 52                  <1>     push rdx
   774 00038CAB 488D37              <1>     lea rsi, [rdi]
   775 00038CAE 488D1425[BB950300]  <1>     lea rdx, [p25519]
   776 00038CB6 E8BCFFFFFF          <1>     call fe_ucmp
   777 00038CBB 85C0                <1>     test eax, eax
   778 00038CBD 743E                <1>     jz .no
   779 00038CBF 488B07              <1>     mov rax, [rdi+0]
   780 00038CC2 482B0425[BB950300]  <1>     sub rax, [p25519+0]
   781 00038CCA 488907              <1>     mov [rdi+0], rax
   782 00038CCD 488B4708            <1>     mov rax, [rdi+8]
   783 00038CD1 481B0425[C3950300]  <1>     sbb rax, [p25519+8]
   784 00038CD9 48894708            <1>     mov [rdi+8], rax
   785 00038CDD 488B4710            <1>     mov rax, [rdi+16]
   786 00038CE1 481B0425[CB950300]  <1>     sbb rax, [p25519+16]
   787 00038CE9 48894710            <1>     mov [rdi+16], rax
   788 00038CED 488B4718            <1>     mov rax, [rdi+24]
   789 00038CF1 481B0425[D3950300]  <1>     sbb rax, [p25519+24]
   790 00038CF9 48894718            <1>     mov [rdi+24], rax
   791                              <1> .no:
   792 00038CFD 5A                  <1>     pop rdx
   793 00038CFE 5E                  <1>     pop rsi
   794 00038CFF 58                  <1>     pop rax
   795 00038D00 C3                  <1>     ret
   796                              <1> 
   797                              <1> ; ---- fe_reduce_full: rdi=x -- subtract p up to 3 times (ample headroom
   798                              <1> ; for anything this file produces, which is always < ~4p). ----
   799                              <1> fe_reduce_full:
   800 00038D01 E8A2FFFFFF          <1>     call fe_sub_p_if_ge
   801 00038D06 E89DFFFFFF          <1>     call fe_sub_p_if_ge
   802 00038D0B E898FFFFFF          <1>     call fe_sub_p_if_ge
   803 00038D10 C3                  <1>     ret
   804                              <1> 
   805                              <1> ; ---- fe_add: rdi=dst, rsi=a, rdx=b. dst = (a+b) mod p. a,b assumed < p. ----
   806                              <1> fe_add:
   807 00038D11 50                  <1>     push rax
   808 00038D12 53                  <1>     push rbx
   809 00038D13 4889D3              <1>     mov rbx, rdx
   810 00038D16 488B06              <1>     mov rax, [rsi+0]
   811 00038D19 480303              <1>     add rax, [rbx+0]
   812 00038D1C 488907              <1>     mov [rdi+0], rax
   813 00038D1F 488B4608            <1>     mov rax, [rsi+8]
   814 00038D23 48134308            <1>     adc rax, [rbx+8]
   815 00038D27 48894708            <1>     mov [rdi+8], rax
   816 00038D2B 488B4610            <1>     mov rax, [rsi+16]
   817 00038D2F 48134310            <1>     adc rax, [rbx+16]
   818 00038D33 48894710            <1>     mov [rdi+16], rax
   819 00038D37 488B4618            <1>     mov rax, [rsi+24]
   820 00038D3B 48134318            <1>     adc rax, [rbx+24]
   821 00038D3F 48894718            <1>     mov [rdi+24], rax
   822 00038D43 E8B9FFFFFF          <1>     call fe_reduce_full
   823 00038D48 5B                  <1>     pop rbx
   824 00038D49 58                  <1>     pop rax
   825 00038D4A C3                  <1>     ret
   826                              <1> 
   827                              <1> ; ---- fe_sub: rdi=dst, rsi=a, rdx=b. dst = (a-b) mod p, via (a + 2p) - b. ----
   828                              <1> fe_sub:
   829 00038D4B 50                  <1>     push rax
   830 00038D4C 53                  <1>     push rbx
   831 00038D4D 51                  <1>     push rcx
   832 00038D4E 52                  <1>     push rdx
   833 00038D4F 56                  <1>     push rsi
   834 00038D50 57                  <1>     push rdi
   835 00038D51 4151                <1>     push r9
   836 00038D53 4883EC20            <1>     sub rsp, 32              ; tmp[0..3] = 2p - b
   837 00038D57 488B0425[DB950300]  <1>     mov rax, [twop25519+0]
   838 00038D5F 482B02              <1>     sub rax, [rdx+0]
   839 00038D62 48890424            <1>     mov [rsp+0], rax
   840 00038D66 488B0425[E3950300]  <1>     mov rax, [twop25519+8]
   841 00038D6E 481B4208            <1>     sbb rax, [rdx+8]
   842 00038D72 4889442408          <1>     mov [rsp+8], rax
   843 00038D77 488B0425[EB950300]  <1>     mov rax, [twop25519+16]
   844 00038D7F 481B4210            <1>     sbb rax, [rdx+16]
   845 00038D83 4889442410          <1>     mov [rsp+16], rax
   846 00038D88 488B0425[F3950300]  <1>     mov rax, [twop25519+24]
   847 00038D90 481B4218            <1>     sbb rax, [rdx+24]
   848 00038D94 4889442418          <1>     mov [rsp+24], rax
   849                              <1>     ; dst = a + tmp. This can carry out past the 4th limb (a<p,
   850                              <1>     ; tmp<2p, so a+tmp < 3p, and 3p > 2^256) -- fold any such carry
   851                              <1>     ; back in as +38, same trick as fe_mul (2^256 mod p = 38).
   852 00038D99 4D31C9              <1>     xor r9, r9                ; carry-out capture, zeroed before the chain
   853 00038D9C 488B06              <1>     mov rax, [rsi+0]
   854 00038D9F 48030424            <1>     add rax, [rsp+0]
   855 00038DA3 4889C3              <1>     mov rbx, rax
   856 00038DA6 488B4E08            <1>     mov rcx, [rsi+8]
   857 00038DAA 48134C2408          <1>     adc rcx, [rsp+8]
   858 00038DAF 488B5610            <1>     mov rdx, [rsi+16]
   859 00038DB3 4813542410          <1>     adc rdx, [rsp+16]
   860 00038DB8 488B7618            <1>     mov rsi, [rsi+24]
   861 00038DBC 4813742418          <1>     adc rsi, [rsp+24]
   862 00038DC1 4983D100            <1>     adc r9, 0                 ; captures the final carry-out, right after the adc
   863 00038DC5 4D85C9              <1>     test r9, r9
   864 00038DC8 7410                <1>     jz .no_carry_fold
   865 00038DCA 4883C326            <1>     add rbx, 38
   866 00038DCE 4883D100            <1>     adc rcx, 0
   867 00038DD2 4883D200            <1>     adc rdx, 0
   868 00038DD6 4883D600            <1>     adc rsi, 0
   869                              <1> .no_carry_fold:
   870 00038DDA 4883C420            <1>     add rsp, 32
   871 00038DDE 4159                <1>     pop r9                    ; restore caller's r9 (top of stack, pushed last)
   872 00038DE0 5F                  <1>     pop rdi                  ; original dst (rdi was pushed just before r9)
   873 00038DE1 48891F              <1>     mov [rdi+0], rbx
   874 00038DE4 48894F08            <1>     mov [rdi+8], rcx
   875 00038DE8 48895710            <1>     mov [rdi+16], rdx
   876 00038DEC 48897718            <1>     mov [rdi+24], rsi
   877 00038DF0 E80CFFFFFF          <1>     call fe_reduce_full
   878 00038DF5 5F                  <1>     pop rdi                  ; discard saved rsi slot (stack balance)
   879 00038DF6 5A                  <1>     pop rdx
   880 00038DF7 59                  <1>     pop rcx
   881 00038DF8 5B                  <1>     pop rbx
   882 00038DF9 58                  <1>     pop rax
   883 00038DFA C3                  <1>     ret
   884                              <1> 
   885                              <1> ; ---- fe_mul: rdi=dst, rsi=a, rdx=b. Full schoolbook 4x4->8 limb
   886                              <1> ; multiply, reduced via 2^256 = 38 (mod p). ----
   887                              <1> fe_mul:
   888 00038DFB 50                  <1>     push rax
   889 00038DFC 53                  <1>     push rbx
   890 00038DFD 51                  <1>     push rcx
   891 00038DFE 52                  <1>     push rdx
   892 00038DFF 56                  <1>     push rsi
   893 00038E00 57                  <1>     push rdi
   894 00038E01 4150                <1>     push r8
   895 00038E03 4151                <1>     push r9
   896 00038E05 4152                <1>     push r10
   897 00038E07 4153                <1>     push r11
   898 00038E09 4154                <1>     push r12
   899 00038E0B 4155                <1>     push r13
   900 00038E0D 4156                <1>     push r14
   901 00038E0F 4883EC40            <1>     sub rsp, 8*8             ; prod[0..7]
   902 00038E13 4989FE              <1>     mov r14, rdi
   903 00038E16 4989F4              <1>     mov r12, rsi
   904 00038E19 4989D5              <1>     mov r13, rdx
   905                              <1> 
   906 00038E1C 48C7042400000000    <1>     mov qword [rsp+0], 0
   907 00038E24 48C744240800000000  <1>     mov qword [rsp+8], 0
   908 00038E2D 48C744241000000000  <1>     mov qword [rsp+16], 0
   909 00038E36 48C744241800000000  <1>     mov qword [rsp+24], 0
   910 00038E3F 48C744242000000000  <1>     mov qword [rsp+32], 0
   911 00038E48 48C744242800000000  <1>     mov qword [rsp+40], 0
   912 00038E51 48C744243000000000  <1>     mov qword [rsp+48], 0
   913 00038E5A 48C744243800000000  <1>     mov qword [rsp+56], 0
   914                              <1> 
   915 00038E63 4D31D2              <1>     xor r10, r10
   916                              <1> .outer:
   917 00038E66 4B8B1CD4            <1>     mov rbx, [r12+r10*8]      ; a[i]
   918 00038E6A 4D31DB              <1>     xor r11, r11
   919                              <1> .inner:
   920 00038E6D 4889D8              <1>     mov rax, rbx
   921 00038E70 4BF764DD00          <1>     mul qword [r13+r11*8]     ; rdx:rax = a[i]*b[j]
   922 00038E75 4C89D1              <1>     mov rcx, r10
   923 00038E78 4C01D9              <1>     add rcx, r11               ; k = i+j (this add's flag effect is unused after)
   924 00038E7B 480104CC            <1>     add [rsp+rcx*8], rax
   925 00038E7F 4883D200            <1>     adc rdx, 0
   926 00038E83 48FFC1              <1>     inc rcx
   927                              <1> .prop:
   928 00038E86 480114CC            <1>     add [rsp+rcx*8], rdx
   929 00038E8A 730E                <1>     jnc .prop_done
   930 00038E8C BA01000000          <1>     mov rdx, 1
   931 00038E91 48FFC1              <1>     inc rcx
   932 00038E94 4883F908            <1>     cmp rcx, 8
   933 00038E98 72EC                <1>     jb .prop
   934                              <1> .prop_done:
   935 00038E9A 49FFC3              <1>     inc r11
   936 00038E9D 4983FB04            <1>     cmp r11, 4
   937 00038EA1 72CA                <1>     jb .inner
   938 00038EA3 49FFC2              <1>     inc r10
   939 00038EA6 4983FA04            <1>     cmp r10, 4
   940 00038EAA 72BA                <1>     jb .outer
   941                              <1> 
   942                              <1>     ; h38[0..4] = prod[4..7] * 38  (explicit carry register r8, not flags)
   943 00038EAC 4883EC28            <1>     sub rsp, 8*5
   944 00038EB0 4D31C0              <1>     xor r8, r8
   945 00038EB3 488B442448          <1>     mov rax, [rsp+40+32]       ; prod[4]
   946 00038EB8 BB26000000          <1>     mov rbx, 38
   947 00038EBD 48F7E3              <1>     mul rbx
   948 00038EC0 4C01C0              <1>     add rax, r8
   949 00038EC3 4883D200            <1>     adc rdx, 0
   950 00038EC7 48890424            <1>     mov [rsp+0], rax
   951 00038ECB 4989D0              <1>     mov r8, rdx
   952                              <1> 
   953 00038ECE 488B442450          <1>     mov rax, [rsp+40+40]       ; prod[5]
   954 00038ED3 BB26000000          <1>     mov rbx, 38
   955 00038ED8 48F7E3              <1>     mul rbx
   956 00038EDB 4C01C0              <1>     add rax, r8
   957 00038EDE 4883D200            <1>     adc rdx, 0
   958 00038EE2 4889442408          <1>     mov [rsp+8], rax
   959 00038EE7 4989D0              <1>     mov r8, rdx
   960                              <1> 
   961 00038EEA 488B442458          <1>     mov rax, [rsp+40+48]       ; prod[6]
   962 00038EEF BB26000000          <1>     mov rbx, 38
   963 00038EF4 48F7E3              <1>     mul rbx
   964 00038EF7 4C01C0              <1>     add rax, r8
   965 00038EFA 4883D200            <1>     adc rdx, 0
   966 00038EFE 4889442410          <1>     mov [rsp+16], rax
   967 00038F03 4989D0              <1>     mov r8, rdx
   968                              <1> 
   969 00038F06 488B442460          <1>     mov rax, [rsp+40+56]       ; prod[7]
   970 00038F0B BB26000000          <1>     mov rbx, 38
   971 00038F10 48F7E3              <1>     mul rbx
   972 00038F13 4C01C0              <1>     add rax, r8
   973 00038F16 4883D200            <1>     adc rdx, 0
   974 00038F1A 4889442418          <1>     mov [rsp+24], rax
   975 00038F1F 4989D0              <1>     mov r8, rdx
   976 00038F22 4C89442420          <1>     mov [rsp+32], r8           ; h38[4]
   977                              <1> 
   978                              <1>     ; acc = h38 + L  (L = prod[0..3], at rsp+40) -- unrolled adc chain
   979 00038F27 488B0424            <1>     mov rax, [rsp+0]
   980 00038F2B 4803442428          <1>     add rax, [rsp+40+0]
   981 00038F30 48890424            <1>     mov [rsp+0], rax
   982 00038F34 488B442408          <1>     mov rax, [rsp+8]
   983 00038F39 4813442430          <1>     adc rax, [rsp+40+8]
   984 00038F3E 4889442408          <1>     mov [rsp+8], rax
   985 00038F43 488B442410          <1>     mov rax, [rsp+16]
   986 00038F48 4813442438          <1>     adc rax, [rsp+40+16]
   987 00038F4D 4889442410          <1>     mov [rsp+16], rax
   988 00038F52 488B442418          <1>     mov rax, [rsp+24]
   989 00038F57 4813442440          <1>     adc rax, [rsp+40+24]
   990 00038F5C 4889442418          <1>     mov [rsp+24], rax
   991 00038F61 488B442420          <1>     mov rax, [rsp+32]
   992 00038F66 4883D000            <1>     adc rax, 0
   993 00038F6A 4889442420          <1>     mov [rsp+32], rax          ; acc[4]
   994                              <1> 
   995                              <1>     ; fold2: dst = acc[0..3] + 38*acc[4]
   996 00038F6F 488B442420          <1>     mov rax, [rsp+32]
   997 00038F74 BB26000000          <1>     mov rbx, 38
   998 00038F79 48F7E3              <1>     mul rbx                    ; rdx:rax, rdx expected 0 (acc[4] is tiny)
   999 00038F7C 48010424            <1>     add [rsp+0], rax
  1000 00038F80 488354240800        <1>     adc qword [rsp+8], 0
  1001 00038F86 488354241000        <1>     adc qword [rsp+16], 0
  1002 00038F8C 488354241800        <1>     adc qword [rsp+24], 0
  1003 00038F92 7317                <1>     jnc .no_fold3
  1004 00038F94 4883042426          <1>     add qword [rsp+0], 38
  1005 00038F99 488354240800        <1>     adc qword [rsp+8], 0
  1006 00038F9F 488354241000        <1>     adc qword [rsp+16], 0
  1007 00038FA5 488354241800        <1>     adc qword [rsp+24], 0
  1008                              <1> .no_fold3:
  1009 00038FAB 488B0424            <1>     mov rax, [rsp+0]
  1010 00038FAF 498906              <1>     mov [r14+0], rax
  1011 00038FB2 488B442408          <1>     mov rax, [rsp+8]
  1012 00038FB7 49894608            <1>     mov [r14+8], rax
  1013 00038FBB 488B442410          <1>     mov rax, [rsp+16]
  1014 00038FC0 49894610            <1>     mov [r14+16], rax
  1015 00038FC4 488B442418          <1>     mov rax, [rsp+24]
  1016 00038FC9 49894618            <1>     mov [r14+24], rax
  1017                              <1> 
  1018 00038FCD 4883C428            <1>     add rsp, 8*5
  1019 00038FD1 4883C440            <1>     add rsp, 8*8
  1020 00038FD5 4C89F7              <1>     mov rdi, r14              ; dst -- MUST happen before r14 is popped below
  1021 00038FD8 E824FDFFFF          <1>     call fe_reduce_full
  1022 00038FDD 415E                <1>     pop r14
  1023 00038FDF 415D                <1>     pop r13
  1024 00038FE1 415C                <1>     pop r12
  1025 00038FE3 415B                <1>     pop r11
  1026 00038FE5 415A                <1>     pop r10
  1027 00038FE7 4159                <1>     pop r9
  1028 00038FE9 4158                <1>     pop r8
  1029 00038FEB 5F                  <1>     pop rdi
  1030 00038FEC 5E                  <1>     pop rsi
  1031 00038FED 5A                  <1>     pop rdx
