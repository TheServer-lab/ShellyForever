 13134 0001454D 7465                        je .setshift
 13135 0001454F 80FB36                      cmp bl, 0x36
 13136 00014552 7460                        je .setshift
 13137 00014554 80FB1D                      cmp bl, 0x1D                 ; left Ctrl make
 13138 00014557 7468                        je .ctrl_make
 13139 00014559 480FB6DB                    movzx rbx, bl
 13140 0001455D 803C25[3A4D0100]00          cmp byte [shift_state], 0
 13141 00014565 7508                        jne .shifted
 13142 00014567 8A83[D0F10100]              mov al, [kbd_unshift + rbx]
 13143 0001456D EB06                        jmp .have
 13144                                  .shifted:
 13145 0001456F 8A83[0AF20100]              mov al, [kbd_shift + rbx]
 13146                                  .have:
 13147 00014575 3C00                        cmp al, 0
 13148 00014577 0F8425FFFFFF                je .wait
 13149 0001457D 803C25[454D0100]00          cmp byte [ctrl_state], 0
 13150 00014585 7410                        je .have_normal
