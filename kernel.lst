 13589                                  
 13590                                  ; ============================================================
 13591                                  ;  complete_line: Tab completion for the rush prompt. Called from
 13592                                  ;  read_line when the user presses Tab.
 13593                                  ;  - first token on the line: completes against the built-in command
 13594                                  ;    table (completion_cmds)
 13595                                  ;  - any later token: completes against the names of files/folders
 13596                                  ;    directly inside cur_dir
 13597                                  ;  A single unique match is completed in place (commands get a trailing
 13598                                  ;  space, folders a trailing '/'); an ambiguous prefix is extended as
 13599                                  ;  far as all candidates agree, and if the prefix is already as long as
 13600                                  ;  the shared portion, the candidates are listed and the prompt and
 13601                                  ;  line are reprinted.
 13602                                  ;  Preserves r9/r10; r8 (current line length) may grow as characters
 13603                                  ;  are completed, which is exactly what read_line expects.
 13604                                  ; ============================================================
 13605                                  complete_line:
 13606 00014A1A 50                          push rax
 13607 00014A1B 53                          push rbx
 13608 00014A1C 51                          push rcx
 13609 00014A1D 52                          push rdx
 13610 00014A1E 56                          push rsi
 13611 00014A1F 57                          push rdi
 13612 00014A20 4153                        push r11
 13613 00014A22 4154                        push r12
 13614 00014A24 4155                        push r13
 13615 00014A26 4156                        push r14
 13616 00014A28 4157                        push r15
 13617                                  
 13618                                      ; ---- locate the token being typed: token_start in r13 ----
 13619 00014A2A 4D89C4                      mov r12, r8                  ; scan backward from the cursor
 13620 00014A2D 4D31ED                      xor r13, r13                 ; token_start
 13621                                  .tk_loop:
 13622 00014A30 4983FC00                    cmp r12, 0
 13623 00014A34 740F                        je .tk_done
 13624 00014A36 49FFCC                      dec r12
 13625 00014A39 43803C2120                  cmp byte [r9 + r12], ' '
 13626 00014A3E 75F0                        jne .tk_loop
 13627 00014A40 4D8D6C2401                  lea r13, [r12 + 1]
 13628                                  .tk_done:
 13629 00014A45 4C89C3                      mov rbx, r8                  ; rbx = token length = r8 - r13
 13630 00014A48 4C29EB                      sub rbx, r13
 13631                                  
 13632                                      ; ---- mode: r11 = 1 if this is not the first token ----
 13633 00014A4B 4D31DB                      xor r11, r11
 13634 00014A4E 4831C9                      xor rcx, rcx
 13635                                  .mode_loop:
 13636 00014A51 4C39E9                      cmp rcx, r13
 13637 00014A54 7312                        jae .mode_done
 13638 00014A56 41803C0920                  cmp byte [r9 + rcx], ' '
 13639 00014A5B 7505                        jne .mode_fs
 13640 00014A5D 48FFC1                      inc rcx
 13641 00014A60 EBEF                        jmp .mode_loop
 13642                                  .mode_fs:
 13643 00014A62 41BB01000000                mov r11, 1
 13644                                  .mode_done:
 13645                                  
 13646                                      ; ---- gather matches into comp_matches[], count in r15 ----
 13647 00014A68 4D31FF                      xor r15, r15
 13648 00014A6B 4983FB00                    cmp r11, 0
 13649 00014A6F 7530                        jne .g_fs
 13650                                  .g_cmd:
 13651 00014A71 4831FF                      xor rdi, rdi                 ; table index
 13652                                  .g_cmd_loop:
 13653 00014A74 488D04FD[98B20100]          lea rax, [completion_cmds + rdi*8]
 13654 00014A7C 488B00                      mov rax, [rax]
 13655 00014A7F 4885C0                      test rax, rax
 13656 00014A82 746A                        jz .g_done
 13657 00014A84 4889C6                      mov rsi, rax
 13658 00014A87 E8A2010000                  call .is_prefix
 13659 00014A8C 3C01                        cmp al, 1
 13660 00014A8E 750C                        jne .g_cmd_next
 13661 00014A90 664389BC3F-                 mov [comp_matches + r15*2], di
 13661 00014A95 [C0B30100]         
 13662 00014A99 49FFC7                      inc r15
 13663                                  .g_cmd_next:
 13664 00014A9C 48FFC7                      inc rdi
 13665 00014A9F EBD3                        jmp .g_cmd_loop
 13666                                  .g_fs:
 13667 00014AA1 4831FF                      xor rdi, rdi                 ; node index
 13668                                  .g_fs_loop:
 13669 00014AA4 4881FFC0000000              cmp rdi, MAX_NODES
 13670 00014AAB 7341                        jae .g_done
 13671 00014AAD 80BF[E8F60100]00            cmp byte [node_type + rdi], 0
 13672 00014AB4 7433                        je .g_fs_next
 13673 00014AB6 480FB7843F-                 movzx rax, word [node_parent + rdi*2]
 13673 00014ABB [E8FC0100]         
 13674 00014ABF 483B0425[3B4D0100]          cmp rax, [cur_dir]
 13675 00014AC7 7520                        jne .g_fs_next
 13676 00014AC9 486BC720                    imul rax, rdi, NAME_LEN
 13677 00014ACD 488DB0[68FE0100]            lea rsi, [node_name + rax]
 13678 00014AD4 E855010000                  call .is_prefix
 13679 00014AD9 3C01                        cmp al, 1
 13680 00014ADB 750C                        jne .g_fs_next
 13681 00014ADD 664389BC3F-                 mov [comp_matches + r15*2], di
 13681 00014AE2 [C0B30100]         
 13682 00014AE6 49FFC7                      inc r15
 13683                                  .g_fs_next:
 13684 00014AE9 48FFC7                      inc rdi
 13685 00014AEC EBB6                        jmp .g_fs_loop
 13686                                  .g_done:
 13687 00014AEE 4983FF00                    cmp r15, 0
 13688 00014AF2 0F8425010000                je .out
 13689                                  
 13690                                      ; ---- common prefix length over all matches (starts at rbx) ----
 13691 00014AF8 4889D9                      mov rcx, rbx                 ; pos
 13692                                  .cc_loop:
 13693 00014AFB 4C39D1                      cmp rcx, r10
 13694 00014AFE 7335                        jae .cc_end
 13695 00014B00 4889CA                      mov rdx, rcx
 13696 00014B03 4D31F6                      xor r14, r14
 13697 00014B06 E883010000                  call .char_at                ; al = char of first match at pos
 13698 00014B0B 4989C4                      mov r12, rax
 13699 00014B0E 4D85E4                      test r12, r12
 13700 00014B11 7422                        jz .cc_end
 13701 00014B13 41BE01000000                mov r14, 1
 13702                                  .cc_inner:
 13703 00014B19 4D39FE                      cmp r14, r15
 13704 00014B1C 7312                        jae .cc_agree
 13705 00014B1E 4889CA                      mov rdx, rcx
 13706 00014B21 E868010000                  call .char_at
 13707 00014B26 4C39E0                      cmp rax, r12
 13708 00014B29 750A                        jne .cc_end
 13709 00014B2B 49FFC6                      inc r14
 13710 00014B2E EBE9                        jmp .cc_inner
 13711                                  .cc_agree:
 13712 00014B30 48FFC1                      inc rcx
 13713 00014B33 EBC6                        jmp .cc_loop
 13714                                  .cc_end:
 13715                                      ; rcx = common prefix length
 13716                                      ; ---- append the unambiguous tail, chars rbx..rcx-1 ----
 13717 00014B35 4889DE                      mov rsi, rbx                 ; pos
 13718                                  .ap_loop:
 13719 00014B38 4839CE                      cmp rsi, rcx
 13720 00014B3B 732A                        jae .ap_done
 13721 00014B3D 4D39D0                      cmp r8, r10
 13722 00014B40 7325                        jae .ap_done
 13723 00014B42 4889F2                      mov rdx, rsi
 13724 00014B45 4D31F6                      xor r14, r14
 13725 00014B48 E841010000                  call .char_at
 13726 00014B4D 43880401                    mov [r9 + r8], al
 13727 00014B51 49FFC0                      inc r8
 13728 00014B54 53                          push rbx
 13729 00014B55 8A1C25[444D0100]            mov bl, [cur_normal_attr]
 13730 00014B5C E876F7FFFF                  call putchar
 13731 00014B61 5B                          pop rbx
 13732 00014B62 48FFC6                      inc rsi
 13733 00014B65 EBD1                        jmp .ap_loop
 13734                                  .ap_done:
 13735 00014B67 4983FF01                    cmp r15, 1
 13736 00014B6B 755B                        jne .multi
 13737                                      ; ---- single match: finish it off ----
 13738 00014B6D 4983FB00                    cmp r11, 0
 13739 00014B71 7525                        jne .uniq_fs
 13740 00014B73 4D39D0                      cmp r8, r10
 13741 00014B76 0F83A1000000                jae .out
 13742 00014B7C B020                        mov al, ' '
 13743 00014B7E 43880401                    mov [r9 + r8], al
 13744 00014B82 49FFC0                      inc r8
 13745 00014B85 53                          push rbx
 13746 00014B86 8A1C25[444D0100]            mov bl, [cur_normal_attr]
 13747 00014B8D E845F7FFFF                  call putchar
 13748 00014B92 5B                          pop rbx
 13749 00014B93 E985000000                  jmp .out
 13750                                  .uniq_fs:
 13751 00014B98 480FB70425-                 movzx rax, word [comp_matches]
 13751 00014B9D [C0B30100]         
 13752 00014BA1 80B8[E8F60100]01            cmp byte [node_type + rax], 1
 13753 00014BA8 7573                        jne .out
 13754 00014BAA 4D39D0                      cmp r8, r10
 13755 00014BAD 736E                        jae .out
 13756 00014BAF B02F                        mov al, '/'
 13757 00014BB1 43880401                    mov [r9 + r8], al
 13758 00014BB5 49FFC0                      inc r8
 13759 00014BB8 53                          push rbx
 13760 00014BB9 8A1C25[444D0100]            mov bl, [cur_normal_attr]
 13761 00014BC0 E812F7FFFF                  call putchar
 13762 00014BC5 5B                          pop rbx
 13763 00014BC6 EB55                        jmp .out
 13764                                  .multi:
 13765                                      ; multiple matches: only list if the common prefix advanced nothing
 13766 00014BC8 4839D9                      cmp rcx, rbx
 13767 00014BCB 7550                        jne .out
 13768 00014BCD B00A                        mov al, 0x0A
 13769 00014BCF E803F7FFFF                  call putchar
 13770 00014BD4 4D31F6                      xor r14, r14
 13771                                  .ls_loop:
 13772 00014BD7 4D39FE                      cmp r14, r15
 13773 00014BDA 7316                        jae .ls_done
 13774 00014BDC E883000000                  call .match_ptr              ; rsi = candidate string
 13775 00014BE1 E886F6FFFF                  call print_string
 13776 00014BE6 B020                        mov al, ' '
 13777 00014BE8 E8EAF6FFFF                  call putchar
 13778 00014BED 49FFC6                      inc r14
 13779 00014BF0 EBE5                        jmp .ls_loop
 13780                                  .ls_done:
 13781 00014BF2 B00A                        mov al, 0x0A
 13782 00014BF4 E8DEF6FFFF                  call putchar
 13783 00014BF9 E8BFF4FFFF                  call print_prompt
 13784 00014BFE 4831C9                      xor rcx, rcx
 13785                                  .echo:
 13786 00014C01 4C39C1                      cmp rcx, r8
 13787 00014C04 7317                        jae .out
 13788 00014C06 418A0409                    mov al, [r9 + rcx]
 13789 00014C0A 53                          push rbx
 13790 00014C0B 8A1C25[444D0100]            mov bl, [cur_normal_attr]
 13791 00014C12 E8C0F6FFFF                  call putchar
 13792 00014C17 5B                          pop rbx
 13793 00014C18 48FFC1                      inc rcx
 13794 00014C1B EBE4                        jmp .echo
 13795                                  .out:
 13796 00014C1D 415F                        pop r15
 13797 00014C1F 415E                        pop r14
 13798 00014C21 415D                        pop r13
 13799 00014C23 415C                        pop r12
 13800 00014C25 415B                        pop r11
 13801 00014C27 5F                          pop rdi
 13802 00014C28 5E                          pop rsi
 13803 00014C29 5A                          pop rdx
 13804 00014C2A 59                          pop rcx
 13805 00014C2B 5B                          pop rbx
 13806 00014C2C 58                          pop rax
 13807 00014C2D C3                          ret
 13808                                  
 13809                                  ; .is_prefix: is the typed token (r9+r13, length rbx) a prefix of the
 13810                                  ; null-terminated string in rsi? Returns al = 1/0. Clobbers only al.
 13811                                  .is_prefix:
 13812 00014C2E 53                          push rbx
 13813 00014C2F 51                          push rcx
 13814 00014C30 52                          push rdx
 13815 00014C31 56                          push rsi
 13816 00014C32 57                          push rdi
 13817 00014C33 4889F7                      mov rdi, rsi
 13818 00014C36 4C89CE                      mov rsi, r9
 13819 00014C39 4C01EE                      add rsi, r13
 13820 00014C3C 4889D9                      mov rcx, rbx
 13821                                  .ip_loop:
 13822 00014C3F 4883F900                    cmp rcx, 0
 13823 00014C43 7413                        je .ip_yes
 13824 00014C45 8A06                        mov al, [rsi]
 13825 00014C47 8A17                        mov dl, [rdi]
 13826 00014C49 38D0                        cmp al, dl
 13827 00014C4B 750F                        jne .ip_no
 13828 00014C4D 48FFC6                      inc rsi
 13829 00014C50 48FFC7                      inc rdi
 13830 00014C53 48FFC9                      dec rcx
 13831 00014C56 EBE7                        jmp .ip_loop
 13832                                  .ip_yes:
 13833 00014C58 B001                        mov al, 1
 13834 00014C5A EB02                        jmp .ip_out
 13835                                  .ip_no:
 13836 00014C5C 30C0                        xor al, al
 13837                                  .ip_out:
 13838 00014C5E 5F                          pop rdi
 13839 00014C5F 5E                          pop rsi
 13840 00014C60 5A                          pop rdx
 13841 00014C61 59                          pop rcx
 13842 00014C62 5B                          pop rbx
 13843 00014C63 C3                          ret
 13844                                  
 13845                                  ; .match_ptr: r14 = match slot -> rsi = candidate string. Clobbers rax.
 13846                                  .match_ptr:
 13847 00014C64 4B0FB78436-                 movzx rax, word [comp_matches + r14*2]
 13847 00014C69 [C0B30100]         
 13848 00014C6D 4983FB00                    cmp r11, 0
 13849 00014C71 750F                        jne .mp_fs
 13850 00014C73 486BC008                    imul rax, 8
 13851 00014C77 488D80[98B20100]            lea rax, [completion_cmds + rax]
 13852 00014C7E 488B30                      mov rsi, [rax]
 13853 00014C81 C3                          ret
 13854                                  .mp_fs:
 13855 00014C82 486BC020                    imul rax, NAME_LEN
 13856 00014C86 488DB0[68FE0100]            lea rsi, [node_name + rax]
 13857 00014C8D C3                          ret
 13858                                  
 13859                                  ; .char_at: r14 = match slot, rdx = position -> al = char at that position.
 13860                                  ; Clobbers rax only; returns the character zero-extended in rax so callers
 13861                                  ; can compare/test the full register (the char in al alone would leave
 13862                                  ; pointer bits in rax's upper bytes and break null checks).
 13863                                  .char_at:
 13864 00014C8E 4B0FB78436-                 movzx rax, word [comp_matches + r14*2]
 13864 00014C93 [C0B30100]         
 13865 00014C97 4983FB00                    cmp r11, 0
 13866 00014C9B 7516                        jne .ca_fs
 13867 00014C9D 486BC008                    imul rax, 8
 13868 00014CA1 488D80[98B20100]            lea rax, [completion_cmds + rax]
 13869 00014CA8 488B00                      mov rax, [rax]
 13870 00014CAB 4801D0                      add rax, rdx
 13871 00014CAE 480FB600                    movzx rax, byte [rax]
 13872 00014CB2 C3                          ret
 13873                                  .ca_fs:
 13874 00014CB3 486BC020                    imul rax, NAME_LEN
 13875 00014CB7 488D80[68FE0100]            lea rax, [node_name + rax]
 13876 00014CBE 4801D0                      add rax, rdx
 13877 00014CC1 480FB600                    movzx rax, byte [rax]
 13878 00014CC5 C3                          ret
 13879                                  
 13880                                  ; erase one character visually (move cursor back, blank it)
 13881                                  do_backspace:
 13882 00014CC6 50                          push rax
 13883 00014CC7 803C25[394D0100]00          cmp byte [cursor_col], 0
 13884 00014CCF 7409                        je .maybeup
 13885 00014CD1 FE0C25[394D0100]            dec byte [cursor_col]
 13886 00014CD8 EB19                        jmp .blank
 13887                                  .maybeup:
 13888 00014CDA 803C25[384D0100]00          cmp byte [cursor_row], 0
 13889 00014CE2 744B                        je .out
 13890 00014CE4 FE0C25[384D0100]            dec byte [cursor_row]
 13891 00014CEB C60425[394D0100]4F          mov byte [cursor_col], VGA_COLS-1
 13892                                  .blank:
 13893 00014CF3 53                          push rbx
 13894 00014CF4 51                          push rcx
 13895 00014CF5 52                          push rdx
 13896 00014CF6 57                          push rdi
 13897 00014CF7 480FB60C25-                 movzx rcx, byte [cursor_row]
 13897 00014CFC [384D0100]         
 13898 00014D00 486BC950                    imul rcx, VGA_COLS
 13899 00014D04 480FB61425-                 movzx rdx, byte [cursor_col]
 13899 00014D09 [394D0100]         
 13900 00014D0D 4801D1                      add rcx, rdx
 13901 00014D10 486BC902                    imul rcx, 2
 13902 00014D14 488D3C2500800B00            lea rdi, [VGA_BASE]
 13903 00014D1C 4801CF                      add rdi, rcx
 13904 00014D1F C60720                      mov byte [rdi], ' '
 13905 00014D22 C6470107                    mov byte [rdi+1], 0x07
 13906 00014D26 5F                          pop rdi
 13907 00014D27 5A                          pop rdx
 13908 00014D28 59                          pop rcx
 13909 00014D29 5B                          pop rbx
 13910 00014D2A E801F5FFFF                  call update_cursor
 13911                                  .out:
 13912 00014D2F 58                          pop rax
 13913 00014D30 C3                          ret
 13914                                  
 13915                                  ; ============================================================
 13916                                  ;  DATA
 13917                                  ; ============================================================
 13918 00014D31 90<rep 7h>              ALIGN 8
 13919 00014D38 00                      cursor_row:   db 0
 13920 00014D39 00                      cursor_col:   db 0
 13921 00014D3A 00                      shift_state:  db 0
 13922 00014D3B 0000000000000000        cur_dir:      dq 0
 13923 00014D43 00                      auth_valid:   db 0                   ; set by 'auth' command, checked by dangerous commands
 13924 00014D44 0A                      cur_normal_attr: db ATTR_NORMAL      ; foreground color used for normal output; changed by 'color'
 13925                                  
 13926                                  ; --- keyboard/scrollback/history state ---
 13927 00014D45 00                      ctrl_state:    db 0                  ; 1 while either Ctrl key is held
 13928 00014D46 00                      kbd_ext_flag:  db 0                  ; 1 while waiting for the byte after an 0xE0 prefix
 13929 00014D47 00                      scroll_offset: db 0                  ; 0 = live view, N = N lines scrolled back
 13930 00014D48 00                      sb_write_idx:  db 0                  ; next slot to write in scrollback_buf (ring)
 13931 00014D49 00                      sb_count:      db 0                  ; valid lines currently stored in scrollback_buf
