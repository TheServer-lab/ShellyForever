   297                                  ; ------------------------------------------------------------
   298                                  ; process_chain_rr: same as process_chain but for rr script lines.
   299                                  ; Splits on ; (respecting quotes), copies each segment to line_buf,
   300                                  ; tokenizes, and dispatches. Between segments, checks kill_flag
   301                                  ; (set by Esc key or prs kill) and saves/restores rr_content_ptr
   302                                  ; and proc_cur_slot around each dispatch call (dispatch may call
   303                                  ; cmd_rr recursively, clobbering these).
   304                                  process_chain_rr:
   305 000001BB 53                          push rbx
   306 000001BC 4154                        push r12
   307 000001BE 4155                        push r13
   308 000001C0 4156                        push r14
   309 000001C2 4157                        push r15
   310                                  
   311 000001C4 C60425[F88F0300]01          mov byte [chain_is_rr], 1
   312                                  
