 16461                                  ; ============================================================
 16462 0002D7B3 90<rep 5h>              ALIGN 8
 16463 0002D7B8 00                      cursor_row:   db 0
 16464 0002D7B9 00                      cursor_col:   db 0
 16465 0002D7BA 00                      shift_state:  db 0
 16466 0002D7BB 0000000000000000        cur_dir:      dq 0
 16467 0002D7C3 00                      auth_valid:   db 0                   ; set by 'auth' command, checked by dangerous commands
 16468 0002D7C4 0A                      cur_normal_attr: db ATTR_NORMAL      ; foreground color used for normal output; changed by 'color'
 16469                                  
 16470                                  ; --- keyboard/scrollback/history state ---
 16471 0002D7C5 00                      ctrl_state:    db 0                  ; 1 while either Ctrl key is held
 16472 0002D7C6 00                      edit_active:   db 0                  ; 1 while cmd_edit's editor loop owns the keyboard -
 16473                                                                        ; makes plain Up/Down scroll the view instead of
 16474                                                                        ; being treated as shell command history
 16475                                  
 16476                                  ; --- cmd_edit .ce_render scratch: the render pass streams fs_io_buf through
 16477                                  ; putchar (which is the only thing allowed to touch cursor_row/cursor_col
 16478                                  ; and trigger wraps), so it can't just compute the cursor's screen position
 16479                                  ; ahead of time - it captures cursor_row/cursor_col live, the instant the
 16480                                  ; render reaches the cursor's buffer index, into these, then restores them
 16481                                  ; once the whole visible page has been drawn. ---
 16482 0002D7C7 00                      ce_cursor_captured: db 0
 16483 0002D7C8 00                      ce_saved_row:       db 0
 16484 0002D7C9 00                      ce_saved_col:       db 0
 16485 0002D7CA 00                      kbd_ext_flag:  db 0                  ; 1 while waiting for the byte after an 0xE0 prefix
 16486 0002D7CB 00                      scroll_offset: db 0                  ; 0 = live view, N = N lines scrolled back
 16487 0002D7CC 00                      sb_write_idx:  db 0                  ; next slot to write in scrollback_buf (ring)
 16488 0002D7CD 00                      sb_count:      db 0                  ; valid lines currently stored in scrollback_buf
 16489 0002D7CE 00                      history_next:  db 0                  ; next slot to write in history_buf (ring)
 16490 0002D7CF 00                      history_count: db 0                  ; valid entries currently stored in history_buf
 16491 0002D7D0 00                      history_nav:   db 0                  ; 0 = not browsing history, else 1..history_count deep
 16492                                  
 16493 0002D7D1 90<rep 7h>              ALIGN 8
 16494 0002D7D8 00<rep 3E80h>           scrollback_buf:     times SCROLLBACK_LINES*VGA_COLS*2 db 0
 16495 00031658 00<rep FA0h>            live_snapshot:       times VGA_ROWS*VGA_COLS*2 db 0
 16496 000325F8 00<rep 1130h>           history_buf:         times HISTORY_MAX*LINE_MAX db 0
 16497 00033728 00<rep DCh>             history_saved_line:  times LINE_MAX db 0
 16498                                  
