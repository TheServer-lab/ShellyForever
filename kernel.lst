  5753 00004F1F 4109C1                      or r9d, eax
  5754 00004F22 4181C900000080              or r9d, 0x80000000           ; enable bit
  5755 00004F29 4489C8                      mov eax, r9d
  5756 00004F2C 66BAF80C                    mov dx, PCI_CFG_ADDR
  5757 00004F30 EF                          out dx, eax
  5758 00004F31 66BAFC0C                    mov dx, PCI_CFG_DATA
  5759 00004F35 ED                          in eax, dx
  5760 00004F36 4159                        pop r9
  5761 00004F38 5A                          pop rdx
  5762 00004F39 59                          pop rcx
  5763 00004F3A 5B                          pop rbx
  5764 00004F3B C3                          ret
