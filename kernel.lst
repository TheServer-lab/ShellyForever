   476                              <1> 
   477                              <1>     ; ---- result = SHA256(opad || inner) ----
   478 00038A4B 488D3C25[B0ED0300]  <1>     lea rdi, [hmac_scratch_ctx]
   479 00038A53 E81BFBFFFF          <1>     call sha256_init
   480 00038A58 488D3C25[B0ED0300]  <1>     lea rdi, [hmac_scratch_ctx]
   481 00038A60 488D3425[A0EE0300]  <1>     lea rsi, [hmac_opad]
   482 00038A68 B940000000          <1>     mov rcx, 64
   483 00038A6D E881FDFFFF          <1>     call sha256_update
   484 00038A72 488D3C25[B0ED0300]  <1>     lea rdi, [hmac_scratch_ctx]
