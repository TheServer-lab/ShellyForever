 13922 0001ACF6 5A                          pop rdx
 13923 0001ACF7 59                          pop rcx
 13924 0001ACF8 58                          pop rax
 13925 0001ACF9 C3                          ret
 13926                                  
 13927                                  ; parse_int: rsi=null-terminated string -> rax=value(int64), cl=1 if the
 13928                                  ; whole string was a valid (optionally negative) decimal integer, else
 13929                                  ; cl=0. Does not preserve rcx (used to return the flag in cl).
 13930                                  parse_int:
 13931 0001ACFA 53                          push rbx
 13932 0001ACFB 52                          push rdx
 13933 0001ACFC 4150                        push r8
 13934 0001ACFE 4151                        push r9
 13935 0001AD00 4831C0                      xor rax, rax
 13936 0001AD03 4831D2                      xor rdx, rdx
 13937 0001AD06 4D31C0                      xor r8, r8
 13938 0001AD09 8A1E                        mov bl, [rsi]
 13939 0001AD0B 80FB2D                      cmp bl, '-'
 13940 0001AD0E 7508                        jne .pi_loop
 13941 0001AD10 BA01000000                  mov rdx, 1
 13942 0001AD15 48FFC6                      inc rsi
 13943                                  .pi_loop:
 13944 0001AD18 8A1E                        mov bl, [rsi]
 13945 0001AD1A 80FB00                      cmp bl, 0
 13946 0001AD1D 7421                        je .pi_end
 13947 0001AD1F 80FB30                      cmp bl, '0'
 13948 0001AD22 722F                        jb .pi_bad
 13949 0001AD24 80FB39                      cmp bl, '9'
 13950 0001AD27 772A                        ja .pi_bad
 13951 0001AD29 486BC00A                    imul rax, rax, 10
 13952 0001AD2D 4C0FB6CB                    movzx r9, bl
 13953 0001AD31 4983E930                    sub r9, '0'
 13954 0001AD35 4C01C8                      add rax, r9
 13955 0001AD38 49FFC0                      inc r8
 13956 0001AD3B 48FFC6                      inc rsi
 13957 0001AD3E EBD8                        jmp .pi_loop
 13958                                  .pi_end:
 13959 0001AD40 4983F800                    cmp r8, 0
 13960 0001AD44 740D                        je .pi_bad
 13961 0001AD46 4883FA01                    cmp rdx, 1
 13962 0001AD4A 7503                        jne .pi_ok
 13963 0001AD4C 48F7D8                      neg rax
 13964                                  .pi_ok:
 13965 0001AD4F B101                        mov cl, 1
 13966 0001AD51 EB05                        jmp .pi_out
 13967                                  .pi_bad:
 13968 0001AD53 4831C0                      xor rax, rax
 13969 0001AD56 B100                        mov cl, 0
 13970                                  .pi_out:
 13971 0001AD58 4159                        pop r9
 13972 0001AD5A 4158                        pop r8
 13973 0001AD5C 5A                          pop rdx
 13974 0001AD5D 5B                          pop rbx
 13975 0001AD5E C3                          ret
 13976                                  
 13977                                  ; int_to_str: rax=value(signed) -> ascii decimal (with leading '-' if
 13978                                  ; negative) written null-terminated to buffer rdi.
 13979                                  int_to_str:
 13980 0001AD5F 50                          push rax
 13981 0001AD60 53                          push rbx
 13982 0001AD61 51                          push rcx
 13983 0001AD62 52                          push rdx
 13984 0001AD63 57                          push rdi
 13985 0001AD64 56                          push rsi
 13986 0001AD65 4883F800                    cmp rax, 0
 13987 0001AD69 7D09                        jge .its_pos
 13988 0001AD6B C6072D                      mov byte [rdi], '-'
 13989 0001AD6E 48FFC7                      inc rdi
 13990 0001AD71 48F7D8                      neg rax
 13991                                  .its_pos:
 13992 0001AD74 4883F800                    cmp rax, 0
 13993 0001AD78 750B                        jne .its_digits
 13994 0001AD7A C60730                      mov byte [rdi], '0'
 13995 0001AD7D 48FFC7                      inc rdi
 13996 0001AD80 C60700                      mov byte [rdi], 0
 13997 0001AD83 EB36                        jmp .its_done
 13998                                  .its_digits:
 13999 0001AD85 4889FE                      mov rsi, rdi
 14000 0001AD88 4831C9                      xor rcx, rcx
 14001                                  .its_loop:
 14002 0001AD8B 4883F800                    cmp rax, 0
 14003 0001AD8F 7414                        je .its_reverse
 14004 0001AD91 BB0A000000                  mov rbx, 10
 14005 0001AD96 4831D2                      xor rdx, rdx
 14006 0001AD99 48F7F3                      div rbx
 14007 0001AD9C 80C230                      add dl, '0'
 14008 0001AD9F 52                          push rdx
 14009 0001ADA0 48FFC1                      inc rcx
 14010 0001ADA3 EBE6                        jmp .its_loop
 14011                                  .its_reverse:
 14012 0001ADA5 4831DB                      xor rbx, rbx
 14013                                  .its_pop:
 14014 0001ADA8 4839CB                      cmp rbx, rcx
 14015 0001ADAB 740B                        je .its_termin
 14016 0001ADAD 5A                          pop rdx
 14017 0001ADAE 8816                        mov [rsi], dl
 14018 0001ADB0 48FFC6                      inc rsi
 14019 0001ADB3 48FFC3                      inc rbx
 14020 0001ADB6 EBF0                        jmp .its_pop
 14021                                  .its_termin:
 14022 0001ADB8 C60600                      mov byte [rsi], 0
 14023                                  .its_done:
 14024 0001ADBB 5E                          pop rsi
 14025 0001ADBC 5F                          pop rdi
 14026 0001ADBD 5A                          pop rdx
 14027 0001ADBE 59                          pop rcx
 14028 0001ADBF 5B                          pop rbx
 14029 0001ADC0 58                          pop rax
 14030 0001ADC1 C3                          ret
 14031                                  
 14032                                  ; parse_uint_run: reads a run of decimal digits starting at [rsi],
 14033                                  ; advances rsi past them, returns rax=value. Caller must have already
 14034                                  ; verified [rsi] is a digit before calling.
 14035                                  parse_uint_run:
 14036 0001ADC2 53                          push rbx
