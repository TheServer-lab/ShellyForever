  1857                              <1>     ; blocked while it runs, so there's nowhere else for keystrokes to
  1858                              <1>     ; go). A background process is stepped in short quanta between
  1859                              <1>     ; shell prompts and already has its own kill path ('prs kill
  1860                              <1>     ; <pid>'), so skip kbd_poll here - otherwise it would silently
  1861                              <1>     ; consume/discard keys the user is typing at the live shell prompt
  1862                              <1>     ; while this quantum runs.
  1863 00027532 803C25[35890C00]00  <1>     cmp byte [party_bg_active], 0
  1864 0002753A 752D                <1>     jne .pes_not_killed
  1865 0002753C E88CEDFDFF          <1>     call kbd_poll
