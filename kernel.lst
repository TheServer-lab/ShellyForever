   654 00038C02 4883C702            <1>     add rdi, 2
   655                              <1> 
   656 00038C06 4488F0              <1>     mov al, r14b
   657 00038C09 0406                <1>     add al, 6                     ; "tls13 " is 6 bytes
   658 00038C0B 8807                <1>     mov [rdi], al
