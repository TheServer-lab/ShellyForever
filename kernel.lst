 15941                                  %include "http.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  http.asm  --  HTTP take / give (Milestone D)
     3                              <1> ;
     4                              <1> ;  Two shell commands:
     5                              <1> ;    take <url> <file>   HTTP/1.1 GET, save body to a file
     6                              <1> ;    give <url> <file>   HTTP/1.1 POST, send file content to server
     7                              <1> ;
     8                              <1> ;  URL format: http://host[:port]/path
     9                              <1> ;  e.g.:  take http://10.0.2.2:80/notes.txt notes.txt
    10                              <1> ;         give http://10.0.2.2:8000/upload notes.txt
    11                              <1> ;
    12                              <1> ;  Included from kernel.asm; inherits BITS 64.
    13                              <1> ; ============================================================
    14                              <1> 
    15                              <1> HTTP_DEFAULT_PORT equ 80
    16                              <1> HTTP_RX_BUF_SIZE equ 16384   ; match TCP_RX_BUF_SIZE: take/stake stage the whole
    17                              <1>                              ; reply (headers + body) in tcp_rx_buf before the
    18                              <1>                              ; body is copied here, so anything bigger than this
    19                              <1>                              ; would just be truncated away - 3072 previously cut
    20                              <1>                              ; ~3.8KB Party scripts mid-line (matrix_rain.pa)
    21                              <1> HTTP_TX_MAX      equ 1200
    22                              <1> 
    23                              <1> ; ---- URL parser ----
    24                              <1> ; http_parse_url: rsi = url string. Fills http_host_buf, http_port,
    25                              <1> ; http_path_buf (defaults to "/"). CF=0 on success, CF=1 on bad URL.
    26                              <1> http_parse_url:
    27 000377BE 53                  <1>     push rbx
    28 000377BF 51                  <1>     push rcx
    29 000377C0 57                  <1>     push rdi
    30 000377C1 56                  <1>     push rsi
    31 000377C2 66C70425[C3D30900]- <1>     mov word [http_port], HTTP_DEFAULT_PORT
    31 000377CA 5000                <1>
    32 000377CC C60425[C5D30900]00  <1>     mov byte [http_url_scheme], 0
    33 000377D4 488D3C25[43D30900]  <1>     lea rdi, [http_path_buf]
    34 000377DC C6072F              <1>     mov byte [rdi], '/'
    35 000377DF C6470100            <1>     mov byte [rdi+1], 0
    36                              <1>     ; verify scheme: accept "http://" (scheme 0, default port 80) or
    37                              <1>     ; "https://" (scheme 1, default port 443). "http://" is a leading
    38                              <1>     ; substring of "https://", so check the first 4 bytes ("http") once,
    39                              <1>     ; then branch on whether an 's' follows.
    40 000377E3 803E68              <1>     cmp byte [rsi], 'h'
    41 000377E6 0F8551010000        <1>     jne .bad
    42 000377EC 807E0174            <1>     cmp byte [rsi+1], 't'
    43 000377F0 0F8547010000        <1>     jne .bad
    44 000377F6 807E0274            <1>     cmp byte [rsi+2], 't'
    45 000377FA 0F853D010000        <1>     jne .bad
    46 00037800 807E0370            <1>     cmp byte [rsi+3], 'p'
    47 00037804 0F8533010000        <1>     jne .bad
    48 0003780A 807E0473            <1>     cmp byte [rsi+4], 's'
    49 0003780E 7536                <1>     jne .try_http
