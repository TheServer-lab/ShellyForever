  9701                                  ;                             the last) is resolved as a folder. Used by cf.
  9702                                  ;            leaf_buf ptr -> split mode: all components except the last
  9703                                  ;                             are resolved as folders; the last component
  9704                                  ;                             is copied verbatim into [leaf_buf] instead of
  9705                                  ;                             being looked up. Used by anything that names
  9706                                  ;                             a file/folder to act on (view, del, rname,
  9707                                  ;                             cpy, mov, mkf, mkfl).
  9708                                  ; out: rax = resolved dir index, or -1 if a folder component along the way
  9709                                  ;            doesn't exist (leaf_buf, if any, is left untouched on failure)
  9710                                  ; ============================================================
  9711                                  fs_resolve_path:
  9712 00008702 53                          push rbx
  9713 00008703 51                          push rcx
  9714 00008704 52                          push rdx
  9715 00008705 4150                        push r8
  9716 00008707 4151                        push r9
  9717 00008709 4152                        push r10
  9718 0000870B 4154                        push r12
  9719 0000870D 4155                        push r13
  9720 0000870F 4156                        push r14
  9721 00008711 4989FC                      mov r12, rdi                ; leaf buf ptr, or 0 for whole-path mode
  9722 00008714 4989C5                      mov r13, rax                ; running "current dir" as we walk
  9723 00008717 4989F6                      mov r14, rsi                ; path cursor
  9724                                  
  9725 0000871A 41803E2F                    cmp byte [r14], '/'
  9726 0000871E 7506                        jne .parse_loop
  9727 00008720 41BD00000000                mov r13, 0                  ; absolute path -> start from root
  9728                                  
  9729                                  .parse_loop:
  9730                                  .skip_seps:
  9731 00008726 41803E2F                    cmp byte [r14], '/'
  9732 0000872A 7505                        jne .extract_check
  9733 0000872C 49FFC6                      inc r14
  9734 0000872F EBF5                        jmp .skip_seps
  9735                                  .extract_check:
  9736 00008731 41803E00                    cmp byte [r14], 0
  9737 00008735 0F84FE000000                je .success                 ; nothing left to parse - done
  9738 0000873B 48BF-                       mov rdi, path_comp_buf
  9738 0000873D [20340A0000000000] 
  9739                                  .copy_loop:
  9740 00008745 418A06                      mov al, [r14]
  9741 00008748 3C00                        cmp al, 0
  9742 0000874A 740E                        je .comp_done
  9743 0000874C 3C2F                        cmp al, '/'
  9744 0000874E 740A                        je .comp_done
  9745 00008750 8807                        mov [rdi], al
  9746 00008752 48FFC7                      inc rdi
  9747 00008755 49FFC6                      inc r14
  9748 00008758 EBEB                        jmp .copy_loop
  9749                                  .comp_done:
  9750 0000875A C60700                      mov byte [rdi], 0
  9751                                      ; peek past any trailing slashes to see whether anything real remains
  9752                                  .skip_seps2:
  9753 0000875D 41803E2F                    cmp byte [r14], '/'
  9754 00008761 7505                        jne .check_last
  9755 00008763 49FFC6                      inc r14
  9756 00008766 EBF5                        jmp .skip_seps2
  9757                                  .check_last:
  9758 00008768 41803E00                    cmp byte [r14], 0
  9759 0000876C 751F                        jne .resolve_component      ; more path remains -> this is a folder step
  9760 0000876E 4983FC00                    cmp r12, 0
  9761 00008772 7419                        je .resolve_component        ; whole-path mode: resolve last comp too
  9762                                      ; split mode, and this was the last component -> it's the leaf name
  9763 00008774 56                          push rsi
  9764 00008775 48BE-                       mov rsi, path_comp_buf
  9764 00008777 [20340A0000000000] 
  9765 0000877F 4C89E7                      mov rdi, r12
  9766 00008782 E8AE830600                  call str_copy
  9767 00008787 5E                          pop rsi
  9768 00008788 E9AC000000                  jmp .success
  9769                                  .resolve_component:
  9770 0000878D 48BE-                       mov rsi, path_comp_buf
  9770 0000878F [20340A0000000000] 
  9771 00008797 48BF-                       mov rdi, str_updir
  9771 00008799 [0A7B070000000000] 
  9772 000087A1 E8BF830600                  call str_eq
  9773 000087A6 3C01                        cmp al, 1
  9774 000087A8 7463                        je .do_updir
  9775 000087AA 48BE-                       mov rsi, path_comp_buf
  9775 000087AC [20340A0000000000] 
  9776 000087B4 48BF-                       mov rdi, str_dot
  9776 000087B6 [0D7B070000000000] 
  9777 000087BE E8A2830600                  call str_eq
  9778 000087C3 3C01                        cmp al, 1
  9779 000087C5 745E                        je .after_resolve            ; "." is a no-op
  9780                                      ; "/home" alias: while sitting at root, a literal "home" component
  9781                                      ; is a no-op too (matches the old single-token "/home" special case)
  9782 000087C7 4983FD00                    cmp r13, 0
  9783 000087CB 751D                        jne .lookup_child
  9784 000087CD 48BE-                       mov rsi, path_comp_buf
  9784 000087CF [20340A0000000000] 
  9785 000087D7 48BF-                       mov rdi, str_home_name
  9785 000087D9 [2C7E070000000000] 
  9786 000087E1 E87F830600                  call str_eq
  9787 000087E6 3C01                        cmp al, 1
  9788 000087E8 743B                        je .after_resolve
  9789                                  .lookup_child:
