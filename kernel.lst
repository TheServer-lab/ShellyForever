  4425                                  ; ------------------------------------------------------------
  4426                                  ; cmd_format: format a drive with the SFFS format and give it a label.
  4427                                  ;   fmt <label>                       first unformatted drive gets this label
  4428                                  ;   fmt <label> -force                first present drive (even an existing volume)
  4429                                  ;   fmt <target> <new-label> [-force] format a SPECIFIC drive: <target> is
  4430                                  ;                                      either the original label dscan shows
  4431                                  ;                                      for it ("disk0", "disk1", ...) or an
  4432                                  ;                                      existing SFFS volume's current label
  4433                                  ;                                      (requires -force to reformat it)
  4434                                  ; The boot drive (device 0) is never touched unless -force is given.
  4435                                  cmd_format:
  4436 00014045 803C25[B8E60600]00          cmp byte [arg1_buf], 0
  4437 0001404D 7512                        jne .have_arg
  4438 0001404F 48BE-                       mov rsi, msg_fmt_usage
  4438 00014051 [864F030000000000] 
  4439 00014059 B00C                        mov al, ATTR_ERROR
  4440 0001405B E8AC890100                  call print_string_attr
  4441 00014060 C3                          ret
  4442                                  .have_arg:
  4443 00014061 4530FF                      xor r15b, r15b                      ; force = 0 by default
  4444 00014064 803C25[18E70600]00          cmp byte [arg2_buf], 0
  4445 0001406C 741F                        je .single_setup                    ; fmt <label>
  4446 0001406E 48BE-                       mov rsi, arg2_buf
  4446 00014070 [18E7060000000000] 
  4447 00014078 48BF-                       mov rdi, str_force
  4447 0001407A [EA3F030000000000] 
  4448 00014082 E87C880100                  call str_eq
  4449 00014087 3C01                        cmp al, 1
  4450 00014089 7437                        je .single_force_setup              ; fmt <label> -force
  4451 0001408B EB6A                        jmp .target_setup                   ; fmt <target> <new-label> [-force]
