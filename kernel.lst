 10801 00018C74 83C737                      add edi, NIC_IO_CMD
 10802 00018C77 B00C                        mov al, 0x0C
 10803 00018C79 E820F9FFFF                  call nic_io_write8
 10804                                  
 10805 00018C7E C60425[ACE80500]01          mov byte [nic_present], 1
 10806 00018C86 F8                          clc
 10807 00018C87 E949060000                  jmp .ndone
