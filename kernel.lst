     1                                  ; ============================================================
     2                                  ;  Shelly OS — Kernel
     3                                  ;
     4                                  ;  Loaded by boot.asm at physical address 0x10000, still in
     5                                  ;  16-bit real mode. This file:
     6                                  ;
     7                                  ;    1. (16-bit) enables A20, loads a 32-bit GDT, enters
     8                                  ;       protected mode
     9                                  ;    2. (32-bit) builds identity-mapped page tables, enables
    10                                  ;       PAE + long mode + paging, loads a 64-bit GDT, enters
    11                                  ;       long mode
    12                                  ;    3. (64-bit) runs kernel_main: prints a banner and starts
    13                                  ;       the "rush" shell, which supports one command:
    14                                  ;
    15                                  ;           show "some text"   ->   prints: some text
    16                                  ; ============================================================
    17                                  
    18                                  [BITS 16]
    19                                  [ORG 0x10000]
    20                                  
    21                                  start16:
    22 00000000 FA                          cli
    23 00000001 B80010                      mov ax, 0x1000
    24 00000004 8ED8                        mov ds, ax
    25 00000006 8EC0                        mov es, ax
    26 00000008 31C0                        xor ax, ax
    27 0000000A 8ED0                        mov ss, ax
    28 0000000C BC007C                      mov sp, 0x7C00          ; boot sector's memory is free now, use it as stack
    29                                  
    30 0000000F E81700                      call enable_a20
    31                                  
    32 00000012 0F0116[F800]                lgdt [gdt32_descriptor]
    33                                  
    34 00000017 0F20C0                      mov eax, cr0
    35 0000001A 6683C801                    or eax, 1
    36 0000001E 0F22C0                      mov cr0, eax
    37                                  
    38 00000021 66EA[30000000]0800          jmp dword CODE_SEG32:protected_mode_init
    39                                  
    40                                  enable_a20:
    41 00000029 E492                        in al, 0x92
    42 0000002B 0C02                        or al, 2
    43 0000002D E692                        out 0x92, al
    44 0000002F C3                          ret
    45                                  
    46                                  ; ------------------------------------------------------------
    47                                  [BITS 32]
    48                                  protected_mode_init:
    49 00000030 66B81000                    mov ax, DATA_SEG32
    50 00000034 8ED8                        mov ds, ax
    51 00000036 8EC0                        mov es, ax
    52 00000038 8EE0                        mov fs, ax
    53 0000003A 8EE8                        mov gs, ax
    54 0000003C 8ED0                        mov ss, ax
    55 0000003E BC00000900                  mov esp, 0x90000
    56                                  
    57 00000043 E838000000                  call setup_paging
    58                                  
    59                                      ; Enable PAE (CR4 bit 5)
    60 00000048 0F20E0                      mov eax, cr4
    61 0000004B 83C820                      or eax, 1 << 5
    62 0000004E 0F22E0                      mov cr4, eax
    63                                  
    64                                      ; Load PML4 physical address into CR3
    65 00000051 B8[00100000]                mov eax, pml4_table
    66 00000056 0F22D8                      mov cr3, eax
    67                                  
    68                                      ; Enable long mode (EFER.LME, MSR 0xC0000080 bit 8)
    69 00000059 B9800000C0                  mov ecx, 0xC0000080
    70 0000005E 0F32                        rdmsr
    71 00000060 0D00010000                  or eax, 1 << 8
    72 00000065 0F30                        wrmsr
    73                                  
    74                                      ; Enable paging (CR0 bit 31) -- this activates long mode
    75 00000067 0F20C0                      mov eax, cr0
    76 0000006A 0D00000080                  or eax, 1 << 31
    77 0000006F 0F22C0                      mov cr0, eax
    78                                  
    79 00000072 0F0115[18010000]            lgdt [gdt64_descriptor]
    80 00000079 EA[C4000000]0800            jmp CODE_SEG64:long_mode_init
    81                                  
    82                                  ; ------------------------------------------------------------
    83                                  ; Build a minimal page table set that identity-maps the first
    84                                  ; 16MB of physical memory using 2MB pages:
    85                                  ;   PML4[0] -> PDPT
    86                                  ;   PDPT[0] -> PD
    87                                  ;   PD[0..7] -> eight 2MB pages covering 0..16MB
    88                                  ; ------------------------------------------------------------
    89                                  setup_paging:
    90                                      ; zero out the three tables (3 * 4096 bytes = 3072 dwords)
    91 00000080 BF[00100000]                mov edi, pml4_table
    92 00000085 B9000C0000                  mov ecx, 3072
    93 0000008A 31C0                        xor eax, eax
    94 0000008C F3AB                        rep stosd
    95                                  
    96 0000008E B8[00200000]                mov eax, pdpt_table
    97 00000093 83C803                      or eax, 0x03            ; present + writable
    98 00000096 A3[00100000]                mov [pml4_table], eax
    99                                  
   100 0000009B B8[00300000]                mov eax, pd_table
   101 000000A0 83C803                      or eax, 0x03
   102 000000A3 A3[00200000]                mov [pdpt_table], eax
   103                                  
   104 000000A8 31C9                        xor ecx, ecx
   105                                  .map_entry:
   106 000000AA B800002000                  mov eax, 0x200000       ; 2MB
   107 000000AF F7E1                        mul ecx                 ; eax = 2MB * ecx
   108 000000B1 0D83000000                  or eax, 0x83            ; present + writable + page-size(2MB)
   109 000000B6 8904CD[00300000]            mov [pd_table + ecx*8], eax
   110 000000BD 41                          inc ecx
   111 000000BE 83F908                      cmp ecx, 8              ; 8 entries * 2MB = 16MB mapped
   112 000000C1 7CE7                        jl .map_entry
   113 000000C3 C3                          ret
   114                                  
   115                                  ; ------------------------------------------------------------
   116                                  [BITS 64]
   117                                  long_mode_init:
   118 000000C4 66B81000                    mov ax, DATA_SEG64
   119 000000C8 8ED8                        mov ds, ax
   120 000000CA 8EC0                        mov es, ax
   121 000000CC 8EE0                        mov fs, ax
   122 000000CE 8EE8                        mov gs, ax
   123 000000D0 8ED0                        mov ss, ax
   124 000000D2 BC00000900                  mov rsp, 0x90000
   125                                  
   126 000000D7 E9243F0000                  jmp kernel_main
   127                                  
   128                                  ; ============================================================
   129                                  ;  Descriptor tables
   130                                  ; ============================================================
   131 000000DC 90<rep 4h>              align 8
   132                                  gdt32_start:
   133 000000E0 0000000000000000            dq 0x0000000000000000                  ; null descriptor
   134                                  gdt32_code:
   135 000000E8 FFFF0000                    dw 0xFFFF, 0x0000
   136 000000EC 009ACF00                    db 0x00, 10011010b, 11001111b, 0x00    ; 32-bit code, base 0, limit 4GB
   137                                  gdt32_data:
   138 000000F0 FFFF0000                    dw 0xFFFF, 0x0000
   139 000000F4 0092CF00                    db 0x00, 10010010b, 11001111b, 0x00    ; 32-bit data, base 0, limit 4GB
   140                                  gdt32_end:
   141                                  
   142                                  gdt32_descriptor:
   143 000000F8 1700                        dw gdt32_end - gdt32_start - 1
   144 000000FA [E0000000]                  dd gdt32_start
   145                                  
   146                                  CODE_SEG32 equ gdt32_code - gdt32_start
   147                                  DATA_SEG32 equ gdt32_data - gdt32_start
   148                                  
   149 000000FE 90<rep 2h>              align 8
   150                                  gdt64_start:
   151 00000100 0000000000000000            dq 0x0000000000000000
   152                                  gdt64_code:
   153 00000108 00000000009A2000            dq 0x00209A0000000000                  ; 64-bit code segment
   154                                  gdt64_data:
   155 00000110 0000000000920000            dq 0x0000920000000000                  ; 64-bit data segment
   156                                  gdt64_end:
   157                                  
   158                                  gdt64_descriptor:
   159 00000118 1700                        dw gdt64_end - gdt64_start - 1
   160 0000011A [0001000000000000]          dq gdt64_start
   161                                  
   162                                  CODE_SEG64 equ gdt64_code - gdt64_start
   163                                  DATA_SEG64 equ gdt64_data - gdt64_start
   164                                  
   165                                  ; ============================================================
   166                                  ;  Page tables (must be page-aligned)
   167                                  ; ============================================================
   168 00000122 90<rep EDEh>            align 4096
   169 00001000 00<rep 1000h>           pml4_table: times 4096 db 0
   170 00002000 00<rep 1000h>           pdpt_table: times 4096 db 0
   171 00003000 00<rep 1000h>           pd_table:   times 4096 db 0
   172                                  
   173                                  
   174                                  ; ============================================================
   175                                  ;  ============  64-BIT KERNEL STARTS HERE  =================
   176                                  ; ============================================================
   177                                  
   178                                  VGA_MEMORY   equ 0xB8000
   179                                  VGA_COLS     equ 80
   180                                  VGA_ROWS     equ 25
   181                                  WHITE_ON_BLACK equ 0x0F
   182                                  RED_ON_BLACK   equ 0x04
   183                                  
   184                                  LINE_BUF_LEN equ 256
   185                                  
