 12485 00009A26 4883C702                    add rdi, 2
 12486 00009A2A 48FFC6                      inc rsi
 12487 00009A2D EBEC                        jmp .wig_write
 12488                                  .wig_written:
 12489 00009A2F 5F                          pop rdi
 12490 00009A30 5E                          pop rsi
 12491 00009A31 59                          pop rcx
 12492 00009A32 5B                          pop rbx
 12493 00009A33 58                          pop rax
 12494 00009A34 C3                          ret
 12495                                  
 12496                                  ; wig_clear: blanks the 8-column corner slot the widget draws in.
 12497                                  wig_clear:
