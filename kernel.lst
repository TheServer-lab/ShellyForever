 13247                                  ; scrollback_render: al = desired scroll offset (0 = live). Clamps to
 13248                                  ; [0, sb_count], stores the clamped value in scroll_offset, and redraws
 13249                                  ; VGA_BASE either as the pure live screen (from live_snapshot) or as a
 13250                                  ; composite of scrollback_buf + live_snapshot. Parks the hardware cursor
 13251                                  ; off-screen while scrolled back, since it belongs to the live line the
 13252                                  ; user is no longer looking at.
 13253                                  scrollback_render:
 13254 0001466D 50                          push rax
 13255 0001466E 53                          push rbx
 13256 0001466F 51                          push rcx
 13257 00014670 52                          push rdx
 13258 00014671 56                          push rsi
 13259 00014672 57                          push rdi
