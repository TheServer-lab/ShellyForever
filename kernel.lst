  8619                                  ; ============================================================
  8620                                  ; fs_resolve_path: walks a '/'-separated path, one folder at a time,
  8621                                  ; using the same node_parent/fs_find_child machinery every other command
  8622                                  ; already relies on. Understands "/" (root), "." and ".." (like cf always
  8623                                  ; has), collapses repeated or trailing slashes, and treats a leading
  8624                                  ; "/home" as an alias for root (same alias cf used to special-case).
  8625                                  ;
  8626                                  ; in:  rax = starting dir index (normally [cur_dir])
  8627                                  ;      rsi = path string, e.g. "docs/notes.txt", "..", "/home/docs", "notes.txt"
  8628                                  ;      rdi = 0            -> whole-path mode: every component (including
  8629                                  ;                             the last) is resolved as a folder. Used by cf.
  8630                                  ;            leaf_buf ptr -> split mode: all components except the last
  8631                                  ;                             are resolved as folders; the last component
  8632                                  ;                             is copied verbatim into [leaf_buf] instead of
  8633                                  ;                             being looked up. Used by anything that names
  8634                                  ;                             a file/folder to act on (view, del, rname,
  8635                                  ;                             cpy, mov, mkf, mkfl).
  8636                                  ; out: rax = resolved dir index, or -1 if a folder component along the way
  8637                                  ;            doesn't exist (leaf_buf, if any, is left untouched on failure)
  8638                                  ; ============================================================
  8639                                  fs_resolve_path:
  8640 000177A5 53                          push rbx
  8641 000177A6 51                          push rcx
  8642 000177A7 52                          push rdx
  8643 000177A8 4150                        push r8
  8644 000177AA 4151                        push r9
  8645 000177AC 4152                        push r10
  8646 000177AE 4154                        push r12
  8647 000177B0 4155                        push r13
  8648 000177B2 4156                        push r14
  8649 000177B4 4989FC                      mov r12, rdi                ; leaf buf ptr, or 0 for whole-path mode
  8650 000177B7 4989C5                      mov r13, rax                ; running "current dir" as we walk
  8651 000177BA 4989F6                      mov r14, rsi                ; path cursor
  8652                                  
  8653 000177BD 41803E2F                    cmp byte [r14], '/'
  8654 000177C1 7506                        jne .parse_loop
  8655 000177C3 41BD00000000                mov r13, 0                  ; absolute path -> start from root
  8656                                  
  8657                                  .parse_loop:
  8658                                  .skip_seps:
  8659 000177C9 41803E2F                    cmp byte [r14], '/'
  8660 000177CD 7505                        jne .extract_check
  8661 000177CF 49FFC6                      inc r14
  8662 000177D2 EBF5                        jmp .skip_seps
  8663                                  .extract_check:
  8664 000177D4 41803E00                    cmp byte [r14], 0
  8665 000177D8 0F84FE000000                je .success                 ; nothing left to parse - done
  8666 000177DE 48BF-                       mov rdi, path_comp_buf
  8666 000177E0 [20E4060000000000] 
  8667                                  .copy_loop:
  8668 000177E8 418A06                      mov al, [r14]
  8669 000177EB 3C00                        cmp al, 0
  8670 000177ED 740E                        je .comp_done
  8671 000177EF 3C2F                        cmp al, '/'
  8672 000177F1 740A                        je .comp_done
  8673 000177F3 8807                        mov [rdi], al
  8674 000177F5 48FFC7                      inc rdi
  8675 000177F8 49FFC6                      inc r14
  8676 000177FB EBEB                        jmp .copy_loop
  8677                                  .comp_done:
  8678 000177FD C60700                      mov byte [rdi], 0
  8679                                      ; peek past any trailing slashes to see whether anything real remains
  8680                                  .skip_seps2:
  8681 00017800 41803E2F                    cmp byte [r14], '/'
  8682 00017804 7505                        jne .check_last
  8683 00017806 49FFC6                      inc r14
  8684 00017809 EBF5                        jmp .skip_seps2
  8685                                  .check_last:
  8686 0001780B 41803E00                    cmp byte [r14], 0
  8687 0001780F 751F                        jne .resolve_component      ; more path remains -> this is a folder step
  8688 00017811 4983FC00                    cmp r12, 0
  8689 00017815 7419                        je .resolve_component        ; whole-path mode: resolve last comp too
  8690                                      ; split mode, and this was the last component -> it's the leaf name
  8691 00017817 56                          push rsi
  8692 00017818 48BE-                       mov rsi, path_comp_buf
  8692 0001781A [20E4060000000000] 
  8693 00017822 4C89E7                      mov rdi, r12
  8694 00017825 E8A9500100                  call str_copy
  8695 0001782A 5E                          pop rsi
  8696 0001782B E9AC000000                  jmp .success
  8697                                  .resolve_component:
  8698 00017830 48BE-                       mov rsi, path_comp_buf
  8698 00017832 [20E4060000000000] 
  8699 0001783A 48BF-                       mov rdi, str_updir
  8699 0001783C [BC38030000000000] 
  8700 00017844 E8BA500100                  call str_eq
  8701 00017849 3C01                        cmp al, 1
  8702 0001784B 7463                        je .do_updir
  8703 0001784D 48BE-                       mov rsi, path_comp_buf
  8703 0001784F [20E4060000000000] 
  8704 00017857 48BF-                       mov rdi, str_dot
  8704 00017859 [BF38030000000000] 
  8705 00017861 E89D500100                  call str_eq
  8706 00017866 3C01                        cmp al, 1
  8707 00017868 745E                        je .after_resolve            ; "." is a no-op
  8708                                      ; "/home" alias: while sitting at root, a literal "home" component
  8709                                      ; is a no-op too (matches the old single-token "/home" special case)
  8710 0001786A 4983FD00                    cmp r13, 0
  8711 0001786E 751D                        jne .lookup_child
  8712 00017870 48BE-                       mov rsi, path_comp_buf
  8712 00017872 [20E4060000000000] 
  8713 0001787A 48BF-                       mov rdi, str_home_name
  8713 0001787C [DC3B030000000000] 
  8714 00017884 E87A500100                  call str_eq
  8715 00017889 3C01                        cmp al, 1
  8716 0001788B 743B                        je .after_resolve
  8717                                  .lookup_child:
  8718 0001788D 4C89E8                      mov rax, r13
  8719 00017890 48BE-                       mov rsi, path_comp_buf
  8719 00017892 [20E4060000000000] 
  8720 0001789A 41BA01000000                mov r10, 1                   ; must be a folder to descend into
  8721 000178A0 E860F9FFFF                  call fs_find_child
  8722 000178A5 4883F8FF                    cmp rax, -1
  8723 000178A9 7428                        je .notfound
  8724 000178AB 4989C5                      mov r13, rax
  8725 000178AE EB18                        jmp .after_resolve
  8726                                  .do_updir:
  8727 000178B0 4983FD00                    cmp r13, 0
  8728 000178B4 7412                        je .after_resolve            ; already at root, no-op
  8729 000178B6 4B0FB79C2D-                 movzx rbx, word [node_parent + r13*2]
  8729 000178BB [50900300]         
  8730 000178BF 6683FBFF                    cmp bx, 0xFFFF
  8731 000178C3 7403                        je .after_resolve
  8732 000178C5 4989DD                      mov r13, rbx
  8733                                  .after_resolve:
  8734 000178C8 41803E00                    cmp byte [r14], 0
  8735 000178CC 740E                        je .success
  8736 000178CE E9F6FEFFFF                  jmp .parse_loop
  8737                                  .notfound:
  8738 000178D3 48C7C0FFFFFFFF              mov rax, -1
  8739 000178DA EB03                        jmp .out
  8740                                  .success:
  8741 000178DC 4C89E8                      mov rax, r13
  8742                                  .out:
  8743 000178DF 415E                        pop r14
  8744 000178E1 415D                        pop r13
  8745 000178E3 415C                        pop r12
  8746 000178E5 415A                        pop r10
  8747 000178E7 4159                        pop r9
  8748 000178E9 4158                        pop r8
  8749 000178EB 5A                          pop rdx
  8750 000178EC 59                          pop rcx
  8751 000178ED 5B                          pop rbx
  8752 000178EE C3                          ret
  8753                                  
  8754                                  ; ============================================================
  8755                                  ;  DISK PERSISTENCE  (ATA PIO driver, primary bus, LBA28, polling)
  8756                                  ; ============================================================
  8757                                  ; Ports (primary ATA channel):
  8758                                  ;   0x1F0 data, 0x1F1 features/error, 0x1F2 sector count,
  8759                                  ;   0x1F3/4/5 LBA low/mid/high, 0x1F6 drive/head, 0x1F7 status/command.
  8760                                  ; No IRQs are used anywhere in this kernel, so these routines just
  8761                                  ; poll BSY/DRQ in the status register, matching the polled keyboard
  8762                                  ; driver's style.
  8763                                  
  8764                                  ; ata_wait_bsy: block until BSY (bit 7) clears, or give up after a timeout.
  8765                                  ; returns CF=0 on success, CF=1 on timeout (no device responding at all,
  8766                                  ; e.g. real hardware with no legacy IDE controller / booting off USB).
  8767                                  ATA_TIMEOUT equ 0x400000
  8768                                  ; ata_wait_bsy: block until BSY (bit 7) clears, or give up after a timeout.
  8769                                  ; returns CF=0 on success, CF=1 on timeout (no device responding at all,
  8770                                  ; e.g. real hardware with no legacy IDE controller / booting off USB).
  8771                                  ATA_TIMEOUT equ 0x400000
  8772                                  ata_wait_bsy:
  8773 000178EF 50                          push rax
  8774 000178F0 52                          push rdx
  8775 000178F1 51                          push rcx
  8776 000178F2 B900004000                  mov rcx, ATA_TIMEOUT
  8777 000178F7 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8778 000178FF 6683C207                    add dx, 7
  8779                                  .wait:
  8780 00017903 EC                          in al, dx
  8781 00017904 A880                        test al, 0x80
  8782 00017906 7407                        jz .ok
  8783 00017908 E2F9                        loop .wait
  8784 0001790A 59                          pop rcx
  8785 0001790B 5A                          pop rdx
  8786 0001790C 58                          pop rax
  8787 0001790D F9                          stc
  8788 0001790E C3                          ret
  8789                                  .ok:
  8790 0001790F 59                          pop rcx
  8791 00017910 5A                          pop rdx
  8792 00017911 58                          pop rax
  8793 00017912 F8                          clc
  8794 00017913 C3                          ret
  8795                                  
  8796                                  ; ata_wait_drq: block until DRQ (bit 3) sets, or time out (see ata_wait_bsy)
  8797                                  ata_wait_drq:
  8798 00017914 50                          push rax
  8799 00017915 52                          push rdx
  8800 00017916 51                          push rcx
  8801 00017917 B900004000                  mov rcx, ATA_TIMEOUT
  8802 0001791C 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8803 00017924 6683C207                    add dx, 7
  8804                                  .wait:
  8805 00017928 EC                          in al, dx
  8806 00017929 A808                        test al, 0x08
  8807 0001792B 7507                        jnz .ok
  8808 0001792D E2F9                        loop .wait
  8809 0001792F 59                          pop rcx
  8810 00017930 5A                          pop rdx
  8811 00017931 58                          pop rax
  8812 00017932 F9                          stc
  8813 00017933 C3                          ret
  8814                                  .ok:
  8815 00017934 59                          pop rcx
  8816 00017935 5A                          pop rdx
  8817 00017936 58                          pop rax
  8818 00017937 F8                          clc
  8819 00017938 C3                          ret
  8820                                  
  8821                                  ; ata_select_device: al = device id (0=primary master, 1=primary slave,
  8822                                  ; 2=secondary master, 3=secondary slave). Picks the I/O port base and the
  8823                                  ; drive-select bit so every ATA routine below talks to the right drive.
  8824                                  ata_select_device:
  8825 00017939 50                          push rax
  8826 0001793A 2403                        and al, 3
  8827 0001793C 3C02                        cmp al, 2
  8828 0001793E 720E                        jb .primary
  8829 00017940 66C70425[60E80500]-         mov word [ata_port_base], 0x170
  8829 00017948 7001               
  8830 0001794A 2C02                        sub al, 2
  8831 0001794C EB0A                        jmp .drive
  8832                                  .primary:
  8833 0001794E 66C70425[60E80500]-         mov word [ata_port_base], 0x1F0
  8833 00017956 F001               
  8834                                  .drive:
  8835 00017958 A801                        test al, 1
  8836 0001795A 750A                        jnz .slave
  8837 0001795C C60425[62E80500]E0          mov byte [ata_drive_sel], 0xE0
  8838 00017964 EB08                        jmp .done
  8839                                  .slave:
  8840 00017966 C60425[62E80500]F0          mov byte [ata_drive_sel], 0xF0
  8841                                  .done:
  8842 0001796E 58                          pop rax
  8843 0001796F C3                          ret
  8844                                  
  8845                                  ; ata_read_sector: rax = LBA (28-bit), rdi = 512-byte destination buffer
  8846                                  ; returns CF=0 on success, CF=1 on failure/timeout (buffer left untouched
  8847                                  ; or partially written - caller should not trust it on failure).
  8848                                  ata_read_sector:
  8849 00017970 50                          push rax
  8850 00017971 53                          push rbx
  8851 00017972 51                          push rcx
  8852 00017973 52                          push rdx
  8853 00017974 57                          push rdi
  8854 00017975 4889C3                      mov rbx, rax                 ; keep LBA
  8855 00017978 E872FFFFFF                  call ata_wait_bsy
  8856 0001797D 0F829B000000                jc .fail
  8857 00017983 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8858 0001798B 6683C206                    add dx, 6
  8859 0001798F 4889D8                      mov rax, rbx
  8860 00017992 48C1E818                    shr rax, 24
  8861 00017996 240F                        and al, 0x0F
  8862 00017998 0A0425[62E80500]            or al, [ata_drive_sel]       ; LBA mode + master/slave bit
  8863 0001799F EE                          out dx, al
  8864 000179A0 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8865 000179A8 6683C202                    add dx, 2
  8866 000179AC B001                        mov al, 1                    ; sector count = 1
  8867 000179AE EE                          out dx, al
  8868 000179AF 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8869 000179B7 6683C203                    add dx, 3
  8870 000179BB 88D8                        mov al, bl
  8871 000179BD EE                          out dx, al                   ; LBA[0:7]
  8872 000179BE 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8873 000179C6 6683C204                    add dx, 4
  8874 000179CA 4889D8                      mov rax, rbx
  8875 000179CD 48C1E808                    shr rax, 8
  8876 000179D1 EE                          out dx, al                   ; LBA[8:15]
  8877 000179D2 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8878 000179DA 6683C205                    add dx, 5
  8879 000179DE 4889D8                      mov rax, rbx
  8880 000179E1 48C1E810                    shr rax, 16
  8881 000179E5 EE                          out dx, al                   ; LBA[16:23]
  8882 000179E6 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8883 000179EE 6683C207                    add dx, 7
  8884 000179F2 B020                        mov al, 0x20                 ; READ SECTORS (with retry)
  8885 000179F4 EE                          out dx, al
  8886 000179F5 E8F5FEFFFF                  call ata_wait_bsy
  8887 000179FA 7222                        jc .fail
  8888 000179FC E813FFFFFF                  call ata_wait_drq
  8889 00017A01 721B                        jc .fail
  8890 00017A03 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8891 00017A0B B900010000                  mov rcx, 256                 ; 256 words = 512 bytes
  8892                                  .readloop:
  8893 00017A10 66ED                        in ax, dx
  8894 00017A12 668907                      mov [rdi], ax
  8895 00017A15 4883C702                    add rdi, 2
  8896 00017A19 E2F5                        loop .readloop
  8897 00017A1B F8                          clc
  8898 00017A1C EB01                        jmp .done
