 15948                                  %include "install.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  INSTALL.ASM  --  Shelly Installer (.sin packages / .inst scripts)
     3                              <1> ; ============================================================
     4                              <1> ; Implements the "ShellyForever Programs & Installer System" spec
     5                              <1> ; (v0.1) and its "whattodo.inst" instruction language on top of the
     6                              <1> ; ZIP-container primitives already in zip.asm: a .sin file IS a
     7                              <1> ; stored-mode .zip (see zip.asm's own scope note - method 0 only),
     8                              <1> ; so cmd_install reuses zip_find_eocd/zip_unpack_validate verbatim
     9                              <1> ; and only adds package-specific logic: finding whattodo.inst inside
    10                              <1> ; the archive, running its instructions, and the program registry.
    11                              <1> ;
    12                              <1> ; Commands added (kernel.asm wires these into dispatch + help text,
    13                              <1> ; same as pack/unpack):
    14                              <1> ;   install <file.sin>   run a .sin package's installer
    15                              <1> ;   uninstall <id>        remove a program by its registered id
    16                              <1> ;
    17                              <1> ; Also wires a dispatch FALLBACK: typing a bare registered program
    18                              <1> ; id (e.g. "calc"), with or without a "-back" flag, launches it the
    19                              <1> ; same way a bare "<n>.run" already does - see reg_lookup_path and
    20                              <1> ; its call site in kernel.asm's dispatch, right before "unknown
    21                              <1> ; command". This is what makes spec section 8 ("Program Execution")
    22                              <1> ; work without a separate "run <id>" command on top of the existing
    23                              <1> ; "run <path>" one.
    24                              <1> ;
    25                              <1> ; Registry format (spec section 5), stored at /sys/programs.sly
    26                              <1> ; (root's "sys" folder - "/home" is just root's display alias, see
    27                              <1> ; fs_resolve_path's own alias handling, so the real on-disk path is
    28                              <1> ; "sys/programs.sly"):
    29                              <1> ;
    30                              <1> ;     program = <id>
    31                              <1> ;     path = <absolute path>
    32                              <1> ;
    33                              <1> ; blank-line separated, one entry per program. Only this module ever
    34                              <1> ; writes the file, so the reader trusts the exact "program = " /
    35                              <1> ; "path = " prefixes (10 / 7 bytes, space included) rather than
    36                              <1> ; doing general whitespace-tolerant parsing.
    37                              <1> ;
    38                              <1> ; Known gaps / deferred (mirrors zip.asm's own such section):
    39                              <1> ;   - No transactional rollback: if an instruction mid-script fails,
    40                              <1> ;     whatever mkdir/copy/program calls already ran stay applied.
    41                              <1> ;     Spec section 16 only says installation SHOULD stop on error,
    42                              <1> ;     not that it must undo prior steps - this does the former.
    43                              <1> ;   - `uninstall` only removes the ONE file recorded as a program's
    44                              <1> ;     "path" (its entry point) plus the registry entry - not every
    45                              <1> ;     file a `copy` instruction wrote during install, since v0.1's
    46                              <1> ;     registry keeps no manifest of those. Matches spec section 9's
    47                              <1> ;     "SHOULD" (not MUST) and its "preserve unrelated files" rule -
    48                              <1> ;     deleting files we have no record of would risk exactly that.
    49                              <1> ;   - `delete` in whattodo.inst refuses to delete folders (every
    50                              <1> ;     spec example only ever targets a file) and is a non-fatal
    51                              <1> ;     no-op if the target is already missing (idempotent).
    52                              <1> ;   - Registry updates are append-at-end: updating an id removes
    53                              <1> ;     its old two-line entry and appends a fresh one at the bottom,
    54                              <1> ;     rather than editing in place, so entry order can drift across
    55                              <1> ;     updates. The content is equivalent either way.
    56                              <1> ;   - Package/registry size caps mirror zip.asm's own EDIT_MAX-based
    57                              <1> ;     philosophy: a whole .sin is capped like any other file
    58                              <1> ;     (EDIT_MAX), whattodo.inst itself at INST_MAX, and the whole
    59                              <1> ;     programs.sly registry at REG_MAX - all clean errors, not
    60                              <1> ;     silent truncation.
    61                              <1> ;   - Not tested in a real boot/QEMU environment - only nasm
    62                              <1> ;     syntax-checked alongside the rest of the kernel image.
    63                              <1> ; ============================================================
    64                              <1> 
    65                              <1> INST_MAX equ 4096              ; max bytes for one whattodo.inst script
    66                              <1> REG_MAX  equ 8192              ; max bytes for the whole programs.sly registry
    67                              <1> 
