   688 00038C4C 488D3425[28F10300]  <1>     lea rsi, [hkdf_label_buf]
   689 00038C54 4889CA              <1>     mov rdx, rcx                  ; info len
   690 00038C57 4C89C9              <1>     mov rcx, r9                   ; desired L
   691 00038C5A 4D89D0              <1>     mov r8, r10                   ; output ptr
