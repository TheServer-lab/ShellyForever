 14988 0003A1F2 90<rep 6h>              ALIGN 8
 14989 0003A1F8 0000000000000000-       calc_vals:  times MAX_CALC_TOKENS dq 0
 14989 0003A1F8 <rep 20h>          
 14990 0003A2F8 0000000000000000-       calc_vals2: times MAX_CALC_TOKENS dq 0
 14990 0003A2F8 <rep 20h>          
 14991 0003A3F8 00<rep 20h>             calc_ops:   times MAX_CALC_TOKENS db 0
 14992 0003A418 00<rep 20h>             calc_ops2:  times MAX_CALC_TOKENS db 0
 14993 0003A438 00<rep 18h>             calc_out_buf: times 24 db 0
 14994 0003A450 00<rep 18h>             show_num_buf: times 24 db 0
 14995 0003A468 00<rep 18h>             dev_name_num_buf: times 24 db 0
 14996 0003A480 00<rep 28h>             ident_buf:  times 40 db 0
