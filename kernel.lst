   522 00038AB5 53                  <1>     push rbx
   523 00038AB6 51                  <1>     push rcx
   524 00038AB7 52                  <1>     push rdx
   525 00038AB8 56                  <1>     push rsi
   526 00038AB9 57                  <1>     push rdi
   527 00038ABA 4150                <1>     push r8
   528 00038ABC 4151                <1>     push r9
   529 00038ABE 4154                <1>     push r12
   530 00038AC0 4155                <1>     push r13
   531 00038AC2 4156                <1>     push r14
   532 00038AC4 4157                <1>     push r15
   533                              <1> 
   534 00038AC6 4989FC              <1>     mov r12, rdi                  ; prk ptr
   535 00038AC9 4989F5              <1>     mov r13, rsi                  ; info ptr
   536 00038ACC 4189D6              <1>     mov r14d, edx                 ; info len
   537 00038ACF 4189CF              <1>     mov r15d, ecx                 ; desired L
   538 00038AD2 4C89C3              <1>     mov rbx, r8                   ; output ptr
   539                              <1> 
   540 00038AD5 4531C9              <1>     xor r9d, r9d                  ; bytes produced so far
   541 00038AD8 31C0                <1>     xor eax, eax
   542 00038ADA 890425[20EF0300]    <1>     mov [hkdf_t_len], eax         ; t_len = 0 (T(0) is empty)
   543 00038AE1 B801000000          <1>     mov eax, 1
   544 00038AE6 890425[24EF0300]    <1>     mov [hkdf_counter], eax       ; i = 1
   545                              <1> 
   546                              <1> .hk_round:
   547 00038AED 4539F9              <1>     cmp r9d, r15d
   548 00038AF0 0F83C5000000        <1>     jae .hk_done
   549 00038AF6 813C25[24EF0300]00- <1>     cmp dword [hkdf_counter], 256
   549 00038AFE 010000              <1>
   550 00038B01 0F83B4000000        <1>     jae .hk_done                  ; safety cap, should never hit for our use
   551                              <1> 
   552                              <1>     ; build msg = T(i-1) [t_len bytes] || info [r14d bytes] || i [1 byte]
   553                              <1>     ; (rdi is (re)computed from hkdf_msg_buf + t_len rather than relying
   554                              <1>     ; on rep movsb's auto-advance, so the t_len==0 first round and the
   555                              <1>     ; t_len==32 later rounds both land at the same, correct offset.)
   556 00038B07 488D3C25[28EF0300]  <1>     lea rdi, [hkdf_msg_buf]
   557 00038B0F 8B0425[20EF0300]    <1>     mov eax, [hkdf_t_len]
   558 00038B16 85C0                <1>     test eax, eax
