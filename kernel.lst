  1518                              <1> ; ------------------------------------------------------------
  1519                              <1> ; party_boot_compiled: KAPI_BOOT. A compiled .run binary's entry stub
  1520                              <1> ; does LEA RSI, embedded-source ; CALL [KAPI_BOOT] ; RET - this is that
  1521                              <1> ; bootstrap. rsi = the Party source embedded in the .run file (token
  1522                              <1> ; text offsets are relative to it). Resets the runtime, lexes the
  1523                              <1> ; embedded source, collects func declarations and runs the program
  1524                              <1> ; with the tree-walking interpreter - the same path 'party foo.pa'
  1525                              <1> ; uses, so a compiled program needs no separate runtime. On a lex
  1526                              <1> ; error prints the failing line to the screen. Clobbers rax-r15 and
  1527                              <1> ; the FPU; sets party_exec_ok / party_lex_ok / party_error_line.
  1528                              <1> ; ------------------------------------------------------------
  1529                              <1> party_boot_compiled:
  1530 000270B8 48893425[07B30200]  <1>     mov [party_src_base], rsi
  1531 000270C0 E8BE0E0000          <1>     call party_reset_runtime
  1532 000270C5 E87AF8FFFF          <1>     call party_lex
  1533 000270CA 803C25[00B30200]01  <1>     cmp byte [party_lex_ok], 1
  1534 000270D2 751E                <1>     jne .pbc_lex_fail
  1535 000270D4 4D31ED              <1>     xor r13, r13                   ; statement cursor, like party_exec does
  1536 000270D7 E8BC020000          <1>     call party_collect_funcs
  1537 000270DC 803C25[01B30200]01  <1>     cmp byte [party_exec_ok], 1
  1538 000270E4 750B                <1>     jne .pbc_out
  1539 000270E6 41BE00000000        <1>     mov r14, TOK_EOF
  1540 000270EC E812040000          <1>     call party_exec_stmts
  1541                              <1> .pbc_out:
  1542 000270F1 C3                  <1>     ret
