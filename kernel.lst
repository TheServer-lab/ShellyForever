  6240 00015991 51                          push rcx
  6241 00015992 57                          push rdi
  6242 00015993 4889FB                      mov rbx, rdi                    ; rbx = slot index
  6243 00015996 C683[24090700]00            mov byte [proc_state + rbx], 0
  6244 0001599D 66C7841B[E0080700]-         mov word [proc_id + rbx*2], 0
  6244 000159A5 0000               
  6245 000159A7 4889D8                      mov rax, rbx
  6246 000159AA 486BC020                    imul rax, 32
  6247 000159AE 488DB8[E4080700]            lea rdi, [proc_name + rax]
  6248 000159B5 B920000000                  mov rcx, 32
  6249 000159BA 30C0                        xor al, al
  6250 000159BC F3AA                        rep stosb
  6251 000159BE 5F                          pop rdi
  6252 000159BF 59                          pop rcx
  6253 000159C0 5B                          pop rbx
  6254 000159C1 C3                          ret
