 16470                                  ; ============================================================
 16471                                  ;  loading spinner: a tiny |/-\ animation for operations that take a
 16472                                  ;  visible moment (scanning drives, formatting). spinner_step draws one
 16473                                  ;  frame at the current cursor cell and steps the cursor back onto that
 16474                                  ;  same cell, so repeated calls animate in place instead of scrolling
 16475                                  ;  text across the screen; spinner_clear blanks that cell again once
 16476                                  ;  the operation is done, leaving the cursor exactly where it was.
 16477                                  ; ============================================================
 16478 00070EC4 00                      spinner_idx: db 0
 16479 00070EC5 7C2F2D5C                spinner_frames: db '|','/','-','\'
 16480                                  
 16481                                  spinner_step:
 16482 00070EC9 50                          push rax
 16483 00070ECA 53                          push rbx
 16484 00070ECB 51                          push rcx
 16485 00070ECC 480FB60425-                 movzx rax, byte [spinner_idx]
 16485 00070ED1 [C40E0700]         
 16486 00070ED5 2403                        and al, 3
 16487 00070ED7 480FB6C8                    movzx rcx, al
 16488 00070EDB 8A81[C50E0700]              mov al, [spinner_frames + rcx]
 16489 00070EE1 8A1C25[241A0700]            mov bl, [cur_normal_attr]
 16490 00070EE8 E8DDFDFFFF                  call putchar
 16491 00070EED FE0C25[191A0700]            dec byte [cursor_col]
 16492 00070EF4 E8CEFCFFFF                  call update_cursor
 16493 00070EF9 FE0425[C40E0700]            inc byte [spinner_idx]
 16494 00070F00 59                          pop rcx
 16495 00070F01 5B                          pop rbx
 16496 00070F02 58                          pop rax
 16497 00070F03 C3                          ret
 16498                                  
 16499                                  spinner_clear:
 16500 00070F04 50                          push rax
 16501 00070F05 53                          push rbx
 16502 00070F06 B020                        mov al, ' '
 16503 00070F08 8A1C25[241A0700]            mov bl, [cur_normal_attr]
 16504 00070F0F E8B6FDFFFF                  call putchar
 16505 00070F14 FE0C25[191A0700]            dec byte [cursor_col]
 16506 00070F1B E8A7FCFFFF                  call update_cursor
 16507 00070F20 5B                          pop rbx
 16508 00070F21 58                          pop rax
 16509 00070F22 C3                          ret
