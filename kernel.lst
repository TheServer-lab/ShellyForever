  9458                                      ; Register H2D FIS at command table offset 0
  9459 00017F3E 41C60127                    mov byte [r9 + 0], 0x27       ; FIS_TYPE_REG_H2D
  9460 00017F42 41C6410180                  mov byte [r9 + 1], 0x80       ; C = 1 (this FIS carries a Command)
  9461 00017F47 8A0425[AAE80500]            mov al, [ahci_op_cmd]
  9462 00017F4E 41884102                    mov byte [r9 + 2], al         ; Command register
  9463                                  
  9464 00017F52 4C89E0                      mov rax, r12
  9465 00017F55 41884104                    mov byte [r9 + 4], al         ; LBA[7:0]
  9466 00017F59 4889C1                      mov rcx, rax
  9467 00017F5C 48C1E908                    shr rcx, 8
  9468 00017F60 41884905                    mov byte [r9 + 5], cl         ; LBA[15:8]
  9469 00017F64 4889C1                      mov rcx, rax
  9470 00017F67 48C1E910                    shr rcx, 16
  9471 00017F6B 41884906                    mov byte [r9 + 6], cl         ; LBA[23:16]
  9472 00017F6F 41C6410740                  mov byte [r9 + 7], 0x40       ; Device (LBA mode)
  9473 00017F74 4889C1                      mov rcx, rax
  9474 00017F77 48C1E918                    shr rcx, 24
  9475 00017F7B 41884908                    mov byte [r9 + 8], cl         ; LBA[31:24]
  9476 00017F7F 4889C1                      mov rcx, rax
  9477 00017F82 48C1E920                    shr rcx, 32
  9478 00017F86 41884909                    mov byte [r9 + 9], cl         ; LBA[39:32]
  9479 00017F8A 4889C1                      mov rcx, rax
  9480 00017F8D 48C1E928                    shr rcx, 40
  9481 00017F91 4188490A                    mov byte [r9 + 10], cl        ; LBA[47:40]
  9482 00017F95 41C6410C01                  mov byte [r9 + 12], 1         ; sector count = 1
  9483                                  
  9484                                      ; PRDT entry, at command table offset 128: points straight at the
  9485                                      ; caller's buffer (identity-mapped, so virtual == physical here).
  9486 00017F9A 4589A980000000              mov [r9 + 128], r13d          ; DBA
  9487 00017FA1 41C781840000000000-         mov dword [r9 + 132], 0       ; DBAU
  9487 00017FAA 0000               
  9488 00017FAC 41C781880000000000-         mov dword [r9 + 136], 0       ; reserved
  9488 00017FB5 0000               
  9489 00017FB7 B8FF010000                  mov eax, 511                  ; byte count field is (N-1); no IRQ bit
  9490 00017FBC 4189818C000000              mov [r9 + 140], eax
  9491                                  
  9492 00017FC3 41C74710FFFFFFFF            mov dword [r15 + 0x10], 0xFFFFFFFF   ; PxIS - clear stale status
  9493 00017FCB B801000000                  mov eax, 1
  9494 00017FD0 41894738                    mov [r15 + 0x38], eax                ; PxCI - issue command slot 0
  9495                                  
  9496 00017FD4 B900004000                  mov rcx, AHCI_TIMEOUT
  9497                                  .wait:
  9498 00017FD9 418B4738                    mov eax, [r15 + 0x38]
  9499 00017FDD A901000000                  test eax, 1
