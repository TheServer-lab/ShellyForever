    59 0002575D 57                  <1>     push rdi
    60 0002575E 51                  <1>     push rcx
    61 0002575F 4885C9              <1>     test rcx, rcx
    62 00025762 741B                <1>     jz .bcsm_zero
    63 00025764 48FFC9              <1>     dec rcx
