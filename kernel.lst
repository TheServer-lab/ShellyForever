 14275 0001B029 B100                        mov cl, 0
 14276                                  .ee_out:
 14277 0001B02B 415F                        pop r15
 14278 0001B02D 415E                        pop r14
 14279 0001B02F 415D                        pop r13
 14280 0001B031 415C                        pop r12
 14281 0001B033 415B                        pop r11
 14282 0001B035 415A                        pop r10
 14283 0001B037 4159                        pop r9
 14284 0001B039 4158                        pop r8
 14285 0001B03B 5A                          pop rdx
