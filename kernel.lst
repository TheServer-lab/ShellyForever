 10459 00018847 663DEC10                    cmp ax, RTL_VENDOR_ID
 10460 0001884B 7520                        jne .rfunc_next
 10461 0001884D C1E810                      shr eax, 16
 10462 00018850 4C8D0C25[90A40600]          lea r9, [rtl_dev_ids]
 10463 00018858 41BA04000000                mov r10d, RTL_DEV_ID_COUNT
 10464                                  .rcmp_loopN:
 10465 0001885E 66413901                    cmp word [r9], ax
 10466 00018862 742A                        je .rfound
 10467 00018864 4983C102                    add r9, 2
 10468 00018868 41FFCA                      dec r10d
 10469 0001886B 75F1                        jnz .rcmp_loopN
 10470                                  .rfunc_next:
