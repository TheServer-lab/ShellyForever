  3380 000286FF 30C0                <1>     xor al, al
  3381 00028701 C3                  <1>     ret
  3382                              <1> 
  3383                              <1> ; party_pel_append: appends rcx bytes from rsi to the interpolation
  3384                              <1> ; output cursor (r10 = write pointer, r11 = bytes of capacity left),
