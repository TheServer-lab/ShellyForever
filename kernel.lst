  3888 00028D39 488D3C25[6BB30200]  <1>     lea rdi, [str_fn_fwrite]
  3889 00028D41 E81F7E0400          <1>     call str_eq
  3890 00028D46 3C01                <1>     cmp al, 1
  3891 00028D48 0F843B020000        <1>     je .pcb_fwrite
