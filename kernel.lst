 11602 000097C6 41B034                      mov r8b, 0x34                  ; Capabilities Pointer register
 11603 000097C9 E8D3F2FFFF                  call pci_read32
 11604 000097CE 440FB6D8                    movzx r11d, al                 ; r11 = offset of first capability
