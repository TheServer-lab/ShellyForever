  5791 00004F7B EF                          out dx, eax
  5792 00004F7C 4489D0                      mov eax, r10d
  5793 00004F7F 66BAFC0C                    mov dx, PCI_CFG_DATA
  5794 00004F83 EF                          out dx, eax
  5795 00004F84 4159                        pop r9
  5796 00004F86 5A                          pop rdx
  5797 00004F87 59                          pop rcx
  5798 00004F88 5B                          pop rbx
  5799 00004F89 58                          pop rax
  5800 00004F8A C3                          ret
