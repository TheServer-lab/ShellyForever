 15949                                  %include "sin.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  sin.asm  --  Shelly package manager ("sin get")
     3                              <1> ;
     4                              <1> ;  One shell command, layered on top of https.asm's stake machinery
     5                              <1> ;  and install.asm's cmd_install:
     6                              <1> ;
     7                              <1> ;    sin get <programname> [-keep]
     8                              <1> ;
     9                              <1> ;  Downloads
    10                              <1> ;    https://raw.githubusercontent.com/TheServer-lab/shellybin/refs/heads/main/sin/programs/<programname>.sin
    11                              <1> ;  via TLS 1.3 (same "no certificate validation" trust model as
    12                              <1> ;  stake/sgive -- see https.asm's header comment and https_warn_once,
    13                              <1> ;  reused verbatim here), saves it into the current directory as
    14                              <1> ;  <programname>.sin, then hands that file straight to cmd_install
    15                              <1> ;  (install.asm) exactly as if the user had typed
    16                              <1> ;  "install <programname>.sin" themselves. Once cmd_install returns,
    17                              <1> ;  the downloaded .sin is deleted -- unless "-keep" was given as the
    18                              <1> ;  third argument, in which case it's left in the current directory
    19                              <1> ;  (matching apt's --keep-downloaded-packages / "apt -d" spirit,
    20                              <1> ;  minus the extra flag name since sin only ever has the one thing
    21                              <1> ;  worth keeping).
    22                              <1> ;
    23                              <1> ;  Design notes:
    24                              <1> ;    - This is deliberately a thin GET-then-install wrapper, not a
    25                              <1> ;      third HTTP/TLS client: http_parse_url / http_build_get /
    26                              <1> ;      https_bridge_tx / https_find_body / https_warn_once /
    27                              <1> ;      tls_do_exchange are all reused unchanged from http.asm /
    28                              <1> ;      https.asm, the same way https.asm itself reused http.asm's
    29                              <1> ;      pieces for stake/sgive. The only new wire-format code here is
    30                              <1> ;      building the request URL and the local filename.
    31                              <1> ;    - <programname> is restricted to a bare identifier (letters,
    32                              <1> ;      digits, '-', '_') by sin_validate_name before it's ever
    33                              <1> ;      concatenated into the request path or a filesystem path --
    34                              <1> ;      it's the only piece of this command that isn't an already-
    35                              <1> ;      trusted constant, so this is what stops a name containing
    36                              <1> ;      "/", "..", or whitespace from escaping the intended
    37                              <1> ;      .../sin/programs/ folder on the remote end or writing outside
    38                              <1> ;      the current directory on this end.
    39                              <1> ;    - Cleanup only ever deletes the exact file this command itself
    40                              <1> ;      just wrote (looked back up by name in the current directory,
    41                              <1> ;      the same way cmd_del looks up its target) -- never anything
    42                              <1> ;      cmd_install's whattodo.inst script may have copied elsewhere.
    43                              <1> ;      That mirrors install.asm's own uninstall scope note: no
    44                              <1> ;      manifest of an install's side effects exists to clean up
    45                              <1> ;      beyond the package file itself.
    46                              <1> ;    - Not tested in a real boot/QEMU environment -- only nasm
    47                              <1> ;      syntax-checked alongside the rest of the kernel image, same
    48                              <1> ;      caveat install.asm carries.
    49                              <1> ;
    50                              <1> ;  Included from kernel.asm, after https.asm (https_bridge_tx /
    51                              <1> ;  https_find_body / https_warn_once) and install.asm (cmd_install);
    52                              <1> ;  inherits BITS 64.
    53                              <1> ; ============================================================
    54                              <1> 
    55                              <1> SIN_NAME_MAX equ 60             ; max bytes for <programname> itself
    56                              <1> 
    57                              <1> ; ------------------------------------------------------------
    58                              <1> ; sin_validate_name: rsi = candidate program name (NUL-terminated,
    59                              <1> ; from arg2_buf). Returns al=1 if it's a safe bare identifier --
    60                              <1> ; 1..SIN_NAME_MAX bytes, letters/digits/'-'/'_' only -- al=0
    61                              <1> ; otherwise. This is the only gate between user input and the
    62                              <1> ; request path / local filename built below, so it runs before
    63                              <1> ; either is touched.
    64                              <1> ; ------------------------------------------------------------
    65                              <1> sin_validate_name:
    66 000702E9 51                  <1>     push rcx
    67 000702EA 56                  <1>     push rsi
    68 000702EB 31C9                <1>     xor ecx, ecx
    69                              <1> .svn_loop:
    70 000702ED 8A06                <1>     mov al, [rsi]
    71 000702EF 84C0                <1>     test al, al
    72 000702F1 742E                <1>     jz .svn_end
    73 000702F3 3C61                <1>     cmp al, 'a'
    74 000702F5 7204                <1>     jb .svn_upper
    75 000702F7 3C7A                <1>     cmp al, 'z'
    76 000702F9 761A                <1>     jbe .svn_ok_char
    77                              <1> .svn_upper:
    78 000702FB 3C41                <1>     cmp al, 'A'
    79 000702FD 7204                <1>     jb .svn_digit
    80 000702FF 3C5A                <1>     cmp al, 'Z'
    81 00070301 7612                <1>     jbe .svn_ok_char
    82                              <1> .svn_digit:
    83 00070303 3C30                <1>     cmp al, '0'
    84 00070305 7204                <1>     jb .svn_dash
    85 00070307 3C39                <1>     cmp al, '9'
    86 00070309 760A                <1>     jbe .svn_ok_char
    87                              <1> .svn_dash:
    88 0007030B 3C2D                <1>     cmp al, '-'
    89 0007030D 7406                <1>     je .svn_ok_char
    90 0007030F 3C5F                <1>     cmp al, '_'
    91 00070311 7402                <1>     je .svn_ok_char
    92 00070313 EB14                <1>     jmp .svn_bad
    93                              <1> .svn_ok_char:
    94 00070315 48FFC6              <1>     inc rsi
    95 00070318 FFC1                <1>     inc ecx
    96 0007031A 83F93C              <1>     cmp ecx, SIN_NAME_MAX
    97 0007031D 770A                <1>     ja .svn_bad
    98 0007031F EBCC                <1>     jmp .svn_loop
    99                              <1> .svn_end:
   100 00070321 85C9                <1>     test ecx, ecx
   101 00070323 7404                <1>     jz .svn_bad
   102 00070325 B001                <1>     mov al, 1
   103 00070327 EB02                <1>     jmp .svn_out
   104                              <1> .svn_bad:
   105 00070329 30C0                <1>     xor al, al
   106                              <1> .svn_out:
   107 0007032B 5E                  <1>     pop rsi
   108 0007032C 59                  <1>     pop rcx
   109 0007032D C3                  <1>     ret
   110                              <1> 
   111                              <1> ; ============================================================
   112                              <1> ; cmd_sin: "sin get <programname> [-keep]"
   113                              <1> ;     Only one subcommand exists today (get); anything else, or a
   114                              <1> ;     bare "sin", prints usage -- same shape as cmd_prs's arg1_buf
   115                              <1> ;     subcommand dispatch in kernel.asm.
   116                              <1> ; ============================================================
