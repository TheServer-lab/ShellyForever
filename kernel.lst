   629                                  ; ------------------------------------------------------------
   630                                  ; expand_identity_map: extends boot.asm's minimal 0-64MB identity map to
   631                                  ; a full 0-4GB identity map using 2MB pages.
   632                                  ;
   633                                  ; Bug this fixes: "sdown" was rebooting the machine instead of shutting
   634                                  ; it down. Root cause: boot.asm's page tables only identity-map the
   635                                  ; first 64MB of physical memory (PML4@0x1000 -> PDPT@0x2000 -> a single
   636                                  ; PD@0x3000 with 32 entries). acpi_shutdown later walks the firmware's
   637                                  ; RSDT/XSDT/FADT/DSDT tables to find the real ACPI power-off port/value,
   638                                  ; and those tables are NOT guaranteed to live under 64MB - confirmed by
   639                                  ; tracing this exact machine: the FADT/DSDT land around 127MB with a
   640                                  ; 128MB guest. Touching that unmapped memory takes a page fault, and
   641                                  ; since there's no IDT installed yet, it escalates straight to a triple
   642                                  ; fault - which looks exactly like a reboot from the user's perspective.
   643                                  ;
   644                                  ; Fix: before anything else runs, reuse boot.asm's existing PML4/PDPT
   645                                  ; (no need to touch those) and add 3 more PD tables (PD1-PD3 at
   646                                  ; 0x4000/0x5000/0x6000, alongside boot.asm's PD0 at 0x3000), wiring all
   647                                  ; 4 into PDPT[0..3]. Then refill all 4 PDs (contiguous in memory) with
   648                                  ; 2048 sequential 2MB pages, giving a full 4GB identity map - enough
   649                                  ; headroom for any RAM size/firmware table placement QEMU, Bochs,
   650                                  ; VirtualBox, or real hardware is likely to use.
   651                                  expand_identity_map:
   652 000005C3 50                          push rax
   653 000005C4 51                          push rcx
   654 000005C5 57                          push rdi
   655                                  
   656                                      ; PDPT[1..3] -> PD1/PD2/PD3 (present+rw). PDPT[0] already points at
   657                                      ; boot.asm's PD0 @ 0x3000.
   658 000005C6 C70425082000000340-         mov dword [0x2000 + 1*8], 0x4000 | 0x3
   658 000005CF 0000               
   659 000005D1 C704250C2000000000-         mov dword [0x2000 + 1*8 + 4], 0
   659 000005DA 0000               
   660 000005DC C70425102000000350-         mov dword [0x2000 + 2*8], 0x5000 | 0x3
   660 000005E5 0000               
   661 000005E7 C70425142000000000-         mov dword [0x2000 + 2*8 + 4], 0
   661 000005F0 0000               
   662 000005F2 C70425182000000360-         mov dword [0x2000 + 3*8], 0x6000 | 0x3
   662 000005FB 0000               
   663 000005FD C704251C2000000000-         mov dword [0x2000 + 3*8 + 4], 0
   663 00000606 0000               
   664                                  
   665                                      ; PD0..PD3 are contiguous (0x3000..0x6FFF = 16KB = 2048 qwords).
   666                                      ; Refill them all with sequential 2MB pages 0, 2MB, ... 4094MB,
   667                                      ; replacing boot.asm's partial PD0 (only entries 0-31 were valid)
   668                                      ; with a complete map.
   669 00000608 BF00300000                  mov rdi, 0x3000
   670 0000060D B883000000                  mov rax, 0x83                  ; present+rw+PS(2MB), base 0
   671 00000612 B900080000                  mov rcx, 512 * 4               ; 512 entries/PD * 4 PDs = 4GB total
   672                                  .fill:
   673 00000617 488907                      mov [rdi], rax
   674 0000061A 480500002000                add rax, 0x200000
   675 00000620 4883C708                    add rdi, 8
   676 00000624 E2F1                        loop .fill
   677                                  
   678 00000626 0F20D8                      mov rax, cr3                   ; reload CR3 to flush any stale TLB
   679 00000629 0F22D8                      mov cr3, rax                   ; entries from the old partial map
   680                                  
   681 0000062C 5F                          pop rdi
   682 0000062D 59                          pop rcx
   683 0000062E 58                          pop rax
   684 0000062F C3                          ret
