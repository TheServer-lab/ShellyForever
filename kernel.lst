 15894 0002D203 7336                        jae .ic_full
 15895 0002D205 88C2                        mov dl, al                   ; stash the typed char - the shift below uses al as scratch
 15896 0002D207 4D39D8                      cmp r8, r11
 15897 0002D20A 7416                        je .ic_no_shift
 15898 0002D20C 4C89C6                      mov rsi, r8
 15899                                  .ic_shift:
 15900 0002D20F 48FFCE                      dec rsi
 15901 0002D212 418A0431                    mov al, [r9 + rsi]
 15902 0002D216 4188443101                  mov [r9 + rsi + 1], al
 15903 0002D21B 4C39DE                      cmp rsi, r11
 15904 0002D21E 7402                        je .ic_no_shift
 15905 0002D220 EBED                        jmp .ic_shift
 15906                                  .ic_no_shift:
 15907 0002D222 88D0                        mov al, dl
 15908 0002D224 43880419                    mov [r9 + r11], al
 15909 0002D228 49FFC0                      inc r8
 15910 0002D22B 4831C9                      xor rcx, rcx                 ; buffer just grew - nothing stale to blank
