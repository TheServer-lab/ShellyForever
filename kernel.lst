  6848                                  ; prs_peek_ring: rdi = slot, rsi = N. Linearizes the process's output
  6849                                  ; ring and prints the last N lines. Clobbers rax, rbx, rcx, rdx,
  6850                                  ; rsi, rdi, r8-r15.
  6851                                  prs_peek_ring:
  6852 00016227 53                          push rbx
  6853 00016228 51                          push rcx
  6854 00016229 52                          push rdx
