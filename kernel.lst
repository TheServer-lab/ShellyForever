  5387                                  ; cmd_sdown: save the filesystem, then power off. Tries a real ACPI
  5388                                  ; shutdown first (finds the FADT/_S5 via the RSDP, which is what real
  5389                                  ; hardware actually requires), then falls back to the fixed magic ports
  5390                                  ; QEMU/Bochs/VirtualBox use as debug shutdown shortcuts, and finally
  5391                                  ; just halts safely if nothing worked.
  5392                                  cmd_sdown:
  5393 00014F95 803C25[C3D70200]00          cmp byte [auth_valid], 0
  5394 00014F9D 7512                        jne .sdown_ok
