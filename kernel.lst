  1634                              <1> ; ------------------------------------------------------------
  1635                              <1> ; party_skip_block: r13 = first token inside a block (already past
  1636                              <1> ; its opening '{'). Advances r13 past the block WITHOUT running any
  1637                              <1> ; of it, stopping at the matching '}' (not consumed). Only tracks
  1638                              <1> ; brace depth, so it doesn't validate anything inside the block.
  1639                              <1> ; Clobbers rax, rbx, rcx.
  1640                              <1> ; ------------------------------------------------------------
  1641                              <1> party_skip_block:
  1642 0001CB29 B901000000          <1>     mov ecx, 1
  1643                              <1> .psb_loop:
  1644 0001CB2E E8CA180000          <1>     call party_tok_ptr
  1645 0001CB33 0FB603              <1>     movzx eax, byte [rbx]
  1646 0001CB36 83F800              <1>     cmp eax, TOK_EOF
  1647 0001CB39 7422                <1>     je .psb_out                    ; unterminated block - caller's next
  1648                              <1>                                     ; token check (expects '}') will error
  1649 0001CB3B 83F80F              <1>     cmp eax, TOK_LBRACE
  1650 0001CB3E 7507                <1>     jne .psb_check_rbrace
  1651 0001CB40 FFC1                <1>     inc ecx
  1652 0001CB42 49FFC5              <1>     inc r13
  1653 0001CB45 EBE7                <1>     jmp .psb_loop
