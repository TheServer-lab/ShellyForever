 10052                                  ; ------------------------------------------------------------------
 10053                                  ;  disk_*: dispatcher in front of the two disk drivers below (legacy ATA
 10054                                  ;  PIO above, AHCI further down). Every caller in this file - vol_read,
 10055                                  ;  vol_write, dscan, fmt, mount - goes through these three routines with
 10056                                  ;  al = device id, exactly like it always called ata_select_device /
 10057                                  ;  ata_read_sector / ata_write_sector directly before. Ids 0-3 still mean
 10058                                  ;  what they always meant (primary/secondary x master/slave); ids 4 and up
 10059                                  ;  mean an AHCI port slot claimed by ahci_init at boot.
 10060                                  ; ------------------------------------------------------------------
 10061                                  
 10062                                  ; disk_select_device: al = device id (0..TOTAL_DEVICES-1).
 10063                                  disk_select_device:
 10064 00008A54 50                          push rax
 10065 00008A55 3C04                        cmp al, 4
 10066 00008A57 7213                        jb .use_ata
 10067 00008A59 C60425[38CA0800]01          mov byte [disk_use_ahci], 1
 10068 00008A61 2C04                        sub al, 4
 10069 00008A63 880425[39CA0800]            mov byte [ahci_cur_slot], al
 10070 00008A6A EB0D                        jmp .done
 10071                                  .use_ata:
 10072 00008A6C C60425[38CA0800]00          mov byte [disk_use_ahci], 0
 10073 00008A74 E81DFEFFFF                  call ata_select_device
 10074                                  .done:
 10075 00008A79 58                          pop rax
 10076 00008A7A C3                          ret
 10077                                  
 10078                                  ; disk_read_sector: rax=LBA, rdi=dest buffer. Same in/out contract as
 10079                                  ; ata_read_sector - tail-jumps into whichever driver disk_select_device
 10080                                  ; picked, so its own CF/register contract passes straight through.
 10081                                  disk_read_sector:
 10082 00008A7B 803C25[38CA0800]00          cmp byte [disk_use_ahci], 0
 10083 00008A83 0F8444FEFFFF                je ata_read_sector
 10084 00008A89 E957030000                  jmp ahci_read_sector
 10085                                  
 10086                                  ; disk_write_sector: rax=LBA, rsi=source buffer. Same contract as above.
 10087                                  disk_write_sector:
 10088 00008A8E 803C25[38CA0800]00          cmp byte [disk_use_ahci], 0
 10089 00008A96 0F84E6FEFFFF                je ata_write_sector
 10090 00008A9C E956030000                  jmp ahci_write_sector
 10091                                  
 10092                                  ; ------------------------------------------------------------------
 10093                                  ;  PCI configuration space access (legacy 0xCF8/0xCFC I/O ports). Used
 10094                                  ;  only to find and configure the AHCI controller below.
 10095                                  ; ------------------------------------------------------------------
 10096                                  PCI_CFG_ADDR equ 0x0CF8
 10097                                  PCI_CFG_DATA equ 0x0CFC
 10098                                  
 10099                                  ; pci_read32: ebx=bus, ecx=device(0-31), edx=function(0-7), r8b=offset
 10100                                  ; (byte, dword-aligned - low 2 bits ignored). Returns eax = the 32-bit
 10101                                  ; config space value at that offset. Preserves ebx/ecx/edx; clobbers r9.
 10102                                  pci_read32:
 10103 00008AA1 53                          push rbx
 10104 00008AA2 51                          push rcx
 10105 00008AA3 52                          push rdx
 10106 00008AA4 4151                        push r9
 10107 00008AA6 4531C9                      xor r9d, r9d
 10108 00008AA9 4188D9                      mov r9b, bl
 10109 00008AAC 41C1E110                    shl r9d, 16                  ; bus -> bits 23:16
 10110 00008AB0 89C8                        mov eax, ecx
 10111 00008AB2 83E01F                      and eax, 0x1F
 10112 00008AB5 C1E00B                      shl eax, 11                  ; device -> bits 15:11
 10113 00008AB8 4109C1                      or r9d, eax
 10114 00008ABB 89D0                        mov eax, edx
 10115 00008ABD 83E007                      and eax, 0x07
 10116 00008AC0 C1E008                      shl eax, 8                   ; function -> bits 10:8
 10117 00008AC3 4109C1                      or r9d, eax
 10118 00008AC6 4489C0                      mov eax, r8d
 10119 00008AC9 25FC000000                  and eax, 0xFC                ; register -> bits 7:2
 10120 00008ACE 4109C1                      or r9d, eax
 10121 00008AD1 4181C900000080              or r9d, 0x80000000           ; enable bit
 10122 00008AD8 4489C8                      mov eax, r9d
 10123 00008ADB 66BAF80C                    mov dx, PCI_CFG_ADDR
 10124 00008ADF EF                          out dx, eax
 10125 00008AE0 66BAFC0C                    mov dx, PCI_CFG_DATA
 10126 00008AE4 ED                          in eax, dx
 10127 00008AE5 4159                        pop r9
 10128 00008AE7 5A                          pop rdx
 10129 00008AE8 59                          pop rcx
 10130 00008AE9 5B                          pop rbx
 10131 00008AEA C3                          ret
