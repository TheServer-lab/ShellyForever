 13079 000144AE 803C25[0B280100]00          cmp byte [mouse_ena], 0
 13080 000144B6 74EA                        je .wait                       ; mouse off: just discard
 13081 000144B8 E85CDDFFFF                  call mouse_byte
 13082 000144BD EBE3                        jmp .wait
 13083                                  .kbd_byte:
 13084 000144BF E460                        in al, 0x60
 13085 000144C1 88C3                        mov bl, al
 13086                                  
 13087 000144C3 803C25[464D0100]00          cmp byte [kbd_ext_flag], 0
 13088 000144CB 746F                        je .not_ext_cont
 13089                                      ; this byte follows an 0xE0 prefix byte
 13090 000144CD C60425[464D0100]00          mov byte [kbd_ext_flag], 0
 13091 000144D5 F6C380                      test bl, 0x80
 13092 000144D8 7511                        jnz .ext_break
 13093 000144DA 80FB48                      cmp bl, 0x48                 ; extended Up
 13094 000144DD 742A                        je .ext_up
 13095 000144DF 80FB50                      cmp bl, 0x50                 ; extended Down
 13096 000144E2 7436                        je .ext_down
 13097 000144E4 80FB1D                      cmp bl, 0x1D                 ; right Ctrl make
 13098 000144E7 740C                        je .ext_ctrl_make
 13099 000144E9 EBB7                        jmp .wait                    ; ignore any other extended key
 13100                                  .ext_break:
 13101 000144EB 80E37F                      and bl, 0x7F
 13102 000144EE 80FB1D                      cmp bl, 0x1D
 13103 000144F1 740C                        je .ext_ctrl_break
 13104 000144F3 EBAD                        jmp .wait
 13105                                  .ext_ctrl_make:
 13106 000144F5 C60425[454D0100]01          mov byte [ctrl_state], 1
 13107 000144FD EBA3                        jmp .wait
 13108                                  .ext_ctrl_break:
 13109 000144FF C60425[454D0100]00          mov byte [ctrl_state], 0
