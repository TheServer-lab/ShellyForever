 12239                                  .rtc_done:
 12240 00009737 5B                          pop rbx
 12241 00009738 58                          pop rax
 12242 00009739 C3                          ret
 12243                                  
 12244                                  ; format_num2: rax = 0..99 -> two zero-padded digits written to [rdi], rdi
 12245                                  ; advances by 2. Preserves rax/rbx/rcx/rdx.
 12246                                  format_num2:
 12247 0000973A 50                          push rax
 12248 0000973B 53                          push rbx
 12249 0000973C 51                          push rcx
 12250 0000973D 52                          push rdx
 12251 0000973E 4831D2                      xor rdx, rdx
 12252 00009741 BB0A000000                  mov rbx, 10
 12253 00009746 48F7F3                      div rbx                       ; rax = tens, rdx = ones
 12254 00009749 0430                        add al, '0'
 12255 0000974B 8807                        mov [rdi], al
 12256 0000974D 48FFC7                      inc rdi
 12257 00009750 88D0                        mov al, dl
 12258 00009752 0430                        add al, '0'
 12259 00009754 8807                        mov [rdi], al
 12260 00009756 48FFC7                      inc rdi
 12261 00009759 5A                          pop rdx
 12262 0000975A 59                          pop rcx
 12263 0000975B 5B                          pop rbx
 12264 0000975C 58                          pop rax
 12265 0000975D C3                          ret
 12266                                  
 12267                                  ; format_num4: rax = 0..9999 -> four zero-padded digits written to [rdi],
 12268                                  ; rdi advances by 4. Preserves rax/rbx/rcx/rdx.
 12269                                  format_num4:
 12270 0000975E 50                          push rax
 12271 0000975F 53                          push rbx
 12272 00009760 51                          push rcx
 12273 00009761 52                          push rdx
 12274 00009762 4831D2                      xor rdx, rdx
 12275 00009765 BBE8030000                  mov rbx, 1000
 12276 0000976A 48F7F3                      div rbx                       ; rax = thousands, rdx = remainder
 12277 0000976D 52                          push rdx
 12278 0000976E 0430                        add al, '0'
 12279 00009770 8807                        mov [rdi], al
 12280 00009772 48FFC7                      inc rdi
 12281 00009775 58                          pop rax
 12282 00009776 4831D2                      xor rdx, rdx
 12283 00009779 BB64000000                  mov rbx, 100
 12284 0000977E 48F7F3                      div rbx                       ; rax = hundreds, rdx = remainder
 12285 00009781 52                          push rdx
 12286 00009782 0430                        add al, '0'
 12287 00009784 8807                        mov [rdi], al
 12288 00009786 48FFC7                      inc rdi
 12289 00009789 58                          pop rax
 12290 0000978A 4831D2                      xor rdx, rdx
 12291 0000978D BB0A000000                  mov rbx, 10
 12292 00009792 48F7F3                      div rbx                       ; rax = tens, rdx = ones
 12293 00009795 0430                        add al, '0'
 12294 00009797 8807                        mov [rdi], al
 12295 00009799 48FFC7                      inc rdi
 12296 0000979C 88D0                        mov al, dl
 12297 0000979E 0430                        add al, '0'
 12298 000097A0 8807                        mov [rdi], al
 12299 000097A2 48FFC7                      inc rdi
 12300 000097A5 5A                          pop rdx
 12301 000097A6 59                          pop rcx
 12302 000097A7 5B                          pop rbx
 12303 000097A8 58                          pop rax
 12304 000097A9 C3                          ret
 12305                                  
 12306                                  ; format_time: writes "HH:MM:SS\0" to [rdi], rdi advances to the terminator.
 12307                                  ; Preserves everything except rdi.
 12308                                  format_time:
