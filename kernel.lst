    74 0002577D EBE8                <1>     jmp .bcsm_loop
    75                              <1> .bcsm_zero:
    76 0002577F C60700              <1>     mov byte [rdi], 0
    77 00025782 EB03                <1>     jmp .bcsm_out
    78                              <1> .bcsm_done:
    79 00025784 C60700              <1>     mov byte [rdi], 0
    80                              <1> .bcsm_out:
