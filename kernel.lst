 13817                                  ; ============================================================
 13818                                  ;  VARIABLES  (simple name -> int64 table used by assignment/show/calc)
 13819                                  ; ============================================================
 13820                                  
 13821                                  ; str_len: rsi=string -> rax=length (not including null terminator)
 13822                                  str_len:
 13823 0001AC2B 56                          push rsi
