 14863 0000BA97 EBF3                        jmp .sl_loop
 14864                                  .sl_done:
 14865 0000BA99 5E                          pop rsi
 14866 0000BA9A C3                          ret
 14867                                  
 14868                                  ; var_find: rsi=name -> rax=index or -1. Preserves rsi.
 14869                                  var_find:
 14870 0000BA9B 56                          push rsi
 14871 0000BA9C 57                          push rdi
 14872 0000BA9D 51                          push rcx
 14873 0000BA9E 4831C9                      xor rcx, rcx
 14874                                  .vf_loop:
 14875 0000BAA1 4883F910                    cmp rcx, MAX_VARS
 14876 0000BAA5 732E                        jae .vf_notfound
 14877 0000BAA7 80B9[483E0A00]00            cmp byte [var_used+rcx], 0
 14878 0000BAAE 741B                        je .vf_next
 14879 0000BAB0 4889CF                      mov rdi, rcx
 14880 0000BAB3 486BFF20                    imul rdi, VAR_NAME_LEN
 14881 0000BAB7 488DBF[C83B0A00]            lea rdi, [var_name+rdi]
 14882 0000BABE 56                          push rsi
 14883 0000BABF 51                          push rcx
 14884 0000BAC0 E8A0500600                  call str_eq
 14885 0000BAC5 59                          pop rcx
 14886 0000BAC6 5E                          pop rsi
 14887 0000BAC7 3C01                        cmp al, 1
 14888 0000BAC9 7405                        je .vf_found
 14889                                  .vf_next:
 14890 0000BACB 48FFC1                      inc rcx
 14891 0000BACE EBD1                        jmp .vf_loop
 14892                                  .vf_found:
 14893 0000BAD0 4889C8                      mov rax, rcx
 14894 0000BAD3 EB07                        jmp .vf_out
 14895                                  .vf_notfound:
 14896 0000BAD5 48C7C0FFFFFFFF              mov rax, -1
 14897                                  .vf_out:
 14898 0000BADC 59                          pop rcx
 14899 0000BADD 5F                          pop rdi
 14900 0000BADE 5E                          pop rsi
 14901 0000BADF C3                          ret
 14902                                  
 14903                                  ; var_get: rsi=name -> rax=value, cl=1 if found else cl=0 and rax=0
 14904                                  var_get:
 14905 0000BAE0 56                          push rsi
 14906 0000BAE1 E8B5FFFFFF                  call var_find
 14907 0000BAE6 5E                          pop rsi
