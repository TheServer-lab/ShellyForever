  5503                                  
  5504                                      ; recreate node 0 as an empty root folder under its old label
  5505 000150FB C60425[508A0300]01          mov byte [node_type], 1
  5506 00015103 66C70425[50900300]-         mov word [node_parent], 0xFFFF
  5506 0001510B FFFF               
  5507 0001510D 488D3425[B0870300]          lea rsi, [sys_reset_label_tmp]
  5508 00015115 488D3C25[50960300]          lea rdi, [node_name]
  5509 0001511D E8B1770100                  call str_copy
  5510                                  
  5511                                      ; back to the root of the freshly-wiped volume
  5512 00015122 48C70425[BBD70200]-         mov qword [cur_dir], 0
  5512 0001512A 00000000           
  5513                                  
  5514                                      ; this is a factory reset - drop session variables and aliases too
  5515 0001512E E859140000                  call vars_clear_all
  5516 00015133 E8C5170000                  call aliases_clear_all
  5517                                  
  5518                                      ; recreate sys/, alias.sly, sysconfig with their default content
  5519 00015138 E8261F0000                  call ensure_sys_folder
  5520                                  
  5521                                      ; persist the reset system to disk right away
  5522 0001513D E842590000                  call fs_save
  5523                                  
  5524 00015142 5F                          pop rdi
  5525 00015143 5E                          pop rsi
  5526 00015144 59                          pop rcx
  5527 00015145 58                          pop rax
  5528 00015146 C3                          ret
