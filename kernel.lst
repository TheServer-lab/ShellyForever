  1686 0002733B 4869C846A70000      <1>     imul rcx, rax, PARTY_CTX_SIZE
  1687 00027342 4801CF              <1>     add rdi, rcx
  1688 00027345 E83CFFFFFF          <1>     call party_ctx_save
  1689 0002734A 480FB60425-         <1>     movzx rax, byte [bg_cur_slot]
