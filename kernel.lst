   272                                  ; ------------------------------------------------------------
   273                                  ; process_chain_rr: same as process_chain but for rr script lines.
   274                                  ; Splits on ; (respecting quotes), copies each segment to line_buf,
   275                                  ; tokenizes, and dispatches. Between segments, checks kill_flag
   276                                  ; (set by Esc key or prs kill) and saves/restores rr_content_ptr
   277                                  ; and proc_cur_slot around each dispatch call (dispatch may call
   278                                  ; cmd_rr recursively, clobbering these).
   279                                  process_chain_rr:
   280 00000191 53                          push rbx
   281 00000192 4154                        push r12
   282 00000194 4155                        push r13
   283 00000196 4156                        push r14
   284 00000198 4157                        push r15
   285                                  
   286 0000019A C60425[F8BB0100]01          mov byte [chain_is_rr], 1
   287                                  
   288                                      ; Copy line_buf to chain_scan_buf for scanning
   289 000001A2 48BE-                       mov rsi, line_buf
   289 000001A4 [E0B8010000000000] 
   290 000001AC 48BF-                       mov rdi, chain_scan_buf
   290 000001AE [BCB9010000000000] 
   291 000001B6 E8A7610000                  call str_copy
   292                                  
   293 000001BB 49BC-                       mov r12, chain_scan_buf   ; r12 = start of current segment
   293 000001BD [BCB9010000000000] 
   294 000001C5 49BD-                       mov r13, chain_scan_buf   ; r13 = scan pointer
   294 000001C7 [BCB9010000000000] 
   295 000001CF 41B600                      mov r14b, 0               ; r14b = quote state (0=outside, 1=inside)
   296                                  
   297                                  .rr_chain_scan:
   298                                      ; Check for Esc key / kill_flag between segments
   299 000001D2 E8A6350000                  call kbd_poll
   300 000001D7 803C25[37D10100]00          cmp byte [kill_flag], 0
   301 000001DF 7574                        jne .rr_chain_killed
   302                                  
   303 000001E1 418A4500                    mov al, [r13]
   304 000001E5 84C0                        test al, al
   305 000001E7 744B                        jz .rr_chain_done         ; end of string, process last segment
   306                                  
   307 000001E9 3C22                        cmp al, '"'
   308 000001EB 7409                        je .rr_toggle_quotes
   309                                  
   310 000001ED 3C3B                        cmp al, ';'
   311 000001EF 740E                        je .rr_chain_break
   312                                  
   313 000001F1 49FFC5                      inc r13
   314 000001F4 EBDC                        jmp .rr_chain_scan
   315                                  
