 15747 0002D0B0 51                          push rcx
 15748 0002D0B1 52                          push rdx
 15749 0002D0B2 56                          push rsi
 15750 0002D0B3 57                          push rdi
 15751 0002D0B4 4150                        push r8
 15752 0002D0B6 4151                        push r9
 15753 0002D0B8 4152                        push r10
