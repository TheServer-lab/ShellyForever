 16188                                  ; cursor_step_left / cursor_step_right: move the hardware cursor one cell
 16189                                  ; back/forward across cursor_row/cursor_col (wrapping at row edges), without
 16190                                  ; touching VGA content. Used by read_line for Left/Right/Home/End so moving
 16191                                  ; the cursor over already-echoed text doesn't erase or retype anything.
 16192                                  ; cursor_step_left is a no-op at row 0, col 0 (nothing further left to go).
 16193                                  ; cursor_step_right does not scroll - callers only step it across text that
 16194                                  ; has already been drawn (and therefore already fits on screen).
 16195                                  cursor_step_left:
 16196 00070C03 50                          push rax
 16197 00070C04 803C25[191A0700]00          cmp byte [cursor_col], 0
 16198 00070C0C 751B                        jne .left_dec
 16199 00070C0E 803C25[181A0700]00          cmp byte [cursor_row], 0
