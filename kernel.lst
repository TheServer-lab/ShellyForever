  6256                                  ; ============================================================
  6257                                  ;  BACKGROUND PARTY SCHEDULER
  6258                                  ;  A background .run is a Party program stepped cooperatively: it
  6259                                  ;  executes on its OWN private stack (proc_bg_stack) with its OWN
  6260                                  ;  parked interpreter state (proc_bg_ctx), so a background script
  6261                                  ;  nested in while loops / function calls can be paused at any
  6262                                  ;  statement boundary and resumed later without losing its call
  6263                                  ;  stack. The shared interpreter globals are parked into/restored
  6264                                  ;  from the process's ctx area around every step, which is what lets
  6265                                  ;  a foreground 'party'/'run' (or another background process) safely
  6266                                  ;  reuse them in between.
  6267                                  ; ============================================================
  6268                                  
  6269                                  ; bg_step_proc: rax = slot. Restores the process's interpreter state,
  6270                                  ; redirects putchar at its output ring, then switches to its private
  6271                                  ; stack and resumes it (the first step lands in party_bg_bootstrap,
  6272                                  ; later steps in the interpreter's own yield-resume point). Control
  6273                                  ; returns to the scheduler - as if this call simply returned - either
  6274                                  ; when the process yields after BG_QUANTUM statements or when it ends.
  6275                                  ; Note this never returns via a normal `ret` (the process stack's saved
  6276                                  ; top word is the resume IP), so it must NOT push anything after saving
  6277                                  ; bg_shell_rsp. Clobbers rax, rbx, rcx, rdx, rsi, rdi, r8-r15.
  6278                                  bg_step_proc:
  6279 000159C2 480FB6D8                    movzx rbx, al
  6280 000159C6 48891C25[60870800]          mov [bg_cur_slot], rbx
  6281 000159CE 48892425[58870800]          mov [bg_shell_rsp], rsp          ; scheduler's return address is on top
  6282                                  
  6283                                      ; restore the process's parked interpreter state
  6284 000159D6 488D3425[54E90700]          lea rsi, [proc_bg_ctx]
  6285 000159DE 4869C3024F0000              imul rax, rbx, PARTY_CTX_SIZE
