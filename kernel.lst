   269 0003F7DF 4989F5              <1>     mov r13, rsi              ; iv
   270 0003F7E2 4989CE              <1>     mov r14, rcx              ; payload ptr
   271 0003F7E5 4D89CF              <1>     mov r15, r9               ; out
   272 0003F7E8 4C89C3              <1>     mov rbx, r8               ; stash ct_len(incl tag) -- r8 gets
   273                              <1>                                ; reused as the AEAD call's aad_len arg
   274                              <1>                                ; below, so it can't be read back after
   275                              <1>     ; rdx = seq
   276                              <1> 
   277                              <1>     ; ---- reject a record shorter than the AEAD tag ----
   278                              <1>     ; A peer (malicious, or just buggy/lossy) can send an application_data
   279                              <1>     ; or handshake-phase record whose declared length is < AEAD_TAG_LEN
   280                              <1>     ; (even 0 -- tls_poll_single_frame only requires the 5-byte header
   281                              <1>     ; plus that many payload bytes, it never enforces a minimum). Without
   282                              <1>     ; this check, "lea rdx, [r8 - AEAD_TAG_LEN]" below wraps r8=0..15
   283                              <1>     ; around to a huge 64-bit value (e.g. r8=0 -> rdx=0xFFFFFFFFFFFFFFF0),
   284                              <1>     ; which is then handed to chacha20_poly1305_decrypt as ct_len -- an
   285                              <1>     ; effectively unbounded read past tls_frame_buf/tls_plain that
   286                              <1>     ; corrupts memory well beyond this module. That's consistent with
   287                              <1>     ; the illegal-instruction/triple-fault crash seen in practice: this
   288                              <1>     ; kernel installs no IDT (see kernel.asm header), so any resulting
   289                              <1>     ; fault is unrecoverable.
