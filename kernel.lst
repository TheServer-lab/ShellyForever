  7248 00005E21 040C                        add al, 12
  7249 00005E23 EB06                        jmp .rtc_h12
  7250                                  .rtc_am:
  7251 00005E25 3C0C                        cmp al, 12
  7252 00005E27 7502                        jne .rtc_h12
  7253 00005E29 30C0                        xor al, al                    ; 12 AM = 00
  7254                                  .rtc_h12:
