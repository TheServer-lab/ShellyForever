 15912 0002D233 49FFC3                      inc r11
 15913 0002D236 E89AF7FFFF                  call cursor_step_right
 15914                                  .ic_full:
 15915 0002D23B C3                          ret
 15916                                  
 15917                                  ; .redraw_tail (in: rcx = extra blank cells to print after the tail, 0 or
 15918                                  ; 1). Redraws buf[r11..r8-1] then rcx blanks via putchar, then walks the
 15919                                  ; hardware cursor back left until it's on r11's screen cell again. Every
 15920                                  ; caller above has the hardware cursor sitting exactly on r11's screen
 15921                                  ; cell when it calls this. Preserves r8/r9/r10/r11; clobbers
 15922                                  ; rax/rbx/rcx/rdx/rsi/rdi.
 15923                                  .redraw_tail:
 15924 0002D23C 50                          push rax
 15925 0002D23D 53                          push rbx
 15926 0002D23E 52                          push rdx
 15927 0002D23F 56                          push rsi
