  1036                              <1> 
  1037                              <1> ; ---- fe_cswap: rdi=a(4 limbs), rsi=b(4 limbs), rdx=swap flag (0 or 1) ----
  1038                              <1> ; Conditionally swaps a and b in place via mask+xor (no data-dependent
  1039                              <1> ; branch on the swap bit itself). The surrounding ladder driver still
  1040                              <1> ; branches on the scalar's bits when extracting them, so this is not a
  1041                              <1> ; fully constant-time implementation end to end -- acceptable per this
  1042                              <1> ; project's stated threat model (no cert/signature verification, no
  1043                              <1> ; secret-timing requirement in phases.txt).
  1044                              <1> fe_cswap:
  1045 00038FF2 50                  <1>     push rax
  1046 00038FF3 53                  <1>     push rbx
  1047 00038FF4 51                  <1>     push rcx
  1048 00038FF5 52                  <1>     push rdx
  1049 00038FF6 4150                <1>     push r8
  1050 00038FF8 4889D1              <1>     mov rcx, rdx
  1051 00038FFB 48F7D9              <1>     neg rcx                    ; rcx = 0 if swap=0, 0xFFFF...FFFF if swap=1
  1052 00038FFE BA04000000          <1>     mov rdx, 4
  1053                              <1> .loop:
  1054 00039003 48FFCA              <1>     dec rdx
  1055 00039006 488B04D7            <1>     mov rax, [rdi+rdx*8]        ; a[i]
  1056 0003900A 488B1CD6            <1>     mov rbx, [rsi+rdx*8]        ; b[i]
  1057 0003900E 4989C0              <1>     mov r8, rax
