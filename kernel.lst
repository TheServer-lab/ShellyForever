  8920 00017A38 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8921 00017A40 6683C206                    add dx, 6
  8922 00017A44 4889D8                      mov rax, rbx
  8923 00017A47 48C1E818                    shr rax, 24
