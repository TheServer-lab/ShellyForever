     1                                  ; ============================================================
     2                                  ;  ShellyForever  --  kernel.asm
     3                                  ;  Loaded flat at physical address 0x8000 by boot.asm, already
     4                                  ;  running in 64-bit long mode with the first 2MB identity
     5                                  ;  mapped. No IDT/interrupts are set up - keyboard is polled.
     6                                  ; ============================================================
     7                                  
     8                                  BITS 64
     9                                  ORG 0x8000
    10                                  
    11                                  ; ---------------- constants ----------------
    12                                  VGA_BASE        equ 0xB8000
    13                                  VGA_COLS        equ 80
    14                                  VGA_ROWS        equ 25
    15                                  ATTR_NORMAL     equ 0x0A          ; bright green on black
    16                                  ATTR_PROMPT     equ 0x0E          ; yellow
    17                                  ATTR_ERROR      equ 0x0C          ; red
    18                                  ATTR_WIG        equ 0x0B          ; light cyan - used by the wig clock widget
    19                                  
    20                                  OS_NODES        equ 64              ; nodes per volume (each drive holds its own 64-node table)
    21                                  MAX_MOUNTS      equ 2               ; how many extra drives can be mounted at once
    22                                  
    23                                  ; AHCI (SATA) support: device ids 0-3 are still the legacy ATA PIO slots
    24                                  ; (primary/secondary x master/slave); ids 4..4+AHCI_MAX_PORTS-1 are AHCI
    25                                  ; ports discovered at boot (see ahci_init). dscan/fmt/mount all iterate
    26                                  ; 0..TOTAL_DEVICES-1 and go through disk_select_device, which routes each
    27                                  ; id to the right driver - see that routine for the full explanation.
    28                                  AHCI_MAX_PORTS  equ 4
    29                                  TOTAL_DEVICES   equ 4 + AHCI_MAX_PORTS
    30                                  VOL_NODES       equ OS_NODES        ; every volume, OS or mounted, is the same size
    31                                  MAX_NODES       equ OS_NODES * (1 + MAX_MOUNTS)   ; 192 = OS volume + 2 mounts
    32                                  NAME_LEN        equ 32
    33                                  CONTENT_LEN     equ 160
    34                                  LINE_MAX        equ 220
    35                                  
    36                                  SCROLLBACK_LINES equ 100         ; extra off-screen rows kept for Ctrl+Up/Down
    37                                  HISTORY_MAX      equ 20          ; command history entries kept for Up/Down
    38                                  KEY_UP           equ 0x11        ; sentinel byte get_char returns for the Up arrow
    39                                  KEY_DOWN         equ 0x12        ; sentinel byte get_char returns for the Down arrow
    40                                  
    41                                  MAX_VARS        equ 16
    42                                  VAR_NAME_LEN    equ 32
    43                                  MAX_CALC_TOKENS equ 32
    44                                  
    45                                  MAX_ALIASES     equ 12         ; how many "ali <name> <commands>" aliases can exist at once
    46                                  ALIAS_NAME_LEN  equ 32
    47                                  ALIAS_BODY_LEN  equ LINE_MAX   ; an alias body is at most one full input line
    48                                  ALIAS_MAX_DEPTH equ 8          ; guards against an alias (in)directly invoking itself
    49                                  
    50                                  PIPE_CAP_MAX    equ 192       ; max bytes captured from a "~" pipe's left side
    51                                  
    52                                  ; ------------------------------------------------------------------
    53                                  ;  SFFS v3 -- ShellyForever File Storage format (on-disk layout).
    54                                  ;  Every drive (OS boot drive and any data drives) uses the same
    55                                  ;  fixed layout so any drive can be scanned, formatted, and mounted:
    56                                  ;
    57                                  ;    LBA  FS_LBA_START     : superblock (512B) - magic 'SFFS', version
    58                                  ;                             byte, reserved, 32-byte disk label
    59                                  ;    LBA  FS_LBA_START+1   : node_type[VOL_NODES]  (1 sector, padded)
    60                                  ;    LBA  FS_LBA_START+2   : node_parent[VOL_NODES] (1 sector, padded)
    61                                  ;    LBA  FS_LBA_START+3   : node_next[VOL_NODES]  (1 sector; 0xFFFF = no
    62                                  ;                             continuation). v3 only - v2 has no next sector.
    63                                  ;    LBA  FS_LBA_START+4.. : node_name[VOL_NODES*NAME_LEN] (4 sectors)
    64                                  ;    LBA  FS_LBA_START+8.. : node_content[VOL_NODES*CONTENT_LEN] (20)
    65                                  ;
    66                                  ;  A file whose content exceeds one 159-byte slot is stored as a chain:
    67                                  ;  the file's own node holds the first chunk, and its node_next points at
    68                                  ;  NODE_TYPE_CHAIN (type-3) continuation nodes, each holding the next 159
    69                                  ;  bytes and linked through their own node_next (0xFFFF terminates). Chain
    70                                  ;  nodes are invisible to path lookup, listing, and the allocator, and are
    71                                  ;  freed along with the file. v2 volumes (no node_next sector, name LBA at
    72                                  ;  +3 / content at +7) still load and read fine; a sync upgrades them to v3.
    73                                  ;
    74                                  ;  dscan probes all four ATA device slots for the magic, format writes
    75                                  ;  a fresh empty volume + label, and mount loads a volume's node table
    76                                  ;  into memory (remapping its parent indices) rooted at /<label>/.
    77                                  ;  The kernel occupies LBA 1..260 (KERNEL_SECTORS in boot.asm), so the
    78                                  ;  filesystem region at LBA 300 is well clear of it.
    79                                  ; ------------------------------------------------------------------
    80                                  FS_LBA_START    equ 300
    81                                  SFFS_VERSION    equ 3
    82                                  SFFS_VERSION_V2 equ 2               ; old format, still readable
    83                                  SUPER_LABEL_OFF equ 8               ; label lives at superblock offset 8..39
    84                                  SUPER_LBA       equ FS_LBA_START
    85                                  TYPE_LBA        equ SUPER_LBA + 1
    86                                  PARENT_LBA      equ SUPER_LBA + 2
    87                                  NEXT_LBA        equ SUPER_LBA + 3
    88                                  NAME_LBA        equ SUPER_LBA + 4
    89                                  CONTENT_LBA     equ SUPER_LBA + 8
    90                                  NAME_SECTORS    equ (VOL_NODES * NAME_LEN) / 512          ; 4
    91                                  CONTENT_SECTORS equ (VOL_NODES * CONTENT_LEN) / 512       ; 20
    92                                  NODE_TYPE_CHAIN equ 3               ; continuation node in a file's content chain
    93                                  EDIT_MAX        equ VOL_NODES * CONTENT_LEN   ; max bytes one file can hold (64*160)
    94                                  
    95                                  ; ============================================================
    96                                  kernel_entry:
    97 00000000 FA                          cli
    98 00000001 BC00F00900                  mov rsp, 0x9F000
    99                                  
   100                                      ; --- TEMPORARY diagnostic checkpoint A: proves boot.asm's real-mode ->
   101                                      ; protected-mode -> long-mode transition landed here at all, before
   102                                      ; expand_identity_map or ahci_init get a chance to run/crash. If you
   103                                      ; only ever see "12" and never "A", the failure is inside boot.asm's
   104                                      ; mode-switch code (A20/GDT/paging/long-mode jump), not in the kernel.
   105 00000006 BF0C8F0B00                  mov rdi, 0xB8000 + (24*80 + 6) * 2
   106 0000000B C60741                      mov byte [rdi], 'A'
   107 0000000E C647011F                    mov byte [rdi+1], 0x1F
   108                                  
   109                                      ; boot.asm only had room (512-byte sector) to identity-map the first
   110                                      ; 64MB. That's not enough for acpi_shutdown's ACPI table walk later -
   111                                      ; firmware can put the FADT/DSDT well above 64MB (e.g. ~127MB on a
   112                                      ; 128MB guest) - so extend the map to 4GB right away, before anything
   113                                      ; else runs. See expand_identity_map below for details.
   114 00000012 E882050000                  call expand_identity_map
   115                                  
   116                                      ; --- TEMPORARY diagnostic checkpoint X: expand_identity_map returned
   117                                      ; without crashing/hanging. If "A" shows but "X" doesn't, the 4GB
   118                                      ; identity-map rebuild is where things go wrong on this hardware.
   119 00000017 BF0E8F0B00                  mov rdi, 0xB8000 + (24*80 + 7) * 2
   120 0000001C C60758                      mov byte [rdi], 'X'
   121 0000001F C647011F                    mov byte [rdi+1], 0x1F
   122                                  
   123                                      ; probe for a PCI AHCI (SATA) controller and bring up its ports, if any,
   124                                      ; as extra disk device slots (4..4+AHCI_MAX_PORTS-1) alongside the four
   125                                      ; legacy ATA slots. Inert/no-op if there isn't one (ahci_port_count stays
   126                                      ; 0) - the OS behaves exactly as it always did in that case.
   127 00000023 E8CF500000                  call ahci_init
   128                                  
   129                                      ; checkpoint 9: kernel code is executing (proves boot.asm's jump into
   130                                      ; 0x8000 landed correctly). Matches the DBG16/32/64 checkpoints in
   131                                      ; boot.asm - if you see 1..8 but not this, the kernel wasn't loaded/
   132                                      ; jumped to correctly; if the OS otherwise looks fine you can ignore it.
   133 00000028 BF108F0B00                  mov rdi, 0xB8000 + (24*80 + 8) * 2
   134 0000002D C6074B                      mov byte [rdi], 'K'
   135 00000030 C647010F                    mov byte [rdi+1], 0x0F
   136                                  
   137 00000034 E879630000                  call clear_screen
   138 00000039 E81B580000                  call fs_load                ; loads persisted fs from disk, or fs_init's a fresh one
   139                                  
