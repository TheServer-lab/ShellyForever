 15076 0002CA25 58                          pop rax
 15077 0002CA26 C3                          ret
 15078                                  
 15079                                  ; putchar: al = char to print, uses attribute in bl if caller set it via
 15080                                  ; print_string_attr; falls back to ATTR_NORMAL when called directly.
 15081                                  ; When pipe_capture_on is set (a "~" pipe is capturing a command's
 15082                                  ; output - see process_segment), characters are appended to
 15083                                  ; pipe_capture_buf instead of touching the screen/cursor at all.
 15084                                  serial_init:
 15085 0002CA27 50                          push rax
 15086 0002CA28 52                          push rdx
 15087 0002CA29 66BAFB03                    mov dx, 0x3FB
 15088 0002CA2D B080                        mov al, 0x80               ; DLAB = 1
 15089 0002CA2F EE                          out dx, al
 15090 0002CA30 66BAF803                    mov dx, 0x3F8
 15091 0002CA34 B001                        mov al, 0x01               ; divisor 1 -> 115200 baud
 15092 0002CA36 EE                          out dx, al
 15093 0002CA37 66BAF903                    mov dx, 0x3F9
 15094 0002CA3B 30C0                        xor al, al
 15095 0002CA3D EE                          out dx, al
 15096 0002CA3E 66BAFB03                    mov dx, 0x3FB
 15097 0002CA42 B003                        mov al, 0x03               ; 8N1, DLAB = 0
 15098 0002CA44 EE                          out dx, al
 15099 0002CA45 66BAFA03                    mov dx, 0x3FA
 15100 0002CA49 B0C7                        mov al, 0xC7               ; FIFO on, clear, 14-byte trigger
 15101 0002CA4B EE                          out dx, al
 15102 0002CA4C 5A                          pop rdx
 15103 0002CA4D 58                          pop rax
 15104 0002CA4E C3                          ret
 15105                                  
 15106                                  ; serial_mirror: transmit the char in al on COM1 (blocks until THR empty).
 15107                                  ; The char is parked in cl because dx (used for the port address) overlaps dl.
 15108                                  serial_mirror:
 15109 0002CA4F 50                          push rax
 15110 0002CA50 51                          push rcx
 15111 0002CA51 52                          push rdx
 15112 0002CA52 88C1                        mov cl, al
 15113 0002CA54 66BAFD03                    mov dx, 0x3FD
 15114                                  .sm_wait:
 15115 0002CA58 EC                          in al, dx
 15116 0002CA59 A820                        test al, 0x20
 15117 0002CA5B 74FB                        jz .sm_wait
 15118 0002CA5D 66BAF803                    mov dx, 0x3F8
 15119 0002CA61 88C8                        mov al, cl
 15120 0002CA63 EE                          out dx, al
 15121 0002CA64 5A                          pop rdx
 15122 0002CA65 59                          pop rcx
 15123 0002CA66 58                          pop rax
 15124 0002CA67 C3                          ret
 15125                                  
 15126                                  putchar:
 15127 0002CA68 50                          push rax
 15128 0002CA69 53                          push rbx
 15129 0002CA6A 51                          push rcx
 15130 0002CA6B 52                          push rdx
 15131 0002CA6C 57                          push rdi
 15132                                  
 15133 0002CA6D 803C25[B1E90600]00          cmp byte [pipe_capture_on], 0
 15134 0002CA75 743A                        je .not_capturing
 15135 0002CA77 3C0D                        cmp al, 0x0D
 15136 0002CA79 7430                        je .cap_done              ; ignore carriage returns
 15137 0002CA7B 488B0C25[B8E90600]          mov rcx, [pipe_capture_len]
 15138 0002CA83 4881F9BF000000              cmp rcx, PIPE_CAP_MAX-1
