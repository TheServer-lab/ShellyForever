 12319 000097DD [7CAD0100]         
 12320 000097E1 E854FFFFFF                  call format_num2
 12321 000097E6 C60700                      mov byte [rdi], 0
 12322 000097E9 58                          pop rax
 12323 000097EA C3                          ret
 12324                                  
 12325                                  ; format_date: writes "YYYY-MM-DD\0" to [rdi], rdi advances to the
 12326                                  ; terminator. Preserves everything except rdi.
 12327                                  format_date:
