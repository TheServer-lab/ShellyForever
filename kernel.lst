 10201 00008B81 F60425[F3C90800]80          test byte [pci_scratch_hdrtype], 0x80
 10202 00008B89 7406                        jz .func_loop_start
 10203 00008B8B 41B908000000                mov r9d, 8                   ; multi-function device - check them all
 10204                                  .func_loop_start:
 10205 00008B91 31D2                        xor edx, edx
 10206                                  .func_loop:
 10207 00008B93 4439CA                      cmp edx, r9d
 10208 00008B96 7351                        jae .next_dev
 10209 00008B98 4D31C0                      xor r8, r8
