  9696 0001824F 51                          push rcx
  9697 00018250 57                          push rdi
  9698 00018251 E8C8F8FFFF                  call disk_read_sector
  9699 00018256 5F                          pop rdi
  9700 00018257 59                          pop rcx
  9701 00018258 58                          pop rax
  9702 00018259 0F82EF000000                jc .fail
  9703 0001825F 4881C700020000              add rdi, 512
  9704 00018266 48FFC0                      inc rax
  9705 00018269 E2E3                        loop .content_loop
  9706                                      ; node_bin_len: only the v4 layout carries it; v2/v3 volumes predate
  9707                                      ; binary files, so zero the whole table - stale memory must never
  9708                                      ; look like a valid length for a binary file read.
  9709 0001826B 803C25[54E80500]02          cmp byte [fs_layout_ver], 2
  9710 00018273 753B                        jne .binlen_zero
  9711 00018275 B87C060000                  mov rax, BINLEN_LBA
  9712 0001827A B902000000                  mov rcx, BINLEN_SECTORS
  9713 0001827F 488D3C25[50DC0500]          lea rdi, [node_bin_len]
  9714 00018287 4D89C1                      mov r9, r8
  9715 0001828A 4D6BC904                    imul r9, 4
  9716 0001828E 4C01CF                      add rdi, r9
  9717                                  .binlen_read_loop:
  9718 00018291 50                          push rax
  9719 00018292 51                          push rcx
  9720 00018293 57                          push rdi
