     1                                  ; ============================================================
     2                                  ;  ShellyForever  --  kernel.asm
     3                                  ;  Loaded flat at physical address 0x8000 by boot.asm. boot.asm hands off
     4                                  ;  here WHILE STILL IN REAL MODE (see splash_stub right below) so BIOS
     5                                  ;  video/keyboard calls are still available for a boot splash; splash_stub
     6                                  ;  then does the A20/GDT/protected-mode/long-mode transition itself (moved
     7                                  ;  here from boot.asm - see boot.asm's read_done for why) and falls into
     8                                  ;  kernel_entry, which is where actual 64-bit long-mode execution used to
     9                                  ;  begin directly. No IDT/interrupts are set up - keyboard is polled.
    10                                  ; ============================================================
    11                                  
    12                                  BITS 64
    13                                  ORG 0x8000
    14                                  
    15                                  %include "splash.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  ShellyForever  --  splash.asm
     3                              <1> ;  %include'd by kernel.asm immediately after "BITS 64 / ORG 0x8000", as
     4                              <1> ;  the very first code in the kernel image (nothing but EQU constants,
     5                              <1> ;  which emit no bytes, may precede it - boot.asm far-jumps straight to
     6                              <1> ;  0x8000). Kept as its own file, like party.asm/tcp.asm/http.asm/
     7                              <1> ;  browse.asm/mouse.asm, because this block is unusually order- and
     8                              <1> ;  mode-sensitive (mixes 16/32/64-bit code, must be first, has real-mode
     9                              <1> ;  segment math) and is easiest to review/test/revert in isolation. nasm
    10                              <1> ;  inlines %include before assembling, so splitting it out here changes
    11                              <1> ;  nothing about the resulting kernel.bin.
    12                              <1> ;
    13                              <1> ;  boot.asm hands off here WHILE STILL IN REAL MODE (see boot.asm's
    14                              <1> ;  read_done) so BIOS video/keyboard calls are still available for a boot
    15                              <1> ;  splash. This code then does the A20/GDT/protected-mode/long-mode
    16                              <1> ;  transition itself (moved here from boot.asm - see boot.asm's
    17                              <1> ;  read_done for why) and falls into kernel_entry, which is where actual
    18                              <1> ;  64-bit long-mode execution used to begin directly.
    19                              <1> ; ============================================================
    20                              <1> BITS 16
    21                              <1> SPLASH_TICKS equ 55          ; ~3 seconds at the BIOS timer's ~18.2 ticks/sec
    22                              <1> splash_stub:
    23 00000000 31C0                <1>     xor ax, ax
    24 00000002 8ED8                <1>     mov ds, ax
    25 00000004 8EC0                <1>     mov es, ax
    26                              <1> 
    27                              <1>     ; ---- VGA mode 13h: 320x200, 256 colors ----
    28 00000006 B81300              <1>     mov ax, 0x0013
    29 00000009 CD10                <1>     int 0x10
    30                              <1> 
    31                              <1>     ; ---- load the splash's 256-color palette (6-bit-per-channel VGA DAC
    32                              <1>     ; values) via BIOS "set block of DAC registers" (AH=10h AL=12h;
    33                              <1>     ; BX=start index, CX=count, ES:DX -> table of CX*3 bytes) ----
    34 0000000B B81308              <1>     mov ax, PALETTE_SEG
    35 0000000E 8EC0                <1>     mov es, ax
    36 00000010 BA0000              <1>     mov dx, PALETTE_OFF
    37 00000013 31DB                <1>     xor bx, bx
    38 00000015 B90001              <1>     mov cx, 256
    39 00000018 B81210              <1>     mov ax, 0x1012
    40 0000001B CD10                <1>     int 0x10
    41                              <1> 
    42                              <1>     ; ---- blit the 320x200 indexed image straight into the mode-13h
    43                              <1>     ; linear framebuffer at 0xA000:0000 ----
    44 0000001D B84308              <1>     mov ax, PIXELS_SEG
    45 00000020 8ED8                <1>     mov ds, ax
    46 00000022 BE0000              <1>     mov si, PIXELS_OFF
    47 00000025 B800A0              <1>     mov ax, 0xA000
    48 00000028 8EC0                <1>     mov es, ax
    49 0000002A 31FF                <1>     xor di, di
    50 0000002C B900FA              <1>     mov cx, 320*200
    51 0000002F FC                  <1>     cld
    52 00000030 F3A4                <1>     rep movsb
    53                              <1> 
    54                              <1>     ; ---- hold the splash for ~SPLASH_TICKS ticks, then continue on its
    55                              <1>     ; own - no keypress needed. Uses the BIOS timer tick counter (INT 1Ah
    56                              <1>     ; AH=00h returns ticks-since-midnight in CX:DX, incrementing at
    57                              <1>     ; ~18.2Hz) rather than INT 15h AH=86h's microsecond wait, which is a
    58                              <1>     ; single blocking call but is known to be unreliable on some real
    59                              <1>     ; BIOSes; polling the tick counter is about as universally supported
    60                              <1>     ; as real-mode BIOS gets. Only DX (the low word) is used - at ~18.2
    61                              <1>     ; ticks/sec that's good for waits well over an hour before DX itself
    62                              <1>     ; wraps, far more than any splash needs. The one edge case is the
    63                              <1>     ; midnight rollover, where the BIOS resets the counter to 0 instead of
    64                              <1>     ; continuing to increment: the unsigned subtraction below can then
    65                              <1>     ; read as a huge elapsed value and exit the wait immediately - i.e.
    66                              <1>     ; the splash is cut short, never stuck, so it fails safe.
    67 00000032 B400                <1>     mov ah, 0x00
    68 00000034 CD1A                <1>     int 0x1A                     ; dx = current tick count (low word)
    69 00000036 89D6                <1>     mov si, dx                   ; si = start tick
    70                              <1> .splash_wait:
    71 00000038 B400                <1>     mov ah, 0x00
    72 0000003A CD1A                <1>     int 0x1A
    73 0000003C 29F2                <1>     sub dx, si                   ; dx = elapsed ticks since start
    74 0000003E 83FA37              <1>     cmp dx, SPLASH_TICKS
    75 00000041 72F5                <1>     jb .splash_wait
    76                              <1> 
    77                              <1>     ; ---- back to 80x25 text mode ----
    78 00000043 B80300              <1>     mov ax, 0x0003
    79 00000046 CD10                <1>     int 0x10
    80                              <1> 
    81 00000048 31C0                <1>     xor ax, ax                  ; restore ds (clobbered above for the blit)
    82 0000004A 8ED8                <1>     mov ds, ax
    83                              <1> 
    84                              <1>     ; ---- same A20/GDT/protected-mode transition boot.asm's read_done used
    85                              <1>     ; to do right after loading the kernel ----
    86 0000004C FA                  <1>     cli
    87 0000004D B002                <1>     mov al, 0x02
    88 0000004F E692                <1>     out 0x92, al                 ; fast-A20 gate (port 0x92)
    89                              <1> 
    90 00000051 0F0116[2001]        <1>     lgdt [gdt32_descriptor]
    91                              <1> 
    92 00000056 0F20C0              <1>     mov eax, cr0
    93 00000059 6683C801            <1>     or eax, 1
    94 0000005D 0F22C0              <1>     mov cr0, eax
    95                              <1> 
    96 00000060 EA[6500]0800        <1>     jmp CODE32_SEL:splash_pm32   ; far jump flushes prefetch, loads CS
    97                              <1> 
    98                              <1> BITS 32
    99                              <1> splash_pm32:
   100 00000065 66B81000            <1>     mov ax, DATA32_SEL
   101 00000069 8ED8                <1>     mov ds, ax
   102 0000006B 8EC0                <1>     mov es, ax
   103 0000006D 8EE0                <1>     mov fs, ax
   104 0000006F 8EE8                <1>     mov gs, ax
   105 00000071 8ED0                <1>     mov ss, ax
   106 00000073 BC00F00900          <1>     mov esp, 0x9F000
   107                              <1> 
   108                              <1>     ; ---- build minimal 4-level page tables for long mode (identical to
   109                              <1>     ; boot.asm's old pm_entry - PML4 @0x1000, PDPT @0x2000, PD @0x3000,
   110                              <1>     ; identity-mapping the first 64MB with 2MB pages). kernel_entry's
   111                              <1>     ; expand_identity_map extends this to 4GB before anything that needs
   112                              <1>     ; it (e.g. acpi_shutdown's ACPI table walk) runs. ----
   113 00000078 BF00100000          <1>     mov edi, 0x1000
   114 0000007D B9000C0000          <1>     mov ecx, 0x3000 / 4
   115 00000082 31C0                <1>     xor eax, eax
   116 00000084 F3AB                <1>     rep stosd
   117                              <1> 
   118 00000086 C70500100000032000- <1>     mov dword [0x1000], 0x2000 | 0x3   ; PML4[0] -> PDPT
   118 0000008F 00                  <1>
   119 00000090 C70500200000033000- <1>     mov dword [0x2000], 0x3000 | 0x3   ; PDPT[0] -> PD
   119 00000099 00                  <1>
   120                              <1> 
   121 0000009A BF00300000          <1>     mov edi, 0x3000
   122 0000009F B883000000          <1>     mov eax, 0x83                ; present+rw+PS(2MB), base 0
   123 000000A4 B120                <1>     mov cl, 32                   ; 32 * 2MB = 64MB
   124                              <1> .fill_pd:
   125 000000A6 8907                <1>     mov [edi], eax
   126 000000A8 0500002000          <1>     add eax, 0x200000
   127 000000AD 83C708              <1>     add edi, 8
   128 000000B0 E2F4                <1>     loop .fill_pd
   129                              <1> 
   130 000000B2 B800100000          <1>     mov eax, 0x1000
   131 000000B7 0F22D8              <1>     mov cr3, eax
   132                              <1> 
   133 000000BA 0F20E0              <1>     mov eax, cr4
   134 000000BD 83C820              <1>     or eax, 1 << 5                ; PAE
   135 000000C0 0F22E0              <1>     mov cr4, eax
   136                              <1> 
   137 000000C3 B9800000C0          <1>     mov ecx, 0xC0000080            ; EFER
   138 000000C8 0F32                <1>     rdmsr
   139 000000CA 0D00010000          <1>     or eax, 1 << 8                ; LME
   140 000000CF 0F30                <1>     wrmsr
   141                              <1> 
   142 000000D1 0F20C0              <1>     mov eax, cr0
   143 000000D4 0D00000080          <1>     or eax, 1 << 31                ; PG - activates long mode
   144 000000D9 0F22C0              <1>     mov cr0, eax
   145                              <1> 
   146 000000DC EA[E3000000]1800    <1>     jmp CODE64_SEL:splash_lm64
   147                              <1> 
   148                              <1> BITS 64
   149                              <1> splash_lm64:
   150 000000E3 66B81000            <1>     mov ax, DATA32_SEL
   151 000000E7 8ED8                <1>     mov ds, ax
   152 000000E9 8EC0                <1>     mov es, ax
   153 000000EB 8EE0                <1>     mov fs, ax
   154 000000ED 8EE8                <1>     mov gs, ax
   155 000000EF 8ED0                <1>     mov ss, ax
   156 000000F1 BC00F00900          <1>     mov rsp, 0x9F000
   157 000000F6 E935FD0000          <1>     jmp kernel_entry
   158                              <1> 
   159                              <1> ; ---- GDT (moved here from boot.asm - see boot.asm's read_done) ----
   160 000000FB 90<rep 5h>          <1> ALIGN 8
   161                              <1> gdt32_start:
   162 00000100 0000000000000000    <1>     dq 0x0000000000000000                     ; null descriptor
   163                              <1> CODE32_DESC:
   164 00000108 FFFF0000            <1>     dw 0xFFFF, 0x0000
   165 0000010C 009ACF00            <1>     db 0x00, 10011010b, 11001111b, 0x00        ; 32-bit code, base0 limit4G
   166                              <1> DATA32_DESC:
   167 00000110 FFFF0000            <1>     dw 0xFFFF, 0x0000
   168 00000114 0092CF00            <1>     db 0x00, 10010010b, 11001111b, 0x00        ; 32-bit data
   169                              <1> CODE64_DESC:
   170 00000118 00000000            <1>     dw 0x0000, 0x0000
   171 0000011C 009A2000            <1>     db 0x00, 10011010b, 00100000b, 0x00        ; 64-bit code (L bit set)
   172                              <1> gdt32_end:
   173                              <1> 
   174                              <1> gdt32_descriptor:
   175 00000120 1F00                <1>     dw gdt32_end - gdt32_start - 1
   176 00000122 [00010000]          <1>     dd gdt32_start
   177                              <1> 
   178                              <1> CODE32_SEL equ CODE32_DESC - gdt32_start
   179                              <1> DATA32_SEL equ DATA32_DESC - gdt32_start
   180                              <1> CODE64_SEL equ CODE64_DESC - gdt32_start
   181                              <1> 
   182                              <1> ; ---- splash image data: 320x200 8bpp indexed image + its 256-color
   183                              <1> ; palette (6-bit-per-channel VGA DAC values), generated from the logo
   184                              <1> ; artwork. Regenerate both with the conversion script if the logo changes.
   185                              <1> ; incbin paths are resolved relative to the top-level file nasm was
   186                              <1> ; invoked on (kernel.asm), not this file - keep both .bin files alongside
   187                              <1> ; kernel.asm, same as today. ----
   188 00000126 90<rep Ah>          <1> ALIGN 16
   189 00000130 <bin 300h>          <1> splash_palette_data: incbin "splash_palette.bin"   ; 256*3 bytes
   190 00000430 <bin FA00h>         <1> splash_pixel_data:   incbin "splash_pixels.bin"    ; 320*200 bytes
   191                              <1> 
   192                              <1> ; nasm's -f bin output won't apply >>/& directly to a label (non-scalar),
   193                              <1> ; so go through a $$-relative offset + the known ORG base to get a plain
   194                              <1> ; number first, matching boot.asm's dap_set_buf technique for the same
   195                              <1> ; real-mode seg:off problem.
   196                              <1> PALETTE_ADDR equ 0x8000 + (splash_palette_data - $$)
   197                              <1> PIXELS_ADDR  equ 0x8000 + (splash_pixel_data - $$)
   198                              <1> PALETTE_SEG equ (PALETTE_ADDR >> 4)
   199                              <1> PALETTE_OFF equ (PALETTE_ADDR & 0xF)
   200                              <1> PIXELS_SEG  equ (PIXELS_ADDR >> 4)
   201                              <1> PIXELS_OFF  equ (PIXELS_ADDR & 0xF)
    16                                  
    17                                  BITS 64
    18                                  ; ---------------- constants ----------------
    19                                  VGA_BASE        equ 0xB8000
    20                                  VGA_COLS        equ 80
    21                                  VGA_ROWS        equ 25
    22                                  ATTR_NORMAL     equ 0x0A          ; bright green on black
    23                                  ATTR_PROMPT     equ 0x0E          ; yellow
    24                                  ATTR_ERROR      equ 0x0C          ; red
    25                                  ATTR_WIG        equ 0x0B          ; light cyan - used by the wig clock widget
    26                                  
    27                                  ; cmd_edit redraws its whole viewport from scratch on every keystroke (see
    28                                  ; cmd_edit below); the first EDIT_HEADER_ROWS screen rows are always the
    29                                  ; "-- editing <name> ... --" banner and a blank line, so the scrollable
    30                                  ; body only gets VGA_ROWS-EDIT_HEADER_ROWS rows. Must match the number of
    31                                  ; newlines msg_edit_header1+msg_edit_header2 print before file content.
    32                                  EDIT_HEADER_ROWS equ 2
    33                                  
    34                                  ; SFFS v4 raises this from 64 to 256 (see the SFFS v4 block below) - the
    35                                  ; old 64-node table was shared by folders, files, AND every chain
    36                                  ; continuation node a file needed once its content passed 159 bytes, so a
    37                                  ; handful of ordinary-sized files could exhaust it well before the disk
    38                                  ; itself was anywhere near full ("error: filesystem is full" with tons of
    39                                  ; free space left). v2/v3 disks (still readable) keep working exactly as
    40                                  ; before; a sync upgrades them to v4 in place - see fs_layout_ver.
    41                                  OS_NODES        equ 256             ; nodes per volume (each drive holds its own node table)
    42                                  MAX_MOUNTS      equ 2               ; how many extra drives can be mounted at once
    43                                  
    44                                  ; AHCI (SATA) support: device ids 0-3 are still the legacy ATA PIO slots
    45                                  ; (primary/secondary x master/slave); ids 4..4+AHCI_MAX_PORTS-1 are AHCI
    46                                  ; ports discovered at boot (see ahci_init). dscan/fmt/mount all iterate
    47                                  ; 0..TOTAL_DEVICES-1 and go through disk_select_device, which routes each
    48                                  ; id to the right driver - see that routine for the full explanation.
    49                                  AHCI_MAX_PORTS  equ 4
    50                                  TOTAL_DEVICES   equ 4 + AHCI_MAX_PORTS
    51                                  VOL_NODES       equ OS_NODES        ; every volume, OS or mounted, is the same size
    52                                  MAX_NODES       equ OS_NODES * (1 + MAX_MOUNTS)   ; 768 = OS volume + 2 mounts
    53                                  NAME_LEN        equ 32
    54                                  CONTENT_LEN     equ 160
    55                                  LINE_MAX        equ 220
    56                                  
    57                                  SCROLLBACK_LINES equ 100         ; extra off-screen rows kept for Ctrl+Up/Down
    58                                  HISTORY_MAX      equ 20          ; command history entries kept for Up/Down
    59                                  KEY_UP           equ 0x11        ; sentinel byte get_char returns for the Up arrow
    60                                  KEY_DOWN         equ 0x12        ; sentinel byte get_char returns for the Down arrow
    61                                  KEY_PASTE        equ 0x13        ; sentinel byte get_char returns for Ctrl+V
    62                                  KEY_LEFT         equ 0x14        ; sentinel byte get_char returns for the Left arrow
    63                                  KEY_RIGHT        equ 0x15        ; sentinel byte get_char returns for the Right arrow
    64                                  KEY_HOME         equ 0x16        ; sentinel byte get_char returns for Home
    65                                  KEY_END          equ 0x17        ; sentinel byte get_char returns for End
    66                                  KEY_DELETE       equ 0x18        ; sentinel byte get_char returns for Delete
    67                                  
    68                                  MAX_VARS        equ 16
    69                                  VAR_NAME_LEN    equ 32
    70                                  MAX_CALC_TOKENS equ 32
    71                                  
    72                                  MAX_ALIASES     equ 12         ; how many "ali <name> <commands>" aliases can exist at once
    73                                  ALIAS_NAME_LEN  equ 32
    74                                  ALIAS_BODY_LEN  equ LINE_MAX   ; an alias body is at most one full input line
    75                                  ALIAS_MAX_DEPTH equ 8          ; guards against an alias (in)directly invoking itself
    76                                  
    77                                  PIPE_CAP_MAX    equ 192       ; max bytes captured from a "~" pipe's left side
    78                                  
    79                                  ; ------------------------------------------------------------------
    80                                  ;  SFFS v4 -- ShellyForever File Storage format (on-disk layout).
    81                                  ;  Every drive (OS boot drive and any data drives) uses the same
    82                                  ;  fixed layout so any drive can be scanned, formatted, and mounted:
    83                                  ;
    84                                  ;    LBA  FS_LBA_START     : superblock (512B) - magic 'SFFS', version
    85                                  ;                             byte, reserved, 32-byte disk label
    86                                  ;    LBA  FS_LBA_START+1   : node_type[VOL_NODES]  (1 sector, padded)
    87                                  ;    LBA  FS_LBA_START+2   : node_parent[VOL_NODES] (1 sector, padded)
    88                                  ;    LBA  FS_LBA_START+3   : node_next[VOL_NODES]  (1 sector; 0xFFFF = no
    89                                  ;                             continuation). v3+ only - v2 has no next sector.
    90                                  ;    LBA  FS_LBA_START+4.. : node_name[VOL_NODES*NAME_LEN]    (NAME_SECTORS)
    91                                  ;    LBA  ..after name..   : node_content[VOL_NODES*CONTENT_LEN] (CONTENT_SECTORS)
    92                                  ;
    93                                  ;  A file whose content exceeds one 159-byte slot is stored as a chain:
    94                                  ;  the file's own node holds the first chunk, and its node_next points at
    95                                  ;  NODE_TYPE_CHAIN (type-3) continuation nodes, each holding the next 159
    96                                  ;  bytes and linked through their own node_next (0xFFFF terminates). Chain
    97                                  ;  nodes are invisible to path lookup, listing, and the allocator, and are
    98                                  ;  freed along with the file.
    99                                  ;
   100                                  ;  *** Why v4 exists ***
   101                                  ;  v2/v3 volumes had a hard VOL_NODES=64 ceiling, and that table was
   102                                  ;  shared by folders, files, AND every chain continuation node. A single
   103                                  ;  file bigger than 159 bytes already burns 2+ node slots, so it took
   104                                  ;  surprisingly few real files (e.g. a compiler test fixture) to trip
   105                                  ;  "error: filesystem is full" while the disk itself still had plenty of
   106                                  ;  free sectors - the node *table*, not the disk, was what ran out.
   107                                  ;  v4 keeps the exact same chain-of-nodes design (so all the code above
   108                                  ;  that walks node_next doesn't change) and simply widens VOL_NODES to
   109                                  ;  256, which needs bigger NAME/CONTENT regions - CONTENT_LBA is now
   110                                  ;  computed from NAME_LBA+NAME_SECTORS instead of being hardcoded, so
   111                                  ;  the two regions can never overlap as VOL_NODES changes again later.
   112                                  ;  It also nudges EDIT_MAX (one file's max size) up from ~10KB to ~40KB
   113                                  ;  as a side effect, since that's just VOL_NODES*CONTENT_LEN.
   114                                  ;
   115                                  ;  *** Backward compatibility ***
   116                                  ;  v2 volumes (no node_next sector, name LBA at SUPER_LBA+3 / content at
   117                                  ;  SUPER_LBA+7, 64 nodes) and v3 volumes (has node_next, but still the old
   118                                  ;  64-node-sized name/content regions at OLD_NAME_LBA/OLD_CONTENT_LBA)
   119                                  ;  both still load and read fine - see fs_layout_ver in vol_read. Loading
   120                                  ;  either one leaves nodes 64..255 of that volume's slice explicitly
   121                                  ;  cleared (free), so the moment you mkfl/mkf/edit again you're already
   122                                  ;  using the bigger table; a sync then writes the volume back out in the
   123                                  ;  current (v4) layout, upgrading it on disk permanently.
   124                                  ;
   125                                  ;  dscan probes all four ATA device slots for the magic, format writes
   126                                  ;  a fresh empty volume + label, and mount loads a volume's node table
   127                                  ;  into memory (remapping its parent indices) rooted at /<label>/.
   128                                  ;  The kernel occupies LBA 1..1500 (KERNEL_SECTORS in boot.asm; the real
   129                                  ;  kernel.bin is ~1180 sectors after MAX_PROCESSES was trimmed 4->2, so
   130                                  ;  1500 leaves some slack). HARD CEILING: the image is loaded flat at
   131                                  ;  0x8000 and base RAM tops out at 0x9FFFF (0xA0000 is the VGA adapter
   132                                  ;  window - not RAM - so anything past that boundary is silently lost; the
   133                                  ;  bg-scheduler arrays once grew the image to ~1373 sectors, past the edge,
   134                                  ;  and the boot crashed). Keep kernel.bin under 0x98000 bytes. The
   135                                  ;  filesystem region must start clear of KERNEL_SECTORS, with real
   136                                  ;  margin for the kernel to keep growing - not just enough for today's
   137                                  ;  build - so it starts at LBA 1560. v4's bigger name/content regions
   138                                  ;  need ~100 sectors per volume (was ~28) - make sure each disk image
   139                                  ;  you build/attach has enough room past LBA 1560 for that.
   140                                  ; ------------------------------------------------------------------
   141                                  FS_LBA_START    equ 1560            ; bumped from 1150 - the background-process arrays
   142                                                                      ; once grew kernel.bin to ~1373 sectors, so boot.asm's
   143                                                                      ; KERNEL_SECTORS went 1100 -> 1500 and the filesystem
   144                                                                      ; must start past LBA 1500. *** BREAKING CHANGE: any
   145                                                                      ; image with a filesystem already written at the old
   146                                                                      ; FS_LBA_START=1150 needs to be reformatted (dscan/fmt)
   147                                                                      ; after this change, or that data is effectively at the
   148                                                                      ; wrong LBA and won't be found. ***
   149                                  SFFS_VERSION    equ 4               ; current on-disk format (256-node volumes)
   150                                  SFFS_VERSION_V3 equ 3               ; old format (64-node volumes, has node_next) - still readable
   151                                  SFFS_VERSION_V2 equ 2               ; old, single-block format - still readable
   152                                  SUPER_LABEL_OFF equ 8               ; label lives at superblock offset 8..39
   153                                  SUPER_LBA       equ FS_LBA_START
   154                                  TYPE_LBA        equ SUPER_LBA + 1
   155                                  PARENT_LBA      equ SUPER_LBA + 2
   156                                  NEXT_LBA        equ SUPER_LBA + 3
   157                                  NAME_LBA        equ SUPER_LBA + 4
   158                                  NAME_SECTORS    equ (VOL_NODES * NAME_LEN) / 512          ; 16 (256 nodes * 32B / 512)
   159                                  CONTENT_LBA     equ NAME_LBA + NAME_SECTORS                ; computed, not hardcoded - see above
   160                                  CONTENT_SECTORS equ (VOL_NODES * CONTENT_LEN) / 512       ; 80 (256 nodes * 160B / 512)
   161                                  BINLEN_LBA      equ CONTENT_LBA + CONTENT_SECTORS          ; binary-length table, first free LBA
   162                                  BINLEN_SECTORS  equ (VOL_NODES * 4) / 512                 ; 2 (256 nodes * 4B / 512)
