  9735 000182C2 B900010000                  mov rcx, VOL_NODES
  9736 000182C7 31C0                        xor eax, eax
  9737 000182C9 F3AB                        rep stosd
  9738                                  .binlen_done:
  9739                                      ; v2/v3 volumes only ever had OLD_VOL_NODES(64) real slots on disk -
  9740                                      ; explicitly free the newly-available 64..255 range for this volume
  9741                                      ; instead of trusting whatever bytes happened to land there, so the
  9742                                      ; extra v4 capacity is guaranteed clean rather than full of stale
  9743                                      ; leftovers from disk. A v4 volume already has all 256 slots valid
  9744                                      ; as read, so this is skipped for it.
  9745 000182CB 803C25[54E80500]02          cmp byte [fs_layout_ver], 2
  9746 000182D3 746C                        je .no_extend
  9747 000182D5 B940000000                  mov rcx, OLD_VOL_NODES
  9748                                  .extend_loop:
