   243                              <1> ; ============================================================
   244                              <1> ;  TLS record decryption
   245                              <1> ;  rdi = key(32), rsi = iv(12), rdx = seq, rcx = record payload
   246                              <1> ;  ptr (after the 5-byte header), r8 = ct len (incl 16-byte tag),
   247                              <1> ;  r9 = out plaintext buf.
   248                              <1> ;  CF=0: eax = inner len (excl ct byte), dl = inner content type.
   249                              <1> ;  CF=1: auth failure.
   250                              <1> ; ============================================================
   251                              <1> tls_record_decrypt:
   252                              <1>     ; NOTE: rax is NOT saved/restored here -- CF=0 returns eax = inner
   253                              <1>     ; len, so a push/pop rax pair would clobber that with the caller's
   254                              <1>     ; stale rax right before ret (same hazard as tls_record_encrypt).
