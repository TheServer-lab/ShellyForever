  1743                                  FS_MAX_ENTRIES equ 64
  1744                                  FS_ENTRY_SIZE  equ 64
  1745                                  FS_MAGIC_LBA   equ 200
  1746                                  FS_TABLE_LBA   equ 201
  1747                                  FS_TABLE_SECTORS equ 8
  1748                                  FS_MAGIC_VALUE equ 0x53464853        ; "SHFS" little-endian
  1749                                  FS_TYPE_FOLDER   equ 0
  1750                                  FS_TYPE_FILE     equ 1
  1751                                  FS_CONTENT_LBA_OFF  equ 40
  1752                                  FS_CONTENT_SIZE_OFF equ 44
