 17693 00070870 00<rep 18h>             calc_out_buf: times 24 db 0
 17694 00070888 00<rep 18h>             show_num_buf: times 24 db 0
 17695 000708A0 00<rep 18h>             dev_name_num_buf: times 24 db 0
 17696 000708B8 00<rep 28h>             ident_buf:  times 40 db 0
 17697                                  
 17698                                  ; --- process table for rush scripts ---
 17699                                  MAX_PROCESSES equ 2   ; was 4; trimmed to fit the kernel's BSS under 0xA0000 -
 17700                                                         ; the kernel image must end before the VGA adapter window
 17701                                                         ; at physical 0xA0000 (base RAM tops out at 0x9FFFF).
 17702 000708E0 0000<rep 2h>            proc_id:       times MAX_PROCESSES dw 0
 17703 000708E4 00<rep 40h>             proc_name:     times MAX_PROCESSES*32 db 0
 17704 00070924 00<rep 2h>              proc_state:    times MAX_PROCESSES db 0    ; 0=free, 1=running, 2=killed
 17705 00070926 0100                    proc_next_pid: dw 1
 17706 00070928 00                      proc_cur_slot: db 0                         ; slot index of currently running script
 17707 00070929 00                      kill_flag:     db 0                         ; set by Esc key or prs kill
 17708 0007092A 0000000000000000        rr_content_ptr: dq 0                         ; cursor into script file content
 17709                                  
 17710                                  ; --- background (.run -back) process support ---
 17711                                  ; A background .run is a Party program (the interpreter path, exactly like
 17712                                  ; 'party file.pa') run cooperatively: it executes on its OWN private stack
 17713                                  ; (proc_bg_stack) with its OWN parked interpreter state (proc_bg_ctx), and
 17714                                  ; yields back to the shell after BG_QUANTUM statements so the prompt stays
 17715                                  ; responsive. Output is redirected by putchar into the process's output
 17716                                  ; ring (proc_bg_ring) while it runs, and 'prs peek' shows the last lines.
 17717                                  BG_RING_CAP   equ 4096          ; bytes of captured output per process
 17718                                  BG_SRC_MAX    equ 16384         ; max embedded source bytes for a -back script
 17719                                  BG_STACK_SIZE equ 8192          ; per-process private interpreter stack
 17720                                  BG_QUANTUM    equ 200           ; statements a background step may run
 17721                                  
 17722 00070932 00<rep 2h>              proc_bg:          times MAX_PROCESSES db 0    ; 1 = background party process
 17723 00070934 0000000000000000-       proc_bg_rsp:      times MAX_PROCESSES dq 0    ; saved private-stack pointer (resume IP on top)
 17723 00070934 <rep 2h>           
 17724 00070944 00000000<rep 2h>        proc_bg_ring_start: times MAX_PROCESSES dd 0  ; output ring read offset
 17725 0007094C 00000000<rep 2h>        proc_bg_ring_len:   times MAX_PROCESSES dd 0  ; output ring byte count
 17726 00070954 00<rep 2000h>           proc_bg_ring:     times MAX_PROCESSES*BG_RING_CAP db 0
 17727 00072954 00<rep 8000h>           proc_bg_src:      times MAX_PROCESSES*BG_SRC_MAX db 0
 17728 0007A954 00<rep 4000h>           proc_bg_stack:    times MAX_PROCESSES*BG_STACK_SIZE db 0
 17729 0007E954 00<rep 9E04h>           proc_bg_ctx:      times MAX_PROCESSES*PARTY_CTX_SIZE db 0  ; parked interpreter state
 17730                                  
 17731 00088758 0000000000000000        bg_shell_rsp:       dq 0        ; shell stack pointer parked across a background step
 17732 00088760 00                      bg_cur_slot:        db 0        ; slot currently being stepped (read by party_bg_suspend)
 17733 00088761 00000000                bg_stmt_idx:        dd 0        ; saved token cursor for a yielded background process
 17734 00088765 00000000                bg_stop_tok:        dd 0        ; saved stop token (r14) for a yielded background process
 17735 00088769 00000000                party_bg_quantum:   dd 0        ; statements left in the current background step
 17736 0008876D 00                      party_bg_active:    db 0        ; 1 while a background process is running (interpreter checks)
 17737 0008876E 0000000000000000        bg_capture_base:    dq 0        ; putchar redirection: base of the active output ring
 17738 00088776 0000000000000000        bg_capture_start_ptr: dq 0      ; pointer to the ring's read-offset dword
 17739 0008877E 0000000000000000        bg_capture_len_ptr: dq 0        ; pointer to the ring's byte-count dword
 17740 00088786 0000000000000000        bg_capture_max:     dq 0        ; ring capacity
 17741 0008878E 00<rep A0h>             bg_notice:          times 160 db 0   ; pending "process finished/killed" line
 17742 0008882E 00                      bg_notice_pending:  db 0        ; 1 while a notice is waiting to be printed
 17743 0008882F 00<rep 1001h>           prs_peek_buf:       times BG_RING_CAP+1 db 0   ; linearized output for 'prs peek'
 17744 00089830 00                      sched_slot:         db 0        ; round-robin cursor for the bg scheduler
 17745                                  
 17746                                  ; --- large staging buffers. A file can span a whole VOL_NODES-node volume slice, so
 17747                                  ; these are sized to hold a full file's content (EDIT_MAX). Declared at the
 17748                                  ; very end of the file, after all code, so any growth doesn't move anything. ---
 17749 00089831 00<rep 200h>            fs_next_scratch: times 512 db 0     ; staging for one full node_next sector
 17750 00089A31 00<rep A000h>           fs_io_buf:  times EDIT_MAX db 0     ; editor + view/read/copy staging for multi-block files
