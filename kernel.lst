 13909                                  .vs_got:
 13910 0001ACCE C681[08ED0600]01            mov byte [var_used+rcx], 1
 13911 0001ACD5 4889CF                      mov rdi, rcx
 13912 0001ACD8 486BFF20                    imul rdi, VAR_NAME_LEN
 13913 0001ACDC 488DBF[88EA0600]            lea rdi, [var_name+rdi]
 13914 0001ACE3 E8EB1B0100                  call str_copy
 13915 0001ACE8 4889C8                      mov rax, rcx
 13916 0001ACEB EB00                        jmp .vs_setval
 13917                                  .vs_have:
 13918                                  .vs_setval:
 13919 0001ACED 48891CC5[88EC0600]          mov [var_value + rax*8], rbx
 13920                                  .vs_full:
