 14673 0001F1D9 38                 
 14674 0001F1DA 39302D3D0809                db '9','0','-','=',8,9                        ; 0x0A-0x0F
 14675 0001F1E0 71776572747975696F-         db 'q','w','e','r','t','y','u','i','o','p'    ; 0x10-0x19
 14675 0001F1E9 70                 
 14676 0001F1EA 5B5D0D00                    db '[',']',13,0                                ; 0x1A-0x1D
 14677 0001F1EE 6173646667686A6B6C-         db 'a','s','d','f','g','h','j','k','l',';'    ; 0x1E-0x27
 14677 0001F1F7 3B                 
 14678 0001F1F8 2760005C                    db 39,'`',0,'\'                                ; 0x28-0x2B
 14679 0001F1FC 7A786376626E6D2C2E-         db 'z','x','c','v','b','n','m',',','.','/'    ; 0x2C-0x35
 14679 0001F205 2F                 
 14680 0001F206 002A0020                    db 0,'*',0,' '                                 ; 0x36-0x39
 14681                                  
 14682                                  kbd_shift:
 14683 0001F20A 001B21402324255E26-         db 0,27,'!','@','#','$','%','^','&','*'       ; 0x00-0x09
 14683 0001F213 2A                 
 14684 0001F214 28295F2B0809                db '(',')','_','+',8,9                         ; 0x0A-0x0F
 14685 0001F21A 51574552545955494F-         db 'Q','W','E','R','T','Y','U','I','O','P'    ; 0x10-0x19
 14685 0001F223 50                 
 14686 0001F224 7B7D0D00                    db '{','}',13,0                                ; 0x1A-0x1D
 14687 0001F228 4153444647484A4B4C-         db 'A','S','D','F','G','H','J','K','L',':'    ; 0x1E-0x27
 14687 0001F231 3A                 
 14688 0001F232 227E007C                    db 34,'~',0,'|'                                ; 0x28-0x2B
 14689 0001F236 5A584356424E4D3C3E-         db 'Z','X','C','V','B','N','M','<','>','?'    ; 0x2C-0x35
 14689 0001F23F 3F                 
 14690 0001F240 002A0020                    db 0,'*',0,' '                                 ; 0x36-0x39
