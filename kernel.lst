  1423                              <1> ; ============================================================
  1424                              <1> ;  PARTY (.pa) LANGUAGE — TREE-WALKING INTERPRETER
  1425                              <1> ; ============================================================
  1426                              <1> ; The executor is a recursive-descent interpreter over the token
  1427                              <1> ; stream produced by party_lex. It supports the full v0.1 spec:
  1428                              <1> ; vars, assignment, if/else-if/else, while, func/return (with
  1429                              <1> ; recursion), and full expressions over int/float/bool/string.
  1430                              <1> ;
  1431                              <1> ; Values are 32 bytes: { type:u8, resv:u8, [pad], data:qword,
  1432                              <1> ; strptr:qword, strlen:qword }. data holds an int64 / double /
  1433                              <1> ; bool flag; strptr/strlen describe a string that points into
  1434                              <1> ; fs_io_buf (string literals are never copied out).
  1435                              <1> ;
  1436                              <1> ; The interpreter keeps its own state in a value stack
  1437                              <1> ; (party_vstack), a global var table, a locals pool (one run per
  1438                              <1> ; active call frame), a function table (collected in a first pass
  1439                              <1> ; so mutual recursion works), and a fixed-size call-frame stack.
  1440                              <1> ;
  1441                              <1> ; Errors set party_exec_ok=0 + party_err_msg_ptr + party_error_line
  1442                              <1> ; through party_set_err; every parser level is a no-op once the
  1443                              <1> ; error flag is set, so a failure unwinds cleanly to party_exec.
  1444                              <1> ; ------------------------------------------------------------
  1445                              <1> 
  1446                              <1> ; ---- value types ----
  1447                              <1> PV_NONE  equ 0
  1448                              <1> PV_INT   equ 1
  1449                              <1> PV_FLOAT equ 2
  1450                              <1> PV_BOOL  equ 3
  1451                              <1> PV_STR   equ 4
  1452                              <1> PV_ARRAY equ 5      ; Phase 4: data field ([+8]) holds a handle - an index
  1453                              <1>                      ; into the party_arr_* table (party_arr_alloc/_check),
  1454                              <1>                      ; the same handle-into-a-fixed-table model PARTY_FH_*
  1455                              <1>                      ; already uses for file handles. No str fields used.
  1456                              <1> 
  1457                              <1> ; ---- interpreter capacities ----
  1458                              <1> MAXVSTACK equ 64
  1459                              <1> MAXVARS   equ 32
  1460                              <1> MAXLOCALS equ 64
  1461                              <1> MAXFUNCS  equ 32
  1462                              <1> MAXCALLS  equ 32
  1463                              <1> 
  1464                              <1> ; ------------------------------------------------------------
  1465                              <1> ; party_exec: interpreter entry. Collects all func declarations,
  1466                              <1> ; then runs top-level statements (skipping the func blocks, which
  1467                              <1> ; are declarations). fninit resets the x87 FPU used for floats.
  1468                              <1> ; Out: party_exec_ok = 1 success, 0 failure (+ party_error_line,
  1469                              <1> ; party_err_msg_ptr). Preserves everything except the interpreter's
  1470                              <1> ; own state (which is fully re-initialized on entry).
  1471                              <1> ; ------------------------------------------------------------
  1472                              <1> party_exec:
  1473 00026FE2 53                  <1>     push rbx
  1474 00026FE3 4154                <1>     push r12
  1475 00026FE5 4155                <1>     push r13
  1476 00026FE7 4156                <1>     push r14
  1477 00026FE9 4157                <1>     push r15
  1478 00026FEB DBE3                <1>     fninit                        ; reset x87 FPU (CW back to defaults)
  1479 00026FED 4D31ED              <1>     xor r13, r13
  1480 00026FF0 C60425[01B30200]01  <1>     mov byte [party_exec_ok], 1
  1481 00026FF8 C60425[02B30200]00  <1>     mov byte [party_killed], 0
  1482 00027000 C60425[46270300]00  <1>     mov byte [party_returning], 0
  1483 00027008 C60425[695A0A00]00  <1>     mov byte [kill_flag], 0
