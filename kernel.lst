     1                                  ; ============================================================
     2                                  ;  ShellyForever  --  kernel.asm
     3                                  ;  Loaded flat at physical address 0x8000 by boot.asm, already
     4                                  ;  running in 64-bit long mode with the first 2MB identity
     5                                  ;  mapped. No IDT/interrupts are set up - keyboard is polled.
     6                                  ; ============================================================
     7                                  
     8                                  BITS 64
     9                                  ORG 0x8000
    10                                  
    11                                  ; ---------------- constants ----------------
    12                                  VGA_BASE        equ 0xB8000
    13                                  VGA_COLS        equ 80
    14                                  VGA_ROWS        equ 25
    15                                  ATTR_NORMAL     equ 0x0A          ; bright green on black
    16                                  ATTR_PROMPT     equ 0x0E          ; yellow
    17                                  ATTR_ERROR      equ 0x0C          ; red
    18                                  ATTR_WIG        equ 0x0B          ; light cyan - used by the wig clock widget
    19                                  
    20                                  OS_NODES        equ 64              ; nodes per volume (each drive holds its own 64-node table)
    21                                  MAX_MOUNTS      equ 2               ; how many extra drives can be mounted at once
    22                                  
    23                                  ; AHCI (SATA) support: device ids 0-3 are still the legacy ATA PIO slots
    24                                  ; (primary/secondary x master/slave); ids 4..4+AHCI_MAX_PORTS-1 are AHCI
    25                                  ; ports discovered at boot (see ahci_init). dscan/fmt/mount all iterate
    26                                  ; 0..TOTAL_DEVICES-1 and go through disk_select_device, which routes each
    27                                  ; id to the right driver - see that routine for the full explanation.
    28                                  AHCI_MAX_PORTS  equ 4
    29                                  TOTAL_DEVICES   equ 4 + AHCI_MAX_PORTS
    30                                  VOL_NODES       equ OS_NODES        ; every volume, OS or mounted, is the same size
    31                                  MAX_NODES       equ OS_NODES * (1 + MAX_MOUNTS)   ; 192 = OS volume + 2 mounts
    32                                  NAME_LEN        equ 32
    33                                  CONTENT_LEN     equ 160
    34                                  LINE_MAX        equ 220
    35                                  
    36                                  SCROLLBACK_LINES equ 100         ; extra off-screen rows kept for Ctrl+Up/Down
    37                                  HISTORY_MAX      equ 20          ; command history entries kept for Up/Down
    38                                  KEY_UP           equ 0x11        ; sentinel byte get_char returns for the Up arrow
    39                                  KEY_DOWN         equ 0x12        ; sentinel byte get_char returns for the Down arrow
    40                                  KEY_PASTE        equ 0x13        ; sentinel byte get_char returns for Ctrl+V
    41                                  
    42                                  MAX_VARS        equ 16
    43                                  VAR_NAME_LEN    equ 32
    44                                  MAX_CALC_TOKENS equ 32
    45                                  
    46                                  MAX_ALIASES     equ 12         ; how many "ali <name> <commands>" aliases can exist at once
    47                                  ALIAS_NAME_LEN  equ 32
    48                                  ALIAS_BODY_LEN  equ LINE_MAX   ; an alias body is at most one full input line
    49                                  ALIAS_MAX_DEPTH equ 8          ; guards against an alias (in)directly invoking itself
    50                                  
    51                                  PIPE_CAP_MAX    equ 192       ; max bytes captured from a "~" pipe's left side
    52                                  
    53                                  ; ------------------------------------------------------------------
    54                                  ;  SFFS v3 -- ShellyForever File Storage format (on-disk layout).
    55                                  ;  Every drive (OS boot drive and any data drives) uses the same
    56                                  ;  fixed layout so any drive can be scanned, formatted, and mounted:
    57                                  ;
    58                                  ;    LBA  FS_LBA_START     : superblock (512B) - magic 'SFFS', version
    59                                  ;                             byte, reserved, 32-byte disk label
    60                                  ;    LBA  FS_LBA_START+1   : node_type[VOL_NODES]  (1 sector, padded)
    61                                  ;    LBA  FS_LBA_START+2   : node_parent[VOL_NODES] (1 sector, padded)
    62                                  ;    LBA  FS_LBA_START+3   : node_next[VOL_NODES]  (1 sector; 0xFFFF = no
    63                                  ;                             continuation). v3 only - v2 has no next sector.
    64                                  ;    LBA  FS_LBA_START+4.. : node_name[VOL_NODES*NAME_LEN] (4 sectors)
    65                                  ;    LBA  FS_LBA_START+8.. : node_content[VOL_NODES*CONTENT_LEN] (20)
    66                                  ;
    67                                  ;  A file whose content exceeds one 159-byte slot is stored as a chain:
    68                                  ;  the file's own node holds the first chunk, and its node_next points at
    69                                  ;  NODE_TYPE_CHAIN (type-3) continuation nodes, each holding the next 159
    70                                  ;  bytes and linked through their own node_next (0xFFFF terminates). Chain
    71                                  ;  nodes are invisible to path lookup, listing, and the allocator, and are
    72                                  ;  freed along with the file. v2 volumes (no node_next sector, name LBA at
    73                                  ;  +3 / content at +7) still load and read fine; a sync upgrades them to v3.
    74                                  ;
    75                                  ;  dscan probes all four ATA device slots for the magic, format writes
    76                                  ;  a fresh empty volume + label, and mount loads a volume's node table
    77                                  ;  into memory (remapping its parent indices) rooted at /<label>/.
    78                                  ;  The kernel occupies LBA 1..480 (KERNEL_SECTORS in boot.asm) - the
    79                                  ;  NIC/network stack (Milestone B), TCP engine (Milestone C) and the
    80                                  ;  browser (Milestone E) grew the image well past 460 - so the filesystem
    81                                  ;  region starts at LBA 500 to stay clear of it.
    82                                  ; ------------------------------------------------------------------
    83                                  FS_LBA_START    equ 500
    84                                  SFFS_VERSION    equ 3
    85                                  SFFS_VERSION_V2 equ 2               ; old format, still readable
    86                                  SUPER_LABEL_OFF equ 8               ; label lives at superblock offset 8..39
    87                                  SUPER_LBA       equ FS_LBA_START
    88                                  TYPE_LBA        equ SUPER_LBA + 1
    89                                  PARENT_LBA      equ SUPER_LBA + 2
    90                                  NEXT_LBA        equ SUPER_LBA + 3
    91                                  NAME_LBA        equ SUPER_LBA + 4
    92                                  CONTENT_LBA     equ SUPER_LBA + 8
    93                                  NAME_SECTORS    equ (VOL_NODES * NAME_LEN) / 512          ; 4
    94                                  CONTENT_SECTORS equ (VOL_NODES * CONTENT_LEN) / 512       ; 20
    95                                  NODE_TYPE_CHAIN equ 3               ; continuation node in a file's content chain
    96                                  EDIT_MAX        equ VOL_NODES * CONTENT_LEN   ; max bytes one file can hold (64*160)
    97                                  
    98                                  ; ============================================================
    99                                  kernel_entry:
   100 00000000 FA                          cli
   101 00000001 BC00F00900                  mov rsp, 0x9F000
   102                                  
   103                                      ; bring up COM1 immediately so putchar can mirror every character there,
   104                                      ; letting QEMU capture the whole session to a file via -serial file:.
   105 00000006 E88B420100                  call serial_init
   106                                  
   107                                  
   108                                      ; --- TEMPORARY diagnostic checkpoint A: proves boot.asm's real-mode ->
   109                                      ; protected-mode -> long-mode transition landed here at all, before
   110                                      ; expand_identity_map or ahci_init get a chance to run/crash. If you
   111                                      ; only ever see "12" and never "A", the failure is inside boot.asm's
   112                                      ; mode-switch code (A20/GDT/paging/long-mode jump), not in the kernel.
   113 0000000B BF0C8F0B00                  mov rdi, 0xB8000 + (24*80 + 6) * 2
   114 00000010 C60741                      mov byte [rdi], 'A'
   115 00000013 C647011F                    mov byte [rdi+1], 0x1F
   116                                  
   117                                      ; boot.asm only had room (512-byte sector) to identity-map the first
   118                                      ; 64MB. That's not enough for acpi_shutdown's ACPI table walk later -
   119                                      ; firmware can put the FADT/DSDT well above 64MB (e.g. ~127MB on a
   120                                      ; 128MB guest) - so extend the map to 4GB right away, before anything
   121                                      ; else runs. See expand_identity_map below for details.
   122 00000017 E8A7050000                  call expand_identity_map
   123                                  
   124                                      ; --- TEMPORARY diagnostic checkpoint X: expand_identity_map returned
   125                                      ; without crashing/hanging. If "A" shows but "X" doesn't, the 4GB
   126                                      ; identity-map rebuild is where things go wrong on this hardware.
   127 0000001C BF0E8F0B00                  mov rdi, 0xB8000 + (24*80 + 7) * 2
   128 00000021 C60758                      mov byte [rdi], 'X'
   129 00000024 C647011F                    mov byte [rdi+1], 0x1F
   130                                  
   131                                      ; probe for a PCI AHCI (SATA) controller and bring up its ports, if any,
   132                                      ; as extra disk device slots (4..4+AHCI_MAX_PORTS-1) alongside the four
   133                                      ; legacy ATA slots. Inert/no-op if there isn't one (ahci_port_count stays
   134                                      ; 0) - the OS behaves exactly as it always did in that case.
   135 00000028 E81A640000                  call ahci_init
   136                                  
   137                                      ; probe for a PCI RTL8139 NIC and bring up its ring buffers, if any.
   138                                      ; Inert/no-op if there isn't one (nic_present stays 0) - the OS behaves
   139                                      ; exactly as it always did in that case. See nic_init below.
   140 0000002D E8D96F0000                  call nic_init
   141                                  
   142                                      ; bring up COM1 as a serial console; putchar mirrors every char there, so
   143                                      ; QEMU can capture the whole session to a file via -serial file:.
   144 00000032 E85F420100                  call serial_init
   145                                  
   146                                      ; checkpoint 9: kernel code is executing (proves boot.asm's jump into
   147                                      ; 0x8000 landed correctly). Matches the DBG16/32/64 checkpoints in
   148                                      ; boot.asm - if you see 1..8 but not this, the kernel wasn't loaded/
   149                                      ; jumped to correctly; if the OS otherwise looks fine you can ignore it.
   150 00000037 BF108F0B00                  mov rdi, 0xB8000 + (24*80 + 8) * 2
   151 0000003C C6074B                      mov byte [rdi], 'K'
   152 0000003F C647010F                    mov byte [rdi+1], 0x0F
   153                                  
   154 00000043 E8A6410100                  call clear_screen
   155 00000048 E858900000                  call fs_load                ; loads persisted fs from disk, or fs_init's a fresh one
   156                                  
