 16327                                  .not_capturing:
 16328                                      ; background-process capture: while a background .run is being
 16329                                      ; stepped, putchar appends to that process's output ring instead of
 16330                                      ; touching the screen/serial at all (like the "~" pipe capture above).
 16331 00070D13 48833C25[36890C00]-         cmp qword [bg_capture_base], 0
 16331 00070D1B 00                 
 16332 00070D1C 0F8480000000                je .bg_nocap
 16333 00070D22 3C0D                        cmp al, 0x0D
 16334 00070D24 7476                        je .bg_cap_exit              ; ignore carriage returns
 16335 00070D26 56                          push rsi
 16336 00070D27 51                          push rcx
 16337 00070D28 52                          push rdx
 16338 00070D29 88C3                        mov bl, al                   ; stash the char (bl is dead on this path)
 16339 00070D2B 488B3425[36890C00]          mov rsi, [bg_capture_base]
 16340 00070D33 488B0C25[46890C00]          mov rcx, [bg_capture_len_ptr]
 16341 00070D3B 488B1425[3E890C00]          mov rdx, [bg_capture_start_ptr]
 16342 00070D43 8B09                        mov ecx, [rcx]               ; current byte count
 16343 00070D45 8B12                        mov edx, [rdx]               ; current start offset
 16344 00070D47 488B3C25[4E890C00]          mov rdi, [bg_capture_max]
 16345 00070D4F 4839F9                      cmp rcx, rdi
 16346 00070D52 721D                        jb .bg_cap_append
 16347                                      ; ring full: overwrite the oldest byte and advance the start
 16348 00070D54 488D3416                    lea rsi, [rsi + rdx]
 16349 00070D58 881E                        mov [rsi], bl
 16350 00070D5A 48FFC2                      inc rdx
 16351 00070D5D 4839FA                      cmp rdx, rdi
 16352 00070D60 7203                        jb .bg_cap_s_ok
 16353 00070D62 4831D2                      xor rdx, rdx
 16354                                  .bg_cap_s_ok:
