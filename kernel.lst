 11392                                  ; mdio_write_rtl: dl = PHY register address (0-31), eax = 16-bit value to
 11393                                  ; write (low 16 bits used). Uses PHYAR (offset 0x60): bit31=1 triggers a
 11394                                  ; write, register addr in bits 20:16, data in bits 15:0. Hardware clears
 11395                                  ; bit31 when the write completes; we poll for that with a bounded budget.
 11396                                  mdio_write_rtl:
 11397 00019404 50                          push rax
 11398 00019405 51                          push rcx
 11399 00019406 52                          push rdx
 11400 00019407 57                          push rdi
 11401 00019408 4151                        push r9
 11402                                  
 11403 0001940A 0FB6CA                      movzx ecx, dl
 11404 0001940D 83E11F                      and ecx, 0x1F
 11405 00019410 C1E110                      shl ecx, 16
 11406 00019413 25FFFF0000                  and eax, 0xFFFF
 11407 00019418 09C1                        or ecx, eax
 11408 0001941A 81C900000080                or ecx, 0x80000000
 11409 00019420 8B3C25[B0E80500]            mov edi, [nic_io_base]
 11410 00019427 83C760                      add edi, RTL_IO_PHYAR
 11411 0001942A 89C8                        mov eax, ecx
 11412 0001942C E878F1FFFF                  call nic_io_write32
 11413                                  
 11414 00019431 41B9D0070000                mov r9, 2000
