 15058                                  ; print_string_attr: rsi=string, al=attribute byte
 15059                                  print_string_attr:
 15060 0002CA0C 50                          push rax
 15061 0002CA0D 53                          push rbx
 15062 0002CA0E 56                          push rsi
 15063 0002CA0F 88C3                        mov bl, al
 15064                                  .loop:
