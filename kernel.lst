  6917                                  .ppr_scan_done2:
  6918 000162E9 498DB0[2F880800]            lea rsi, [prs_peek_buf + r8]
  6919 000162F0 41C687[2F880800]00          mov byte [prs_peek_buf + r15], 0
  6920 000162F8 4180BF[2E880800]0A          cmp byte [prs_peek_buf + r15 - 1], 0x0A
  6921 00016300 7410                        je .ppr_print
  6922 00016302 41C687[2F880800]0A          mov byte [prs_peek_buf + r15], 0x0A
  6923 0001630A 41C687[30880800]00          mov byte [prs_peek_buf + r15 + 1], 0
