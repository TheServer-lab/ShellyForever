   679                              <1> ; ============================================================
   680                              <1> ;  PARTY (.pa) LANGUAGE — TREE-WALKING INTERPRETER
   681                              <1> ; ============================================================
   682                              <1> ; The executor is a recursive-descent interpreter over the token
   683                              <1> ; stream produced by party_lex. It supports the full v0.1 spec:
   684                              <1> ; vars, assignment, if/else-if/else, while, func/return (with
   685                              <1> ; recursion), and full expressions over int/float/bool/string.
   686                              <1> ;
   687                              <1> ; Values are 32 bytes: { type:u8, resv:u8, [pad], data:qword,
   688                              <1> ; strptr:qword, strlen:qword }. data holds an int64 / double /
   689                              <1> ; bool flag; strptr/strlen describe a string that points into
   690                              <1> ; fs_io_buf (string literals are never copied out).
   691                              <1> ;
   692                              <1> ; The interpreter keeps its own state in a value stack
   693                              <1> ; (party_vstack), a global var table, a locals pool (one run per
   694                              <1> ; active call frame), a function table (collected in a first pass
   695                              <1> ; so mutual recursion works), and a fixed-size call-frame stack.
   696                              <1> ;
   697                              <1> ; Errors set party_exec_ok=0 + party_err_msg_ptr + party_error_line
   698                              <1> ; through party_set_err; every parser level is a no-op once the
   699                              <1> ; error flag is set, so a failure unwinds cleanly to party_exec.
   700                              <1> ; ------------------------------------------------------------
   701                              <1> 
   702                              <1> ; ---- value types ----
   703                              <1> PV_NONE  equ 0
   704                              <1> PV_INT   equ 1
   705                              <1> PV_FLOAT equ 2
   706                              <1> PV_BOOL  equ 3
   707                              <1> PV_STR   equ 4
   708                              <1> 
   709                              <1> ; ---- interpreter capacities ----
   710                              <1> MAXVSTACK equ 64
   711                              <1> MAXVARS   equ 32
   712                              <1> MAXLOCALS equ 64
   713                              <1> MAXFUNCS  equ 32
   714                              <1> MAXCALLS  equ 32
   715                              <1> 
   716                              <1> ; ------------------------------------------------------------
   717                              <1> ; party_exec: interpreter entry. Collects all func declarations,
   718                              <1> ; then runs top-level statements (skipping the func blocks, which
   719                              <1> ; are declarations). fninit resets the x87 FPU used for floats.
   720                              <1> ; Out: party_exec_ok = 1 success, 0 failure (+ party_error_line,
   721                              <1> ; party_err_msg_ptr). Preserves everything except the interpreter's
   722                              <1> ; own state (which is fully re-initialized on entry).
   723                              <1> ; ------------------------------------------------------------
   724                              <1> party_exec:
   725 0001BE59 53                  <1>     push rbx
   726 0001BE5A 4154                <1>     push r12
   727 0001BE5C 4155                <1>     push r13
   728 0001BE5E 4156                <1>     push r14
   729 0001BE60 4157                <1>     push r15
   730 0001BE62 DBE3                <1>     fninit                        ; reset x87 FPU (CW back to defaults)
   731 0001BE64 4D31ED              <1>     xor r13, r13
   732 0001BE67 C60425[E9E70100]01  <1>     mov byte [party_exec_ok], 1
   733 0001BE6F C60425[EAE70100]00  <1>     mov byte [party_killed], 0
   734 0001BE77 C60425[8EFA0100]00  <1>     mov byte [party_returning], 0
   735 0001BE7F C60425[29090700]00  <1>     mov byte [kill_flag], 0
   736 0001BE87 48C70425[98FA0100]- <1>     mov qword [party_vsp], 0
   736 0001BE8F 00000000            <1>
   737 0001BE93 48C70425[A0FA0100]- <1>     mov qword [party_call_depth], 0
   737 0001BE9B 00000000            <1>
   738 0001BE9F 48C70425[A8FA0100]- <1>     mov qword [party_loc_count], 0
   738 0001BEA7 00000000            <1>
   739 0001BEAB 48C70425[B0FA0100]- <1>     mov qword [party_func_count], 0
   739 0001BEB3 00000000            <1>
   740 0001BEB7 48C70425[90FA0100]- <1>     mov qword [party_err_msg_ptr], 0
   740 0001BEBF 00000000            <1>
   741                              <1> 
   742 0001BEC3 488D3C25[60030200]  <1>     lea rdi, [party_var_used]
   743 0001BECB B920000000          <1>     mov rcx, MAXVARS
   744 0001BED0 E8890C0000          <1>     call party_memzero
   745 0001BED5 488D3C25[800C0200]  <1>     lea rdi, [party_loc_used]
   746 0001BEDD B940000000          <1>     mov rcx, MAXLOCALS
   747 0001BEE2 E8770C0000          <1>     call party_memzero
   748 0001BEE7 488D3C25[002A0200]  <1>     lea rdi, [party_frame_returned]
   749 0001BEEF B920000000          <1>     mov rcx, MAXCALLS
   750 0001BEF4 E8650C0000          <1>     call party_memzero
   751                              <1> 
   752 0001BEF9 E8CC020000          <1>     call party_collect_funcs
   753 0001BEFE 803C25[E9E70100]01  <1>     cmp byte [party_exec_ok], 1
   754 0001BF06 750B                <1>     jne .pe_out
   755                              <1> 
   756 0001BF08 41BE00000000        <1>     mov r14, TOK_EOF
   757 0001BF0E E822040000          <1>     call party_exec_stmts
   758                              <1> 
   759                              <1> .pe_out:
   760 0001BF13 415F                <1>     pop r15
   761 0001BF15 415E                <1>     pop r14
   762 0001BF17 415D                <1>     pop r13
   763 0001BF19 415C                <1>     pop r12
   764 0001BF1B 5B                  <1>     pop rbx
   765 0001BF1C C3                  <1>     ret
   766                              <1> 
   767                              <1> ; ------------------------------------------------------------
   768                              <1> ; party_boot_compiled: KAPI_BOOT. A compiled .run binary's entry stub
   769                              <1> ; does LEA RSI, embedded-source ; CALL [KAPI_BOOT] ; RET - this is that
   770                              <1> ; bootstrap. rsi = the Party source embedded in the .run file (token
   771                              <1> ; text offsets are relative to it). Resets the runtime, lexes the
   772                              <1> ; embedded source, collects func declarations and runs the program
   773                              <1> ; with the tree-walking interpreter - the same path 'party foo.pa'
   774                              <1> ; uses, so a compiled program needs no separate runtime. On a lex
   775                              <1> ; error prints the failing line to the screen. Clobbers rax-r15 and
   776                              <1> ; the FPU; sets party_exec_ok / party_lex_ok / party_error_line.
   777                              <1> ; ------------------------------------------------------------
   778                              <1> party_boot_compiled:
   779 0001BF1D 48893425[EFE70100]  <1>     mov [party_src_base], rsi
   780 0001BF25 E83C0D0000          <1>     call party_reset_runtime
   781 0001BF2A E860F9FFFF          <1>     call party_lex
   782 0001BF2F 803C25[E8E70100]01  <1>     cmp byte [party_lex_ok], 1
   783 0001BF37 751B                <1>     jne .pbc_lex_fail
   784 0001BF39 E88C020000          <1>     call party_collect_funcs
   785 0001BF3E 803C25[E9E70100]01  <1>     cmp byte [party_exec_ok], 1
   786 0001BF46 750B                <1>     jne .pbc_out
   787 0001BF48 41BE00000000        <1>     mov r14, TOK_EOF
   788 0001BF4E E8E2030000          <1>     call party_exec_stmts
   789                              <1> .pbc_out:
   790 0001BF53 C3                  <1>     ret
   791                              <1> .pbc_lex_fail:
   792 0001BF54 48BE-               <1>     mov rsi, msg_party_lex_err
   792 0001BF56 [90E5010000000000]  <1>
   793 0001BF5E B00C                <1>     mov al, ATTR_ERROR
   794 0001BF60 E8A70A0100          <1>     call print_string_attr
   795 0001BF65 8B0425[EBE70100]    <1>     mov eax, [party_error_line]
   796 0001BF6C 488D3C25[88080700]  <1>     lea rdi, [show_num_buf]
   797 0001BF74 E8E6EDFFFF          <1>     call int_to_str
   798 0001BF79 48BE-               <1>     mov rsi, show_num_buf
   798 0001BF7B [8808070000000000]  <1>
   799 0001BF83 E8750A0100          <1>     call print_string
   800 0001BF88 48BE-               <1>     mov rsi, newline_str
   800 0001BF8A [B238030000000000]  <1>
   801 0001BF92 E8660A0100          <1>     call print_string
   802 0001BF97 C3                  <1>     ret
   803                              <1> 
   804                              <1> ; ------------------------------------------------------------
   805                              <1> ;  BACKGROUND PROCESS CONTEXT SAVE / RESTORE
   806                              <1> ;  party_ctx_save(rdi = dst ctx base) parks the whole mutable
   807                              <1> ;  interpreter state (token stream, value stack, variable/locals/
   808                              <1> ;  function/call-frame tables, all scalars, the live statement cursor)
   809                              <1> ;  into a process's proc_bg_ctx area. party_ctx_restore(rsi = src ctx
   810                              <1> ;  base) brings it all back before a background step resumes. The
   811                              <1> ;  regions copied are listed in party_ctx_table (src-address/size
   812                              <1> ;  pairs, zero-terminated); r13 (statement cursor), r14 (stop token)
   813                              <1> ;  and r15 (branch flag) are parked after the data block. Used both by
   814                              <1> ;  cmd_run_back (parks the freshly lexed+collected state before the
   815                              <1> ;  first step) and party_bg_suspend (parks a mid-run state at a yield).
   816                              <1> ;  Both clobber rax, rbx, rcx, rsi, rdi, r8-r15.
   817                              <1> ; ------------------------------------------------------------
   818                              <1> PARTY_CTX_REGS_OFFS equ 20226 - 24
   819                              <1> PARTY_CTX_SIZE      equ 20226
   820                              <1> 
   821                              <1> party_ctx_table:
   822 0001BF98 [E8E7010000000000]- <1>     dq party_lex_ok, 7             ; lex_ok, exec_ok, killed, error_line
   822 0001BFA0 0700000000000000    <1>
   823 0001BFA8 [EFE7010000000000]- <1>     dq party_src_base, 8
   823 0001BFB0 0800000000000000    <1>
   824 0001BFB8 [F7E7010000000000]- <1>     dq party_ident_buf, 184        ; ident_buf + call_name_buf + stmt_name_buf + text_buf
   824 0001BFC0 B800000000000000    <1>
   825 0001BFC8 [B0E8010000000000]- <1>     dq party_token_count, 4098     ; token_count + the token array
   825 0001BFD0 0210000000000000    <1>
   826 0001BFD8 [8EFA010000000000]- <1>     dq party_returning, 1
   826 0001BFE0 0100000000000000    <1>
   827 0001BFE8 [90FA010000000000]- <1>     dq party_err_msg_ptr, 40       ; err_msg_ptr, vsp, call_depth, loc_count, func_count
   827 0001BFF0 2800000000000000    <1>
   828 0001BFF8 [B8FA010000000000]- <1>     dq party_while_cond_tok, 8
   828 0001C000 0800000000000000    <1>
   829 0001C008 [C0FA010000000000]- <1>     dq party_scratch, 96           ; scratch, scratch1, scratch2
   829 0001C010 6000000000000000    <1>
   830 0001C018 [20FB010000000000]- <1>     dq party_ftmp_i, 20            ; ftmp_i, tmp_i, fp_cw, fp_cw2
   830 0001C020 1400000000000000    <1>
   831 0001C028 [3CFB010000000000]- <1>     dq party_num_buf, 32
   831 0001C030 2000000000000000    <1>
   832 0001C038 [60FB010000000000]- <1>     dq party_vstack, 2048
   832 0001C040 0008000000000000    <1>
   833 0001C048 [6003020000000000]- <1>     dq party_var_used, 32
   833 0001C050 2000000000000000    <1>
   834 0001C058 [8003020000000000]- <1>     dq party_var_val, 2304         ; var_val + var_name
   834 0001C060 0009000000000000    <1>
   835 0001C068 [800C020000000000]- <1>     dq party_loc_used, 64
