 16307 00070CCF 803C25[F13A0A00]00          cmp byte [pipe_capture_on], 0
 16308 00070CD7 743A                        je .not_capturing
 16309 00070CD9 3C0D                        cmp al, 0x0D
 16310 00070CDB 7430                        je .cap_done              ; ignore carriage returns
 16311 00070CDD 488B0C25[F83A0A00]          mov rcx, [pipe_capture_len]
 16312 00070CE5 4881F9BF000000              cmp rcx, PIPE_CAP_MAX-1
 16313 00070CEC 731F                        jae .cap_done              ; capture buffer full - silently truncate
 16314 00070CEE 488D3C25[003B0A00]          lea rdi, [pipe_capture_buf]
 16315 00070CF6 4801CF                      add rdi, rcx
 16316 00070CF9 8807                        mov [rdi], al
 16317 00070CFB 48FFC1                      inc rcx
 16318 00070CFE 48890C25[F83A0A00]          mov [pipe_capture_len], rcx
 16319 00070D06 C681[003B0A00]00            mov byte [pipe_capture_buf + rcx], 0
 16320                                  .cap_done:
 16321 00070D0D 5F                          pop rdi
 16322 00070D0E 5A                          pop rdx
 16323 00070D0F 59                          pop rcx
 16324 00070D10 5B                          pop rbx
