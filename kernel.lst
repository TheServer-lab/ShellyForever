 15337                                  ; ============================================================
 15338                                  ;  PS/2 KEYBOARD
 15339                                  ; ============================================================
 15340                                  
 15341                                  ; get_char: blocks until a key is pressed, returns ascii in al.
 15342                                  ; Also handles: Ctrl tracking (make/break of 0x1D, plain or E0-prefixed),
 15343                                  ; E0-prefixed arrow/Home/End/Delete keys (Up=0x48, Down=0x50, Left=0x4B,
 15344                                  ; Right=0x4D, Home=0x47, End=0x4F, Delete=0x53), and Ctrl+Up/Ctrl+Down (or,
 15345                                  ; while edit_active is set, plain Up/Down with no Ctrl needed) driving the
 15346                                  ; on-screen scrollback view. Plain Up/Down (no Ctrl, edit_active clear),
 15347                                  ; Left, Right, Home, End, and Delete are all returned to the caller as
 15348                                  ; sentinel bytes (KEY_UP/KEY_DOWN/KEY_LEFT/KEY_RIGHT/KEY_HOME/KEY_END/
 15349                                  ; KEY_DELETE) instead of an ascii char, so read_line can use them for
 15350                                  ; history and in-line cursor movement/editing. Right before returning any
 15351                                  ; real key (ascii or sentinel) to the caller, if the view is currently
 15352                                  ; scrolled back it snaps back to the live screen first - typing or
 15353                                  ; navigating history always means "I'm done reviewing, back to the prompt".
 15354                                  get_char:
 15355 0002CCC1 53                          push rbx
 15356                                  .wait:
 15357 0002CCC2 E464                        in al, 0x64
 15358 0002CCC4 A801                        test al, 1
 15359 0002CCC6 74FA                        jz .wait
 15360 0002CCC8 A820                        test al, 0x20                  ; aux (mouse) byte waiting?
 15361 0002CCCA 7413                        jz .kbd_byte
 15362 0002CCCC E460                        in al, 0x60
 15363 0002CCCE 803C25[40AF0200]00          cmp byte [mouse_ena], 0
 15364 0002CCD6 74EA                        je .wait                       ; mouse off: just discard
 15365 0002CCD8 E871DCFFFF                  call mouse_byte
 15366 0002CCDD EBE3                        jmp .wait
 15367                                  .kbd_byte:
 15368 0002CCDF E460                        in al, 0x60
 15369 0002CCE1 88C3                        mov bl, al
 15370                                  
 15371 0002CCE3 803C25[CAD70200]00          cmp byte [kbd_ext_flag], 0
 15372 0002CCEB 0F842E010000                je .not_ext_cont
 15373                                      ; this byte follows an 0xE0 prefix byte
 15374 0002CCF1 C60425[CAD70200]00          mov byte [kbd_ext_flag], 0
 15375 0002CCF9 F6C380                      test bl, 0x80
 15376 0002CCFC 7579                        jnz .ext_break
 15377 0002CCFE 80FB48                      cmp bl, 0x48                 ; extended Up
 15378 0002CD01 0F8497000000                je .ext_up
 15379 0002CD07 80FB50                      cmp bl, 0x50                 ; extended Down
 15380 0002CD0A 0F84B6000000                je .ext_down
 15381 0002CD10 80FB4B                      cmp bl, 0x4B                 ; extended Left
 15382 0002CD13 0F84E3000000                je .ext_left
 15383 0002CD19 80FB4D                      cmp bl, 0x4D                 ; extended Right
 15384 0002CD1C 0F84E1000000                je .ext_right
 15385 0002CD22 80FB47                      cmp bl, 0x47                 ; extended Home
 15386 0002CD25 0F84DF000000                je .ext_home
 15387 0002CD2B 80FB4F                      cmp bl, 0x4F                 ; extended End
 15388 0002CD2E 0F84DD000000                je .ext_end
 15389 0002CD34 80FB53                      cmp bl, 0x53                 ; extended Delete
 15390 0002CD37 0F84DB000000                je .ext_delete
 15391 0002CD3D 80FB1D                      cmp bl, 0x1D                 ; right Ctrl make
 15392 0002CD40 7442                        je .ext_ctrl_make
 15393 0002CD42 80FB1C                      cmp bl, 0x1C                 ; keypad Enter
 15394 0002CD45 7414                        je .ext_kp_enter
 15395 0002CD47 80FB35                      cmp bl, 0x35                 ; keypad /
 15396 0002CD4A 7416                        je .ext_kp_slash
 15397 0002CD4C 80FB4A                      cmp bl, 0x4A                 ; keypad -
