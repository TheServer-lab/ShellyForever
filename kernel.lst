   374                                  
   375                                  ; ------------------------------------------------------------
   376                                  ; process_segment: called with a single ;-delimited command segment
   377                                  ; sitting null-terminated in line_buf (chain_is_rr says whether this
   378                                  ; came from process_chain or process_chain_rr, which changes how
   379                                  ; do_dispatch_call below wraps dispatch). Looks for a "~" outside
   380                                  ; double quotes:
   381                                  ;
   382                                  ;   left ~ right
   383                                  ;
   384                                  ; If none is found, this is exactly the original behaviour: tokenize
   385                                  ; line_buf and dispatch it.
   386                                  ;
   387                                  ; If one is found, "left" is run with its output captured instead of
   388                                  ; printed (e.g. calc's printed result, a variable's show'd value, a
   389                                  ; file's view'd content). "right" is then either:
   390                                  ;   - "= name" or "=name"  -> the captured text is parsed as a decimal
   391                                  ;     integer and stored into that variable (same rules as ordinary
   392                                  ;     "name = value" assignment).
   393                                  ;   - any other command    -> the captured text is appended to it as
   394                                  ;     one extra quoted argument and the whole thing is dispatched, e.g.
   395                                  ;     "calc 2+2 ~ show" becomes "show 4".
   396                                  ;
   397                                  ; Example: calc 1 + 1 * 5 ~ = a ; show a   -->  prints 6
   398                                  process_segment:
   399 0000025F 53                          push rbx
   400 00000260 4154                        push r12
   401 00000262 4156                        push r14
   402                                  
   403                                      ; --- scan line_buf for '~' outside double quotes ---
   404 00000264 48BE-                       mov rsi, line_buf
   404 00000266 [E0B8010000000000] 
   405 0000026E 4D31F6                      xor r14, r14              ; r14b = quote state (0=outside, 1=inside)
   406 00000271 4D31E4                      xor r12, r12               ; r12 = pointer to '~' (0 = none found)
   407                                  .pseg_scan:
   408 00000274 8A06                        mov al, [rsi]
   409 00000276 84C0                        test al, al
   410 00000278 7419                        jz .pseg_scan_done
   411 0000027A 3C22                        cmp al, '"'
   412 0000027C 7409                        je .pseg_toggle
   413 0000027E 3C7E                        cmp al, '~'
   414 00000280 740E                        je .pseg_found
   415 00000282 48FFC6                      inc rsi
   416 00000285 EBED                        jmp .pseg_scan
   417                                  .pseg_toggle:
   418 00000287 4180F601                    xor r14b, 1
   419 0000028B 48FFC6                      inc rsi
   420 0000028E EBE4                        jmp .pseg_scan
   421                                  .pseg_found:
   422 00000290 4989F4                      mov r12, rsi
   423                                  .pseg_scan_done:
   424                                  
   425 00000293 4D85E4                      test r12, r12
   426 00000296 0F845D020000                jz .pseg_plain
   427                                  
   428                                      ; ---------- "~" pipe path ----------
   429                                      ; copy the left half [line_buf .. r12) into pipe_left_buf
   430 0000029C 48BE-                       mov rsi, line_buf
   430 0000029E [E0B8010000000000] 
   431 000002A6 48BF-                       mov rdi, pipe_left_buf
   431 000002A8 [F9BB010000000000] 
   432                                  .pseg_copyleft:
   433 000002B0 4C39E6                      cmp rsi, r12
   434 000002B3 740C                        je .pseg_copyleft_done
   435 000002B5 8A06                        mov al, [rsi]
   436 000002B7 8807                        mov [rdi], al
   437 000002B9 48FFC6                      inc rsi
   438 000002BC 48FFC7                      inc rdi
