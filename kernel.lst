  7502                                  ; aliases_persist: serializes every currently-defined alias as a plain
  7503                                  ; text "ali <name> <commands>" line (the exact syntax that defines it -
  7504                                  ; so the file doubles as a script alias_load can just re-parse) into
  7505                                  ; /home/sys/alias.sly, creating the file if it doesn't exist yet.
  7506                                  ; Writing to a node only updates the in-memory filesystem tree; the
  7507                                  ; actual disk write still goes through maybe_auto_sync/fs_save like
  7508                                  ; everything else, so this respects the 'autosync off' setting too.
  7509                                  aliases_persist:
