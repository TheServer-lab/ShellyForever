 13345 00014769 415A                        pop r10
 13346 0001476B 4159                        pop r9
 13347 0001476D 4158                        pop r8
 13348 0001476F 5F                          pop rdi
 13349 00014770 5E                          pop rsi
 13350 00014771 5A                          pop rdx
 13351 00014772 59                          pop rcx
 13352 00014773 5B                          pop rbx
 13353 00014774 58                          pop rax
