  1673                              <1> ; party_bg_suspend: cooperative yield. Called from party_exec_stmts at a
  1674                              <1> ; statement boundary when the background quantum is exhausted (see the
  1675                              <1> ; party_bg_active / party_bg_quantum check at the top of the statement
  1676                              <1> ; loop). Parks the interpreter state (globals + r13/r14/r15) into the
  1677                              <1> ; current process's ctx area, saves the private-stack pointer (its top
  1678                              <1> ; word is the resume address - the instruction right after this call) into
  1679                              <1> ; proc_bg_rsp[slot], then switches back to the scheduler's stack and
  1680                              <1> ; returns to bg_scheduler_tick. The next bg_step_proc restores the ctx,
  1681                              <1> ; sets rsp back to proc_bg_rsp[slot] and RETs, so execution continues
  1682                              <1> ; right after this call. Clobbers rax, rbx, rcx, rsi, rdi, r8-r15.
  1683                              <1> party_bg_suspend:
  1684 0002732A 480FB60425-         <1>     movzx rax, byte [bg_cur_slot]
  1684 0002732F [28890C00]          <1>
