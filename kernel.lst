   665 00038C1F 4C89EE              <1>     mov rsi, r13
   666 00038C22 410FB6CE            <1>     movzx ecx, r14b
   667 00038C26 F3A4                <1>     rep movsb
   668                              <1> 
   669 00038C28 88D8                <1>     mov al, bl
   670 00038C2A 8807                <1>     mov [rdi], al
   671 00038C2C 48FFC7              <1>     inc rdi
   672                              <1> 
   673 00038C2F 85DB                <1>     test ebx, ebx
   674 00038C31 7408                <1>     jz .hel_noctx
   675 00038C33 4C89FE              <1>     mov rsi, r15
   676 00038C36 0FB6CB              <1>     movzx ecx, bl
   677 00038C39 F3A4                <1>     rep movsb
   678                              <1> .hel_noctx:
   679                              <1> 
   680 00038C3B 488D0425[28F10300]  <1>     lea rax, [hkdf_label_buf]
