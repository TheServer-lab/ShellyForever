 14850                                  ; ============================================================
 14851                                  ;  VARIABLES  (simple name -> int64 table used by assignment/show/calc)
 14852                                  ; ============================================================
 14853                                  
 14854                                  ; str_len: rsi=string -> rax=length (not including null terminator)
 14855                                  str_len:
 14856 0000BA88 56                          push rsi
 14857 0000BA89 4831C0                      xor rax, rax
 14858                                  .sl_loop:
 14859 0000BA8C 803E00                      cmp byte [rsi], 0
