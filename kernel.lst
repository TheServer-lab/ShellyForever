  6833 00006400 48890425[3E890C00]          mov [bg_capture_start_ptr], rax
  6834 00006408 488D0C25[8C5A0A00]          lea rcx, [proc_bg_ring_len]
  6835 00006410 488D0499                    lea rax, [rcx + rbx*4]
