  8122                                  ; fs_create_node: rax=parent_idx, rsi=name, r10=type
  8123                                  ; returns rax = new index or -1 if full
  8124                                  fs_create_node:
  8125 00017287 53                          push rbx
  8126 00017288 51                          push rcx
  8127 00017289 52                          push rdx
