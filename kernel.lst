  3359                              <1> ; party_str_has_lbrace: rsi = ptr, rcx = len -> al = 1 if the slice
  3360                              <1> ; contains a '{' byte, else al = 0. Cheap pre-check so a plain
  3361                              <1> ; literal (the overwhelming common case) skips interpolation
  3362                              <1> ; entirely and keeps pointing straight into the source buffer,
  3363                              <1> ; exactly as before this phase - only literals that opt in via '{'
  3364                              <1> ; pay the party_eval_string_literal cost.
  3365                              <1> ; Clobbers rax, rcx, rsi.
  3366                              <1> party_str_has_lbrace:
  3367                              <1> .phl_loop:
  3368 000286E8 4883F900            <1>     cmp rcx, 0
  3369 000286EC 7411                <1>     je .phl_no
  3370 000286EE 8A06                <1>     mov al, [rsi]
  3371 000286F0 3C7B                <1>     cmp al, '{'
  3372 000286F2 7408                <1>     je .phl_yes
  3373 000286F4 48FFC6              <1>     inc rsi
