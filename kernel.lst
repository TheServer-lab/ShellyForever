  1868 00039B27 8A040B              <1>     mov al, [rbx+rcx]
  1869 00039B2A 88440C30            <1>     mov [rsp+48+rcx], al
  1870 00039B2E 48FFC1              <1>     inc rcx
  1871 00039B31 EBEF                <1>     jmp .cpblock
  1872                              <1> .cpdone:
  1873 00039B33 C6440C3001          <1>     mov byte [rsp+48+rcx], 1    ; append the 0x01 byte at offset L
  1874                              <1> 
  1875                              <1>     ; A(scratch at rsp+72..95, reuse as "acc+n") = acc + n
  1876 00039B38 488B442418          <1>     mov rax, [rsp+24]
  1877 00039B3D 4803442430          <1>     add rax, [rsp+48]
  1878 00039B42 4889442448          <1>     mov [rsp+72], rax
  1879 00039B47 488B442420          <1>     mov rax, [rsp+32]
  1880 00039B4C 4813442438          <1>     adc rax, [rsp+56]
  1881 00039B51 4889442450          <1>     mov [rsp+80], rax
  1882 00039B56 488B442428          <1>     mov rax, [rsp+40]
  1883 00039B5B 4813442440          <1>     adc rax, [rsp+64]
  1884 00039B60 4889442458          <1>     mov [rsp+88], rax
  1885                              <1> 
  1886                              <1>     ; reduce (acc+n) mod p once (it's < 2p, so a single conditional
  1887                              <1>     ; subtract suffices). poly_sub_p_cond clobbers rax/rbx/rcx and rbx
  1888                              <1>     ; is our live msg pointer here, so protect it.
  1889 00039B65 53                  <1>     push rbx
  1890 00039B66 4C8D742450          <1>     lea r14, [rsp+8+72]
  1891 00039B6B E8F1FDFFFF          <1>     call poly_sub_p_cond
  1892 00039B70 5B                  <1>     pop rbx
  1893                              <1> 
  1894                              <1>     ; acc = (acc+n) * r mod p -- point acc ptr at the (acc+n) scratch
  1895                              <1>     ; instead of the real acc slot, then copy the result back after.
