 10401                                  ; pci_find_rtl8168: brute-force scan of PCI bus 0, vendor 0x10EC, matching
 10402                                  ; any device id in rtl_dev_ids. Returns CF=0 and nic_pci_bus/dev/func set,
 10403                                  ; or CF=1.
 10404                                  ; pci_find_rtl8168: brute-force scan of every PCI bus (0..255), every
 10405                                  ; device, function 0 first and then functions 1..7 if multi-function,
 10406                                  ; vendor 0x10EC, matching any device id in rtl_dev_ids. A bus-0-only scan
 10407                                  ; misses real hardware, where the NIC usually sits behind a PCIe root port
 10408                                  ; on a non-zero bus - see pci_find_nic above for the same fix. Returns
 10409                                  ; CF=0 and nic_pci_bus/dev/func set, or CF=1.
 10410                                  pci_find_rtl8168:
 10411 000187B5 50                          push rax
 10412 000187B6 53                          push rbx
 10413 000187B7 51                          push rcx
 10414 000187B8 52                          push rdx
 10415 000187B9 4150                        push r8
 10416 000187BB 4151                        push r9
 10417 000187BD 4152                        push r10
 10418 000187BF 4153                        push r11
 10419 000187C1 31DB                        xor ebx, ebx                     ; bus
 10420                                  .rbus_loop:
 10421 000187C3 81FB00010000                cmp ebx, 256
 10422 000187C9 0F83B1000000                jae .rnot_found
 10423 000187CF 31C9                        xor ecx, ecx                     ; device
 10424                                  .rdev_loop:
 10425 000187D1 83F920                      cmp ecx, 32
 10426 000187D4 0F839F000000                jae .rnext_bus
 10427 000187DA 31D2                        xor edx, edx                     ; try function 0 first
 10428 000187DC 4D31C0                      xor r8, r8
 10429 000187DF E860F3FFFF                  call pci_read32
 10430 000187E4 83F8FF                      cmp eax, 0xFFFFFFFF
 10431 000187E7 0F8485000000                je .rnext_dev                    ; nothing at this slot at all
 10432 000187ED 663DEC10                    cmp ax, RTL_VENDOR_ID
 10433 000187F1 7524                        jne .rf0_no_match
 10434 000187F3 C1E810                      shr eax, 16                     ; eax = device id
 10435 000187F6 4C8D0C25[90A40600]          lea r9, [rtl_dev_ids]
 10436 000187FE 41BA04000000                mov r10d, RTL_DEV_ID_COUNT
 10437                                  .rcmp_loop0:
 10438 00018804 66413901                    cmp word [r9], ax
 10439 00018808 0F8480000000                je .rfound
 10440 0001880E 4983C102                    add r9, 2
 10441 00018812 41FFCA                      dec r10d
 10442 00018815 75ED                        jnz .rcmp_loop0
 10443                                  .rf0_no_match:
 10444 00018817 31D2                        xor edx, edx
 10445 00018819 41B80C000000                mov r8, 0x0C                     ; header-type dword
 10446 0001881F E820F3FFFF                  call pci_read32
 10447 00018824 C1E810                      shr eax, 16
 10448 00018827 A880                        test al, 0x80                    ; multi-function bit
 10449 00018829 7447                        jz .rnext_dev                    ; single-function: nothing more here
 10450 0001882B 41BB01000000                mov r11d, 1
 10451                                  .rfunc_loop:
 10452 00018831 4183FB08                    cmp r11d, 8
 10453 00018835 733B                        jae .rnext_dev
 10454 00018837 4489DA                      mov edx, r11d
 10455 0001883A 4D31C0                      xor r8, r8
 10456 0001883D E802F3FFFF                  call pci_read32
 10457 00018842 83F8FF                      cmp eax, 0xFFFFFFFF
