 16563                                  ; ------------------------------------------------------------
 16564                                  ; kernel_api_table slot layout (each slot = 8 bytes, offset shown
 16565                                  ; is the byte offset used by "call [r11+offset]" from compiled .run
 16566                                  ; code). Slots 0x00-0x20 are the original v0.1 ABI (print/read/kill);
 16567                                  ; 0x28 onward were added for the "party compile" native-codegen
 16568                                  ; backend (see party.asm: party_compile_to_run) so compiled programs
 16569                                  ; can call the SAME tested interpreter primitives (value stack,
 16570                                  ; operators, variable table, function invocation) instead of each
 16571                                  ; compiled program re-implementing them. One slot (0x18) holds a DATA
 16572                                  ; pointer - everything else is a function pointer. 0xE0 (KAPI_BOOT)
 16573                                  ; is the compiled-program runtime bootstrap: a compiled binary's
 16574                                  ; whole entry sequence is LEA RSI,embedded-source ; CALL [KAPI_BOOT]
 16575                                  ; ; RET - party_boot_compiled does the lex + interpreted run.
 16576                                  ; ------------------------------------------------------------
 16577                                  KAPI_PRINT_STRING       equ 0x00
 16578                                  KAPI_PRINT_STRING_ATTR  equ 0x08
 16579                                  KAPI_GET_CHAR           equ 0x10
 16580                                  KAPI_NEWLINE_STR        equ 0x18   ; data: pointer to newline_str
 16581                                  KAPI_POLL_KILL          equ 0x20
 16582                                  KAPI_PUSH_VAL           equ 0x28
 16583                                  KAPI_POP_VAL            equ 0x30
 16584                                  KAPI_VAL_SET_INT        equ 0x38
 16585                                  KAPI_VAL_SET_STR        equ 0x40
 16586                                  KAPI_VAL_SET_BOOL_TRUE  equ 0x48
 16587                                  KAPI_VAL_SET_BOOL_FALSE equ 0x50
 16588                                  KAPI_VAL_SET_NONE       equ 0x58
 16589                                  KAPI_OP_BIN             equ 0x60
 16590                                  KAPI_OP_EQ              equ 0x68
 16591                                  KAPI_OP_NEQ             equ 0x70
 16592                                  KAPI_OP_REL             equ 0x78
 16593                                  KAPI_TRUTHY             equ 0x80
 16594                                  KAPI_PRINT_VALUE        equ 0x88
 16595                                  KAPI_VAR_DECLARE        equ 0x90
 16596                                  KAPI_VAR_ASSIGN         equ 0x98
 16597                                  KAPI_VAR_GET_PTR        equ 0xA0
 16598                                  KAPI_VAL_COPY           equ 0xA8
 16599                                  KAPI_INVOKE_FUNC        equ 0xB0
 16600                                  KAPI_FUNC_FIND          equ 0xB8
 16601                                  KAPI_NEG_TOP            equ 0xC0
 16602                                  KAPI_LEX                equ 0xC8
 16603                                  KAPI_COLLECT_FUNCS      equ 0xD0
 16604                                  KAPI_VAL_SET_FLOAT      equ 0xD8
 16605                                  KAPI_BOOT               equ 0xE0   ; compiled-program runtime bootstrap
 16606                                  KAPI_TABLE_SIZE         equ 0xF0   ; total bytes
 16607                                  
