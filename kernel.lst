   471 00038A2E 4C89F9              <1>     mov rcx, r15
   472 00038A31 E8BDFDFFFF          <1>     call sha256_update
   473 00038A36 488D3C25[B0ED0300]  <1>     lea rdi, [hmac_scratch_ctx]
