  6862 00016237 4989F5                      mov r13, rsi                    ; N
  6863 0001623A 428B04A5[4C090700]          mov eax, [proc_bg_ring_len + r12*4]
  6864 00016242 428B0CA5[44090700]          mov ecx, [proc_bg_ring_start + r12*4]
  6865 0001624A 4989C7                      mov r15, rax                    ; byte count
  6866 0001624D 4983FF00                    cmp r15, 0
  6867 00016251 0F84C7000000                je .ppr_done
  6868 00016257 4981FF00100000              cmp r15, BG_RING_CAP
  6869 0001625E 7606                        jbe .ppr_have_len
  6870 00016260 41BF00100000                mov r15, BG_RING_CAP
  6871                                  .ppr_have_len:
  6872 00016266 4C89E0                      mov rax, r12
  6873 00016269 4869C000100000              imul rax, BG_RING_CAP
  6874 00016270 4C8DB0[54090700]            lea r14, [proc_bg_ring + rax]   ; ring base
  6875 00016277 488D3C25[2F880800]          lea rdi, [prs_peek_buf]
  6876 0001627F 4D31C0                      xor r8, r8                      ; copied count
  6877                                  .ppr_cp_loop:
  6878 00016282 4D39F8                      cmp r8, r15
  6879 00016285 731F                        jae .ppr_cp_done
  6880 00016287 498D340E                    lea rsi, [r14 + rcx]
  6881 0001628B 8A06                        mov al, [rsi]
  6882 0001628D 8807                        mov [rdi], al
  6883 0001628F 48FFC7                      inc rdi
  6884 00016292 49FFC0                      inc r8
  6885 00016295 48FFC1                      inc rcx
  6886 00016298 4881F900100000              cmp rcx, BG_RING_CAP
  6887 0001629F 72E1                        jb .ppr_cp_loop
  6888 000162A1 4831C9                      xor rcx, rcx
