  8930 00017A63 EE                          out dx, al
  8931 00017A64 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8932 00017A6C 6683C203                    add dx, 3
  8933 00017A70 88D8                        mov al, bl
  8934 00017A72 EE                          out dx, al
  8935 00017A73 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8936 00017A7B 6683C204                    add dx, 4
  8937 00017A7F 4889D8                      mov rax, rbx
  8938 00017A82 48C1E808                    shr rax, 8
  8939 00017A86 EE                          out dx, al
  8940 00017A87 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8941 00017A8F 6683C205                    add dx, 5
  8942 00017A93 4889D8                      mov rax, rbx
  8943 00017A96 48C1E810                    shr rax, 16
  8944 00017A9A EE                          out dx, al
  8945 00017A9B 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8946 00017AA3 6683C207                    add dx, 7
  8947 00017AA7 B030                        mov al, 0x30                 ; WRITE SECTORS (with retry)
  8948 00017AA9 EE                          out dx, al
  8949 00017AAA E840FEFFFF                  call ata_wait_bsy
