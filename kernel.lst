   324 000001FC E8C1480000                  call kbd_poll
   325 00000201 803C25[37A50300]00          cmp byte [kill_flag], 0
   326 00000209 7574                        jne .rr_chain_killed
   327                                  
   328 0000020B 418A4500                    mov al, [r13]
   329 0000020F 84C0                        test al, al
   330 00000211 744B                        jz .rr_chain_done         ; end of string, process last segment
   331                                  
   332 00000213 3C22                        cmp al, '"'
   333 00000215 7409                        je .rr_toggle_quotes
   334                                  
   335 00000217 3C3B                        cmp al, ';'
   336 00000219 740E                        je .rr_chain_break
   337                                  
   338 0000021B 49FFC5                      inc r13
   339 0000021E EBDC                        jmp .rr_chain_scan
   340                                  
