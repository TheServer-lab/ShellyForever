 14789                                  %include "browse.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  browse.asm  --  Text-based web browser (Milestone E)
     3                              <1> ;  Command: browse <url>
     4                              <1> ;
     5                              <1> ;  A Lynx-style plain-text browser:
     6                              <1> ;    - HTTP page downloads (built on the Milestone D http/tcp stack)
     7                              <1> ;    - HTML stripped to readable text, <a href> links collected
     8                              <1> ;    - Hyperlink selection by number ([N] markers in the text)
     9                              <1> ;    - Back / Forward navigation
    10                              <1> ;    - Bookmarks (session only)
    11                              <1> ;    - "t" saves the current page's raw body to a file (take-style)
    12                              <1> ;
    13                              <1> ;  The stripped page text lives in tcp_rx_buf (in-place compacted from
    14                              <1> ;  the raw body, which is staged in http_rx_buf). See browse_fetch_url.
    15                              <1> ;
    16                              <1> ;  Included from kernel.asm; inherits BITS 64.
    17                              <1> ; ============================================================
    18                              <1> 
    19                              <1> BROWSE_LINKS_MAX equ 64
    20                              <1> BROWSE_LINK_BUF  equ 128          ; bytes per stored URL (links, history, bookmarks)
    21                              <1> BROWSE_HIST_MAX  equ 16
    22                              <1> BROWSE_BMK_MAX   equ 16
    23                              <1> BROWSE_PAGE_MAX  equ TCP_PAYLOAD_MAX   ; page text = tcp_rx_buf (1536 bytes)
    24                              <1> BROWSE_VROWS     equ 23               ; visible page rows on screen (80x25)
    25                              <1> 
    26                              <1> ATTR_BRW_HEADER equ 0x1F          ; white on blue
    27                              <1> ATTR_BRW_STATUS equ 0x1E          ; yellow on blue
    28                              <1> ATTR_BRW_LINK   equ 0x0E          ; yellow
    29                              <1> 
    30                              <1> ; ============================================================
    31                              <1> ;  browse_emit: al = char -> writes to [rdi] (output ptr), advances rdi.
    32                              <1> ;  out: CF=1 if output buffer full (char NOT written).
    33                              <1> browse_emit:
    34 0002573F 4C39F7              <1>     cmp rdi, r14
    35 00025742 7307                <1>     jae .emit_full
    36 00025744 8807                <1>     mov [rdi], al
    37 00025746 48FFC7              <1>     inc rdi
    38 00025749 F8                  <1>     clc
    39 0002574A C3                  <1>     ret
    40                              <1> .emit_full:
    41 0002574B F9                  <1>     stc
    42 0002574C C3                  <1>     ret
    43                              <1> 
    44                              <1> ; browse_cp_str: rsi = NUL-terminated src -> copies to rdi (advances rdi
    45                              <1> ; past the terminating NUL).
    46                              <1> browse_cp_str:
    47 0002574D 8A06                <1>     mov al, [rsi]
    48 0002574F 8807                <1>     mov [rdi], al
    49 00025751 48FFC7              <1>     inc rdi
    50 00025754 48FFC6              <1>     inc rsi
    51 00025757 84C0                <1>     test al, al
    52 00025759 75F2                <1>     jnz browse_cp_str
    53 0002575B C3                  <1>     ret
    54                              <1> 
    55                              <1> ; browse_cp_str_max: rsi = src, rdi = dst, rcx = max bytes (incl NUL).
    56                              <1> ; Copies at most rcx-1 chars plus a NUL. rdi advances.
    57                              <1> browse_cp_str_max:
