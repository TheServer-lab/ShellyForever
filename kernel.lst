 14683 0000B8E0 C3                          ret
 14684                                  
 14685                                  ; fs_save: writes the OS volume ([boot_device], nodes 0..OS_NODES) then
 14686                                  ; every mounted volume back to its own device. Returns CF=0 on success,
 14687                                  ; CF=1 if the OS volume's disk isn't there/isn't responding. A mounted
 14688                                  ; volume that fails to write is left mounted (best effort; sync still
 14689                                  ; reports success).
 14690                                  fs_save:
 14691 0000B8E1 50                          push rax
 14692 0000B8E2 53                          push rbx
 14693 0000B8E3 56                          push rsi
 14694 0000B8E4 57                          push rdi
 14695 0000B8E5 4155                        push r13
 14696 0000B8E7 4156                        push r14
 14697 0000B8E9 4530F6                      xor r14b, r14b                ; r14b = 1 once anything has actually been saved
 14698 0000B8EC 803C25[E1C90800]00          cmp byte [fs_disk_available], 0
 14699 0000B8F4 741D                        je .skip_os_volume            ; no OS disk responded this session - don't retry
 14700                                                                     ; it, but still try any mounted AHCI volumes below
 14701                                      ; OS volume: [boot_device] (0 = legacy ATA boot drive, 4+ = an AHCI slot
 14702                                      ; fs_load fell back to), base 0, label = root node's name
 14703 0000B8F6 488D3425[E0F10700]          lea rsi, [node_name]
 14704 0000B8FE 4831FF                      xor rdi, rdi
 14705 0000B901 0FB60425[E2C90800]          movzx eax, byte [boot_device]
 14706 0000B909 E868D8FFFF                  call vol_write
 14707 0000B90E 7258                        jc .disk_gone
 14708 0000B910 41B601                      mov r14b, 1
 14709                                  .skip_os_volume:
 14710                                      ; mounted volumes
 14711 0000B913 4D31ED                      xor r13, r13
 14712                                  .mount_loop:
 14713 0000B916 4983FD02                    cmp r13, MAX_MOUNTS
 14714 0000B91A 733C                        jae .check_any
 14715 0000B91C 4180BD[DEE50700]00          cmp byte [mount_used + r13], 0
 14716 0000B924 742D                        je .mount_next
 14717 0000B926 490FB685[DCE50700]          movzx rax, byte [mount_device + r13]
 14718 0000B92E 4C89EF                      mov rdi, r13
 14719 0000B931 48FFC7                      inc rdi
 14720 0000B934 4869FF00010000              imul rdi, VOL_NODES
 14721 0000B93B 4C89EB                      mov rbx, r13
 14722 0000B93E 486BDB20                    imul rbx, 32
 14723 0000B942 488DB3[9CE50700]            lea rsi, [mount_label + rbx]
 14724 0000B949 E828D8FFFF                  call vol_write
 14725 0000B94E 7203                        jc .mount_next                ; a mounted volume failing to save is not fatal;
 14726 0000B950 41B601                      mov r14b, 1                   ; keep it mounted, just don't count it as saved
 14727                                  .mount_next:
 14728 0000B953 49FFC5                      inc r13
 14729 0000B956 EBBE                        jmp .mount_loop
 14730                                  .check_any:
 14731 0000B958 4180FE00                    cmp r14b, 0
 14732 0000B95C 7414                        je .fail                      ; nothing at all got saved - genuinely no disk
 14733 0000B95E 415E                        pop r14
 14734 0000B960 415D                        pop r13
 14735 0000B962 5F                          pop rdi
 14736 0000B963 5E                          pop rsi
 14737 0000B964 5B                          pop rbx
 14738 0000B965 58                          pop rax
 14739 0000B966 F8                          clc
 14740 0000B967 C3                          ret
 14741                                  .disk_gone:
 14742 0000B968 C60425[E1C90800]00          mov byte [fs_disk_available], 0
 14743 0000B970 EBA1                        jmp .skip_os_volume
 14744                                  .fail:
 14745 0000B972 415E                        pop r14
 14746 0000B974 415D                        pop r13
 14747 0000B976 5F                          pop rdi
 14748 0000B977 5E                          pop rsi
 14749 0000B978 5B                          pop rbx
 14750 0000B979 58                          pop rax
 14751 0000B97A F9                          stc
 14752 0000B97B C3                          ret
 14753                                  
 14754                                  ; fs_load: reads the OS volume into nodes 0..OS_NODES. Tries device 0
 14755                                  ; (legacy ATA primary master) first, exactly as always. If that device
 14756                                  ; never responds at all - common on real hardware that has no PATA/IDE
 14757                                  ; controller and only exposes its disk(s) over SATA - it then looks
 14758                                  ; through whatever AHCI port slots (4..4+ahci_port_count-1) ahci_init
 14759                                  ; found at boot, preferring one that already holds a valid SFFS volume,
 14760                                  ; falling back to the first one that simply responds (a blank/new SATA
 14761                                  ; SSD) so a fresh filesystem still has somewhere to persist to. Whichever
 14762                                  ; device actually ends up holding the OS volume is remembered in
 14763                                  ; [boot_device] for fs_save (and cmd_format's "don't touch the boot
 14764                                  ; drive" check) to use afterwards. If nothing responds anywhere, falls
 14765                                  ; back to fs_init for a fresh in-memory-only filesystem.
 14766                                  ; Mounted volumes are never loaded here - you re-attach them after boot
 14767                                  ; with 'dscan' + 'mount'.
 14768                                  ; sets fs_loaded_from_disk, fs_disk_available and boot_device accordingly.
 14769                                  fs_load:
 14770 0000B97C 50                          push rax
 14771 0000B97D 53                          push rbx
 14772 0000B97E 51                          push rcx
 14773 0000B97F 57                          push rdi
 14774 0000B980 56                          push rsi
 14775 0000B981 C60425[E2C90800]00          mov byte [boot_device], 0
 14776 0000B989 30C0                        xor al, al                  ; device 0 (boot drive) - legacy ATA, tried first
 14777 0000B98B 4831FF                      xor rdi, rdi                ; base 0 = OS volume
 14778 0000B98E E8E1D5FFFF                  call vol_read
 14779 0000B993 4883F8FF                    cmp rax, -1
 14780 0000B997 0F85D1000000                jne .loaded
 14781                                      ; device 0 gave us nothing. If it's present but just not SFFS (blank
 14782                                      ; disk, older format, ...) keep it as the boot device exactly like
 14783                                      ; before - only chase AHCI slots when device 0 wasn't there at all.
 14784 0000B99D 803C25[E1C90800]00          cmp byte [fs_disk_available], 0
 14785 0000B9A5 7412                        je .try_ahci
 14786 0000B9A7 E844C2FFFF                  call fs_init
 14787 0000B9AC C60425[E0C90800]00          mov byte [fs_loaded_from_disk], 0
 14788 0000B9B4 E9C9000000                  jmp .done
 14789                                  .try_ahci:
 14790 0000B9B9 0FB60C25[00CA0800]          movzx ecx, byte [ahci_port_count]
 14791 0000B9C1 85C9                        test ecx, ecx
 14792 0000B9C3 0F8486000000                jz .no_disk                 ; no AHCI controller/ports either - genuinely nothing
 14793                                      ; pass 1: any AHCI slot that already has a valid SFFS volume on it
 14794 0000B9C9 31DB                        xor ebx, ebx
 14795                                  .ahci_sffs_scan:
 14796 0000B9CB 39CB                        cmp ebx, ecx
 14797 0000B9CD 731D                        jae .ahci_blank_scan
 14798 0000B9CF 678D4304                    lea eax, [ebx + 4]           ; device id 4+slot
 14799 0000B9D3 880425[E2C90800]            mov byte [boot_device], al
 14800 0000B9DA 4831FF                      xor rdi, rdi
 14801 0000B9DD E892D5FFFF                  call vol_read
 14802 0000B9E2 4883F8FF                    cmp rax, -1
 14803 0000B9E6 7549                        jne .ahci_found
 14804 0000B9E8 FFC3                        inc ebx
 14805 0000B9EA EBDF                        jmp .ahci_sffs_scan
 14806                                      ; pass 2: no AHCI slot had a ready SFFS volume yet - use the first one
 14807                                      ; that at least responds (freshly flashed/blank SATA SSD) as the boot
 14808                                      ; device, so a fresh in-memory filesystem has somewhere to save to.
 14809                                  .ahci_blank_scan:
 14810 0000B9EC 31DB                        xor ebx, ebx
 14811                                  .ahci_blank_loop:
 14812 0000B9EE 39CB                        cmp ebx, ecx
 14813 0000B9F0 735D                        jae .no_disk
 14814 0000B9F2 678D4304                    lea eax, [ebx + 4]
 14815 0000B9F6 880425[E2C90800]            mov byte [boot_device], al
 14816 0000B9FD E852D0FFFF                  call disk_select_device
 14817 0000BA02 B8D9090000                  mov rax, SUPER_LBA
 14818 0000BA07 488D3C25[18E10700]          lea rdi, [fs_super_buf]
 14819 0000BA0F E867D0FFFF                  call disk_read_sector
 14820 0000BA14 7304                        jnc .ahci_blank_present
 14821 0000BA16 FFC3                        inc ebx
 14822 0000BA18 EBD4                        jmp .ahci_blank_loop
 14823                                  .ahci_blank_present:
 14824 0000BA1A C60425[E1C90800]01          mov byte [fs_disk_available], 1
 14825 0000BA22 E8C9C1FFFF                  call fs_init
 14826 0000BA27 C60425[E0C90800]00          mov byte [fs_loaded_from_disk], 0
 14827 0000BA2F EB51                        jmp .done
 14828                                  .ahci_found:
 14829 0000BA31 C60425[E1C90800]01          mov byte [fs_disk_available], 1
 14830 0000BA39 48C70425[1B1A0700]-         mov qword [cur_dir], 0
 14830 0000BA41 00000000           
 14831 0000BA45 C60425[E0C90800]01          mov byte [fs_loaded_from_disk], 1
 14832 0000BA4D EB33                        jmp .done
 14833                                  .no_disk:
 14834 0000BA4F C60425[E1C90800]00          mov byte [fs_disk_available], 0
 14835 0000BA57 C60425[E2C90800]00          mov byte [boot_device], 0
 14836 0000BA5F E88CC1FFFF                  call fs_init
 14837 0000BA64 C60425[E0C90800]00          mov byte [fs_loaded_from_disk], 0
 14838 0000BA6C EB14                        jmp .done
 14839                                  .loaded:
 14840 0000BA6E 48C70425[1B1A0700]-         mov qword [cur_dir], 0
 14840 0000BA76 00000000           
 14841 0000BA7A C60425[E0C90800]01          mov byte [fs_loaded_from_disk], 1
 14842                                  .done:
 14843 0000BA82 5E                          pop rsi
 14844 0000BA83 5F                          pop rdi
 14845 0000BA84 59                          pop rcx
 14846 0000BA85 5B                          pop rbx
 14847 0000BA86 58                          pop rax
 14848 0000BA87 C3                          ret
