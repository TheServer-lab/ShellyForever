  1279                                  
  1280 000049F3 66BAD403                    mov dx, 0x3D4
  1281 000049F7 B00E                        mov al, 0x0E                  ; select "cursor location high" register
  1282 000049F9 EE                          out dx, al
  1283 000049FA 66BAD503                    mov dx, 0x3D5
  1284 000049FE 88F8                        mov al, bh                    ; high byte of position
  1285 00004A00 EE                          out dx, al
  1286                                  
  1287 00004A01 66BAD403                    mov dx, 0x3D4
  1288 00004A05 B00F                        mov al, 0x0F                  ; select "cursor location low" register
  1289 00004A07 EE                          out dx, al
  1290 00004A08 66BAD503                    mov dx, 0x3D5
  1291 00004A0C 88D8                        mov al, bl                    ; low byte of position
  1292 00004A0E EE                          out dx, al
