 12602                                  %include "mouse.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  PS/2 MOUSE  (polled - no IRQs, matching the keyboard)
     3                              <1> ; ============================================================
     4                              <1> ; The kernel is fully polled: the keyboard reads ports 0x64/0x60
     5                              <1> ; directly. The PS/2 mouse shares those same two ports, so this
     6                              <1> ; driver is polled too. The 8042 status register (port 0x64) bit
     7                              <1> ; 5 (0x20) tells us when the byte waiting in port 0x60 came from
     8                              <1> ; the auxiliary (mouse) device, which is exactly how get_char and
     9                              <1> ; kbd_poll keep mouse bytes out of the keyboard scancode parser.
    10                              <1> ;
    11                              <1> ;   mouse            toggles the mouse cursor on/off
    12                              <1> ;
    13                              <1> ; The cursor is a text-mode overlay: the cell under the pointer is
    14                              <1> ; saved, the cell is redrawn reverse-video, and every routine that
    15                              <1> ; mutates the screen re-applies the cursor afterwards (putchar,
    16                              <1> ; scroll_screen, clear_screen, scrollback_render, browse_render),
    17                              <1> ; so the pointer stays on top of scrolling text and full-screen
    18                              <1> ; redraws without ever baking a stale copy of the cursor into the
    19                              <1> ; screen buffer.
    20                              <1> 
    21                              <1> MOUSE_SCALE     equ 8           ; raw mickey counts per text cell (tune feel)
    22                              <1> MOUSE_CLAMP_X   equ VGA_COLS-1
    23                              <1> MOUSE_CLAMP_Y   equ VGA_ROWS-1
    24                              <1> MOUSE_BLOCK     equ 0x0FDB      ; char 0xDB, attr 0x0F: solid bright-white block
    25                              <1> MOUSE_WHEEL_STEP equ 1          ; Z clicks accumulated before one scroll step
    26                              <1> 
    27                              <1> ; ------------------------------------------------------------
    28                              <1> ;  PS/2 helpers
    29                              <1> ; ------------------------------------------------------------
    30                              <1> ; ps2_wait_ibf: block until the controller's input buffer is empty
    31                              <1> ; (bit 1 of status clear), i.e. it is safe to write 0x64/0x60.
    32                              <1> ps2_wait_ibf:
    33 00012009 50                  <1>     push rax
    34 0001200A E464                <1>     in al, 0x64
    35 0001200C A802                <1>     test al, 2
    36 0001200E 75F9                <1>     jnz ps2_wait_ibf
    37 00012010 58                  <1>     pop rax
    38 00012011 C3                  <1>     ret
    39                              <1> 
    40                              <1> ; ps2_wait_obf: block until the controller's output buffer is full
    41                              <1> ; (bit 0 of status set), i.e. a byte is waiting in port 0x60.
    42                              <1> ps2_wait_obf:
    43 00012012 50                  <1>     push rax
    44 00012013 E464                <1>     in al, 0x64
    45 00012015 A801                <1>     test al, 1
    46 00012017 74F9                <1>     jz ps2_wait_obf
    47 00012019 58                  <1>     pop rax
    48 0001201A C3                  <1>     ret
    49                              <1> 
    50                              <1> ; mouse_send_cmd: al = command byte for the mouse. Writes it via the
    51                              <1> ; 0xD4 "write to auxiliary device" prefix and waits for the 0xFA ACK.
    52                              <1> ; Returns CF=0 on ACK, CF=1 on timeout/no ACK (no mouse attached).
    53                              <1> mouse_send_cmd:
    54 0001201B 51                  <1>     push rcx
    55 0001201C 52                  <1>     push rdx
    56 0001201D 50                  <1>     push rax
    57 0001201E 88C1                <1>     mov cl, al                   ; command byte
    58 00012020 E8E4FFFFFF          <1>     call ps2_wait_ibf
    59 00012025 B0D4                <1>     mov al, 0xD4                 ; write-to-aux prefix
    60 00012027 E664                <1>     out 0x64, al
    61 00012029 E8DBFFFFFF          <1>     call ps2_wait_ibf
    62 0001202E 88C8                <1>     mov al, cl
    63 00012030 E660                <1>     out 0x60, al
    64 00012032 B9FFFFFF00          <1>     mov rcx, 0xFFFFFF             ; ACK timeout (generous: some mice are slow)
    65                              <1> .ack:
    66 00012037 E464                <1>     in al, 0x64
    67 00012039 A801                <1>     test al, 1
    68 0001203B 7505                <1>     jnz .have_byte
    69 0001203D E2F8                <1>     loop .ack
    70 0001203F F9                  <1>     stc                          ; timed out - assume no mouse
    71 00012040 EB10                <1>     jmp .out
    72                              <1> .have_byte:
    73 00012042 E460                <1>     in al, 0x60
    74 00012044 3CFA                <1>     cmp al, 0xFA                 ; ACK
    75 00012046 7503                <1>     jne .bad
    76 00012048 F8                  <1>     clc
    77 00012049 EB07                <1>     jmp .out
    78                              <1> .bad:
    79 0001204B 3CFE                <1>     cmp al, 0xFE                 ; RESEND - retry once
    80 0001204D 7502                <1>     jne .timeout
    81 0001204F E2E6                <1>     loop .ack
    82                              <1> .timeout:
    83 00012051 F9                  <1>     stc
    84                              <1> .out:
    85 00012052 58                  <1>     pop rax
    86 00012053 5A                  <1>     pop rdx
    87 00012054 59                  <1>     pop rcx
    88 00012055 C3                  <1>     ret
    89                              <1> 
    90                              <1> ; ------------------------------------------------------------
    91                              <1> ;  mouse_init: put the PS/2 mouse into default stream mode with
    92                              <1> ;  data reporting enabled. Returns CF=0 on success, CF=1 on failure.
    93                              <1> mouse_init:
    94 00012056 50                  <1>     push rax
    95 00012057 E8ADFFFFFF          <1>     call ps2_wait_ibf
    96 0001205C B0A8                <1>     mov al, 0xA8                 ; enable auxiliary device
    97 0001205E E664                <1>     out 0x64, al
    98 00012060 E8A4FFFFFF          <1>     call ps2_wait_ibf
    99 00012065 B020                <1>     mov al, 0x20                 ; read controller config byte
   100 00012067 E664                <1>     out 0x64, al
   101 00012069 E8A4FFFFFF          <1>     call ps2_wait_obf
   102 0001206E E460                <1>     in al, 0x60
   103 00012070 0C02                <1>     or al, 0x02                  ; bit1: enable aux IRQ (harmless if unused)
   104 00012072 24DF                <1>     and al, 0xDF                 ; bit5 clear: aux clock enabled
   105 00012074 50                  <1>     push rax
   106 00012075 E88FFFFFFF          <1>     call ps2_wait_ibf
   107 0001207A B060                <1>     mov al, 0x60                 ; write config byte
   108 0001207C E664                <1>     out 0x64, al
   109 0001207E E886FFFFFF          <1>     call ps2_wait_ibf
   110 00012083 58                  <1>     pop rax
   111 00012084 E660                <1>     out 0x60, al
   112 00012086 B0F6                <1>     mov al, 0xF6                 ; set defaults (stream mode, reporting off)
   113 00012088 E88EFFFFFF          <1>     call mouse_send_cmd
   114 0001208D 0F828E000000        <1>     jc .fail
   115                              <1>     ; IntelliMouse negotiation: sending sample rate 200 three times in a
   116                              <1>     ; row switches a wheel mouse into 4-byte packets (flags/X/Y/Z). The
   117                              <1>     ; device ID read confirms it - 0x03/0x04 = wheel present. If that
   118                              <1>     ; doesn't take, retry with the IntelliMouse Explorer sequence
   119                              <1>     ; (200/100/80). A mouse that answers neither stays in 3-byte mode.
   120 00012093 B1C8                <1>     mov cl, 200
   121 00012095 E88A000000          <1>     call mouse_set_rate
   122 0001209A 7251                <1>     jc .wheel_off
   123 0001209C E883000000          <1>     call mouse_set_rate
   124 000120A1 724A                <1>     jc .wheel_off
   125 000120A3 E87C000000          <1>     call mouse_set_rate
   126 000120A8 7243                <1>     jc .wheel_off
   127 000120AA E8B3000000          <1>     call mouse_read_id
   128 000120AF 723C                <1>     jc .wheel_off
   129 000120B1 3C03                <1>     cmp al, 0x03
   130 000120B3 742E                <1>     je .wheel_on
   131 000120B5 3C04                <1>     cmp al, 0x04
   132 000120B7 742A                <1>     je .wheel_on
   133 000120B9 B1C8                <1>     mov cl, 200
   134 000120BB E864000000          <1>     call mouse_set_rate
   135 000120C0 722B                <1>     jc .wheel_off
   136 000120C2 B164                <1>     mov cl, 100
   137 000120C4 E85B000000          <1>     call mouse_set_rate
   138 000120C9 7222                <1>     jc .wheel_off
   139 000120CB B150                <1>     mov cl, 80
   140 000120CD E852000000          <1>     call mouse_set_rate
   141 000120D2 7219                <1>     jc .wheel_off
   142 000120D4 E889000000          <1>     call mouse_read_id
   143 000120D9 7212                <1>     jc .wheel_off
   144 000120DB 3C03                <1>     cmp al, 0x03
   145 000120DD 7404                <1>     je .wheel_on
   146 000120DF 3C04                <1>     cmp al, 0x04
   147 000120E1 750A                <1>     jne .wheel_off
   148                              <1> .wheel_on:
   149 000120E3 C60425[1A280100]01  <1>     mov byte [mouse_wheel], 1
   150 000120EB EB08                <1>     jmp .have_wheel
   151                              <1> .wheel_off:
   152 000120ED C60425[1A280100]00  <1>     mov byte [mouse_wheel], 0
   153                              <1> .have_wheel:
   154 000120F5 B0F4                <1>     mov al, 0xF4                 ; enable data reporting
   155 000120F7 E81FFFFFFF          <1>     call mouse_send_cmd
   156 000120FC 7223                <1>     jc .fail
   157 000120FE C60425[17280100]00  <1>     mov byte [mouse_pkt_idx], 0
   158 00012106 C60425[18280100]00  <1>     mov byte [mouse_acc_x], 0
   159 0001210E C60425[19280100]00  <1>     mov byte [mouse_acc_y], 0
   160 00012116 C60425[1B280100]00  <1>     mov byte [mouse_wheel_acc], 0
   161 0001211E F8                  <1>     clc
   162 0001211F EB01                <1>     jmp .out
   163                              <1> .fail:
   164 00012121 F9                  <1>     stc
   165                              <1> .out:
   166 00012122 58                  <1>     pop rax
   167 00012123 C3                  <1>     ret
   168                              <1> 
   169                              <1> ; mouse_set_rate: cl = sample rate. Sends 0xF3, waits for its ACK, then
