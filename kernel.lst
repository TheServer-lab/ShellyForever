 10290                                  ; pci_find_e1000: brute-force scan of PCI bus 0, vendor 0x8086, matching any
 10291                                  ; device id in e1000_dev_ids. Real e1000-family silicon spans a lot of PCI
 10292                                  ; device ids across generations (82540/82541/82545/82546/82571-82574/...),
 10293                                  ; unlike the RTL8139's single fixed id, so this checks the incoming device
 10294                                  ; id against a table instead of one constant. QEMU's "e1000" model reports
 10295                                  ; 0x100E. Returns CF=0 and nic_pci_bus/dev/func set, or CF=1.
 10296                                  ; pci_find_e1000: brute-force scan of every PCI bus (0..255), every device,
 10297                                  ; function 0 first and then functions 1..7 if multi-function, vendor 0x8086,
 10298                                  ; matching any device id in e1000_dev_ids. Real e1000-family silicon spans a
 10299                                  ; lot of PCI device ids across generations (82540/82541/82545/82546/82571-
 10300                                  ; 82574/...), unlike the RTL8139's single fixed id, so this checks the
 10301                                  ; incoming device id against a table instead of one constant. QEMU's "e1000"
 10302                                  ; model reports 0x100E. A bus-0-only scan misses real hardware, where the
 10303                                  ; NIC usually sits behind a PCIe root port on a non-zero bus - see
 10304                                  ; pci_find_nic above for the same fix. Returns CF=0 and nic_pci_bus/dev/func
 10305                                  ; set, or CF=1.
 10306                                  pci_find_e1000:
 10307 000186B9 50                          push rax
 10308 000186BA 53                          push rbx
 10309 000186BB 51                          push rcx
 10310 000186BC 52                          push rdx
 10311 000186BD 4150                        push r8
 10312 000186BF 4151                        push r9
 10313 000186C1 4152                        push r10
 10314 000186C3 4153                        push r11
 10315 000186C5 31DB                        xor ebx, ebx                     ; bus
 10316                                  .ebus_loop:
 10317 000186C7 81FB00010000                cmp ebx, 256
 10318 000186CD 0F83B1000000                jae .enot_found
 10319 000186D3 31C9                        xor ecx, ecx                     ; device
 10320                                  .edev_loop:
 10321 000186D5 83F920                      cmp ecx, 32
 10322 000186D8 0F839F000000                jae .enext_bus
 10323 000186DE 31D2                        xor edx, edx                     ; try function 0 first
 10324 000186E0 4D31C0                      xor r8, r8
 10325 000186E3 E85CF4FFFF                  call pci_read32
 10326 000186E8 83F8FF                      cmp eax, 0xFFFFFFFF
 10327 000186EB 0F8485000000                je .enext_dev                    ; nothing at this slot at all
 10328 000186F1 663D8680                    cmp ax, E1000_VENDOR_ID
 10329 000186F5 7524                        jne .ef0_no_match
 10330 000186F7 C1E810                      shr eax, 16                      ; eax = device id
 10331 000186FA 4C8D0C25[48620600]          lea r9, [e1000_dev_ids]
 10332 00018702 41BA1D000000                mov r10d, E1000_DEV_ID_COUNT
 10333                                  .ecmp_loop0:
 10334 00018708 66413901                    cmp word [r9], ax
 10335 0001870C 0F8480000000                je .efound
 10336 00018712 4983C102                    add r9, 2
 10337 00018716 41FFCA                      dec r10d
 10338 00018719 75ED                        jnz .ecmp_loop0
 10339                                  .ef0_no_match:
 10340 0001871B 31D2                        xor edx, edx
 10341 0001871D 41B80C000000                mov r8, 0x0C                     ; header-type dword
 10342 00018723 E81CF4FFFF                  call pci_read32
 10343 00018728 C1E810                      shr eax, 16
 10344 0001872B A880                        test al, 0x80                    ; multi-function bit
 10345 0001872D 7447                        jz .enext_dev                    ; single-function: nothing more here
 10346 0001872F 41BB01000000                mov r11d, 1
 10347                                  .efunc_loop:
 10348 00018735 4183FB08                    cmp r11d, 8
 10349 00018739 733B                        jae .enext_dev
 10350 0001873B 4489DA                      mov edx, r11d
 10351 0001873E 4D31C0                      xor r8, r8
 10352 00018741 E8FEF3FFFF                  call pci_read32
 10353 00018746 83F8FF                      cmp eax, 0xFFFFFFFF
 10354 00018749 7426                        je .efunc_next
 10355 0001874B 663D8680                    cmp ax, E1000_VENDOR_ID
 10356 0001874F 7520                        jne .efunc_next
 10357 00018751 C1E810                      shr eax, 16
 10358 00018754 4C8D0C25[48620600]          lea r9, [e1000_dev_ids]
 10359 0001875C 41BA1D000000                mov r10d, E1000_DEV_ID_COUNT
 10360                                  .ecmp_loopN:
 10361 00018762 66413901                    cmp word [r9], ax
 10362 00018766 742A                        je .efound
 10363 00018768 4983C102                    add r9, 2
 10364 0001876C 41FFCA                      dec r10d
 10365 0001876F 75F1                        jnz .ecmp_loopN
 10366                                  .efunc_next:
 10367 00018771 41FFC3                      inc r11d
 10368 00018774 EBBF                        jmp .efunc_loop
 10369                                  .enext_dev:
 10370 00018776 FFC1                        inc ecx
 10371 00018778 E958FFFFFF                  jmp .edev_loop
 10372                                  .enext_bus:
 10373 0001877D FFC3                        inc ebx
 10374 0001877F E943FFFFFF                  jmp .ebus_loop
 10375                                  .enot_found:
 10376 00018784 415B                        pop r11
 10377 00018786 415A                        pop r10
 10378 00018788 4159                        pop r9
 10379 0001878A 4158                        pop r8
 10380 0001878C 5A                          pop rdx
 10381 0001878D 59                          pop rcx
 10382 0001878E 5B                          pop rbx
 10383 0001878F 58                          pop rax
 10384 00018790 F9                          stc
 10385 00018791 C3                          ret
 10386                                  .efound:
 10387 00018792 881C25[ADE80500]            mov [nic_pci_bus], bl
 10388 00018799 880C25[AEE80500]            mov [nic_pci_dev], cl
 10389 000187A0 881425[AFE80500]            mov [nic_pci_func], dl
 10390 000187A7 415B                        pop r11
 10391 000187A9 415A                        pop r10
 10392 000187AB 4159                        pop r9
 10393 000187AD 4158                        pop r8
 10394 000187AF 5A                          pop rdx
 10395 000187B0 59                          pop rcx
 10396 000187B1 5B                          pop rbx
 10397 000187B2 58                          pop rax
 10398 000187B3 F8                          clc
 10399 000187B4 C3                          ret
