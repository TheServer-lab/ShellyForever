 12437 0000A27A 31C0                        xor eax, eax
 12438 0000A27C E897FFFFFF                  call mdio_write_rtl        ; clear power-down bit (page-specific reg)
 12439                                  
 12440 0000A281 B200                        mov dl, 0x00                ; BMCR
 12441 0000A283 B800920000                  mov eax, 0x9200              ; RESET | ANENABLE | ANRESTART
