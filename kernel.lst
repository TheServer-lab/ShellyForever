 17737                                  ; ------------------------------------------------------------
 17738                                  ; kernel_api_table slot layout (each slot = 8 bytes, offset shown
 17739                                  ; is the byte offset used by "call [r11+offset]" from compiled .run
 17740                                  ; code). Slots 0x00-0x20 are the original v0.1 ABI (print/read/kill);
 17741                                  ; 0x28 onward were added for the "party compile" native-codegen
 17742                                  ; backend (see party.asm: party_compile_to_run) so compiled programs
 17743                                  ; can call the SAME tested interpreter primitives (value stack,
 17744                                  ; operators, variable table, function invocation) instead of each
 17745                                  ; compiled program re-implementing them. One slot (0x18) holds a DATA
 17746                                  ; pointer - everything else is a function pointer. 0xE0 (KAPI_BOOT)
 17747                                  ; is the compiled-program runtime bootstrap: a compiled binary's
 17748                                  ; whole entry sequence is LEA RSI,embedded-source ; CALL [KAPI_BOOT]
 17749                                  ; ; RET - party_boot_compiled does the lex + interpreted run.
 17750                                  ; ------------------------------------------------------------
 17751                                  KAPI_PRINT_STRING       equ 0x00
 17752                                  KAPI_PRINT_STRING_ATTR  equ 0x08
 17753                                  KAPI_GET_CHAR           equ 0x10
 17754                                  KAPI_NEWLINE_STR        equ 0x18   ; data: pointer to newline_str
 17755                                  KAPI_POLL_KILL          equ 0x20
 17756                                  KAPI_PUSH_VAL           equ 0x28
 17757                                  KAPI_POP_VAL            equ 0x30
 17758                                  KAPI_VAL_SET_INT        equ 0x38
 17759                                  KAPI_VAL_SET_STR        equ 0x40
 17760                                  KAPI_VAL_SET_BOOL_TRUE  equ 0x48
 17761                                  KAPI_VAL_SET_BOOL_FALSE equ 0x50
 17762                                  KAPI_VAL_SET_NONE       equ 0x58
 17763                                  KAPI_OP_BIN             equ 0x60
 17764                                  KAPI_OP_EQ              equ 0x68
 17765                                  KAPI_OP_NEQ             equ 0x70
 17766                                  KAPI_OP_REL             equ 0x78
 17767                                  KAPI_TRUTHY             equ 0x80
 17768                                  KAPI_PRINT_VALUE        equ 0x88
 17769                                  KAPI_VAR_DECLARE        equ 0x90
 17770                                  KAPI_VAR_ASSIGN         equ 0x98
 17771                                  KAPI_VAR_GET_PTR        equ 0xA0
 17772                                  KAPI_VAL_COPY           equ 0xA8
 17773                                  KAPI_INVOKE_FUNC        equ 0xB0
 17774                                  KAPI_FUNC_FIND          equ 0xB8
 17775                                  KAPI_NEG_TOP            equ 0xC0
 17776                                  KAPI_LEX                equ 0xC8
 17777                                  KAPI_COLLECT_FUNCS      equ 0xD0
 17778                                  KAPI_VAL_SET_FLOAT      equ 0xD8
 17779                                  KAPI_BOOT               equ 0xE0   ; compiled-program runtime bootstrap
 17780                                  KAPI_TABLE_SIZE         equ 0xF0   ; total bytes
 17781                                  
 17782 00077CF2 90<rep 6h>              ALIGN 8
