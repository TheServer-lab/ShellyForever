 12891                                  ; ---- UDP / DNS ---------------------------------------------------
 12892                                  ; nic_send_udp: rsi = payload, ecx = payload len, r8d = dst IP, r9w = dst
 12893                                  ; port, r10w = src port. Builds the UDP datagram in net_build_buf, then
 12894                                  ; ships it as an IP payload.
 12895                                  nic_send_udp:
 12896 0001A303 53                          push rbx
 12897 0001A304 51                          push rcx
 12898 0001A305 52                          push rdx
 12899 0001A306 57                          push rdi
 12900 0001A307 56                          push rsi
 12901 0001A308 4151                        push r9
 12902 0001A30A 4152                        push r10
 12903 0001A30C 4153                        push r11
 12904 0001A30E 4154                        push r12
 12905 0001A310 4155                        push r13
 12906 0001A312 4156                        push r14
 12907 0001A314 4157                        push r15
 12908 0001A316 4989F3                      mov r11, rsi
 12909 0001A319 4189CC                      mov r12d, ecx
 12910 0001A31C 4589C5                      mov r13d, r8d
 12911 0001A31F 664589CE                    mov r14w, r9w
 12912 0001A323 664589D7                    mov r15w, r10w
 12913                                      ; The payload (r11) is often the same net_build_buf we're about to
 12914                                      ; build the datagram in (callers construct their message there before
 12915                                      ; calling us), aliased with dst = src+8. If we wrote the 8-byte UDP
 12916                                      ; header first, it would destroy the payload's own first 8 bytes
 12917                                      ; before they could ever be copied - no copy direction fixes that.
 12918                                      ; So: shift the payload into place first (back-to-front, since
 12919                                      ; dst > src makes that direction overlap-safe), and only write the
 12920                                      ; header afterward, once bytes 0-7 are no longer needed as payload.
 12921 0001A327 4C89DE                      mov rsi, r11
 12922 0001A32A 4C01E6                      add rsi, r12
 12923 0001A32D 48FFCE                      dec rsi
 12924 0001A330 488D3C25[48110600]          lea rdi, [net_build_buf + 8]
 12925 0001A338 4C01E7                      add rdi, r12
 12926 0001A33B 48FFCF                      dec rdi
 12927 0001A33E 4C89E1                      mov rcx, r12
 12928 0001A341 FD                          std
 12929 0001A342 F3A4                        rep movsb
 12930 0001A344 FC                          cld
 12931 0001A345 488D3C25[40110600]          lea rdi, [net_build_buf]
 12932 0001A34D 664489F8                    mov ax, r15w
 12933 0001A351 8827                        mov byte [rdi], ah
 12934 0001A353 884701                      mov byte [rdi+1], al
 12935 0001A356 664489F0                    mov ax, r14w
 12936 0001A35A 886702                      mov byte [rdi+2], ah
 12937 0001A35D 884703                      mov byte [rdi+3], al
 12938 0001A360 4489E0                      mov eax, r12d
 12939 0001A363 83C008                      add eax, 8
 12940 0001A366 886704                      mov byte [rdi+4], ah
 12941 0001A369 884705                      mov byte [rdi+5], al
 12942 0001A36C 66C747060000                mov word [rdi+6], 0
 12943 0001A372 50                          push rax
 12944 0001A373 56                          push rsi
 12945 0001A374 51                          push rcx
 12946 0001A375 4150                        push r8
 12947 0001A377 4151                        push r9
 12948 0001A379 488D3425[40110600]          lea rsi, [net_build_buf]
 12949 0001A381 4489E1                      mov ecx, r12d
 12950 0001A384 83C108                      add ecx, 8
 12951 0001A387 448B0425[C6E80500]          mov r8d, [nic_ip]
 12952 0001A38F 4589E9                      mov r9d, r13d
 12953 0001A392 E813FAFFFF                  call net_udp_checksum
 12954                                      ; net_checksum16's result is a host-order logical 16-bit value, same
 12955                                      ; as nic_send_ip's IP-header checksum - that call site byte-swaps with
 12956                                      ; ror ax,8 before the store (see nic_send_ip below) because `mov word`
 12957                                      ; writes little-endian but the wire field needs big-endian. This call
 12958                                      ; site was missing that same swap, so every outgoing UDP checksum
 12959                                      ; (DHCP discover/request included) was written backwards. QEMU's slirp
 12960                                      ; doesn't validate UDP checksums so this never showed up there, but a
 12961                                      ; real DHCP server will silently drop a packet with a bad checksum -
 12962                                      ; which is indistinguishable from "no response" on our end.
 12963 0001A397 66C1C808                    ror ax, 8
 12964 0001A39B 66890425[46110600]          mov [net_build_buf + 6], ax
 12965 0001A3A3 4159                        pop r9
 12966 0001A3A5 4158                        pop r8
 12967 0001A3A7 59                          pop rcx
 12968 0001A3A8 5E                          pop rsi
 12969 0001A3A9 58                          pop rax
 12970 0001A3AA 488D3425[40110600]          lea rsi, [net_build_buf]
 12971 0001A3B2 4489E1                      mov ecx, r12d
 12972 0001A3B5 83C108                      add ecx, 8
