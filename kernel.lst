   667                              <1>     ; the extension's declared data must not run past the ext block --
   668                              <1>     ; without this, a truncated/malformed ServerHello could send rsi (and
   669                              <1>     ; the key_share reads below) past the extensions block's real end.
   670 0003FBC5 4C8D4E04            <1>     lea r9, [rsi + 4]
   671 0003FBC9 4901C9              <1>     add r9, rcx
   672 0003FBCC 4D39C1              <1>     cmp r9, r8
   673 0003FBCF 7753                <1>     ja .tls_psh_bad
   674 0003FBD1 6683F833            <1>     cmp ax, 0x0033
   675 0003FBD5 7541                <1>     jne .tls_psh_next
   676                              <1>     ; key_share ext: group(2) + keylen(2) + key(32) -- confirm the
   677                              <1>     ; extension actually declared that much data before reading it
   678 0003FBD7 83F924              <1>     cmp ecx, 36
   679 0003FBDA 7248                <1>     jb .tls_psh_bad
   680 0003FBDC 0FB64604            <1>     movzx eax, byte [rsi+4]
   681 0003FBE0 C1E008              <1>     shl eax, 8
   682 0003FBE3 0FB65605            <1>     movzx edx, byte [rsi+5]
   683 0003FBE7 09D0                <1>     or eax, edx
   684 0003FBE9 6683F81D            <1>     cmp ax, GROUP_X25519
   685 0003FBED 7535                <1>     jne .tls_psh_bad
   686 0003FBEF 0FB64606            <1>     movzx eax, byte [rsi+6]
   687 0003FBF3 C1E008              <1>     shl eax, 8
   688 0003FBF6 0FB65607            <1>     movzx edx, byte [rsi+7]
   689 0003FBFA 09D0                <1>     or eax, edx
   690 0003FBFC 6683F820            <1>     cmp ax, 32
   691 0003FC00 7522                <1>     jne .tls_psh_bad
   692 0003FC02 488D3C25[3F520400]  <1>     lea rdi, [tls_server_pub]
   693 0003FC0A 488D7608            <1>     lea rsi, [rsi+8]
   694 0003FC0E B920000000          <1>     mov ecx, 32
   695 0003FC13 F3A4                <1>     rep movsb
   696 0003FC15 F8                  <1>     clc
   697 0003FC16 EB0D                <1>     jmp .tls_psh_out
   698                              <1> .tls_psh_next:
   699 0003FC18 4883C604            <1>     add rsi, 4
   700 0003FC1C 4801CE              <1>     add rsi, rcx
   701 0003FC1F E976FFFFFF          <1>     jmp .tls_psh_ext
   702                              <1> .tls_psh_nokeyshare:
   703                              <1> .tls_psh_bad:
   704 0003FC24 F9                  <1>     stc
   705                              <1> .tls_psh_out:
   706 0003FC25 4159                <1>     pop r9
   707 0003FC27 4158                <1>     pop r8
   708 0003FC29 5F                  <1>     pop rdi
   709 0003FC2A 5E                  <1>     pop rsi
   710 0003FC2B 5A                  <1>     pop rdx
   711 0003FC2C 59                  <1>     pop rcx
   712 0003FC2D 5B                  <1>     pop rbx
   713 0003FC2E 58                  <1>     pop rax
   714 0003FC2F C3                  <1>     ret
   715                              <1> 
   716                              <1> ; ============================================================
   717                              <1> ;  tls_derive_secret -- RFC 8446 7.1 Derive-Secret
   718                              <1> ;  rdi = secret(32), rsi = label ptr, rdx = label len,
   719                              <1> ;  rcx = transcript hash(32), r8 = out(32)
   720                              <1> ;  = HKDF-Expand-Label(secret, label, transcript_hash, 32)
   721                              <1> ; ============================================================
   722                              <1> tls_derive_secret:
   723 0003FC30 4152                <1>     push r10
   724 0003FC32 4151                <1>     push r9
   725 0003FC34 4150                <1>     push r8
   726 0003FC36 51                  <1>     push rcx
   727 0003FC37 52                  <1>     push rdx
   728 0003FC38 56                  <1>     push rsi
   729 0003FC39 57                  <1>     push rdi
   730                              <1>     ; hkdf_expand_label:
   731                              <1>     ;   rdi=secret, rsi=label, edx=label len, rcx=context ptr,
   732                              <1>     ;   r8d=context len, r9d=L, r10=out
   733 0003FC3A 4D89C2              <1>     mov r10, r8
   734 0003FC3D 41B820000000        <1>     mov r8d, HASH_LEN
   735 0003FC43 41B920000000        <1>     mov r9d, HASH_LEN
   736 0003FC49 E8808FFFFF          <1>     call hkdf_expand_label
   737 0003FC4E 5F                  <1>     pop rdi
   738 0003FC4F 5E                  <1>     pop rsi
   739 0003FC50 5A                  <1>     pop rdx
   740 0003FC51 59                  <1>     pop rcx
   741 0003FC52 4158                <1>     pop r8
   742 0003FC54 4159                <1>     pop r9
   743 0003FC56 415A                <1>     pop r10
   744 0003FC58 C3                  <1>     ret
   745                              <1> 
   746                              <1> ; ============================================================
   747                              <1> ;  tls_traffic_key_iv -- rdi = traffic secret(32), r8 = key out(32),
   748                              <1> ;  r9 = iv out(12). Derives "key" and "iv" labels.
   749                              <1> ; ============================================================
   750                              <1> tls_traffic_key_iv:
   751 0003FC59 4152                <1>     push r10
   752 0003FC5B 4151                <1>     push r9
   753 0003FC5D 4150                <1>     push r8
   754 0003FC5F 51                  <1>     push rcx
   755 0003FC60 52                  <1>     push rdx
   756 0003FC61 56                  <1>     push rsi
   757 0003FC62 57                  <1>     push rdi
   758                              <1>     ; key
   759 0003FC63 4D89C2              <1>     mov r10, r8
   760 0003FC66 488D3425[2FAF0500]  <1>     lea rsi, [tls_label_key]
   761 0003FC6E BA03000000          <1>     mov edx, 3
   762 0003FC73 31C9                <1>     xor ecx, ecx
   763 0003FC75 4531C0              <1>     xor r8d, r8d
   764 0003FC78 41B920000000        <1>     mov r9d, AEAD_KEY_LEN
   765 0003FC7E E84B8FFFFF          <1>     call hkdf_expand_label
   766                              <1>     ; iv
   767 0003FC83 488B3C24            <1>     mov rdi, [rsp + 0]               ; original secret (saved rdi on stack)
   768 0003FC87 4C8B542428          <1>     mov r10, [rsp + 40]              ; original r9 (iv out)
   769 0003FC8C 488D3425[32AF0500]  <1>     lea rsi, [tls_label_iv]
   770 0003FC94 BA02000000          <1>     mov edx, 2
   771 0003FC99 31C9                <1>     xor ecx, ecx
   772 0003FC9B 4531C0              <1>     xor r8d, r8d
   773 0003FC9E 41B90C000000        <1>     mov r9d, AEAD_IV_LEN
   774 0003FCA4 E8258FFFFF          <1>     call hkdf_expand_label
   775 0003FCA9 5F                  <1>     pop rdi
   776 0003FCAA 5E                  <1>     pop rsi
   777 0003FCAB 5A                  <1>     pop rdx
   778 0003FCAC 59                  <1>     pop rcx
   779 0003FCAD 4158                <1>     pop r8
   780 0003FCAF 4159                <1>     pop r9
   781 0003FCB1 415A                <1>     pop r10
   782 0003FCB3 C3                  <1>     ret
   783                              <1> 
   784                              <1> ; ============================================================
   785                              <1> ;  tls_finished_verify_data -- rdi = base key(32), rsi = transcript
   786                              <1> ;  hash(32), r8 = out(32)
   787                              <1> ;  = HMAC(HKDF-Expand-Label(base, "finished", "", 32), th)
   788                              <1> ; ============================================================
   789                              <1> tls_finished_verify_data:
   790 0003FCB4 4150                <1>     push r8
   791 0003FCB6 51                  <1>     push rcx
   792 0003FCB7 52                  <1>     push rdx
   793 0003FCB8 56                  <1>     push rsi
   794 0003FCB9 57                  <1>     push rdi
   795 0003FCBA 4151                <1>     push r9
   796                              <1>     ; finished_key
   797 0003FCBC 4989FA              <1>     mov r10, rdi
   798                              <1>     ; hkdf_expand_label(secret, "finished", "", 0, 32, tls_finished_key)
   799 0003FCBF 488D3C25[07550400]  <1>     lea rdi, [tls_finished_key]
   800 0003FCC7 57                  <1>     push rdi
   801 0003FCC8 4C89D7              <1>     mov rdi, r10
   802 0003FCCB 488D3425[27AF0500]  <1>     lea rsi, [tls_label_finished]
   803 0003FCD3 BA08000000          <1>     mov edx, 8
   804 0003FCD8 31C9                <1>     xor ecx, ecx
   805 0003FCDA 4531C0              <1>     xor r8d, r8d
   806 0003FCDD 41B920000000        <1>     mov r9d, HASH_LEN
   807 0003FCE3 4C8B1424            <1>     mov r10, [rsp + 0]               ; tls_finished_key out
   808 0003FCE7 E8E28EFFFF          <1>     call hkdf_expand_label
   809 0003FCEC 5F                  <1>     pop rdi
   810                              <1>     ; hmac_sha256: rdi=key, rcx=keylen, rsi=msg ptr, rdx=msglen, r8=out.
   811                              <1>     ; rsi was clobbered above (set to the "finished" label ptr for the
   812                              <1>     ; hkdf_expand_label call) -- must reload the original th ptr here,
   813                              <1>     ; or this hashes the wrong message.
   814 0003FCED 488D3C25[07550400]  <1>     lea rdi, [tls_finished_key]
   815 0003FCF5 B920000000          <1>     mov rcx, HASH_LEN
   816 0003FCFA 488B742410          <1>     mov rsi, [rsp + 16]               ; original rsi (th)
   817 0003FCFF BA20000000          <1>     mov rdx, HASH_LEN
   818 0003FD04 4C8B442428          <1>     mov r8, [rsp + 40]               ; original r8 (out)
   819 0003FD09 E86F8CFFFF          <1>     call hmac_sha256
   820 0003FD0E 4159                <1>     pop r9
   821 0003FD10 5F                  <1>     pop rdi
   822 0003FD11 5E                  <1>     pop rsi
   823 0003FD12 5A                  <1>     pop rdx
   824 0003FD13 59                  <1>     pop rcx
   825 0003FD14 4158                <1>     pop r8
   826 0003FD16 C3                  <1>     ret
   827                              <1> 
   828                              <1> ; ============================================================
   829                              <1> ;  tls_key_schedule -- runs the RFC 8446 7.1 zero-PSK schedule.
   830                              <1> ;  Uses tls_ecdh_shared and tls_th_ch_sh (transcript hash of
   831                              <1> ;  ClientHello + ServerHello). Fills all tls_*_secret / traffic
   832                              <1> ;  secrets. Caller derives keys/ivs afterwards.
   833                              <1> ; ============================================================
   834                              <1> tls_key_schedule:
   835 0003FD17 50                  <1>     push rax
   836 0003FD18 53                  <1>     push rbx
   837 0003FD19 51                  <1>     push rcx
   838 0003FD1A 52                  <1>     push rdx
   839 0003FD1B 56                  <1>     push rsi
   840 0003FD1C 57                  <1>     push rdi
   841 0003FD1D 4150                <1>     push r8
   842 0003FD1F 4151                <1>     push r9
   843 0003FD21 4152                <1>     push r10
   844                              <1> 
   845                              <1>     ; early_secret = HKDF-Extract(zeros, zeros)
   846 0003FD23 488D3C25[170F0400]  <1>     lea rdi, [tls_zero32]
   847 0003FD2B B920000000          <1>     mov rcx, 32
   848 0003FD30 488D3425[170F0400]  <1>     lea rsi, [tls_zero32]
   849 0003FD38 BA20000000          <1>     mov rdx, 32
   850 0003FD3D 4C8D0425[6B0F0400]  <1>     lea r8, [tls_early_secret]
   851 0003FD45 E8658DFFFF          <1>     call hkdf_extract
   852                              <1> 
   853                              <1>     ; derived1 = Derive-Secret(early, "derived", Hash(""))
   854 0003FD4A 488D3C25[6B0F0400]  <1>     lea rdi, [tls_early_secret]
   855 0003FD52 488D3425[F0AE0500]  <1>     lea rsi, [tls_label_derived]
   856 0003FD5A BA07000000          <1>     mov edx, 7
   857 0003FD5F 488D0C25[34AF0500]  <1>     lea rcx, [tls_empty_hash]
   858 0003FD67 4C8D0425[8B0F0400]  <1>     lea r8, [tls_derived1]
   859 0003FD6F E8BCFEFFFF          <1>     call tls_derive_secret
   860                              <1> 
   861                              <1>     ; handshake_secret = HKDF-Extract(derived1, ecdh_shared)
   862 0003FD74 488D3C25[8B0F0400]  <1>     lea rdi, [tls_derived1]
   863 0003FD7C B920000000          <1>     mov rcx, 32
   864 0003FD81 488D3425[5F520400]  <1>     lea rsi, [tls_ecdh_shared]
   865 0003FD89 BA20000000          <1>     mov rdx, 32
   866 0003FD8E 4C8D0425[AB0F0400]  <1>     lea r8, [tls_hs_secret]
   867 0003FD96 E8148DFFFF          <1>     call hkdf_extract
   868                              <1> 
   869                              <1>     ; c_hs / s_hs traffic secrets
   870 0003FD9B 488D3C25[AB0F0400]  <1>     lea rdi, [tls_hs_secret]
   871 0003FDA3 488D3425[F7AE0500]  <1>     lea rsi, [tls_label_c_hs]
   872 0003FDAB BA0C000000          <1>     mov edx, 12
   873 0003FDB0 488D0C25[3F510400]  <1>     lea rcx, [tls_th_ch_sh]
   874 0003FDB8 4C8D0425[0B100400]  <1>     lea r8, [tls_c_hs_traffic]
   875 0003FDC0 E86BFEFFFF          <1>     call tls_derive_secret
   876                              <1> 
   877 0003FDC5 488D3C25[AB0F0400]  <1>     lea rdi, [tls_hs_secret]
   878 0003FDCD 488D3425[03AF0500]  <1>     lea rsi, [tls_label_s_hs]
   879 0003FDD5 BA0C000000          <1>     mov edx, 12
   880 0003FDDA 488D0C25[3F510400]  <1>     lea rcx, [tls_th_ch_sh]
   881 0003FDE2 4C8D0425[2B100400]  <1>     lea r8, [tls_s_hs_traffic]
   882 0003FDEA E841FEFFFF          <1>     call tls_derive_secret
   883                              <1> 
   884                              <1>     ; derived2 = Derive-Secret(hs, "derived", Hash(""))
   885 0003FDEF 488D3C25[AB0F0400]  <1>     lea rdi, [tls_hs_secret]
   886 0003FDF7 488D3425[F0AE0500]  <1>     lea rsi, [tls_label_derived]
   887 0003FDFF BA07000000          <1>     mov edx, 7
   888 0003FE04 488D0C25[34AF0500]  <1>     lea rcx, [tls_empty_hash]
   889 0003FE0C 4C8D0425[CB0F0400]  <1>     lea r8, [tls_derived2]
   890 0003FE14 E817FEFFFF          <1>     call tls_derive_secret
   891                              <1> 
   892                              <1>     ; master_secret = HKDF-Extract(derived2, zeros)
   893 0003FE19 488D3C25[CB0F0400]  <1>     lea rdi, [tls_derived2]
   894 0003FE21 B920000000          <1>     mov rcx, 32
   895 0003FE26 488D3425[170F0400]  <1>     lea rsi, [tls_zero32]
   896 0003FE2E BA20000000          <1>     mov rdx, 32
   897 0003FE33 4C8D0425[EB0F0400]  <1>     lea r8, [tls_master]
   898 0003FE3B E86F8CFFFF          <1>     call hkdf_extract
   899                              <1> 
   900 0003FE40 415A                <1>     pop r10
   901 0003FE42 4159                <1>     pop r9
   902 0003FE44 4158                <1>     pop r8
   903 0003FE46 5F                  <1>     pop rdi
   904 0003FE47 5E                  <1>     pop rsi
   905 0003FE48 5A                  <1>     pop rdx
   906 0003FE49 59                  <1>     pop rcx
   907 0003FE4A 5B                  <1>     pop rbx
   908 0003FE4B 58                  <1>     pop rax
   909 0003FE4C C3                  <1>     ret
   910                              <1> 
   911                              <1> ; ============================================================
   912                              <1> ;  tls_transcript_append -- rsi = data, rcx = len. Appends to the
   913                              <1> ;  running transcript buffer (capped at TLS_TRANSCRIPT_MAX).
   914                              <1> ; ============================================================
   915                              <1> tls_transcript_append:
   916 0003FE4D 50                  <1>     push rax
   917 0003FE4E 53                  <1>     push rbx
   918 0003FE4F 51                  <1>     push rcx
   919 0003FE50 56                  <1>     push rsi
   920 0003FE51 57                  <1>     push rdi
   921 0003FE52 8B0425[3B510400]    <1>     mov eax, [tls_transcript_len]
   922 0003FE59 3DFF3F0000          <1>     cmp eax, TLS_TRANSCRIPT_MAX - 1
   923 0003FE5E 733D                <1>     jae .tls_ta_done
   924 0003FE60 BA00400000          <1>     mov edx, TLS_TRANSCRIPT_MAX
   925 0003FE65 29C2                <1>     sub edx, eax
   926 0003FE67 39D1                <1>     cmp ecx, edx
   927 0003FE69 7718                <1>     ja .tls_ta_trunc
   928 0003FE6B 488D3C25[3B110400]  <1>     lea rdi, [tls_transcript]
   929 0003FE73 4801C7              <1>     add rdi, rax
   930 0003FE76 89CB                <1>     mov ebx, ecx                     ; stash length: rep movsb zeroes ecx
   931 0003FE78 F3A4                <1>     rep movsb
   932 0003FE7A 011C25[3B510400]    <1>     add [tls_transcript_len], ebx
   933 0003FE81 EB1A                <1>     jmp .tls_ta_done
   934                              <1> .tls_ta_trunc:
   935 0003FE83 89D1                <1>     mov ecx, edx
   936 0003FE85 488D3C25[3B110400]  <1>     lea rdi, [tls_transcript]
   937 0003FE8D 4801C7              <1>     add rdi, rax
   938 0003FE90 F3A4                <1>     rep movsb
   939 0003FE92 C70425[3B510400]00- <1>     mov dword [tls_transcript_len], TLS_TRANSCRIPT_MAX
   939 0003FE9A 400000              <1>
   940                              <1> .tls_ta_done:
   941 0003FE9D 5F                  <1>     pop rdi
   942 0003FE9E 5E                  <1>     pop rsi
   943 0003FE9F 59                  <1>     pop rcx
   944 0003FEA0 5B                  <1>     pop rbx
   945 0003FEA1 58                  <1>     pop rax
   946 0003FEA2 C3                  <1>     ret
   947                              <1> 
   948                              <1> ; ============================================================
   949                              <1> ;  tls_transcript_hash -- rdi = out (32 bytes). Computes sha256
   950                              <1> ;  over the running transcript.
   951                              <1> ; ============================================================
   952                              <1> tls_transcript_hash:
   953 0003FEA3 50                  <1>     push rax
   954 0003FEA4 51                  <1>     push rcx
   955 0003FEA5 56                  <1>     push rsi
   956 0003FEA6 57                  <1>     push rdi
   957 0003FEA7 4889F8              <1>     mov rax, rdi                ; out
   958 0003FEAA 488D3C25[3B110400]  <1>     lea rdi, [tls_transcript]   ; data
   959 0003FEB2 8B0C25[3B510400]    <1>     mov ecx, [tls_transcript_len]
   960 0003FEB9 4889C6              <1>     mov rsi, rax                ; out
   961 0003FEBC E87E8AFFFF          <1>     call sha256_hash
   962 0003FEC1 5F                  <1>     pop rdi
   963 0003FEC2 5E                  <1>     pop rsi
   964 0003FEC3 59                  <1>     pop rcx
   965 0003FEC4 58                  <1>     pop rax
   966 0003FEC5 C3                  <1>     ret
   967                              <1> 
   968                              <1> ; ============================================================
   969                              <1> ;  tls_pump -- drain tcp_rx_buf into tls_rx_buf stream.
   970                              <1> ;  Kernel: call netpoll first, then tls_pump. Harness: shims both.
   971                              <1> ; ============================================================
   972                              <1> tls_pump:
   973 0003FEC6 50                  <1>     push rax
   974 0003FEC7 51                  <1>     push rcx
   975 0003FEC8 56                  <1>     push rsi
   976 0003FEC9 57                  <1>     push rdi
   977 0003FECA 8B0425[DC8C0900]    <1>     mov eax, [tcp_rx_len]
   978 0003FED1 85C0                <1>     test eax, eax
   979 0003FED3 743F                <1>     jz .tls_pump_done
   980                              <1>     ; cap to remaining room in tls_rx_buf
   981 0003FED5 BA00400000          <1>     mov edx, TLS_RX_BUF_SIZE
   982 0003FEDA 2B1425[12960500]    <1>     sub edx, [tls_rx_used]
   983 0003FEE1 39D0                <1>     cmp eax, edx
   984 0003FEE3 7602                <1>     jbe .tls_pump_copy
   985 0003FEE5 89D0                <1>     mov eax, edx
   986                              <1> .tls_pump_copy:
   987 0003FEE7 488D3C25[12560500]  <1>     lea rdi, [tls_rx_buf]
   988 0003FEEF 033C25[12960500]    <1>     add edi, [tls_rx_used]           ; 32-bit add/zero-extend -- tls_rx_used
   989                              <1>                                       ; is a dd; `add rdi,[tls_rx_used]` would
   990                              <1>                                       ; read 8 bytes and pull in the following
   991                              <1>                                       ; dword (tls_last_frame_len) as garbage
   992                              <1>                                       ; upper bits once it's nonzero
   993 0003FEF6 488D3425[FA8C0900]  <1>     lea rsi, [tcp_rx_buf]
   994 0003FEFE 89C1                <1>     mov ecx, eax
   995 0003FF00 F3A4                <1>     rep movsb
   996 0003FF02 010425[12960500]    <1>     add [tls_rx_used], eax
   997 0003FF09 C70425[DC8C0900]00- <1>     mov dword [tcp_rx_len], 0
   997 0003FF11 000000              <1>
   998                              <1> .tls_pump_done:
   999 0003FF14 5F                  <1>     pop rdi
  1000 0003FF15 5E                  <1>     pop rsi
  1001 0003FF16 59                  <1>     pop rcx
  1002 0003FF17 58                  <1>     pop rax
  1003 0003FF18 C3                  <1>     ret
  1004                              <1> 
  1005                              <1> ; ============================================================
  1006                              <1> ;  tls_poll_single_frame -- looks for one complete TLS record in
  1007                              <1> ;  the tls_rx_buf stream. CF=0: dl=content type, ecx=payload len,
  1008                              <1> ;  rsi=payload ptr (points into tls_rx_buf). CF=1: incomplete.
  1009                              <1> ; ============================================================
  1010                              <1> tls_poll_single_frame:
  1011                              <1>     ; NOTE: rdx is NOT saved/restored here -- CF=0 returns dl = content
  1012                              <1>     ; type (set via `movzx edx, byte [tls_rx_buf]` below), so a
  1013                              <1>     ; push/pop rdx pair would clobber that with the caller's stale rdx
