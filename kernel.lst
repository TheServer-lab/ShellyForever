  5578 00004D74 6683C204                    add dx, 4
  5579 00004D78 4889D8                      mov rax, rbx
  5580 00004D7B 48C1E808                    shr rax, 8
  5581 00004D7F EE                          out dx, al                   ; LBA[8:15]
  5582 00004D80 0FB71425[F09E0100]          movzx edx, word [ata_port_base]
  5583 00004D88 6683C205                    add dx, 5
  5584 00004D8C 4889D8                      mov rax, rbx
