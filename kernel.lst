 14757                                  
 14758                                  ; cmd_shelly_rainbow: prints the null-terminated string in rsi, cycling the
 14759                                  ; attribute through the rainbow palette per character.
 14760                                  cmd_shelly_rainbow:
 14761 0001B5F7 50                          push rax
 14762 0001B5F8 53                          push rbx
 14763 0001B5F9 51                          push rcx
 14764 0001B5FA 56                          push rsi
 14765 0001B5FB 4831C9                      xor rcx, rcx
 14766                                  .rs_loop:
 14767 0001B5FE 8A06                        mov al, [rsi]
 14768 0001B600 3C00                        cmp al, 0
 14769 0001B602 7421                        je .rs_done
 14770 0001B604 488D1C25[B23C0300]          lea rbx, [shelly_palette]
 14771 0001B60C 8A1C0B                      mov bl, [rbx + rcx]
 14772 0001B60F E854140100                  call putchar
 14773 0001B614 48FFC6                      inc rsi
 14774 0001B617 48FFC1                      inc rcx
 14775 0001B61A 4883F906                    cmp rcx, SHELLY_PAL_LEN
 14776 0001B61E 72DE                        jb .rs_loop
 14777 0001B620 4831C9                      xor rcx, rcx
 14778 0001B623 EBD9                        jmp .rs_loop
 14779                                  .rs_done:
 14780 0001B625 5E                          pop rsi
 14781 0001B626 59                          pop rcx
 14782 0001B627 5B                          pop rbx
 14783 0001B628 58                          pop rax
 14784 0001B629 C3                          ret
