     1                              <1> ; ============================================================
     2                              <1> ;  tcp.asm  --  minimal polled TCP engine (Milestone C)
     3                              <1> ;
     4                              <1> ;  A deliberately tiny TCP client: 3-way handshake (SYN -> SYN-ACK ->
     5                              <1> ;  ACK), seq/ack tracking, one retransmit per wait phase, a single
     6                              <1> ;  send + receive of up to TCP_PAYLOAD_MAX bytes, and Esc-cancellable
     7                              <1> ;  waits. This is the foundation for Milestone D's HTTP take/give.
     8                              <1> ;
     9                              <1> ;  Entry points:
    10                              <1> ;    tcp_send_segment     build + transmit one segment (seq/ack from
    11                              <1> ;                         tcp_cur_seq / tcp_cur_ack)
    12                              <1> ;    tcp_handle_segment   called from handle_ipv4 for IP_PROTO_TCP;
    13                              <1> ;                         rsi = TCP header ptr inside nic_rx_frame
    14                              <1> ;    cmd_tcp              "tcp <host> <port> [payload]" shell command
    15                              <1> ;
    16                              <1> ;  All state lives in the data area at the end of kernel.asm (tcp_*),
    17                              <1> ;  declared separately so the module here stays pure code.
    18                              <1> ; ============================================================
    19                              <1> 
    20                              <1> TCP_PAYLOAD_MAX equ 1536     ; fits inside net_build_buf (4096 build area) and
    21                              <1>                               ; nic_tx_buf (2KB): frame = 34 + 20 + 1536 = 1590 < 2048
    22                              <1> ; Wait budget for SYN-ACK / reply waits. A SYN (or a data segment) has to
    23                              <1> ; make a real round trip to a host out past the gateway - unlike ARP/DHCP,
    24                              <1> ; which only ever talk to something on the local segment. The old code gave
    25                              <1> ; up after one whole-second tick plus a single immediate retransmit (~1-2s
    26                              <1> ; total), which is nowhere near enough for a real WAN round trip and made
    27                              <1> ; perfectly healthy connections report "timed out" before a reply had any
    28                              <1> ; chance to arrive. Mirror nic_arp_resolve's fix: a multi-second budget per
    29                              <1> ; round, several resend rounds before finally giving up.
    30                              <1> TCP_ROUND_SECS  equ 5         ; ~5-6s of continuous polling per round
    31                              <1> TCP_MAX_RETRIES equ 3         ; up to 3 retransmits (4 sends total) per phase
    32                              <1> TCP_FLAG_FIN    equ 0x01
    33                              <1> TCP_FLAG_SYN    equ 0x02
    34                              <1> TCP_FLAG_RST    equ 0x04
    35                              <1> TCP_FLAG_PSH    equ 0x08
    36                              <1> TCP_FLAG_ACK    equ 0x10
    37                              <1> 
    38                              <1> ; ---- 32-bit big-endian (wire order) helpers ----
    39                              <1> ; tcp_load_be32: rsi = ptr -> eax = big-endian dword as a host value.
    40                              <1> tcp_load_be32:
    41 00024118 0FB606              <1>     movzx eax, byte [rsi]
    42 0002411B C1E008              <1>     shl eax, 8
