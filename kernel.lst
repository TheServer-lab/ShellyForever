  2661 00027FC6 00000000            <1>
  2662 00027FCA 48C70425[68270300]- <1>     mov qword [party_func_count], 0
  2662 00027FD2 00000000            <1>
  2663 00027FD6 48C70425[48270300]- <1>     mov qword [party_err_msg_ptr], 0
  2663 00027FDE 00000000            <1>
  2664                              <1> 
  2665 00027FE2 488D3C25[38300300]  <1>     lea rdi, [party_var_used]
  2666 00027FEA B920000000          <1>     mov rcx, MAXVARS
  2667 00027FEF E887FEFFFF          <1>     call party_memzero
  2668 00027FF4 488D3C25[58390300]  <1>     lea rdi, [party_loc_used]
  2669 00027FFC B940000000          <1>     mov rcx, MAXLOCALS
