 15946                                  %include "mouse.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  PS/2 MOUSE  (polled - no IRQs, matching the keyboard)
     3                              <1> ; ============================================================
     4                              <1> ; The kernel is fully polled: the keyboard reads ports 0x64/0x60
     5                              <1> ; directly. The PS/2 mouse shares those same two ports, so this
     6                              <1> ; driver is polled too. The 8042 status register (port 0x64) bit
     7                              <1> ; 5 (0x20) tells us when the byte waiting in port 0x60 came from
     8                              <1> ; the auxiliary (mouse) device, which is exactly how get_char and
     9                              <1> ; kbd_poll keep mouse bytes out of the keyboard scancode parser.
    10                              <1> ;
    11                              <1> ;   mouse            toggles the mouse cursor on/off
    12                              <1> ;
    13                              <1> ; The cursor is a text-mode overlay: the cell under the pointer is
    14                              <1> ; saved, the cell is redrawn reverse-video, and every routine that
    15                              <1> ; mutates the screen re-applies the cursor afterwards (putchar,
    16                              <1> ; scroll_screen, clear_screen, scrollback_render, browse_render),
    17                              <1> ; so the pointer stays on top of scrolling text and full-screen
    18                              <1> ; redraws without ever baking a stale copy of the cursor into the
    19                              <1> ; screen buffer.
    20                              <1> 
    21                              <1> MOUSE_SCALE     equ 8           ; raw mickey counts per text cell (tune feel)
    22                              <1> MOUSE_CLAMP_X   equ VGA_COLS-1
    23                              <1> MOUSE_CLAMP_Y   equ VGA_ROWS-1
    24                              <1> MOUSE_BLOCK     equ 0x0FDB      ; char 0xDB, attr 0x0F: solid bright-white block
    25                              <1> MOUSE_WHEEL_STEP equ 1          ; Z clicks accumulated before one scroll step
    26                              <1> 
    27                              <1> ; ------------------------------------------------------------
    28                              <1> ;  PS/2 helpers
    29                              <1> ; ------------------------------------------------------------
    30                              <1> ; ps2_wait_ibf: block until the controller's input buffer is empty
    31                              <1> ; (bit 1 of status clear), i.e. it is safe to write 0x64/0x60.
    32                              <1> ps2_wait_ibf:
    33 000608A2 50                  <1>     push rax
    34 000608A3 E464                <1>     in al, 0x64
    35 000608A5 A802                <1>     test al, 2
    36 000608A7 75F9                <1>     jnz ps2_wait_ibf
    37 000608A9 58                  <1>     pop rax
    38 000608AA C3                  <1>     ret
    39                              <1> 
    40                              <1> ; ps2_wait_obf: block until the controller's output buffer is full
    41                              <1> ; (bit 0 of status set), i.e. a byte is waiting in port 0x60.
    42                              <1> ps2_wait_obf:
    43 000608AB 50                  <1>     push rax
    44 000608AC E464                <1>     in al, 0x64
    45 000608AE A801                <1>     test al, 1
    46 000608B0 74F9                <1>     jz ps2_wait_obf
    47 000608B2 58                  <1>     pop rax
    48 000608B3 C3                  <1>     ret
    49                              <1> 
    50                              <1> ; mouse_send_cmd: al = command byte for the mouse. Writes it via the
    51                              <1> ; 0xD4 "write to auxiliary device" prefix and waits for the 0xFA ACK.
    52                              <1> ; Returns CF=0 on ACK, CF=1 on timeout/no ACK (no mouse attached).
    53                              <1> mouse_send_cmd:
    54 000608B4 51                  <1>     push rcx
    55 000608B5 52                  <1>     push rdx
    56 000608B6 50                  <1>     push rax
    57 000608B7 88C1                <1>     mov cl, al                   ; command byte
    58 000608B9 E8E4FFFFFF          <1>     call ps2_wait_ibf
    59 000608BE B0D4                <1>     mov al, 0xD4                 ; write-to-aux prefix
    60 000608C0 E664                <1>     out 0x64, al
    61 000608C2 E8DBFFFFFF          <1>     call ps2_wait_ibf
    62 000608C7 88C8                <1>     mov al, cl
    63 000608C9 E660                <1>     out 0x60, al
    64 000608CB B9FFFFFF00          <1>     mov rcx, 0xFFFFFF             ; ACK timeout (generous: some mice are slow)
    65                              <1> .ack:
    66 000608D0 E464                <1>     in al, 0x64
    67 000608D2 A801                <1>     test al, 1
    68 000608D4 7505                <1>     jnz .have_byte
    69 000608D6 E2F8                <1>     loop .ack
    70 000608D8 F9                  <1>     stc                          ; timed out - assume no mouse
    71 000608D9 EB10                <1>     jmp .out
    72                              <1> .have_byte:
    73 000608DB E460                <1>     in al, 0x60
    74 000608DD 3CFA                <1>     cmp al, 0xFA                 ; ACK
    75 000608DF 7503                <1>     jne .bad
    76 000608E1 F8                  <1>     clc
    77 000608E2 EB07                <1>     jmp .out
    78                              <1> .bad:
    79 000608E4 3CFE                <1>     cmp al, 0xFE                 ; RESEND - retry once
    80 000608E6 7502                <1>     jne .timeout
    81 000608E8 E2E6                <1>     loop .ack
    82                              <1> .timeout:
    83 000608EA F9                  <1>     stc
    84                              <1> .out:
    85 000608EB 58                  <1>     pop rax
    86 000608EC 5A                  <1>     pop rdx
    87 000608ED 59                  <1>     pop rcx
    88 000608EE C3                  <1>     ret
    89                              <1> 
    90                              <1> ; ------------------------------------------------------------
    91                              <1> ;  mouse_init: put the PS/2 mouse into default stream mode with
    92                              <1> ;  data reporting enabled. Returns CF=0 on success, CF=1 on failure.
    93                              <1> mouse_init:
    94 000608EF 50                  <1>     push rax
    95 000608F0 E8ADFFFFFF          <1>     call ps2_wait_ibf
    96 000608F5 B0A8                <1>     mov al, 0xA8                 ; enable auxiliary device
    97 000608F7 E664                <1>     out 0x64, al
    98 000608F9 E8A4FFFFFF          <1>     call ps2_wait_ibf
    99 000608FE B020                <1>     mov al, 0x20                 ; read controller config byte
   100 00060900 E664                <1>     out 0x64, al
   101 00060902 E8A4FFFFFF          <1>     call ps2_wait_obf
   102 00060907 E460                <1>     in al, 0x60
   103 00060909 0C02                <1>     or al, 0x02                  ; bit1: enable aux IRQ (harmless if unused)
   104 0006090B 24DF                <1>     and al, 0xDF                 ; bit5 clear: aux clock enabled
   105 0006090D 50                  <1>     push rax
   106 0006090E E88FFFFFFF          <1>     call ps2_wait_ibf
   107 00060913 B060                <1>     mov al, 0x60                 ; write config byte
   108 00060915 E664                <1>     out 0x64, al
   109 00060917 E886FFFFFF          <1>     call ps2_wait_ibf
   110 0006091C 58                  <1>     pop rax
   111 0006091D E660                <1>     out 0x60, al
   112 0006091F B0F6                <1>     mov al, 0xF6                 ; set defaults (stream mode, reporting off)
   113 00060921 E88EFFFFFF          <1>     call mouse_send_cmd
   114 00060926 0F828E000000        <1>     jc .fail
   115                              <1>     ; IntelliMouse negotiation: sending sample rate 200 three times in a
   116                              <1>     ; row switches a wheel mouse into 4-byte packets (flags/X/Y/Z). The
   117                              <1>     ; device ID read confirms it - 0x03/0x04 = wheel present. If that
   118                              <1>     ; doesn't take, retry with the IntelliMouse Explorer sequence
   119                              <1>     ; (200/100/80). A mouse that answers neither stays in 3-byte mode.
   120 0006092C B1C8                <1>     mov cl, 200
   121 0006092E E88A000000          <1>     call mouse_set_rate
   122 00060933 7251                <1>     jc .wheel_off
   123 00060935 E883000000          <1>     call mouse_set_rate
   124 0006093A 724A                <1>     jc .wheel_off
   125 0006093C E87C000000          <1>     call mouse_set_rate
   126 00060941 7243                <1>     jc .wheel_off
   127 00060943 E8B3000000          <1>     call mouse_read_id
   128 00060948 723C                <1>     jc .wheel_off
   129 0006094A 3C03                <1>     cmp al, 0x03
   130 0006094C 742E                <1>     je .wheel_on
   131 0006094E 3C04                <1>     cmp al, 0x04
   132 00060950 742A                <1>     je .wheel_on
   133 00060952 B1C8                <1>     mov cl, 200
   134 00060954 E864000000          <1>     call mouse_set_rate
   135 00060959 722B                <1>     jc .wheel_off
   136 0006095B B164                <1>     mov cl, 100
   137 0006095D E85B000000          <1>     call mouse_set_rate
   138 00060962 7222                <1>     jc .wheel_off
   139 00060964 B150                <1>     mov cl, 80
   140 00060966 E852000000          <1>     call mouse_set_rate
   141 0006096B 7219                <1>     jc .wheel_off
   142 0006096D E889000000          <1>     call mouse_read_id
   143 00060972 7212                <1>     jc .wheel_off
   144 00060974 3C03                <1>     cmp al, 0x03
   145 00060976 7404                <1>     je .wheel_on
   146 00060978 3C04                <1>     cmp al, 0x04
   147 0006097A 750A                <1>     jne .wheel_off
   148                              <1> .wheel_on:
   149 0006097C C60425[B3100600]01  <1>     mov byte [mouse_wheel], 1
   150 00060984 EB08                <1>     jmp .have_wheel
   151                              <1> .wheel_off:
   152 00060986 C60425[B3100600]00  <1>     mov byte [mouse_wheel], 0
   153                              <1> .have_wheel:
   154 0006098E B0F4                <1>     mov al, 0xF4                 ; enable data reporting
   155 00060990 E81FFFFFFF          <1>     call mouse_send_cmd
   156 00060995 7223                <1>     jc .fail
   157 00060997 C60425[B0100600]00  <1>     mov byte [mouse_pkt_idx], 0
   158 0006099F C60425[B1100600]00  <1>     mov byte [mouse_acc_x], 0
   159 000609A7 C60425[B2100600]00  <1>     mov byte [mouse_acc_y], 0
   160 000609AF C60425[B4100600]00  <1>     mov byte [mouse_wheel_acc], 0
   161 000609B7 F8                  <1>     clc
   162 000609B8 EB01                <1>     jmp .out
   163                              <1> .fail:
   164 000609BA F9                  <1>     stc
   165                              <1> .out:
   166 000609BB 58                  <1>     pop rax
   167 000609BC C3                  <1>     ret
   168                              <1> 
   169                              <1> ; mouse_set_rate: cl = sample rate. Sends 0xF3, waits for its ACK, then
   170                              <1> ; sends the rate byte, waits for its ACK. CF=0 on both ACKs.
   171                              <1> mouse_set_rate:
   172 000609BD 50                  <1>     push rax
   173 000609BE 51                  <1>     push rcx
   174 000609BF 52                  <1>     push rdx
   175 000609C0 88CA                <1>     mov dl, cl                   ; rate byte
   176 000609C2 B0F3                <1>     mov al, 0xF3
   177 000609C4 E8EBFEFFFF          <1>     call mouse_send_cmd
   178 000609C9 722B                <1>     jc .fail
   179 000609CB E8D2FEFFFF          <1>     call ps2_wait_ibf
   180 000609D0 B0D4                <1>     mov al, 0xD4
   181 000609D2 E664                <1>     out 0x64, al
   182 000609D4 E8C9FEFFFF          <1>     call ps2_wait_ibf
   183 000609D9 88D0                <1>     mov al, dl
   184 000609DB E660                <1>     out 0x60, al
   185 000609DD B9FFFFFF00          <1>     mov rcx, 0xFFFFFF
   186                              <1> .ack:
   187 000609E2 E464                <1>     in al, 0x64
   188 000609E4 A801                <1>     test al, 1
   189 000609E6 7505                <1>     jnz .have_byte
   190 000609E8 E2F8                <1>     loop .ack
   191 000609EA F9                  <1>     stc
   192 000609EB EB0A                <1>     jmp .out
   193                              <1> .have_byte:
   194 000609ED E460                <1>     in al, 0x60
   195 000609EF 3CFA                <1>     cmp al, 0xFA
   196 000609F1 7503                <1>     jne .fail
   197 000609F3 F8                  <1>     clc
   198 000609F4 EB01                <1>     jmp .out
   199                              <1> .fail:
   200 000609F6 F9                  <1>     stc
   201                              <1> .out:
   202 000609F7 5A                  <1>     pop rdx
   203 000609F8 59                  <1>     pop rcx
   204 000609F9 58                  <1>     pop rax
   205 000609FA C3                  <1>     ret
   206                              <1> 
   207                              <1> ; mouse_read_id: 0xF2 -> ACK (consumed by mouse_send_cmd) then the device
   208                              <1> ; ID byte is read from port 0x60. Returns the ID in al, CF=0.
   209                              <1> mouse_read_id:
   210 000609FB 51                  <1>     push rcx
   211 000609FC B0F2                <1>     mov al, 0xF2
   212 000609FE E8B1FEFFFF          <1>     call mouse_send_cmd
   213 00060A03 720A                <1>     jc .fail
   214 00060A05 E8A1FEFFFF          <1>     call ps2_wait_obf
   215 00060A0A E460                <1>     in al, 0x60
   216 00060A0C F8                  <1>     clc
   217 00060A0D 59                  <1>     pop rcx
   218 00060A0E C3                  <1>     ret
   219                              <1> .fail:
   220 00060A0F F9                  <1>     stc
   221 00060A10 59                  <1>     pop rcx
   222 00060A11 C3                  <1>     ret
   223                              <1> 
   224                              <1> ; mouse_disable_reporting: best-effort stop of the data stream
   225                              <1> ; (used when the cursor is toggled off so the mouse stops flooding
   226                              <1> ; port 0x60 while idle).
   227                              <1> mouse_disable_reporting:
   228 00060A12 50                  <1>     push rax
   229 00060A13 803C25[A4100600]00  <1>     cmp byte [mouse_ena], 0
   230 00060A1B 7407                <1>     je .out
   231 00060A1D B0F5                <1>     mov al, 0xF5                 ; disable data reporting
   232 00060A1F E890FEFFFF          <1>     call mouse_send_cmd
   233                              <1> .out:
   234 00060A24 58                  <1>     pop rax
   235 00060A25 C3                  <1>     ret
   236                              <1> 
   237                              <1> ; ------------------------------------------------------------
   238                              <1> ;  Cursor overlay
   239                              <1> ; ------------------------------------------------------------
