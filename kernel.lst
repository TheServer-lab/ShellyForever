 14692                                  ; --- filesystem storage ---
 14693                                  ; One flat node table shared by every mounted volume. The OS volume lives
 14694                                  ; in nodes 0..OS_NODES; mount slot k owns nodes VOL_NODES*(k+1)..VOL_NODES*(k+2)-1.
 14695                                  ; Each volume is persisted separately (superblock + node arrays) to its own
 14696                                  ; device - see the SFFS v2 layout notes near the top of this file.
 14697                                  ;
 14698                                  ; IMPORTANT: ata_read_sector/ata_write_sector always move a full 512-byte
 14699                                  ; sector, so every buffer a sector is staged in/out of must hold 512 bytes.
 14700                                  ; node_type and fs_parent_scratch are exactly that: the type/parent reads
 14701                                  ; in vol_read/vol_write go straight at a whole sector each, and anything
 14702                                  ; smaller would silently overflow into the adjacent arrays (which showed up
 14703                                  ; as a black screen after 'mount' corrupted the node table).
 14704 0001F244 90<rep 4h>              ALIGN 8
 14705 0001F248 00<rep 200h>            fs_super_buf:   times 512 db 0        ; scratch for reading/building superblocks
 14706 0001F448 00<rep 28h>             fmt_new_label:      times 40 db 0     ; label being applied by the current 'fmt'
 14707 0001F470 00<rep 28h>             orig_label_buf:      times 40 db 0    ; scratch: a device's generated "diskN" label
 14708 0001F498 00<rep Ch>              orig_label_num_tmp:  times 12 db 0    ; scratch: decimal digits for gen_orig_label
 14709 0001F4A4 00<rep 200h>            fs_parent_scratch: times 512 db 0     ; staging for one full parent sector (512B)
 14710 0001F6A4 00<rep 40h>             mount_label:   times MAX_MOUNTS*32 db 0     ; label of each mounted volume
 14711 0001F6E4 00<rep 2h>              mount_device:  times MAX_MOUNTS db 0        ; device id each volume came from
 14712 0001F6E6 00<rep 2h>              mount_used:    times MAX_MOUNTS db 0        ; 1 = slot in use
 14713                                  ; type sector = 512B per volume (base 0/64/128), so this must span the max
 14714                                  ; extent of a sector write: base + 512. node indices still index it by node
 14715                                  ; (1 byte per node); the per-volume padding holds whatever the sector has.
 14716 0001F6E8 00<rep 600h>            node_type:    times 512 * (1 + MAX_MOUNTS) db 0
 14717 0001FCE8 0000<rep C0h>           node_parent:  times MAX_NODES dw 0
 14718 0001FE68 00<rep 1800h>           node_name:    times MAX_NODES*NAME_LEN db 0
 14719 00021668 00<rep 7800h>           node_content: times MAX_NODES*CONTENT_LEN db 0
 14720 00028E68 FFFF<rep C0h>           node_next:    times MAX_NODES dw 0xFFFF   ; 0xFFFF = end of chain (or no chain)
 14721                                  
 14722 00028FE8 00                      fs_loaded_from_disk: db 0
 14723 00028FE9 01                      fs_disk_available:   db 1     ; optimistic default; cleared on first ATA failure
 14724 00028FEA 00                      boot_device:         db 0     ; device id holding the OS volume - normally 0
 14725                                                                 ; (legacy ATA primary master), but fs_load moves
 14726                                                                 ; this to an AHCI slot (4+) when device 0 never
 14727                                                                 ; responds and a SATA disk was found instead
 14728 00028FEB 00                      fs_name_too_long:    db 0     ; set by fs_create_node when a name won't fit
 14729 00028FEC 00                      fs_layout_v3:        db 0     ; set by vol_read: 1 = on-disk v3 (has node_next sector)
 14730                                  
 14731 00028FED 00                      mkfl_test_flag:      db 0     ; set by cmd_mkfl when -test appears in arg2/3/4
 14732 00028FEE 90<rep 2h>              ALIGN 8
 14733 00028FF0 0000000000000000        mkfl_content_ptr:     dq 0     ; points at the effective content string for -test reporting
 14734                                  
 14735                                  ALIGN 8
 14736 00028FF8 F001                    ata_port_base: dw 0x1F0        ; 0x1F0 primary channel, 0x170 secondary
 14737 00028FFA E0                      ata_drive_sel: db 0xE0         ; 0xE0 master, 0xF0 slave
 14738                                  
 14739                                  ; --- AHCI (SATA) driver state ---
 14740 00028FFB 00                      pci_scratch_hdrtype: db 0
 14741 00028FFC 00                      ahci_pci_bus:     db 0
 14742 00028FFD 00                      ahci_pci_dev:     db 0
 14743 00028FFE 00                      ahci_pci_func:    db 0
 14744 00028FFF 90                      ALIGN 4
 14745 00029000 00000000                ahci_abar:        dd 0             ; physical base of the AHCI MMIO register window
 14746 00029004 00000000                ahci_ports_impl:  dd 0             ; PI bitmap read from the HBA at boot
 14747 00029008 00                      ahci_port_count:  db 0             ; how many of ahci_port_num/base are valid
 14748 00029009 00000000<rep 4h>        ahci_port_num:    times AHCI_MAX_PORTS dd 0   ; slot -> real HBA port number
 14749 00029019 90<rep 7h>              ALIGN 8
 14750 00029020 0000000000000000-       ahci_port_base:   times AHCI_MAX_PORTS dq 0   ; slot -> port register base ptr
 14750 00029020 <rep 4h>           
 14751 00029040 00                      disk_use_ahci:    db 0             ; set by disk_select_device: 0=ATA, 1=AHCI
 14752 00029041 00                      ahci_cur_slot:    db 0             ; which AHCI slot is currently selected
 14753 00029042 00                      ahci_op_cmd:      db 0             ; pending ATA command byte (read vs write)
 14754 00029043 00                      ahci_op_write:    db 0             ; 1 if the pending op is a write
 14755                                  
 14756                                  ; --- RTL8139 NIC driver state ---
 14757 00029044 00                      nic_present:     db 0             ; 1 = NIC found and rings live
 14758 00029045 00                      nic_pci_bus:     db 0
 14759 00029046 00                      nic_pci_dev:     db 0
 14760 00029047 00                      nic_pci_func:    db 0
 14761                                  ALIGN 4
 14762 00029048 00000000                nic_io_base:     dd 0             ; BAR0 I/O port base (RTL8139)
 14763 0002904C 00                      nic_driver_type: db 0             ; 0 = rtl8139, 1 = e1000; set by nic_init
 14764 0002904D 90<rep 3h>              ALIGN 4
 14765 00029050 00000000                nic_mmio_base:   dd 0             ; BAR0 MMIO physical base (e1000)
 14766 00029054 00000000                nic_rx_seen:     dd 0             ; diagnostic: raw frames seen since last reset
 14767 00029058 00<rep 6h>              nic_mac:         times 6 db 0
 14768 0002905E 0A00020F                nic_ip:          db 10, 0, 2, 15  ; static config (QEMU slirp defaults)
 14769 00029062 FFFFFF00                nic_mask:        db 255, 255, 255, 0
 14770 00029066 0A000202                nic_gw:          db 10, 0, 2, 2
 14771 0002906A 0A000203                nic_dns:         db 10, 0, 2, 3
 14772 0002906E 00000000                nic_capr:        dd 0             ; software RX read pointer (ring offset)
 14773 00029072 00                      nic_ihl:         db 0             ; IPv4 header length (bytes) of current frame
 14774 00029073 0042                    nic_ip_id:       dw 0x4200        ; IPv4 identification counter
 14775                                  NIC_ARP_CACHE_ENTRIES equ 4
 14776 00029075 00<rep 28h>             nic_arp_cache:   times NIC_ARP_CACHE_ENTRIES*10 db 0   ; per entry: 6B MAC + 4B IP
 14777 0002909D 00                      nic_arp_next:    db 0
 14778 0002909E 00                      nic_arp_tried:   db 0             ; unused now (nic_arp_resolve tracks its own
 14779                                                                     ; round counters in registers) - kept so
 14780                                                                     ; existing reset-on-init writes stay valid
 14781 0002909F 00                      nic_last_fail_reason: db 0        ; set by nic_arp_resolve on CF=1: 0 = raw
 14782                                                                     ; broadcast TX itself failed (hardware/
 14783                                                                     ; timeout - see nic_send_raw_rtl8168 diag),
 14784                                                                     ; 1 = broadcast sent fine, just never got
 14785                                                                     ; an ARP reply back in time
 14786 000290A0 00                      nic_last_tx_ctx: db 0             ; 0 = data/segment frame, 1 = ARP broadcast -
 14787                                                                     ; set right before every nic_send_raw call so
 14788                                                                     ; a failure dump can say which frame it was
 14789 000290A1 00                      nic_tx_desc:     db 0             ; C-mode TX descriptor currently in use (0..3)
 14790 000290A2 00000000                nic_bounce_target: dd 0           ; IP the bounce/monitor loop is pinging
 14791 000290A6 3412                    nic_echo_id:     dw 0x1234
 14792 000290A8 0100                    nic_echo_seq:    dw 1
 14793 000290AA 00                      nic_echo_got:    db 0             ; 1 = matching echo reply received
 14794 000290AB 00                      nic_echo_retry:  db 0             ; bounce retry flag
 14795 000290AC 0000                    nic_echo_seq_rcv: dw 0
 14796 000290AE 00000000                nic_echo_src_ip: dd 0             ; source IP of the last matching reply
 14797 000290B2 0100                    nic_dns_id:      dw 1
 14798 000290B4 0000                    nic_dns_query_id: dw 0
 14799 000290B6 00                      nic_dns_done:    db 0
 14800 000290B7 00                      nic_dns_retry:   db 0
 14801 000290B8 00000000                nic_dns_result:  dd 0
 14802 000290BC 00000000                dhcp_xid:        dd 0
 14803 000290C0 00000000                dhcp_offered_ip: dd 0
 14804 000290C4 00                      dhcp_done:       db 0
 14805 000290C5 00                      dhcp_retries:    db 0
 14806 000290C6 00                      dhcp_msg_type:   db 0      ; DHCP message type (53) seen in the last offer/ack
 14807 000290C7 00                      nic_diag_verbose: db 0     ; 1 = netpoll prints a summary of every frame it sees
 14808 000290C8 00                      nic_diag_rx_count: db 0    ; caps how many "rx: ..." lines netpoll will print
 14809                                                             ; per dhcp/bounce attempt - on a real LAN with
 14810                                                             ; constant background broadcast traffic this was
 14811                                                             ; still unbounded even after the tx dump got
 14812                                                             ; throttled, and could flood the screen across a
 14813                                                             ; long multi-retry wait on its own
 14814 000290C9 00                      nic_dns_seen:    db 0      ; 1 = the router sent DHCP option 6 (DNS server)
 14815                                                             ; at some point this lease - if it never does,
 14816                                                             ; cmd_dhcp falls back to using the gateway as
 14817                                                             ; DNS, since many consumer routers proxy DNS on
 14818                                                             ; their own LAN IP without advertising option 6
 14819 000290CA 00                      nic_diag_tx_dumped: db 0   ; 1 = the full tx hex dump has already fired this
 14820                                                             ; dhcp session - keeps retries from re-flooding
 14821                                                             ; the screen with the same packet layout
 14822 000290CB FFFFFFFFFFFF            mac_broadcast:   db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
 14823                                  
 14824                                  ; --- NIC buffers (all resb, identity-mapped, so linked = physical addr) ---
 14825 000290D1 90<rep Fh>              ALIGN 16
 14826 000290E0 00<rep 2000h>           nic_rx_ring:     times NIC_RX_RING_SIZE db 0    ; 8KB DMA RX ring
 14827                                  ALIGN 16
 14828 0002B0E0 00<rep 800h>            nic_tx_buf:      times NIC_TX_BUF_SIZE db 0     ; 2KB frame build/DMA buffer
 14829 0002B8E0 00<rep 1000h>           net_build_buf:   times 4096 db 0                ; dns query / udp / icmp / tcp build area
 14830                                  
 14831                                  ; --- e1000 descriptor rings + RX buffers (identity-mapped; the linked
 14832                                  ; address doubles as the physical address the chip DMAs into/out of, same
 14833                                  ; trick as nic_rx_ring/nic_tx_buf above) ---
 14834                                  ALIGN 16
 14835 0002C8E0 00<rep 80h>             e1000_rx_desc:   times E1000_RX_DESC_COUNT * 16 db 0
 14836                                  ALIGN 16
 14837 0002C960 00<rep 80h>             e1000_tx_desc:   times E1000_TX_DESC_COUNT * 16 db 0
 14838                                  ALIGN 16
 14839 0002C9E0 00<rep 4000h>           e1000_rx_bufs:   times E1000_RX_DESC_COUNT * E1000_RX_BUF_SIZE db 0
 14840                                  ALIGN 4
 14841 000309E0 00000000                e1000_rx_idx:    dd 0             ; software head: next descriptor to check for DD
 14842 000309E4 00000000                e1000_tx_idx:    dd 0             ; next TX descriptor slot to use
 14843                                  
 14844                                  ; e1000_dev_ids: PCI device ids (vendor 0x8086) pci_find_e1000 matches
 14845                                  ; against, spanning the common real-hardware e1000/e1000e generations:
 14846                                  ; 82540/82541/82544/82545/82546/82547 (PCI/PCIe PRO/1000) and 82571-82583
 14847                                  ; (server/desktop PRO/1000 PT/PM/GT). QEMU's "e1000" model reports 0x100E.
 14848                                  e1000_dev_ids:
 14849 000309E8 0E100F100410011010-         dw 0x100E, 0x100F, 0x1004, 0x1001, 0x1010, 0x1012, 0x1013, 0x1019
 14849 000309F1 10121013101910     
 14850 000309F8 1D101E102610271028-         dw 0x101D, 0x101E, 0x1026, 0x1027, 0x1028, 0x1075, 0x1076, 0x1077
 14850 00030A01 10751076107710     
 14851 00030A08 78107C105E105F1060-         dw 0x1078, 0x107C, 0x105E, 0x105F, 0x1060, 0x108B, 0x108C, 0x109A
 14851 00030A11 108B108C109A10     
 14852 00030A18 B910D310EA10F5100C-         dw 0x10B9, 0x10D3, 0x10EA, 0x10F5, 0x150C
 14852 00030A21 15                 
 14853                                  E1000_DEV_ID_COUNT equ ($ - e1000_dev_ids) / 2
 14854                                  
 14855                                  ; --- RTL8168 descriptor rings + RX buffers (identity-mapped) ---
 14856 00030A22 90<rep DEh>             ALIGN 256
 14857 00030B00 00<rep 80h>             rtl_rx_desc:     times RTL_RX_DESC_COUNT * 16 db 0
 14858 00030B80 90<rep 80h>             ALIGN 256
 14859 00030C00 00<rep 80h>             rtl_tx_desc:     times RTL_TX_DESC_COUNT * 16 db 0
 14860                                  ALIGN 16
 14861 00030C80 00<rep 4000h>           rtl_rx_bufs:     times RTL_RX_DESC_COUNT * RTL_RX_BUF_SIZE db 0
 14862                                  ALIGN 4
 14863 00034C80 00000000                rtl_rx_idx:      dd 0             ; software head: next descriptor to check for OWN=0
 14864 00034C84 00000000                rtl_tx_idx:      dd 0             ; next TX descriptor slot to use
 14865 00034C88 00000000                nic_hwver_raw:   dd 0             ; raw TxConfig value captured right after
 14866                                                                     ; reset, before our own TCR write - used
 14867                                                                     ; to identify the exact chip revision
 14868 00034C8C 00                      nic_tx_wait_start:   db 0         ; CMOS seconds value when the current TX
 14869                                                                     ; wait began (nic_send_raw_rtl8168)
 14870 00034C8D 00                      nic_tx_wait_elapsed: db 0         ; real wall-clock seconds actually spent
 14871                                                                     ; waiting before the last TX failure was
 14872                                                                     ; declared - objective proof of whether the
 14873                                                                     ; wait budget genuinely ran out or something
 14874                                                                     ; failed fast, instead of guessing from
 14875                                                                     ; how long a failure "felt" on screen
 14876 00034C8E 00                      nic_tx_wait_end:     db 0         ; raw rtc_sec_now() reading at the moment
 14877                                                                     ; .rtks_err fires - printed alongside
 14878                                                                     ; nic_tx_wait_start so a bad elapsed
 14879                                                                     ; computation can be told apart from a
 14880                                                                     ; genuinely-fast failure, instead of
 14881                                                                     ; trusting the subtracted value alone
 14882 00034C8F 00                      nic_tx_wait_ticks:   db 0         ; number of real second-boundary ticks
 14883                                                                     ; actually observed by the wait loop
 14884                                                                     ; before giving up (should be ~budget+1
 14885                                                                     ; on a real timeout; a low number here
 14886                                                                     ; means the loop exited some other way)
 14887                                  
 14888                                  ; rtl_dev_ids: PCI device ids (vendor 0x10EC) pci_find_rtl8168 matches
 14889                                  ; against - the RTL8169-compatible C+ descriptor interface shared by the
 14890                                  ; common real-hardware gigabit Realtek chips. Deliberately doesn't include
 14891                                  ; the 2.5GbE RTL8125, which uses a different descriptor/register layout.
 14892                                  rtl_dev_ids:
 14893 00034C90 6881698161813681            dw 0x8168, 0x8169, 0x8161, 0x8136
 14894                                  RTL_DEV_ID_COUNT equ ($ - rtl_dev_ids) / 2
 14895                                  
 14896 00034C98 00<rep 600h>            nic_rx_frame:    times 1536 db 0                ; wrap-reassembly staging
 14897 00035298 00000000                nic_rx_len:      dd 0                           ; bytes in nic_rx_frame
 14898 0003529C 00<rep 8h>              dec_tmp_buf:     times 8 db 0
 14899 000352A4 00<rep 14h>             net_ip_str:      times 20 db 0
 14900                                  
 14901                                  ; --- minimal polled TCP engine state (Milestone C) ---
 14902 000352B8 00                      tcp_state:     db 0          ; 0 idle, 1 syn_sent, 2 established, 3 closed
 14903 000352B9 00                      tcp_retry:     db 0          ; retransmit round count in the current phase (0..TCP_MAX_RETRIES)
 14904 000352BA 00                      tcp_wait_ticks: db 0         ; whole-seconds left in the current wait round (see TCP_ROUND_SECS)
 14905 000352BB 00                      tcp_rx_got:    db 0          ; 1 = peer payload landed in tcp_rx_buf
 14906 000352BC 00                      tcp_fin_got:   db 0          ; 1 = peer sent FIN
 14907 000352BD 00                      tcp_rst_got:   db 0          ; 1 = peer sent RST
 14908 000352BE 90<rep 2h>              ALIGN 4
 14909 000352C0 00000000                tcp_isn:       dd 0          ; our initial sequence number (SYN)
 14910 000352C4 00000000                tcp_cur_seq:   dd 0          ; seq field used by the next outgoing segment
 14911 000352C8 00000000                tcp_cur_ack:   dd 0          ; ack field used by the next outgoing segment
 14912 000352CC 00000000                tcp_peer_seq:  dd 0          ; peer's ISN from the SYN-ACK
 14913 000352D0 00000000                tcp_last_ack:  dd 0          ; ack number from the most recent peer segment
 14914 000352D4 00000000                tcp_peer_ip:   dd 0
 14915 000352D8 0000                    tcp_peer_port: dw 0
 14916 000352DA 0000                    tcp_my_port:   dw 0
 14917 000352DC 00000000                tcp_rx_len:    dd 0
 14918 000352E0 00000000                tcp_tx_len:    dd 0
 14919 000352E4 00000000                tcp_rx_prev:   dd 0          ; rx length at the previous idle-check tick
 14920 000352E8 0000000000000000        tcp_err_msg:   dq 0          ; ptr to the last tcp/http error message (0 = none)
 14921 000352F0 00<rep Ah>              tcp_dec_buf:   times 10 db 0
 14922 000352FA 00<rep 600h>            tcp_rx_buf:    times TCP_PAYLOAD_MAX db 0
 14923 000358FA 00<rep 600h>            tcp_tx_buf:    times TCP_PAYLOAD_MAX db 0
 14924                                  
 14925                                  ; --- HTTP take / give buffers (Milestone D) ---
 14926 00035EFA 00<rep 40h>             http_host_buf:   times 64 db 0
 14927 00035F3A 00<rep 80h>             http_path_buf:   times 128 db 0
 14928 00035FBA 0000                    http_port:       dw 0
 14929 00035FBC 00000000                http_body_len:   dd 0
 14930 00035FC0 00<rep 4B0h>            http_tx_big:     times HTTP_TX_MAX db 0
 14931 00036470 00<rep C00h>            http_rx_buf:     times HTTP_RX_BUF_SIZE db 0
 14932                                  
 14933                                  ; Command list (1KB/port, must be 1KB-aligned), FIS receive area (256B/port,
 14934                                  ; must be 256B-aligned), and command table (256B/port, must be 128B-aligned,
 14935                                  ; and big enough for a 20-byte Reg H2D FIS plus one 16-byte PRDT entry) for
 14936                                  ; each AHCI port slot we bring up. Identity-mapped, so these labels' linked
 14937                                  ; addresses double as the physical addresses the HBA needs - same trick the
 14938                                  ; rest of this file already relies on for fs_super_buf and friends.
 14939 00037070 90<rep 390h>            ALIGN 1024
 14940 00037400 00<rep 1000h>           ahci_clb:    times AHCI_MAX_PORTS*1024 db 0
 14941                                  ALIGN 256
 14942 00038400 00<rep 400h>            ahci_fis:    times AHCI_MAX_PORTS*256 db 0
 14943                                  ALIGN 128
 14944 00038800 00<rep 400h>            ahci_cmdtbl: times AHCI_MAX_PORTS*256 db 0
 14945                                  
 14946 00038C00 0000<rep 10h>           path_stack:   times 16 dw 0
 14947                                  
 14948                                  ; --- scratch for fs_resolve_path ---
 14949 00038C20 00<rep 40h>             path_comp_buf: times 64 db 0     ; one path component at a time
 14950 00038C60 00<rep 40h>             leaf1_buf:      times 64 db 0    ; resolved leaf name for arg1_buf paths
 14951 00038CA0 00<rep 40h>             leaf2_buf:      times 64 db 0    ; resolved leaf name for arg2_buf paths
 14952                                  
 14953                                  ; --- line editing buffers ---
 14954 00038CE0 00<rep DCh>             line_buf: times LINE_MAX db 0
 14955 00038DBC 00<rep DCh>             chain_scan_buf: times LINE_MAX db 0  ; scratch copy for ; chaining
 14956 00038E98 00<rep 20h>             cmd_buf:  times 32  db 0
 14957 00038EB8 00<rep 60h>             arg1_buf: times 96  db 0
 14958 00038F18 00<rep A0h>             arg2_buf: times 160 db 0
 14959 00038FB8 00<rep 20h>             arg3_buf: times 32  db 0             ; for flags (-force, -silent, -info)
 14960 00038FD8 00<rep 20h>             arg4_buf: times 32  db 0             ; for additional flags
 14961                                  
 14962                                  ; --- "~" pipe scratch (see process_segment) ---
 14963 00038FF8 00                      chain_is_rr:       db 0             ; 0 = process_chain, 1 = process_chain_rr
 14964 00038FF9 00<rep DCh>             pipe_left_buf:     times LINE_MAX db 0
 14965 000390D5 00<rep DCh>             pipe_right_buf:    times LINE_MAX db 0
 14966 000391B1 00                      pipe_capture_on:   db 0
 14967 000391B2 90<rep 6h>              ALIGN 8
 14968 000391B8 0000000000000000        pipe_capture_len:  dq 0
 14969 000391C0 00<rep C0h>             pipe_capture_buf:  times PIPE_CAP_MAX db 0
 14970 00039280 2200                    pipe_quote_str:       db '"', 0
 14971 00039282 202200                  pipe_space_quote_str: db ' ', '"', 0
 14972                                  
 14973                                  ; --- variables table (used by assignment, show, and calc) ---
 14974 00039285 90<rep 3h>              ALIGN 8
 14975 00039288 00<rep 200h>            var_name:  times MAX_VARS*VAR_NAME_LEN db 0
 14976 00039488 0000000000000000-       var_value: times MAX_VARS dq 0
 14976 00039488 <rep 10h>          
 14977 00039508 00<rep 10h>             var_used:  times MAX_VARS db 0
 14978                                  
 14979 00039518 00<rep 180h>            alias_names:  times MAX_ALIASES*ALIAS_NAME_LEN db 0
 14980 00039698 00<rep A50h>            alias_bodies: times MAX_ALIASES*ALIAS_BODY_LEN db 0
 14981 0003A0E8 00<rep Ch>              alias_used:   times MAX_ALIASES db 0
 14982 0003A0F4 00<rep 20h>             ali_name_tmp: times ALIAS_NAME_LEN db 0   ; scratch: name parsed by try_handle_ali_line
 14983 0003A114 00<rep DCh>             ali_body_tmp: times ALIAS_BODY_LEN db 0   ; scratch: body parsed by try_handle_ali_line
 14984 0003A1F0 00                      alias_match_idx: db 0                     ; set by dispatch before jmp cmd_alias_invoke
 14985 0003A1F1 00                      alias_depth:     db 0                     ; nested alias-invocation depth (recursion guard)
 14986                                  
