 15943                                  %include "tls.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  tls.asm  --  minimal TLS 1.3 client (Phase 3)
     3                              <1> ;
     4                              <1> ;  A single-cipher TLS 1.3 client on top of tcp.asm's polled
     5                              <1> ;  engine: ClientHello builder, ServerHello parser, the RFC 8446
     6                              <1> ;  7.1 zero-PSK key schedule, ChaCha20-Poly1305 record layer
     7                              <1> ;  (TLS_CHACHA20_POLY1305_SHA256, the cipher suite chosen in
     8                              <1> ;  Phase 2), transcript tracking, ServerFinished verification,
     9                              <1> ;  ClientFinished, and application traffic secret derivation.
    10                              <1> ;  No certificate validation by design (see phases.txt scope) --
    11                              <1> ;  Certificate / CertificateVerify are parsed only enough to skip
    12                              <1> ;  them while keeping the transcript in sync.
    13                              <1> ;
    14                              <1> ;  Verified byte-for-byte against tls_ref.py (the Python oracle),
    15                              <1> ;  which is itself validated against real OpenSSL in both
    16                              <1> ;  directions. tls_ref.py `vect` emits the exact bytes this module
    17                              <1> ;  must reproduce; the WSL ELF harness replays those vectors
    18                              <1> ;  through the shimmed transport.
    19                              <1> ;
    20                              <1> ;  Kernel conventions (Phase 1 note in phases.txt): NO `section`
    21                              <1> ;  directives -- kernel.asm is a flat ORG'd binary and buffers are
    22                              <1> ;  `times N db 0`, not `resb`. Every function below saves and
    23                              <1> ;  restores every register it touches. CF=0 success / CF=1 failure
    24                              <1> ;  where noted. Big-endian wire values are written byte-by-byte.
    25                              <1> ;
    26                              <1> ;  Entry points:
    27                              <1> ;    tls_connect_and_handshake   rsi=hostname(null-term), dx=port.
    28                              <1> ;                                TCP connect (reusing tcp.asm's
    29                              <1> ;                                setup) + full TLS handshake.
    30                              <1> ;                                CF=0 ready, CF=1 error printed.
    31                              <1> ;    tls_handshake_after_connect assumes TCP established (tcp_state
    32                              <1> ;                                == 2, peer/ports/seq set), does the
    33                              <1> ;                                TLS handshake only. CF=0 ready.
    34                              <1> ;    tls_pump                    drain tcp_rx_buf into tls_rx_buf
    35                              <1> ;                                (call netpoll first in the kernel;
    36                              <1> ;                                the harness shims both).
    37                              <1> ;    tls_poll_single_frame       CF=0 + dl=ct, ecx=payload len,
    38                              <1> ;                                rsi=payload ptr (inside tls_rx_buf)
    39                              <1> ;                                when one full TLS record is present;
    40                              <1> ;                                CF=1 otherwise.
    41                              <1> ;    tls_record_encrypt / tls_record_decrypt  app-data record layer
    42                              <1> ;                                for Phase 4.
    43                              <1> ; ============================================================
    44                              <1> 
    45                              <1> ; ---- optional test-harness tracing hooks ----
    46                              <1> ; Real kernel builds never define TLS_TRACE, so these expand to
    47                              <1> ; nothing and tls.asm has zero undefined symbols on its own. The
    48                              <1> ; Linux test harness %defines TLS_TRACE 1 before %including this
    49                              <1> ; file and provides its own harness_trace_pump/got/consume labels.
    50                              <1> %macro TLS_TRACE_PUMP 0
    51                              <1> %ifdef TLS_TRACE
    52                              <1>     call harness_trace_pump
    53                              <1> %endif
    54                              <1> %endmacro
    55                              <1> %macro TLS_TRACE_GOT 0
    56                              <1> %ifdef TLS_TRACE
    57                              <1>     call harness_trace_got
    58                              <1> %endif
    59                              <1> %endmacro
    60                              <1> %macro TLS_TRACE_CONSUME 0
    61                              <1> %ifdef TLS_TRACE
    62                              <1>     call harness_trace_consume
    63                              <1> %endif
    64                              <1> %endmacro
    65                              <1> 
    66                              <1> ; ---- wire constants (RFC 8446) ----
    67                              <1> TLS_VERSION_13          equ 0x0304
    68                              <1> LEGACY_VERSION          equ 0x0303
    69                              <1> SUITE_CHACHA20_POLY1305 equ 0x1303
    70                              <1> GROUP_X25519            equ 0x001D
    71                              <1> 
    72                              <1> CT_CHANGE_CIPHER_SPEC   equ 20
    73                              <1> CT_ALERT                equ 21
