 17061                                  ; .insert_char (in: al = character to insert at the cursor). Shifts
 17062                                  ; buf[r11..r8-1] right by one, stores al at r9+r11, redraws the
 17063                                  ; widened tail, and advances r11/the screen cursor past the inserted
 17064                                  ; character. No-op if the buffer is already full. Clobbers
 17065                                  ; rax/rbx/rcx/rdx/rsi/rdi; updates r8/r11.
 17066                                  .insert_char:
 17067 00071462 4D39D0                      cmp r8, r10
 17068 00071465 7336                        jae .ic_full
 17069 00071467 88C2                        mov dl, al                   ; stash the typed char - the shift below uses al as scratch
 17070 00071469 4D39D8                      cmp r8, r11
 17071 0007146C 7416                        je .ic_no_shift
 17072 0007146E 4C89C6                      mov rsi, r8
 17073                                  .ic_shift:
 17074 00071471 48FFCE                      dec rsi
 17075 00071474 418A0431                    mov al, [r9 + rsi]
 17076 00071478 4188443101                  mov [r9 + rsi + 1], al
 17077 0007147D 4C39DE                      cmp rsi, r11
 17078 00071480 7402                        je .ic_no_shift
 17079 00071482 EBED                        jmp .ic_shift
 17080                                  .ic_no_shift:
 17081 00071484 88D0                        mov al, dl
 17082 00071486 43880419                    mov [r9 + r11], al
 17083 0007148A 49FFC0                      inc r8
 17084 0007148D 4831C9                      xor rcx, rcx                 ; buffer just grew - nothing stale to blank
 17085 00071490 E809000000                  call .redraw_tail
 17086 00071495 49FFC3                      inc r11
 17087 00071498 E89AF7FFFF                  call cursor_step_right
 17088                                  .ic_full:
 17089 0007149D C3                          ret
 17090                                  
 17091                                  ; .redraw_tail (in: rcx = extra blank cells to print after the tail, 0 or
 17092                                  ; 1). Redraws buf[r11..r8-1] then rcx blanks via putchar, then walks the
 17093                                  ; hardware cursor back left until it's on r11's screen cell again. Every
 17094                                  ; caller above has the hardware cursor sitting exactly on r11's screen
 17095                                  ; cell when it calls this. Preserves r8/r9/r10/r11; clobbers
 17096                                  ; rax/rbx/rcx/rdx/rsi/rdi.
 17097                                  .redraw_tail:
 17098 0007149E 50                          push rax
 17099 0007149F 53                          push rbx
 17100 000714A0 52                          push rdx
