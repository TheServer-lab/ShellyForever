 14786                                  %include "party.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  PARTY (.pa) LANGUAGE — LEXER
     3                              <1> ; ============================================================
     4                              <1> ; Stage 1 of the Party interpreter: turns raw script text into a flat
     5                              <1> ; array of tokens. No parsing/execution here yet - that's the next
     6                              <1> ; module. cmd_party currently just reads the file, lexes it, and
     7                              <1> ; prints the token stream so the lexer can be verified on its own
     8                              <1> ; before anything is built on top of it.
     9                              <1> ;
    10                              <1> ; Design:
    11                              <1> ;   - Token = 8 bytes: {type:u8, reserved:u8, length:u16, start:u32}
    12                              <1> ;     start/length point INTO the source buffer (fs_io_buf) rather
    13                              <1> ;     than copying text out - cheap and matches how the rest of the
    14                              <1> ;     kernel already slices strings in place (see fs_resolve_path).
    15                              <1> ;   - Newlines are real tokens (TOK_NEWLINE), not whitespace, since
    16                              <1> ;     Party statements are newline-terminated - the parser needs to
    17                              <1> ;     see where a statement ends.
    18                              <1> ;   - "-45" is NOT a single token: '-' lexes as TOK_MINUS and 45 as
    19                              <1> ;     TOK_INT; unary minus is a parser concern, same approach as the
    20                              <1> ;     existing calc evaluator (eval_expr) uses.
    21                              <1> ;   - Keyword vs identifier is decided here (scan word, then compare
    22                              <1> ;     against the keyword list) via the existing str_eq helper.
    23                              <1> ; ============================================================
    24                              <1> 
    25                              <1> PARTY_MAX_TOKENS equ 512     ; token array capacity
    26                              <1> PARTY_IDENT_MAX  equ 40      ; longest ident/keyword this lexer buffers
    27                              <1> 
    28                              <1> ; ---- token types ----
    29                              <1> TOK_EOF     equ 0
    30                              <1> TOK_IDENT   equ 1
    31                              <1> TOK_STR     equ 2
    32                              <1> TOK_INT     equ 3
    33                              <1> TOK_FLOAT   equ 4
    34                              <1> TOK_TRUE    equ 5
    35                              <1> TOK_FALSE   equ 6
    36                              <1> TOK_VARS    equ 7
    37                              <1> TOK_IF      equ 8
    38                              <1> TOK_ELSE    equ 9
    39                              <1> TOK_WHILE   equ 10
    40                              <1> TOK_FUNC    equ 11
    41                              <1> TOK_RETURN  equ 12
    42                              <1> TOK_DISPLAY equ 13
    43                              <1> TOK_NEWLINE equ 14
    44                              <1> TOK_LBRACE  equ 15
    45                              <1> TOK_RBRACE  equ 16
    46                              <1> TOK_LPAREN  equ 17
    47                              <1> TOK_RPAREN  equ 18
    48                              <1> TOK_PLUS    equ 19
    49                              <1> TOK_MINUS   equ 20
    50                              <1> TOK_STAR    equ 21
    51                              <1> TOK_SLASH   equ 22
    52                              <1> TOK_EQ      equ 23
    53                              <1> TOK_EQEQ    equ 24
    54                              <1> TOK_NEQ     equ 25
    55                              <1> TOK_LT      equ 26
    56                              <1> TOK_LTE     equ 27
    57                              <1> TOK_GT      equ 28
    58                              <1> TOK_GTE     equ 29
    59                              <1> TOK_COMMA   equ 30
    60                              <1> TOK_COUNT_KNOWN equ 31       ; number of entries in party_tok_names
    61                              <1> TOK_ERROR   equ 255
    62                              <1> 
    63                              <1> ; ------------------------------------------------------------
    64                              <1> ; cmd_party: shell entry point. "party <file.pa>"
    65                              <1> ; ------------------------------------------------------------
    66                              <1> cmd_party:
    67 0001B62A 803C25[B8E60600]00  <1>     cmp byte [arg1_buf], 0
    68 0001B632 7512                <1>     jne .check_compile
    69 0001B634 48BE-               <1>     mov rsi, msg_party_usage
    69 0001B636 [78E5010000000000]  <1>
