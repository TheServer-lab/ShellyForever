 12404 00019D4B 4989C8                      mov r8, rcx
 12405 00019D4E 4889CA                      mov rdx, rcx
 12406 00019D51 48D1EA                      shr rdx, 1
 12407                                  .cs_words:
 12408 00019D54 4885D2                      test rdx, rdx
 12409 00019D57 741A                        jz .cs_odd
 12410 00019D59 0FB60E                      movzx ecx, byte [rsi]
 12411 00019D5C C1E108                      shl ecx, 8
 12412 00019D5F 0FB65E01                    movzx ebx, byte [rsi+1]
 12413 00019D63 09D9                        or ecx, ebx
 12414 00019D65 01C8                        add eax, ecx
 12415 00019D67 83D000                      adc eax, 0
 12416 00019D6A 4883C602                    add rsi, 2
 12417 00019D6E 48FFCA                      dec rdx
 12418 00019D71 EBE1                        jmp .cs_words
 12419                                  .cs_odd:
 12420 00019D73 49F7C001000000              test r8, 1
 12421 00019D7A 740B                        jz .cs_fold
 12422 00019D7C 0FB60E                      movzx ecx, byte [rsi]
 12423 00019D7F C1E108                      shl ecx, 8
 12424 00019D82 01C8                        add eax, ecx
 12425 00019D84 83D000                      adc eax, 0
 12426                                  .cs_fold:
 12427 00019D87 89C2                        mov edx, eax
 12428 00019D89 C1EA10                      shr edx, 16
 12429 00019D8C 85D2                        test edx, edx
 12430 00019D8E 740C                        jz .cs_done
 12431 00019D90 25FFFF0000                  and eax, 0xFFFF
 12432 00019D95 01D0                        add eax, edx
 12433 00019D97 83D000                      adc eax, 0
 12434 00019D9A EBEB                        jmp .cs_fold
 12435                                  .cs_done:
 12436 00019D9C F7D0                        not eax
 12437 00019D9E 25FFFF0000                  and eax, 0xFFFF
 12438 00019DA3 4158                        pop r8
