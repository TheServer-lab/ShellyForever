 13946 0000B18A 56                          push rsi
 13947 0000B18B 51                          push rcx
 13948 0000B18C 4150                        push r8
 13949 0000B18E 4151                        push r9
 13950 0000B190 488D3425[F0F20800]          lea rsi, [net_build_buf]
 13951 0000B198 4489E1                      mov ecx, r12d
 13952 0000B19B 83C108                      add ecx, 8
 13953 0000B19E 448B0425[56CA0800]          mov r8d, [nic_ip]
 13954 0000B1A6 4589E9                      mov r9d, r13d
 13955 0000B1A9 E813FAFFFF                  call net_udp_checksum
 13956                                      ; net_checksum16's result is a host-order logical 16-bit value, same
 13957                                      ; as nic_send_ip's IP-header checksum - that call site byte-swaps with
 13958                                      ; ror ax,8 before the store (see nic_send_ip below) because `mov word`
 13959                                      ; writes little-endian but the wire field needs big-endian. This call
 13960                                      ; site was missing that same swap, so every outgoing UDP checksum
 13961                                      ; (DHCP discover/request included) was written backwards. QEMU's slirp
 13962                                      ; doesn't validate UDP checksums so this never showed up there, but a
 13963                                      ; real DHCP server will silently drop a packet with a bad checksum -
 13964                                      ; which is indistinguishable from "no response" on our end.
