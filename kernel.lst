   486 00038A82 B920000000          <1>     mov rcx, 32
   487 00038A87 E867FDFFFF          <1>     call sha256_update
   488 00038A8C 488D3C25[B0ED0300]  <1>     lea rdi, [hmac_scratch_ctx]
   489 00038A94 4889DE              <1>     mov rsi, rbx
