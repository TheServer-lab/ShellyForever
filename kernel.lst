 10809                                  ; ---- e1000 bring-up (only reached if no RTL8139 was found above) --
 10810                                  .try_e1000:
 10811 00018C8C E828FAFFFF                  call pci_find_e1000
 10812 00018C91 0F82EE020000                jc .try_rtl8168
 10813                                  
 10814 00018C97 E815FCFFFF                  call pci_pm_wake                 ; make sure it's in D0 before we touch it
 10815 00018C9C E8EDFCFFFF                  call pci_disable_aspm            ; keep the PCIe link out of L0s/L1
 10816                                  
 10817                                      ; PCI command: enable memory space (bit1) + bus master (bit2)
 10818 00018CA1 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10819 00018CA9 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10820 00018CB1 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10821 00018CB9 41B004                      mov r8b, NIC_PCI_CMD
 10822 00018CBC E883EEFFFF                  call pci_read32
 10823 00018CC1 83C806                      or eax, 0x0006
 10824 00018CC4 4189C2                      mov r10d, eax
 10825 00018CC7 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10826 00018CCF 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10827 00018CD7 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10828 00018CDF 41B004                      mov r8b, NIC_PCI_CMD
 10829 00018CE2 E8A7EEFFFF                  call pci_write32
 10830                                  
 10831                                      ; BAR0 must be a memory BAR (bit0=0 - an I/O bar here would mean a chip
 10832                                      ; this driver doesn't understand); mask off the low 4 type/prefetch bits
 10833 00018CE7 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10834 00018CEF 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10835 00018CF7 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10836 00018CFF 41B010                      mov r8b, NIC_PCI_BAR0
 10837 00018D02 E83DEEFFFF                  call pci_read32
 10838 00018D07 A901000000                  test eax, 1
 10839 00018D0C 0F85C3050000                jnz .ndone
 10840 00018D12 83E0F0                      and eax, 0xFFFFFFF0
 10841 00018D15 890425[B8E80500]            mov [nic_mmio_base], eax
 10842                                  
 10843                                      ; Same issue AHCI's ABAR had (see ahci_mark_uncached above): polling an
 10844                                      ; MMIO register through a cacheable identity-map entry can read back a
 10845                                      ; stale cached value on real hardware instead of what the device just
 10846                                      ; wrote - e.g. CTRL.RST below could look permanently set and the reset
 10847                                      ; loop would spin out and abandon the NIC even though the device reset
 10848                                      ; fine. ahci_mark_uncached is generic (just sets PCD on whichever 2MB
 10849                                      ; identity-map page contains the physical address in edi), so reuse it
 10850                                      ; here for the e1000's BAR0 window too.
 10851 00018D1C 89C7                        mov edi, eax
 10852 00018D1E E888EFFFFF                  call ahci_mark_uncached
 10853                                  
 10854                                      ; full device reset: CTRL.RST, then poll for it to self-clear
 10855 00018D23 BF00000000                  mov edi, E1000_CTRL
 10856 00018D28 B800000004                  mov eax, E1000_CTRL_RST
 10857 00018D2D E83FFDFFFF                  call e1000_reg_write32
 10858 00018D32 41B900000001                mov r9, 0x1000000
 10859                                  .e1k_reset_wait:
 10860 00018D38 BF00000000                  mov edi, E1000_CTRL
 10861 00018D3D E81EFDFFFF                  call e1000_reg_read32
 10862 00018D42 A900000004                  test eax, E1000_CTRL_RST
 10863 00018D47 740A                        jz .e1k_reset_done
 10864 00018D49 49FFC9                      dec r9
 10865 00018D4C 75EA                        jnz .e1k_reset_wait
 10866 00018D4E E982050000                  jmp .ndone
 10867                                  .e1k_reset_done:
 10868                                  
 10869                                      ; polled driver, same discipline as the RTL8139 side: mask interrupts,
 10870                                      ; then read ICR once to drop anything reset/link-change latched there
