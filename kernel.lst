  2534 00027E70 49FFC5              <1>     inc r13
  2535 00027E73 EBD6                <1>     jmp .psb_loop
  2536                              <1> .psb_next:
  2537 00027E75 49FFC5              <1>     inc r13
  2538 00027E78 EBD1                <1>     jmp .psb_loop
  2539                              <1> .psb_out:
  2540 00027E7A C3                  <1>     ret
