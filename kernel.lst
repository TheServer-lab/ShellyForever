  1719                                  ; ============================================================
  1720                                  ;  /home filesystem — a flat table of directory entries kept
  1721                                  ;  in memory and mirrored to disk so it survives a reboot.
  1722                                  ;
  1723                                  ;  Each entry is 64 bytes:
  1724                                  ;    offset 0  : name, 32 bytes, NUL-terminated
  1725                                  ;    offset 32 : used flag (1 byte: 1 = in use, 0 = free)
  1726                                  ;    offset 33 : type (1 byte: 0 = folder, 1 = file)
  1727                                  ;    offset 36 : parent_idx, signed dword (-1 for the root)
  1728                                  ;    offset 40 : content_lba (4 bytes, LBA of content sector, 0 = none)
  1729                                  ;    offset 44 : content_size (4 bytes)
  1730                                  ;
  1731                                  ;  Disk layout:
  1732                                  ;    LBA 200        : magic sector ("SHFS")
  1733                                  ;    LBA 201..208    : the 64-entry table (8 sectors = 4096B)
  1734                                  ;
  1735                                  ;  Entry 0 is always the root, named "home". Commands:
  1736                                  ;    mkf <name>          create a folder in the current dir
  1737                                  ;    cf <path>            change directory (absolute /home/.. ,
  1738                                  ;                          relative name, "..", or nested a/b)
  1739                                  ;    list                  list items in the current dir
  1740                                  ;    mkfl <name>          create a file in the current dir
  1741                                  ; ============================================================
