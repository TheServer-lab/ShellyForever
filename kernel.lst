 13875 0001AC8A 4883F8FF                    cmp rax, -1
 13876 0001AC8E 740E                        je .vg_notfound
 13877 0001AC90 4989C1                      mov r9, rax
 13878 0001AC93 4A8B04CD[88EC0600]          mov rax, [var_value + r9*8]
 13879 0001AC9B B101                        mov cl, 1
 13880 0001AC9D C3                          ret
 13881                                  .vg_notfound:
 13882 0001AC9E 4831C0                      xor rax, rax
 13883 0001ACA1 B100                        mov cl, 0
 13884 0001ACA3 C3                          ret
 13885                                  
 13886                                  ; var_set: rsi=name, rbx=value(int64). Creates the variable if it
 13887                                  ; doesn't exist yet, otherwise updates it in place. Silently does
 13888                                  ; nothing if the table is full (MAX_VARS reached).
 13889                                  var_set:
 13890 0001ACA4 50                          push rax
 13891 0001ACA5 51                          push rcx
 13892 0001ACA6 52                          push rdx
 13893 0001ACA7 57                          push rdi
 13894 0001ACA8 56                          push rsi
 13895 0001ACA9 53                          push rbx
 13896 0001ACAA E88FFFFFFF                  call var_find
 13897 0001ACAF 5B                          pop rbx
 13898 0001ACB0 5E                          pop rsi
 13899 0001ACB1 4883F8FF                    cmp rax, -1
 13900 0001ACB5 7536                        jne .vs_have
 13901 0001ACB7 4831C9                      xor rcx, rcx
 13902                                  .vs_free:
 13903 0001ACBA 4883F910                    cmp rcx, MAX_VARS
 13904 0001ACBE 7335                        jae .vs_full
