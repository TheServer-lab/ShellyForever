 19092                                  ; --- process table for rush scripts ---
 19093                                  MAX_PROCESSES equ 2   ; was 4, trimmed to fit the kernel's BSS under the old
 19094                                                         ; 0xA0000 flat-load ceiling (the kernel image had to
 19095                                                         ; end before the VGA adapter window at physical
 19096                                                         ; 0xA0000, since base RAM topped out at 0x9FFFF). That
 19097                                                         ; ceiling is gone now that the kernel is relocated
 19098                                                         ; above 1MB (see this file's header comment) - 2 is no
 19099                                                         ; longer a hard requirement, just left as-is here
 19100                                                         ; since raising it back to 4 is a scheduler/memory
 19101                                                         ; sizing decision on its own, not part of this fix.
 19102 000A5A20 0000<rep 2h>            proc_id:       times MAX_PROCESSES dw 0
 19103 000A5A24 00<rep 40h>             proc_name:     times MAX_PROCESSES*32 db 0
 19104 000A5A64 00<rep 2h>              proc_state:    times MAX_PROCESSES db 0    ; 0=free, 1=running, 2=killed
 19105 000A5A66 0100                    proc_next_pid: dw 1
 19106 000A5A68 00                      proc_cur_slot: db 0                         ; slot index of currently running script
 19107 000A5A69 00                      kill_flag:     db 0                         ; set by Esc key or prs kill
 19108 000A5A6A 0000000000000000        rr_content_ptr: dq 0                         ; cursor into script file content
 19109                                  
 19110                                  ; --- background (.run -back) process support ---
 19111                                  ; A background .run is a Party program (the interpreter path, exactly like
 19112                                  ; 'party file.pa') run cooperatively: it executes on its OWN private stack
 19113                                  ; (proc_bg_stack) with its OWN parked interpreter state (proc_bg_ctx), and
 19114                                  ; yields back to the shell after BG_QUANTUM statements so the prompt stays
 19115                                  ; responsive. Output is redirected by putchar into the process's output
 19116                                  ; ring (proc_bg_ring) while it runs, and 'prs peek' shows the last lines.
 19117                                  BG_RING_CAP   equ 4096          ; bytes of captured output per process
 19118                                  BG_SRC_MAX    equ 16384         ; max embedded source bytes for a -back script
 19119                                  BG_STACK_SIZE equ 8192          ; per-process private interpreter stack
 19120                                  BG_QUANTUM    equ 200           ; statements a background step may run
 19121                                  
 19122 000A5A72 00<rep 2h>              proc_bg:          times MAX_PROCESSES db 0    ; 1 = background party process
 19123 000A5A74 0000000000000000-       proc_bg_rsp:      times MAX_PROCESSES dq 0    ; saved private-stack pointer (resume IP on top)
 19123 000A5A74 <rep 2h>           
 19124 000A5A84 00000000<rep 2h>        proc_bg_ring_start: times MAX_PROCESSES dd 0  ; output ring read offset
 19125 000A5A8C 00000000<rep 2h>        proc_bg_ring_len:   times MAX_PROCESSES dd 0  ; output ring byte count
 19126 000A5A94 00<rep 2000h>           proc_bg_ring:     times MAX_PROCESSES*BG_RING_CAP db 0
 19127 000A7A94 00<rep 8000h>           proc_bg_src:      times MAX_PROCESSES*BG_SRC_MAX db 0
 19128 000AFA94 00<rep 4000h>           proc_bg_stack:    times MAX_PROCESSES*BG_STACK_SIZE db 0
 19129 000B3A94 00<rep 14E8Ch>          proc_bg_ctx:      times MAX_PROCESSES*PARTY_CTX_SIZE db 0  ; parked interpreter state
 19130                                  
 19131 000C8920 0000000000000000        bg_shell_rsp:       dq 0        ; shell stack pointer parked across a background step
 19132 000C8928 00                      bg_cur_slot:        db 0        ; slot currently being stepped (read by party_bg_suspend)
 19133 000C8929 00000000                bg_stmt_idx:        dd 0        ; saved token cursor for a yielded background process
 19134 000C892D 00000000                bg_stop_tok:        dd 0        ; saved stop token (r14) for a yielded background process
 19135 000C8931 00000000                party_bg_quantum:   dd 0        ; statements left in the current background step
 19136 000C8935 00                      party_bg_active:    db 0        ; 1 while a background process is running (interpreter checks)
 19137 000C8936 0000000000000000        bg_capture_base:    dq 0        ; putchar redirection: base of the active output ring
 19138 000C893E 0000000000000000        bg_capture_start_ptr: dq 0      ; pointer to the ring's read-offset dword
 19139 000C8946 0000000000000000        bg_capture_len_ptr: dq 0        ; pointer to the ring's byte-count dword
 19140 000C894E 0000000000000000        bg_capture_max:     dq 0        ; ring capacity
 19141 000C8956 00<rep A0h>             bg_notice:          times 160 db 0   ; pending "process finished/killed" line
 19142 000C89F6 00                      bg_notice_pending:  db 0        ; 1 while a notice is waiting to be printed
 19143 000C89F7 00<rep 1001h>           prs_peek_buf:       times BG_RING_CAP+1 db 0   ; linearized output for 'prs peek'
 19144 000C99F8 00                      sched_slot:         db 0        ; round-robin cursor for the bg scheduler
 19145                                  
 19146                                  ; --- large staging buffers. A file can span the whole data area, but interactive
 19147                                  ; view/edit/run stage content through these fixed-size buffers (EDIT_MAX). Declared
 19148                                  ; at the very end of the file, after all code, so any growth doesn't move anything. ---
 19149 000C99F9 00<rep 200h>            fs_io_scratch: times 512 db 0     ; zero-pad staging for the tail sector of a cluster write
 19150 000C9BF9 00                      rr_buf_idx:    db 0               ; toggles which rr_script_buf half the current runrush uses
 19151                                                                    ; (so a script that launches another script doesn't clobber
 19152                                                                    ; the outer script's content - each nesting depth gets its own)
 19153 000C9BFA 00<rep A000h>           rr_script_buf: times 2 * EDIT_MAX db 0   ; resident copy of a runrush script (runrush used to
 19154                                                                    ; stream straight from node_content, which no longer holds
 19155                                                                    ; file bytes - the script is read here once at startup)
 19156 000D3BFA 00<rep 5000h>           fs_io_buf:  times EDIT_MAX db 0     ; editor + view/read/copy staging for multi-block files
