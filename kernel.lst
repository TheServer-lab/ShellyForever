 18906 00094411 10751076107710     
 18907 00094418 78107C105E105F1060-         dw 0x1078, 0x107C, 0x105E, 0x105F, 0x1060, 0x108B, 0x108C, 0x109A
 18907 00094421 108B108C109A10     
 18908 00094428 B910D310EA10F5100C-         dw 0x10B9, 0x10D3, 0x10EA, 0x10F5, 0x150C
