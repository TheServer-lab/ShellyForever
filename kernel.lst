  9962                                  
  9963                                  ; ==================================================================
  9964                                  ;  RTL8139 NIC driver + base network stack (Milestone B)
  9965                                  ;  Polled, no IRQs. Inbound frames land in a DMA RX ring; the shell
  9966                                  ;  loop calls netpoll to drain and dispatch them (ARP / IPv4 / ICMP /
  9967                                  ;  UDP-DNS). Outbound frames are built in nic_tx_buf and pushed out
  9968                                  ;  TSAD0/TSD0 by nic_send_raw. Static IP config lives in nic_ip /
  9969                                  ;  nic_mask / nic_gw / nic_dns (defaults are the QEMU slirp values).
  9970                                  ;  All register discipline: every function in this section saves and
  9971                                  ;  restores every register it uses, so the polling loops (bounce /
  9972                                  ;  monitor / dns) can hold state in r12/r13/r14/r15 across calls.
  9973                                  ; ==================================================================
  9974                                  NIC_VENDOR_ID   equ 0x10EC
  9975                                  NIC_DEVICE_ID   equ 0x8139
  9976                                  NIC_PCI_CMD     equ 0x04
  9977                                  NIC_PCI_BAR0    equ 0x10
  9978                                  
  9979                                  NIC_IO_IDR0     equ 0x00
  9980                                  NIC_IO_TSD0     equ 0x10
  9981                                  NIC_IO_TSAD0    equ 0x20
  9982                                  NIC_IO_RBSTART  equ 0x30
  9983                                  NIC_IO_CBR      equ 0x34
  9984                                  NIC_IO_CAPR     equ 0x38
  9985                                  NIC_IO_CMD      equ 0x37
  9986                                  NIC_IO_IMR      equ 0x3C
  9987                                  NIC_IO_ISR      equ 0x3E
  9988                                  NIC_IO_TCR      equ 0x40
  9989                                  NIC_IO_RCR      equ 0x44
  9990                                  NIC_IO_CFG1     equ 0x52
  9991                                  
  9992                                  NIC_RX_RING_SIZE equ 0x2000        ; 8KB ring (fits the boot budget)
  9993                                  NIC_RX_RING_MASK equ 0x1FFF
  9994                                  NIC_TX_BUF_SIZE  equ 0x800         ; 2KB frame build/DMA buffer
  9995                                  ETH_TYPE_ARP_W   equ 0x0608        ; "08 06" as a little-endian memory word
  9996                                  ETH_TYPE_IP_W    equ 0x0008        ; "08 00" as a little-endian memory word
  9997                                  IP_PROTO_ICMP    equ 0x01
  9998                                  IP_PROTO_TCP     equ 0x06
  9999                                  IP_PROTO_UDP     equ 0x11
 10000                                  
 10001                                  ; ---- Intel e1000 (82540/82541/82545/82546/8257x "PRO/1000") support -----
 10002                                  ; A second NIC backend behind the exact same nic_init/nic_send_raw/nic_fetch_rx
 10003                                  ; entry points the RTL8139 driver above already exposes, so ARP/IPv4/ICMP/
 10004                                  ; UDP-DNS and every shell command above never need to know which chip is
 10005                                  ; live - they only ever touch nic_present/nic_mac and call nic_send_raw /
 10006                                  ; nic_fetch_rx. nic_driver_type (0=rtl8139, 1=e1000) picks the branch inside
 10007                                  ; those three functions. Unlike the RTL8139's port I/O, e1000 registers are
 10008                                  ; memory-mapped (BAR0), so this backend uses ordinary loads/stores against
 10009                                  ; the identity-mapped physical address in nic_mmio_base instead of in/out.
 10010                                  E1000_VENDOR_ID  equ 0x8086
 10011                                  
 10012                                  E1000_CTRL       equ 0x0000
 10013                                  E1000_STATUS     equ 0x0008
 10014                                  E1000_ICR        equ 0x00C0
 10015                                  E1000_IMS        equ 0x00D0
 10016                                  E1000_IMC        equ 0x00D8
 10017                                  E1000_RCTL       equ 0x0100
 10018                                  E1000_TCTL       equ 0x0400
 10019                                  E1000_TIPG       equ 0x0410
 10020                                  E1000_RDBAL      equ 0x2800
 10021                                  E1000_RDBAH      equ 0x2804
 10022                                  E1000_RDLEN      equ 0x2808
 10023                                  E1000_RDH        equ 0x2810
 10024                                  E1000_RDT        equ 0x2818
 10025                                  E1000_TDBAL      equ 0x3800
 10026                                  E1000_TDBAH      equ 0x3804
 10027                                  E1000_TDLEN      equ 0x3808
 10028                                  E1000_TDH        equ 0x3810
 10029                                  E1000_TDT        equ 0x3818
 10030                                  E1000_MTA        equ 0x5200
 10031                                  E1000_RAL0       equ 0x5400
 10032                                  E1000_RAH0       equ 0x5404
 10033                                  
 10034                                  E1000_CTRL_RST   equ 0x04000000
 10035                                  E1000_CTRL_SLU_ASDE equ 0x00000060   ; SLU (bit6) | ASDE (bit5)
 10036                                  
 10037                                  E1000_RCTL_EN    equ 0x00000002
 10038                                  E1000_RCTL_UPE   equ 0x00000008
 10039                                  E1000_RCTL_MPE   equ 0x00000010
 10040                                  E1000_RCTL_BAM   equ 0x00008000
 10041                                  E1000_RCTL_SECRC equ 0x04000000      ; strip the 4-byte Ethernet CRC, like RTL8139's ring does
 10042                                  
 10043                                  E1000_TCTL_EN    equ 0x00000002
 10044                                  E1000_TCTL_PSP   equ 0x00000008
 10045                                  E1000_TCTL_CT    equ 0x000000F0      ; collision threshold 0x0F << 4
 10046                                  E1000_TCTL_COLD  equ 0x00040000      ; collision distance 0x40 << 12 (full duplex)
 10047                                  E1000_TIPG_VAL   equ 0x0060200A      ; Intel-recommended IPGT/IPGR1/IPGR2 for full duplex
 10048                                  
 10049                                  E1000_TXD_CMD_EOP_IFCS_RS equ 0x0B   ; EOP(0x01) | IFCS(0x02) | RS(0x08)
 10050                                  E1000_DD         equ 0x01            ; Descriptor Done, shared by RX/TX status bytes
 10051                                  
 10052                                  E1000_RX_DESC_COUNT equ 8            ; 8 * 16B = 128B: the minimum ring length e1000 accepts
 10053                                  E1000_TX_DESC_COUNT equ 8
 10054                                  E1000_RX_BUF_SIZE   equ 2048
 10055                                  
 10056                                  ; ---- Realtek RTL8168/8169/8161 ("PCIe GBE Family Controller") support ---
 10057                                  ; A third NIC backend behind the same nic_init/nic_send_raw/nic_fetch_rx
 10058                                  ; entry points (nic_driver_type: 0=rtl8139, 1=e1000, 2=rtl8168). This is
 10059                                  ; the common gigabit Realtek chip found on most real desktop motherboards -
 10060                                  ; a completely different beast from the old RTL8139: descriptor rings like
 10061                                  ; e1000, but reached over port I/O (BAR0) like the RTL8139 driver, so it
 10062                                  ; reuses nic_io_read8/16/32 / nic_io_write8/16/32 against nic_io_base. Only
 10063                                  ; the "normal priority" TX queue is used; the high-priority queue is left
 10064                                  ; zeroed/unused. Register offsets and the reset/bring-up sequence follow
 10065                                  ; the publicly documented RTL8169 programming model (OSDev.org's RTL8169
 10066                                  ; page, itself sourced from Realtek's public datasheet).
 10067                                  RTL_VENDOR_ID    equ 0x10EC
 10068                                  
 10069                                  RTL_IO_IDR0      equ 0x00             ; MAC address, 6 bytes
 10070                                  RTL_IO_TNPDS_LO  equ 0x20             ; Tx Normal Priority Descriptor Start Addr (low dword)
 10071                                  RTL_IO_TNPDS_HI  equ 0x24
 10072                                  RTL_IO_THPDS_LO  equ 0x28             ; Tx High Priority ring - unused, kept zeroed
 10073                                  RTL_IO_THPDS_HI  equ 0x2C
 10074                                  RTL_IO_CMD       equ 0x37             ; Chip Command register
 10075                                  RTL_IO_TPPOLL    equ 0x38             ; Transmit Priority Polling (kick DMA)
 10076                                  RTL_IO_IMR       equ 0x3C
 10077                                  RTL_IO_ISR       equ 0x3E
 10078                                  RTL_IO_TCR       equ 0x40             ; TxConfig
 10079                                  RTL_IO_RCR       equ 0x44             ; RxConfig
 10080                                  RTL_IO_9346CR    equ 0x50             ; EEPROM/config-register lock
 10081                                  RTL_IO_CPCMD     equ 0xE0             ; C+ Command Register
 10082                                  RTL_IO_RMS       equ 0xDA             ; Rx max packet size (word)
 10083                                  RTL_IO_MTPS      equ 0xEC             ; Tx max packet size, 128-byte units (byte)
 10084                                  RTL_IO_RDSAR_LO  equ 0xE4             ; Rx Descriptor Start Addr (low dword)
 10085                                  RTL_IO_RDSAR_HI  equ 0xE8
 10086                                  RTL_IO_PHYSTATUS equ 0x6C             ; PHY status register; bit1 = LinkStatus
 10087                                  RTL_IO_PHYAR     equ 0x60             ; PHY (MDIO) Access Register
 10088                                  RTL_PHYSTATUS_LINK equ 0x02
 10089                                  
 10090                                  RTL_CMD_RST      equ 0x10
 10091                                  RTL_CMD_TE       equ 0x04
 10092                                  RTL_CMD_RE       equ 0x08
 10093                                  RTL_9346_UNLOCK  equ 0xC0
 10094                                  RTL_9346_LOCK    equ 0x00
 10095                                  RTL_TPPOLL_NPQ   equ 0x40
 10096                                  
 10097                                  RTL_DESC_OWN     equ 0x80000000
 10098                                  RTL_DESC_EOR     equ 0x40000000
 10099                                  RTL_DESC_FS      equ 0x20000000
 10100                                  RTL_DESC_LS      equ 0x10000000
 10101                                  
 10102                                  RTL_RX_DESC_COUNT equ 8
 10103                                  RTL_TX_DESC_COUNT equ 8
 10104                                  RTL_RX_BUF_SIZE   equ 2048
