   618                              <1> 
   619                              <1> ; hkdf_expand_label (RFC 8446 7.1):
   620                              <1> ;   rdi = secret ptr (32 bytes)
   621                              <1> ;   rsi = label ptr (ASCII, WITHOUT the "tls13 " prefix -- this
   622                              <1> ;         routine adds it)
   623                              <1> ;   edx = label len
   624                              <1> ;   rcx = context ptr (may be 0 if context len is 0)
   625                              <1> ;   r8d = context len
   626                              <1> ;   r9d = desired output length L
   627                              <1> ;   r10 = output buffer ptr
   628                              <1> hkdf_expand_label:
   629 00038BCE 50                  <1>     push rax
   630 00038BCF 53                  <1>     push rbx
   631 00038BD0 51                  <1>     push rcx
   632 00038BD1 52                  <1>     push rdx
   633 00038BD2 56                  <1>     push rsi
   634 00038BD3 57                  <1>     push rdi
   635 00038BD4 4150                <1>     push r8
   636 00038BD6 4151                <1>     push r9
   637 00038BD8 4152                <1>     push r10
   638 00038BDA 4154                <1>     push r12
   639 00038BDC 4155                <1>     push r13
   640 00038BDE 4156                <1>     push r14
   641 00038BE0 4157                <1>     push r15
   642                              <1> 
   643 00038BE2 4989FC              <1>     mov r12, rdi                  ; secret ptr
   644 00038BE5 4989F5              <1>     mov r13, rsi                  ; label ptr
   645 00038BE8 4189D6              <1>     mov r14d, edx                 ; label len
   646 00038BEB 4989CF              <1>     mov r15, rcx                  ; context ptr
   647 00038BEE 4489C3              <1>     mov ebx, r8d                  ; context len (ebx free: rbx not otherwise used here)
   648                              <1> 
   649                              <1>     ; HkdfLabel: uint16 length | uint8 label_len | "tls13 "+label | uint8 ctx_len | ctx
   650 00038BF1 488D3C25[28F10300]  <1>     lea rdi, [hkdf_label_buf]
