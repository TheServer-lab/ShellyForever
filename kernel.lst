 14267                                  .ee_as_next:
 14268 0001B01D 49FFC6                      inc r14
 14269 0001B020 EBCD                        jmp .ee_as_loop
 14270                                  .ee_as_done:
 14271 0001B022 B101                        mov cl, 1
 14272 0001B024 EB05                        jmp .ee_out
 14273                                  .ee_bad:
