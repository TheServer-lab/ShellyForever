  3911                              <1> ; ------------------------------------------------------------
  3912                              <1> ; party_emit_lit_display: emits one compiled "display <literal>"
  3913                              <1> ; sequence (print text, then newline) into the .run code buffer,
  3914                              <1> ; followed by the literal's text itself.
  3915                              <1> ; In:  rdi = output cursor into party_run_bin_buf (the live codegen
  3916                              <1> ;            cursor - callers keep using rdi after this returns)
  3917                              <1> ;      rsi = pointer to the literal's raw text (no quotes, no minus)
  3918                              <1> ;      rcx = length of that text
  3919                              <1> ;      r11 = 1 to prepend a literal '-' before the text, 0 otherwise
  3920                              <1> ; Out: rdi advanced past the emitted instructions + text + NUL.
  3921                              <1> ; Clobbers: rax, rsi, rcx.
  3922                              <1> ; ------------------------------------------------------------
  3923                              <1> party_emit_lit_display:
  3924                              <1>     ; LEA RSI, [RIP+disp]   (runtime instruction, being written here)
  3925                              <1>     ; disp must land exactly on the text bytes that follow the fixed
  3926                              <1>     ; 15-byte call/mov/call/jmp tail below (3+4+3+5), plus 1 more byte if
  3927                              <1>     ; a '-' is going to be written before the text.
  3928 00023EFF C60748              <1>     mov byte [rdi], 0x48
  3929 00023F02 C647018D            <1>     mov byte [rdi+1], 0x8D
  3930 00023F06 C6470235            <1>     mov byte [rdi+2], 0x35
  3931 00023F0A B80F000000          <1>     mov eax, 15                   ; was 10 - grew by 5 for the JMP added below
  3932 00023F0F 4983FB01            <1>     cmp r11, 1
  3933 00023F13 7502                <1>     jne .eld_disp_set
  3934 00023F15 FFC0                <1>     inc eax
  3935                              <1> .eld_disp_set:
  3936 00023F17 894703              <1>     mov [rdi+3], eax
  3937 00023F1A 4883C707            <1>     add rdi, 7
  3938                              <1> 
  3939 00023F1E C607FF              <1>     mov byte [rdi], 0xFF          ; call [table+0]  -> kernel print_string
  3940 00023F21 C6470157            <1>     mov byte [rdi+1], 0x57
  3941 00023F25 C6470200            <1>     mov byte [rdi+2], 0x00
  3942 00023F29 4883C703            <1>     add rdi, 3
  3943                              <1> 
  3944 00023F2D C60748              <1>     mov byte [rdi], 0x48          ; mov rsi, [table+0x18] -> newline_str
  3945 00023F30 C647018B            <1>     mov byte [rdi+1], 0x8B
  3946 00023F34 C6470277            <1>     mov byte [rdi+2], 0x77
  3947 00023F38 C6470318            <1>     mov byte [rdi+3], 0x18
  3948 00023F3C 4883C704            <1>     add rdi, 4
  3949                              <1> 
  3950 00023F40 C607FF              <1>     mov byte [rdi], 0xFF          ; call [table+0]  -> print the newline
  3951 00023F43 C6470157            <1>     mov byte [rdi+1], 0x57
  3952 00023F47 C6470200            <1>     mov byte [rdi+2], 0x00
  3953 00023F4B 4883C703            <1>     add rdi, 3
