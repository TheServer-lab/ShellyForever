   713                                  ; ------------------------------------------------------------
   714                                  ; expand_identity_map: extends boot.asm's minimal 0-64MB identity map to
   715                                  ; a full 0-4GB identity map using 2MB pages.
   716                                  ;
   717                                  ; Bug this fixes: "sdown" was rebooting the machine instead of shutting
   718                                  ; it down. Root cause: boot.asm's page tables only identity-map the
   719                                  ; first 64MB of physical memory (PML4@0x1000 -> PDPT@0x2000 -> a single
   720                                  ; PD@0x3000 with 32 entries). acpi_shutdown later walks the firmware's
   721                                  ; RSDT/XSDT/FADT/DSDT tables to find the real ACPI power-off port/value,
   722                                  ; and those tables are NOT guaranteed to live under 64MB - confirmed by
   723                                  ; tracing this exact machine: the FADT/DSDT land around 127MB with a
   724                                  ; 128MB guest. Touching that unmapped memory takes a page fault, and
   725                                  ; since there's no IDT installed yet, it escalates straight to a triple
   726                                  ; fault - which looks exactly like a reboot from the user's perspective.
   727                                  ;
   728                                  ; Fix: before anything else runs, reuse boot.asm's existing PML4/PDPT
   729                                  ; (no need to touch those) and add 3 more PD tables (PD1-PD3 at
   730                                  ; 0x4000/0x5000/0x6000, alongside boot.asm's PD0 at 0x3000), wiring all
   731                                  ; 4 into PDPT[0..3]. Then refill all 4 PDs (contiguous in memory) with
   732                                  ; 2048 sequential 2MB pages, giving a full 4GB identity map - enough
   733                                  ; headroom for any RAM size/firmware table placement QEMU, Bochs,
   734                                  ; VirtualBox, or real hardware is likely to use.
   735                                  expand_identity_map:
   736 000103FD 50                          push rax
   737 000103FE 51                          push rcx
   738 000103FF 57                          push rdi
   739                                  
   740                                      ; PDPT[1..3] -> PD1/PD2/PD3 (present+rw). PDPT[0] already points at
   741                                      ; boot.asm's PD0 @ 0x3000.
   742 00010400 C70425082000000340-         mov dword [0x2000 + 1*8], 0x4000 | 0x3
   742 00010409 0000               
   743 0001040B C704250C2000000000-         mov dword [0x2000 + 1*8 + 4], 0
   743 00010414 0000               
   744 00010416 C70425102000000350-         mov dword [0x2000 + 2*8], 0x5000 | 0x3
   744 0001041F 0000               
   745 00010421 C70425142000000000-         mov dword [0x2000 + 2*8 + 4], 0
   745 0001042A 0000               
   746 0001042C C70425182000000360-         mov dword [0x2000 + 3*8], 0x6000 | 0x3
   746 00010435 0000               
   747 00010437 C704251C2000000000-         mov dword [0x2000 + 3*8 + 4], 0
   747 00010440 0000               
   748                                  
   749                                      ; PD0..PD3 are contiguous (0x3000..0x6FFF = 16KB = 2048 qwords).
   750                                      ; Refill them all with sequential 2MB pages 0, 2MB, ... 4094MB,
   751                                      ; replacing boot.asm's partial PD0 (only entries 0-31 were valid)
   752                                      ; with a complete map.
   753 00010442 BF00300000                  mov rdi, 0x3000
   754 00010447 B883000000                  mov rax, 0x83                  ; present+rw+PS(2MB), base 0
   755 0001044C B900080000                  mov rcx, 512 * 4               ; 512 entries/PD * 4 PDs = 4GB total
   756                                  .fill:
   757 00010451 488907                      mov [rdi], rax
   758 00010454 480500002000                add rax, 0x200000
   759 0001045A 4883C708                    add rdi, 8
   760 0001045E E2F1                        loop .fill
   761                                  
   762 00010460 0F20D8                      mov rax, cr3                   ; reload CR3 to flush any stale TLB
   763 00010463 0F22D8                      mov cr3, rax                   ; entries from the old partial map
   764                                  
   765 00010466 5F                          pop rdi
   766 00010467 59                          pop rcx
   767 00010468 58                          pop rax
   768 00010469 C3                          ret
   769                                  
