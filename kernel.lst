 12737 000141C6 3C00                        cmp al, 0
 12738 000141C8 75F2                        jne .sa_copy
 12739 000141CA 5F                          pop rdi
 12740 000141CB 5E                          pop rsi
 12741 000141CC 58                          pop rax
 12742 000141CD C3                          ret
