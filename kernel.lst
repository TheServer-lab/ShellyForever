 13152                                      ; also held). Ctrl+C copies the mouse selection into the clipboard and
 13153                                      ; is consumed; Ctrl+V returns the KEY_PASTE sentinel for read_line.
 13154 00014587 3C63                        cmp al, 'c'
 13155 00014589 740E                        je .ctrl_c
 13156 0001458B 3C43                        cmp al, 'C'
 13157 0001458D 740A                        je .ctrl_c
 13158 0001458F 3C76                        cmp al, 'v'
 13159 00014591 7410                        je .ctrl_v
 13160 00014593 3C56                        cmp al, 'V'
 13161 00014595 740C                        je .ctrl_v
 13162                                  .have_normal:
