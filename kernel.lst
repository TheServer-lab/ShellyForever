 13893                                  ; ---- UDP / DNS ---------------------------------------------------
 13894                                  ; nic_send_udp: rsi = payload, ecx = payload len, r8d = dst IP, r9w = dst
 13895                                  ; port, r10w = src port. Builds the UDP datagram in net_build_buf, then
 13896                                  ; ships it as an IP payload.
