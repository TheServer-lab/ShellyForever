 14238 0001AFC1 488B1CDD[30060700]          mov rbx, [calc_vals + rbx*8]
 14239 0001AFC9 4883FB00                    cmp rbx, 0
 14240 0001AFCD 7457                        je .ee_bad
 14241 0001AFCF 4899                        cqo
 14242 0001AFD1 48F7FB                      idiv rbx
