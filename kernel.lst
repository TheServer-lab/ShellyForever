 15944                                  %include "https.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  https.asm  --  HTTPS stake / sgive (Phase 5 of the https.asm
     3                              <1> ;  build plan -- see phases.txt)
     4                              <1> ;
     5                              <1> ;  Two shell commands, user-facing parity with http.asm's take/give:
     6                              <1> ;    stake <url> <file>   TLS 1.3 GET,  save body to a file
     7                              <1> ;    sgive <url> <file>   TLS 1.3 POST, send file content to server
     8                              <1> ;
     9                              <1> ;  URL format: https://host[:port]/path  (default port 443)
    10                              <1> ;
    11                              <1> ;  *** NO CERTIFICATE VALIDATION ***  tls.asm (Phase 3) does not
    12                              <1> ;  verify the server's Certificate/CertificateVerify chain -- see
    13                              <1> ;  phases.txt's SCOPE DECISION. This is the same trust model as
    14                              <1> ;  `curl -k` / `wget --no-check-certificate`: the connection is
    15                              <1> ;  encrypted but the server's identity is NOT authenticated. A
    16                              <1> ;  warning is printed once per session the first time stake/sgive
    17                              <1> ;  runs (https_warn_once, called from both commands below) so this
    18                              <1> ;  is never mistaken for a verifying client.
    19                              <1> ;
    20                              <1> ;  Design (per phases.txt Phase 5):
    21                              <1> ;    - http_parse_url (http.asm) now recognizes both http:// and
    22                              <1> ;      https:// and records which one in http_url_scheme (0/1).
    23                              <1> ;      stake/sgive require scheme==1 (https://); take/give (already
    24                              <1> ;      edited in http.asm) require scheme==0 -- separate verbs, not
    25                              <1> ;      scheme-sniffing on a shared command, per the "pick ONE
    26                              <1> ;      approach" note.
    27                              <1> ;    - http_build_get / http_build_post are content-format-agnostic
    28                              <1> ;      and reused completely unchanged; they still write into
    29                              <1> ;      tcp_tx_buf / http_tx_big as before. https_bridge_tx below
    30                              <1> ;      copies the finished request from tcp_tx_buf into
    31                              <1> ;      tls_app_tx_buf (tls_do_exchange's input buffer) since the two
    32                              <1> ;      are sized differently (TCP_PAYLOAD_MAX=1536 vs
    33                              <1> ;      TLS_APP_TX_MAX=2048) and tls_do_exchange doesn't read
    34                              <1> ;      tcp_tx_buf directly.
    35                              <1> ;    - https_find_body is http_find_body's logic re-pointed at
    36                              <1> ;      tls_app_rx_buf/tls_app_rx_len instead of tcp_rx_buf/
    37                              <1> ;      tcp_rx_len, for the same reason in the other direction
    38                              <1> ;      (TLS_APP_RX_MAX=4096 is a different buffer with a different
    39                              <1> ;      purpose than tcp_rx_buf, which only ever holds raw handshake-
    40                              <1> ;      phase record bytes before tls_pump drains it -- see
    41                              <1> ;      TCP_RX_BUF_SIZE in tcp.asm).
    42                              <1> ;      tcp_rx_buf/tcp_rx_len themselves are untouched by this phase.
    43                              <1> ;
    44                              <1> ;  Included from kernel.asm; inherits BITS 64.
    45                              <1> ; ============================================================
    46                              <1> 
    47                              <1> ; ---- bridge: copy the finished request from tcp_tx_buf (built by
    48                              <1> ; http_build_get / http_build_post, [tcp_tx_len] bytes) into
    49                              <1> ; tls_app_tx_buf, the buffer tls_do_exchange actually reads. Both
    50                              <1> ; HTTP_TX_MAX (1200) and the GET path's short header block fit
    51                              <1> ; comfortably inside TLS_APP_TX_MAX (2048), so no bounds check is
    52                              <1> ; needed here beyond what http_build_get/http_build_post already do
    53                              <1> ; against HTTP_TX_MAX/tcp_tx_buf. ----
    54                              <1> https_bridge_tx:
    55 0005B22B 50                  <1>     push rax
    56 0005B22C 51                  <1>     push rcx
    57 0005B22D 56                  <1>     push rsi
    58 0005B22E 57                  <1>     push rdi
    59 0005B22F 8B0C25[E08C0900]    <1>     mov ecx, [tcp_tx_len]
    60 0005B236 890C25[3A9E0500]    <1>     mov [tls_app_tx_len], ecx
    61 0005B23D 488D3425[FACC0900]  <1>     lea rsi, [tcp_tx_buf]
    62 0005B245 488D3C25[3A960500]  <1>     lea rdi, [tls_app_tx_buf]
    63 0005B24D F3A4                <1>     rep movsb
    64 0005B24F 5F                  <1>     pop rdi
    65 0005B250 5E                  <1>     pop rsi
    66 0005B251 59                  <1>     pop rcx
    67 0005B252 58                  <1>     pop rax
    68 0005B253 C3                  <1>     ret
    69                              <1> 
    70                              <1> ; ---- find HTTP headers end (CRLF CRLF) in tls_app_rx_buf ----
    71                              <1> ; Same contract/logic as http.asm's http_find_body, re-pointed at the
    72                              <1> ; TLS app-data buffer -- see header comment above for why this can't
    73                              <1> ; just reuse http_find_body against tcp_rx_buf.
    74                              <1> ; Returns: rax = ptr into tls_app_rx_buf past the blank line (body
    75                              <1> ;          start), ecx = body length remaining.
    76                              <1> ;          CF=1 if no body found.
    77                              <1> https_find_body:
    78 0005B254 53                  <1>     push rbx
    79 0005B255 57                  <1>     push rdi
    80 0005B256 56                  <1>     push rsi
    81 0005B257 52                  <1>     push rdx
    82                              <1> 
    83 0005B258 C70425[C6D30900]00- <1>     mov dword [http_body_len], 0
    83 0005B260 000000              <1>
    84 0005B263 488D3425[3E9E0500]  <1>     lea rsi, [tls_app_rx_buf]
    85 0005B26B 8B0C25[3FAE0500]    <1>     mov ecx, [tls_app_rx_len]
    86 0005B272 85C9                <1>     test ecx, ecx
    87 0005B274 7441                <1>     jz .nob
    88                              <1> 
    89                              <1> .scan:
    90 0005B276 83F903              <1>     cmp ecx, 3                  ; need at least 4 bytes
    91 0005B279 763C                <1>     jbe .nob
    92 0005B27B 803E0D              <1>     cmp byte [rsi], 13
    93 0005B27E 7530                <1>     jne .next
    94 0005B280 807E010A            <1>     cmp byte [rsi+1], 10
    95 0005B284 752A                <1>     jne .next
    96 0005B286 807E020D            <1>     cmp byte [rsi+2], 13
    97 0005B28A 7524                <1>     jne .next
    98 0005B28C 807E030A            <1>     cmp byte [rsi+3], 10
    99 0005B290 751E                <1>     jne .next
   100                              <1>     ; found. rax = body start pointer
   101 0005B292 488D4604            <1>     lea rax, [rsi+4]
   102                              <1>     ; body length = (tls_app_rx_buf + tls_app_rx_len) - rax
   103 0005B296 8B0C25[3FAE0500]    <1>     mov ecx, [tls_app_rx_len]
   104 0005B29D 488D1425[3E9E0500]  <1>     lea rdx, [tls_app_rx_buf]
   105 0005B2A5 4801CA              <1>     add rdx, rcx
   106 0005B2A8 4829C2              <1>     sub rdx, rax
   107 0005B2AB 89D1                <1>     mov ecx, edx
   108 0005B2AD F8                  <1>     clc
   109 0005B2AE EB08                <1>     jmp .sout
   110                              <1> .next:
   111 0005B2B0 48FFC6              <1>     inc rsi
   112 0005B2B3 FFC9                <1>     dec ecx
   113 0005B2B5 EBBF                <1>     jmp .scan
   114                              <1> .nob:
   115 0005B2B7 F9                  <1>     stc
   116                              <1> .sout:
   117 0005B2B8 5A                  <1>     pop rdx
   118 0005B2B9 5E                  <1>     pop rsi
   119 0005B2BA 5F                  <1>     pop rdi
   120 0005B2BB 5B                  <1>     pop rbx
   121 0005B2BC C3                  <1>     ret
   122                              <1> 
   123                              <1> ; ---- print the "no certificate validation" warning once per session.
   124                              <1> ; Called at the top of both cmd_stake and cmd_sgive, after usage/URL
   125                              <1> ; checks pass, so it's shown before any network activity but not on
   126                              <1> ; every failed/mistyped invocation. ----
   127                              <1> https_warn_once:
   128 0005B2BD 50                  <1>     push rax
