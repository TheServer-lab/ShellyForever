  7821                                  ; ---- Intel e1000 (82540/82541/82545/82546/8257x "PRO/1000") support -----
  7822                                  ; A second NIC backend behind the exact same nic_init/nic_send_raw/nic_fetch_rx
  7823                                  ; entry points the RTL8139 driver above already exposes, so ARP/IPv4/ICMP/
  7824                                  ; UDP-DNS and every shell command above never need to know which chip is
  7825                                  ; live - they only ever touch nic_present/nic_mac and call nic_send_raw /
  7826                                  ; nic_fetch_rx. nic_driver_type (0=rtl8139, 1=e1000) picks the branch inside
  7827                                  ; those three functions. Unlike the RTL8139's port I/O, e1000 registers are
  7828                                  ; memory-mapped (BAR0), so this backend uses ordinary loads/stores against
  7829                                  ; the identity-mapped physical address in nic_mmio_base instead of in/out.
  7830                                  E1000_VENDOR_ID  equ 0x8086
  7831                                  
  7832                                  E1000_CTRL       equ 0x0000
  7833                                  E1000_STATUS     equ 0x0008
  7834                                  E1000_ICR        equ 0x00C0
  7835                                  E1000_IMS        equ 0x00D0
  7836                                  E1000_IMC        equ 0x00D8
  7837                                  E1000_RCTL       equ 0x0100
  7838                                  E1000_TCTL       equ 0x0400
  7839                                  E1000_TIPG       equ 0x0410
  7840                                  E1000_RDBAL      equ 0x2800
  7841                                  E1000_RDBAH      equ 0x2804
  7842                                  E1000_RDLEN      equ 0x2808
  7843                                  E1000_RDH        equ 0x2810
  7844                                  E1000_RDT        equ 0x2818
  7845                                  E1000_TDBAL      equ 0x3800
  7846                                  E1000_TDBAH      equ 0x3804
  7847                                  E1000_TDLEN      equ 0x3808
  7848                                  E1000_TDH        equ 0x3810
  7849                                  E1000_TDT        equ 0x3818
  7850                                  E1000_MTA        equ 0x5200
  7851                                  E1000_RAL0       equ 0x5400
  7852                                  E1000_RAH0       equ 0x5404
  7853                                  
  7854                                  E1000_CTRL_RST   equ 0x04000000
  7855                                  E1000_CTRL_SLU_ASDE equ 0x00000060   ; SLU (bit6) | ASDE (bit5)
  7856                                  
  7857                                  E1000_RCTL_EN    equ 0x00000002
  7858                                  E1000_RCTL_UPE   equ 0x00000008
  7859                                  E1000_RCTL_MPE   equ 0x00000010
  7860                                  E1000_RCTL_BAM   equ 0x00008000
  7861                                  E1000_RCTL_SECRC equ 0x04000000      ; strip the 4-byte Ethernet CRC, like RTL8139's ring does
  7862                                  
  7863                                  E1000_TCTL_EN    equ 0x00000002
  7864                                  E1000_TCTL_PSP   equ 0x00000008
  7865                                  E1000_TCTL_CT    equ 0x000000F0      ; collision threshold 0x0F << 4
  7866                                  E1000_TCTL_COLD  equ 0x00040000      ; collision distance 0x40 << 12 (full duplex)
  7867                                  E1000_TIPG_VAL   equ 0x0060200A      ; Intel-recommended IPGT/IPGR1/IPGR2 for full duplex
  7868                                  
  7869                                  E1000_TXD_CMD_EOP_IFCS_RS equ 0x0B   ; EOP(0x01) | IFCS(0x02) | RS(0x08)
  7870                                  E1000_DD         equ 0x01            ; Descriptor Done, shared by RX/TX status bytes
  7871                                  
  7872                                  E1000_RX_DESC_COUNT equ 8            ; 8 * 16B = 128B: the minimum ring length e1000 accepts
  7873                                  E1000_TX_DESC_COUNT equ 8
  7874                                  E1000_RX_BUF_SIZE   equ 2048
  7875                                  
  7876                                  ; ---- Realtek RTL8168/8169/8161 ("PCIe GBE Family Controller") support ---
  7877                                  ; A third NIC backend behind the same nic_init/nic_send_raw/nic_fetch_rx
  7878                                  ; entry points (nic_driver_type: 0=rtl8139, 1=e1000, 2=rtl8168). This is
  7879                                  ; the common gigabit Realtek chip found on most real desktop motherboards -
  7880                                  ; a completely different beast from the old RTL8139: descriptor rings like
  7881                                  ; e1000, but reached over port I/O (BAR0) like the RTL8139 driver, so it
  7882                                  ; reuses nic_io_read8/16/32 / nic_io_write8/16/32 against nic_io_base. Only
  7883                                  ; the "normal priority" TX queue is used; the high-priority queue is left
  7884                                  ; zeroed/unused. Register offsets and the reset/bring-up sequence follow
  7885                                  ; the publicly documented RTL8169 programming model (OSDev.org's RTL8169
  7886                                  ; page, itself sourced from Realtek's public datasheet).
  7887                                  RTL_VENDOR_ID    equ 0x10EC
  7888                                  
  7889                                  RTL_IO_IDR0      equ 0x00             ; MAC address, 6 bytes
  7890                                  RTL_IO_TNPDS_LO  equ 0x20             ; Tx Normal Priority Descriptor Start Addr (low dword)
  7891                                  RTL_IO_TNPDS_HI  equ 0x24
  7892                                  RTL_IO_THPDS_LO  equ 0x28             ; Tx High Priority ring - unused, kept zeroed
  7893                                  RTL_IO_THPDS_HI  equ 0x2C
  7894                                  RTL_IO_CMD       equ 0x37             ; Chip Command register
  7895                                  RTL_IO_TPPOLL    equ 0x38             ; Transmit Priority Polling (kick DMA)
  7896                                  RTL_IO_IMR       equ 0x3C
  7897                                  RTL_IO_ISR       equ 0x3E
  7898                                  RTL_IO_TCR       equ 0x40             ; TxConfig
  7899                                  RTL_IO_RCR       equ 0x44             ; RxConfig
  7900                                  RTL_IO_9346CR    equ 0x50             ; EEPROM/config-register lock
  7901                                  RTL_IO_CPCMD     equ 0xE0             ; C+ Command Register
  7902                                  RTL_IO_RMS       equ 0xDA             ; Rx max packet size (word)
  7903                                  RTL_IO_MTPS      equ 0xEC             ; Tx max packet size, 128-byte units (byte)
  7904                                  RTL_IO_RDSAR_LO  equ 0xE4             ; Rx Descriptor Start Addr (low dword)
  7905                                  RTL_IO_RDSAR_HI  equ 0xE8
  7906                                  RTL_IO_PHYSTATUS equ 0x6C             ; PHY status register; bit1 = LinkStatus
  7907                                  RTL_IO_PHYAR     equ 0x60             ; PHY (MDIO) Access Register
  7908                                  RTL_PHYSTATUS_LINK equ 0x02
  7909                                  
  7910                                  RTL_CMD_RST      equ 0x10
  7911                                  RTL_CMD_TE       equ 0x04
  7912                                  RTL_CMD_RE       equ 0x08
  7913                                  RTL_9346_UNLOCK  equ 0xC0
  7914                                  RTL_9346_LOCK    equ 0x00
  7915                                  RTL_TPPOLL_NPQ   equ 0x40
  7916                                  
  7917                                  RTL_DESC_OWN     equ 0x80000000
  7918                                  RTL_DESC_EOR     equ 0x40000000
  7919                                  RTL_DESC_FS      equ 0x20000000
  7920                                  RTL_DESC_LS      equ 0x10000000
  7921                                  
  7922                                  RTL_RX_DESC_COUNT equ 8
  7923                                  RTL_TX_DESC_COUNT equ 8
  7924                                  RTL_RX_BUF_SIZE   equ 2048
