  9530                                  ; ------------------------------------------------------------------
  9531                                  ;  SFFS v2 volume I/O
  9532                                  ; ------------------------------------------------------------------
  9533                                  
  9534                                  ; vol_read: al = device id (0..3), rdi = base node index.
  9535                                  ; Loads an SFFS volume from that device into the node table at
  9536                                  ; [base .. base+VOL_NODES). For the OS volume (base 0) parents are
  9537                                  ; copied verbatim; for mounted volumes, on-disk relative parent indices
  9538                                  ; are remapped to the mount's global slice and the volume root becomes a
  9539                                  ; child of the OS root (parent 0).
  9540                                  ; returns rax = 0 on success, -1 on failure (absent device, bad magic,
  9541                                  ; or an I/O error). Sets fs_disk_available=0 when the device never
  9542                                  ; responded (i.e. there's no drive at that slot).
  9543                                  vol_read:
  9544 00018017 53                          push rbx
  9545 00018018 51                          push rcx
  9546 00018019 52                          push rdx
  9547 0001801A 56                          push rsi
  9548 0001801B 57                          push rdi
  9549 0001801C 4150                        push r8
  9550 0001801E 4151                        push r9
  9551 00018020 4152                        push r10
  9552 00018022 4989F8                      mov r8, rdi                 ; r8 = base node index
  9553 00018025 E8CDFAFFFF                  call disk_select_device
  9554 0001802A B818060000                  mov rax, SUPER_LBA
  9555 0001802F 488D3C25[88850300]          lea rdi, [fs_super_buf]
  9556 00018037 E8E2FAFFFF                  call disk_read_sector
  9557 0001803C 0F8204030000                jc .nodisk
  9558 00018042 803C25[88850300]53          cmp byte [fs_super_buf+0], 'S'
  9559 0001804A 0F85FE020000                jne .fail
  9560 00018050 803C25[89850300]46          cmp byte [fs_super_buf+1], 'F'
  9561 00018058 0F85F0020000                jne .fail
  9562 0001805E 803C25[8A850300]46          cmp byte [fs_super_buf+2], 'F'
  9563 00018066 0F85E2020000                jne .fail
  9564 0001806C 803C25[8B850300]53          cmp byte [fs_super_buf+3], 'S'
  9565 00018074 0F85D4020000                jne .fail
  9566                                      ; accept v4 (current, 256-node), legacy v3 (64-node), and v2 (old
  9567                                      ; single-block) formats. fs_layout_ver records which one so the
  9568                                      ; name/content sections below know which LBAs/sector counts to use;
  9569                                      ; the node_next section below still just needs "does this format even
  9570                                      ; have a chain sector" (true for v3 and v4, false for v2).
  9571 0001807A C60425[54E80500]00          mov byte [fs_layout_ver], 0
  9572 00018082 803C25[8C850300]04          cmp byte [fs_super_buf+4], SFFS_VERSION
  9573 0001808A 7419                        je .is_v4
  9574 0001808C 803C25[8C850300]03          cmp byte [fs_super_buf+4], SFFS_VERSION_V3
  9575 00018094 7419                        je .is_v3
  9576 00018096 803C25[8C850300]02          cmp byte [fs_super_buf+4], SFFS_VERSION_V2
  9577 0001809E 7417                        je .version_ok
  9578 000180A0 E9A9020000                  jmp .fail
  9579                                  .is_v4:
  9580 000180A5 C60425[54E80500]02          mov byte [fs_layout_ver], 2
  9581 000180AD EB08                        jmp .version_ok
  9582                                  .is_v3:
  9583 000180AF C60425[54E80500]01          mov byte [fs_layout_ver], 1
  9584                                  .version_ok:
  9585                                      ; node_type
  9586 000180B7 B819060000                  mov rax, TYPE_LBA
  9587 000180BC 488D3C25[508A0300]          lea rdi, [node_type]
  9588 000180C4 4C01C7                      add rdi, r8
  9589 000180C7 E852FAFFFF                  call disk_read_sector
  9590 000180CC 0F827C020000                jc .fail
