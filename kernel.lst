  3034                                  
  3035                                      ; Lex + collect functions now, so the user sees any error immediately.
  3036 00012AA3 E8BEA10000                  call party_reset_runtime
  3037 00012AA8 4C893C25[EFE70100]          mov qword [party_src_base], r15
  3038 00012AB0 4C89FE                      mov rsi, r15
  3039 00012AB3 E8D78D0000                  call party_lex
  3040 00012AB8 803C25[E8E70100]01          cmp byte [party_lex_ok], 1
  3041 00012AC0 0F852F010000                jne .crb_lex_fail
