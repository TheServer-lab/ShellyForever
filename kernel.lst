 12225                                  ; nic_arp_learn: eax = IP, rsi = 6-byte MAC. Insert/replace in the cache.
 12226                                  nic_arp_learn:
 12227 00019C0B 53                          push rbx
 12228 00019C0C 51                          push rcx
 12229 00019C0D 52                          push rdx
 12230 00019C0E 56                          push rsi
 12231 00019C0F 57                          push rdi
 12232 00019C10 4151                        push r9
 12233 00019C12 4152                        push r10
 12234 00019C14 4D31C9                      xor r9, r9
 12235                                  .learn_loop:
 12236 00019C17 4983F904                    cmp r9, NIC_ARP_CACHE_ENTRIES
 12237 00019C1B 7314                        jae .learn_new
 12238 00019C1D 496BD90A                    imul rbx, r9, 10
 12239 00019C21 488DBB[E3E80500]            lea rdi, [nic_arp_cache + rbx + 6]
 12240 00019C28 3B07                        cmp eax, [rdi]
 12241 00019C2A 7426                        je .learn_hit
 12242 00019C2C 49FFC1                      inc r9
 12243 00019C2F EBE6                        jmp .learn_loop
 12244                                  .learn_new:
 12245 00019C31 4C0FB60C25-                 movzx r9, byte [nic_arp_next]
 12245 00019C36 [05E90500]         
