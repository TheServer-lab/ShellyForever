  7973                                  ; rtc_sec_now: eax = current RTC seconds (0..59), zero-extended. Used for
  7974                                  ; coarse 1s-granularity timeouts in the ARP / ICMP / DNS wait loops.
  7975                                  rtc_sec_now:
  7976 00006B50 53                          push rbx
  7977 00006B51 52                          push rdx
  7978                                  .rsn_retry:
  7979 00006B52 E8822A0000                  call rtc_wait_uip            ; don't read while the RTC is mid-update
  7980 00006B57 B000                        mov al, 0x00
  7981 00006B59 E8662A0000                  call cmos_read
  7982 00006B5E 88C3                        mov bl, al                   ; first reading
  7983 00006B60 E8742A0000                  call rtc_wait_uip            ; guard again in case an update started
  7984                                                                    ; between our address-select and data read
  7985 00006B65 B000                        mov al, 0x00
  7986 00006B67 E8582A0000                  call cmos_read
  7987 00006B6C 38D8                        cmp al, bl
  7988 00006B6E 75E2                        jne .rsn_retry                ; two reads disagree - torn/transient, retry
  7989                                      ; BUGFIX: this used to return the raw CMOS byte unconverted. Real
  7990                                      ; hardware defaults to BCD mode (status B bit2 clear), same as
  7991                                      ; rtc_update already accounts for - so a seconds value of "10" comes
  7992                                      ; back as the byte 0x10 (16 decimal), "20" as 0x20 (32 decimal), etc.
  7993                                      ; Tick DETECTION (a plain inequality compare against the previous
  7994                                      ; reading) still fired correctly every real second regardless, so the
  7995                                      ; wait loop's actual budget was never shortened by this - but the
  7996                                      ; elapsed-time SUBTRACTION in the error path assumes plain binary
  7997                                      ; 0..59 seconds, so once start/end straddle a tens-digit boundary the
  7998                                      ; math comes out wrong (this is why a real ~5-6s wait was being
  7999                                      ; reported as "elapsed: 0" in netdiag_dump_tx). Mirror rtc_update's
  8000                                      ; own check of status register B bit2 rather than assuming BCD
  8001                                      ; unconditionally - only convert if the chip is actually in BCD mode.
  8002 00006B70 50                          push rax
  8003 00006B71 B00B                        mov al, 0x0B
  8004 00006B73 E84C2A0000                  call cmos_read
  8005 00006B78 A804                        test al, 0x04
  8006 00006B7A 750D                        jnz .rsn_binary               ; bit2 set = already binary, nothing to do
  8007 00006B7C 58                          pop rax
  8008 00006B7D 88D8                        mov al, bl
  8009 00006B7F E8632A0000                  call bcd_to_bin
  8010 00006B84 0FB6C0                      movzx eax, al
  8011 00006B87 EB04                        jmp .rsn_done
  8012                                  .rsn_binary:
  8013 00006B89 58                          pop rax
  8014 00006B8A 0FB6C3                      movzx eax, bl
  8015                                  .rsn_done:
  8016 00006B8D 5A                          pop rdx
  8017 00006B8E 5B                          pop rbx
  8018 00006B8F C3                          ret
