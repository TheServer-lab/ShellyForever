  5685                                  ; ------------------------------------------------------------------
  5686                                  ;  disk_*: dispatcher in front of the two disk drivers below (legacy ATA
  5687                                  ;  PIO above, AHCI further down). Every caller in this file - vol_read,
  5688                                  ;  vol_write, dscan, fmt, mount - goes through these three routines with
  5689                                  ;  al = device id, exactly like it always called ata_select_device /
  5690                                  ;  ata_read_sector / ata_write_sector directly before. Ids 0-3 still mean
  5691                                  ;  what they always meant (primary/secondary x master/slave); ids 4 and up
  5692                                  ;  mean an AHCI port slot claimed by ahci_init at boot.
  5693                                  ; ------------------------------------------------------------------
  5694                                  
  5695                                  ; disk_select_device: al = device id (0..TOTAL_DEVICES-1).
  5696                                  disk_select_device:
  5697 00004EA5 50                          push rax
  5698 00004EA6 3C04                        cmp al, 4
  5699 00004EA8 7213                        jb .use_ata
  5700 00004EAA C60425[389F0100]01          mov byte [disk_use_ahci], 1
  5701 00004EB2 2C04                        sub al, 4
  5702 00004EB4 880425[399F0100]            mov byte [ahci_cur_slot], al
  5703 00004EBB EB0D                        jmp .done
  5704                                  .use_ata:
  5705 00004EBD C60425[389F0100]00          mov byte [disk_use_ahci], 0
  5706 00004EC5 E81DFEFFFF                  call ata_select_device
  5707                                  .done:
  5708 00004ECA 58                          pop rax
  5709 00004ECB C3                          ret
  5710                                  
  5711                                  ; disk_read_sector: rax=LBA, rdi=dest buffer. Same in/out contract as
  5712                                  ; ata_read_sector - tail-jumps into whichever driver disk_select_device
  5713                                  ; picked, so its own CF/register contract passes straight through.
  5714                                  disk_read_sector:
  5715 00004ECC 803C25[389F0100]00          cmp byte [disk_use_ahci], 0
  5716 00004ED4 0F8444FEFFFF                je ata_read_sector
  5717 00004EDA E957030000                  jmp ahci_read_sector
  5718                                  
  5719                                  ; disk_write_sector: rax=LBA, rsi=source buffer. Same contract as above.
  5720                                  disk_write_sector:
  5721 00004EDF 803C25[389F0100]00          cmp byte [disk_use_ahci], 0
  5722 00004EE7 0F84E6FEFFFF                je ata_write_sector
  5723 00004EED E956030000                  jmp ahci_write_sector
  5724                                  
  5725                                  ; ------------------------------------------------------------------
  5726                                  ;  PCI configuration space access (legacy 0xCF8/0xCFC I/O ports). Used
  5727                                  ;  only to find and configure the AHCI controller below.
  5728                                  ; ------------------------------------------------------------------
  5729                                  PCI_CFG_ADDR equ 0x0CF8
  5730                                  PCI_CFG_DATA equ 0x0CFC
  5731                                  
  5732                                  ; pci_read32: ebx=bus, ecx=device(0-31), edx=function(0-7), r8b=offset
  5733                                  ; (byte, dword-aligned - low 2 bits ignored). Returns eax = the 32-bit
  5734                                  ; config space value at that offset. Preserves ebx/ecx/edx; clobbers r9.
  5735                                  pci_read32:
