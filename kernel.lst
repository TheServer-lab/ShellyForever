  5695                                  ; cmd_alias_invoke: called from dispatch when cmd_buf matched an alias
  5696                                  ; name, with [alias_match_idx] set to that alias's table index. Runs
  5697                                  ; the alias's stored body exactly like a freshly-typed line, through
  5698                                  ; the same chain processor (process_chain or process_chain_rr) that's
  5699                                  ; currently active, so ; chaining and ~ piping inside the alias work
  5700                                  ; normally and nested alias calls work too.
  5701                                  ;
  5702                                  ; This has to protect two pieces of global, shared state that would
  5703                                  ; otherwise be clobbered by that nested call:
  5704                                  ;   - chain_scan_buf: the outer process_chain(_rr) is still mid-scan
  5705                                  ;     over it (via r12/r13), so it's backed up on the stack, restored
  5706                                  ;     after the nested call returns. r12/r13 are ordinary registers,
  5707                                  ;     saved/restored by normal callee-saved discipline, so only the
  5708                                  ;     memory needs protecting, not the pointers themselves.
  5709                                  ;   - chain_is_rr: process_chain/process_chain_rr each set this as a
  5710                                  ;     side effect, so it's saved and restored too, otherwise an alias
  5711                                  ;     call partway through an rr script could leave later segments in
  5712                                  ;     that script using the wrong dispatch-wrapping behaviour.
  5713                                  ; alias_depth guards against runaway recursion (an alias that invokes
  5714                                  ; itself, directly or indirectly) overrunning the stack.
  5715                                  cmd_alias_invoke:
  5716 000053AF 50                          push rax
  5717 000053B0 53                          push rbx
  5718                                  
  5719 000053B1 480FB60425-                 movzx rax, byte [alias_depth]
  5719 000053B6 [F1A10300]         
  5720 000053BA 4883F808                    cmp rax, ALIAS_MAX_DEPTH
  5721 000053BE 7C14                        jl .cai_depth_ok
  5722 000053C0 48BE-                       mov rsi, msg_alias_too_deep
  5722 000053C2 [30C8010000000000] 
  5723 000053CA B00C                        mov al, ATTR_ERROR
  5724 000053CC E8AAEE0000                  call print_string_attr
  5725 000053D1 5B                          pop rbx
  5726 000053D2 58                          pop rax
  5727 000053D3 C3                          ret
  5728                                  .cai_depth_ok:
  5729 000053D4 FE0425[F1A10300]            inc byte [alias_depth]
  5730                                  
  5731 000053DB 480FB60425-                 movzx rax, byte [chain_is_rr]
  5731 000053E0 [F88F0300]         
  5732 000053E4 50                          push rax                        ; saved chain_is_rr, at [rsp+224] after the sub below
  5733                                  
  5734 000053E5 4881ECE0000000              sub rsp, 224                    ; > LINE_MAX, room to back up chain_scan_buf
  5735 000053EC 48BE-                       mov rsi, chain_scan_buf
  5735 000053EE [BC8D030000000000] 
  5736 000053F6 4889E7                      mov rdi, rsp
  5737 000053F9 E8A0ED0000                  call str_copy
  5738                                  
  5739 000053FE 480FB60425-                 movzx rax, byte [alias_match_idx]
  5739 00005403 [F0A10300]         
  5740 00005407 BBDC000000                  mov rbx, ALIAS_BODY_LEN
  5741 0000540C 480FAFC3                    imul rax, rbx
  5742 00005410 488DB0[98960300]            lea rsi, [alias_bodies + rax]
  5743 00005417 48BF-                       mov rdi, line_buf
  5743 00005419 [E08C030000000000] 
  5744 00005421 E878ED0000                  call str_copy
  5745                                  
  5746 00005426 488B8424E0000000            mov rax, [rsp+224]
  5747 0000542E 3C00                        cmp al, 0
  5748 00005430 7407                        je .cai_plain
  5749 00005432 E884ADFFFF                  call process_chain_rr
  5750 00005437 EB05                        jmp .cai_after
  5751                                  .cai_plain:
  5752 00005439 E8C8ACFFFF                  call process_chain
  5753                                  .cai_after:
  5754                                  
  5755 0000543E 4889E6                      mov rsi, rsp
  5756 00005441 48BF-                       mov rdi, chain_scan_buf
  5756 00005443 [BC8D030000000000] 
  5757 0000544B E84EED0000                  call str_copy
  5758 00005450 4881C4E0000000              add rsp, 224
  5759                                  
  5760 00005457 58                          pop rax
  5761 00005458 880425[F88F0300]            mov [chain_is_rr], al
  5762                                  
  5763 0000545F FE0C25[F1A10300]            dec byte [alias_depth]
