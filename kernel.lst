    44 0000B97C 09D0                <1>     or eax, edx
    45 0000B97E C1E008              <1>     shl eax, 8
    46 0000B981 0FB65602            <1>     movzx edx, byte [rsi+2]
    47 0000B985 09D0                <1>     or eax, edx
    48 0000B987 C1E008              <1>     shl eax, 8
    49 0000B98A 0FB65603            <1>     movzx edx, byte [rsi+3]
    50 0000B98E 09D0                <1>     or eax, edx
    51 0000B990 C3                  <1>     ret
    52                              <1> 
    53                              <1> ; tcp_store_be32: rdi = ptr, eax = host value -> stores big-endian dword.
