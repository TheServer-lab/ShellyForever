  5888                                  ; ------------------------------------------------------------------
  5889                                  ;  AHCI (SATA) driver. Talks to the HBA over MMIO (its ABAR, found via
  5890                                  ;  PCI BAR5) instead of legacy IDE ports - a different I/O model from the
  5891                                  ;  ata_* driver above, but the disk is identity-mapped memory either way
  5892                                  ;  once ahci_mark_uncached has run, so it's read/written with plain
  5893                                  ;  mov/or/and just like any other buffer in this file. No interrupts are
  5894                                  ;  used here either, matching the polled style of the rest of the OS:
  5895                                  ;  commands are issued and then polled for completion on PxCI.
  5896                                  ; ------------------------------------------------------------------
  5897                                  PCI_CMD_OFFSET  equ 0x04
  5898                                  PCI_BAR5_OFFSET equ 0x24
