  6837 0000641C 48C70425[4E890C00]-         mov qword [bg_capture_max], BG_RING_CAP
  6837 00006424 00100000           
  6838                                  
  6839 00006428 C60425[35890C00]01          mov byte [party_bg_active], 1
  6840 00006430 C70425[31890C00]C8-         mov dword [party_bg_quantum], BG_QUANTUM
