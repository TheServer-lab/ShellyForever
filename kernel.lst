     1                                  ; ============================================================
     2                                  ;  ShellyForever  --  kernel.asm
     3                                  ;  *** RELOCATED ABOVE 1MB (relocating loader rewrite) ***
     4                                  ;  This used to be loaded flat at physical 0x8000 (conventional memory)
     5                                  ;  together with splash.asm's %include, which is what capped the whole
     6                                  ;  OS at ~1216 sectors (base RAM tops out at 0x9FFFF; 0xA0000 is the VGA
     7                                  ;  framebuffer window, not RAM - see the old boot.asm/FS_LBA_START
     8                                  ;  comments in git history). That's gone: this file is now a SEPARATE
     9                                  ;  top-level build (kernel_body.bin) loaded at KERNEL_HIGH_BASE (2MB, see
    10                                  ;  layout.inc), with essentially no ceiling below the 4GB identity map
    11                                  ;  expand_identity_map builds a few instructions into kernel_entry.
    12                                  ;
    13                                  ;  boot.asm loads stage2.bin (splash + relocator + mode transition - see
    14                                  ;  stage2.asm, formerly this file's splash.asm %include) to 0x8000 in
    15                                  ;  real mode. stage2.asm's relocate_kernel_body then reads THIS binary
    16                                  ;  off disk in chunks and moves it up to KERNEL_HIGH_BASE via BIOS
    17                                  ;  INT 15h/AH=87h, still in real mode, before ever entering protected/
    18                                  ;  long mode. Once that's done, stage2 does A20/GDT/paging/long-mode and
    19                                  ;  jumps straight to KERNEL_HIGH_BASE, which is kernel_entry below - it's
    20                                  ;  the very first thing after the ORG/equ block (nothing but equ
    21                                  ;  constants, which emit no bytes, precedes it), so KERNEL_HIGH_BASE and
    22                                  ;  kernel_entry's address are always identical by construction. No IDT/
    23                                  ;  interrupts are set up - keyboard is polled.
    24                                  ; ============================================================
    25                                  
    26                                  %include "layout.inc"
     1                              <1> ; ============================================================
     2                              <1> ;  ShellyForever  --  layout.inc
     3                              <1> ;  Shared physical-memory / disk-layout constants for the two-stage boot
     4                              <1> ;  process. %include'd by boot.asm, stage2.asm, and kernel.asm so the
     5                              <1> ;  three separately-assembled binaries can never drift out of sync the
     6                              <1> ;  way KERNEL_SECTORS/FS_LBA_START used to (see boot.asm's old comments,
     7                              <1> ;  pre-relocation, in git history: "the two are not shared constants, so
     8                              <1> ;  nothing else will catch a drift between them" - this file is the fix
     9                              <1> ;  for that, not just for the ceiling bug).
    10                              <1> ; ============================================================
    11                              <1> 
    12                              <1> ; ---- disk layout (LBA, 512B sectors; LBA 0 is the MBR = boot.asm) ----
    13                              <1> STAGE2_LBA        equ 1                       ; stage2.bin starts right after the MBR
    14                              <1> 
    15                              <1> ; stage2.bin is the splash + relocator + real->protected->long-mode
    16                              <1> ; transition ONLY - not the whole OS anymore, so it has nothing like the
    17                              <1> ; old ~1216-sector conventional-memory ceiling to worry about. It still
    18                              <1> ; loads flat into conventional memory at 0x8000 in real mode (BIOS video/
    19                              <1> ; keyboard calls are needed for the splash and for the disk reads that
    20                              <1> ; relocate the real kernel), so it must still stay clear of the 0xA0000
    21                              <1> ; VGA window - but that is enormous headroom compared to what's actually
    22                              <1> ; here. Measured build is ~129 sectors (the 320x200 splash image, at
    23                              <1> ; 64768 bytes/~127 sectors, is almost all of that - the loader code
    24                              <1> ; itself is under 1000 bytes). 256 leaves roughly 2x margin, i.e. room
    25                              <1> ; for the splash image to grow a fair amount, or the loader code to grow
    26                              <1> ; a lot, without touching this constant again. If stage2 ever needs to
    27                              <1> ; grow past ~1200 sectors (a much bigger splash image, say), the same
    28                              <1> ; "load above 1MB" fix applies to it too, but that is not a realistic
    29                              <1> ; concern for a splash screen + loader.
    30                              <1> STAGE2_SECTORS    equ 256
    31                              <1> 
    32                              <1> KERNEL_BODY_LBA     equ STAGE2_LBA + STAGE2_SECTORS
    33                              <1> ; kernel_body.bin is the actual OS (everything that used to be kernel.asm
    34                              <1> ; after splash.asm's %include - party/tcp/http/crypto/tls/https/browse/
    35                              <1> ; mouse/zip/install and all). It is loaded and relocated above 1MB in
    36                              <1> ; chunks by stage2 (see stage2.asm's relocate_kernel_body), so it is NOT
    37                              <1> ; bounded by conventional memory at all - the only real ceiling left is
    38                              <1> ; expand_identity_map's 4GB identity map (kernel_entry runs long before
    39                              <1> ; that map is even needed to be complete for the kernel's own code/data,
    40                              <1> ; since KERNEL_HIGH_BASE below sits inside splash_pm32's boot-time 0-64MB
    41                              <1> ; temporary map). With the real party/tcp/http/crypto/tls/https/browse/
    42                              <1> ; mouse/zip/install modules (not the placeholder stubs used to test-
    43                              <1> ; assemble this rewrite) the build was previously measured around ~1400
    44                              <1> ; sectors including Phase 5 (crypto/TLS/HTTPS). 2200 leaves meaningful
    45                              <1> ; margin above that for further growth without touching this file again
    46                              <1> ; for a while - VERIFY against a real full build before shipping and bump
    47                              <1> ; if needed. If it does need to grow, just bump this constant - there is
    48                              <1> ; no hidden physical wall to hit anymore, only disk capacity and
    49                              <1> ; FS_LBA_START below (which is derived from this, not hand-maintained, so
    50                              <1> ; it can never drift out of sync the way it used to).
    51                              <1> KERNEL_BODY_SECTORS equ 2200
    52                              <1> 
    53                              <1> ; ---- filesystem region: starts safely after the kernel body, wherever
    54                              <1> ; that ends up being. Derived, not hand-copied, so bumping
    55                              <1> ; KERNEL_BODY_SECTORS above can never silently leave FS_LBA_START
    56                              <1> ; pointing into the kernel the way the old manually-synced constants
    57                              <1> ; could (see boot.asm's pre-relocation comments). +64 sectors slack on
    58                              <1> ; top of that for a little extra safety margin. ----
    59                              <1> FS_LBA_START equ KERNEL_BODY_LBA + KERNEL_BODY_SECTORS + 64
    60                              <1> 
    61                              <1> ; ---- real-mode physical memory layout ----
    62                              <1> STAGE2_LOAD_SEG   equ 0x0000
    63                              <1> STAGE2_LOAD_OFF   equ 0x8000          ; same spot the old flat kernel used to load;
    64                              <1>                                        ; still fine now that stage2 is small.
    65                              <1> 
    66                              <1> ; The kernel body's new home. 2MB, chosen because splash_pm32's temporary
    67                              <1> ; boot-time identity map already covers 0-64MB with 2MB pages, so
    68                              <1> ; far-jumping straight here works correctly even before
    69                              <1> ; expand_identity_map (kernel_entry's first call) extends that map to a
    70                              <1> ; full 0-4GB map. Comfortably clear of every low-memory fixed address
    71                              <1> ; still in use: real-mode IVT/BDA (0-0x500), the long-mode page tables
    72                              <1> ; (0x1000-0x6FFF, built by splash_pm32/expand_identity_map), stage2's own
    73                              <1> ; code/data (0x8000 upward), the relocation staging buffer below, and the
    74                              <1> ; boot-time stack (0x9F000, set in both splash_lm64 and kernel_entry).
    75                              <1> KERNEL_HIGH_BASE  equ 0x00200000
    76                              <1> 
    77                              <1> ; ---- relocation staging buffer: stage2 reads each disk chunk here (still
    78                              <1> ; real mode, still comfortably under 1MB), then INT 15h/AH=87h moves it up
    79                              <1> ; to KERNEL_HIGH_BASE+offset. This one buffer is reused every iteration -
    80                              <1> ; only the source LBA (advancing through the disk) and the destination
    81                              <1> ; offset (advancing through KERNEL_HIGH_BASE) change between chunks, so
    82                              <1> ; there's no seg:off-growth arithmetic needed here the way boot.asm's old
    83                              <1> ; single flat read into a growing >64K buffer needed dap_set_buf. ----
    84                              <1> STAGE_BUF         equ 0x00040000      ; 256KB mark - far clear of stage2 itself
    85                              <1>                                        ; (measured ~20KB) and everything else below 1MB
    86                              <1> CHUNK_SECTORS     equ 64              ; 32KB per chunk
    87                              <1> CHUNK_BYTES       equ CHUNK_SECTORS * 512
    88                              <1> CHUNK_WORDS       equ CHUNK_BYTES / 2 ; INT 15h/AH=87h counts in words; max legal
    89                              <1>                                        ; value is 8000h (32K words = 64KB) - 4000h
    90                              <1>                                        ; keeps a healthy margin below that ceiling
    91                              <1>                                        ; for older/pickier BIOSes.
    27                                  
    28                                  BITS 64
    29                                  ORG KERNEL_HIGH_BASE
    30                                  ; ---------------- constants ----------------
    31                                  VGA_BASE        equ 0xB8000
    32                                  VGA_COLS        equ 80
    33                                  VGA_ROWS        equ 25
    34                                  ATTR_NORMAL     equ 0x0A          ; bright green on black
    35                                  ATTR_PROMPT     equ 0x0E          ; yellow
    36                                  ATTR_ERROR      equ 0x0C          ; red
    37                                  ATTR_WIG        equ 0x0B          ; light cyan - used by the wig clock widget
    38                                  
    39                                  ; cmd_edit redraws its whole viewport from scratch on every keystroke (see
    40                                  ; cmd_edit below); the first EDIT_HEADER_ROWS screen rows are always the
    41                                  ; "-- editing <name> ... --" banner and a blank line, so the scrollable
    42                                  ; body only gets EDIT_BODY_ROWS rows (see below - one short of the
    43                                  ; physical remainder on purpose). Must match the number of newlines
    44                                  ; msg_edit_header1+msg_edit_header2 print before file content.
    45                                  EDIT_HEADER_ROWS equ 2
    46                                  
    47                                  ; The body must never be allowed to completely fill the screen's last
    48                                  ; physical row (row VGA_ROWS-1): putchar has no idea it's being driven by
    49                                  ; a fixed-viewport editor, so finishing that row (via an 80-col wrap or a
    50                                  ; real newline) makes it advance the cursor past the bottom exactly like
    51                                  ; a scrolling terminal - triggering scroll_screen mid-render. That shifts
    52                                  ; everything .ce_render already drew (including the header just printed
    53                                  ; moments earlier in this same call) up and off-screen, while the
    54                                  ; render's own row bookkeeping (r12/r9) has no idea it happened - the
    55                                  ; next call's cursor-position capture ends up stale/misplaced. Reserving
    56                                  ; one unused row at the bottom keeps every row .ce_render draws strictly
    57                                  ; above VGA_ROWS-1, so that transition can never happen.
    58                                  EDIT_BODY_ROWS  equ VGA_ROWS - EDIT_HEADER_ROWS - 1
    59                                  
    60                                  ; SFFS v5 removes the old chain-of-nodes content storage entirely: the
    61                                  ; node table used to hold file bytes (160 bytes per node, chained through
    62                                  ; type-3 continuation nodes), which capped one file at ~40KB and let a
    63                                  ; handful of files exhaust all 256 node slots of a volume while the disk
    64                                  ; was still almost empty. v5 stores file content in 4096-byte clusters on
    65                                  ; disk (see the SFFS v5 block below), so a file can span (almost) the
    66                                  ; whole 256 MiB disk and node slots are used only by real files/folders.
    67                                  OS_NODES        equ 256             ; nodes per volume (each drive holds its own node table)
    68                                  MAX_MOUNTS      equ 2               ; how many extra drives can be mounted at once
    69                                  
    70                                  ; AHCI (SATA) support: device ids 0-3 are still the legacy ATA PIO slots
    71                                  ; (primary/secondary x master/slave); ids 4..4+AHCI_MAX_PORTS-1 are AHCI
    72                                  ; ports discovered at boot (see ahci_init). dscan/fmt/mount all iterate
    73                                  ; 0..TOTAL_DEVICES-1 and go through disk_select_device, which routes each
    74                                  ; id to the right driver - see that routine for the full explanation.
    75                                  AHCI_MAX_PORTS  equ 4
    76                                  TOTAL_DEVICES   equ 4 + AHCI_MAX_PORTS
    77                                  VOL_NODES       equ OS_NODES        ; every volume, OS or mounted, is the same size
    78                                  MAX_NODES       equ OS_NODES * (1 + MAX_MOUNTS)   ; 768 = OS volume + 2 mounts
    79                                  NAME_LEN        equ 32
    80                                  LINE_MAX        equ 220
    81                                  
    82                                  SCROLLBACK_LINES equ 100         ; extra off-screen rows kept for Ctrl+Up/Down
    83                                  HISTORY_MAX      equ 20          ; command history entries kept for Up/Down
    84                                  KEY_UP           equ 0x11        ; sentinel byte get_char returns for the Up arrow
    85                                  KEY_DOWN         equ 0x12        ; sentinel byte get_char returns for the Down arrow
    86                                  KEY_PASTE        equ 0x13        ; sentinel byte get_char returns for Ctrl+V
    87                                  KEY_LEFT         equ 0x14        ; sentinel byte get_char returns for the Left arrow
    88                                  KEY_RIGHT        equ 0x15        ; sentinel byte get_char returns for the Right arrow
    89                                  KEY_HOME         equ 0x16        ; sentinel byte get_char returns for Home
    90                                  KEY_END          equ 0x17        ; sentinel byte get_char returns for End
    91                                  KEY_DELETE       equ 0x18        ; sentinel byte get_char returns for Delete
    92                                  
    93                                  MAX_VARS        equ 16
    94                                  VAR_NAME_LEN    equ 32
    95                                  MAX_CALC_TOKENS equ 32
    96                                  
    97                                  MAX_ALIASES     equ 12         ; how many "ali <name> <commands>" aliases can exist at once
    98                                  ALIAS_NAME_LEN  equ 32
    99                                  ALIAS_BODY_LEN  equ LINE_MAX   ; an alias body is at most one full input line
   100                                  ALIAS_MAX_DEPTH equ 8          ; guards against an alias (in)directly invoking itself
   101                                  
   102                                  PIPE_CAP_MAX    equ 192       ; max bytes captured from a "~" pipe's left side
   103                                  
   104                                  ; ------------------------------------------------------------------
   105                                  ;  SFFS v5 -- ShellyForever File Storage format (on-disk layout).
   106                                  ;  Every drive (OS boot drive and any data drives) uses the same fixed
   107                                  ;  layout so any drive can be scanned, formatted, and mounted:
   108                                  ;
   109                                  ;    LBA  FS_LBA_START       : superblock (512B) - magic 'SFFS', version
   110                                  ;                              byte, reserved, 32-byte disk label
   111                                  ;    LBA  FS_LBA_START+1     : node_type[VOL_NODES]   (1 sector)
   112                                  ;    LBA  FS_LBA_START+2     : node_parent[VOL_NODES] (1 sector; 0xFFFF = root)
   113                                  ;    LBA  FS_LBA_START+3..   : node_name[VOL_NODES*NAME_LEN] (NAME_SECTORS)
   114                                  ;    LBA  ..after name..     : node_bin_len[VOL_NODES]   (BINLEN_SECTORS)
   115                                  ;    LBA  ..after binlen..   : node_first_block[VOL_NODES] (FIRSTBLOCK_SECTORS)
   116                                  ;    LBA  ..after firstblk.. : free-block bitmap (BITMAP_SECTORS)
   117                                  ;    LBA  DATA_START_LBA..   : data area, allocated in CLUSTER_SECTORS
   118                                  ;                              (4096-byte) clusters
   119                                  ;
   120                                  ;  A node (type 1 = folder, type 2 = file) only holds metadata now. A
   121                                  ;  file's bytes live in a contiguous run of clusters starting at
   122                                  ;  node_first_block[node]; node_bin_len[node] is the exact byte count.
   123                                  ;  The bitmap tracks which clusters are free (1 bit per cluster; 0 = free,
   124                                  ;  1 = used), one per volume, cached in RAM and persisted at the same
   125                                  ;  fixed LBA on each disk.
   126                                  ;
   127                                  ;  *** What changed in v5 ***
   128                                  ;  v4 kept content in the node table itself (160 bytes/node, chained
   129                                  ;  through type-3 continuation nodes) which capped one file at ~40KB and
   130                                  ;  let a handful of files exhaust all 256 node slots of a volume while
   131                                  ;  the disk was still almost empty. v5 moves content off the node table
   132                                  ;  entirely: node_content/node_next are gone, replaced by a 4-byte
   133                                  ;  starting-cluster index per node. Files now grow up to the whole data
   134                                  ;  region (~255 MB on a 256 MiB disk), the node table is used only by
   135                                  ;  real files/folders, and interactive view/edit/run still stage content
   136                                  ;  through the fixed fs_io_buf (EDIT_MAX bytes) exactly as before.
   137                                  ;
   138                                  ;  *** Backward compatibility ***
   139                                  ;  NONE. v2/v3/v4 volumes (and the old single-block layout) are no longer
   140                                  ;  readable - the on-disk layout and the semantics of node_next differ too
   141                                  ;  much. Any existing disk must be reformatted (dscan/fmt). This is a
   142                                  ;  deliberate breaking change to fund the cluster-based design.
   143                                  ;
   144                                  ;  dscan probes all device slots for the magic, format writes a fresh
   145                                  ;  empty volume + label, and mount loads a volume's node table + bitmap
   146                                  ;  into memory (remapping its parent indices) rooted at /<label>/.
   147                                  ;  The kernel now occupies LBA STAGE2_LBA..FS_LBA_START-1 (stage2.bin +
   148                                  ;  kernel_body.bin, see layout.inc) - relocated above 1MB by
   149                                  ;  relocate_kernel_body, so there is no more hard ceiling tied to
   150                                  ;  0x8000/0xA0000 the way there used to be (see this file's header
   151                                  ;  comment). FS_LBA_START is derived from KERNEL_BODY_SECTORS in
   152                                  ;  layout.inc, not hand-copied here, so it can't silently drift out of
   153                                  ;  sync with the kernel's actual on-disk footprint the way it used to.
   154                                  ;  v5 needs ~36 sectors of metadata per volume (was ~100) - tiny - and
   155                                  ;  the data area spans the rest of the disk.
   156                                  ; ------------------------------------------------------------------
   157                                  ; FS_LBA_START now comes from layout.inc (KERNEL_BODY_LBA + KERNEL_BODY_SECTORS
   158                                  ; + slack) so boot.asm/stage2.asm/kernel.asm can never disagree about where
   159                                  ; the kernel ends and the filesystem begins. *** BREAKING CHANGE (unchanged
   160                                  ; from before this rewrite): any image with a filesystem already written at
   161                                  ; an old FS_LBA_START needs to be reformatted (dscan/fmt) after updating,
   162                                  ; or that data is effectively at the wrong LBA and won't be found. ***
   163                                  SFFS_VERSION    equ 5               ; current on-disk format (cluster-based file storage)
   164                                  SUPER_LABEL_OFF equ 8               ; label lives at superblock offset 8..39
   165                                  SUPER_LBA       equ FS_LBA_START
   166                                  TYPE_LBA        equ SUPER_LBA + 1
   167                                  PARENT_LBA      equ SUPER_LBA + 2
   168                                  NAME_LBA        equ SUPER_LBA + 3
   169                                  NAME_SECTORS    equ (VOL_NODES * NAME_LEN) / 512          ; 16 (256 nodes * 32B / 512)
   170                                  BINLEN_LBA      equ NAME_LBA + NAME_SECTORS                ; computed, not hardcoded
   171                                  BINLEN_SECTORS  equ (VOL_NODES * 4) / 512                 ; 2 (256 nodes * 4B / 512)
   172                                  FIRSTBLOCK_LBA  equ BINLEN_LBA + BINLEN_SECTORS
   173                                  FIRSTBLOCK_SECTORS equ (VOL_NODES * 4) / 512              ; 2 (256 nodes * 4B / 512)
   174                                  BITMAP_LBA      equ FIRSTBLOCK_LBA + FIRSTBLOCK_SECTORS
   175                                  BITMAP_SECTORS  equ 16              ; covers 16*512*8 = 65536 clusters >= 65336 (whole disk)
   176                                  BITMAP_BYTES    equ BITMAP_SECTORS * 512                  ; 8192 bytes per volume's cached bitmap
   177                                  DATA_START_LBA  equ BITMAP_LBA + BITMAP_SECTORS           ; first cluster LBA of the data area
   178                                  CLUSTER_SECTORS equ 8               ; one allocation unit = 4096 bytes
   179                                  CLUSTER_BYTES   equ CLUSTER_SECTORS * 512
   180                                  TOTAL_DISK_SECTORS equ 256 * 1024 * 1024 / 512            ; 524288 (a 256 MiB image)
   181                                  TOTAL_CLUSTERS  equ (TOTAL_DISK_SECTORS - DATA_START_LBA) / CLUSTER_SECTORS ; 65336
   182                                  EMPTY_CLUSTER   equ 0xFFFFFFFF      ; node_first_block value meaning "file is empty"
   183                                  
   184                                  EDIT_MAX        equ 20480           ; max bytes one file can hold in the staging buffers
   185                                                                      ; (fs_io_buf / script buffers) - a cap on interactive
   186                                                                      ; view/edit/run, not on the on-disk format anymore.
   187                                                                      ; REVERTED from 40960 (2026-08-14): that build pushed
   188                                                                      ; kernel.bin's end address past rsp=0x9F000 (set in
   189                                                                      ; kernel_entry), colliding the stack with fs_io_buf/
   190                                                                      ; rr_script_buf and corrupting the editor's own view
   191                                                                      ; (blank content, garbage glyphs). Don't just bump this
   192                                                                      ; equ again without first shrinking the ~61KB it costs
   193                                                                      ; at 40960 - see the split-buffer plan in kernel_entry's
   194                                                                      ; area / ask before re-raising.
   195                                  
   196                                  ; ============================================================
   197                                  kernel_entry:
   198 00000000 FA                          cli
   199 00000001 BC00F00900                  mov rsp, 0x9F000
   200                                  
   201                                      ; bring up COM1 immediately so putchar can mirror every character there,
   202                                      ; letting QEMU capture the whole session to a file via -serial file:.
   203 00000006 E87E0C0700                  call serial_init
   204                                  
   205                                  
   206                                      ; --- TEMPORARY diagnostic checkpoint A: proves stage2's real-mode ->
   207                                      ; protected-mode -> long-mode transition landed here at all, before
   208                                      ; expand_identity_map or ahci_init get a chance to run/crash. If you
   209                                      ; only ever see up through "7" (stage2's last checkpoint) and never
   210                                      ; "A", the failure is inside stage2's mode-switch code (A20/GDT/
   211                                      ; paging/long-mode jump/relocation) or in the jump to KERNEL_HIGH_BASE,
   212                                      ; not in the kernel body itself. Column shifted to 7 (was 6, pre-
   213                                      ; relocation-rewrite) since stage2 now uses one more checkpoint column
   214                                      ; for relocate_kernel_body - see stage2.asm.
   215 0000000B BF0E8F0B00                  mov rdi, 0xB8000 + (24*80 + 7) * 2
   216 00000010 C60741                      mov byte [rdi], 'A'
   217 00000013 C647011F                    mov byte [rdi+1], 0x1F
   218                                  
   219                                      ; boot.asm only had room (512-byte sector) to identity-map the first
   220                                      ; 64MB. That's not enough for acpi_shutdown's ACPI table walk later -
   221                                      ; firmware can put the FADT/DSDT well above 64MB (e.g. ~127MB on a
   222                                      ; 128MB guest) - so extend the map to 4GB right away, before anything
   223                                      ; else runs. See expand_identity_map below for details.
   224 00000017 E828060000                  call expand_identity_map
   225                                  
   226                                      ; --- TEMPORARY diagnostic checkpoint X: expand_identity_map returned
   227                                      ; without crashing/hanging. If "A" shows but "X" doesn't, the 4GB
   228                                      ; identity-map rebuild is where things go wrong on this hardware.
   229 0000001C BF108F0B00                  mov rdi, 0xB8000 + (24*80 + 8) * 2
   230 00000021 C60758                      mov byte [rdi], 'X'
   231 00000024 C647011F                    mov byte [rdi+1], 0x1F
   232                                  
   233                                      ; probe for a PCI AHCI (SATA) controller and bring up its ports, if any,
   234                                      ; as extra disk device slots (4..4+AHCI_MAX_PORTS-1) alongside the four
   235                                      ; legacy ATA slots. Inert/no-op if there isn't one (ahci_port_count stays
   236                                      ; 0) - the OS behaves exactly as it always did in that case.
   237 00000028 E8798C0000                  call ahci_init
   238                                  
   239                                      ; probe for a PCI RTL8139 NIC and bring up its ring buffers, if any.
   240                                      ; Inert/no-op if there isn't one (nic_present stays 0) - the OS behaves
   241                                      ; exactly as it always did in that case. See nic_init below.
   242 0000002D E864980000                  call nic_init
   243                                  
   244                                      ; bring up COM1 as a serial console; putchar mirrors every char there, so
   245                                      ; QEMU can capture the whole session to a file via -serial file:.
   246 00000032 E8520C0700                  call serial_init
   247                                  
   248                                      ; checkpoint K: kernel code is executing (proves stage2's jump to
   249                                      ; KERNEL_HIGH_BASE landed correctly). Matches the DBG16/dbg_local
   250                                      ; checkpoints in boot.asm/stage2.asm - if you see 1..7,A,X but not
   251                                      ; this, something is wrong between expand_identity_map and here; if
   252                                      ; the OS otherwise looks fine you can ignore it.
   253 00000037 BF128F0B00                  mov rdi, 0xB8000 + (24*80 + 9) * 2
   254 0000003C C6074B                      mov byte [rdi], 'K'
   255 0000003F C647010F                    mov byte [rdi+1], 0x0F
   256                                  
   257 00000043 E83D0B0700                  call clear_screen
   258                                  
   259                                      ; calibrate the RDTSC-based sleep_ms delay (Party's sleep() builtin)
   260                                      ; against the RTC's real 1-second tick - see the TIMING/SLEEP section
   261                                      ; below for why this exists instead of a PIT/IRQ0 timer. Takes up to
   262                                      ; ~1 real second; done once, here, before anything could call sleep().
   263 00000048 E8E4BF0000                  call tsc_calibrate
   264                                  
   265 0000004D E82AB90000                  call fs_load                ; loads persisted fs from disk, or fs_init's a fresh one
   266                                  
