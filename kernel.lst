  9789 0001835F 5B                          pop rbx
  9790 00018360 C3                          ret
  9791                                  
  9792                                  ; vol_write: al = device id, rdi = base node index, rsi = label ptr.
  9793                                  ; Writes the volume at [base .. base+VOL_NODES) plus a fresh superblock
  9794                                  ; (magic + version + label) to that device. Parents are remapped back to
  9795                                  ; on-disk relative indices (the volume root is stored as 0xFFFF).
  9796                                  ; returns CF=0 on success, CF=1 on failure.
  9797                                  vol_write:
  9798 00018361 50                          push rax
  9799 00018362 53                          push rbx
  9800 00018363 51                          push rcx
  9801 00018364 52                          push rdx
  9802 00018365 56                          push rsi
  9803 00018366 57                          push rdi
  9804 00018367 4150                        push r8
  9805 00018369 4151                        push r9
  9806 0001836B 4989F8                      mov r8, rdi                 ; r8 = base node index
  9807 0001836E 4989F1                      mov r9, rsi                 ; r9 = label ptr
  9808 00018371 E881F7FFFF                  call disk_select_device
  9809                                      ; --- build and write the superblock ---
  9810 00018376 C60425[88850300]53          mov byte [fs_super_buf+0], 'S'
  9811 0001837E C60425[89850300]46          mov byte [fs_super_buf+1], 'F'
  9812 00018386 C60425[8A850300]46          mov byte [fs_super_buf+2], 'F'
  9813 0001838E C60425[8B850300]53          mov byte [fs_super_buf+3], 'S'
  9814 00018396 C60425[8C850300]04          mov byte [fs_super_buf+4], SFFS_VERSION
  9815 0001839E C60425[8D850300]00          mov byte [fs_super_buf+5], 0
  9816 000183A6 C60425[8E850300]00          mov byte [fs_super_buf+6], 0
  9817 000183AE C60425[8F850300]00          mov byte [fs_super_buf+7], 0
  9818 000183B6 48BF-                       mov rdi, fs_super_buf
  9818 000183B8 [8885030000000000] 
  9819 000183C0 4883C708                    add rdi, SUPER_LABEL_OFF
  9820 000183C4 B920000000                  mov rcx, 32
  9821 000183C9 30C0                        xor al, al
  9822 000183CB F3AA                        rep stosb
  9823 000183CD 4C89CE                      mov rsi, r9
  9824 000183D0 48BF-                       mov rdi, fs_super_buf
  9824 000183D2 [8885030000000000] 
  9825 000183DA 4883C708                    add rdi, SUPER_LABEL_OFF
  9826 000183DE 4831C9                      xor rcx, rcx
  9827                                  .label_copy:
  9828 000183E1 4883F91F                    cmp rcx, 31
  9829 000183E5 7313                        jae .label_done
  9830 000183E7 8A06                        mov al, [rsi]
  9831 000183E9 84C0                        test al, al
  9832 000183EB 740D                        jz .label_done
  9833 000183ED 8807                        mov [rdi], al
  9834 000183EF 48FFC6                      inc rsi
  9835 000183F2 48FFC7                      inc rdi
  9836 000183F5 48FFC1                      inc rcx
  9837 000183F8 EBE7                        jmp .label_copy
  9838                                  .label_done:
  9839 000183FA B818060000                  mov rax, SUPER_LBA
  9840 000183FF 488D3425[88850300]          lea rsi, [fs_super_buf]
  9841 00018407 E825F7FFFF                  call disk_write_sector
  9842 0001840C 0F8270010000                jc .fail
  9843                                      ; --- node_type ---
  9844 00018412 B819060000                  mov rax, TYPE_LBA
  9845 00018417 488D3425[508A0300]          lea rsi, [node_type]
  9846 0001841F 4C01C6                      add rsi, r8
  9847 00018422 E80AF7FFFF                  call disk_write_sector
  9848 00018427 0F8255010000                jc .fail
  9849                                      ; --- node_parent (remap to on-disk relative indices) ---
  9850 0001842D 4831C9                      xor rcx, rcx
  9851                                  .parent_loop:
  9852 00018430 4881F900010000              cmp rcx, VOL_NODES
  9853 00018437 7333                        jae .parent_done
  9854 00018439 4883F900                    cmp rcx, 0
  9855 0001843D 741E                        je .parent_root
  9856 0001843F 4C89C0                      mov rax, r8
  9857 00018442 4801C8                      add rax, rcx                 ; rax = global node index (base+i)
  9858 00018445 48D1E0                      shl rax, 1                   ; rax = byte offset into node_parent (word-sized)
  9859 00018448 480FB780[50900300]          movzx rax, word [node_parent + rax]
  9860 00018450 4C29C0                      sub rax, r8
  9861 00018453 66898409[0C880300]          mov [fs_parent_scratch + rcx*2], ax
  9862 0001845B EB0A                        jmp .parent_next
  9863                                  .parent_root:
  9864 0001845D 66C78409[0C880300]-         mov word [fs_parent_scratch + rcx*2], 0xFFFF
  9864 00018465 FFFF               
  9865                                  .parent_next:
  9866 00018467 48FFC1                      inc rcx
  9867 0001846A EBC4                        jmp .parent_loop
  9868                                  .parent_done:
  9869 0001846C B81A060000                  mov rax, PARENT_LBA
  9870 00018471 488D3425[0C880300]          lea rsi, [fs_parent_scratch]
  9871 00018479 E8B3F6FFFF                  call disk_write_sector
  9872 0001847E 0F82FE000000                jc .fail
  9873                                      ; --- node_next: this volume's 64 words padded to a full 0xFFFF sector ---
  9874 00018484 48BF-                       mov rdi, fs_next_scratch
  9874 00018486 [3198080000000000] 
  9875 0001848E B900010000                  mov rcx, 512 / 2
  9876 00018493 66B8FFFF                    mov ax, 0xFFFF
  9877 00018497 66F3AB                      rep stosw
  9878 0001849A 4B8DB400[50D60500]          lea rsi, [node_next + r8*2]
  9879 000184A2 488D3C25[31980800]          lea rdi, [fs_next_scratch]
  9880 000184AA B900010000                  mov rcx, VOL_NODES
  9881 000184AF 66F3A5                      rep movsw
  9882 000184B2 B81B060000                  mov rax, NEXT_LBA
  9883 000184B7 488D3425[31980800]          lea rsi, [fs_next_scratch]
  9884 000184BF E86DF6FFFF                  call disk_write_sector
  9885 000184C4 0F82B8000000                jc .fail
  9886                                      ; --- node_name ---
  9887 000184CA B81C060000                  mov rax, NAME_LBA
  9888 000184CF B910000000                  mov rcx, NAME_SECTORS
  9889 000184D4 488D3425[50960300]          lea rsi, [node_name]
  9890 000184DC 4C89C7                      mov rdi, r8
  9891 000184DF 486BFF20                    imul rdi, NAME_LEN
  9892 000184E3 4801FE                      add rsi, rdi
  9893                                  .name_loop:
  9894 000184E6 50                          push rax
  9895 000184E7 51                          push rcx
  9896 000184E8 56                          push rsi
  9897 000184E9 E879470100                  call spinner_step
  9898 000184EE E83EF6FFFF                  call disk_write_sector
  9899 000184F3 5E                          pop rsi
  9900 000184F4 59                          pop rcx
  9901 000184F5 58                          pop rax
  9902 000184F6 0F8286000000                jc .fail
  9903 000184FC 4881C600020000              add rsi, 512
  9904 00018503 48FFC0                      inc rax
  9905 00018506 E2DE                        loop .name_loop
  9906                                      ; --- node_content ---
  9907 00018508 B82C060000                  mov rax, CONTENT_LBA
  9908 0001850D B950000000                  mov rcx, CONTENT_SECTORS
  9909 00018512 488D3425[50F60300]          lea rsi, [node_content]
  9910 0001851A 4C89C7                      mov rdi, r8
  9911 0001851D 4869FFA0000000              imul rdi, CONTENT_LEN
  9912 00018524 4801FE                      add rsi, rdi
  9913                                  .content_loop:
