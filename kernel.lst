  5479 00004C9E 52                          push rdx
  5480 00004C9F 51                          push rcx
  5481 00004CA0 B900004000                  mov rcx, ATA_TIMEOUT
  5482 00004CA5 0FB71425[F09E0100]          movzx edx, word [ata_port_base]
  5483 00004CAD 6683C207                    add dx, 7
  5484                                  .wait:
  5485 00004CB1 EC                          in al, dx
  5486 00004CB2 A880                        test al, 0x80
  5487 00004CB4 7407                        jz .ok
  5488 00004CB6 E2F9                        loop .wait
  5489 00004CB8 59                          pop rcx
  5490 00004CB9 5A                          pop rdx
  5491 00004CBA 58                          pop rax
  5492 00004CBB F9                          stc
  5493 00004CBC C3                          ret
  5494                                  .ok:
  5495 00004CBD 59                          pop rcx
  5496 00004CBE 5A                          pop rdx
  5497 00004CBF 58                          pop rax
  5498 00004CC0 F8                          clc
  5499 00004CC1 C3                          ret
  5500                                  
