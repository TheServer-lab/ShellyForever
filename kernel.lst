 13835                                  ; var_find: rsi=name -> rax=index or -1. Preserves rsi.
 13836                                  var_find:
 13837 0001AC3E 56                          push rsi
 13838 0001AC3F 57                          push rdi
 13839 0001AC40 51                          push rcx
 13840 0001AC41 4831C9                      xor rcx, rcx
 13841                                  .vf_loop:
 13842 0001AC44 4883F910                    cmp rcx, MAX_VARS
 13843 0001AC48 732E                        jae .vf_notfound
 13844 0001AC4A 80B9[08ED0600]00            cmp byte [var_used+rcx], 0
 13845 0001AC51 741B                        je .vf_next
 13846 0001AC53 4889CF                      mov rdi, rcx
 13847 0001AC56 486BFF20                    imul rdi, VAR_NAME_LEN
 13848 0001AC5A 488DBF[88EA0600]            lea rdi, [var_name+rdi]
 13849 0001AC61 56                          push rsi
 13850 0001AC62 51                          push rcx
 13851 0001AC63 E89B1C0100                  call str_eq
 13852 0001AC68 59                          pop rcx
 13853 0001AC69 5E                          pop rsi
 13854 0001AC6A 3C01                        cmp al, 1
 13855 0001AC6C 7405                        je .vf_found
 13856                                  .vf_next:
 13857 0001AC6E 48FFC1                      inc rcx
 13858 0001AC71 EBD1                        jmp .vf_loop
 13859                                  .vf_found:
 13860 0001AC73 4889C8                      mov rax, rcx
 13861 0001AC76 EB07                        jmp .vf_out
 13862                                  .vf_notfound:
 13863 0001AC78 48C7C0FFFFFFFF              mov rax, -1
 13864                                  .vf_out:
 13865 0001AC7F 59                          pop rcx
 13866 0001AC80 5F                          pop rdi
 13867 0001AC81 5E                          pop rsi
 13868 0001AC82 C3                          ret
 13869                                  
 13870                                  ; var_get: rsi=name -> rax=value, cl=1 if found else cl=0 and rax=0
 13871                                  var_get:
