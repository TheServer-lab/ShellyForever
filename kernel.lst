 10283 00008C14 81C100300000                add ecx, 0x3000              ; PD0 starts at 0x3000 (see expand_identity_map)
 10284 00008C1A 48830910                    or qword [rcx], 0x10         ; set PCD
 10285 00008C1E 0F20D8                      mov rax, cr3
 10286 00008C21 0F22D8                      mov cr3, rax                 ; flush stale TLB entries
 10287 00008C24 59                          pop rcx
 10288 00008C25 58                          pop rax
 10289 00008C26 C3                          ret
