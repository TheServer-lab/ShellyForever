 14257 0001AFFA 490FB69E[50080700]          movzx rbx, byte [calc_ops2 + r14]
 14258 0001B002 4C89F2                      mov rdx, r14
 14259 0001B005 48FFC2                      inc rdx
 14260 0001B008 488B0CD5[30070700]          mov rcx, [calc_vals2 + rdx*8]
 14261 0001B010 80FB2B                      cmp bl, '+'
 14262 0001B013 7405                        je .ee_doadd
