 14998                                  ; --- process table for rush scripts ---
 14999                                  MAX_PROCESSES equ 4
 15000 0003A4A8 0000<rep 4h>            proc_id:       times MAX_PROCESSES dw 0
 15001 0003A4B0 00<rep 80h>             proc_name:     times MAX_PROCESSES*32 db 0
 15002 0003A530 00<rep 4h>              proc_state:    times MAX_PROCESSES db 0    ; 0=free, 1=running, 2=killed
 15003 0003A534 0100                    proc_next_pid: dw 1
 15004 0003A536 00                      proc_cur_slot: db 0                         ; slot index of currently running script
 15005 0003A537 00                      kill_flag:     db 0                         ; set by Esc key or prs kill
 15006 0003A538 0000000000000000        rr_content_ptr: dq 0                         ; cursor into script file content
 15007                                  
 15008                                  ; --- large staging buffers. A file can span a whole 64-node volume slice, so
 15009                                  ; these are sized to hold a full file's content (EDIT_MAX). Declared at the
 15010                                  ; very end of the file, after all code, so any growth doesn't move anything. ---
 15011 0003A540 00<rep 200h>            fs_next_scratch: times 512 db 0     ; staging for one full node_next sector
 15012 0003A740 00<rep 2800h>           fs_io_buf:  times EDIT_MAX db 0     ; editor + view/read/copy staging for multi-block files
