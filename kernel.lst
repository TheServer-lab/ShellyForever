  1535 0001CA8A 5F                  <1>     pop rdi
  1536 0001CA8B C3                  <1>     ret
  1537                              <1> 
  1538                              <1> ; party_strcpy_save: rsi = src (NUL-terminated), rdi = dst; copies
  1539                              <1> ; the string capped at PARTY_IDENT_MAX-1 bytes. Clobbers rax, rcx,
  1540                              <1> ; rsi, rdi.
  1541                              <1> party_strcpy_save:
