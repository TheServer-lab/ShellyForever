   183                                  
   184                                      .shell_loop:
   185                                          ; drain any inbound NIC frames (ARP/ICMP/UDP) that arrived while we
   186                                          ; were idle, so ARP replies / echo replies / DNS answers don't sit in
   187                                          ; the ring until the next command. Cheap no-op without a NIC.
   188 000000CE E8607E0000                      call netpoll
   189 000000D3 E8E53F0100                      call print_prompt
   190                                      
   191 000000D8 48BF-                           mov rdi, line_buf
   191 000000DA [E08C030000000000] 
   192 000000E2 B9DB000000                      mov rcx, LINE_MAX-1
   193 000000E7 E8E0460100                      call read_line
   194                                      
   195                                          ; skip $ comments (lines starting with $)
   196 000000EC 803C25[E08C0300]24              cmp byte [line_buf], '$'
   197 000000F4 74D8                            je .shell_loop
   198                                  
   199                                          ; "ali <name> <commands>" defines an alias. This has to be
   200                                          ; intercepted here, before ; chaining/tokenizing get anywhere
   201                                          ; near the line, so that a body like "calc 5 + 5 ~ = a ; show a"
   202                                          ; is stored verbatim instead of being split on ; or ~ right now.
   203 000000F6 E8E1500000                      call try_handle_ali_line
   204 000000FB 3C01                            cmp al, 1
   205 000000FD 74CF                            je .shell_loop
   206                                      
   207                                          ; process ;-chained commands (tokenize + dispatch each segment)
   208 000000FF E802000000                      call process_chain
   209 00000104 EBC8                            jmp .shell_loop
   210                                  
   211                                  ; ------------------------------------------------------------
   212                                  ; process_chain: splits line_buf on ; (respecting double quotes),
   213                                  ; copies each segment to line_buf, then tokenizes and dispatches.
   214                                  ; This lets users write: show hello ; show world
   215                                  process_chain:
   216 00000106 53                          push rbx
   217 00000107 4154                        push r12
   218 00000109 4155                        push r13
   219 0000010B 4156                        push r14
   220 0000010D 4157                        push r15
   221                                  
   222 0000010F C60425[F88F0300]00          mov byte [chain_is_rr], 0
   223                                  
   224                                      ; Copy line_buf to chain_scan_buf so we can scan without destroying it
   225 00000117 48BE-                       mov rsi, line_buf
   225 00000119 [E08C030000000000] 
   226 00000121 48BF-                       mov rdi, chain_scan_buf
   226 00000123 [BC8D030000000000] 
   227 0000012B E86E400100                  call str_copy
   228                                  
   229 00000130 49BC-                       mov r12, chain_scan_buf   ; r12 = start of current segment
   229 00000132 [BC8D030000000000] 
   230 0000013A 49BD-                       mov r13, chain_scan_buf   ; r13 = scan pointer
   230 0000013C [BC8D030000000000] 
   231 00000144 41B600                      mov r14b, 0               ; r14b = quote state (0=outside, 1=inside)
   232                                  
   233                                  .chain_scan:
   234 00000147 418A4500                    mov al, [r13]
   235 0000014B 84C0                        test al, al
   236 0000014D 744B                        jz .chain_done            ; end of string, process last segment
   237                                  
   238 0000014F 3C22                        cmp al, '"'
   239 00000151 7409                        je .toggle_quotes
   240                                  
   241 00000153 3C3B                        cmp al, ';'
   242 00000155 740E                        je .chain_break
   243                                  
   244 00000157 49FFC5                      inc r13
   245 0000015A EBEB                        jmp .chain_scan
   246                                  
   247                                  .toggle_quotes:
   248 0000015C 4180F601                    xor r14b, 1               ; toggle quote state
   249 00000160 49FFC5                      inc r13
   250 00000163 EBE2                        jmp .chain_scan
   251                                  
   252                                  .chain_break:
   253                                      ; Found ; at r13 (outside quotes)
   254                                      ; Copy segment [r12 .. r13) into line_buf
   255 00000165 4155                        push r13                  ; save scan pointer
   256 00000167 4C89E6                      mov rsi, r12
   257 0000016A 48BF-                       mov rdi, line_buf
   257 0000016C [E08C030000000000] 
   258                                  .chain_copy:
   259 00000174 8A06                        mov al, [rsi]
   260 00000176 3C3B                        cmp al, ';'
   261 00000178 740E                        je .chain_copy_done
   262 0000017A 84C0                        test al, al
   263 0000017C 740A                        je .chain_copy_done
   264 0000017E 8807                        mov [rdi], al
   265 00000180 48FFC7                      inc rdi
   266 00000183 48FFC6                      inc rsi
   267 00000186 EBEC                        jmp .chain_copy
   268                                  .chain_copy_done:
   269 00000188 C60700                      mov byte [rdi], 0         ; null-terminate line_buf
   270                                  
   271                                      ; Tokenize (and, if a "~" pipe is present, split/capture/rejoin) and
   272                                      ; dispatch the segment - see process_segment below.
   273 0000018B E8F9000000                  call process_segment
   274                                  
   275                                  .chain_skip:
   276 00000190 415D                        pop r13                   ; restore scan pointer (points to ;)
   277 00000192 49FFC5                      inc r13                   ; advance past ;
   278 00000195 4D89EC                      mov r12, r13              ; r12 = start of next segment
   279 00000198 EBAD                        jmp .chain_scan
   280                                  
   281                                  .chain_done:
   282                                      ; Process last segment (from r12 to end of chain_scan_buf)
   283 0000019A 4C89E6                      mov rsi, r12
   284 0000019D 48BF-                       mov rdi, line_buf
   284 0000019F [E08C030000000000] 
   285 000001A7 E8F23F0100                  call str_copy             ; copy last segment to line_buf
   286                                  
   287 000001AC E8D8000000                  call process_segment
   288                                  
   289                                  .chain_end:
   290 000001B1 415F                        pop r15
   291 000001B3 415E                        pop r14
   292 000001B5 415D                        pop r13
   293 000001B7 415C                        pop r12
   294 000001B9 5B                          pop rbx
   295 000001BA C3                          ret
