 10493 0001889C 881425[AFE80500]            mov [nic_pci_func], dl
 10494 000188A3 415B                        pop r11
 10495 000188A5 415A                        pop r10
 10496 000188A7 4159                        pop r9
 10497 000188A9 4158                        pop r8
