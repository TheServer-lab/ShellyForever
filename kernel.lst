 16360 00070D71 4889D0                      mov rax, rdx
 16361 00070D74 4801C8                      add rax, rcx
 16362 00070D77 4839F8                      cmp rax, rdi
 16363 00070D7A 7203                        jb .bg_cap_nowrap
 16364 00070D7C 4829F8                      sub rax, rdi
 16365                                  .bg_cap_nowrap:
 16366 00070D7F 488B3425[36890C00]          mov rsi, [bg_capture_base]
 16367 00070D87 4801C6                      add rsi, rax
 16368 00070D8A 881E                        mov [rsi], bl
 16369 00070D8C 48FFC1                      inc rcx
 16370 00070D8F 488B3425[46890C00]          mov rsi, [bg_capture_len_ptr]
 16371 00070D97 890E                        mov [rsi], ecx
 16372                                  .bg_cap_exit2:
 16373 00070D99 5A                          pop rdx
 16374 00070D9A 59                          pop rcx
 16375 00070D9B 5E                          pop rsi
 16376                                  .bg_cap_exit:
