  8953 00017AB8 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8954 00017AC0 B900010000                  mov rcx, 256
  8955                                  .writeloop:
  8956 00017AC5 668B06                      mov ax, [rsi]
  8957 00017AC8 66EF                        out dx, ax
  8958 00017ACA 4883C602                    add rsi, 2
  8959 00017ACE E2F5                        loop .writeloop
  8960 00017AD0 E81AFEFFFF                  call ata_wait_bsy
  8961 00017AD5 7219                        jc .fail
  8962 00017AD7 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8963 00017ADF 6683C207                    add dx, 7
  8964 00017AE3 B0E7                        mov al, 0xE7                 ; CACHE FLUSH so it actually hits the image
  8965 00017AE5 EE                          out dx, al
  8966 00017AE6 E804FEFFFF                  call ata_wait_bsy
  8967 00017AEB 7203                        jc .fail
  8968 00017AED F8                          clc
  8969 00017AEE EB01                        jmp .done
  8970                                  .fail:
  8971 00017AF0 F9                          stc
  8972                                  .done:
  8973 00017AF1 5E                          pop rsi
  8974 00017AF2 5A                          pop rdx
  8975 00017AF3 59                          pop rcx
  8976 00017AF4 5B                          pop rbx
  8977 00017AF5 58                          pop rax
  8978 00017AF6 C3                          ret
  8979                                  
  8980                                  ; ------------------------------------------------------------------
  8981                                  ;  disk_*: dispatcher in front of the two disk drivers below (legacy ATA
  8982                                  ;  PIO above, AHCI further down). Every caller in this file - vol_read,
  8983                                  ;  vol_write, dscan, fmt, mount - goes through these three routines with
  8984                                  ;  al = device id, exactly like it always called ata_select_device /
  8985                                  ;  ata_read_sector / ata_write_sector directly before. Ids 0-3 still mean
  8986                                  ;  what they always meant (primary/secondary x master/slave); ids 4 and up
  8987                                  ;  mean an AHCI port slot claimed by ahci_init at boot.
  8988                                  ; ------------------------------------------------------------------
  8989                                  
  8990                                  ; disk_select_device: al = device id (0..TOTAL_DEVICES-1).
  8991                                  disk_select_device:
  8992 00017AF7 50                          push rax
  8993 00017AF8 3C04                        cmp al, 4
  8994 00017AFA 7213                        jb .use_ata
  8995 00017AFC C60425[A8E80500]01          mov byte [disk_use_ahci], 1
  8996 00017B04 2C04                        sub al, 4
  8997 00017B06 880425[A9E80500]            mov byte [ahci_cur_slot], al
  8998 00017B0D EB0D                        jmp .done
  8999                                  .use_ata:
  9000 00017B0F C60425[A8E80500]00          mov byte [disk_use_ahci], 0
  9001 00017B17 E81DFEFFFF                  call ata_select_device
  9002                                  .done:
  9003 00017B1C 58                          pop rax
  9004 00017B1D C3                          ret
  9005                                  
  9006                                  ; disk_read_sector: rax=LBA, rdi=dest buffer. Same in/out contract as
  9007                                  ; ata_read_sector - tail-jumps into whichever driver disk_select_device
  9008                                  ; picked, so its own CF/register contract passes straight through.
  9009                                  disk_read_sector:
  9010 00017B1E 803C25[A8E80500]00          cmp byte [disk_use_ahci], 0
  9011 00017B26 0F8444FEFFFF                je ata_read_sector
  9012 00017B2C E957030000                  jmp ahci_read_sector
  9013                                  
  9014                                  ; disk_write_sector: rax=LBA, rsi=source buffer. Same contract as above.
  9015                                  disk_write_sector:
  9016 00017B31 803C25[A8E80500]00          cmp byte [disk_use_ahci], 0
  9017 00017B39 0F84E6FEFFFF                je ata_write_sector
  9018 00017B3F E956030000                  jmp ahci_write_sector
  9019                                  
  9020                                  ; ------------------------------------------------------------------
  9021                                  ;  PCI configuration space access (legacy 0xCF8/0xCFC I/O ports). Used
  9022                                  ;  only to find and configure the AHCI controller below.
  9023                                  ; ------------------------------------------------------------------
  9024                                  PCI_CFG_ADDR equ 0x0CF8
  9025                                  PCI_CFG_DATA equ 0x0CFC
  9026                                  
  9027                                  ; pci_read32: ebx=bus, ecx=device(0-31), edx=function(0-7), r8b=offset
  9028                                  ; (byte, dword-aligned - low 2 bits ignored). Returns eax = the 32-bit
  9029                                  ; config space value at that offset. Preserves ebx/ecx/edx; clobbers r9.
  9030                                  pci_read32:
  9031 00017B44 53                          push rbx
  9032 00017B45 51                          push rcx
  9033 00017B46 52                          push rdx
  9034 00017B47 4151                        push r9
  9035 00017B49 4531C9                      xor r9d, r9d
  9036 00017B4C 4188D9                      mov r9b, bl
  9037 00017B4F 41C1E110                    shl r9d, 16                  ; bus -> bits 23:16
  9038 00017B53 89C8                        mov eax, ecx
  9039 00017B55 83E01F                      and eax, 0x1F
  9040 00017B58 C1E00B                      shl eax, 11                  ; device -> bits 15:11
  9041 00017B5B 4109C1                      or r9d, eax
  9042 00017B5E 89D0                        mov eax, edx
  9043 00017B60 83E007                      and eax, 0x07
  9044 00017B63 C1E008                      shl eax, 8                   ; function -> bits 10:8
  9045 00017B66 4109C1                      or r9d, eax
  9046 00017B69 4489C0                      mov eax, r8d
  9047 00017B6C 25FC000000                  and eax, 0xFC                ; register -> bits 7:2
  9048 00017B71 4109C1                      or r9d, eax
  9049 00017B74 4181C900000080              or r9d, 0x80000000           ; enable bit
  9050 00017B7B 4489C8                      mov eax, r9d
  9051 00017B7E 66BAF80C                    mov dx, PCI_CFG_ADDR
  9052 00017B82 EF                          out dx, eax
  9053 00017B83 66BAFC0C                    mov dx, PCI_CFG_DATA
  9054 00017B87 ED                          in eax, dx
  9055 00017B88 4159                        pop r9
  9056 00017B8A 5A                          pop rdx
  9057 00017B8B 59                          pop rcx
  9058 00017B8C 5B                          pop rbx
  9059 00017B8D C3                          ret
  9060                                  
  9061                                  ; pci_write32: ebx=bus, ecx=device, edx=function, r8b=offset, r10d=value.
  9062                                  ; Preserves ebx/ecx/edx; clobbers r9.
  9063                                  pci_write32:
  9064 00017B8E 50                          push rax
  9065 00017B8F 53                          push rbx
  9066 00017B90 51                          push rcx
  9067 00017B91 52                          push rdx
  9068 00017B92 4151                        push r9
  9069 00017B94 4531C9                      xor r9d, r9d
  9070 00017B97 4188D9                      mov r9b, bl
  9071 00017B9A 41C1E110                    shl r9d, 16
  9072 00017B9E 89C8                        mov eax, ecx
  9073 00017BA0 83E01F                      and eax, 0x1F
  9074 00017BA3 C1E00B                      shl eax, 11
  9075 00017BA6 4109C1                      or r9d, eax
  9076 00017BA9 89D0                        mov eax, edx
  9077 00017BAB 83E007                      and eax, 0x07
  9078 00017BAE C1E008                      shl eax, 8
  9079 00017BB1 4109C1                      or r9d, eax
  9080 00017BB4 4489C0                      mov eax, r8d
  9081 00017BB7 25FC000000                  and eax, 0xFC
  9082 00017BBC 4109C1                      or r9d, eax
  9083 00017BBF 4181C900000080              or r9d, 0x80000000
  9084 00017BC6 4489C8                      mov eax, r9d
  9085 00017BC9 66BAF80C                    mov dx, PCI_CFG_ADDR
  9086 00017BCD EF                          out dx, eax
  9087 00017BCE 4489D0                      mov eax, r10d
  9088 00017BD1 66BAFC0C                    mov dx, PCI_CFG_DATA
  9089 00017BD5 EF                          out dx, eax
  9090 00017BD6 4159                        pop r9
  9091 00017BD8 5A                          pop rdx
  9092 00017BD9 59                          pop rcx
  9093 00017BDA 5B                          pop rbx
  9094 00017BDB 58                          pop rax
  9095 00017BDC C3                          ret
  9096                                  
  9097                                  ; pci_find_ahci: brute-force scan of PCI bus 0 only (per-device, and every
  9098                                  ; function of a multi-function device). This covers the common case - the
  9099                                  ; chipset's root complex, where AHCI controllers normally live, and is
  9100                                  ; where QEMU/Bochs/VirtualBox and most real desktop chipsets put theirs -
  9101                                  ; but doesn't walk PCI-to-PCI bridges out to other buses, which unusual
  9102                                  ; multi-bus hardware could need. Looks for class 0x01 (mass storage),
  9103                                  ; subclass 0x06 (SATA), regardless of programming interface.
  9104                                  ; On success: CF=0, [ahci_pci_bus/dev/func] set. On failure: CF=1.
  9105                                  pci_find_ahci:
  9106 00017BDD 50                          push rax
  9107 00017BDE 53                          push rbx
  9108 00017BDF 51                          push rcx
  9109 00017BE0 52                          push rdx
  9110 00017BE1 4150                        push r8
  9111 00017BE3 4151                        push r9
  9112 00017BE5 4152                        push r10
  9113 00017BE7 31DB                        xor ebx, ebx                 ; bus 0 only
  9114 00017BE9 31C9                        xor ecx, ecx                 ; device 0..31
  9115                                  .dev_loop:
  9116 00017BEB 83F920                      cmp ecx, 32
  9117 00017BEE 0F839F000000                jae .not_found
  9118 00017BF4 31D2                        xor edx, edx                 ; try function 0 first
  9119 00017BF6 4D31C0                      xor r8, r8
  9120 00017BF9 E846FFFFFF                  call pci_read32
  9121 00017BFE 83F8FF                      cmp eax, 0xFFFFFFFF
  9122 00017C01 0F8485000000                je .next_dev                 ; nothing in this slot
  9123 00017C07 41B00C                      mov r8b, 0x0C                ; header type lives at offset 0x0C, byte 2
  9124 00017C0A E835FFFFFF                  call pci_read32
  9125 00017C0F C1E810                      shr eax, 16
  9126 00017C12 25FF000000                  and eax, 0xFF
  9127 00017C17 880425[63E80500]            mov [pci_scratch_hdrtype], al
  9128 00017C1E 41B901000000                mov r9d, 1                   ; how many functions to check
  9129 00017C24 F60425[63E80500]80          test byte [pci_scratch_hdrtype], 0x80
  9130 00017C2C 7406                        jz .func_loop_start
  9131 00017C2E 41B908000000                mov r9d, 8                   ; multi-function device - check them all
  9132                                  .func_loop_start:
  9133 00017C34 31D2                        xor edx, edx
  9134                                  .func_loop:
  9135 00017C36 4439CA                      cmp edx, r9d
  9136 00017C39 7351                        jae .next_dev
  9137 00017C3B 4D31C0                      xor r8, r8
  9138 00017C3E E801FFFFFF                  call pci_read32
  9139 00017C43 83F8FF                      cmp eax, 0xFFFFFFFF
  9140 00017C46 7440                        je .func_next
  9141 00017C48 41B008                      mov r8b, 0x08                ; class code dword
  9142 00017C4B E8F4FEFFFF                  call pci_read32
  9143 00017C50 4189C2                      mov r10d, eax
  9144 00017C53 41C1EA18                    shr r10d, 24                 ; class
  9145 00017C57 4180FA01                    cmp r10b, 0x01
  9146 00017C5B 752B                        jne .func_next
  9147 00017C5D 4189C2                      mov r10d, eax
  9148 00017C60 41C1EA10                    shr r10d, 16
  9149 00017C64 4181E2FF000000              and r10d, 0xFF                ; subclass
  9150 00017C6B 4180FA06                    cmp r10b, 0x06
  9151 00017C6F 7517                        jne .func_next
  9152 00017C71 881C25[64E80500]            mov [ahci_pci_bus], bl
  9153 00017C78 880C25[65E80500]            mov [ahci_pci_dev], cl
  9154 00017C7F 881425[66E80500]            mov [ahci_pci_func], dl
  9155 00017C86 EB17                        jmp .found
  9156                                  .func_next:
  9157 00017C88 FFC2                        inc edx
  9158 00017C8A EBAA                        jmp .func_loop
  9159                                  .next_dev:
  9160 00017C8C FFC1                        inc ecx
  9161 00017C8E E958FFFFFF                  jmp .dev_loop
  9162                                  .not_found:
  9163 00017C93 415A                        pop r10
  9164 00017C95 4159                        pop r9
  9165 00017C97 4158                        pop r8
  9166 00017C99 5A                          pop rdx
  9167 00017C9A 59                          pop rcx
  9168 00017C9B 5B                          pop rbx
  9169 00017C9C 58                          pop rax
  9170 00017C9D F9                          stc
  9171 00017C9E C3                          ret
  9172                                  .found:
  9173 00017C9F 415A                        pop r10
  9174 00017CA1 4159                        pop r9
  9175 00017CA3 4158                        pop r8
  9176 00017CA5 5A                          pop rdx
  9177 00017CA6 59                          pop rcx
  9178 00017CA7 5B                          pop rbx
  9179 00017CA8 58                          pop rax
  9180 00017CA9 F8                          clc
  9181 00017CAA C3                          ret
  9182                                  
  9183                                  ; ------------------------------------------------------------------
  9184                                  ;  AHCI (SATA) driver. Talks to the HBA over MMIO (its ABAR, found via
  9185                                  ;  PCI BAR5) instead of legacy IDE ports - a different I/O model from the
  9186                                  ;  ata_* driver above, but the disk is identity-mapped memory either way
  9187                                  ;  once ahci_mark_uncached has run, so it's read/written with plain
  9188                                  ;  mov/or/and just like any other buffer in this file. No interrupts are
  9189                                  ;  used here either, matching the polled style of the rest of the OS:
  9190                                  ;  commands are issued and then polled for completion on PxCI.
  9191                                  ; ------------------------------------------------------------------
  9192                                  PCI_CMD_OFFSET  equ 0x04
  9193                                  PCI_BAR5_OFFSET equ 0x24
  9194                                  AHCI_TIMEOUT    equ 0x400000
  9195                                  
  9196                                  ; ahci_mark_uncached: edi = a physical address inside the 2MB page to mark
  9197                                  ; uncached (sets PCD, bit4) in the identity-map PDs built by
  9198                                  ; expand_identity_map (4 contiguous page directories at 0x3000..0x6FFF,
  9199                                  ; 512 entries each, 2MB pages). Without this, polling an HBA register
  9200                                  ; through a cacheable mapping could read back a stale value instead of
  9201                                  ; what the device just wrote - the ABAR sits in a dedicated MMIO range
  9202                                  ; that nothing else in this kernel uses, so marking its whole 2MB page
  9203                                  ; uncached doesn't affect anything else.
  9204                                  ahci_mark_uncached:
  9205 00017CAB 50                          push rax
  9206 00017CAC 51                          push rcx
  9207 00017CAD 89F8                        mov eax, edi
  9208 00017CAF C1E815                      shr eax, 21                  ; which 2MB page, 0..2047, across all 4 PDs
  9209 00017CB2 89C1                        mov ecx, eax
  9210 00017CB4 C1E103                      shl ecx, 3                   ; * 8 (each PD entry is a qword)
  9211 00017CB7 81C100300000                add ecx, 0x3000              ; PD0 starts at 0x3000 (see expand_identity_map)
  9212 00017CBD 48830910                    or qword [rcx], 0x10         ; set PCD
  9213 00017CC1 0F20D8                      mov rax, cr3
  9214 00017CC4 0F22D8                      mov cr3, rax                 ; flush stale TLB entries
  9215 00017CC7 59                          pop rcx
  9216 00017CC8 58                          pop rax
  9217 00017CC9 C3                          ret
  9218                                  
  9219                                  ; ahci_port_init: rbx = this port's register base (ABAR + 0x100 +
  9220                                  ; port*0x80), r14d = slot index (0..AHCI_MAX_PORTS-1, picks which static
  9221                                  ; command-list/FIS buffer this port uses). Stops the port if it was
  9222                                  ; already running, points it at our buffers, then starts it.
  9223                                  ahci_port_init:
  9224 00017CCA 50                          push rax
  9225 00017CCB 51                          push rcx
  9226 00017CCC 57                          push rdi
  9227                                  
  9228 00017CCD 8B4318                      mov eax, [rbx + 0x18]        ; PxCMD
  9229 00017CD0 83E0FE                      and eax, 0xFFFFFFFE          ; clear ST
  9230 00017CD3 894318                      mov [rbx + 0x18], eax
  9231 00017CD6 83E0EF                      and eax, 0xFFFFFFEF          ; clear FRE
  9232 00017CD9 894318                      mov [rbx + 0x18], eax
  9233                                  
  9234                                      ; wait for FR/CR to clear, but don't spin forever - some real
  9235                                      ; controllers (unlike QEMU's virtual AHCI) can take a while here, or in
  9236                                      ; rare cases never quiesce from this code's point of view. Bail out
  9237                                      ; and skip this port rather than hanging the whole boot if it doesn't
  9238                                      ; clear within AHCI_TIMEOUT iterations.
  9239 00017CDC B900004000                  mov rcx, AHCI_TIMEOUT
  9240                                  .wait_stop:
  9241 00017CE1 8B4318                      mov eax, [rbx + 0x18]
  9242 00017CE4 A900800000                  test eax, 0x8000             ; FR - FIS receive still running?
  9243 00017CE9 750A                        jnz .wait_stop_dec
  9244 00017CEB 8B4318                      mov eax, [rbx + 0x18]
  9245 00017CEE A900400000                  test eax, 0x4000             ; CR - command list still running?
  9246 00017CF3 7404                        jz .stopped
  9247                                  .wait_stop_dec:
  9248 00017CF5 E2EA                        loop .wait_stop
  9249 00017CF7 EB4C                        jmp .skip_port               ; timed out - leave this port unclaimed
  9250                                  .stopped:
  9251                                  
  9252 00017CF9 4489F0                      mov eax, r14d
  9253 00017CFC 69C000040000                imul eax, 1024
  9254 00017D02 488DB8[00CC0600]            lea rdi, [ahci_clb + rax]    ; this slot's 1KB-aligned command list
  9255 00017D09 893B                        mov [rbx + 0x00], edi        ; PxCLB
  9256 00017D0B C7430400000000              mov dword [rbx + 0x04], 0    ; PxCLBU (we're always <4GB here)
  9257                                  
  9258 00017D12 4489F0                      mov eax, r14d
  9259 00017D15 69C000010000                imul eax, 256
  9260 00017D1B 488DB8[00DC0600]            lea rdi, [ahci_fis + rax]    ; this slot's 256B-aligned FIS receive area
  9261 00017D22 897B08                      mov [rbx + 0x08], edi        ; PxFB
  9262 00017D25 C7430C00000000              mov dword [rbx + 0x0C], 0    ; PxFBU
  9263                                  
  9264 00017D2C C74330FFFFFFFF              mov dword [rbx + 0x30], 0xFFFFFFFF   ; PxSERR - clear (write-1-to-clear)
  9265                                  
  9266 00017D33 8B4318                      mov eax, [rbx + 0x18]
  9267 00017D36 83C810                      or eax, 0x10                 ; FRE
  9268 00017D39 894318                      mov [rbx + 0x18], eax
  9269 00017D3C 8B4318                      mov eax, [rbx + 0x18]
  9270 00017D3F 83C801                      or eax, 0x01                 ; ST
  9271 00017D42 894318                      mov [rbx + 0x18], eax
  9272                                  
  9273                                  .skip_port:
  9274 00017D45 5F                          pop rdi
  9275 00017D46 59                          pop rcx
  9276 00017D47 58                          pop rax
  9277 00017D48 C3                          ret
  9278                                  
  9279                                  ; ahci_init: called once at boot. Finds a PCI AHCI controller if one's
  9280                                  ; present, enables it, and brings up to AHCI_MAX_PORTS of its ports (that
  9281                                  ; have an actual SATA disk attached) as extra disk device slots, ids
  9282                                  ; 4..4+AHCI_MAX_PORTS-1. Completely inert if there's no AHCI controller:
  9283                                  ; [ahci_port_count] stays 0 and the OS behaves exactly as it always did.
  9284                                  ahci_init:
  9285 00017D49 50                          push rax
  9286 00017D4A 53                          push rbx
  9287 00017D4B 51                          push rcx
  9288 00017D4C 52                          push rdx
  9289 00017D4D 57                          push rdi
  9290 00017D4E 4150                        push r8
  9291 00017D50 4152                        push r10
  9292 00017D52 4154                        push r12
  9293 00017D54 4155                        push r13
  9294 00017D56 4156                        push r14
  9295                                  
  9296 00017D58 E880FEFFFF                  call pci_find_ahci
  9297 00017D5D 0F8215010000                jc .done
  9298                                  
  9299                                      ; Memory Space (bit1) + Bus Master (bit2) in the PCI command register -
  9300                                      ; usually already on if firmware set the machine up, but make sure.
  9301 00017D63 0FB61C25[64E80500]          movzx ebx, byte [ahci_pci_bus]
  9302 00017D6B 0FB60C25[65E80500]          movzx ecx, byte [ahci_pci_dev]
  9303 00017D73 0FB61425[66E80500]          movzx edx, byte [ahci_pci_func]
  9304 00017D7B 41B004                      mov r8b, PCI_CMD_OFFSET
  9305 00017D7E E8C1FDFFFF                  call pci_read32
  9306 00017D83 83C806                      or eax, 0x0006
  9307 00017D86 4189C2                      mov r10d, eax
  9308 00017D89 0FB61C25[64E80500]          movzx ebx, byte [ahci_pci_bus]
  9309 00017D91 0FB60C25[65E80500]          movzx ecx, byte [ahci_pci_dev]
  9310 00017D99 0FB61425[66E80500]          movzx edx, byte [ahci_pci_func]
  9311 00017DA1 41B004                      mov r8b, PCI_CMD_OFFSET
  9312 00017DA4 E8E5FDFFFF                  call pci_write32
  9313                                  
  9314                                      ; BAR5 = ABAR, the AHCI MMIO register window
  9315 00017DA9 0FB61C25[64E80500]          movzx ebx, byte [ahci_pci_bus]
  9316 00017DB1 0FB60C25[65E80500]          movzx ecx, byte [ahci_pci_dev]
  9317 00017DB9 0FB61425[66E80500]          movzx edx, byte [ahci_pci_func]
  9318 00017DC1 41B024                      mov r8b, PCI_BAR5_OFFSET
  9319 00017DC4 E87BFDFFFF                  call pci_read32
  9320 00017DC9 83E0F0                      and eax, 0xFFFFFFF0           ; drop the low flag bits, keep the base
  9321 00017DCC 890425[68E80500]            mov [ahci_abar], eax
  9322 00017DD3 89C7                        mov edi, eax
  9323 00017DD5 E8D1FEFFFF                  call ahci_mark_uncached
  9324                                  
  9325 00017DDA 8B1C25[68E80500]            mov ebx, [ahci_abar]          ; 32-bit load zero-extends into rbx - ahci_abar
  9326                                                                     ; is only a dd, so a 64-bit load here would pull
  9327                                                                     ; in the following ahci_ports_impl dword too
  9328 00017DE1 8B4304                      mov eax, [rbx + 0x04]         ; GHC
  9329 00017DE4 0D00000080                  or eax, 0x80000000            ; AE - AHCI Enable
  9330 00017DE9 894304                      mov [rbx + 0x04], eax
  9331                                  
  9332 00017DEC 8B430C                      mov eax, [rbx + 0x0C]         ; PI - ports implemented bitmap
  9333 00017DEF 890425[6CE80500]            mov [ahci_ports_impl], eax
