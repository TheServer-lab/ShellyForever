 17308                                  ; ============================================================
 17309                                  ;  complete_line: Tab completion for the rush prompt. Called from
 17310                                  ;  read_line when the user presses Tab.
 17311                                  ;  - first token on the line: completes against the built-in command
 17312                                  ;    table (completion_cmds)
 17313                                  ;  - any later token: completes against the names of files/folders
 17314                                  ;    directly inside cur_dir
 17315                                  ;  A single unique match is completed in place (commands get a trailing
 17316                                  ;  space, folders a trailing '/'); an ambiguous prefix is extended as
 17317                                  ;  far as all candidates agree, and if the prefix is already as long as
 17318                                  ;  the shared portion, the candidates are listed and the prompt and
 17319                                  ;  line are reprinted.
 17320                                  ;  Preserves r9/r10; r8 (current line length) may grow as characters
 17321                                  ;  are completed, which is exactly what read_line expects.
 17322                                  ; ============================================================
 17323                                  complete_line:
 17324 000716FE 50                          push rax
 17325 000716FF 53                          push rbx
 17326 00071700 51                          push rcx
 17327 00071701 52                          push rdx
 17328 00071702 56                          push rsi
 17329 00071703 57                          push rdi
 17330 00071704 4153                        push r11
 17331 00071706 4154                        push r12
 17332 00071708 4155                        push r13
 17333 0007170A 4156                        push r14
 17334 0007170C 4157                        push r15
 17335                                  
 17336                                      ; ---- locate the token being typed: token_start in r13 ----
 17337 0007170E 4D89C4                      mov r12, r8                  ; scan backward from the cursor
 17338 00071711 4D31ED                      xor r13, r13                 ; token_start
 17339                                  .tk_loop:
 17340 00071714 4983FC00                    cmp r12, 0
 17341 00071718 740F                        je .tk_done
 17342 0007171A 49FFCC                      dec r12
 17343 0007171D 43803C2120                  cmp byte [r9 + r12], ' '
 17344 00071722 75F0                        jne .tk_loop
 17345 00071724 4D8D6C2401                  lea r13, [r12 + 1]
 17346                                  .tk_done:
 17347 00071729 4C89C3                      mov rbx, r8                  ; rbx = token length = r8 - r13
 17348 0007172C 4C29EB                      sub rbx, r13
 17349                                  
 17350                                      ; ---- mode: r11 = 1 if this is not the first token ----
 17351 0007172F 4D31DB                      xor r11, r11
 17352 00071732 4831C9                      xor rcx, rcx
 17353                                  .mode_loop:
 17354 00071735 4C39E9                      cmp rcx, r13
