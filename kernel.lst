  2248                              <1> ; ============================================================
  2249                              <1> ;  Kernel RNG: RDRAND primary, TSC+RTC-jitter/SHA-256 fallback
  2250                              <1> ;  Ported from rng.asm (standalone scratch, verified against the
  2251                              <1> ;  criteria in phases.txt Phase 2: runs without faulting, produces
  2252                              <1> ;  non-constant output across calls, retry-on-CF-clear path
  2253                              <1> ;  exercised -- see rng_test.asm). Differences from the scratch
  2254                              <1> ;  version:
  2255                              <1> ;    - no `section` directive (kernel.asm has none; these globals
  2256                              <1> ;      just follow the code, same as everything else in this file).
  2257                              <1> ;    - every entry point now saves/restores every register it
  2258                              <1> ;      touches, per this file's "callee saves everything" convention
  2259                              <1> ;      (the scratch version already did this for rng_fallback64, but
  2260                              <1> ;      rng_get64/rng_get64_force_fallback only saved rcx).
  2261                              <1> ;    - rng_fallback64 now also mixes in an RTC seconds reading via
  2262                              <1> ;      rtc_sec_now (kernel.asm, ~line 11042) alongside the TSC, per
  2263                              <1> ;      phases.txt's original "RTC/TSC-jitter through SHA-256"
  2264                              <1> ;      description -- the standalone scratch version could only mix
  2265                              <1> ;      the TSC, since a Linux userspace harness has no access to
  2266                              <1> ;      port-I/O-based RTC reads. rng_mix_buf grew from 40 to 48 bytes
  2267                              <1> ;      to hold the extra 8-byte (zero-extended) RTC field.
  2268                              <1> ;    - rng_state/rng_mix_buf/rng_digest renamed with no change in
  2269                              <1> ;      layout other than the above, to avoid colliding with rng.asm
  2270                              <1> ;      if both are ever %include'd in the same test build.
  2271                              <1> ; ============================================================
  2272                              <1> 
  2273                              <1> RNG_MAX_RETRIES equ 10
  2274                              <1> 
  2275                              <1> ; rng_get64(rdi=out8): writes 8 random bytes to [rdi]. Always
  2276                              <1> ; "succeeds" from the caller's point of view (CF=0) -- if RDRAND is
  2277                              <1> ; exhausted after retry, falls back to rng_fallback64 rather than
  2278                              <1> ; propagating a hardware-level failure.
  2279                              <1> ;
  2280                              <1> ; IMPORTANT: RDRAND support is NOT universal -- unlike a CPUID-visible
  2281                              <1> ; feature that merely changes behavior, executing `rdrand` on a CPU
  2282                              <1> ; that doesn't implement it raises #UD (invalid opcode) the instant
  2283                              <1> ; the CPU tries to decode it. That happens before the instruction can
  2284                              <1> ; even set CF, so the `jc .have_random` / retry loop below cannot catch
  2285                              <1> ; it -- it only handles the CPU supporting RDRAND but the DRNG not
  2286                              <1> ; having a value ready yet, a different (retryable) situation. Several
  2287                              <1> ; common QEMU CPU models don't expose RDRAND, so without a feature
  2288                              <1> ; check this faults deterministically on the very first call, every
  2289                              <1> ; boot, regardless of any network/TLS data (this crashed the kernel
  2290                              <1> ; via cmd_stake/cmd_sgive's very first tls_handshake_after_connect
  2291                              <1> ; call -- see the client_random rng_get64 calls there).
  2292                              <1> ; rng_rdrand_checked/rng_rdrand_ok cache the CPUID.1:ECX.bit30 result
  2293                              <1> ; so we only ever probe once, not on every rng_get64 call.
  2294                              <1> rng_get64:
  2295 0003E090 50                  <1>     push rax
  2296 0003E091 53                  <1>     push rbx
  2297 0003E092 51                  <1>     push rcx
  2298 0003E093 52                  <1>     push rdx
  2299 0003E094 57                  <1>     push rdi
  2300                              <1> 
  2301 0003E095 803C25[EAE00300]00  <1>     cmp byte [rng_rdrand_checked], 0
  2302 0003E09D 751D                <1>     jne .checked
  2303 0003E09F B801000000          <1>     mov eax, 1
  2304 0003E0A4 0FA2                <1>     cpuid                      ; clobbers eax,ebx,ecx,edx -- all reloaded below
  2305 0003E0A6 F7C100000040        <1>     test ecx, (1 << 30)        ; RDRAND support bit
  2306 0003E0AC 0F950425[EBE00300]  <1>     setnz byte [rng_rdrand_ok]
