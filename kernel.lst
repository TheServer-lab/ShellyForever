 17489                                  .ls_loop:
 17490 000718BB 4D39FE                      cmp r14, r15
 17491 000718BE 7316                        jae .ls_done
 17492 000718C0 E883000000                  call .match_ptr              ; rsi = candidate string
 17493 000718C5 E895F3FFFF                  call print_string
 17494 000718CA B020                        mov al, ' '
 17495 000718CC E8F9F3FFFF                  call putchar
 17496 000718D1 49FFC6                      inc r14
 17497 000718D4 EBE5                        jmp .ls_loop
 17498                                  .ls_done:
 17499 000718D6 B00A                        mov al, 0x0A
 17500 000718D8 E8EDF3FFFF                  call putchar
 17501 000718DD E861F1FFFF                  call print_prompt
 17502 000718E2 4831C9                      xor rcx, rcx
 17503                                  .echo:
 17504 000718E5 4C39C1                      cmp rcx, r8
 17505 000718E8 7317                        jae .out
 17506 000718EA 418A0409                    mov al, [r9 + rcx]
 17507 000718EE 53                          push rbx
 17508 000718EF 8A1C25[241A0700]            mov bl, [cur_normal_attr]
 17509 000718F6 E8CFF3FFFF                  call putchar
 17510 000718FB 5B                          pop rbx
 17511 000718FC 48FFC1                      inc rcx
 17512 000718FF EBE4                        jmp .echo
 17513                                  .out:
 17514 00071901 415F                        pop r15
 17515 00071903 415E                        pop r14
 17516 00071905 415D                        pop r13
 17517 00071907 415C                        pop r12
 17518 00071909 415B                        pop r11
 17519 0007190B 5F                          pop rdi
 17520 0007190C 5E                          pop rsi
 17521 0007190D 5A                          pop rdx
 17522 0007190E 59                          pop rcx
 17523 0007190F 5B                          pop rbx
 17524 00071910 58                          pop rax
 17525 00071911 C3                          ret
 17526                                  
 17527                                  ; .is_prefix: is the typed token (r9+r13, length rbx) a prefix of the
 17528                                  ; null-terminated string in rsi? Returns al = 1/0. Clobbers only al.
 17529                                  .is_prefix:
 17530 00071912 53                          push rbx
 17531 00071913 51                          push rcx
 17532 00071914 52                          push rdx
 17533 00071915 56                          push rsi
 17534 00071916 57                          push rdi
 17535 00071917 4889F7                      mov rdi, rsi
 17536 0007191A 4C89CE                      mov rsi, r9
 17537 0007191D 4C01EE                      add rsi, r13
 17538 00071920 4889D9                      mov rcx, rbx
 17539                                  .ip_loop:
 17540 00071923 4883F900                    cmp rcx, 0
 17541 00071927 7413                        je .ip_yes
 17542 00071929 8A06                        mov al, [rsi]
 17543 0007192B 8A17                        mov dl, [rdi]
 17544 0007192D 38D0                        cmp al, dl
 17545 0007192F 750F                        jne .ip_no
 17546 00071931 48FFC6                      inc rsi
 17547 00071934 48FFC7                      inc rdi
 17548 00071937 48FFC9                      dec rcx
 17549 0007193A EBE7                        jmp .ip_loop
 17550                                  .ip_yes:
 17551 0007193C B001                        mov al, 1
 17552 0007193E EB02                        jmp .ip_out
 17553                                  .ip_no:
 17554 00071940 30C0                        xor al, al
 17555                                  .ip_out:
 17556 00071942 5F                          pop rdi
 17557 00071943 5E                          pop rsi
 17558 00071944 5A                          pop rdx
 17559 00071945 59                          pop rcx
 17560 00071946 5B                          pop rbx
 17561 00071947 C3                          ret
 17562                                  
 17563                                  ; .match_ptr: r14 = match slot -> rsi = candidate string. Clobbers rax.
 17564                                  .match_ptr:
 17565 00071948 4B0FB78436-                 movzx rax, word [comp_matches + r14*2]
 17565 0007194D [1E840700]         
 17566 00071951 4983FB00                    cmp r11, 0
 17567 00071955 750F                        jne .mp_fs
 17568 00071957 486BC008                    imul rax, 8
 17569 0007195B 488D80[AE820700]            lea rax, [completion_cmds + rax]
 17570 00071962 488B30                      mov rsi, [rax]
 17571 00071965 C3                          ret
 17572                                  .mp_fs:
 17573 00071966 486BC020                    imul rax, NAME_LEN
 17574 0007196A 488DB0[E0F10700]            lea rsi, [node_name + rax]
 17575 00071971 C3                          ret
 17576                                  
 17577                                  ; .char_at: r14 = match slot, rdx = position -> al = char at that position.
 17578                                  ; Clobbers rax only; returns the character zero-extended in rax so callers
 17579                                  ; can compare/test the full register (the char in al alone would leave
 17580                                  ; pointer bits in rax's upper bytes and break null checks).
 17581                                  .char_at:
 17582 00071972 4B0FB78436-                 movzx rax, word [comp_matches + r14*2]
 17582 00071977 [1E840700]         
 17583 0007197B 4983FB00                    cmp r11, 0
 17584 0007197F 7516                        jne .ca_fs
 17585 00071981 486BC008                    imul rax, 8
 17586 00071985 488D80[AE820700]            lea rax, [completion_cmds + rax]
 17587 0007198C 488B00                      mov rax, [rax]
 17588 0007198F 4801D0                      add rax, rdx
 17589 00071992 480FB600                    movzx rax, byte [rax]
 17590 00071996 C3                          ret
 17591                                  .ca_fs:
 17592 00071997 486BC020                    imul rax, NAME_LEN
 17593 0007199B 488D80[E0F10700]            lea rax, [node_name + rax]
 17594 000719A2 4801D0                      add rax, rdx
 17595 000719A5 480FB600                    movzx rax, byte [rax]
 17596 000719A9 C3                          ret
 17597                                  
 17598                                  ; erase one character visually (move cursor back, blank it)
 17599                                  do_backspace:
 17600 000719AA 50                          push rax
 17601 000719AB 803C25[191A0700]00          cmp byte [cursor_col], 0
 17602 000719B3 7409                        je .maybeup
 17603 000719B5 FE0C25[191A0700]            dec byte [cursor_col]
 17604 000719BC EB19                        jmp .blank
 17605                                  .maybeup:
 17606 000719BE 803C25[181A0700]00          cmp byte [cursor_row], 0
 17607 000719C6 744B                        je .out
 17608 000719C8 FE0C25[181A0700]            dec byte [cursor_row]
 17609 000719CF C60425[191A0700]4F          mov byte [cursor_col], VGA_COLS-1
 17610                                  .blank:
 17611 000719D7 53                          push rbx
 17612 000719D8 51                          push rcx
 17613 000719D9 52                          push rdx
 17614 000719DA 57                          push rdi
 17615 000719DB 480FB60C25-                 movzx rcx, byte [cursor_row]
 17615 000719E0 [181A0700]         
 17616 000719E4 486BC950                    imul rcx, VGA_COLS
 17617 000719E8 480FB61425-                 movzx rdx, byte [cursor_col]
 17617 000719ED [191A0700]         
 17618 000719F1 4801D1                      add rcx, rdx
 17619 000719F4 486BC902                    imul rcx, 2
 17620 000719F8 488D3C2500800B00            lea rdi, [VGA_BASE]
 17621 00071A00 4801CF                      add rdi, rcx
 17622 00071A03 C60720                      mov byte [rdi], ' '
 17623 00071A06 C6470107                    mov byte [rdi+1], 0x07
 17624 00071A0A 5F                          pop rdi
 17625 00071A0B 5A                          pop rdx
 17626 00071A0C 59                          pop rcx
 17627 00071A0D 5B                          pop rbx
 17628 00071A0E E8B4F1FFFF                  call update_cursor
 17629                                  .out:
 17630 00071A13 58                          pop rax
 17631 00071A14 C3                          ret
