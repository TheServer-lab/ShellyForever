 15961                                  ; print_path: walks parent chain of cur_dir, prints /home/.../name
 15962                                  print_path:
 15963 00070A69 50                          push rax
 15964 00070A6A 53                          push rbx
 15965 00070A6B 51                          push rcx
 15966 00070A6C 56                          push rsi
 15967 00070A6D 4831C9                      xor rcx, rcx                    ; depth counter
 15968 00070A70 488B0425[1B1A0700]          mov rax, [cur_dir]
 15969                                  .collect:
 15970 00070A78 66898409[00340A00]          mov [path_stack + rcx*2], ax
 15971 00070A80 48FFC1                      inc rcx
 15972 00070A83 480FB79C00-                 movzx rbx, word [node_parent + rax*2]
 15972 00070A88 [E0EB0700]         
 15973 00070A8C 6683FBFF                    cmp bx, 0xFFFF
 15974 00070A90 7405                        je .print
 15975 00070A92 4889D8                      mov rax, rbx
 15976 00070A95 EBE1                        jmp .collect
 15977                                  .print:
 15978 00070A97 B02F                        mov al, '/'
 15979 00070A99 B30E                        mov bl, ATTR_PROMPT
 15980 00070A9B E82A020000                  call putchar
 15981                                  .printloop:
 15982 00070AA0 48FFC9                      dec rcx
 15983 00070AA3 480FB78409-                 movzx rax, word [path_stack + rcx*2]
 15983 00070AA8 [00340A00]         
 15984 00070AAC 486BC020                    imul rax, NAME_LEN
 15985 00070AB0 488DB0[E0F10700]            lea rsi, [node_name + rax]
 15986 00070AB7 B00E                        mov al, ATTR_PROMPT
 15987 00070AB9 51                          push rcx
 15988 00070ABA E8AF010000                  call print_string_attr
 15989 00070ABF 59                          pop rcx
 15990 00070AC0 4883F900                    cmp rcx, 0
 15991 00070AC4 740B                        je .done
 15992 00070AC6 B02F                        mov al, '/'
 15993 00070AC8 B30E                        mov bl, ATTR_PROMPT
 15994 00070ACA E8FB010000                  call putchar
 15995 00070ACF EBCF                        jmp .printloop
 15996                                  .done:
 15997 00070AD1 5E                          pop rsi
 15998 00070AD2 59                          pop rcx
 15999 00070AD3 5B                          pop rbx
 16000 00070AD4 58                          pop rax
 16001 00070AD5 C3                          ret
 16002                                  
 16003                                  ; next_token: rsi = source (advanced past the consumed token), rdi =
 16004                                  ; destination buffer, rdx = max chars to write (destination buffer
 16005                                  ; size minus 1, for the NUL). Stops copying at rdx chars even if the
 16006                                  ; token is longer, so a long argument (e.g. a long URL) truncates
 16007                                  ; instead of overflowing into whatever buffer follows rdi in memory.
 16008                                  ; Still always NUL-terminates. Supports "quoted strings with spaces".
 16009                                  next_token:
 16010 00070AD6 50                          push rax
 16011 00070AD7 53                          push rbx
 16012 00070AD8 31DB                        xor ebx, ebx                ; chars written so far
 16013                                  .skip:
 16014 00070ADA 8A06                        mov al, [rsi]
 16015 00070ADC 3C00                        cmp al, 0
 16016 00070ADE 744F                        je .empty
 16017 00070AE0 3C20                        cmp al, ' '
 16018 00070AE2 7505                        jne .check_quote
 16019 00070AE4 48FFC6                      inc rsi
 16020 00070AE7 EBF1                        jmp .skip
 16021                                  .check_quote:
 16022 00070AE9 3C22                        cmp al, '"'
 16023 00070AEB 7522                        jne .plain
 16024 00070AED 48FFC6                      inc rsi
 16025                                  .qloop:
 16026 00070AF0 8A06                        mov al, [rsi]
 16027 00070AF2 3C00                        cmp al, 0
 16028 00070AF4 7433                        je .term
 16029 00070AF6 3C22                        cmp al, '"'
 16030 00070AF8 7410                        je .qend
 16031 00070AFA 39D3                        cmp ebx, edx
 16032 00070AFC 7307                        jae .qskip               ; buffer full - keep consuming input but stop writing
 16033 00070AFE 8807                        mov [rdi], al
 16034 00070B00 48FFC7                      inc rdi
 16035 00070B03 FFC3                        inc ebx
 16036                                  .qskip:
 16037 00070B05 48FFC6                      inc rsi
 16038 00070B08 EBE6                        jmp .qloop
 16039                                  .qend:
 16040 00070B0A 48FFC6                      inc rsi
 16041 00070B0D EB1A                        jmp .term
 16042                                  .plain:
 16043                                  .ploop:
 16044 00070B0F 8A06                        mov al, [rsi]
 16045 00070B11 3C00                        cmp al, 0
 16046 00070B13 7414                        je .term
 16047 00070B15 3C20                        cmp al, ' '
 16048 00070B17 7410                        je .term
 16049 00070B19 39D3                        cmp ebx, edx
 16050 00070B1B 7307                        jae .pskip                ; buffer full - keep consuming input but stop writing
 16051 00070B1D 8807                        mov [rdi], al
 16052 00070B1F 48FFC7                      inc rdi
 16053 00070B22 FFC3                        inc ebx
 16054                                  .pskip:
 16055 00070B24 48FFC6                      inc rsi
 16056 00070B27 EBE6                        jmp .ploop
 16057                                  .term:
 16058 00070B29 C60700                      mov byte [rdi], 0
 16059 00070B2C 5B                          pop rbx
 16060 00070B2D 58                          pop rax
 16061 00070B2E C3                          ret
 16062                                  .empty:
 16063 00070B2F C60700                      mov byte [rdi], 0
 16064 00070B32 5B                          pop rbx
 16065 00070B33 58                          pop rax
 16066 00070B34 C3                          ret
 16067                                  
 16068                                  ; str_copy: null-terminated string rsi -> rdi
 16069                                  str_copy:
 16070 00070B35 50                          push rax
 16071                                  .loop:
 16072 00070B36 8A06                        mov al, [rsi]
 16073 00070B38 8807                        mov [rdi], al
 16074 00070B3A 48FFC6                      inc rsi
 16075 00070B3D 48FFC7                      inc rdi
 16076 00070B40 3C00                        cmp al, 0
 16077 00070B42 75F2                        jne .loop
 16078 00070B44 58                          pop rax
 16079 00070B45 C3                          ret
 16080                                  
 16081                                  ; str_append: appends null-terminated string rsi onto the end of the
 16082                                  ; null-terminated buffer starting at rdi (rdi = start of the buffer,
 16083                                  ; not its current end - this walks to the end itself).
 16084                                  str_append:
 16085 00070B46 50                          push rax
 16086 00070B47 56                          push rsi
 16087 00070B48 57                          push rdi
 16088                                  .sa_find_end:
 16089 00070B49 803F00                      cmp byte [rdi], 0
 16090 00070B4C 7405                        je .sa_end_found
 16091 00070B4E 48FFC7                      inc rdi
 16092 00070B51 EBF6                        jmp .sa_find_end
 16093                                  .sa_end_found:
 16094                                  .sa_copy:
 16095 00070B53 8A06                        mov al, [rsi]
 16096 00070B55 8807                        mov [rdi], al
 16097 00070B57 48FFC6                      inc rsi
 16098 00070B5A 48FFC7                      inc rdi
 16099 00070B5D 3C00                        cmp al, 0
 16100 00070B5F 75F2                        jne .sa_copy
 16101 00070B61 5F                          pop rdi
 16102 00070B62 5E                          pop rsi
 16103 00070B63 58                          pop rax
 16104 00070B64 C3                          ret
 16105                                  
 16106                                  ; str_eq: rsi, rdi null-terminated strings. returns al=1 if equal else 0
 16107                                  str_eq:
 16108 00070B65 56                          push rsi
 16109 00070B66 57                          push rdi
 16110                                  .loop:
 16111 00070B67 8A06                        mov al, [rsi]
 16112 00070B69 8A27                        mov ah, [rdi]
 16113 00070B6B 38E0                        cmp al, ah
 16114 00070B6D 7511                        jne .neq
 16115 00070B6F 3C00                        cmp al, 0
 16116 00070B71 7408                        je .eq
 16117 00070B73 48FFC6                      inc rsi
 16118 00070B76 48FFC7                      inc rdi
 16119 00070B79 EBEC                        jmp .loop
 16120                                  .eq:
 16121 00070B7B 5F                          pop rdi
 16122 00070B7C 5E                          pop rsi
 16123 00070B7D B001                        mov al, 1
 16124 00070B7F C3                          ret
 16125                                  .neq:
 16126 00070B80 5F                          pop rdi
 16127 00070B81 5E                          pop rsi
 16128 00070B82 B000                        mov al, 0
 16129 00070B84 C3                          ret
