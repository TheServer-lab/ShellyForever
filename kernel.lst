  1658 0001CB4E 83F900              <1>     cmp ecx, 0
  1659 0001CB51 740A                <1>     je .psb_out                    ; matching close brace - leave r13 on it
  1660 0001CB53 49FFC5              <1>     inc r13
  1661 0001CB56 EBD6                <1>     jmp .psb_loop
  1662                              <1> .psb_next:
  1663 0001CB58 49FFC5              <1>     inc r13
  1664 0001CB5B EBD1                <1>     jmp .psb_loop
  1665                              <1> .psb_out:
  1666 0001CB5D C3                  <1>     ret
  1667                              <1> 
