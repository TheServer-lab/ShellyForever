   314 000001CC 48BE-                       mov rsi, line_buf
   314 000001CE [E08C030000000000] 
   315 000001D6 48BF-                       mov rdi, chain_scan_buf
   315 000001D8 [BC8D030000000000] 
   316 000001E0 E8B93F0100                  call str_copy
   317                                  
   318 000001E5 49BC-                       mov r12, chain_scan_buf   ; r12 = start of current segment
   318 000001E7 [BC8D030000000000] 
   319 000001EF 49BD-                       mov r13, chain_scan_buf   ; r13 = scan pointer
   319 000001F1 [BC8D030000000000] 
   320 000001F9 41B600                      mov r14b, 0               ; r14b = quote state (0=outside, 1=inside)
   321                                  
