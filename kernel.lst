 15041 0000BBFC 52                          push rdx
 15042 0000BBFD 48FFC1                      inc rcx
 15043 0000BC00 EBE6                        jmp .its_loop
 15044                                  .its_reverse:
 15045 0000BC02 4831DB                      xor rbx, rbx
 15046                                  .its_pop:
 15047 0000BC05 4839CB                      cmp rbx, rcx
 15048 0000BC08 740B                        je .its_termin
