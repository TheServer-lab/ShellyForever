  5802                                  ; pci_find_ahci: brute-force scan of PCI bus 0 only (per-device, and every
  5803                                  ; function of a multi-function device). This covers the common case - the
  5804                                  ; chipset's root complex, where AHCI controllers normally live, and is
  5805                                  ; where QEMU/Bochs/VirtualBox and most real desktop chipsets put theirs -
  5806                                  ; but doesn't walk PCI-to-PCI bridges out to other buses, which unusual
  5807                                  ; multi-bus hardware could need. Looks for class 0x01 (mass storage),
  5808                                  ; subclass 0x06 (SATA), regardless of programming interface.
  5809                                  ; On success: CF=0, [ahci_pci_bus/dev/func] set. On failure: CF=1.
  5810                                  pci_find_ahci:
  5811 00004F8B 50                          push rax
  5812 00004F8C 53                          push rbx
  5813 00004F8D 51                          push rcx
  5814 00004F8E 52                          push rdx
  5815 00004F8F 4150                        push r8
  5816 00004F91 4151                        push r9
  5817 00004F93 4152                        push r10
  5818 00004F95 31DB                        xor ebx, ebx                 ; bus 0 only
  5819 00004F97 31C9                        xor ecx, ecx                 ; device 0..31
  5820                                  .dev_loop:
