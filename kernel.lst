  9767 00018331 51                          push rcx
  9768 00018332 B9A0000000                  mov rcx, CONTENT_LEN
  9769 00018337 30C0                        xor al, al
  9770 00018339 F3AA                        rep stosb
  9771 0001833B 59                          pop rcx
  9772 0001833C 48FFC1                      inc rcx
  9773 0001833F EB99                        jmp .extend_loop
  9774                                  .no_extend:
  9775 00018341 4831C0                      xor rax, rax
