 12717 000141AE C3                          ret
 12718                                  
 12719                                  ; str_append: appends null-terminated string rsi onto the end of the
 12720                                  ; null-terminated buffer starting at rdi (rdi = start of the buffer,
 12721                                  ; not its current end - this walks to the end itself).
 12722                                  str_append:
 12723 000141AF 50                          push rax
 12724 000141B0 56                          push rsi
 12725 000141B1 57                          push rdi
