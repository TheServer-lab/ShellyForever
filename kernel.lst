  8925 00017A4D 0A0425[62E80500]            or al, [ata_drive_sel]
  8926 00017A54 EE                          out dx, al
  8927 00017A55 0FB71425[60E80500]          movzx edx, word [ata_port_base]
  8928 00017A5D 6683C202                    add dx, 2
