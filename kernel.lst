  9516 00018004 415E                        pop r14
  9517 00018006 415D                        pop r13
  9518 00018008 415C                        pop r12
  9519 0001800A 415A                        pop r10
  9520 0001800C 4159                        pop r9
  9521 0001800E 4158                        pop r8
