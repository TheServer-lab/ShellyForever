   351 0000022E 48BF-                       mov rdi, line_buf
   351 00000230 [E08C030000000000] 
   352                                  .rr_chain_copy:
   353 00000238 8A06                        mov al, [rsi]
   354 0000023A 3C3B                        cmp al, ';'
   355 0000023C 740E                        je .rr_chain_copy_done
   356 0000023E 84C0                        test al, al
   357 00000240 740A                        je .rr_chain_copy_done
   358 00000242 8807                        mov [rdi], al
   359 00000244 48FFC7                      inc rdi
   360 00000247 48FFC6                      inc rsi
   361 0000024A EBEC                        jmp .rr_chain_copy
   362                                  .rr_chain_copy_done:
