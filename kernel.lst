 16752 000711A6 FE0425[2D1A0700]            inc byte [sb_count]
 16753                                  .out:
 16754 000711AD 5F                          pop rdi
 16755 000711AE 5E                          pop rsi
 16756 000711AF 59                          pop rcx
 16757 000711B0 58                          pop rax
 16758 000711B1 C3                          ret
