 15322                                  ; ============================================================
 15323                                  ;  RTC / CMOS CLOCK  (date, time, wig time)
 15324                                  ; ============================================================
 15325                                  ; The MC146818 real-time clock chip is addressed through port 0x70
 15326                                  ; (register index, bit 7 disables NMIs while set) and 0x71 (data).
 15327                                  ; All values come back BCD-encoded unless status register B's binary
 15328                                  ; bit is set, and hours may be 12-hour mode - rtc_update normalizes
 15329                                  ; everything to plain 24-hour binary before storing it.
 15330                                  
 15331                                  ; cmos_read: al = register index (0..0x3F) -> al = that register's value.
 15332                                  cmos_read:
 15333 0000BE9B 52                          push rdx
 15334 0000BE9C 0C80                        or al, 0x80                 ; set NMI-disable bit while selecting
 15335 0000BE9E 66BA7000                    mov dx, 0x70
 15336 0000BEA2 EE                          out dx, al
 15337                                      ; tiny I/O delay so the RTC latches the address before the data read
 15338 0000BEA3 50                          push rax
 15339 0000BEA4 B000                        mov al, 0
 15340 0000BEA6 E680                        out 0x80, al                ; write to the unused POST port = short pause
 15341 0000BEA8 58                          pop rax
 15342 0000BEA9 66BA7100                    mov dx, 0x71
 15343 0000BEAD EC                          in al, dx
 15344 0000BEAE 5A                          pop rdx
 15345 0000BEAF C3                          ret
 15346                                  
 15347                                  ; rtc_wait_uip: waits until the RTC's Update-In-Progress flag (status A,
 15348                                  ; bit 7) clears, so the registers read below are internally consistent.
 15349                                  rtc_wait_uip:
 15350 0000BEB0 50                          push rax
 15351                                  .uip_wait:
 15352 0000BEB1 B00A                        mov al, 0x0A
 15353 0000BEB3 E8E3FFFFFF                  call cmos_read
 15354 0000BEB8 A880                        test al, 0x80
 15355 0000BEBA 75F5                        jnz .uip_wait
 15356 0000BEBC 58                          pop rax
 15357 0000BEBD C3                          ret
 15358                                  
 15359                                  ; bcd_to_bin: al = BCD byte -> al = binary value. Preserves other regs.
 15360                                  bcd_to_bin:
 15361 0000BEBE 53                          push rbx
 15362 0000BEBF 51                          push rcx
 15363 0000BEC0 52                          push rdx
 15364 0000BEC1 480FB6D8                    movzx rbx, al
 15365 0000BEC5 88D8                        mov al, bl
 15366 0000BEC7 C0E804                      shr al, 4
 15367 0000BECA 480FB6C8                    movzx rcx, al
 15368 0000BECE 486BC90A                    imul rcx, 10
 15369 0000BED2 88D8                        mov al, bl
 15370 0000BED4 240F                        and al, 0x0F
 15371 0000BED6 480FB6D0                    movzx rdx, al
 15372 0000BEDA 4801D1                      add rcx, rdx
 15373 0000BEDD 4889C8                      mov rax, rcx
 15374 0000BEE0 5A                          pop rdx
 15375 0000BEE1 59                          pop rcx
 15376 0000BEE2 5B                          pop rbx
 15377 0000BEE3 C3                          ret
 15378                                  
 15379                                  ; rtc_update: reads seconds/minutes/hours/day/month/year (+ century, if the
 15380                                  ; chip provides one) into the rtc_* variables, normalized to 24-hour binary.
 15381                                  rtc_update:
 15382 0000BEE4 50                          push rax
 15383 0000BEE5 53                          push rbx
 15384 0000BEE6 E8C5FFFFFF                  call rtc_wait_uip
 15385 0000BEEB B000                        mov al, 0x00
 15386 0000BEED E8A9FFFFFF                  call cmos_read
 15387 0000BEF2 880425[647A0700]            mov [rtc_sec], al
 15388 0000BEF9 B002                        mov al, 0x02
 15389 0000BEFB E89BFFFFFF                  call cmos_read
 15390 0000BF00 880425[657A0700]            mov [rtc_min], al
 15391 0000BF07 B004                        mov al, 0x04
 15392 0000BF09 E88DFFFFFF                  call cmos_read
 15393 0000BF0E 880425[667A0700]            mov [rtc_hour], al
 15394 0000BF15 B007                        mov al, 0x07
 15395 0000BF17 E87FFFFFFF                  call cmos_read
 15396 0000BF1C 880425[677A0700]            mov [rtc_day], al
 15397 0000BF23 B008                        mov al, 0x08
 15398 0000BF25 E871FFFFFF                  call cmos_read
 15399 0000BF2A 880425[687A0700]            mov [rtc_month], al
 15400 0000BF31 B009                        mov al, 0x09
 15401 0000BF33 E863FFFFFF                  call cmos_read
 15402 0000BF38 880425[697A0700]            mov [rtc_year], al
 15403 0000BF3F B032                        mov al, 0x32
 15404 0000BF41 E855FFFFFF                  call cmos_read
 15405 0000BF46 880425[6A7A0700]            mov [rtc_century], al
 15406 0000BF4D B00B                        mov al, 0x0B
 15407 0000BF4F E847FFFFFF                  call cmos_read
 15408 0000BF54 88C3                        mov bl, al                     ; status register B
 15409                                      ; BCD? (status B bit 2). If clear, values are already binary.
 15410 0000BF56 F6C304                      test bl, 0x04
 15411 0000BF59 0F8485000000                jz .rtc_no_bcd
 15412 0000BF5F 8A0425[647A0700]            mov al, [rtc_sec]
 15413 0000BF66 E853FFFFFF                  call bcd_to_bin
 15414 0000BF6B 880425[647A0700]            mov [rtc_sec], al
 15415 0000BF72 8A0425[657A0700]            mov al, [rtc_min]
 15416 0000BF79 E840FFFFFF                  call bcd_to_bin
 15417 0000BF7E 880425[657A0700]            mov [rtc_min], al
 15418 0000BF85 8A0425[667A0700]            mov al, [rtc_hour]
 15419 0000BF8C E82DFFFFFF                  call bcd_to_bin
 15420 0000BF91 880425[667A0700]            mov [rtc_hour], al
 15421 0000BF98 8A0425[677A0700]            mov al, [rtc_day]
 15422 0000BF9F E81AFFFFFF                  call bcd_to_bin
 15423 0000BFA4 880425[677A0700]            mov [rtc_day], al
 15424 0000BFAB 8A0425[687A0700]            mov al, [rtc_month]
 15425 0000BFB2 E807FFFFFF                  call bcd_to_bin
 15426 0000BFB7 880425[687A0700]            mov [rtc_month], al
 15427 0000BFBE 8A0425[697A0700]            mov al, [rtc_year]
 15428 0000BFC5 E8F4FEFFFF                  call bcd_to_bin
 15429 0000BFCA 880425[697A0700]            mov [rtc_year], al
 15430 0000BFD1 8A0425[6A7A0700]            mov al, [rtc_century]
 15431 0000BFD8 E8E1FEFFFF                  call bcd_to_bin
 15432 0000BFDD 880425[6A7A0700]            mov [rtc_century], al
 15433                                  .rtc_no_bcd:
 15434                                      ; 12-hour mode? (status B bit 1). If set, hour's bit 7 = PM.
 15435 0000BFE4 F6C302                      test bl, 0x02
 15436 0000BFE7 7425                        jz .rtc_done
 15437 0000BFE9 8A0425[667A0700]            mov al, [rtc_hour]
 15438 0000BFF0 88C4                        mov ah, al
 15439 0000BFF2 247F                        and al, 0x7F                  ; hour value 1..12
 15440 0000BFF4 F6C480                      test ah, 0x80                 ; PM?
 15441 0000BFF7 7408                        jz .rtc_am
 15442 0000BFF9 3C0C                        cmp al, 12
 15443 0000BFFB 730A                        jae .rtc_h12                  ; 12 PM stays 12
 15444 0000BFFD 040C                        add al, 12
 15445 0000BFFF EB06                        jmp .rtc_h12
 15446                                  .rtc_am:
 15447 0000C001 3C0C                        cmp al, 12
 15448 0000C003 7502                        jne .rtc_h12
 15449 0000C005 30C0                        xor al, al                    ; 12 AM = 00
 15450                                  .rtc_h12:
 15451 0000C007 880425[667A0700]            mov [rtc_hour], al
 15452                                  .rtc_done:
 15453 0000C00E 5B                          pop rbx
 15454 0000C00F 58                          pop rax
 15455 0000C010 C3                          ret
 15456                                  
 15457                                  ; ============================================================
 15458                                  ;  TIMING / SLEEP  (Phase 6)
 15459                                  ; ============================================================
 15460                                  ; There's no PIT/IRQ0 timer wired up (no IDT is set up - keyboard is
 15461                                  ; polled, see this file's header comment), so millisecond delays are
 15462                                  ; built from the CPU's own cycle counter (RDTSC) instead of a
 15463                                  ; hardware timer tick. cpu_tsc_hz is calibrated once at boot
 15464                                  ; (tsc_calibrate, called from kernel_entry) by busy-waiting across
 15465                                  ; exactly one real RTC second and counting how many TSC cycles
 15466                                  ; elapsed - rtc_sec_now's raw (possibly BCD) byte is only ever
 15467                                  ; compared for inequality here, so whether it's BCD or binary doesn't
 15468                                  ; matter, only that it changes once per real second. sleep_ms then
 15469                                  ; busy-waits that many cycles*ms/1000, polling kbd_poll/kill_flag on
 15470                                  ; every spin so Esc still aborts a long sleep promptly instead of
 15471                                  ; only being noticed after it returns (see party_exec_stmts's
 15472                                  ; between-statement kill check in party.asm).
 15473 0000C011 90<rep 7h>              ALIGN 8
 15474 0000C018 0000000000000000        cpu_tsc_hz:      dq 0
 15475 0000C020 0000000000000000        sleep_ms_cycles: dq 0
 15476 0000C028 0000000000000000        sleep_ms_target: dq 0
 15477 0000C030 00                      tsc_calibrated:  db 0
 15478                                  
 15479                                  ; tsc_calibrate: measures cpu_tsc_hz. Call once at boot, before
 15480                                  ; anything relies on sleep_ms - takes up to ~1 real second to run.
 15481                                  ; Clobbers rax, rbx, rcx, rdx.
 15482                                  tsc_calibrate:
 15483 0000C031 50                          push rax
 15484 0000C032 53                          push rbx
 15485 0000C033 51                          push rcx
 15486 0000C034 52                          push rdx
 15487 0000C035 E8A1D3FFFF                  call rtc_sec_now
 15488 0000C03A 88C3                        mov bl, al
 15489                                  .tc_wait_edge1:
 15490 0000C03C E89AD3FFFF                  call rtc_sec_now
 15491 0000C041 38D8                        cmp al, bl
 15492 0000C043 74F7                        je .tc_wait_edge1        ; spin until the second changes (align to an edge)
 15493 0000C045 88C3                        mov bl, al
 15494 0000C047 0F31                        rdtsc
 15495 0000C049 48C1E220                    shl rdx, 32
 15496 0000C04D 4809D0                      or rax, rdx
 15497 0000C050 4889C1                      mov rcx, rax              ; rcx = tsc reading at the edge
 15498                                  .tc_wait_edge2:
 15499 0000C053 E883D3FFFF                  call rtc_sec_now
 15500 0000C058 38D8                        cmp al, bl
 15501 0000C05A 74F7                        je .tc_wait_edge2        ; spin for one full real second
 15502 0000C05C 0F31                        rdtsc
 15503 0000C05E 48C1E220                    shl rdx, 32
 15504 0000C062 4809D0                      or rax, rdx               ; rax = tsc reading one second later
 15505 0000C065 4829C8                      sub rax, rcx               ; rax = cycles elapsed in ~1 second
 15506 0000C068 48890425[18C00000]          mov [cpu_tsc_hz], rax
 15507 0000C070 C60425[30C00000]01          mov byte [tsc_calibrated], 1
 15508 0000C078 5A                          pop rdx
 15509 0000C079 59                          pop rcx
 15510 0000C07A 5B                          pop rbx
 15511 0000C07B 58                          pop rax
 15512 0000C07C C3                          ret
 15513                                  
 15514                                  ; sleep_ms: rdi = milliseconds to busy-wait. Returns early (without
 15515                                  ; completing the full delay) if Esc sets kill_flag mid-sleep - the
 15516                                  ; caller doesn't need to do anything extra for that, party_exec_stmts's
 15517                                  ; own kill check (which runs right after a builtin call returns) takes
 15518                                  ; it from there. If cpu_tsc_hz is still 0 (tsc_calibrate never ran, or
 15519                                  ; an absent/bugged TSC), this is a no-op instead of a divide fault or
 15520                                  ; an infinite spin. Clobbers rax, rbx, rcx, rdx.
 15521                                  sleep_ms:
 15522 0000C07D 50                          push rax
 15523 0000C07E 53                          push rbx
 15524 0000C07F 51                          push rcx
 15525 0000C080 52                          push rdx
 15526 0000C081 48833C25[18C00000]-         cmp qword [cpu_tsc_hz], 0
 15526 0000C089 00                 
 15527 0000C08A 745E                        je .sm_out
 15528 0000C08C 488B0425[18C00000]          mov rax, [cpu_tsc_hz]
 15529 0000C094 480FAFC7                    imul rax, rdi                 ; rax = tsc_hz * ms
 15530 0000C098 4831D2                      xor rdx, rdx
 15531 0000C09B BBE8030000                  mov rbx, 1000
 15532 0000C0A0 48F7F3                      div rbx                       ; rax = cycles to wait
 15533 0000C0A3 48890425[20C00000]          mov [sleep_ms_cycles], rax
 15534 0000C0AB 0F31                        rdtsc
 15535 0000C0AD 48C1E220                    shl rdx, 32
 15536 0000C0B1 4809D0                      or rax, rdx
 15537 0000C0B4 48030425[20C00000]          add rax, [sleep_ms_cycles]
 15538 0000C0BC 48890425[28C00000]          mov [sleep_ms_target], rax    ; target tsc reading
 15539                                  .sm_loop:
 15540 0000C0C4 E804A2FFFF                  call kbd_poll
 15541 0000C0C9 803C25[695A0A00]00          cmp byte [kill_flag], 0
 15542 0000C0D1 7517                        jne .sm_out                   ; Esc pressed - stop waiting early
 15543 0000C0D3 0F31                        rdtsc
 15544 0000C0D5 48C1E220                    shl rdx, 32
 15545 0000C0D9 4809D0                      or rax, rdx
 15546 0000C0DC 483B0425[28C00000]          cmp rax, [sleep_ms_target]
 15547 0000C0E4 7304                        jae .sm_out
 15548 0000C0E6 F390                        pause
 15549 0000C0E8 EBDA                        jmp .sm_loop
 15550                                  .sm_out:
 15551 0000C0EA 5A                          pop rdx
 15552 0000C0EB 59                          pop rcx
 15553 0000C0EC 5B                          pop rbx
 15554 0000C0ED 58                          pop rax
 15555 0000C0EE C3                          ret
 15556                                  
 15557                                  ; ============================================================
 15558                                  ;  CURSOR ADDRESSING  (Phase 6)
 15559                                  ; ============================================================
 15560                                  ; kernel_gotoxy: dil = x (column, 0..VGA_COLS-1), sil = y (row,
 15561                                  ; 0..VGA_ROWS-1). Moves cursor_row/cursor_col directly (no scrolling,
 15562                                  ; no drawing) and updates the hardware cursor, so the next
 15563                                  ; display/putchar output starts from there. Range-checking the x/y
 15564                                  ; args against screen bounds is the caller's job (party_bi_gotoxy) -
 15565                                  ; this just writes them through, same division of labor as putchar
 15566                                  ; trusting cursor_row/cursor_col are already in range. Clobbers rax.
 15567                                  kernel_gotoxy:
 15568 0000C0EF 50                          push rax
 15569 0000C0F0 4088F8                      mov al, dil
 15570 0000C0F3 880425[191A0700]            mov [cursor_col], al
 15571 0000C0FA 4088F0                      mov al, sil
 15572 0000C0FD 880425[181A0700]            mov [cursor_row], al
 15573 0000C104 E8BE4A0600                  call update_cursor
 15574 0000C109 58                          pop rax
 15575 0000C10A C3                          ret
 15576                                  
 15577                                  ; format_num2: rax = 0..99 -> two zero-padded digits written to [rdi], rdi
 15578                                  ; advances by 2. Preserves rax/rbx/rcx/rdx.
 15579                                  format_num2:
 15580 0000C10B 50                          push rax
 15581 0000C10C 53                          push rbx
 15582 0000C10D 51                          push rcx
 15583 0000C10E 52                          push rdx
 15584 0000C10F 4831D2                      xor rdx, rdx
 15585 0000C112 BB0A000000                  mov rbx, 10
 15586 0000C117 48F7F3                      div rbx                       ; rax = tens, rdx = ones
 15587 0000C11A 0430                        add al, '0'
 15588 0000C11C 8807                        mov [rdi], al
 15589 0000C11E 48FFC7                      inc rdi
 15590 0000C121 88D0                        mov al, dl
 15591 0000C123 0430                        add al, '0'
 15592 0000C125 8807                        mov [rdi], al
 15593 0000C127 48FFC7                      inc rdi
 15594 0000C12A 5A                          pop rdx
 15595 0000C12B 59                          pop rcx
 15596 0000C12C 5B                          pop rbx
 15597 0000C12D 58                          pop rax
 15598 0000C12E C3                          ret
 15599                                  
 15600                                  ; format_num4: rax = 0..9999 -> four zero-padded digits written to [rdi],
 15601                                  ; rdi advances by 4. Preserves rax/rbx/rcx/rdx.
 15602                                  format_num4:
 15603 0000C12F 50                          push rax
 15604 0000C130 53                          push rbx
 15605 0000C131 51                          push rcx
 15606 0000C132 52                          push rdx
 15607 0000C133 4831D2                      xor rdx, rdx
 15608 0000C136 BBE8030000                  mov rbx, 1000
 15609 0000C13B 48F7F3                      div rbx                       ; rax = thousands, rdx = remainder
 15610 0000C13E 52                          push rdx
 15611 0000C13F 0430                        add al, '0'
 15612 0000C141 8807                        mov [rdi], al
 15613 0000C143 48FFC7                      inc rdi
 15614 0000C146 58                          pop rax
 15615 0000C147 4831D2                      xor rdx, rdx
 15616 0000C14A BB64000000                  mov rbx, 100
 15617 0000C14F 48F7F3                      div rbx                       ; rax = hundreds, rdx = remainder
 15618 0000C152 52                          push rdx
 15619 0000C153 0430                        add al, '0'
 15620 0000C155 8807                        mov [rdi], al
 15621 0000C157 48FFC7                      inc rdi
 15622 0000C15A 58                          pop rax
 15623 0000C15B 4831D2                      xor rdx, rdx
 15624 0000C15E BB0A000000                  mov rbx, 10
 15625 0000C163 48F7F3                      div rbx                       ; rax = tens, rdx = ones
 15626 0000C166 0430                        add al, '0'
 15627 0000C168 8807                        mov [rdi], al
 15628 0000C16A 48FFC7                      inc rdi
 15629 0000C16D 88D0                        mov al, dl
 15630 0000C16F 0430                        add al, '0'
 15631 0000C171 8807                        mov [rdi], al
 15632 0000C173 48FFC7                      inc rdi
 15633 0000C176 5A                          pop rdx
 15634 0000C177 59                          pop rcx
 15635 0000C178 5B                          pop rbx
 15636 0000C179 58                          pop rax
 15637 0000C17A C3                          ret
 15638                                  
 15639                                  ; format_time: writes "HH:MM:SS\0" to [rdi], rdi advances to the terminator.
 15640                                  ; Preserves everything except rdi.
 15641                                  format_time:
 15642 0000C17B 50                          push rax
 15643 0000C17C E863FDFFFF                  call rtc_update
 15644 0000C181 480FB60425-                 movzx rax, byte [rtc_hour]
 15644 0000C186 [667A0700]         
 15645 0000C18A E87CFFFFFF                  call format_num2
 15646 0000C18F C6073A                      mov byte [rdi], ':'
 15647 0000C192 48FFC7                      inc rdi
 15648 0000C195 480FB60425-                 movzx rax, byte [rtc_min]
 15648 0000C19A [657A0700]         
 15649 0000C19E E868FFFFFF                  call format_num2
 15650 0000C1A3 C6073A                      mov byte [rdi], ':'
 15651 0000C1A6 48FFC7                      inc rdi
 15652 0000C1A9 480FB60425-                 movzx rax, byte [rtc_sec]
 15652 0000C1AE [647A0700]         
 15653 0000C1B2 E854FFFFFF                  call format_num2
 15654 0000C1B7 C60700                      mov byte [rdi], 0
 15655 0000C1BA 58                          pop rax
 15656 0000C1BB C3                          ret
 15657                                  
 15658                                  ; format_date: writes "YYYY-MM-DD\0" to [rdi], rdi advances to the
 15659                                  ; terminator. Preserves everything except rdi.
 15660                                  format_date:
 15661 0000C1BC 50                          push rax
 15662 0000C1BD 53                          push rbx
 15663 0000C1BE E821FDFFFF                  call rtc_update
 15664                                      ; full year = century*100 + year; fall back to the 2000s when the
 15665                                      ; chip has no century register (or it reports something unusable).
 15666 0000C1C3 480FB60425-                 movzx rax, byte [rtc_century]
 15666 0000C1C8 [6A7A0700]         
 15667 0000C1CC 3C14                        cmp al, 20
 15668 0000C1CE 7406                        je .fd_cent_ok
 15669 0000C1D0 3C15                        cmp al, 21
 15670 0000C1D2 7402                        je .fd_cent_ok
 15671 0000C1D4 B014                        mov al, 20
 15672                                  .fd_cent_ok:
 15673 0000C1D6 486BC064                    imul rax, 100
 15674 0000C1DA 480FB61C25-                 movzx rbx, byte [rtc_year]
 15674 0000C1DF [697A0700]         
 15675 0000C1E3 4801D8                      add rax, rbx
 15676 0000C1E6 E844FFFFFF                  call format_num4
 15677 0000C1EB C6072D                      mov byte [rdi], '-'
 15678 0000C1EE 48FFC7                      inc rdi
 15679 0000C1F1 480FB60425-                 movzx rax, byte [rtc_month]
 15679 0000C1F6 [687A0700]         
 15680 0000C1FA E80CFFFFFF                  call format_num2
 15681 0000C1FF C6072D                      mov byte [rdi], '-'
 15682 0000C202 48FFC7                      inc rdi
 15683 0000C205 480FB60425-                 movzx rax, byte [rtc_day]
 15683 0000C20A [677A0700]         
 15684 0000C20E E8F8FEFFFF                  call format_num2
 15685 0000C213 C60700                      mov byte [rdi], 0
 15686 0000C216 5B                          pop rbx
 15687 0000C217 58                          pop rax
 15688 0000C218 C3                          ret
 15689                                  
 15690                                  ; ------------------------------------------------------------
 15691                                  ; cmd_date / cmd_time: print the current date / time from the RTC.
 15692                                  ; ------------------------------------------------------------
 15693                                  cmd_date:
 15694 0000C219 488D3C25[7B7A0700]          lea rdi, [date_str_buf]
 15695 0000C221 E896FFFFFF                  call format_date
 15696 0000C226 48BE-                       mov rsi, date_str_buf
 15696 0000C228 [7B7A070000000000] 
 15697 0000C230 8A0425[241A0700]            mov al, [cur_normal_attr]
 15698 0000C237 E8324A0600                  call print_string_attr
 15699 0000C23C 48BE-                       mov rsi, newline_str
 15699 0000C23E [007B070000000000] 
 15700 0000C246 E8144A0600                  call print_string
 15701 0000C24B C3                          ret
 15702                                  
 15703                                  cmd_time:
 15704 0000C24C 488D3C25[6B7A0700]          lea rdi, [time_str_buf]
 15705 0000C254 E822FFFFFF                  call format_time
 15706 0000C259 48BE-                       mov rsi, time_str_buf
 15706 0000C25B [6B7A070000000000] 
 15707 0000C263 8A0425[241A0700]            mov al, [cur_normal_attr]
 15708 0000C26A E8FF490600                  call print_string_attr
 15709 0000C26F 48BE-                       mov rsi, newline_str
 15709 0000C271 [007B070000000000] 
 15710 0000C279 E8E1490600                  call print_string
 15711 0000C27E C3                          ret
 15712                                  
 15713                                  ; ------------------------------------------------------------
 15714                                  ; cmd_write: write <path> <content> creates the file (or overwrites an
 15715                                  ; existing file's content). It's meant to be used through a "~" pipe -
 15716                                  ; "show hi ~ write file.txt" writes "hi" to file.txt - but also works
 15717                                  ; standalone: write file.txt "some text".
 15718                                  ; ------------------------------------------------------------
 15719                                  cmd_write:
 15720 0000C27F 803C25[B8360A00]00          cmp byte [arg1_buf], 0
 15721 0000C287 7512                        jne .cw_have_arg
 15722 0000C289 48BE-                       mov rsi, msg_write_usage
 15722 0000C28B [F59B070000000000] 
 15723 0000C293 B00C                        mov al, ATTR_ERROR
 15724 0000C295 E8D4490600                  call print_string_attr
 15725 0000C29A C3                          ret
 15726                                  .cw_have_arg:
 15727 0000C29B 488B0425[1B1A0700]          mov rax, [cur_dir]
 15728 0000C2A3 48BE-                       mov rsi, arg1_buf
 15728 0000C2A5 [B8360A0000000000] 
 15729 0000C2AD 48BF-                       mov rdi, leaf1_buf
 15729 0000C2AF [60340A0000000000] 
 15730 0000C2B7 E846C4FFFF                  call fs_resolve_path
 15731 0000C2BC 4883F8FF                    cmp rax, -1
 15732 0000C2C0 0F84D3000000                je .cw_bad_path
 15733 0000C2C6 4989C3                      mov r11, rax                  ; parent dir the file goes in
 15734 0000C2C9 E82ABBFFFF                  call check_target_sys_auth
 15735 0000C2CE 4883F801                    cmp rax, 1
 15736 0000C2D2 0F84C1000000                je .cw_bad_path
 15737                                      ; an existing FILE by that name gets its content overwritten
 15738 0000C2D8 4C89D8                      mov rax, r11
 15739 0000C2DB 48BE-                       mov rsi, leaf1_buf
 15739 0000C2DD [60340A0000000000] 
 15740 0000C2E5 41BA02000000                mov r10, 2
 15741 0000C2EB E865BBFFFF                  call fs_find_child
 15742 0000C2F0 4883F8FF                    cmp rax, -1
 15743 0000C2F4 7550                        jne .cw_overwrite
 15744                                      ; no file - make sure a folder with that name isn't in the way
 15745 0000C2F6 4C89D8                      mov rax, r11
 15746 0000C2F9 48BE-                       mov rsi, leaf1_buf
 15746 0000C2FB [60340A0000000000] 
 15747 0000C303 49C7C2FFFFFFFF              mov r10, -1
 15748 0000C30A E846BBFFFF                  call fs_find_child
 15749 0000C30F 4883F8FF                    cmp rax, -1
 15750 0000C313 7544                        jne .cw_exists
 15751 0000C315 4C89D8                      mov rax, r11
 15752 0000C318 48BE-                       mov rsi, leaf1_buf
 15752 0000C31A [60340A0000000000] 
 15753 0000C322 41BA02000000                mov r10, 2                    ; type file
 15754 0000C328 E8A0BBFFFF                  call fs_create_node
 15755 0000C32D 4883F8FF                    cmp rax, -1
 15756 0000C331 7438                        je .cw_full
 15757 0000C333 488D3425[B8370A00]          lea rsi, [arg2_buf]
 15758 0000C33B E8D9BFFFFF                  call fs_write_file
 15759 0000C340 E8E36AFFFF                  call maybe_auto_sync
 15760 0000C345 C3                          ret
 15761                                  .cw_overwrite:
 15762                                      ; rax = existing file node index, replace its content
 15763 0000C346 488D3425[B8370A00]          lea rsi, [arg2_buf]
 15764 0000C34E E8C6BFFFFF                  call fs_write_file
 15765 0000C353 E8D06AFFFF                  call maybe_auto_sync
 15766 0000C358 C3                          ret
 15767                                  .cw_exists:
 15768 0000C359 48BE-                       mov rsi, msg_exists
 15768 0000C35B [A185070000000000] 
 15769 0000C363 B00C                        mov al, ATTR_ERROR
 15770 0000C365 E804490600                  call print_string_attr
 15771 0000C36A C3                          ret
 15772                                  .cw_full:
 15773 0000C36B 803C25[E3C90800]01          cmp byte [fs_name_too_long], 1
 15774 0000C373 7412                        je .cw_toolong
 15775 0000C375 48BE-                       mov rsi, msg_full
 15775 0000C377 [C785070000000000] 
 15776 0000C37F B00C                        mov al, ATTR_ERROR
 15777 0000C381 E8E8480600                  call print_string_attr
 15778 0000C386 C3                          ret
 15779                                  .cw_toolong:
 15780 0000C387 48BE-                       mov rsi, msg_name_too_long
 15780 0000C389 [E285070000000000] 
 15781 0000C391 B00C                        mov al, ATTR_ERROR
 15782 0000C393 E8D6480600                  call print_string_attr
 15783 0000C398 C3                          ret
 15784                                  .cw_bad_path:
 15785 0000C399 48BE-                       mov rsi, msg_bad_path
 15785 0000C39B [2085070000000000] 
 15786 0000C3A3 B00C                        mov al, ATTR_ERROR
 15787 0000C3A5 E8C4480600                  call print_string_attr
 15788 0000C3AA 48BE-                       mov rsi, arg1_buf
 15788 0000C3AC [B8360A0000000000] 
 15789 0000C3B4 E8A6480600                  call print_string
 15790 0000C3B9 48BE-                       mov rsi, newline_str
 15790 0000C3BB [007B070000000000] 
 15791 0000C3C3 E897480600                  call print_string
 15792 0000C3C8 C3                          ret
 15793                                  
 15794                                  ; ------------------------------------------------------------
 15795                                  ; wig time: the "widget" command. Draws a live clock in the top-right
 15796                                  ; corner of the screen that updates every second, until Esc is pressed.
 15797                                  ; ------------------------------------------------------------
 15798                                  
 15799                                  ; wig_draw_clock: right-aligns "HH:MM:SS" at row 0 of the screen, writing
 15800                                  ; straight to VGA memory so the shell's cursor and scrollback stay put.
 15801                                  wig_draw_clock:
 15802 0000C3C9 50                          push rax
 15803 0000C3CA 53                          push rbx
 15804 0000C3CB 51                          push rcx
 15805 0000C3CC 56                          push rsi
 15806 0000C3CD 57                          push rdi
 15807 0000C3CE 488D3C25[8B7A0700]          lea rdi, [wig_str_buf]
 15808 0000C3D6 E8A0FDFFFF                  call format_time
 15809 0000C3DB 488D3425[8B7A0700]          lea rsi, [wig_str_buf]
 15810 0000C3E3 E8A0F6FFFF                  call str_len                  ; rax = 8 (always, for HH:MM:SS)
 15811 0000C3E8 BB50000000                  mov rbx, 80
 15812 0000C3ED 4829C3                      sub rbx, rax                  ; rbx = starting column
 15813 0000C3F0 486BDB02                    imul rbx, rbx, 2              ; column -> byte offset
 15814 0000C3F4 488DBB00800B00              lea rdi, [VGA_BASE + rbx]
 15815 0000C3FB 488D3425[8B7A0700]          lea rsi, [wig_str_buf]
 15816 0000C403 B30B                        mov bl, ATTR_WIG
 15817                                  .wig_write:
 15818 0000C405 8A06                        mov al, [rsi]
 15819 0000C407 3C00                        cmp al, 0
 15820 0000C409 740E                        je .wig_written
 15821 0000C40B 8807                        mov [rdi], al
 15822 0000C40D 885F01                      mov [rdi+1], bl
 15823 0000C410 4883C702                    add rdi, 2
 15824 0000C414 48FFC6                      inc rsi
 15825 0000C417 EBEC                        jmp .wig_write
 15826                                  .wig_written:
 15827 0000C419 5F                          pop rdi
 15828 0000C41A 5E                          pop rsi
 15829 0000C41B 59                          pop rcx
 15830 0000C41C 5B                          pop rbx
 15831 0000C41D 58                          pop rax
 15832 0000C41E C3                          ret
 15833                                  
 15834                                  ; wig_clear: blanks the 8-column corner slot the widget draws in.
 15835                                  wig_clear:
 15836 0000C41F 50                          push rax
 15837 0000C420 51                          push rcx
 15838 0000C421 57                          push rdi
 15839 0000C422 488D3C2590800B00            lea rdi, [VGA_BASE + (0*80 + 72)*2]
 15840 0000C42A B908000000                  mov rcx, 8
 15841 0000C42F 66B82007                    mov ax, 0x0720                ; space, light grey on black
 15842                                  .wig_clr:
 15843 0000C433 668907                      mov [rdi], ax
 15844 0000C436 4883C702                    add rdi, 2
 15845 0000C43A E2F7                        loop .wig_clr
 15846 0000C43C 5F                          pop rdi
 15847 0000C43D 59                          pop rcx
 15848 0000C43E 58                          pop rax
 15849 0000C43F C3                          ret
 15850                                  
 15851                                  ; cmd_wig: usage "wig time". Runs the live clock widget until Esc.
 15852                                  cmd_wig:
 15853 0000C440 803C25[B8360A00]00          cmp byte [arg1_buf], 0
 15854 0000C448 0F847D000000                je .wig_usage
 15855 0000C44E 48BE-                       mov rsi, arg1_buf
 15855 0000C450 [B8360A0000000000] 
 15856 0000C458 48BF-                       mov rdi, str_time
 15856 0000C45A [AC7E070000000000] 
 15857 0000C462 E8FE460600                  call str_eq
 15858 0000C467 3C01                        cmp al, 1
 15859 0000C469 7560                        jne .wig_usage
 15860 0000C46B C60425[695A0A00]00          mov byte [kill_flag], 0
 15861 0000C473 E851FFFFFF                  call wig_draw_clock
 15862 0000C478 E867FAFFFF                  call rtc_update
 15863 0000C47D 8A0425[647A0700]            mov al, [rtc_sec]
 15864 0000C484 880425[9B7A0700]            mov [wig_last_sec], al
 15865                                  .wig_loop:
 15866 0000C48B E83D9EFFFF                  call kbd_poll
 15867 0000C490 803C25[695A0A00]00          cmp byte [kill_flag], 0
 15868 0000C498 7523                        jne .wig_done
 15869 0000C49A E845FAFFFF                  call rtc_update
 15870 0000C49F 8A0425[647A0700]            mov al, [rtc_sec]
 15871 0000C4A6 3A0425[9B7A0700]            cmp al, [wig_last_sec]
 15872 0000C4AD 74DC                        je .wig_loop
 15873 0000C4AF 880425[9B7A0700]            mov [wig_last_sec], al
 15874 0000C4B6 E80EFFFFFF                  call wig_draw_clock
 15875 0000C4BB EBCE                        jmp .wig_loop
 15876                                  .wig_done:
 15877 0000C4BD C60425[695A0A00]00          mov byte [kill_flag], 0
 15878 0000C4C5 E855FFFFFF                  call wig_clear
 15879 0000C4CA C3                          ret
 15880                                  .wig_usage:
 15881 0000C4CB 48BE-                       mov rsi, msg_wig_usage
 15881 0000C4CD [3A9C070000000000] 
 15882 0000C4D5 B00C                        mov al, ATTR_ERROR
 15883 0000C4D7 E892470600                  call print_string_attr
 15884 0000C4DC C3                          ret
 15885                                  
 15886                                  ; cmd_shelly: prints a splash banner. The title cycles through the rainbow
 15887                                  ; palette one character at a time.
 15888                                  cmd_shelly:
 15889 0000C4DD 48BE-                       mov rsi, shelly_rule
 15889 0000C4DF [2A7F070000000000] 
 15890 0000C4E7 B00B                        mov al, ATTR_WIG
 15891 0000C4E9 E880470600                  call print_string_attr
 15892 0000C4EE 488D3425[6A7F0700]          lea rsi, [shelly_title]
 15893 0000C4F6 E853000000                  call cmd_shelly_rainbow
 15894 0000C4FB B00A                        mov al, 0x0A
 15895 0000C4FD 8A1C25[241A0700]            mov bl, [cur_normal_attr]
 15896 0000C504 E8C1470600                  call putchar
 15897 0000C509 48BE-                       mov rsi, shelly_version
 15897 0000C50B [847F070000000000] 
 15898 0000C513 B00B                        mov al, ATTR_WIG
 15899 0000C515 E854470600                  call print_string_attr
 15900 0000C51A 48BE-                       mov rsi, shelly_by
 15900 0000C51C [967F070000000000] 
 15901 0000C524 B00D                        mov al, 0x0D
 15902 0000C526 E843470600                  call print_string_attr
 15903 0000C52B 48BE-                       mov rsi, shelly_cr
 15903 0000C52D [BB7F070000000000] 
 15904 0000C535 B00E                        mov al, ATTR_PROMPT
 15905 0000C537 E832470600                  call print_string_attr
 15906 0000C53C 48BE-                       mov rsi, shelly_rule
 15906 0000C53E [2A7F070000000000] 
 15907 0000C546 B00B                        mov al, ATTR_WIG
 15908 0000C548 E821470600                  call print_string_attr
 15909 0000C54D C3                          ret
 15910                                  
 15911                                  ; cmd_shelly_rainbow: prints the null-terminated string in rsi, cycling the
 15912                                  ; attribute through the rainbow palette per character.
 15913                                  cmd_shelly_rainbow:
 15914 0000C54E 50                          push rax
 15915 0000C54F 53                          push rbx
 15916 0000C550 51                          push rcx
 15917 0000C551 56                          push rsi
 15918 0000C552 4831C9                      xor rcx, rcx
 15919                                  .rs_loop:
 15920 0000C555 8A06                        mov al, [rsi]
 15921 0000C557 3C00                        cmp al, 0
 15922 0000C559 7421                        je .rs_done
 15923 0000C55B 488D1C25[247F0700]          lea rbx, [shelly_palette]
 15924 0000C563 8A1C0B                      mov bl, [rbx + rcx]
 15925 0000C566 E85F470600                  call putchar
 15926 0000C56B 48FFC6                      inc rsi
 15927 0000C56E 48FFC1                      inc rcx
 15928 0000C571 4883F906                    cmp rcx, SHELLY_PAL_LEN
 15929 0000C575 72DE                        jb .rs_loop
 15930 0000C577 4831C9                      xor rcx, rcx
 15931 0000C57A EBD9                        jmp .rs_loop
 15932                                  .rs_done:
 15933 0000C57C 5E                          pop rsi
 15934 0000C57D 59                          pop rcx
 15935 0000C57E 5B                          pop rbx
 15936 0000C57F 58                          pop rax
 15937 0000C580 C3                          ret
 15938                                  
 15939                                  %include "party.asm"
     1                              <1> ; ============================================================
     2                              <1> ;  PARTY (.pa) LANGUAGE — LEXER
     3                              <1> ; ============================================================
     4                              <1> ; Stage 1 of the Party interpreter: turns raw script text into a flat
     5                              <1> ; array of tokens. No parsing/execution here yet - that's the next
     6                              <1> ; module. cmd_party currently just reads the file, lexes it, and
     7                              <1> ; prints the token stream so the lexer can be verified on its own
     8                              <1> ; before anything is built on top of it.
     9                              <1> ;
    10                              <1> ; Design:
    11                              <1> ;   - Token = 8 bytes: {type:u8, reserved:u8, length:u16, start:u32}
    12                              <1> ;     start/length point INTO the source buffer (fs_io_buf) rather
    13                              <1> ;     than copying text out - cheap and matches how the rest of the
    14                              <1> ;     kernel already slices strings in place (see fs_resolve_path).
    15                              <1> ;   - Newlines are real tokens (TOK_NEWLINE), not whitespace, since
    16                              <1> ;     Party statements are newline-terminated - the parser needs to
    17                              <1> ;     see where a statement ends.
    18                              <1> ;   - "-45" is NOT a single token: '-' lexes as TOK_MINUS and 45 as
    19                              <1> ;     TOK_INT; unary minus is a parser concern, same approach as the
    20                              <1> ;     existing calc evaluator (eval_expr) uses.
    21                              <1> ;   - Keyword vs identifier is decided here (scan word, then compare
    22                              <1> ;     against the keyword list) via the existing str_eq helper.
    23                              <1> ; ============================================================
    24                              <1> 
    25                              <1> PARTY_MAX_TOKENS equ 2048    ; token array capacity - was 512, too small for
    26                              <1>                               ; even moderate scripts (e.g. matrix_rain.pa
    27                              <1>                               ; needs ~775 tokens); party_emit's overflow
    28                              <1>                               ; path looks identical to a bad-char lex
    29                              <1>                               ; failure to the caller (same party_lex_ok=0
    30                              <1>                               ; + party_error_line), so hitting the old cap
    31                              <1>                               ; showed up as a misleading "lex error near
    32                              <1>                               ; line N" at whatever line happened to be
    33                              <1>                               ; mid-scan when the array filled, not at any
    34                              <1>                               ; actually-invalid text
    35                              <1> PARTY_IDENT_MAX  equ 40      ; longest ident/keyword this lexer buffers
    36                              <1> 
    37                              <1> ; ---- token types ----
    38                              <1> TOK_EOF     equ 0
    39                              <1> TOK_IDENT   equ 1
    40                              <1> TOK_STR     equ 2
    41                              <1> TOK_INT     equ 3
    42                              <1> TOK_FLOAT   equ 4
    43                              <1> TOK_TRUE    equ 5
    44                              <1> TOK_FALSE   equ 6
    45                              <1> TOK_VARS    equ 7
    46                              <1> TOK_IF      equ 8
    47                              <1> TOK_ELSE    equ 9
    48                              <1> TOK_WHILE   equ 10
    49                              <1> TOK_FUNC    equ 11
    50                              <1> TOK_RETURN  equ 12
    51                              <1> TOK_DISPLAY equ 13
    52                              <1> TOK_NEWLINE equ 14
    53                              <1> TOK_LBRACE  equ 15
    54                              <1> TOK_RBRACE  equ 16
    55                              <1> TOK_LPAREN  equ 17
    56                              <1> TOK_RPAREN  equ 18
    57                              <1> TOK_PLUS    equ 19
    58                              <1> TOK_MINUS   equ 20
    59                              <1> TOK_STAR    equ 21
    60                              <1> TOK_SLASH   equ 22
    61                              <1> TOK_EQ      equ 23
