 14164 0001AEB6 80F901                      cmp cl, 1
 14165 0001AEB9 0F8567010000                jne .ee_bad
 14166                                  .ee_have_val:
 14167 0001AEBF 4983FA01                    cmp r10, 1
 14168 0001AEC3 7506                        jne .ee_store
 14169 0001AEC5 48F7D8                      neg rax
 14170 0001AEC8 4D31D2                      xor r10, r10
 14171                                  .ee_store:
 14172 0001AECB 4983F820                    cmp r8, MAX_CALC_TOKENS
 14173 0001AECF 0F8351010000                jae .ee_bad
 14174 0001AED5 4A8904C5[30060700]          mov [calc_vals + r8*8], rax
 14175 0001AEDD 49FFC0                      inc r8
 14176 0001AEE0 41B900000000                mov r9, 0
 14177 0001AEE6 E96EFFFFFF                  jmp .ee_loop
 14178                                  
 14179                                  .ee_operator:
 14180 0001AEEB 3C2B                        cmp al, '+'
 14181 0001AEED 7411                        je .ee_op_ok
 14182 0001AEEF 3C2D                        cmp al, '-'
 14183 0001AEF1 740D                        je .ee_op_ok
 14184 0001AEF3 3C2A                        cmp al, '*'
 14185 0001AEF5 7409                        je .ee_op_ok
 14186 0001AEF7 3C2F                        cmp al, '/'
 14187 0001AEF9 7405                        je .ee_op_ok
 14188 0001AEFB E926010000                  jmp .ee_bad
 14189                                  .ee_op_ok:
 14190 0001AF00 4D89C3                      mov r11, r8
 14191 0001AF03 49FFCB                      dec r11
 14192 0001AF06 418883[30080700]            mov [calc_ops + r11], al
 14193 0001AF0D 48FFC6                      inc rsi
 14194 0001AF10 41B901000000                mov r9, 1
 14195 0001AF16 E93EFFFFFF                  jmp .ee_loop
 14196                                  
 14197                                  .ee_endloop:
 14198 0001AF1B 4983F901                    cmp r9, 1
 14199 0001AF1F 0F8401010000                je .ee_bad
 14200 0001AF25 4983F800                    cmp r8, 0
 14201 0001AF29 0F84F7000000                je .ee_bad
 14202                                  
 14203                                      ; ---- pass 1: fold * and / left-to-right ----
 14204 0001AF2F 488B0425[30060700]          mov rax, [calc_vals]
 14205 0001AF37 48890425[30070700]          mov [calc_vals2], rax
 14206 0001AF3F 41BC01000000                mov r12, 1
 14207 0001AF45 4D31ED                      xor r13, r13
 14208                                  .ee_md_loop:
 14209 0001AF48 4C89C0                      mov rax, r8
 14210 0001AF4B 48FFC8                      dec rax
 14211 0001AF4E 4939C5                      cmp r13, rax
 14212 0001AF51 0F838D000000                jae .ee_md_done
 14213 0001AF57 490FB68D[30080700]          movzx rcx, byte [calc_ops + r13]
 14214 0001AF5F 4C89E2                      mov rdx, r12
 14215 0001AF62 48FFCA                      dec rdx
 14216 0001AF65 80F92A                      cmp cl, '*'
 14217 0001AF68 7428                        je .ee_domul
 14218 0001AF6A 80F92F                      cmp cl, '/'
 14219 0001AF6D 7444                        je .ee_dodiv
 14220 0001AF6F 4C89EB                      mov rbx, r13
 14221 0001AF72 48FFC3                      inc rbx
 14222 0001AF75 488B04DD[30060700]          mov rax, [calc_vals + rbx*8]
 14223 0001AF7D 4A8904E5[30070700]          mov [calc_vals2 + r12*8], rax
 14224 0001AF85 41888C24[4F080700]          mov [calc_ops2 + r12 - 1], cl
 14225 0001AF8D 49FFC4                      inc r12
 14226 0001AF90 EB4A                        jmp .ee_md_next
 14227                                  .ee_domul:
 14228 0001AF92 488B04D5[30070700]          mov rax, [calc_vals2 + rdx*8]
 14229 0001AF9A 4C89EB                      mov rbx, r13
 14230 0001AF9D 48FFC3                      inc rbx
 14231 0001AFA0 480FAF04DD-                 imul rax, [calc_vals + rbx*8]
 14231 0001AFA5 [30060700]         
 14232 0001AFA9 488904D5[30070700]          mov [calc_vals2 + rdx*8], rax
 14233 0001AFB1 EB29                        jmp .ee_md_next
