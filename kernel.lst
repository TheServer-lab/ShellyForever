  9826                                  ; ============================================================
  9827                                  ;  DISK PERSISTENCE  (ATA PIO driver, primary bus, LBA28, polling)
  9828                                  ; ============================================================
  9829                                  ; Ports (primary ATA channel):
  9830                                  ;   0x1F0 data, 0x1F1 features/error, 0x1F2 sector count,
  9831                                  ;   0x1F3/4/5 LBA low/mid/high, 0x1F6 drive/head, 0x1F7 status/command.
  9832                                  ; No IRQs are used anywhere in this kernel, so these routines just
  9833                                  ; poll BSY/DRQ in the status register, matching the polled keyboard
  9834                                  ; driver's style.
  9835                                  
  9836                                  ; ata_wait_bsy: block until BSY (bit 7) clears, or give up after a timeout.
  9837                                  ; returns CF=0 on success, CF=1 on timeout (no device responding at all,
  9838                                  ; e.g. real hardware with no legacy IDE controller / booting off USB).
  9839                                  ATA_TIMEOUT equ 0x400000
  9840                                  ; ata_wait_bsy: block until BSY (bit 7) clears, or give up after a timeout.
  9841                                  ; returns CF=0 on success, CF=1 on timeout (no device responding at all,
  9842                                  ; e.g. real hardware with no legacy IDE controller / booting off USB).
  9843                                  ATA_TIMEOUT equ 0x400000
  9844                                  ata_wait_bsy:
  9845 0000884C 50                          push rax
  9846 0000884D 52                          push rdx
  9847 0000884E 51                          push rcx
  9848 0000884F B900004000                  mov rcx, ATA_TIMEOUT
  9849 00008854 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9850 0000885C 6683C207                    add dx, 7
  9851                                  .wait:
  9852 00008860 EC                          in al, dx
  9853 00008861 A880                        test al, 0x80
  9854 00008863 7407                        jz .ok
  9855 00008865 E2F9                        loop .wait
  9856 00008867 59                          pop rcx
  9857 00008868 5A                          pop rdx
  9858 00008869 58                          pop rax
  9859 0000886A F9                          stc
  9860 0000886B C3                          ret
  9861                                  .ok:
  9862 0000886C 59                          pop rcx
  9863 0000886D 5A                          pop rdx
  9864 0000886E 58                          pop rax
  9865 0000886F F8                          clc
  9866 00008870 C3                          ret
  9867                                  
  9868                                  ; ata_wait_drq: block until DRQ (bit 3) sets, or time out (see ata_wait_bsy)
  9869                                  ata_wait_drq:
  9870 00008871 50                          push rax
  9871 00008872 52                          push rdx
  9872 00008873 51                          push rcx
  9873 00008874 B900004000                  mov rcx, ATA_TIMEOUT
  9874 00008879 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9875 00008881 6683C207                    add dx, 7
  9876                                  .wait:
  9877 00008885 EC                          in al, dx
  9878 00008886 A808                        test al, 0x08
  9879 00008888 7507                        jnz .ok
  9880 0000888A E2F9                        loop .wait
  9881 0000888C 59                          pop rcx
  9882 0000888D 5A                          pop rdx
  9883 0000888E 58                          pop rax
  9884 0000888F F9                          stc
  9885 00008890 C3                          ret
  9886                                  .ok:
  9887 00008891 59                          pop rcx
  9888 00008892 5A                          pop rdx
  9889 00008893 58                          pop rax
  9890 00008894 F8                          clc
  9891 00008895 C3                          ret
  9892                                  
  9893                                  ; ata_select_device: al = device id (0=primary master, 1=primary slave,
  9894                                  ; 2=secondary master, 3=secondary slave). Picks the I/O port base and the
  9895                                  ; drive-select bit so every ATA routine below talks to the right drive.
  9896                                  ata_select_device:
  9897 00008896 50                          push rax
  9898 00008897 2403                        and al, 3
  9899 00008899 3C02                        cmp al, 2
  9900 0000889B 720E                        jb .primary
  9901 0000889D 66C70425[F0C90800]-         mov word [ata_port_base], 0x170
  9901 000088A5 7001               
  9902 000088A7 2C02                        sub al, 2
  9903 000088A9 EB0A                        jmp .drive
  9904                                  .primary:
  9905 000088AB 66C70425[F0C90800]-         mov word [ata_port_base], 0x1F0
  9905 000088B3 F001               
  9906                                  .drive:
  9907 000088B5 A801                        test al, 1
  9908 000088B7 750A                        jnz .slave
  9909 000088B9 C60425[F2C90800]E0          mov byte [ata_drive_sel], 0xE0
  9910 000088C1 EB08                        jmp .done
  9911                                  .slave:
  9912 000088C3 C60425[F2C90800]F0          mov byte [ata_drive_sel], 0xF0
  9913                                  .done:
  9914 000088CB 58                          pop rax
  9915 000088CC C3                          ret
  9916                                  
  9917                                  ; ata_read_sector: rax = LBA (28-bit), rdi = 512-byte destination buffer
  9918                                  ; returns CF=0 on success, CF=1 on failure/timeout (buffer left untouched
  9919                                  ; or partially written - caller should not trust it on failure).
  9920                                  ata_read_sector:
  9921 000088CD 50                          push rax
  9922 000088CE 53                          push rbx
  9923 000088CF 51                          push rcx
  9924 000088D0 52                          push rdx
  9925 000088D1 57                          push rdi
  9926 000088D2 4889C3                      mov rbx, rax                 ; keep LBA
  9927 000088D5 E872FFFFFF                  call ata_wait_bsy
  9928 000088DA 0F829B000000                jc .fail
  9929 000088E0 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9930 000088E8 6683C206                    add dx, 6
  9931 000088EC 4889D8                      mov rax, rbx
  9932 000088EF 48C1E818                    shr rax, 24
  9933 000088F3 240F                        and al, 0x0F
  9934 000088F5 0A0425[F2C90800]            or al, [ata_drive_sel]       ; LBA mode + master/slave bit
  9935 000088FC EE                          out dx, al
  9936 000088FD 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9937 00008905 6683C202                    add dx, 2
  9938 00008909 B001                        mov al, 1                    ; sector count = 1
  9939 0000890B EE                          out dx, al
  9940 0000890C 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9941 00008914 6683C203                    add dx, 3
  9942 00008918 88D8                        mov al, bl
  9943 0000891A EE                          out dx, al                   ; LBA[0:7]
  9944 0000891B 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9945 00008923 6683C204                    add dx, 4
  9946 00008927 4889D8                      mov rax, rbx
  9947 0000892A 48C1E808                    shr rax, 8
  9948 0000892E EE                          out dx, al                   ; LBA[8:15]
  9949 0000892F 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9950 00008937 6683C205                    add dx, 5
  9951 0000893B 4889D8                      mov rax, rbx
  9952 0000893E 48C1E810                    shr rax, 16
  9953 00008942 EE                          out dx, al                   ; LBA[16:23]
  9954 00008943 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9955 0000894B 6683C207                    add dx, 7
  9956 0000894F B020                        mov al, 0x20                 ; READ SECTORS (with retry)
  9957 00008951 EE                          out dx, al
  9958 00008952 E8F5FEFFFF                  call ata_wait_bsy
  9959 00008957 7222                        jc .fail
  9960 00008959 E813FFFFFF                  call ata_wait_drq
  9961 0000895E 721B                        jc .fail
  9962 00008960 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9963 00008968 B900010000                  mov rcx, 256                 ; 256 words = 512 bytes
  9964                                  .readloop:
  9965 0000896D 66ED                        in ax, dx
  9966 0000896F 668907                      mov [rdi], ax
  9967 00008972 4883C702                    add rdi, 2
  9968 00008976 E2F5                        loop .readloop
  9969 00008978 F8                          clc
  9970 00008979 EB01                        jmp .done
  9971                                  .fail:
  9972 0000897B F9                          stc
  9973                                  .done:
  9974 0000897C 5F                          pop rdi
  9975 0000897D 5A                          pop rdx
  9976 0000897E 59                          pop rcx
  9977 0000897F 5B                          pop rbx
  9978 00008980 58                          pop rax
  9979 00008981 C3                          ret
  9980                                  
  9981                                  ; ata_write_sector: rax = LBA (28-bit), rsi = 512-byte source buffer
  9982                                  ; returns CF=0 on success, CF=1 on failure/timeout.
  9983                                  ata_write_sector:
  9984 00008982 50                          push rax
  9985 00008983 53                          push rbx
  9986 00008984 51                          push rcx
  9987 00008985 52                          push rdx
  9988 00008986 56                          push rsi
  9989 00008987 4889C3                      mov rbx, rax
  9990 0000898A E8BDFEFFFF                  call ata_wait_bsy
  9991 0000898F 0F82B8000000                jc .fail
  9992 00008995 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
  9993 0000899D 6683C206                    add dx, 6
  9994 000089A1 4889D8                      mov rax, rbx
  9995 000089A4 48C1E818                    shr rax, 24
  9996 000089A8 240F                        and al, 0x0F
  9997 000089AA 0A0425[F2C90800]            or al, [ata_drive_sel]
  9998 000089B1 EE                          out dx, al
  9999 000089B2 0FB71425[F0C90800]          movzx edx, word [ata_port_base]
