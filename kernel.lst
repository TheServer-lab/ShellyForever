  6691                                  ;  DISK PERSISTENCE  (ATA PIO driver, primary bus, LBA28, polling)
  6692                                  ; ============================================================
  6693                                  ; Ports (primary ATA channel):
  6694                                  ;   0x1F0 data, 0x1F1 features/error, 0x1F2 sector count,
  6695                                  ;   0x1F3/4/5 LBA low/mid/high, 0x1F6 drive/head, 0x1F7 status/command.
  6696                                  ; No IRQs are used anywhere in this kernel, so these routines just
  6697                                  ; poll BSY/DRQ in the status register, matching the polled keyboard
  6698                                  ; driver's style.
  6699                                  
  6700                                  ; ata_wait_bsy: block until BSY (bit 7) clears, or give up after a timeout.
  6701                                  ; returns CF=0 on success, CF=1 on timeout (no device responding at all,
  6702                                  ; e.g. real hardware with no legacy IDE controller / booting off USB).
  6703                                  ATA_TIMEOUT equ 0x400000
  6704                                  ; ata_wait_bsy: block until BSY (bit 7) clears, or give up after a timeout.
  6705                                  ; returns CF=0 on success, CF=1 on timeout (no device responding at all,
  6706                                  ; e.g. real hardware with no legacy IDE controller / booting off USB).
  6707                                  ATA_TIMEOUT equ 0x400000
