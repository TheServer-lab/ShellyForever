 13335 00014755 EE                          out dx, al
 13336 00014756 66BAD403                    mov dx, 0x3D4
 13337 0001475A B00E                        mov al, 0x0E
 13338 0001475C EE                          out dx, al
 13339 0001475D 66BAD503                    mov dx, 0x3D5
