  1616                                  ; ------------------------------------------------------------
  1617                                  ; cmd_edit: opens the built-in editor on an existing file. Edits a copy of
  1618                                  ; the file's content in place (typed chars/Enter insert at the cursor,
  1619                                  ; Backspace/Delete remove around it, Left/Right/Home/End move it - all
  1620                                  ; newline-aware), ESC ends editing and asks whether to save (y) or
  1621                                  ; discard (n).
  1622                                  ;
  1623                                  ; Loop state (kept in registers across the whole edit session, same
  1624                                  ; convention as cur_dir-style code elsewhere - callees here are all
  1625                                  ; expected to preserve r12-r15):
  1626                                  ;   r15 = node id being edited
  1627                                  ;   r14 = content length (bytes used in fs_io_buf)
  1628                                  ;   r13 = cursor index into fs_io_buf (0..r14)
  1629                                  ;   r12 = "top row" - the 0-based row number (counting both embedded
  1630                                  ;         newlines and 80-col wraps from the start of the buffer) that
  1631                                  ;         .ce_render currently shows at the top of the scrollable body.
  1632                                  ;
  1633                                  ; Unlike read_line (which only ever holds one un-wrapped line, so it can
  1634                                  ; patch the screen in place with cursor_step_left/right), fs_io_buf here
  1635                                  ; contains real embedded newlines, and putchar forces column->0 on those
  1636                                  ; regardless of the current column - so column-wrap-only cursor stepping
  1637                                  ; would desync from the real screen layout on any line short of 80 cols.
  1638                                  ; Simpler and robust: every navigation or edit fully redraws the visible
  1639                                  ; page from a recomputed buffer offset (.ce_render below), rather than
  1640                                  ; trying to patch deltas.
  1641                                  cmd_edit:
  1642 00011400 803C25[B8E60600]00          cmp byte [arg1_buf], 0
  1643 00011408 7512                        jne .ce_have_arg
