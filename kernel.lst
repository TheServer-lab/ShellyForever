 12247 00019C3E 4C0FB61425-                 movzx r10, byte [nic_arp_next]
 12247 00019C43 [05E90500]         
 12248 00019C47 49FFC2                      inc r10
 12249 00019C4A 44881425[05E90500]          mov [nic_arp_next], r10b
 12250                                  .learn_hit:
