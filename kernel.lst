 14909 0000BAEB 740E                        je .vg_notfound
 14910 0000BAED 4989C1                      mov r9, rax
 14911 0000BAF0 4A8B04CD[C83D0A00]          mov rax, [var_value + r9*8]
 14912 0000BAF8 B101                        mov cl, 1
 14913 0000BAFA C3                          ret
 14914                                  .vg_notfound:
 14915 0000BAFB 4831C0                      xor rax, rax
 14916 0000BAFE B100                        mov cl, 0
 14917 0000BB00 C3                          ret
 14918                                  
 14919                                  ; var_set: rsi=name, rbx=value(int64). Creates the variable if it
 14920                                  ; doesn't exist yet, otherwise updates it in place. Silently does
 14921                                  ; nothing if the table is full (MAX_VARS reached).
 14922                                  var_set:
 14923 0000BB01 50                          push rax
 14924 0000BB02 51                          push rcx
 14925 0000BB03 52                          push rdx
 14926 0000BB04 57                          push rdi
 14927 0000BB05 56                          push rsi
 14928 0000BB06 53                          push rbx
 14929 0000BB07 E88FFFFFFF                  call var_find
 14930 0000BB0C 5B                          pop rbx
 14931 0000BB0D 5E                          pop rsi
 14932 0000BB0E 4883F8FF                    cmp rax, -1
 14933 0000BB12 7536                        jne .vs_have
 14934 0000BB14 4831C9                      xor rcx, rcx
 14935                                  .vs_free:
 14936 0000BB17 4883F910                    cmp rcx, MAX_VARS
 14937 0000BB1B 7335                        jae .vs_full
 14938 0000BB1D 80B9[483E0A00]00            cmp byte [var_used+rcx], 0
 14939 0000BB24 7405                        je .vs_got
 14940 0000BB26 48FFC1                      inc rcx
 14941 0000BB29 EBEC                        jmp .vs_free
 14942                                  .vs_got:
 14943 0000BB2B C681[483E0A00]01            mov byte [var_used+rcx], 1
 14944 0000BB32 4889CF                      mov rdi, rcx
 14945 0000BB35 486BFF20                    imul rdi, VAR_NAME_LEN
 14946 0000BB39 488DBF[C83B0A00]            lea rdi, [var_name+rdi]
 14947 0000BB40 E8F04F0600                  call str_copy
 14948 0000BB45 4889C8                      mov rax, rcx
 14949 0000BB48 EB00                        jmp .vs_setval
 14950                                  .vs_have:
 14951                                  .vs_setval:
 14952 0000BB4A 48891CC5[C83D0A00]          mov [var_value + rax*8], rbx
 14953                                  .vs_full:
 14954 0000BB52 5F                          pop rdi
 14955 0000BB53 5A                          pop rdx
 14956 0000BB54 59                          pop rcx
 14957 0000BB55 58                          pop rax
 14958 0000BB56 C3                          ret
 14959                                  
 14960                                  ; parse_int: rsi=null-terminated string -> rax=value(int64), cl=1 if the
 14961                                  ; whole string was a valid (optionally negative) decimal integer, else
 14962                                  ; cl=0. Does not preserve rcx (used to return the flag in cl).
 14963                                  parse_int:
 14964 0000BB57 53                          push rbx
 14965 0000BB58 52                          push rdx
 14966 0000BB59 4150                        push r8
 14967 0000BB5B 4151                        push r9
