  9386                                  ; ahci_read_sector / ahci_write_sector: same calling convention as their
  9387                                  ; ata_* counterparts (rax=LBA, rdi=dest / rsi=src, CF=0/1 on return), for
  9388                                  ; whichever port [ahci_cur_slot] currently names. They just set which ATA
  9389                                  ; command to send and which direction the data goes, then share the actual
  9390                                  ; command-submission logic in ahci_rw_common below.
  9391                                  ahci_read_sector:
  9392 00017E88 C60425[AAE80500]25          mov byte [ahci_op_cmd], 0x25    ; READ DMA EXT
  9393 00017E90 C60425[ABE80500]00          mov byte [ahci_op_write], 0
  9394 00017E98 EB15                        jmp ahci_rw_common
  9395                                  
  9396                                  ahci_write_sector:
  9397 00017E9A C60425[AAE80500]35          mov byte [ahci_op_cmd], 0x35    ; WRITE DMA EXT
  9398 00017EA2 C60425[ABE80500]01          mov byte [ahci_op_write], 1
  9399 00017EAA 4889F7                      mov rdi, rsi                    ; unify on rdi as "the buffer" below
  9400 00017EAD EB00                        jmp ahci_rw_common
  9401                                  
  9402                                  ; ahci_rw_common: rax=LBA, rdi=buffer, using [ahci_op_cmd]/[ahci_op_write]
  9403                                  ; set by the caller above. Builds one command (command-list entry 0, its
  9404                                  ; command table, and a Register H2D FIS) for a single 512-byte sector
  9405                                  ; transfer, issues it, and polls PxCI until it clears (or times out).
  9406                                  ; Returns CF=0 on success, CF=1 on failure/timeout.
  9407                                  ahci_rw_common:
  9408 00017EAF 50                          push rax
  9409 00017EB0 53                          push rbx
  9410 00017EB1 51                          push rcx
  9411 00017EB2 52                          push rdx
  9412 00017EB3 56                          push rsi
  9413 00017EB4 57                          push rdi
  9414 00017EB5 4150                        push r8
  9415 00017EB7 4151                        push r9
  9416 00017EB9 4152                        push r10
  9417 00017EBB 4154                        push r12
  9418 00017EBD 4155                        push r13
  9419 00017EBF 4156                        push r14
  9420 00017EC1 4157                        push r15
  9421                                  
  9422 00017EC3 4989C4                      mov r12, rax                  ; r12 = LBA
  9423 00017EC6 4989FD                      mov r13, rdi                  ; r13 = buffer pointer
  9424                                  
  9425 00017EC9 440FB63425-                 movzx r14d, byte [ahci_cur_slot]
  9425 00017ECE [A9E80500]         
  9426 00017ED2 4C89F0                      mov rax, r14
  9427 00017ED5 486BC008                    imul rax, 8
  9428 00017ED9 4C8BB8[88E80500]            mov r15, [ahci_port_base + rax]   ; r15 = this port's register base
  9429                                  
  9430 00017EE0 4C89F0                      mov rax, r14
  9431 00017EE3 4869C000040000              imul rax, 1024
  9432 00017EEA 4C8D80[00CC0600]            lea r8, [ahci_clb + rax]      ; r8 = this port's command list (entry 0)
  9433                                  
  9434 00017EF1 31C0                        xor eax, eax
  9435 00017EF3 B005                        mov al, 5                     ; CFL = 5 DWORDS (20-byte Reg H2D FIS)
  9436 00017EF5 803C25[ABE80500]00          cmp byte [ahci_op_write], 0
  9437 00017EFD 7403                        je .no_w
  9438 00017EFF 83C840                      or eax, 0x40                  ; W bit - this is a write
  9439                                  .no_w:
  9440 00017F02 0D00000100                  or eax, (1 << 16)             ; PRDTL = 1 (one PRDT entry)
  9441 00017F07 418900                      mov [r8], eax
  9442 00017F0A 41C7400400000000            mov dword [r8 + 4], 0         ; PRDBC, cleared before each command
  9443                                  
  9444 00017F12 4C89F0                      mov rax, r14
  9445 00017F15 4869C000010000              imul rax, 256
  9446 00017F1C 4C8D88[00E00600]            lea r9, [ahci_cmdtbl + rax]   ; r9 = this port's command table
  9447 00017F23 45894808                    mov [r8 + 8], r9d             ; CTBA
  9448 00017F27 41C7400C00000000            mov dword [r8 + 12], 0        ; CTBAU
  9449                                  
  9450                                      ; zero the command table's FIS area (first 64 bytes) before building it
  9451 00017F2F 57                          push rdi
  9452 00017F30 4C89CF                      mov rdi, r9
  9453 00017F33 31C0                        xor eax, eax
  9454 00017F35 B908000000                  mov rcx, 8
  9455 00017F3A F348AB                      rep stosq
  9456 00017F3D 5F                          pop rdi
