  5403 00014FC7 E8407A0100                  call print_string_attr
  5404 00014FCC E876010000                  call acpi_shutdown            ; if this works, we never come back
  5405 00014FD1 66BA0406                    mov dx, 0x604                ; QEMU (older versions) ACPI PM control
  5406 00014FD5 66B80020                    mov ax, 0x2000
  5407 00014FD9 66EF                        out dx, ax
  5408 00014FDB 66BA04B0                    mov dx, 0xB004                ; Bochs / very old QEMU
  5409 00014FDF 66B80020                    mov ax, 0x2000
  5410 00014FE3 66EF                        out dx, ax
  5411 00014FE5 66BA0440                    mov dx, 0x4004                ; VirtualBox
  5412 00014FE9 66B80034                    mov ax, 0x3400
  5413 00014FED 66EF                        out dx, ax
  5414                                  .hang:
  5415 00014FEF FA                          cli
  5416 00014FF0 F4                          hlt
  5417 00014FF1 EBFC                        jmp .hang
