 13206                                  ; ============================================================
 13207                                  ;  SCROLLBACK VIEW (Ctrl+Up / Ctrl+Down)
 13208                                  ; ============================================================
 13209                                  ; All of these routines save/restore every register they use, so they are
 13210                                  ; safe to call from anywhere inside get_char without disturbing a caller
 13211                                  ; like read_line that keeps its own state (buffer ptr/length/max) in
 13212                                  ; r8/r9/r10 across get_char calls.
 13213                                  
 13214                                  ; scrollback_capture_row: archives the current row 0 (about to be shifted
 13215                                  ; off by scroll_screen) into the scrollback ring buffer.
 13216                                  scrollback_capture_row:
 13217 00014614 50                          push rax
 13218 00014615 51                          push rcx
 13219 00014616 56                          push rsi
 13220 00014617 57                          push rdi
 13221                                  
 13222 00014618 480FB60425-                 movzx rax, byte [sb_write_idx]
 13222 0001461D [484D0100]         
 13223 00014621 4869C0A0000000              imul rax, VGA_COLS*2
 13224 00014628 488DB8[504D0100]            lea rdi, [scrollback_buf + rax]
 13225 0001462F BE00800B00                  mov rsi, VGA_BASE
 13226 00014634 B9A0000000                  mov rcx, VGA_COLS*2
 13227 00014639 F3A4                        rep movsb
 13228                                  
 13229 0001463B 480FB60425-                 movzx rax, byte [sb_write_idx]
 13229 00014640 [484D0100]         
