 16131                                  ; ============================================================
 16132                                  ;  VGA TEXT OUTPUT
 16133                                  ; ============================================================
 16134                                  clear_screen:
 16135 00070B85 50                          push rax
 16136 00070B86 51                          push rcx
 16137 00070B87 57                          push rdi
 16138 00070B88 E899FEFEFF                  call mouse_hide
 16139 00070B8D E88501FFFF                  call mouse_sel_clear
 16140 00070B92 BF00800B00                  mov rdi, VGA_BASE
 16141 00070B97 B9D0070000                  mov rcx, VGA_COLS*VGA_ROWS
 16142 00070B9C 66B82007                    mov ax, 0x0720           ; space, light grey
 16143                                  .loop:
 16144 00070BA0 668907                      mov [rdi], ax
 16145 00070BA3 4883C702                    add rdi, 2
 16146 00070BA7 E2F7                        loop .loop
 16147 00070BA9 C60425[181A0700]00          mov byte [cursor_row], 0
 16148 00070BB1 C60425[191A0700]00          mov byte [cursor_col], 0
 16149 00070BB9 E809000000                  call update_cursor
 16150 00070BBE E896FEFEFF                  call mouse_show
 16151 00070BC3 5F                          pop rdi
 16152 00070BC4 59                          pop rcx
 16153 00070BC5 58                          pop rax
 16154 00070BC6 C3                          ret
 16155                                  
 16156                                  ; update_cursor: programs the VGA CRTC hardware cursor (the blinking block)
 16157                                  ; to match cursor_row/cursor_col, via the index/data port pair 0x3D4/0x3D5.
 16158                                  ; Without this the blinking cursor never moves from wherever the BIOS left
 16159                                  ; it, even though text is being printed elsewhere.
 16160                                  update_cursor:
 16161 00070BC7 50                          push rax
 16162 00070BC8 51                          push rcx
 16163 00070BC9 52                          push rdx
 16164 00070BCA 480FB60C25-                 movzx rcx, byte [cursor_row]
 16164 00070BCF [181A0700]         
 16165 00070BD3 486BC950                    imul rcx, VGA_COLS
 16166 00070BD7 480FB61425-                 movzx rdx, byte [cursor_col]
 16166 00070BDC [191A0700]         
 16167 00070BE0 4801D1                      add rcx, rdx                 ; rcx = linear cursor position
 16168                                  
 16169 00070BE3 66BAD403                    mov dx, 0x3D4
