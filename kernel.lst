  5904 000154C3 488B0425[BBD70200]          mov rax, [cur_dir]
  5905 000154CB 48BE-                       mov rsi, arg1_buf
  5905 000154CD [B8E6060000000000] 
  5906 000154D5 48BF-                       mov rdi, leaf1_buf
  5906 000154D7 [60E4060000000000] 
  5907 000154DF E8C1220000                  call fs_resolve_path
  5908 000154E4 4883F8FF                    cmp rax, -1
  5909 000154E8 0F848B000000                je .not_found
  5910 000154EE 4989C5                      mov r13, rax                ; folder the source lives in
  5911 000154F1 4C89E8                      mov rax, r13
  5912 000154F4 48BE-                       mov rsi, leaf1_buf
