   326 00000204 48BF-                       mov rdi, line_buf
   326 00000206 [E0B8010000000000] 
   327                                  .rr_chain_copy:
   328 0000020E 8A06                        mov al, [rsi]
   329 00000210 3C3B                        cmp al, ';'
   330 00000212 740E                        je .rr_chain_copy_done
   331 00000214 84C0                        test al, al
   332 00000216 740A                        je .rr_chain_copy_done
   333 00000218 8807                        mov [rdi], al
   334 0000021A 48FFC7                      inc rdi
   335 0000021D 48FFC6                      inc rsi
   336 00000220 EBEC                        jmp .rr_chain_copy
   337                                  .rr_chain_copy_done:
