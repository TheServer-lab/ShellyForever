 14288                                  
 14289                                  ; ============================================================
 14290                                  ;  RTC / CMOS CLOCK  (date, time, wig time)
 14291                                  ; ============================================================
 14292                                  ; The MC146818 real-time clock chip is addressed through port 0x70
 14293                                  ; (register index, bit 7 disables NMIs while set) and 0x71 (data).
 14294                                  ; All values come back BCD-encoded unless status register B's binary
 14295                                  ; bit is set, and hours may be 12-hour mode - rtc_update normalizes
 14296                                  ; everything to plain 24-hour binary before storing it.
 14297                                  
 14298                                  ; cmos_read: al = register index (0..0x3F) -> al = that register's value.
 14299                                  cmos_read:
 14300 0001B03E 52                          push rdx
 14301 0001B03F 0C80                        or al, 0x80                 ; set NMI-disable bit while selecting
 14302 0001B041 66BA7000                    mov dx, 0x70
 14303 0001B045 EE                          out dx, al
 14304                                      ; tiny I/O delay so the RTC latches the address before the data read
 14305 0001B046 50                          push rax
 14306 0001B047 B000                        mov al, 0
 14307 0001B049 E680                        out 0x80, al                ; write to the unused POST port = short pause
 14308 0001B04B 58                          pop rax
 14309 0001B04C 66BA7100                    mov dx, 0x71
 14310 0001B050 EC                          in al, dx
 14311 0001B051 5A                          pop rdx
 14312 0001B052 C3                          ret
 14313                                  
 14314                                  ; rtc_wait_uip: waits until the RTC's Update-In-Progress flag (status A,
 14315                                  ; bit 7) clears, so the registers read below are internally consistent.
 14316                                  rtc_wait_uip:
 14317 0001B053 50                          push rax
 14318                                  .uip_wait:
 14319 0001B054 B00A                        mov al, 0x0A
 14320 0001B056 E8E3FFFFFF                  call cmos_read
 14321 0001B05B A880                        test al, 0x80
 14322 0001B05D 75F5                        jnz .uip_wait
 14323 0001B05F 58                          pop rax
 14324 0001B060 C3                          ret
 14325                                  
 14326                                  ; bcd_to_bin: al = BCD byte -> al = binary value. Preserves other regs.
 14327                                  bcd_to_bin:
 14328 0001B061 53                          push rbx
 14329 0001B062 51                          push rcx
 14330 0001B063 52                          push rdx
 14331 0001B064 480FB6D8                    movzx rbx, al
 14332 0001B068 88D8                        mov al, bl
 14333 0001B06A C0E804                      shr al, 4
 14334 0001B06D 480FB6C8                    movzx rcx, al
 14335 0001B071 486BC90A                    imul rcx, 10
 14336 0001B075 88D8                        mov al, bl
 14337 0001B077 240F                        and al, 0x0F
 14338 0001B079 480FB6D0                    movzx rdx, al
 14339 0001B07D 4801D1                      add rcx, rdx
 14340 0001B080 4889C8                      mov rax, rcx
 14341 0001B083 5A                          pop rdx
 14342 0001B084 59                          pop rcx
 14343 0001B085 5B                          pop rbx
 14344 0001B086 C3                          ret
 14345                                  
 14346                                  ; rtc_update: reads seconds/minutes/hours/day/month/year (+ century, if the
 14347                                  ; chip provides one) into the rtc_* variables, normalized to 24-hour binary.
 14348                                  rtc_update:
 14349 0001B087 50                          push rax
 14350 0001B088 53                          push rbx
 14351 0001B089 E8C5FFFFFF                  call rtc_wait_uip
 14352 0001B08E B000                        mov al, 0x00
 14353 0001B090 E8A9FFFFFF                  call cmos_read
 14354 0001B095 880425[04380300]            mov [rtc_sec], al
 14355 0001B09C B002                        mov al, 0x02
 14356 0001B09E E89BFFFFFF                  call cmos_read
 14357 0001B0A3 880425[05380300]            mov [rtc_min], al
 14358 0001B0AA B004                        mov al, 0x04
 14359 0001B0AC E88DFFFFFF                  call cmos_read
 14360 0001B0B1 880425[06380300]            mov [rtc_hour], al
 14361 0001B0B8 B007                        mov al, 0x07
 14362 0001B0BA E87FFFFFFF                  call cmos_read
 14363 0001B0BF 880425[07380300]            mov [rtc_day], al
 14364 0001B0C6 B008                        mov al, 0x08
 14365 0001B0C8 E871FFFFFF                  call cmos_read
 14366 0001B0CD 880425[08380300]            mov [rtc_month], al
 14367 0001B0D4 B009                        mov al, 0x09
 14368 0001B0D6 E863FFFFFF                  call cmos_read
 14369 0001B0DB 880425[09380300]            mov [rtc_year], al
 14370 0001B0E2 B032                        mov al, 0x32
 14371 0001B0E4 E855FFFFFF                  call cmos_read
 14372 0001B0E9 880425[0A380300]            mov [rtc_century], al
 14373 0001B0F0 B00B                        mov al, 0x0B
 14374 0001B0F2 E847FFFFFF                  call cmos_read
 14375 0001B0F7 88C3                        mov bl, al                     ; status register B
 14376                                      ; BCD? (status B bit 2). If clear, values are already binary.
 14377 0001B0F9 F6C304                      test bl, 0x04
 14378 0001B0FC 0F8485000000                jz .rtc_no_bcd
 14379 0001B102 8A0425[04380300]            mov al, [rtc_sec]
 14380 0001B109 E853FFFFFF                  call bcd_to_bin
 14381 0001B10E 880425[04380300]            mov [rtc_sec], al
 14382 0001B115 8A0425[05380300]            mov al, [rtc_min]
 14383 0001B11C E840FFFFFF                  call bcd_to_bin
 14384 0001B121 880425[05380300]            mov [rtc_min], al
 14385 0001B128 8A0425[06380300]            mov al, [rtc_hour]
 14386 0001B12F E82DFFFFFF                  call bcd_to_bin
 14387 0001B134 880425[06380300]            mov [rtc_hour], al
 14388 0001B13B 8A0425[07380300]            mov al, [rtc_day]
 14389 0001B142 E81AFFFFFF                  call bcd_to_bin
 14390 0001B147 880425[07380300]            mov [rtc_day], al
 14391 0001B14E 8A0425[08380300]            mov al, [rtc_month]
 14392 0001B155 E807FFFFFF                  call bcd_to_bin
 14393 0001B15A 880425[08380300]            mov [rtc_month], al
 14394 0001B161 8A0425[09380300]            mov al, [rtc_year]
 14395 0001B168 E8F4FEFFFF                  call bcd_to_bin
 14396 0001B16D 880425[09380300]            mov [rtc_year], al
 14397 0001B174 8A0425[0A380300]            mov al, [rtc_century]
 14398 0001B17B E8E1FEFFFF                  call bcd_to_bin
 14399 0001B180 880425[0A380300]            mov [rtc_century], al
 14400                                  .rtc_no_bcd:
 14401                                      ; 12-hour mode? (status B bit 1). If set, hour's bit 7 = PM.
 14402 0001B187 F6C302                      test bl, 0x02
 14403 0001B18A 7425                        jz .rtc_done
 14404 0001B18C 8A0425[06380300]            mov al, [rtc_hour]
 14405 0001B193 88C4                        mov ah, al
 14406 0001B195 247F                        and al, 0x7F                  ; hour value 1..12
 14407 0001B197 F6C480                      test ah, 0x80                 ; PM?
 14408 0001B19A 7408                        jz .rtc_am
 14409 0001B19C 3C0C                        cmp al, 12
 14410 0001B19E 730A                        jae .rtc_h12                  ; 12 PM stays 12
 14411 0001B1A0 040C                        add al, 12
 14412 0001B1A2 EB06                        jmp .rtc_h12
 14413                                  .rtc_am:
 14414 0001B1A4 3C0C                        cmp al, 12
 14415 0001B1A6 7502                        jne .rtc_h12
 14416 0001B1A8 30C0                        xor al, al                    ; 12 AM = 00
 14417                                  .rtc_h12:
 14418 0001B1AA 880425[06380300]            mov [rtc_hour], al
 14419                                  .rtc_done:
 14420 0001B1B1 5B                          pop rbx
 14421 0001B1B2 58                          pop rax
 14422 0001B1B3 C3                          ret
 14423                                  
 14424                                  ; format_num2: rax = 0..99 -> two zero-padded digits written to [rdi], rdi
 14425                                  ; advances by 2. Preserves rax/rbx/rcx/rdx.
 14426                                  format_num2:
 14427 0001B1B4 50                          push rax
 14428 0001B1B5 53                          push rbx
 14429 0001B1B6 51                          push rcx
 14430 0001B1B7 52                          push rdx
 14431 0001B1B8 4831D2                      xor rdx, rdx
 14432 0001B1BB BB0A000000                  mov rbx, 10
 14433 0001B1C0 48F7F3                      div rbx                       ; rax = tens, rdx = ones
 14434 0001B1C3 0430                        add al, '0'
 14435 0001B1C5 8807                        mov [rdi], al
 14436 0001B1C7 48FFC7                      inc rdi
 14437 0001B1CA 88D0                        mov al, dl
 14438 0001B1CC 0430                        add al, '0'
 14439 0001B1CE 8807                        mov [rdi], al
 14440 0001B1D0 48FFC7                      inc rdi
 14441 0001B1D3 5A                          pop rdx
 14442 0001B1D4 59                          pop rcx
 14443 0001B1D5 5B                          pop rbx
 14444 0001B1D6 58                          pop rax
 14445 0001B1D7 C3                          ret
 14446                                  
 14447                                  ; format_num4: rax = 0..9999 -> four zero-padded digits written to [rdi],
 14448                                  ; rdi advances by 4. Preserves rax/rbx/rcx/rdx.
 14449                                  format_num4:
 14450 0001B1D8 50                          push rax
 14451 0001B1D9 53                          push rbx
 14452 0001B1DA 51                          push rcx
 14453 0001B1DB 52                          push rdx
 14454 0001B1DC 4831D2                      xor rdx, rdx
 14455 0001B1DF BBE8030000                  mov rbx, 1000
 14456 0001B1E4 48F7F3                      div rbx                       ; rax = thousands, rdx = remainder
 14457 0001B1E7 52                          push rdx
 14458 0001B1E8 0430                        add al, '0'
 14459 0001B1EA 8807                        mov [rdi], al
 14460 0001B1EC 48FFC7                      inc rdi
 14461 0001B1EF 58                          pop rax
 14462 0001B1F0 4831D2                      xor rdx, rdx
 14463 0001B1F3 BB64000000                  mov rbx, 100
 14464 0001B1F8 48F7F3                      div rbx                       ; rax = hundreds, rdx = remainder
 14465 0001B1FB 52                          push rdx
 14466 0001B1FC 0430                        add al, '0'
 14467 0001B1FE 8807                        mov [rdi], al
 14468 0001B200 48FFC7                      inc rdi
 14469 0001B203 58                          pop rax
 14470 0001B204 4831D2                      xor rdx, rdx
 14471 0001B207 BB0A000000                  mov rbx, 10
 14472 0001B20C 48F7F3                      div rbx                       ; rax = tens, rdx = ones
 14473 0001B20F 0430                        add al, '0'
 14474 0001B211 8807                        mov [rdi], al
 14475 0001B213 48FFC7                      inc rdi
 14476 0001B216 88D0                        mov al, dl
 14477 0001B218 0430                        add al, '0'
 14478 0001B21A 8807                        mov [rdi], al
 14479 0001B21C 48FFC7                      inc rdi
 14480 0001B21F 5A                          pop rdx
 14481 0001B220 59                          pop rcx
 14482 0001B221 5B                          pop rbx
 14483 0001B222 58                          pop rax
 14484 0001B223 C3                          ret
 14485                                  
 14486                                  ; format_time: writes "HH:MM:SS\0" to [rdi], rdi advances to the terminator.
 14487                                  ; Preserves everything except rdi.
 14488                                  format_time:
 14489 0001B224 50                          push rax
 14490 0001B225 E85DFEFFFF                  call rtc_update
 14491 0001B22A 480FB60425-                 movzx rax, byte [rtc_hour]
 14491 0001B22F [06380300]         
 14492 0001B233 E87CFFFFFF                  call format_num2
 14493 0001B238 C6073A                      mov byte [rdi], ':'
 14494 0001B23B 48FFC7                      inc rdi
 14495 0001B23E 480FB60425-                 movzx rax, byte [rtc_min]
 14495 0001B243 [05380300]         
 14496 0001B247 E868FFFFFF                  call format_num2
 14497 0001B24C C6073A                      mov byte [rdi], ':'
 14498 0001B24F 48FFC7                      inc rdi
 14499 0001B252 480FB60425-                 movzx rax, byte [rtc_sec]
 14499 0001B257 [04380300]         
 14500 0001B25B E854FFFFFF                  call format_num2
 14501 0001B260 C60700                      mov byte [rdi], 0
 14502 0001B263 58                          pop rax
 14503 0001B264 C3                          ret
 14504                                  
 14505                                  ; format_date: writes "YYYY-MM-DD\0" to [rdi], rdi advances to the
 14506                                  ; terminator. Preserves everything except rdi.
 14507                                  format_date:
 14508 0001B265 50                          push rax
 14509 0001B266 53                          push rbx
 14510 0001B267 E81BFEFFFF                  call rtc_update
 14511                                      ; full year = century*100 + year; fall back to the 2000s when the
 14512                                      ; chip has no century register (or it reports something unusable).
 14513 0001B26C 480FB60425-                 movzx rax, byte [rtc_century]
 14513 0001B271 [0A380300]         
 14514 0001B275 3C14                        cmp al, 20
 14515 0001B277 7406                        je .fd_cent_ok
 14516 0001B279 3C15                        cmp al, 21
 14517 0001B27B 7402                        je .fd_cent_ok
 14518 0001B27D B014                        mov al, 20
 14519                                  .fd_cent_ok:
 14520 0001B27F 486BC064                    imul rax, 100
 14521 0001B283 480FB61C25-                 movzx rbx, byte [rtc_year]
 14521 0001B288 [09380300]         
 14522 0001B28C 4801D8                      add rax, rbx
 14523 0001B28F E844FFFFFF                  call format_num4
 14524 0001B294 C6072D                      mov byte [rdi], '-'
 14525 0001B297 48FFC7                      inc rdi
 14526 0001B29A 480FB60425-                 movzx rax, byte [rtc_month]
 14526 0001B29F [08380300]         
 14527 0001B2A3 E80CFFFFFF                  call format_num2
 14528 0001B2A8 C6072D                      mov byte [rdi], '-'
 14529 0001B2AB 48FFC7                      inc rdi
 14530 0001B2AE 480FB60425-                 movzx rax, byte [rtc_day]
 14530 0001B2B3 [07380300]         
 14531 0001B2B7 E8F8FEFFFF                  call format_num2
 14532 0001B2BC C60700                      mov byte [rdi], 0
 14533 0001B2BF 5B                          pop rbx
 14534 0001B2C0 58                          pop rax
 14535 0001B2C1 C3                          ret
 14536                                  
 14537                                  ; ------------------------------------------------------------
 14538                                  ; cmd_date / cmd_time: print the current date / time from the RTC.
 14539                                  ; ------------------------------------------------------------
 14540                                  cmd_date:
 14541 0001B2C2 488D3C25[1B380300]          lea rdi, [date_str_buf]
 14542 0001B2CA E896FFFFFF                  call format_date
 14543 0001B2CF 48BE-                       mov rsi, date_str_buf
 14543 0001B2D1 [1B38030000000000] 
 14544 0001B2D9 8A0425[C4D70200]            mov al, [cur_normal_attr]
 14545 0001B2E0 E827170100                  call print_string_attr
 14546 0001B2E5 48BE-                       mov rsi, newline_str
 14546 0001B2E7 [B238030000000000] 
 14547 0001B2EF E809170100                  call print_string
 14548 0001B2F4 C3                          ret
 14549                                  
 14550                                  cmd_time:
 14551 0001B2F5 488D3C25[0B380300]          lea rdi, [time_str_buf]
 14552 0001B2FD E822FFFFFF                  call format_time
 14553 0001B302 48BE-                       mov rsi, time_str_buf
 14553 0001B304 [0B38030000000000] 
 14554 0001B30C 8A0425[C4D70200]            mov al, [cur_normal_attr]
 14555 0001B313 E8F4160100                  call print_string_attr
 14556 0001B318 48BE-                       mov rsi, newline_str
 14556 0001B31A [B238030000000000] 
 14557 0001B322 E8D6160100                  call print_string
 14558 0001B327 C3                          ret
 14559                                  
 14560                                  ; ------------------------------------------------------------
 14561                                  ; cmd_write: write <path> <content> creates the file (or overwrites an
 14562                                  ; existing file's content). It's meant to be used through a "~" pipe -
 14563                                  ; "show hi ~ write file.txt" writes "hi" to file.txt - but also works
 14564                                  ; standalone: write file.txt "some text".
 14565                                  ; ------------------------------------------------------------
 14566                                  cmd_write:
