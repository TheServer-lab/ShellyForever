  6599                              <1> ; ------------------------------------------------------------
  6600                              <1> ; party_emit_lit_display: emits one compiled "display <literal>"
  6601                              <1> ; sequence (print text, then newline) into the .run code buffer,
  6602                              <1> ; followed by the literal's text itself.
  6603                              <1> ; In:  rdi = output cursor into party_run_bin_buf (the live codegen
  6604                              <1> ;            cursor - callers keep using rdi after this returns)
  6605                              <1> ;      rsi = pointer to the literal's raw text (no quotes, no minus)
  6606                              <1> ;      rcx = length of that text
  6607                              <1> ;      r11 = 1 to prepend a literal '-' before the text, 0 otherwise
  6608                              <1> ; Out: rdi advanced past the emitted instructions + text + NUL.
  6609                              <1> ; Clobbers: rax, rsi, rcx.
  6610                              <1> ; ------------------------------------------------------------
  6611                              <1> party_emit_lit_display:
  6612                              <1>     ; LEA RSI, [RIP+disp]   (runtime instruction, being written here)
  6613                              <1>     ; disp must land exactly on the text bytes that follow the fixed
  6614                              <1>     ; 15-byte call/mov/call/jmp tail below (3+4+3+5), plus 1 more byte if
  6615                              <1>     ; a '-' is going to be written before the text.
  6616 00036BD7 C60748              <1>     mov byte [rdi], 0x48
  6617 00036BDA C647018D            <1>     mov byte [rdi+1], 0x8D
  6618 00036BDE C6470235            <1>     mov byte [rdi+2], 0x35
  6619 00036BE2 B80F000000          <1>     mov eax, 15                   ; was 10 - grew by 5 for the JMP added below
  6620 00036BE7 4983FB01            <1>     cmp r11, 1
  6621 00036BEB 7502                <1>     jne .eld_disp_set
  6622 00036BED FFC0                <1>     inc eax
  6623                              <1> .eld_disp_set:
  6624 00036BEF 894703              <1>     mov [rdi+3], eax
  6625 00036BF2 4883C707            <1>     add rdi, 7
  6626                              <1> 
  6627 00036BF6 C607FF              <1>     mov byte [rdi], 0xFF          ; call [table+0]  -> kernel print_string
  6628 00036BF9 C6470157            <1>     mov byte [rdi+1], 0x57
  6629 00036BFD C6470200            <1>     mov byte [rdi+2], 0x00
  6630 00036C01 4883C703            <1>     add rdi, 3
  6631                              <1> 
  6632 00036C05 C60748              <1>     mov byte [rdi], 0x48          ; mov rsi, [table+0x18] -> newline_str
