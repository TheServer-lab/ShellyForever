  7126                                  ; ============================================================
  7127                                  ;  RTC / CMOS CLOCK  (date, time, wig time)
  7128                                  ; ============================================================
  7129                                  ; The MC146818 real-time clock chip is addressed through port 0x70
  7130                                  ; (register index, bit 7 disables NMIs while set) and 0x71 (data).
  7131                                  ; All values come back BCD-encoded unless status register B's binary
  7132                                  ; bit is set, and hours may be 12-hour mode - rtc_update normalizes
  7133                                  ; everything to plain 24-hour binary before storing it.
  7134                                  
  7135                                  ; cmos_read: al = register index (0..0x3F) -> al = that register's value.
  7136                                  cmos_read:
  7137 00005CBF 52                          push rdx
  7138 00005CC0 0C80                        or al, 0x80                 ; set NMI-disable bit while selecting
  7139 00005CC2 66BA7000                    mov dx, 0x70
  7140 00005CC6 EE                          out dx, al
  7141                                      ; tiny I/O delay so the RTC latches the address before the data read
  7142 00005CC7 50                          push rax
  7143 00005CC8 B000                        mov al, 0
  7144 00005CCA E680                        out 0x80, al                ; write to the unused POST port = short pause
  7145 00005CCC 58                          pop rax
  7146 00005CCD 66BA7100                    mov dx, 0x71
  7147 00005CD1 EC                          in al, dx
  7148 00005CD2 5A                          pop rdx
