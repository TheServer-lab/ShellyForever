 12476 0000A2AF 5F                          pop rdi
 12477 0000A2B0 5A                          pop rdx
 12478 0000A2B1 59                          pop rcx
 12479 0000A2B2 58                          pop rax
 12480 0000A2B3 B93C000000                  mov ecx, 60                  ; frame length is now the Ethernet minimum
 12481                                  .nsr_no_pad:
 12482 0000A2B8 803C25[44CA0800]01          cmp byte [nic_driver_type], 1
