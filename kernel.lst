  8131 0001728F C60425[53E80500]00          mov byte [fs_name_too_long], 0
  8132 00017297 4989C0                      mov r8, rax                 ; save parent idx before str_len clobbers rax
  8133                                      ; reject names that won't fit in the fixed NAME_LEN slot (leaving room
  8134                                      ; for the null terminator) instead of silently overflowing into the
  8135                                      ; next node's name/type/parent fields
  8136 0001729A E88C390000                  call str_len
  8137 0001729F 4883F820                    cmp rax, NAME_LEN
  8138 000172A3 736B                        jae .name_too_long
  8139                                      ; Nodes are partitioned into fixed VOL_NODES-sized slices, one per
  8140                                      ; volume (OS volume first, then each mount slot). Search only within
  8141                                      ; the parent's own slice - never across into another volume's range,
  8142                                      ; or a node created here could get an index outside the volume it
  8143                                      ; actually belongs to, and that volume's vol_write would never
  8144                                      ; include it (silently losing it on the next sync/reboot).
  8145 000172A5 4C89C0                      mov rax, r8
  8146 000172A8 4831D2                      xor rdx, rdx
  8147 000172AB B900010000                  mov rcx, VOL_NODES
  8148 000172B0 48F7F1                      div rcx                     ; rax = volume index = parent_idx / VOL_NODES
  8149 000172B3 4869C000010000              imul rax, VOL_NODES         ; rax = first node index of that volume
  8150 000172BA 4989C1                      mov r9, rax
