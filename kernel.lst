  9915 00018528 51                          push rcx
  9916 00018529 56                          push rsi
  9917 0001852A E838470100                  call spinner_step
  9918 0001852F E8FDF5FFFF                  call disk_write_sector
  9919 00018534 5E                          pop rsi
  9920 00018535 59                          pop rcx
  9921 00018536 58                          pop rax
  9922 00018537 7249                        jc .fail
  9923 00018539 4881C600020000              add rsi, 512
  9924 00018540 48FFC0                      inc rax
  9925 00018543 E2E2                        loop .content_loop
  9926                                      ; --- node_bin_len: exact byte count of binary files (written by
  9927                                      ; fs_write_binary_file, e.g. compiled .run programs). Without it the
  9928                                      ; length is lost on a reboot and fs_read_binary_file returns 0 bytes.
  9929 00018545 B87C060000                  mov rax, BINLEN_LBA
  9930 0001854A B902000000                  mov rcx, BINLEN_SECTORS
  9931 0001854F 488D3425[50DC0500]          lea rsi, [node_bin_len]
  9932 00018557 4C89C7                      mov rdi, r8
  9933 0001855A 486BFF04                    imul rdi, 4
  9934 0001855E 4801FE                      add rsi, rdi
  9935                                  .binlen_loop:
  9936 00018561 50                          push rax
  9937 00018562 51                          push rcx
  9938 00018563 56                          push rsi
  9939 00018564 E8FE460100                  call spinner_step
  9940 00018569 E8C3F5FFFF                  call disk_write_sector
  9941 0001856E 5E                          pop rsi
  9942 0001856F 59                          pop rcx
  9943 00018570 58                          pop rax
  9944 00018571 720F                        jc .fail
  9945 00018573 4881C600020000              add rsi, 512
  9946 0001857A 48FFC0                      inc rax
  9947 0001857D E2E2                        loop .binlen_loop
