  3573 0001345D 53                          push rbx
  3574 0001345E 51                          push rcx
  3575 0001345F 52                          push rdx
  3576 00013460 56                          push rsi
  3577 00013461 57                          push rdi
  3578 00013462 4150                        push r8
  3579 00013464 4152                        push r10
  3580                                  
  3581                                      ; which frame actually failed - ARP broadcast vs. a real data/segment
  3582                                      ; send are two very different failure stories (e.g. an ARP TX failure
  3583                                      ; means the handshake/segment never even got a chance to go out).
  3584 00013466 803C25[08E90500]00          cmp byte [nic_last_tx_ctx], 0
  3585 0001346E 740C                        je .ndt_ctx_seg
