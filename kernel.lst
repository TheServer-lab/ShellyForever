  3593                                  
  3594                                      ; PCI Status register: dword at cfg offset 0x04 covers Command (low 16)
  3595                                      ; + Status (high 16); shift down to isolate Status.
  3596 00013492 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
  3597 0001349A 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
  3598 000134A2 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
