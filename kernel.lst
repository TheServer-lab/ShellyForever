 12109                                  ; ============================================================
 12110                                  ;  RTC / CMOS CLOCK  (date, time, wig time)
 12111                                  ; ============================================================
 12112                                  ; The MC146818 real-time clock chip is addressed through port 0x70
 12113                                  ; (register index, bit 7 disables NMIs while set) and 0x71 (data).
 12114                                  ; All values come back BCD-encoded unless status register B's binary
 12115                                  ; bit is set, and hours may be 12-hour mode - rtc_update normalizes
 12116                                  ; everything to plain 24-hour binary before storing it.
 12117                                  
 12118                                  ; cmos_read: al = register index (0..0x3F) -> al = that register's value.
 12119                                  cmos_read:
 12120 000095C4 52                          push rdx
 12121 000095C5 0C80                        or al, 0x80                 ; set NMI-disable bit while selecting
 12122 000095C7 66BA7000                    mov dx, 0x70
 12123 000095CB EE                          out dx, al
 12124                                      ; tiny I/O delay so the RTC latches the address before the data read
 12125 000095CC 50                          push rax
 12126 000095CD B000                        mov al, 0
 12127 000095CF E680                        out 0x80, al                ; write to the unused POST port = short pause
 12128 000095D1 58                          pop rax
 12129 000095D2 66BA7100                    mov dx, 0x71
 12130 000095D6 EC                          in al, dx
 12131 000095D7 5A                          pop rdx
 12132 000095D8 C3                          ret
 12133                                  
 12134                                  ; rtc_wait_uip: waits until the RTC's Update-In-Progress flag (status A,
 12135                                  ; bit 7) clears, so the registers read below are internally consistent.
 12136                                  rtc_wait_uip:
 12137 000095D9 50                          push rax
 12138                                  .uip_wait:
 12139 000095DA B00A                        mov al, 0x0A
 12140 000095DC E8E3FFFFFF                  call cmos_read
 12141 000095E1 A880                        test al, 0x80
 12142 000095E3 75F5                        jnz .uip_wait
 12143 000095E5 58                          pop rax
 12144 000095E6 C3                          ret
 12145                                  
 12146                                  ; bcd_to_bin: al = BCD byte -> al = binary value. Preserves other regs.
 12147                                  bcd_to_bin:
 12148 000095E7 53                          push rbx
 12149 000095E8 51                          push rcx
 12150 000095E9 52                          push rdx
 12151 000095EA 480FB6D8                    movzx rbx, al
 12152 000095EE 88D8                        mov al, bl
 12153 000095F0 C0E804                      shr al, 4
 12154 000095F3 480FB6C8                    movzx rcx, al
 12155 000095F7 486BC90A                    imul rcx, 10
 12156 000095FB 88D8                        mov al, bl
 12157 000095FD 240F                        and al, 0x0F
 12158 000095FF 480FB6D0                    movzx rdx, al
 12159 00009603 4801D1                      add rcx, rdx
 12160 00009606 4889C8                      mov rax, rcx
 12161 00009609 5A                          pop rdx
 12162 0000960A 59                          pop rcx
 12163 0000960B 5B                          pop rbx
 12164 0000960C C3                          ret
 12165                                  
 12166                                  ; rtc_update: reads seconds/minutes/hours/day/month/year (+ century, if the
 12167                                  ; chip provides one) into the rtc_* variables, normalized to 24-hour binary.
 12168                                  rtc_update:
 12169 0000960D 50                          push rax
 12170 0000960E 53                          push rbx
 12171 0000960F E8C5FFFFFF                  call rtc_wait_uip
 12172 00009614 B000                        mov al, 0x00
 12173 00009616 E8A9FFFFFF                  call cmos_read
 12174 0000961B 880425[7CAD0100]            mov [rtc_sec], al
 12175 00009622 B002                        mov al, 0x02
 12176 00009624 E89BFFFFFF                  call cmos_read
 12177 00009629 880425[7DAD0100]            mov [rtc_min], al
 12178 00009630 B004                        mov al, 0x04
 12179 00009632 E88DFFFFFF                  call cmos_read
 12180 00009637 880425[7EAD0100]            mov [rtc_hour], al
 12181 0000963E B007                        mov al, 0x07
 12182 00009640 E87FFFFFFF                  call cmos_read
 12183 00009645 880425[7FAD0100]            mov [rtc_day], al
 12184 0000964C B008                        mov al, 0x08
 12185 0000964E E871FFFFFF                  call cmos_read
 12186 00009653 880425[80AD0100]            mov [rtc_month], al
 12187 0000965A B009                        mov al, 0x09
 12188 0000965C E863FFFFFF                  call cmos_read
 12189 00009661 880425[81AD0100]            mov [rtc_year], al
 12190 00009668 B032                        mov al, 0x32
 12191 0000966A E855FFFFFF                  call cmos_read
 12192 0000966F 880425[82AD0100]            mov [rtc_century], al
 12193 00009676 B00B                        mov al, 0x0B
 12194 00009678 E847FFFFFF                  call cmos_read
 12195 0000967D 88C3                        mov bl, al                     ; status register B
 12196                                      ; BCD? (status B bit 2). If clear, values are already binary.
 12197 0000967F F6C304                      test bl, 0x04
 12198 00009682 0F8485000000                jz .rtc_no_bcd
 12199 00009688 8A0425[7CAD0100]            mov al, [rtc_sec]
 12200 0000968F E853FFFFFF                  call bcd_to_bin
 12201 00009694 880425[7CAD0100]            mov [rtc_sec], al
 12202 0000969B 8A0425[7DAD0100]            mov al, [rtc_min]
 12203 000096A2 E840FFFFFF                  call bcd_to_bin
 12204 000096A7 880425[7DAD0100]            mov [rtc_min], al
 12205 000096AE 8A0425[7EAD0100]            mov al, [rtc_hour]
 12206 000096B5 E82DFFFFFF                  call bcd_to_bin
 12207 000096BA 880425[7EAD0100]            mov [rtc_hour], al
 12208 000096C1 8A0425[7FAD0100]            mov al, [rtc_day]
 12209 000096C8 E81AFFFFFF                  call bcd_to_bin
 12210 000096CD 880425[7FAD0100]            mov [rtc_day], al
 12211 000096D4 8A0425[80AD0100]            mov al, [rtc_month]
 12212 000096DB E807FFFFFF                  call bcd_to_bin
 12213 000096E0 880425[80AD0100]            mov [rtc_month], al
 12214 000096E7 8A0425[81AD0100]            mov al, [rtc_year]
 12215 000096EE E8F4FEFFFF                  call bcd_to_bin
 12216 000096F3 880425[81AD0100]            mov [rtc_year], al
 12217 000096FA 8A0425[82AD0100]            mov al, [rtc_century]
 12218 00009701 E8E1FEFFFF                  call bcd_to_bin
 12219 00009706 880425[82AD0100]            mov [rtc_century], al
 12220                                  .rtc_no_bcd:
 12221                                      ; 12-hour mode? (status B bit 1). If set, hour's bit 7 = PM.
 12222 0000970D F6C302                      test bl, 0x02
 12223 00009710 7425                        jz .rtc_done
