  4863                              <1> ; ============================================================
  4864                              <1> ;  RANDOM + TIME BUILTINS  (Phase 5)
  4865                              <1> ; ============================================================
  4866                              <1> ; random: a xorshift64* generator (state = party_rand_state) lazily
  4867                              <1> ; seeded on first use from RDTSC mixed with the RTC clock, so two
  4868                              <1> ; runs started a second or more apart get different sequences without
  4869                              <1> ; the script having to call randseed() itself. randseed() reseeds it
  4870                              <1> ; explicitly (e.g. for a repeatable test run).
  4871                              <1> ;
  4872                              <1> ; time: there's no real epoch on this hardware, only the CMOS RTC's
  4873                              <1> ; wall-clock fields (see rtc_update/rtc_sec..rtc_century, kernel.asm
  4874                              <1> ; ~15322+). time() converts those into a seconds count from a fixed
  4875                              <1> ; reference point (2000-01-01 00:00:00) using ordinary calendar math
  4876                              <1> ; - it's not a true Unix timestamp, but it's monotonic across a run
  4877                              <1> ; and good enough for elapsed-time measurements and for seeding
  4878                              <1> ; things. datestr()/timestr() just wrap the kernel's existing
  4879                              <1> ; format_date/format_time helpers (the same ones cmd_date/cmd_time
  4880                              <1> ; use) as Party-callable strings.
  4881                              <1> 
  4882 00029AA1 0000000000000000    <1> party_rand_state:   dq 0
  4883 00029AA9 00                  <1> party_rand_seeded:  db 0
  4884 00029AAA 90<rep 6h>          <1> ALIGN 8
  4885 00029AB0 1DDD6C4F91F44525    <1> party_rand_k1:      dq 0x2545F4914F6CDD1D   ; xorshift64* multiplier
  4886                              <1> 
  4887                              <1> ; party_rand_next: out = rax = next 64-bit pseudo-random value.
  4888                              <1> ; Lazily seeds party_rand_state on first call. Clobbers rax, rcx, rdx.
  4889                              <1> party_rand_next:
  4890 00029AB8 803C25[A99A0200]00  <1>     cmp byte [party_rand_seeded], 0
  4891 00029AC0 7527                <1>     jne .prn_seeded
  4892 00029AC2 0F31                <1>     rdtsc                          ; edx:eax = timestamp counter
  4893 00029AC4 48C1E220            <1>     shl rdx, 32
  4894 00029AC8 4809D0              <1>     or rax, rdx                    ; rax = 64-bit tsc reading
  4895 00029ACB 50                  <1>     push rax                       ; stash it - rtc_sec_now below clobbers rax
  4896 00029ACC E80AF9FDFF          <1>     call rtc_sec_now                ; eax = current RTC seconds (0..59)
  4897 00029AD1 5A                  <1>     pop rdx                        ; rdx = the saved tsc reading
  4898 00029AD2 4831D0              <1>     xor rax, rdx                   ; fold the RTC second into the tsc bits
  4899 00029AD5 4883C801            <1>     or rax, 1                      ; xorshift64 can't recover from an all-zero state
  4900 00029AD9 48890425[A19A0200]  <1>     mov [party_rand_state], rax
  4901 00029AE1 C60425[A99A0200]01  <1>     mov byte [party_rand_seeded], 1
  4902                              <1> .prn_seeded:
  4903 00029AE9 488B0425[A19A0200]  <1>     mov rax, [party_rand_state]
  4904 00029AF1 4889C1              <1>     mov rcx, rax
  4905 00029AF4 48C1E90C            <1>     shr rcx, 12
  4906 00029AF8 4831C8              <1>     xor rax, rcx
  4907 00029AFB 4889C1              <1>     mov rcx, rax
  4908 00029AFE 48C1E119            <1>     shl rcx, 25
  4909 00029B02 4831C8              <1>     xor rax, rcx
  4910 00029B05 4889C1              <1>     mov rcx, rax
  4911 00029B08 48C1E907            <1>     shr rcx, 7
  4912 00029B0C 4831C8              <1>     xor rax, rcx
  4913 00029B0F 48890425[A19A0200]  <1>     mov [party_rand_state], rax
  4914 00029B17 480FAF0425-         <1>     imul rax, [party_rand_k1]      ; scramble the output (xorshift64*)
  4914 00029B1C [B09A0200]          <1>
  4915 00029B20 C3                  <1>     ret
  4916                              <1> 
