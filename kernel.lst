 18695                                  ; --- scancode set 1 -> ascii tables (index = scancode, 0..0x53) ---
 18696 0007E06A 90<rep 6h>              ALIGN 8
 18697                                  kbd_unshift:
 18698 0007E070 001B31323334353637-         db 0,27,'1','2','3','4','5','6','7','8'      ; 0x00-0x09
 18698 0007E079 38                 
 18699 0007E07A 39302D3D0809                db '9','0','-','=',8,9                        ; 0x0A-0x0F
 18700 0007E080 71776572747975696F-         db 'q','w','e','r','t','y','u','i','o','p'    ; 0x10-0x19
 18700 0007E089 70                 
 18701 0007E08A 5B5D0D00                    db '[',']',13,0                                ; 0x1A-0x1D
 18702 0007E08E 6173646667686A6B6C-         db 'a','s','d','f','g','h','j','k','l',';'    ; 0x1E-0x27
 18702 0007E097 3B                 
 18703 0007E098 2760005C                    db 39,'`',0,'\'                                ; 0x28-0x2B
 18704 0007E09C 7A786376626E6D2C2E-         db 'z','x','c','v','b','n','m',',','.','/'    ; 0x2C-0x35
 18704 0007E0A5 2F                 
 18705 0007E0A6 002A0020                    db 0,'*',0,' '                                 ; 0x36-0x39
 18706 0007E0AA 00<rep Dh>                  times 0x47-0x3A db 0                           ; 0x3A-0x46 unused
 18707 0007E0B7 3738392D3435362B31-         db '7','8','9','-','4','5','6','+','1','2','3','0','.'  ; 0x47-0x53 keypad
 18707 0007E0C0 3233302E           
 18708                                  
 18709                                  kbd_shift:
 18710 0007E0C4 001B21402324255E26-         db 0,27,'!','@','#','$','%','^','&','*'       ; 0x00-0x09
 18710 0007E0CD 2A                 
 18711 0007E0CE 28295F2B0809                db '(',')','_','+',8,9                         ; 0x0A-0x0F
 18712 0007E0D4 51574552545955494F-         db 'Q','W','E','R','T','Y','U','I','O','P'    ; 0x10-0x19
 18712 0007E0DD 50                 
 18713 0007E0DE 7B7D0D00                    db '{','}',13,0                                ; 0x1A-0x1D
 18714 0007E0E2 4153444647484A4B4C-         db 'A','S','D','F','G','H','J','K','L',':'    ; 0x1E-0x27
 18714 0007E0EB 3A                 
 18715 0007E0EC 227E007C                    db 34,'~',0,'|'                                ; 0x28-0x2B
 18716 0007E0F0 5A584356424E4D3C3E-         db 'Z','X','C','V','B','N','M','<','>','?'    ; 0x2C-0x35
 18716 0007E0F9 3F                 
 18717 0007E0FA 002A0020                    db 0,'*',0,' '                                 ; 0x36-0x39
 18718 0007E0FE 00<rep Dh>                  times 0x47-0x3A db 0                           ; 0x3A-0x46 unused
 18719 0007E10B 3738392D3435362B31-         db '7','8','9','-','4','5','6','+','1','2','3','0','.'  ; 0x47-0x53 keypad
 18719 0007E114 3233302E           
 18720                                  
 18721                                  ; --- filesystem storage ---
 18722                                  ; One flat node table shared by every mounted volume. The OS volume lives
 18723                                  ; in nodes 0..OS_NODES; mount slot k owns nodes VOL_NODES*(k+1)..VOL_NODES*(k+2)-1.
 18724                                  ; Each volume is persisted separately (superblock + node arrays) to its own
 18725                                  ; device - see the SFFS v2 layout notes near the top of this file.
 18726                                  ;
 18727                                  ; IMPORTANT: ata_read_sector/ata_write_sector always move a full 512-byte
 18728                                  ; sector, so every buffer a sector is staged in/out of must hold 512 bytes.
 18729                                  ; node_type and fs_parent_scratch are exactly that: the type/parent reads
 18730                                  ; in vol_read/vol_write go straight at a whole sector each, and anything
 18731                                  ; smaller would silently overflow into the adjacent arrays (which showed up
 18732                                  ; as a black screen after 'mount' corrupted the node table).
 18733                                  ALIGN 8
 18734 0007E118 00<rep 200h>            fs_super_buf:   times 512 db 0        ; scratch for reading/building superblocks
 18735 0007E318 00<rep 28h>             fmt_new_label:      times 40 db 0     ; label being applied by the current 'fmt'
 18736 0007E340 00<rep 28h>             sys_reset_label_tmp: times 40 db 0    ; root label preserved across 'sys reset'
 18737 0007E368 00<rep 28h>             orig_label_buf:      times 40 db 0    ; scratch: a device's generated "diskN" label
 18738 0007E390 00<rep Ch>              orig_label_num_tmp:  times 12 db 0    ; scratch: decimal digits for gen_orig_label
 18739 0007E39C 00<rep 200h>            fs_parent_scratch: times 512 db 0     ; staging for one full parent sector (512B)
 18740 0007E59C 00<rep 40h>             mount_label:   times MAX_MOUNTS*32 db 0     ; label of each mounted volume
 18741 0007E5DC 00<rep 2h>              mount_device:  times MAX_MOUNTS db 0        ; device id each volume came from
 18742 0007E5DE 00<rep 2h>              mount_used:    times MAX_MOUNTS db 0        ; 1 = slot in use
 18743                                  ; type sector = 512B per volume (base 0/256/512 with VOL_NODES=256), so this
 18744                                  ; must span the max extent of a sector write: base + 512. node indices still
 18745                                  ; index it by node (1 byte per node); the per-volume padding holds whatever
 18746                                  ; the sector has. 512*(1+MAX_MOUNTS) stays comfortably >= MAX_NODES either way.
 18747 0007E5E0 00<rep 600h>            node_type:    times 512 * (1 + MAX_MOUNTS) db 0
 18748 0007EBE0 0000<rep 300h>          node_parent:  times MAX_NODES dw 0
 18749 0007F1E0 00<rep 6000h>           node_name:    times MAX_NODES*NAME_LEN db 0
 18750                                  ; node_first_block: starting data cluster of each file's content run. EMPTY_CLUSTER
 18751                                  ; (0xFFFFFFFF) = the file is empty (no clusters owned). 4 bytes per node - a single
 18752                                  ; cluster index reaches the whole 256 MiB data area.
 18753 000851E0 FFFFFFFF<rep 300h>      node_first_block: times MAX_NODES dd EMPTY_CLUSTER
 18754                                  ; node_bin_len: exact byte count for every file (text and binary alike) written via
 18755                                  ; fs_write_file/fs_write_binary_file, recorded on the file's head node only. Lets
 18756                                  ; fs_read_file/fs_read_binary_file copy back the precise length instead of guessing
 18757                                  ; from NUL bytes (which real binary content - e.g. compiled .run programs - can
 18758                                  ; legitimately contain). Persisted with the volume.
 18759 00085DE0 00000000<rep 300h>      node_bin_len: times MAX_NODES dd 0
 18760                                  ; fs_bitmap: cached free-block bitmap, one 8KB slice per volume (OS volume first,
 18761                                  ; then each mount slot, matching the node table's slot partitioning). Bit set = cluster
 18762                                  ; in use, clear = free. Loaded by vol_read, flushed by vol_write, edited by the
 18763                                  ; cluster allocator (fs_alloc_run/fs_free_run).
 18764 000869E0 00<rep 6000h>           fs_bitmap:    times (1 + MAX_MOUNTS) * BITMAP_BYTES db 0
 18765                                  
 18766 0008C9E0 00                      fs_loaded_from_disk: db 0
 18767 0008C9E1 01                      fs_disk_available:   db 1     ; optimistic default; cleared on first ATA failure
 18768 0008C9E2 00                      boot_device:         db 0     ; device id holding the OS volume - normally 0
 18769                                                                 ; (legacy ATA primary master), but fs_load moves
 18770                                                                 ; this to an AHCI slot (4+) when device 0 never
 18771                                                                 ; responds and a SATA disk was found instead
 18772 0008C9E3 00                      fs_name_too_long:    db 0     ; set by fs_create_node when a name won't fit
 18773 0008C9E4 00                      fs_cur_slot:         db 0     ; set by the fs disk routines: slot (0 = OS, 1.. = mounts)
 18774                                                                ; of the node currently being read/written
 18775                                  
 18776 0008C9E5 00                      mkfl_test_flag:      db 0     ; set by cmd_mkfl when -test appears in arg2/3/4
 18777 0008C9E6 90<rep 2h>              ALIGN 8
 18778 0008C9E8 0000000000000000        mkfl_content_ptr:     dq 0     ; points at the effective content string for -test reporting
 18779                                  
 18780                                  ALIGN 8
 18781 0008C9F0 F001                    ata_port_base: dw 0x1F0        ; 0x1F0 primary channel, 0x170 secondary
 18782 0008C9F2 E0                      ata_drive_sel: db 0xE0         ; 0xE0 master, 0xF0 slave
 18783                                  
 18784                                  ; --- AHCI (SATA) driver state ---
 18785 0008C9F3 00                      pci_scratch_hdrtype: db 0
 18786 0008C9F4 00                      ahci_pci_bus:     db 0
 18787 0008C9F5 00                      ahci_pci_dev:     db 0
 18788 0008C9F6 00                      ahci_pci_func:    db 0
 18789 0008C9F7 90                      ALIGN 4
 18790 0008C9F8 00000000                ahci_abar:        dd 0             ; physical base of the AHCI MMIO register window
 18791 0008C9FC 00000000                ahci_ports_impl:  dd 0             ; PI bitmap read from the HBA at boot
 18792 0008CA00 00                      ahci_port_count:  db 0             ; how many of ahci_port_num/base are valid
 18793 0008CA01 00000000<rep 4h>        ahci_port_num:    times AHCI_MAX_PORTS dd 0   ; slot -> real HBA port number
 18794 0008CA11 90<rep 7h>              ALIGN 8
 18795 0008CA18 0000000000000000-       ahci_port_base:   times AHCI_MAX_PORTS dq 0   ; slot -> port register base ptr
 18795 0008CA18 <rep 4h>           
 18796 0008CA38 00                      disk_use_ahci:    db 0             ; set by disk_select_device: 0=ATA, 1=AHCI
 18797 0008CA39 00                      ahci_cur_slot:    db 0             ; which AHCI slot is currently selected
 18798 0008CA3A 00                      ahci_op_cmd:      db 0             ; pending ATA command byte (read vs write)
 18799 0008CA3B 00                      ahci_op_write:    db 0             ; 1 if the pending op is a write
 18800                                  
 18801                                  ; --- RTL8139 NIC driver state ---
 18802 0008CA3C 00                      nic_present:     db 0             ; 1 = NIC found and rings live
 18803 0008CA3D 00                      nic_pci_bus:     db 0
 18804 0008CA3E 00                      nic_pci_dev:     db 0
 18805 0008CA3F 00                      nic_pci_func:    db 0
 18806                                  ALIGN 4
 18807 0008CA40 00000000                nic_io_base:     dd 0             ; BAR0 I/O port base (RTL8139)
 18808 0008CA44 00                      nic_driver_type: db 0             ; 0 = rtl8139, 1 = e1000; set by nic_init
 18809 0008CA45 90<rep 3h>              ALIGN 4
 18810 0008CA48 00000000                nic_mmio_base:   dd 0             ; BAR0 MMIO physical base (e1000)
 18811 0008CA4C 00000000                nic_rx_seen:     dd 0             ; diagnostic: raw frames seen since last reset
 18812 0008CA50 00<rep 6h>              nic_mac:         times 6 db 0
 18813 0008CA56 0A00020F                nic_ip:          db 10, 0, 2, 15  ; static config (QEMU slirp defaults)
 18814 0008CA5A FFFFFF00                nic_mask:        db 255, 255, 255, 0
 18815 0008CA5E 0A000202                nic_gw:          db 10, 0, 2, 2
 18816 0008CA62 0A000203                nic_dns:         db 10, 0, 2, 3
 18817 0008CA66 00000000                nic_capr:        dd 0             ; software RX read pointer (ring offset)
 18818 0008CA6A 00                      nic_ihl:         db 0             ; IPv4 header length (bytes) of current frame
 18819 0008CA6B 0042                    nic_ip_id:       dw 0x4200        ; IPv4 identification counter
 18820                                  NIC_ARP_CACHE_ENTRIES equ 4
 18821 0008CA6D 00<rep 28h>             nic_arp_cache:   times NIC_ARP_CACHE_ENTRIES*10 db 0   ; per entry: 6B MAC + 4B IP
 18822 0008CA95 00                      nic_arp_next:    db 0
 18823 0008CA96 00                      nic_arp_tried:   db 0             ; unused now (nic_arp_resolve tracks its own
 18824                                                                     ; round counters in registers) - kept so
 18825                                                                     ; existing reset-on-init writes stay valid
 18826 0008CA97 00                      nic_last_fail_reason: db 0        ; set by nic_arp_resolve on CF=1: 0 = raw
 18827                                                                     ; broadcast TX itself failed (hardware/
 18828                                                                     ; timeout - see nic_send_raw_rtl8168 diag),
 18829                                                                     ; 1 = broadcast sent fine, just never got
 18830                                                                     ; an ARP reply back in time
 18831 0008CA98 00                      nic_last_tx_ctx: db 0             ; 0 = data/segment frame, 1 = ARP broadcast -
 18832                                                                     ; set right before every nic_send_raw call so
 18833                                                                     ; a failure dump can say which frame it was
 18834 0008CA99 00                      nic_tx_desc:     db 0             ; C-mode TX descriptor currently in use (0..3)
 18835 0008CA9A 00000000                nic_bounce_target: dd 0           ; IP the bounce/monitor loop is pinging
 18836 0008CA9E 3412                    nic_echo_id:     dw 0x1234
 18837 0008CAA0 0100                    nic_echo_seq:    dw 1
 18838 0008CAA2 00                      nic_echo_got:    db 0             ; 1 = matching echo reply received
 18839 0008CAA3 00                      nic_echo_retry:  db 0             ; bounce retry flag
 18840 0008CAA4 0000                    nic_echo_seq_rcv: dw 0
 18841 0008CAA6 00000000                nic_echo_src_ip: dd 0             ; source IP of the last matching reply
 18842 0008CAAA 0100                    nic_dns_id:      dw 1
 18843 0008CAAC 0000                    nic_dns_query_id: dw 0
 18844 0008CAAE 00                      nic_dns_done:    db 0
 18845 0008CAAF 00                      nic_dns_retry:   db 0
 18846 0008CAB0 00                      nic_dns_wait_ticks: db 0   ; whole-seconds left in the current DNS round -- same
 18847                                                              ; multi-second-round idea as tcp_wait_ticks, see the
 18848                                                              ; fix in dns_query (the old code gave up after ~1-2
 18849                                                              ; real seconds total, nowhere near enough for a real
 18850                                                              ; DNS round trip through QEMU's user-mode DNS proxy)
 18851 0008CAB1 00000000                nic_dns_result:  dd 0
 18852                                  ; every A record from the most recent reply, so a caller whose TCP connect
 18853                                  ; to the first one times out (e.g. one anycast edge of a multi-IP host is
 18854                                  ; unreachable from this network while the others are fine) can fall back
 18855                                  ; to the next one instead of just giving up.
 18856 0008CAB5 00000000<rep 8h>        nic_dns_ips:     times NIC_DNS_MAX_IPS dd 0
 18857 0008CAD5 00                      nic_dns_ip_count: db 0
 18858 0008CAD6 00000000                dhcp_xid:        dd 0
 18859 0008CADA 00000000                dhcp_offered_ip: dd 0
 18860 0008CADE 00                      dhcp_done:       db 0
 18861 0008CADF 00                      dhcp_retries:    db 0
 18862 0008CAE0 00                      dhcp_msg_type:   db 0      ; DHCP message type (53) seen in the last offer/ack
 18863 0008CAE1 00                      nic_diag_verbose: db 0     ; 1 = netpoll prints a summary of every frame it sees
 18864 0008CAE2 00                      nic_diag_rx_count: db 0    ; caps how many "rx: ..." lines netpoll will print
 18865                                                             ; per dhcp/bounce attempt - on a real LAN with
 18866                                                             ; constant background broadcast traffic this was
 18867                                                             ; still unbounded even after the tx dump got
 18868                                                             ; throttled, and could flood the screen across a
 18869                                                             ; long multi-retry wait on its own
 18870 0008CAE3 00                      nic_dns_seen:    db 0      ; 1 = the router sent DHCP option 6 (DNS server)
 18871                                                             ; at some point this lease - if it never does,
 18872                                                             ; cmd_dhcp falls back to using the gateway as
 18873                                                             ; DNS, since many consumer routers proxy DNS on
 18874                                                             ; their own LAN IP without advertising option 6
 18875 0008CAE4 00                      nic_diag_tx_dumped: db 0   ; 1 = the full tx hex dump has already fired this
 18876                                                             ; dhcp session - keeps retries from re-flooding
 18877                                                             ; the screen with the same packet layout
 18878 0008CAE5 FFFFFFFFFFFF            mac_broadcast:   db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
