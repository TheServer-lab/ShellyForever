  1590 0002716E 0240000000000000    <1>
  1591 00027176 [4627030000000000]- <1>     dq party_returning, 1
  1591 0002717E 0100000000000000    <1>
  1592 00027186 [4827030000000000]- <1>     dq party_err_msg_ptr, 40       ; err_msg_ptr, vsp, call_depth, loc_count, func_count
  1592 0002718E 2800000000000000    <1>
