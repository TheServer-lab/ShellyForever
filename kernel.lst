 10955                                  ; ==================================================================
 10956                                  ;  RTL8139 NIC driver + base network stack (Milestone B)
 10957                                  ;  Polled, no IRQs. Inbound frames land in a DMA RX ring; the shell
 10958                                  ;  loop calls netpoll to drain and dispatch them (ARP / IPv4 / ICMP /
 10959                                  ;  UDP-DNS). Outbound frames are built in nic_tx_buf and pushed out
 10960                                  ;  TSAD0/TSD0 by nic_send_raw. Static IP config lives in nic_ip /
 10961                                  ;  nic_mask / nic_gw / nic_dns (defaults are the QEMU slirp values).
 10962                                  ;  All register discipline: every function in this section saves and
 10963                                  ;  restores every register it uses, so the polling loops (bounce /
 10964                                  ;  monitor / dns) can hold state in r12/r13/r14/r15 across calls.
 10965                                  ; ==================================================================
 10966                                  NIC_VENDOR_ID   equ 0x10EC
 10967                                  NIC_DEVICE_ID   equ 0x8139
 10968                                  NIC_PCI_CMD     equ 0x04
 10969                                  NIC_PCI_BAR0    equ 0x10
 10970                                  
 10971                                  NIC_IO_IDR0     equ 0x00
 10972                                  NIC_IO_TSD0     equ 0x10
 10973                                  NIC_IO_TSAD0    equ 0x20
 10974                                  NIC_IO_RBSTART  equ 0x30
 10975                                  NIC_IO_CBR      equ 0x34
 10976                                  NIC_IO_CAPR     equ 0x38
 10977                                  NIC_IO_CMD      equ 0x37
 10978                                  NIC_IO_IMR      equ 0x3C
 10979                                  NIC_IO_ISR      equ 0x3E
 10980                                  NIC_IO_TCR      equ 0x40
 10981                                  NIC_IO_RCR      equ 0x44
 10982                                  NIC_IO_CFG1     equ 0x52
 10983                                  
 10984                                  NIC_RX_RING_SIZE equ 0x2000        ; 8KB ring (fits the boot budget)
 10985                                  NIC_RX_RING_MASK equ 0x1FFF
 10986                                  NIC_TX_BUF_SIZE  equ 0x800         ; 2KB frame build/DMA buffer
 10987                                  ETH_TYPE_ARP_W   equ 0x0608        ; "08 06" as a little-endian memory word
 10988                                  ETH_TYPE_IP_W    equ 0x0008        ; "08 00" as a little-endian memory word
 10989                                  IP_PROTO_ICMP    equ 0x01
 10990                                  IP_PROTO_TCP     equ 0x06
 10991                                  IP_PROTO_UDP     equ 0x11
 10992                                  
 10993                                  ; ---- Intel e1000 (82540/82541/82545/82546/8257x "PRO/1000") support -----
 10994                                  ; A second NIC backend behind the exact same nic_init/nic_send_raw/nic_fetch_rx
 10995                                  ; entry points the RTL8139 driver above already exposes, so ARP/IPv4/ICMP/
 10996                                  ; UDP-DNS and every shell command above never need to know which chip is
 10997                                  ; live - they only ever touch nic_present/nic_mac and call nic_send_raw /
 10998                                  ; nic_fetch_rx. nic_driver_type (0=rtl8139, 1=e1000) picks the branch inside
 10999                                  ; those three functions. Unlike the RTL8139's port I/O, e1000 registers are
 11000                                  ; memory-mapped (BAR0), so this backend uses ordinary loads/stores against
 11001                                  ; the identity-mapped physical address in nic_mmio_base instead of in/out.
 11002                                  E1000_VENDOR_ID  equ 0x8086
 11003                                  
 11004                                  E1000_CTRL       equ 0x0000
 11005                                  E1000_STATUS     equ 0x0008
 11006                                  E1000_ICR        equ 0x00C0
 11007                                  E1000_IMS        equ 0x00D0
 11008                                  E1000_IMC        equ 0x00D8
 11009                                  E1000_RCTL       equ 0x0100
 11010                                  E1000_TCTL       equ 0x0400
 11011                                  E1000_TIPG       equ 0x0410
 11012                                  E1000_RDBAL      equ 0x2800
 11013                                  E1000_RDBAH      equ 0x2804
 11014                                  E1000_RDLEN      equ 0x2808
 11015                                  E1000_RDH        equ 0x2810
 11016                                  E1000_RDT        equ 0x2818
 11017                                  E1000_TDBAL      equ 0x3800
 11018                                  E1000_TDBAH      equ 0x3804
 11019                                  E1000_TDLEN      equ 0x3808
 11020                                  E1000_TDH        equ 0x3810
 11021                                  E1000_TDT        equ 0x3818
 11022                                  E1000_MTA        equ 0x5200
 11023                                  E1000_RAL0       equ 0x5400
 11024                                  E1000_RAH0       equ 0x5404
 11025                                  
 11026                                  E1000_CTRL_RST   equ 0x04000000
 11027                                  E1000_CTRL_SLU_ASDE equ 0x00000060   ; SLU (bit6) | ASDE (bit5)
 11028                                  
 11029                                  E1000_RCTL_EN    equ 0x00000002
 11030                                  E1000_RCTL_UPE   equ 0x00000008
 11031                                  E1000_RCTL_MPE   equ 0x00000010
 11032                                  E1000_RCTL_BAM   equ 0x00008000
 11033                                  E1000_RCTL_SECRC equ 0x04000000      ; strip the 4-byte Ethernet CRC, like RTL8139's ring does
 11034                                  
 11035                                  E1000_TCTL_EN    equ 0x00000002
 11036                                  E1000_TCTL_PSP   equ 0x00000008
 11037                                  E1000_TCTL_CT    equ 0x000000F0      ; collision threshold 0x0F << 4
 11038                                  E1000_TCTL_COLD  equ 0x00040000      ; collision distance 0x40 << 12 (full duplex)
 11039                                  E1000_TIPG_VAL   equ 0x0060200A      ; Intel-recommended IPGT/IPGR1/IPGR2 for full duplex
 11040                                  
 11041                                  E1000_TXD_CMD_EOP_IFCS_RS equ 0x0B   ; EOP(0x01) | IFCS(0x02) | RS(0x08)
 11042                                  E1000_DD         equ 0x01            ; Descriptor Done, shared by RX/TX status bytes
 11043                                  
 11044                                  E1000_RX_DESC_COUNT equ 8            ; 8 * 16B = 128B: the minimum ring length e1000 accepts
 11045                                  E1000_TX_DESC_COUNT equ 8
 11046                                  E1000_RX_BUF_SIZE   equ 2048
 11047                                  
 11048                                  ; ---- Realtek RTL8168/8169/8161 ("PCIe GBE Family Controller") support ---
 11049                                  ; A third NIC backend behind the same nic_init/nic_send_raw/nic_fetch_rx
 11050                                  ; entry points (nic_driver_type: 0=rtl8139, 1=e1000, 2=rtl8168). This is
 11051                                  ; the common gigabit Realtek chip found on most real desktop motherboards -
 11052                                  ; a completely different beast from the old RTL8139: descriptor rings like
 11053                                  ; e1000, but reached over port I/O (BAR0) like the RTL8139 driver, so it
 11054                                  ; reuses nic_io_read8/16/32 / nic_io_write8/16/32 against nic_io_base. Only
 11055                                  ; the "normal priority" TX queue is used; the high-priority queue is left
 11056                                  ; zeroed/unused. Register offsets and the reset/bring-up sequence follow
 11057                                  ; the publicly documented RTL8169 programming model (OSDev.org's RTL8169
 11058                                  ; page, itself sourced from Realtek's public datasheet).
 11059                                  RTL_VENDOR_ID    equ 0x10EC
 11060                                  
 11061                                  RTL_IO_IDR0      equ 0x00             ; MAC address, 6 bytes
 11062                                  RTL_IO_TNPDS_LO  equ 0x20             ; Tx Normal Priority Descriptor Start Addr (low dword)
 11063                                  RTL_IO_TNPDS_HI  equ 0x24
 11064                                  RTL_IO_THPDS_LO  equ 0x28             ; Tx High Priority ring - unused, kept zeroed
 11065                                  RTL_IO_THPDS_HI  equ 0x2C
 11066                                  RTL_IO_CMD       equ 0x37             ; Chip Command register
 11067                                  RTL_IO_TPPOLL    equ 0x38             ; Transmit Priority Polling (kick DMA)
 11068                                  RTL_IO_IMR       equ 0x3C
 11069                                  RTL_IO_ISR       equ 0x3E
 11070                                  RTL_IO_TCR       equ 0x40             ; TxConfig
 11071                                  RTL_IO_RCR       equ 0x44             ; RxConfig
 11072                                  RTL_IO_9346CR    equ 0x50             ; EEPROM/config-register lock
 11073                                  RTL_IO_CPCMD     equ 0xE0             ; C+ Command Register
 11074                                  RTL_IO_RMS       equ 0xDA             ; Rx max packet size (word)
 11075                                  RTL_IO_MTPS      equ 0xEC             ; Tx max packet size, 128-byte units (byte)
 11076                                  RTL_IO_RDSAR_LO  equ 0xE4             ; Rx Descriptor Start Addr (low dword)
 11077                                  RTL_IO_RDSAR_HI  equ 0xE8
 11078                                  RTL_IO_PHYSTATUS equ 0x6C             ; PHY status register; bit1 = LinkStatus
 11079                                  RTL_IO_PHYAR     equ 0x60             ; PHY (MDIO) Access Register
 11080                                  RTL_PHYSTATUS_LINK equ 0x02
 11081                                  
 11082                                  RTL_CMD_RST      equ 0x10
 11083                                  RTL_CMD_TE       equ 0x04
 11084                                  RTL_CMD_RE       equ 0x08
 11085                                  RTL_9346_UNLOCK  equ 0xC0
 11086                                  RTL_9346_LOCK    equ 0x00
 11087                                  RTL_TPPOLL_NPQ   equ 0x40
 11088                                  
 11089                                  RTL_DESC_OWN     equ 0x80000000
 11090                                  RTL_DESC_EOR     equ 0x40000000
 11091                                  RTL_DESC_FS      equ 0x20000000
 11092                                  RTL_DESC_LS      equ 0x10000000
 11093                                  
 11094                                  RTL_RX_DESC_COUNT equ 8
 11095                                  RTL_TX_DESC_COUNT equ 8
 11096                                  RTL_RX_BUF_SIZE   equ 2048
 11097                                  
 11098                                  ; ---- I/O helpers -------------------------------------------------
 11099                                  ; nic_io_read8/16/32: edi = port -> al/ax/eax
 11100                                  nic_io_read8:
 11101 000093A2 6689FA                      mov dx, di
 11102 000093A5 EC                          in al, dx
 11103 000093A6 C3                          ret
 11104                                  nic_io_read16:
 11105 000093A7 6689FA                      mov dx, di
 11106 000093AA 66ED                        in ax, dx
 11107 000093AC C3                          ret
 11108                                  nic_io_read32:
 11109 000093AD 6689FA                      mov dx, di
 11110 000093B0 ED                          in eax, dx
 11111 000093B1 C3                          ret
 11112                                  ; nic_io_write8/16/32: edi = port, data in al/ax/eax
 11113                                  nic_io_write8:
 11114 000093B2 6689FA                      mov dx, di
 11115 000093B5 EE                          out dx, al
 11116 000093B6 C3                          ret
 11117                                  nic_io_write16:
 11118 000093B7 6689FA                      mov dx, di
 11119 000093BA 66EF                        out dx, ax
 11120 000093BC C3                          ret
 11121                                  nic_io_write32:
 11122 000093BD 6689FA                      mov dx, di
 11123 000093C0 EF                          out dx, eax
 11124 000093C1 C3                          ret
 11125                                  ; nic_io_read_block: edi = start port, rsi = dst, rcx = byte count
 11126                                  nic_io_read_block:
 11127 000093C2 50                          push rax
 11128 000093C3 51                          push rcx
 11129 000093C4 57                          push rdi
 11130 000093C5 56                          push rsi
 11131                                  .bloop:
 11132 000093C6 6689FA                      mov dx, di
 11133 000093C9 EC                          in al, dx
 11134 000093CA 8806                        mov [rsi], al
 11135 000093CC FFC7                        inc edi
 11136 000093CE 48FFC6                      inc rsi
 11137 000093D1 48FFC9                      dec rcx
 11138 000093D4 75F0                        jnz .bloop
 11139 000093D6 5E                          pop rsi
 11140 000093D7 5F                          pop rdi
 11141 000093D8 59                          pop rcx
 11142 000093D9 58                          pop rax
 11143 000093DA C3                          ret
 11144                                  
 11145                                  ; rtc_sec_now: eax = current RTC seconds (0..59), zero-extended. Used for
 11146                                  ; coarse 1s-granularity timeouts in the ARP / ICMP / DNS wait loops.
 11147                                  rtc_sec_now:
 11148 000093DB 53                          push rbx
 11149 000093DC 52                          push rdx
 11150                                  .rsn_retry:
 11151 000093DD E8CE2A0000                  call rtc_wait_uip            ; don't read while the RTC is mid-update
 11152 000093E2 B000                        mov al, 0x00
 11153 000093E4 E8B22A0000                  call cmos_read
 11154 000093E9 88C3                        mov bl, al                   ; first reading
 11155 000093EB E8C02A0000                  call rtc_wait_uip            ; guard again in case an update started
 11156                                                                    ; between our address-select and data read
 11157 000093F0 B000                        mov al, 0x00
 11158 000093F2 E8A42A0000                  call cmos_read
 11159 000093F7 38D8                        cmp al, bl
 11160 000093F9 75E2                        jne .rsn_retry                ; two reads disagree - torn/transient, retry
 11161                                      ; BUGFIX: this used to return the raw CMOS byte unconverted. Real
 11162                                      ; hardware defaults to BCD mode (status B bit2 clear), same as
 11163                                      ; rtc_update already accounts for - so a seconds value of "10" comes
 11164                                      ; back as the byte 0x10 (16 decimal), "20" as 0x20 (32 decimal), etc.
 11165                                      ; Tick DETECTION (a plain inequality compare against the previous
 11166                                      ; reading) still fired correctly every real second regardless, so the
 11167                                      ; wait loop's actual budget was never shortened by this - but the
 11168                                      ; elapsed-time SUBTRACTION in the error path assumes plain binary
 11169                                      ; 0..59 seconds, so once start/end straddle a tens-digit boundary the
 11170                                      ; math comes out wrong (this is why a real ~5-6s wait was being
 11171                                      ; reported as "elapsed: 0" in netdiag_dump_tx). Mirror rtc_update's
 11172                                      ; own check of status register B bit2 rather than assuming BCD
 11173                                      ; unconditionally - only convert if the chip is actually in BCD mode.
 11174 000093FB 50                          push rax
 11175 000093FC B00B                        mov al, 0x0B
 11176 000093FE E8982A0000                  call cmos_read
 11177 00009403 A804                        test al, 0x04
 11178 00009405 750D                        jnz .rsn_binary               ; bit2 set = already binary, nothing to do
 11179 00009407 58                          pop rax
 11180 00009408 88D8                        mov al, bl
 11181 0000940A E8AF2A0000                  call bcd_to_bin
 11182 0000940F 0FB6C0                      movzx eax, al
 11183 00009412 EB04                        jmp .rsn_done
 11184                                  .rsn_binary:
 11185 00009414 58                          pop rax
 11186 00009415 0FB6C3                      movzx eax, bl
 11187                                  .rsn_done:
 11188 00009418 5A                          pop rdx
 11189 00009419 5B                          pop rbx
 11190 0000941A C3                          ret
 11191                                  
 11192                                  ; ---- PCI ---------------------------------------------------------
 11193                                  ; pci_find_nic: scans bus 0 for vendor 10EC device 8139. Returns CF=0 and
 11194                                  ; nic_pci_bus/dev/func set, or CF=1.
 11195                                  ; pci_find_nic: brute-force scan of every PCI bus (0..255), every device
 11196                                  ; (0..31), function 0 first and then functions 1..7 if the header-type byte
 11197                                  ; says the device is multi-function - matching vendor 0x10EC/device 0x8139.
 11198                                  ; A bus-0-only scan (the original version of this routine) finds nothing on
 11199                                  ; real hardware, where the NIC typically sits behind a PCIe root port on a
 11200                                  ; non-zero bus; QEMU's flat topology just happened to put it on bus 0.
 11201                                  ; Returns CF=0 and nic_pci_bus/dev/func set, or CF=1.
 11202                                  pci_find_nic:
 11203 0000941B 50                          push rax
 11204 0000941C 53                          push rbx
 11205 0000941D 51                          push rcx
 11206 0000941E 52                          push rdx
 11207 0000941F 4150                        push r8
 11208 00009421 4151                        push r9
 11209 00009423 4153                        push r11
 11210 00009425 31DB                        xor ebx, ebx                     ; bus
 11211                                  .pbus_loop:
 11212 00009427 81FB00010000                cmp ebx, 256
 11213 0000942D 7371                        jae .pnot_found
 11214 0000942F 31C9                        xor ecx, ecx                     ; device
 11215                                  .pdev_loop:
 11216 00009431 83F920                      cmp ecx, 32
 11217 00009434 7366                        jae .pnext_bus
 11218 00009436 31D2                        xor edx, edx                     ; try function 0 first
 11219 00009438 4D31C0                      xor r8, r8
 11220 0000943B E861F6FFFF                  call pci_read32
 11221 00009440 83F8FF                      cmp eax, 0xFFFFFFFF
 11222 00009443 7453                        je .pnext_dev                    ; nothing at this slot at all
 11223 00009445 663DEC10                    cmp ax, NIC_VENDOR_ID
 11224 00009449 7509                        jne .pf0_no_match
 11225 0000944B C1E810                      shr eax, 16
 11226 0000944E 663D3981                    cmp ax, NIC_DEVICE_ID
 11227 00009452 7458                        je .pfound
 11228                                  .pf0_no_match:
 11229 00009454 31D2                        xor edx, edx
 11230 00009456 41B80C000000                mov r8, 0x0C                     ; header-type dword
 11231 0000945C E840F6FFFF                  call pci_read32
 11232 00009461 C1E810                      shr eax, 16
 11233 00009464 A880                        test al, 0x80                    ; multi-function bit
 11234 00009466 7430                        jz .pnext_dev                    ; single-function: nothing more here
 11235 00009468 41BB01000000                mov r11d, 1
 11236                                  .pfunc_loop:
 11237 0000946E 4183FB08                    cmp r11d, 8
 11238 00009472 7324                        jae .pnext_dev
 11239 00009474 4489DA                      mov edx, r11d
 11240 00009477 4D31C0                      xor r8, r8
 11241 0000947A E822F6FFFF                  call pci_read32
 11242 0000947F 83F8FF                      cmp eax, 0xFFFFFFFF
 11243 00009482 740F                        je .pfunc_next
 11244 00009484 663DEC10                    cmp ax, NIC_VENDOR_ID
 11245 00009488 7509                        jne .pfunc_next
 11246 0000948A C1E810                      shr eax, 16
 11247 0000948D 663D3981                    cmp ax, NIC_DEVICE_ID
 11248 00009491 7419                        je .pfound
 11249                                  .pfunc_next:
 11250 00009493 41FFC3                      inc r11d
 11251 00009496 EBD6                        jmp .pfunc_loop
 11252                                  .pnext_dev:
 11253 00009498 FFC1                        inc ecx
 11254 0000949A EB95                        jmp .pdev_loop
 11255                                  .pnext_bus:
 11256 0000949C FFC3                        inc ebx
 11257 0000949E EB87                        jmp .pbus_loop
 11258                                  .pnot_found:
 11259 000094A0 415B                        pop r11
 11260 000094A2 4159                        pop r9
 11261 000094A4 4158                        pop r8
 11262 000094A6 5A                          pop rdx
 11263 000094A7 59                          pop rcx
 11264 000094A8 5B                          pop rbx
 11265 000094A9 58                          pop rax
 11266 000094AA F9                          stc
 11267 000094AB C3                          ret
 11268                                  .pfound:
 11269 000094AC 881C25[3DCA0800]            mov [nic_pci_bus], bl
 11270 000094B3 880C25[3ECA0800]            mov [nic_pci_dev], cl
 11271 000094BA 881425[3FCA0800]            mov [nic_pci_func], dl
 11272 000094C1 415B                        pop r11
 11273 000094C3 4159                        pop r9
 11274 000094C5 4158                        pop r8
 11275 000094C7 5A                          pop rdx
 11276 000094C8 59                          pop rcx
 11277 000094C9 5B                          pop rbx
 11278 000094CA 58                          pop rax
 11279 000094CB F8                          clc
 11280 000094CC C3                          ret
 11281                                  
 11282                                  ; pci_find_e1000: brute-force scan of PCI bus 0, vendor 0x8086, matching any
 11283                                  ; device id in e1000_dev_ids. Real e1000-family silicon spans a lot of PCI
 11284                                  ; device ids across generations (82540/82541/82545/82546/82571-82574/...),
 11285                                  ; unlike the RTL8139's single fixed id, so this checks the incoming device
 11286                                  ; id against a table instead of one constant. QEMU's "e1000" model reports
 11287                                  ; 0x100E. Returns CF=0 and nic_pci_bus/dev/func set, or CF=1.
 11288                                  ; pci_find_e1000: brute-force scan of every PCI bus (0..255), every device,
 11289                                  ; function 0 first and then functions 1..7 if multi-function, vendor 0x8086,
 11290                                  ; matching any device id in e1000_dev_ids. Real e1000-family silicon spans a
 11291                                  ; lot of PCI device ids across generations (82540/82541/82545/82546/82571-
 11292                                  ; 82574/...), unlike the RTL8139's single fixed id, so this checks the
 11293                                  ; incoming device id against a table instead of one constant. QEMU's "e1000"
 11294                                  ; model reports 0x100E. A bus-0-only scan misses real hardware, where the
 11295                                  ; NIC usually sits behind a PCIe root port on a non-zero bus - see
 11296                                  ; pci_find_nic above for the same fix. Returns CF=0 and nic_pci_bus/dev/func
 11297                                  ; set, or CF=1.
 11298                                  pci_find_e1000:
 11299 000094CD 50                          push rax
 11300 000094CE 53                          push rbx
 11301 000094CF 51                          push rcx
 11302 000094D0 52                          push rdx
 11303 000094D1 4150                        push r8
 11304 000094D3 4151                        push r9
 11305 000094D5 4152                        push r10
 11306 000094D7 4153                        push r11
 11307 000094D9 31DB                        xor ebx, ebx                     ; bus
 11308                                  .ebus_loop:
 11309 000094DB 81FB00010000                cmp ebx, 256
 11310 000094E1 0F83B1000000                jae .enot_found
 11311 000094E7 31C9                        xor ecx, ecx                     ; device
 11312                                  .edev_loop:
 11313 000094E9 83F920                      cmp ecx, 32
 11314 000094EC 0F839F000000                jae .enext_bus
 11315 000094F2 31D2                        xor edx, edx                     ; try function 0 first
 11316 000094F4 4D31C0                      xor r8, r8
 11317 000094F7 E8A5F5FFFF                  call pci_read32
 11318 000094FC 83F8FF                      cmp eax, 0xFFFFFFFF
 11319 000094FF 0F8485000000                je .enext_dev                    ; nothing at this slot at all
 11320 00009505 663D8680                    cmp ax, E1000_VENDOR_ID
 11321 00009509 7524                        jne .ef0_no_match
 11322 0000950B C1E810                      shr eax, 16                      ; eax = device id
 11323 0000950E 4C8D0C25[F8430900]          lea r9, [e1000_dev_ids]
 11324 00009516 41BA1D000000                mov r10d, E1000_DEV_ID_COUNT
 11325                                  .ecmp_loop0:
 11326 0000951C 66413901                    cmp word [r9], ax
 11327 00009520 0F8480000000                je .efound
 11328 00009526 4983C102                    add r9, 2
 11329 0000952A 41FFCA                      dec r10d
 11330 0000952D 75ED                        jnz .ecmp_loop0
 11331                                  .ef0_no_match:
 11332 0000952F 31D2                        xor edx, edx
 11333 00009531 41B80C000000                mov r8, 0x0C                     ; header-type dword
 11334 00009537 E865F5FFFF                  call pci_read32
 11335 0000953C C1E810                      shr eax, 16
 11336 0000953F A880                        test al, 0x80                    ; multi-function bit
 11337 00009541 7447                        jz .enext_dev                    ; single-function: nothing more here
 11338 00009543 41BB01000000                mov r11d, 1
 11339                                  .efunc_loop:
 11340 00009549 4183FB08                    cmp r11d, 8
 11341 0000954D 733B                        jae .enext_dev
 11342 0000954F 4489DA                      mov edx, r11d
 11343 00009552 4D31C0                      xor r8, r8
 11344 00009555 E847F5FFFF                  call pci_read32
 11345 0000955A 83F8FF                      cmp eax, 0xFFFFFFFF
 11346 0000955D 7426                        je .efunc_next
 11347 0000955F 663D8680                    cmp ax, E1000_VENDOR_ID
 11348 00009563 7520                        jne .efunc_next
 11349 00009565 C1E810                      shr eax, 16
 11350 00009568 4C8D0C25[F8430900]          lea r9, [e1000_dev_ids]
 11351 00009570 41BA1D000000                mov r10d, E1000_DEV_ID_COUNT
 11352                                  .ecmp_loopN:
 11353 00009576 66413901                    cmp word [r9], ax
 11354 0000957A 742A                        je .efound
 11355 0000957C 4983C102                    add r9, 2
 11356 00009580 41FFCA                      dec r10d
 11357 00009583 75F1                        jnz .ecmp_loopN
 11358                                  .efunc_next:
 11359 00009585 41FFC3                      inc r11d
 11360 00009588 EBBF                        jmp .efunc_loop
 11361                                  .enext_dev:
 11362 0000958A FFC1                        inc ecx
 11363 0000958C E958FFFFFF                  jmp .edev_loop
 11364                                  .enext_bus:
 11365 00009591 FFC3                        inc ebx
 11366 00009593 E943FFFFFF                  jmp .ebus_loop
 11367                                  .enot_found:
 11368 00009598 415B                        pop r11
 11369 0000959A 415A                        pop r10
 11370 0000959C 4159                        pop r9
 11371 0000959E 4158                        pop r8
 11372 000095A0 5A                          pop rdx
 11373 000095A1 59                          pop rcx
 11374 000095A2 5B                          pop rbx
 11375 000095A3 58                          pop rax
 11376 000095A4 F9                          stc
 11377 000095A5 C3                          ret
 11378                                  .efound:
 11379 000095A6 881C25[3DCA0800]            mov [nic_pci_bus], bl
 11380 000095AD 880C25[3ECA0800]            mov [nic_pci_dev], cl
 11381 000095B4 881425[3FCA0800]            mov [nic_pci_func], dl
 11382 000095BB 415B                        pop r11
