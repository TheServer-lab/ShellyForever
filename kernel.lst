  7201 00005D47 B008                        mov al, 0x08
  7202 00005D49 E871FFFFFF                  call cmos_read
  7203 00005D4E 880425[10CE0000]            mov [rtc_month], al
  7204 00005D55 B009                        mov al, 0x09
  7205 00005D57 E863FFFFFF                  call cmos_read
