  6891                                      ; prs_peek_buf[0..r15) = newest output. Find the first byte of the
  6892                                      ; last N lines (the trailing newline terminates the last line; count
  6893                                      ; newlines backwards from there).
  6894 000162A6 41B800000000                mov r8, 0                       ; print start
  6895 000162AC 4C89F9                      mov rcx, r15
  6896 000162AF 4883F900                    cmp rcx, 0
  6897 000162B3 7434                        je .ppr_scan_done2
  6898 000162B5 48FFC9                      dec rcx
  6899 000162B8 488DB1[2F880800]            lea rsi, [prs_peek_buf + rcx]
  6900 000162BF 803E0A                      cmp byte [rsi], 0x0A
  6901 000162C2 7503                        jne .ppr_scan2
  6902 000162C4 48FFC9                      dec rcx                         ; skip the trailing newline
  6903                                  .ppr_scan2:
  6904 000162C7 4883F900                    cmp rcx, 0
  6905 000162CB 7C1C                        jl .ppr_scan_done2              ; all lines kept: print from 0
  6906 000162CD 488DB1[2F880800]            lea rsi, [prs_peek_buf + rcx]
  6907 000162D4 803E0A                      cmp byte [rsi], 0x0A
  6908 000162D7 7505                        jne .ppr_scan_dec
  6909 000162D9 49FFCD                      dec r13
