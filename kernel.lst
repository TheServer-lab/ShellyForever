 13278 000146A8 488D3425[D08B0100]          lea rsi, [live_snapshot]
 13279 000146B0 BF00800B00                  mov rdi, VGA_BASE
 13280 000146B5 B9A00F0000                  mov rcx, VGA_ROWS*VGA_COLS*2
