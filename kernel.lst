  8020                                  ; ---- PCI ---------------------------------------------------------
  8021                                  ; pci_find_nic: scans bus 0 for vendor 10EC device 8139. Returns CF=0 and
  8022                                  ; nic_pci_bus/dev/func set, or CF=1.
  8023                                  ; pci_find_nic: brute-force scan of every PCI bus (0..255), every device
  8024                                  ; (0..31), function 0 first and then functions 1..7 if the header-type byte
  8025                                  ; says the device is multi-function - matching vendor 0x10EC/device 0x8139.
  8026                                  ; A bus-0-only scan (the original version of this routine) finds nothing on
  8027                                  ; real hardware, where the NIC typically sits behind a PCIe root port on a
  8028                                  ; non-zero bus; QEMU's flat topology just happened to put it on bus 0.
  8029                                  ; Returns CF=0 and nic_pci_bus/dev/func set, or CF=1.
  8030                                  pci_find_nic:
  8031 00006B90 50                          push rax
  8032 00006B91 53                          push rbx
  8033 00006B92 51                          push rcx
  8034 00006B93 52                          push rdx
  8035 00006B94 4150                        push r8
  8036 00006B96 4151                        push r9
  8037 00006B98 4153                        push r11
  8038 00006B9A 31DB                        xor ebx, ebx                     ; bus
  8039                                  .pbus_loop:
  8040 00006B9C 81FB00010000                cmp ebx, 256
  8041 00006BA2 7371                        jae .pnot_found
  8042 00006BA4 31C9                        xor ecx, ecx                     ; device
  8043                                  .pdev_loop:
  8044 00006BA6 83F920                      cmp ecx, 32
  8045 00006BA9 7366                        jae .pnext_bus
  8046 00006BAB 31D2                        xor edx, edx                     ; try function 0 first
  8047 00006BAD 4D31C0                      xor r8, r8
  8048 00006BB0 E88DF6FFFF                  call pci_read32
  8049 00006BB5 83F8FF                      cmp eax, 0xFFFFFFFF
  8050 00006BB8 7453                        je .pnext_dev                    ; nothing at this slot at all
  8051 00006BBA 663DEC10                    cmp ax, NIC_VENDOR_ID
  8052 00006BBE 7509                        jne .pf0_no_match
  8053 00006BC0 C1E810                      shr eax, 16
  8054 00006BC3 663D3981                    cmp ax, NIC_DEVICE_ID
  8055 00006BC7 7458                        je .pfound
  8056                                  .pf0_no_match:
  8057 00006BC9 31D2                        xor edx, edx
  8058 00006BCB 41B80C000000                mov r8, 0x0C                     ; header-type dword
  8059 00006BD1 E86CF6FFFF                  call pci_read32
  8060 00006BD6 C1E810                      shr eax, 16
  8061 00006BD9 A880                        test al, 0x80                    ; multi-function bit
  8062 00006BDB 7430                        jz .pnext_dev                    ; single-function: nothing more here
  8063 00006BDD 41BB01000000                mov r11d, 1
  8064                                  .pfunc_loop:
  8065 00006BE3 4183FB08                    cmp r11d, 8
