 17102 000714A2 57                          push rdi
 17103 000714A3 4C89C2                      mov rdx, r8
 17104 000714A6 4C29DA                      sub rdx, r11                 ; rdx = tail length (buffer chars to draw)
 17105 000714A9 4889D7                      mov rdi, rdx
 17106 000714AC 4801CF                      add rdi, rcx                 ; rdi = total cells printed = walk-back distance
 17107 000714AF 4C89DE                      mov rsi, r11                 ; rsi walks r11..r8-1 as a buffer index directly
 17108                                  .rt_buf_loop:
