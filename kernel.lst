  6911                                  .ppr_scan_dec:
  6912 000162DE 48FFC9                      dec rcx
  6913 000162E1 EBE4                        jmp .ppr_scan2
  6914                                  .ppr_found:
  6915 000162E3 4989C8                      mov r8, rcx
