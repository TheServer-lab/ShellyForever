 13594                                  
 13595                                  ; netdiag_dump_tx_frame: prints a hex dump of the fully-assembled frame
 13596                                  ; about to leave the NIC (eth header + ip header + payload), 16
 13597                                  ; space-separated hex bytes per line, so it can be checked by hand
 13598                                  ; against RFC 2131/RFC 791 field offsets when there's no external
 13599                                  ; capture tool available. rsi = frame ptr, rcx = frame length in bytes.
 13600                                  ; Only called when nic_diag_verbose is set (during the dhcp wait), so
 13601                                  ; normal shell use isn't spammed by a dump on every packet sent.
 13602                                  netdiag_dump_tx_frame:
 13603 0001AA1F 50                          push rax
 13604 0001AA20 53                          push rbx
 13605 0001AA21 51                          push rcx
 13606 0001AA22 52                          push rdx
 13607 0001AA23 56                          push rsi
 13608 0001AA24 57                          push rdi
 13609 0001AA25 31DB                        xor ebx, ebx            ; ebx = bytes printed on the current line
 13610                                  .ndtf_loop:
 13611 0001AA27 4885C9                      test rcx, rcx
 13612 0001AA2A 7427                        jz .ndtf_flush
 13613 0001AA2C 0FB606                      movzx eax, byte [rsi]
 13614 0001AA2F E81DFEFFFF                  call print_hex8
 13615 0001AA34 B020                        mov al, ' '
 13616 0001AA36 E82D200100                  call putchar
 13617 0001AA3B 48FFC6                      inc rsi
 13618 0001AA3E 48FFC9                      dec rcx
 13619 0001AA41 FFC3                        inc ebx
 13620 0001AA43 83FB10                      cmp ebx, 16
 13621 0001AA46 75DF                        jne .ndtf_loop
 13622 0001AA48 B00A                        mov al, 10
 13623 0001AA4A E819200100                  call putchar
 13624 0001AA4F 31DB                        xor ebx, ebx
 13625 0001AA51 EBD4                        jmp .ndtf_loop
 13626                                  .ndtf_flush:
 13627 0001AA53 85DB                        test ebx, ebx
 13628 0001AA55 7407                        jz .ndtf_done
 13629 0001AA57 B00A                        mov al, 10
 13630 0001AA59 E80A200100                  call putchar
 13631                                  .ndtf_done:
 13632 0001AA5E 5F                          pop rdi
 13633 0001AA5F 5E                          pop rsi
 13634 0001AA60 5A                          pop rdx
 13635 0001AA61 59                          pop rcx
 13636 0001AA62 5B                          pop rbx
 13637 0001AA63 58                          pop rax
 13638 0001AA64 C3                          ret
 13639                                  
 13640                                  ; print_ip4: rsi = 4-byte IP -> prints "a.b.c.d".
 13641                                  print_ip4:
 13642 0001AA65 56                          push rsi
 13643 0001AA66 57                          push rdi
 13644 0001AA67 488D3C25[A4AA0600]          lea rdi, [net_ip_str]
 13645 0001AA6F E816FDFFFF                  call ipv4_to_str
 13646 0001AA74 488D3425[A4AA0600]          lea rsi, [net_ip_str]
 13647 0001AA7C E87C1F0100                  call print_string
 13648 0001AA81 5F                          pop rdi
 13649 0001AA82 5E                          pop rsi
 13650 0001AA83 C3                          ret
 13651                                  
 13652                                  ; fs_save: writes the OS volume ([boot_device], nodes 0..OS_NODES) then
 13653                                  ; every mounted volume back to its own device. Returns CF=0 on success,
 13654                                  ; CF=1 if the OS volume's disk isn't there/isn't responding. A mounted
 13655                                  ; volume that fails to write is left mounted (best effort; sync still
 13656                                  ; reports success).
 13657                                  fs_save:
 13658 0001AA84 50                          push rax
 13659 0001AA85 53                          push rbx
 13660 0001AA86 56                          push rsi
 13661 0001AA87 57                          push rdi
 13662 0001AA88 4155                        push r13
 13663 0001AA8A 4156                        push r14
 13664 0001AA8C 4530F6                      xor r14b, r14b                ; r14b = 1 once anything has actually been saved
 13665 0001AA8F 803C25[51E80500]00          cmp byte [fs_disk_available], 0
 13666 0001AA97 741D                        je .skip_os_volume            ; no OS disk responded this session - don't retry
 13667                                                                     ; it, but still try any mounted AHCI volumes below
 13668                                      ; OS volume: [boot_device] (0 = legacy ATA boot drive, 4+ = an AHCI slot
 13669                                      ; fs_load fell back to), base 0, label = root node's name
 13670 0001AA99 488D3425[50960300]          lea rsi, [node_name]
 13671 0001AAA1 4831FF                      xor rdi, rdi
 13672 0001AAA4 0FB60425[52E80500]          movzx eax, byte [boot_device]
 13673 0001AAAC E8B0D8FFFF                  call vol_write
 13674 0001AAB1 7258                        jc .disk_gone
 13675 0001AAB3 41B601                      mov r14b, 1
 13676                                  .skip_os_volume:
 13677                                      ; mounted volumes
 13678 0001AAB6 4D31ED                      xor r13, r13
 13679                                  .mount_loop:
 13680 0001AAB9 4983FD02                    cmp r13, MAX_MOUNTS
 13681 0001AABD 733C                        jae .check_any
 13682 0001AABF 4180BD[4E8A0300]00          cmp byte [mount_used + r13], 0
 13683 0001AAC7 742D                        je .mount_next
 13684 0001AAC9 490FB685[4C8A0300]          movzx rax, byte [mount_device + r13]
 13685 0001AAD1 4C89EF                      mov rdi, r13
 13686 0001AAD4 48FFC7                      inc rdi
 13687 0001AAD7 4869FF00010000              imul rdi, VOL_NODES
 13688 0001AADE 4C89EB                      mov rbx, r13
 13689 0001AAE1 486BDB20                    imul rbx, 32
 13690 0001AAE5 488DB3[0C8A0300]            lea rsi, [mount_label + rbx]
 13691 0001AAEC E870D8FFFF                  call vol_write
 13692 0001AAF1 7203                        jc .mount_next                ; a mounted volume failing to save is not fatal;
 13693 0001AAF3 41B601                      mov r14b, 1                   ; keep it mounted, just don't count it as saved
 13694                                  .mount_next:
 13695 0001AAF6 49FFC5                      inc r13
 13696 0001AAF9 EBBE                        jmp .mount_loop
 13697                                  .check_any:
 13698 0001AAFB 4180FE00                    cmp r14b, 0
 13699 0001AAFF 7414                        je .fail                      ; nothing at all got saved - genuinely no disk
 13700 0001AB01 415E                        pop r14
 13701 0001AB03 415D                        pop r13
 13702 0001AB05 5F                          pop rdi
 13703 0001AB06 5E                          pop rsi
 13704 0001AB07 5B                          pop rbx
 13705 0001AB08 58                          pop rax
 13706 0001AB09 F8                          clc
 13707 0001AB0A C3                          ret
 13708                                  .disk_gone:
 13709 0001AB0B C60425[51E80500]00          mov byte [fs_disk_available], 0
 13710 0001AB13 EBA1                        jmp .skip_os_volume
 13711                                  .fail:
 13712 0001AB15 415E                        pop r14
 13713 0001AB17 415D                        pop r13
 13714 0001AB19 5F                          pop rdi
 13715 0001AB1A 5E                          pop rsi
 13716 0001AB1B 5B                          pop rbx
 13717 0001AB1C 58                          pop rax
 13718 0001AB1D F9                          stc
 13719 0001AB1E C3                          ret
 13720                                  
 13721                                  ; fs_load: reads the OS volume into nodes 0..OS_NODES. Tries device 0
 13722                                  ; (legacy ATA primary master) first, exactly as always. If that device
 13723                                  ; never responds at all - common on real hardware that has no PATA/IDE
 13724                                  ; controller and only exposes its disk(s) over SATA - it then looks
 13725                                  ; through whatever AHCI port slots (4..4+ahci_port_count-1) ahci_init
 13726                                  ; found at boot, preferring one that already holds a valid SFFS volume,
 13727                                  ; falling back to the first one that simply responds (a blank/new SATA
 13728                                  ; SSD) so a fresh filesystem still has somewhere to persist to. Whichever
 13729                                  ; device actually ends up holding the OS volume is remembered in
 13730                                  ; [boot_device] for fs_save (and cmd_format's "don't touch the boot
 13731                                  ; drive" check) to use afterwards. If nothing responds anywhere, falls
 13732                                  ; back to fs_init for a fresh in-memory-only filesystem.
 13733                                  ; Mounted volumes are never loaded here - you re-attach them after boot
 13734                                  ; with 'dscan' + 'mount'.
 13735                                  ; sets fs_loaded_from_disk, fs_disk_available and boot_device accordingly.
 13736                                  fs_load:
 13737 0001AB1F 50                          push rax
 13738 0001AB20 53                          push rbx
 13739 0001AB21 51                          push rcx
 13740 0001AB22 57                          push rdi
 13741 0001AB23 56                          push rsi
 13742 0001AB24 C60425[52E80500]00          mov byte [boot_device], 0
 13743 0001AB2C 30C0                        xor al, al                  ; device 0 (boot drive) - legacy ATA, tried first
 13744 0001AB2E 4831FF                      xor rdi, rdi                ; base 0 = OS volume
 13745 0001AB31 E8E1D4FFFF                  call vol_read
 13746 0001AB36 4883F8FF                    cmp rax, -1
 13747 0001AB3A 0F85D1000000                jne .loaded
 13748                                      ; device 0 gave us nothing. If it's present but just not SFFS (blank
 13749                                      ; disk, older format, ...) keep it as the boot device exactly like
 13750                                      ; before - only chase AHCI slots when device 0 wasn't there at all.
 13751 0001AB40 803C25[51E80500]00          cmp byte [fs_disk_available], 0
 13752 0001AB48 7412                        je .try_ahci
 13753 0001AB4A E864C4FFFF                  call fs_init
 13754 0001AB4F C60425[50E80500]00          mov byte [fs_loaded_from_disk], 0
 13755 0001AB57 E9C9000000                  jmp .done
 13756                                  .try_ahci:
 13757 0001AB5C 0FB60C25[70E80500]          movzx ecx, byte [ahci_port_count]
 13758 0001AB64 85C9                        test ecx, ecx
 13759 0001AB66 0F8486000000                jz .no_disk                 ; no AHCI controller/ports either - genuinely nothing
 13760                                      ; pass 1: any AHCI slot that already has a valid SFFS volume on it
 13761 0001AB6C 31DB                        xor ebx, ebx
 13762                                  .ahci_sffs_scan:
 13763 0001AB6E 39CB                        cmp ebx, ecx
 13764 0001AB70 731D                        jae .ahci_blank_scan
 13765 0001AB72 678D4304                    lea eax, [ebx + 4]           ; device id 4+slot
 13766 0001AB76 880425[52E80500]            mov byte [boot_device], al
 13767 0001AB7D 4831FF                      xor rdi, rdi
 13768 0001AB80 E892D4FFFF                  call vol_read
 13769 0001AB85 4883F8FF                    cmp rax, -1
 13770 0001AB89 7549                        jne .ahci_found
 13771 0001AB8B FFC3                        inc ebx
 13772 0001AB8D EBDF                        jmp .ahci_sffs_scan
 13773                                      ; pass 2: no AHCI slot had a ready SFFS volume yet - use the first one
 13774                                      ; that at least responds (freshly flashed/blank SATA SSD) as the boot
 13775                                      ; device, so a fresh in-memory filesystem has somewhere to save to.
 13776                                  .ahci_blank_scan:
 13777 0001AB8F 31DB                        xor ebx, ebx
 13778                                  .ahci_blank_loop:
 13779 0001AB91 39CB                        cmp ebx, ecx
 13780 0001AB93 735D                        jae .no_disk
 13781 0001AB95 678D4304                    lea eax, [ebx + 4]
 13782 0001AB99 880425[52E80500]            mov byte [boot_device], al
 13783 0001ABA0 E852CFFFFF                  call disk_select_device
 13784 0001ABA5 B818060000                  mov rax, SUPER_LBA
 13785 0001ABAA 488D3C25[88850300]          lea rdi, [fs_super_buf]
 13786 0001ABB2 E867CFFFFF                  call disk_read_sector
 13787 0001ABB7 7304                        jnc .ahci_blank_present
 13788 0001ABB9 FFC3                        inc ebx
 13789 0001ABBB EBD4                        jmp .ahci_blank_loop
 13790                                  .ahci_blank_present:
 13791 0001ABBD C60425[51E80500]01          mov byte [fs_disk_available], 1
 13792 0001ABC5 E8E9C3FFFF                  call fs_init
 13793 0001ABCA C60425[50E80500]00          mov byte [fs_loaded_from_disk], 0
 13794 0001ABD2 EB51                        jmp .done
 13795                                  .ahci_found:
 13796 0001ABD4 C60425[51E80500]01          mov byte [fs_disk_available], 1
 13797 0001ABDC 48C70425[BBD70200]-         mov qword [cur_dir], 0
 13797 0001ABE4 00000000           
 13798 0001ABE8 C60425[50E80500]01          mov byte [fs_loaded_from_disk], 1
 13799 0001ABF0 EB33                        jmp .done
 13800                                  .no_disk:
 13801 0001ABF2 C60425[51E80500]00          mov byte [fs_disk_available], 0
 13802 0001ABFA C60425[52E80500]00          mov byte [boot_device], 0
 13803 0001AC02 E8ACC3FFFF                  call fs_init
 13804 0001AC07 C60425[50E80500]00          mov byte [fs_loaded_from_disk], 0
 13805 0001AC0F EB14                        jmp .done
 13806                                  .loaded:
 13807 0001AC11 48C70425[BBD70200]-         mov qword [cur_dir], 0
 13807 0001AC19 00000000           
 13808 0001AC1D C60425[50E80500]01          mov byte [fs_loaded_from_disk], 1
 13809                                  .done:
 13810 0001AC25 5E                          pop rsi
 13811 0001AC26 5F                          pop rdi
 13812 0001AC27 59                          pop rcx
 13813 0001AC28 5B                          pop rbx
 13814 0001AC29 58                          pop rax
 13815 0001AC2A C3                          ret
