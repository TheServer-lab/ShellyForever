  1484 00027018 00000000            <1>
  1485 0002701C 48C70425[58270300]- <1>     mov qword [party_call_depth], 0
  1485 00027024 00000000            <1>
  1486 00027028 48C70425[60270300]- <1>     mov qword [party_loc_count], 0
  1486 00027030 00000000            <1>
  1487 00027034 48C70425[68270300]- <1>     mov qword [party_func_count], 0
  1487 0002703C 00000000            <1>
  1488 00027040 48C70425[48270300]- <1>     mov qword [party_err_msg_ptr], 0
  1488 00027048 00000000            <1>
  1489                              <1> 
  1490 0002704C 488D3C25[38300300]  <1>     lea rdi, [party_var_used]
  1491 00027054 B920000000          <1>     mov rcx, MAXVARS
  1492 00027059 E81D0E0000          <1>     call party_memzero
  1493 0002705E 488D3C25[58390300]  <1>     lea rdi, [party_loc_used]
  1494 00027066 B940000000          <1>     mov rcx, MAXLOCALS
