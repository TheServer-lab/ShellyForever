 15296                                  ; ============================================================
 15297                                  ;  loading spinner: a tiny |/-\ animation for operations that take a
 15298                                  ;  visible moment (scanning drives, formatting). spinner_step draws one
 15299                                  ;  frame at the current cursor cell and steps the cursor back onto that
 15300                                  ;  same cell, so repeated calls animate in place instead of scrolling
 15301                                  ;  text across the screen; spinner_clear blanks that cell again once
 15302                                  ;  the operation is done, leaving the cursor exactly where it was.
 15303                                  ; ============================================================
 15304 0002CC62 00                      spinner_idx: db 0
 15305 0002CC63 7C2F2D5C                spinner_frames: db '|','/','-','\'
 15306                                  
 15307                                  spinner_step:
 15308 0002CC67 50                          push rax
 15309 0002CC68 53                          push rbx
 15310 0002CC69 51                          push rcx
 15311 0002CC6A 480FB60425-                 movzx rax, byte [spinner_idx]
 15311 0002CC6F [62CC0200]         
 15312 0002CC73 2403                        and al, 3
 15313 0002CC75 480FB6C8                    movzx rcx, al
 15314 0002CC79 8A81[63CC0200]              mov al, [spinner_frames + rcx]
 15315 0002CC7F 8A1C25[C4D70200]            mov bl, [cur_normal_attr]
 15316 0002CC86 E8DDFDFFFF                  call putchar
 15317 0002CC8B FE0C25[B9D70200]            dec byte [cursor_col]
 15318 0002CC92 E8CEFCFFFF                  call update_cursor
 15319 0002CC97 FE0425[62CC0200]            inc byte [spinner_idx]
 15320 0002CC9E 59                          pop rcx
 15321 0002CC9F 5B                          pop rbx
 15322 0002CCA0 58                          pop rax
 15323 0002CCA1 C3                          ret
 15324                                  
 15325                                  spinner_clear:
 15326 0002CCA2 50                          push rax
 15327 0002CCA3 53                          push rbx
 15328 0002CCA4 B020                        mov al, ' '
 15329 0002CCA6 8A1C25[C4D70200]            mov bl, [cur_normal_attr]
 15330 0002CCAD E8B6FDFFFF                  call putchar
 15331 0002CCB2 FE0C25[B9D70200]            dec byte [cursor_col]
 15332 0002CCB9 E8A7FCFFFF                  call update_cursor
 15333 0002CCBE 5B                          pop rbx
 15334 0002CCBF 58                          pop rax
 15335 0002CCC0 C3                          ret
