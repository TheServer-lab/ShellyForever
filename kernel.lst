 10504                                  
 10505                                  ; pci_pm_wake: force the device at nic_pci_bus/dev/func out of D3 into D0
 10506                                  ; via its PCI Power Management capability, if it has one. On real hardware,
 10507                                  ; firmware quite often leaves an onboard NIC parked in D3hot at handoff
 10508                                  ; (or a previous OS's ACPI driver put it there and a warm reset didn't
 10509                                  ; clear it) - config/IO/MMIO reads and writes to a device in D3 are
 10510                                  ; unreliable (commonly read back as all-1s/garbage, writes silently
 10511                                  ; dropped), so every other fix in the bring-up path is moot until this
 10512                                  ; runs. QEMU's virtual devices are always already in D0, which is why
 10513                                  ; this was invisible there. Walks the capabilities list from offset 0x34
 10514                                  ; looking for PCI_CAP_ID_PM (0x01), clears the PowerState bits in PMCSR
 10515                                  ; (cap_ptr+4) to select D0, then waits >=10ms per the PCI PM spec before
 10516                                  ; the device's config space is touched again. No-op if the device has no
 10517                                  ; PM capability, or is already in D0.
 10518                                  pci_pm_wake:
 10519 000188B1 50                          push rax
 10520 000188B2 53                          push rbx
 10521 000188B3 51                          push rcx
 10522 000188B4 52                          push rdx
 10523 000188B5 4150                        push r8
 10524 000188B7 4151                        push r9
 10525 000188B9 4152                        push r10
 10526 000188BB 4153                        push r11
 10527                                  
 10528 000188BD 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10529 000188C5 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10530 000188CD 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10531 000188D5 41B034                      mov r8b, 0x34                  ; Capabilities Pointer register
 10532 000188D8 E867F2FFFF                  call pci_read32
 10533 000188DD 440FB6D8                    movzx r11d, al                 ; r11 = offset of first capability
 10534                                  .pmw_walk:
 10535 000188E1 4585DB                      test r11d, r11d
 10536 000188E4 0F8497000000                jz .pmw_done                   ; end of list: no PM capability, nothing to do
 10537 000188EA 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10538 000188F2 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10539 000188FA 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10540 00018902 4589D8                      mov r8d, r11d
 10541 00018905 4181E0FC000000              and r8d, 0xFC
 10542 0001890C E833F2FFFF                  call pci_read32                ; al=cap id, ah=next ptr (bits 8:15 of eax)
 10543 00018911 3C01                        cmp al, 0x01                   ; PCI_CAP_ID_PM
 10544 00018913 740D                        je .pmw_found
 10545 00018915 4189C2                      mov r10d, eax
 10546 00018918 41C1EA08                    shr r10d, 8
 10547 0001891C 450FB6DA                    movzx r11d, r10b               ; next capability pointer
 10548 00018920 EBBF                        jmp .pmw_walk
 10549                                  .pmw_found:
 10550 00018922 4589D9                      mov r9d, r11d
 10551 00018925 4181E1FC000000              and r9d, 0xFC
 10552 0001892C 4183C104                    add r9d, 4                     ; PMCSR lives in the dword right after the cap header
 10553 00018930 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10554 00018938 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10555 00018940 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10556 00018948 4589C8                      mov r8d, r9d
 10557 0001894B E8F4F1FFFF                  call pci_read32
 10558 00018950 83E0FC                      and eax, 0xFFFFFFFC            ; PowerState = 00b -> D0 (bits 1:0 of PMCSR)
 10559 00018953 4189C2                      mov r10d, eax
 10560 00018956 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10561 0001895E 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10562 00018966 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10563 0001896E 4589C8                      mov r8d, r9d
 10564 00018971 E818F2FFFF                  call pci_write32
 10565                                      ; PCI Power Management spec: after a D3hot->D0 transition, software
 10566                                      ; must not access the function's config/IO/memory space for >=10ms.
 10567 00018976 41B900000008                mov r9, 0x8000000
 10568                                  .pmw_delay:
 10569 0001897C 49FFC9                      dec r9
 10570 0001897F 75FB                        jnz .pmw_delay
 10571                                  .pmw_done:
 10572 00018981 415B                        pop r11
 10573 00018983 415A                        pop r10
 10574 00018985 4159                        pop r9
 10575 00018987 4158                        pop r8
 10576 00018989 5A                          pop rdx
 10577 0001898A 59                          pop rcx
 10578 0001898B 5B                          pop rbx
 10579 0001898C 58                          pop rax
 10580 0001898D C3                          ret
 10581                                  
 10582                                  ; pci_disable_aspm: clear ASPM (Active State Power Management, L0s/L1) in the
 10583                                  ; PCI Express Capability's Link Control register for the device at
 10584                                  ; nic_pci_bus/dev/func, if it has one. Firmware on most real boards leaves
 10585                                  ; ASPM enabled by default; a driver that only pokes the legacy I/O BAR and
 10586                                  ; never does the associated PCIe link power-state handshake can end up with
 10587                                  ; a chip whose descriptor-DMA engine stalls in a low-power link state - a TX
 10588                                  ; descriptor gets handed to it (OWN set) but the engine never actually
 10589                                  ; drains it, even though the copper PHY link itself is up (PHY link state
 10590                                  ; and PCIe link power state are independent). QEMU's virtual PCIe root port
 10591                                  ; doesn't implement ASPM at all, which is why this is invisible there. Walks
 10592                                  ; the same capabilities list pci_pm_wake does, looking for PCI_CAP_ID_EXP
 10593                                  ; (0x10) this time, then clears bits 1:0 (ASPM Control) of the Link Control
 10594                                  ; register at cap_ptr+0x10. No-op if the device has no PCIe capability, or
 10595                                  ; ASPM is already off.
 10596                                  PCI_CAP_ID_EXP equ 0x10
 10597                                  pci_disable_aspm:
 10598 0001898E 50                          push rax
 10599 0001898F 53                          push rbx
 10600 00018990 51                          push rcx
 10601 00018991 52                          push rdx
 10602 00018992 4150                        push r8
 10603 00018994 4151                        push r9
 10604 00018996 4152                        push r10
 10605 00018998 4153                        push r11
 10606                                  
 10607 0001899A 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10608 000189A2 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10609 000189AA 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10610 000189B2 41B034                      mov r8b, 0x34                  ; Capabilities Pointer register
 10611 000189B5 E88AF1FFFF                  call pci_read32
 10612 000189BA 440FB6D8                    movzx r11d, al                 ; r11 = offset of first capability
 10613                                  .asp_walk:
 10614 000189BE 4585DB                      test r11d, r11d
 10615 000189C1 0F848C000000                jz .asp_done                   ; end of list: no PCIe capability
 10616 000189C7 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10617 000189CF 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10618 000189D7 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10619 000189DF 4589D8                      mov r8d, r11d
 10620 000189E2 4181E0FC000000              and r8d, 0xFC
 10621 000189E9 E856F1FFFF                  call pci_read32                ; al=cap id, ah=next ptr (bits 8:15)
 10622 000189EE 3C10                        cmp al, PCI_CAP_ID_EXP
 10623 000189F0 740D                        je .asp_found
 10624 000189F2 4189C2                      mov r10d, eax
 10625 000189F5 41C1EA08                    shr r10d, 8
 10626 000189F9 450FB6DA                    movzx r11d, r10b
 10627 000189FD EBBF                        jmp .asp_walk
 10628                                  .asp_found:
 10629 000189FF 4589D9                      mov r9d, r11d
 10630 00018A02 4181E1FC000000              and r9d, 0xFC
 10631 00018A09 4183C110                    add r9d, 0x10                  ; Link Control register: cap_ptr+0x10 (word)
 10632 00018A0D 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10633 00018A15 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10634 00018A1D 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10635 00018A25 4589C8                      mov r8d, r9d
 10636 00018A28 E817F1FFFF                  call pci_read32
 10637 00018A2D 83E0FC                      and eax, 0xFFFFFFFC             ; clear ASPM Control (bits 1:0): L0s/L1 off
 10638 00018A30 4189C2                      mov r10d, eax
 10639 00018A33 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10640 00018A3B 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10641 00018A43 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10642 00018A4B 4589C8                      mov r8d, r9d
 10643 00018A4E E83BF1FFFF                  call pci_write32
 10644                                  .asp_done:
 10645 00018A53 415B                        pop r11
 10646 00018A55 415A                        pop r10
 10647 00018A57 4159                        pop r9
 10648 00018A59 4158                        pop r8
 10649 00018A5B 5A                          pop rdx
 10650 00018A5C 59                          pop rcx
 10651 00018A5D 5B                          pop rbx
 10652 00018A5E 58                          pop rax
 10653 00018A5F C3                          ret
 10654                                  
 10655                                  ; ---- e1000 MMIO helpers -------------------------------------------
 10656                                  ; e1000_reg_read32:  edi = register offset -> eax = value
 10657                                  ; e1000_reg_write32: edi = register offset, eax = value to write
 10658                                  ; BAR0 is identity-mapped (same trick expand_identity_map already sets up
 10659                                  ; for every other DMA buffer in this kernel), so this is a plain load/store
 10660                                  ; against nic_mmio_base+offset - no port I/O involved.
 10661                                  e1000_reg_read32:
 10662 00018A60 53                          push rbx
 10663 00018A61 57                          push rdi
 10664 00018A62 8B1C25[B8E80500]            mov ebx, [nic_mmio_base]
 10665 00018A69 4801FB                      add rbx, rdi
 10666 00018A6C 8B03                        mov eax, [rbx]
 10667 00018A6E 5F                          pop rdi
 10668 00018A6F 5B                          pop rbx
 10669 00018A70 C3                          ret
 10670                                  e1000_reg_write32:
 10671 00018A71 53                          push rbx
 10672 00018A72 57                          push rdi
 10673 00018A73 8B1C25[B8E80500]            mov ebx, [nic_mmio_base]
 10674 00018A7A 4801FB                      add rbx, rdi
 10675 00018A7D 8903                        mov [rbx], eax
 10676 00018A7F 5F                          pop rdi
 10677 00018A80 5B                          pop rbx
 10678 00018A81 C3                          ret
 10679                                  
 10680                                  ; ---- bring-up ----------------------------------------------------
 10681                                  nic_init:
 10682 00018A82 53                          push rbx
 10683 00018A83 51                          push rcx
 10684 00018A84 52                          push rdx
 10685 00018A85 4150                        push r8
 10686 00018A87 4151                        push r9
 10687 00018A89 4152                        push r10
 10688 00018A8B 57                          push rdi
 10689 00018A8C 56                          push rsi
 10690                                  
 10691 00018A8D C60425[ACE80500]00          mov byte [nic_present], 0
 10692 00018A95 C60425[B4E80500]00          mov byte [nic_driver_type], 0
 10693 00018A9D E865FBFFFF                  call pci_find_nic
 10694 00018AA2 0F82E4010000                jc .try_e1000
 10695                                  
 10696 00018AA8 E804FEFFFF                  call pci_pm_wake                 ; make sure it's in D0 before we touch it
 10697 00018AAD E8DCFEFFFF                  call pci_disable_aspm            ; keep the PCIe link out of L0s/L1
 10698                                  
 10699                                      ; PCI command: enable I/O space (bit0) + bus master (bit2)
 10700 00018AB2 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10701 00018ABA 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10702 00018AC2 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10703 00018ACA 41B004                      mov r8b, NIC_PCI_CMD
 10704 00018ACD E872F0FFFF                  call pci_read32
 10705 00018AD2 83C805                      or eax, 0x0005
 10706 00018AD5 4189C2                      mov r10d, eax
 10707 00018AD8 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10708 00018AE0 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10709 00018AE8 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10710 00018AF0 41B004                      mov r8b, NIC_PCI_CMD
 10711 00018AF3 E896F0FFFF                  call pci_write32
 10712                                  
 10713                                      ; BAR0 must be an I/O bar (QEMU's RTL8139 uses I/O by default)
 10714 00018AF8 0FB61C25[ADE80500]          movzx ebx, byte [nic_pci_bus]
 10715 00018B00 0FB60C25[AEE80500]          movzx ecx, byte [nic_pci_dev]
 10716 00018B08 0FB61425[AFE80500]          movzx edx, byte [nic_pci_func]
 10717 00018B10 41B010                      mov r8b, NIC_PCI_BAR0
 10718 00018B13 E82CF0FFFF                  call pci_read32
 10719 00018B18 A901000000                  test eax, 1
 10720 00018B1D 0F84B2070000                jz .ndone
 10721 00018B23 83E0FC                      and eax, 0xFFFFFFFC
 10722 00018B26 890425[B0E80500]            mov [nic_io_base], eax
 10723                                  
 10724                                      ; read the MAC from IDR0..IDR5
 10725 00018B2D 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10726 00018B34 83C700                      add edi, NIC_IO_IDR0
 10727 00018B37 488D3425[C0E80500]          lea rsi, [nic_mac]
 10728 00018B3F B906000000                  mov rcx, 6
 10729 00018B44 E865FAFFFF                  call nic_io_read_block
 10730                                  
 10731                                      ; soft reset: write RST (0x10) to CMD, poll until it clears
 10732 00018B49 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10733 00018B50 83C737                      add edi, NIC_IO_CMD
 10734 00018B53 B010                        mov al, 0x10
 10735 00018B55 E844FAFFFF                  call nic_io_write8
 10736 00018B5A 41B900002000                mov r9, 0x200000
 10737                                  .nreset_wait:
 10738 00018B60 8B3C25[B0E80500]            mov edi, [nic_io_base]
 10739 00018B67 83C737                      add edi, NIC_IO_CMD
 10740 00018B6A E81FFAFFFF                  call nic_io_read8
 10741 00018B6F A810                        test al, 0x10
 10742 00018B71 740A                        jz .nreset_done
