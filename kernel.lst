  3283                              <1> ; ------------------------------------------------------------
  3284                              <1> ; STRING INTERPOLATION (Phase 2)
  3285                              <1> ;
  3286                              <1> ; "hello {name}" embeds the string form of the variable `name`
  3287                              <1> ; inline. Scope for this phase: `{identifier}` only - a bare,
  3288                              <1> ; already-declared variable name, first char [a-zA-Z_], rest
  3289                              <1> ; [a-zA-Z0-9_] (same rule as any other identifier). `{{` and `}}`
  3290                              <1> ; escape to a literal brace. Full `{<expr>}` / `{ident(...)}` calls
  3291                              <1> ; are deferred - see phases.txt Phase 2 notes - since re-entering
  3292                              <1> ; party_parse_expr on text that was never tokenized is a bigger diff
  3293                              <1> ; than this phase needs.
  3294                              <1> ;
  3295                              <1> ; Evaluated lazily, per the recommended approach in phases.txt: the
  3296                              <1> ; lexer still emits one plain TOK_STR per literal (token count/shape
  3297                              <1> ; unchanged); the scan for `{`/`}` and the actual substitution happen
  3298                              <1> ; here, when the literal is turned into a runtime value.
  3299                              <1> ; ------------------------------------------------------------
  3300                              <1> 
  3301                              <1> ; party_val_to_string: rbx = value pointer. Formats the value as
  3302                              <1> ; text. Out: rsi = ptr to text, rcx = length. PV_STR values pass
  3303                              <1> ; their existing slice straight through (no copy). Numeric/bool text
  3304                              <1> ; is written into the shared party_num_buf scratch buffer (the same
  3305                              <1> ; one party_print_value uses) - copy it out (as party_pel_append
  3306                              <1> ; below does) before formatting another value if it must survive
  3307                              <1> ; that. PV_NONE yields length 0.
  3308                              <1> ; Clobbers rax, rcx, rdx, rsi, rdi.
  3309                              <1> ; ------------------------------------------------------------
  3310                              <1> party_val_to_string:
  3311 00028630 0FB603              <1>     movzx eax, byte [rbx]
  3312 00028633 83F804              <1>     cmp eax, PV_STR
  3313 00028636 7416                <1>     je .vts_str
  3314 00028638 83F801              <1>     cmp eax, PV_INT
  3315 0002863B 741A                <1>     je .vts_int
