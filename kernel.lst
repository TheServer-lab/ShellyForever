 15930 0002D244 4C29DA                      sub rdx, r11                 ; rdx = tail length (buffer chars to draw)
 15931 0002D247 4889D7                      mov rdi, rdx
 15932 0002D24A 4801CF                      add rdi, rcx                 ; rdi = total cells printed = walk-back distance
 15933 0002D24D 4C89DE                      mov rsi, r11                 ; rsi walks r11..r8-1 as a buffer index directly
