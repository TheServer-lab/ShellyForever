 12789 0001422C 5F                          pop rdi
 12790 0001422D 59                          pop rcx
 12791 0001422E 58                          pop rax
 12792 0001422F C3                          ret
 12793                                  
 12794                                  ; update_cursor: programs the VGA CRTC hardware cursor (the blinking block)
 12795                                  ; to match cursor_row/cursor_col, via the index/data port pair 0x3D4/0x3D5.
 12796                                  ; Without this the blinking cursor never moves from wherever the BIOS left
 12797                                  ; it, even though text is being printed elsewhere.
 12798                                  update_cursor:
 12799 00014230 50                          push rax
 12800 00014231 51                          push rcx
 12801 00014232 52                          push rdx
 12802 00014233 480FB60C25-                 movzx rcx, byte [cursor_row]
 12802 00014238 [384D0100]         
 12803 0001423C 486BC950                    imul rcx, VGA_COLS
 12804 00014240 480FB61425-                 movzx rdx, byte [cursor_col]
 12804 00014245 [394D0100]         
 12805 00014249 4801D1                      add rcx, rdx                 ; rcx = linear cursor position
 12806                                  
 12807 0001424C 66BAD403                    mov dx, 0x3D4
 12808 00014250 B00F                        mov al, 0x0F                 ; cursor location low byte
 12809 00014252 EE                          out dx, al
 12810 00014253 66BAD503                    mov dx, 0x3D5
 12811 00014257 88C8                        mov al, cl
 12812 00014259 EE                          out dx, al
 12813                                  
 12814 0001425A 66BAD403                    mov dx, 0x3D4
 12815 0001425E B00E                        mov al, 0x0E                 ; cursor location high byte
 12816 00014260 EE                          out dx, al
 12817 00014261 66BAD503                    mov dx, 0x3D5
 12818 00014265 88E8                        mov al, ch
 12819 00014267 EE                          out dx, al
 12820                                  
 12821 00014268 5A                          pop rdx
 12822 00014269 59                          pop rcx
 12823 0001426A 58                          pop rax
 12824 0001426B C3                          ret
 12825                                  
 12826                                  ; print_string: rsi = null terminated string, default attribute
 12827                                  print_string:
 12828 0001426C 50                          push rax
 12829 0001426D 8A0425[444D0100]            mov al, [cur_normal_attr]
 12830 00014274 E802000000                  call print_string_attr
 12831 00014279 58                          pop rax
 12832 0001427A C3                          ret
 12833                                  
 12834                                  ; print_string_attr: rsi=string, al=attribute byte
 12835                                  print_string_attr:
 12836 0001427B 50                          push rax
 12837 0001427C 53                          push rbx
 12838 0001427D 56                          push rsi
 12839 0001427E 88C3                        mov bl, al
 12840                                  .loop:
 12841 00014280 8A06                        mov al, [rsi]
 12842 00014282 3C00                        cmp al, 0
 12843 00014284 740C                        je .done
 12844 00014286 53                          push rbx
 12845 00014287 E84B000000                  call putchar
 12846 0001428C 5B                          pop rbx
 12847 0001428D 48FFC6                      inc rsi
 12848 00014290 EBEE                        jmp .loop
 12849                                  .done:
 12850 00014292 5E                          pop rsi
 12851 00014293 5B                          pop rbx
 12852 00014294 58                          pop rax
 12853 00014295 C3                          ret
 12854                                  
 12855                                  ; putchar: al = char to print, uses attribute in bl if caller set it via
 12856                                  ; print_string_attr; falls back to ATTR_NORMAL when called directly.
 12857                                  ; When pipe_capture_on is set (a "~" pipe is capturing a command's
 12858                                  ; output - see process_segment), characters are appended to
 12859                                  ; pipe_capture_buf instead of touching the screen/cursor at all.
 12860                                  serial_init:
 12861 00014296 50                          push rax
 12862 00014297 52                          push rdx
 12863 00014298 66BAFB03                    mov dx, 0x3FB
 12864 0001429C B080                        mov al, 0x80               ; DLAB = 1
 12865 0001429E EE                          out dx, al
 12866 0001429F 66BAF803                    mov dx, 0x3F8
 12867 000142A3 B001                        mov al, 0x01               ; divisor 1 -> 115200 baud
 12868 000142A5 EE                          out dx, al
 12869 000142A6 66BAF903                    mov dx, 0x3F9
 12870 000142AA 30C0                        xor al, al
 12871 000142AC EE                          out dx, al
 12872 000142AD 66BAFB03                    mov dx, 0x3FB
 12873 000142B1 B003                        mov al, 0x03               ; 8N1, DLAB = 0
 12874 000142B3 EE                          out dx, al
 12875 000142B4 66BAFA03                    mov dx, 0x3FA
 12876 000142B8 B0C7                        mov al, 0xC7               ; FIFO on, clear, 14-byte trigger
 12877 000142BA EE                          out dx, al
 12878 000142BB 5A                          pop rdx
 12879 000142BC 58                          pop rax
 12880 000142BD C3                          ret
 12881                                  
 12882                                  ; serial_mirror: transmit the char in al on COM1 (blocks until THR empty).
 12883                                  ; The char is parked in cl because dx (used for the port address) overlaps dl.
 12884                                  serial_mirror:
 12885 000142BE 50                          push rax
 12886 000142BF 51                          push rcx
 12887 000142C0 52                          push rdx
 12888 000142C1 88C1                        mov cl, al
 12889 000142C3 66BAFD03                    mov dx, 0x3FD
 12890                                  .sm_wait:
 12891 000142C7 EC                          in al, dx
 12892 000142C8 A820                        test al, 0x20
 12893 000142CA 74FB                        jz .sm_wait
 12894 000142CC 66BAF803                    mov dx, 0x3F8
 12895 000142D0 88C8                        mov al, cl
 12896 000142D2 EE                          out dx, al
 12897 000142D3 5A                          pop rdx
 12898 000142D4 59                          pop rcx
 12899 000142D5 58                          pop rax
 12900 000142D6 C3                          ret
 12901                                  
 12902                                  putchar:
 12903 000142D7 50                          push rax
 12904 000142D8 53                          push rbx
 12905 000142D9 51                          push rcx
 12906 000142DA 52                          push rdx
 12907 000142DB 57                          push rdi
 12908                                  
 12909 000142DC 803C25[B1910300]00          cmp byte [pipe_capture_on], 0
 12910 000142E4 743A                        je .not_capturing
 12911 000142E6 3C0D                        cmp al, 0x0D
 12912 000142E8 7430                        je .cap_done              ; ignore carriage returns
 12913 000142EA 488B0C25[B8910300]          mov rcx, [pipe_capture_len]
 12914 000142F2 4881F9BF000000              cmp rcx, PIPE_CAP_MAX-1
 12915 000142F9 731F                        jae .cap_done              ; capture buffer full - silently truncate
 12916 000142FB 488D3C25[C0910300]          lea rdi, [pipe_capture_buf]
 12917 00014303 4801CF                      add rdi, rcx
 12918 00014306 8807                        mov [rdi], al
 12919 00014308 48FFC1                      inc rcx
 12920 0001430B 48890C25[B8910300]          mov [pipe_capture_len], rcx
 12921 00014313 C681[C0910300]00            mov byte [pipe_capture_buf + rcx], 0
 12922                                  .cap_done:
 12923 0001431A 5F                          pop rdi
 12924 0001431B 5A                          pop rdx
 12925 0001431C 59                          pop rcx
 12926 0001431D 5B                          pop rbx
 12927 0001431E 58                          pop rax
 12928 0001431F C3                          ret
 12929                                  .not_capturing:
 12930 00014320 3C0A                        cmp al, 0x0A
 12931 00014322 0F8486000000                je .newline
 12932 00014328 3C0D                        cmp al, 0x0D
 12933 0001432A 0F847E000000                je .newline
 12934                                  
 12935                                      ; compute video offset = (row*80+col)*2
 12936 00014330 480FB60C25-                 movzx rcx, byte [cursor_row]
 12936 00014335 [384D0100]         
 12937 00014339 486BC950                    imul rcx, VGA_COLS
 12938 0001433D 480FB61425-                 movzx rdx, byte [cursor_col]
 12938 00014342 [394D0100]         
 12939 00014346 4801D1                      add rcx, rdx
 12940 00014349 486BC902                    imul rcx, 2
 12941 0001434D 488D3C2500800B00            lea rdi, [VGA_BASE]
 12942 00014355 4801CF                      add rdi, rcx
 12943 00014358 8807                        mov [rdi], al
 12944 0001435A 80FB00                      cmp bl, 0
 12945 0001435D 750E                        jne .useattr
 12946 0001435F 50                          push rax
 12947 00014360 8A0425[444D0100]            mov al, [cur_normal_attr]
 12948 00014367 884701                      mov [rdi+1], al
 12949 0001436A 58                          pop rax
 12950 0001436B EB03                        jmp .advance
 12951                                  .useattr:
 12952 0001436D 885F01                      mov [rdi+1], bl
 12953                                  .advance:
 12954 00014370 E8AEE2FFFF                  call mouse_sel_putchar_check
 12955 00014375 FE0425[394D0100]            inc byte [cursor_col]
 12956 0001437C 803C25[394D0100]50          cmp byte [cursor_col], VGA_COLS
 12957 00014384 750F                        jne .maybe_scroll
 12958 00014386 C60425[394D0100]00          mov byte [cursor_col], 0
 12959 0001438E FE0425[384D0100]            inc byte [cursor_row]
 12960                                  .maybe_scroll:
 12961 00014395 803C25[384D0100]19          cmp byte [cursor_row], VGA_ROWS
 12962 0001439D 7537                        jne .out
 12963 0001439F E847000000                  call scroll_screen
 12964 000143A4 C60425[384D0100]18          mov byte [cursor_row], VGA_ROWS-1
 12965 000143AC EB28                        jmp .out
 12966                                  .newline:
 12967 000143AE C60425[394D0100]00          mov byte [cursor_col], 0
 12968 000143B6 FE0425[384D0100]            inc byte [cursor_row]
 12969 000143BD 803C25[384D0100]19          cmp byte [cursor_row], VGA_ROWS
 12970 000143C5 750D                        jne .nl_out
 12971 000143C7 E81F000000                  call scroll_screen
 12972 000143CC C60425[384D0100]18          mov byte [cursor_row], VGA_ROWS-1
 12973                                  .nl_out:
 12974 000143D4 B00A                        mov al, 0x0A
 12975                                  .out:
 12976 000143D6 E855FEFFFF                  call update_cursor
 12977 000143DB E8DEFEFFFF                  call serial_mirror
 12978 000143E0 E8DBDDFFFF                  call mouse_show
 12979 000143E5 5F                          pop rdi
 12980 000143E6 5A                          pop rdx
 12981 000143E7 59                          pop rcx
 12982 000143E8 5B                          pop rbx
 12983 000143E9 58                          pop rax
 12984 000143EA C3                          ret
 12985                                  
 12986                                  scroll_screen:
 12987 000143EB 50                          push rax
 12988 000143EC 51                          push rcx
 12989 000143ED 56                          push rsi
 12990 000143EE 57                          push rdi
 12991 000143EF E899DDFFFF                  call mouse_hide
 12992 000143F4 E81B020000                  call scrollback_capture_row      ; archive row 0 before it's shifted away
 12993 000143F9 E880E0FFFF                  call mouse_sel_clear             ; the shift would otherwise invalidate the snapshot
 12994 000143FE BEA0800B00                  mov rsi, VGA_BASE + (VGA_COLS*2)
 12995 00014403 BF00800B00                  mov rdi, VGA_BASE
 12996 00014408 B980070000                  mov rcx, (VGA_ROWS-1)*VGA_COLS
 12997 0001440D 66F3A5                      rep movsw
 12998 00014410 BF008F0B00                  mov rdi, VGA_BASE + ((VGA_ROWS-1)*VGA_COLS*2)
 12999 00014415 B950000000                  mov rcx, VGA_COLS
 13000 0001441A 66B82007                    mov ax, 0x0720
 13001                                  .clr:
 13002 0001441E 668907                      mov [rdi], ax
 13003 00014421 4883C702                    add rdi, 2
 13004 00014425 E2F7                        loop .clr
 13005 00014427 803C25[0D280100]00          cmp byte [mouse_y], 0           ; content moved up: track the cursor up too
 13006 0001442F 7407                        je .done
 13007 00014431 FE0C25[0D280100]            dec byte [mouse_y]
 13008                                  .done:
 13009 00014438 E883DDFFFF                  call mouse_show
 13010 0001443D 5F                          pop rdi
 13011 0001443E 5E                          pop rsi
 13012 0001443F 59                          pop rcx
 13013 00014440 58                          pop rax
 13014 00014441 C3                          ret
 13015                                  
 13016                                  ; ============================================================
 13017                                  ;  loading spinner: a tiny |/-\ animation for operations that take a
 13018                                  ;  visible moment (scanning drives, formatting). spinner_step draws one
 13019                                  ;  frame at the current cursor cell and steps the cursor back onto that
 13020                                  ;  same cell, so repeated calls animate in place instead of scrolling
 13021                                  ;  text across the screen; spinner_clear blanks that cell again once
 13022                                  ;  the operation is done, leaving the cursor exactly where it was.
 13023                                  ; ============================================================
 13024 00014442 00                      spinner_idx: db 0
 13025 00014443 7C2F2D5C                spinner_frames: db '|','/','-','\'
 13026                                  
 13027                                  spinner_step:
 13028 00014447 50                          push rax
 13029 00014448 53                          push rbx
 13030 00014449 51                          push rcx
 13031 0001444A 480FB60425-                 movzx rax, byte [spinner_idx]
 13031 0001444F [42440100]         
 13032 00014453 2403                        and al, 3
 13033 00014455 480FB6C8                    movzx rcx, al
 13034 00014459 8A81[43440100]              mov al, [spinner_frames + rcx]
 13035 0001445F 8A1C25[444D0100]            mov bl, [cur_normal_attr]
 13036 00014466 E86CFEFFFF                  call putchar
 13037 0001446B FE0C25[394D0100]            dec byte [cursor_col]
 13038 00014472 E8B9FDFFFF                  call update_cursor
 13039 00014477 FE0425[42440100]            inc byte [spinner_idx]
 13040 0001447E 59                          pop rcx
 13041 0001447F 5B                          pop rbx
 13042 00014480 58                          pop rax
 13043 00014481 C3                          ret
 13044                                  
 13045                                  spinner_clear:
 13046 00014482 50                          push rax
 13047 00014483 53                          push rbx
 13048 00014484 B020                        mov al, ' '
 13049 00014486 8A1C25[444D0100]            mov bl, [cur_normal_attr]
 13050 0001448D E845FEFFFF                  call putchar
 13051 00014492 FE0C25[394D0100]            dec byte [cursor_col]
 13052 00014499 E892FDFFFF                  call update_cursor
 13053 0001449E 5B                          pop rbx
 13054 0001449F 58                          pop rax
 13055 000144A0 C3                          ret
 13056                                  
 13057                                  ; ============================================================
 13058                                  ;  PS/2 KEYBOARD
 13059                                  ; ============================================================
 13060                                  
 13061                                  ; get_char: blocks until a key is pressed, returns ascii in al.
 13062                                  ; Also handles: Ctrl tracking (make/break of 0x1D, plain or E0-prefixed),
 13063                                  ; E0-prefixed arrow keys (Up=0x48, Down=0x50), and Ctrl+Up/Ctrl+Down driving
 13064                                  ; the on-screen scrollback view. Plain Up/Down (no Ctrl) are returned to the
 13065                                  ; caller as the sentinel bytes KEY_UP/KEY_DOWN instead of an ascii char, so
 13066                                  ; read_line can use them for command history. Right before returning any
 13067                                  ; real key (ascii or arrow sentinel) to the caller, if the view is currently
 13068                                  ; scrolled back it snaps back to the live screen first - typing or
 13069                                  ; navigating history always means "I'm done reviewing, back to the prompt".
 13070                                  get_char:
 13071 000144A1 53                          push rbx
 13072                                  .wait:
 13073 000144A2 E464                        in al, 0x64
 13074 000144A4 A801                        test al, 1
 13075 000144A6 74FA                        jz .wait
 13076 000144A8 A820                        test al, 0x20                  ; aux (mouse) byte waiting?
 13077 000144AA 7413                        jz .kbd_byte
