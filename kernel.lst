 14641                                  ; ------------------------------------------------------------
 14642                                  ; wig time: the "widget" command. Draws a live clock in the top-right
 14643                                  ; corner of the screen that updates every second, until Esc is pressed.
 14644                                  ; ------------------------------------------------------------
 14645                                  
 14646                                  ; wig_draw_clock: right-aligns "HH:MM:SS" at row 0 of the screen, writing
 14647                                  ; straight to VGA memory so the shell's cursor and scrollback stay put.
 14648                                  wig_draw_clock:
 14649 0001B472 50                          push rax
 14650 0001B473 53                          push rbx
 14651 0001B474 51                          push rcx
 14652 0001B475 56                          push rsi
 14653 0001B476 57                          push rdi
 14654 0001B477 488D3C25[2B380300]          lea rdi, [wig_str_buf]
 14655 0001B47F E8A0FDFFFF                  call format_time
 14656 0001B484 488D3425[2B380300]          lea rsi, [wig_str_buf]
 14657 0001B48C E89AF7FFFF                  call str_len                  ; rax = 8 (always, for HH:MM:SS)
 14658 0001B491 BB50000000                  mov rbx, 80
 14659 0001B496 4829C3                      sub rbx, rax                  ; rbx = starting column
 14660 0001B499 486BDB02                    imul rbx, rbx, 2              ; column -> byte offset
 14661 0001B49D 488DBB00800B00              lea rdi, [VGA_BASE + rbx]
 14662 0001B4A4 488D3425[2B380300]          lea rsi, [wig_str_buf]
 14663 0001B4AC B30B                        mov bl, ATTR_WIG
 14664                                  .wig_write:
 14665 0001B4AE 8A06                        mov al, [rsi]
 14666 0001B4B0 3C00                        cmp al, 0
 14667 0001B4B2 740E                        je .wig_written
 14668 0001B4B4 8807                        mov [rdi], al
 14669 0001B4B6 885F01                      mov [rdi+1], bl
 14670 0001B4B9 4883C702                    add rdi, 2
 14671 0001B4BD 48FFC6                      inc rsi
 14672 0001B4C0 EBEC                        jmp .wig_write
 14673                                  .wig_written:
 14674 0001B4C2 5F                          pop rdi
 14675 0001B4C3 5E                          pop rsi
 14676 0001B4C4 59                          pop rcx
 14677 0001B4C5 5B                          pop rbx
 14678 0001B4C6 58                          pop rax
 14679 0001B4C7 C3                          ret
 14680                                  
 14681                                  ; wig_clear: blanks the 8-column corner slot the widget draws in.
 14682                                  wig_clear:
 14683 0001B4C8 50                          push rax
 14684 0001B4C9 51                          push rcx
 14685 0001B4CA 57                          push rdi
 14686 0001B4CB 488D3C2590800B00            lea rdi, [VGA_BASE + (0*80 + 72)*2]
 14687 0001B4D3 B908000000                  mov rcx, 8
 14688 0001B4D8 66B82007                    mov ax, 0x0720                ; space, light grey on black
 14689                                  .wig_clr:
 14690 0001B4DC 668907                      mov [rdi], ax
 14691 0001B4DF 4883C702                    add rdi, 2
 14692 0001B4E3 E2F7                        loop .wig_clr
 14693 0001B4E5 5F                          pop rdi
 14694 0001B4E6 59                          pop rcx
 14695 0001B4E7 58                          pop rax
 14696 0001B4E8 C3                          ret
 14697                                  
 14698                                  ; cmd_wig: usage "wig time". Runs the live clock widget until Esc.
 14699                                  cmd_wig:
