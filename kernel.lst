  6143                                  ; ============================================================
  6144                                  ;  NON-BLOCKING KEYBOARD POLL  (for Esc-to-kill during scripts)
  6145                                  ; ============================================================
  6146                                  ; kbd_poll: checks if a key is available (non-blocking). If it's
  6147                                  ; Esc (scancode 0x01 make code), sets kill_flag. Other keys are
  6148                                  ; consumed and discarded.
  6149                                  kbd_poll:
  6150 000158E0 E464                        in al, 0x64
  6151 000158E2 A801                        test al, 1
  6152 000158E4 7425                        jz .no_key
  6153 000158E6 A820                        test al, 0x20                  ; aux (mouse) byte waiting?
  6154 000158E8 7413                        jz .kbd_byte
  6155 000158EA E460                        in al, 0x60
  6156 000158EC 803C25[40AF0200]00          cmp byte [mouse_ena], 0
  6157 000158F4 7415                        je .no_key
  6158 000158F6 E853500100                  call mouse_byte
  6159 000158FB EB0E                        jmp .no_key
  6160                                  .kbd_byte:
  6161 000158FD E460                        in al, 0x60
  6162 000158FF 3C01                        cmp al, 0x01                  ; Esc make code
  6163 00015901 7508                        jne .no_key
  6164 00015903 C60425[29090700]01          mov byte [kill_flag], 1
  6165                                  .no_key:
  6166 0001590B C3                          ret
  6167                                  
  6168                                  ; party_poll_kill_api: exposed to compiled .run programs at
  6169                                  ; [kernel_api_table+0x20]. Called once per while(true) iteration so an
  6170                                  ; otherwise-unbreakable loop can be stopped from outside it.
  6171                                  ; Compiled .run code keeps its only persistent state in rdi (the api
  6172                                  ; table pointer), so this preserves every register except rax rather
  6173                                  ; than trusting kbd_poll's (and mouse_byte's) clobber list to stay rdi/
  6174                                  ; rsi-safe forever.
  6175                                  ; Out: al = 1 if the running program should stop (Esc pressed, or
  6176                                  ;      killed via 'prs kill <pid/name>'), 0 to keep going.
  6177                                  party_poll_kill_api:
  6178 0001590C 53                          push rbx
  6179 0001590D 51                          push rcx
  6180 0001590E 52                          push rdx
  6181 0001590F 56                          push rsi
  6182 00015910 57                          push rdi
  6183 00015911 4150                        push r8
  6184 00015913 4151                        push r9
  6185 00015915 4152                        push r10
  6186 00015917 4153                        push r11
  6187 00015919 4154                        push r12
  6188 0001591B 4155                        push r13
  6189 0001591D 4156                        push r14
  6190 0001591F 4157                        push r15
  6191 00015921 E8BAFFFFFF                  call kbd_poll
  6192 00015926 415F                        pop r15
  6193 00015928 415E                        pop r14
  6194 0001592A 415D                        pop r13
  6195 0001592C 415C                        pop r12
  6196 0001592E 415B                        pop r11
  6197 00015930 415A                        pop r10
  6198 00015932 4159                        pop r9
  6199 00015934 4158                        pop r8
  6200 00015936 5F                          pop rdi
  6201 00015937 5E                          pop rsi
  6202 00015938 5A                          pop rdx
  6203 00015939 59                          pop rcx
  6204 0001593A 5B                          pop rbx
  6205 0001593B 0FB60425[29090700]          movzx eax, byte [kill_flag]
  6206 00015943 C3                          ret
