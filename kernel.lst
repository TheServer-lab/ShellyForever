   506                              <1> ; ============================================================
   507                              <1> ;  HKDF (RFC 5869), and TLS 1.3's HKDF-Expand-Label (RFC 8446 7.1)
   508                              <1> ; ============================================================
   509                              <1> 
   510                              <1> ; hkdf_extract: rdi = salt ptr, rcx = salt len, rsi = ikm ptr,
   511                              <1> ;               rdx = ikm len, r8 = 32-byte PRK output ptr.
   512                              <1> ; This is exactly HMAC-Hash(salt, IKM), so it's a thin pass-through.
   513                              <1> hkdf_extract:
   514 00038AAF E9C9FEFFFF          <1>     jmp hmac_sha256
   515                              <1> 
   516                              <1> ; hkdf_expand: rdi = prk ptr (32 bytes), rsi = info ptr, rdx = info
   517                              <1> ;              len, rcx = desired output length L, r8 = output ptr.
   518                              <1> ; N = ceil(L/32), T(0) = empty, T(i) = HMAC(prk, T(i-1)||info||i).
   519                              <1> ; Capped at 255 rounds per RFC 5869; TLS 1.3 never needs more than 1.
   520                              <1> hkdf_expand:
