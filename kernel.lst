 16429 0002D753 FE0C25[B9D70200]            dec byte [cursor_col]
 16430 0002D75A EB19                        jmp .blank
 16431                                  .maybeup:
 16432 0002D75C 803C25[B8D70200]00          cmp byte [cursor_row], 0
 16433 0002D764 744B                        je .out
 16434 0002D766 FE0C25[B8D70200]            dec byte [cursor_row]
 16435 0002D76D C60425[B9D70200]4F          mov byte [cursor_col], VGA_COLS-1
 16436                                  .blank:
 16437 0002D775 53                          push rbx
 16438 0002D776 51                          push rcx
 16439 0002D777 52                          push rdx
 16440 0002D778 57                          push rdi
 16441 0002D779 480FB60C25-                 movzx rcx, byte [cursor_row]
 16441 0002D77E [B8D70200]         
 16442 0002D782 486BC950                    imul rcx, VGA_COLS
 16443 0002D786 480FB61425-                 movzx rdx, byte [cursor_col]
 16443 0002D78B [B9D70200]         
 16444 0002D78F 4801D1                      add rcx, rdx
 16445 0002D792 486BC902                    imul rcx, 2
 16446 0002D796 488D3C2500800B00            lea rdi, [VGA_BASE]
 16447 0002D79E 4801CF                      add rdi, rcx
 16448 0002D7A1 C60720                      mov byte [rdi], ' '
 16449 0002D7A4 C6470107                    mov byte [rdi+1], 0x07
 16450 0002D7A8 5F                          pop rdi
 16451 0002D7A9 5A                          pop rdx
 16452 0002D7AA 59                          pop rcx
 16453 0002D7AB 5B                          pop rbx
 16454 0002D7AC E8B4F1FFFF                  call update_cursor
 16455                                  .out:
 16456 0002D7B1 58                          pop rax
 16457 0002D7B2 C3                          ret
