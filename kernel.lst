 13914 0000B13A 664589D7                    mov r15w, r10w
 13915                                      ; The payload (r11) is often the same net_build_buf we're about to
 13916                                      ; build the datagram in (callers construct their message there before
 13917                                      ; calling us), aliased with dst = src+8. If we wrote the 8-byte UDP
 13918                                      ; header first, it would destroy the payload's own first 8 bytes
 13919                                      ; before they could ever be copied - no copy direction fixes that.
 13920                                      ; So: shift the payload into place first (back-to-front, since
 13921                                      ; dst > src makes that direction overlap-safe), and only write the
 13922                                      ; header afterward, once bytes 0-7 are no longer needed as payload.
