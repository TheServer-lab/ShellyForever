 13126 00014537 E9C3000000                  jmp .snap_and_return
 13127                                  
 13128                                  .not_ext_cont:
 13129 0001453C 80FBE0                      cmp bl, 0xE0
 13130 0001453F 7466                        je .set_ext
 13131 00014541 F6C380                      test bl, 0x80
 13132 00014544 0F8584000000                jnz .breakcode
