  2508                              <1> ; ------------------------------------------------------------
  2509                              <1> ; party_skip_block: r13 = first token inside a block (already past
  2510                              <1> ; its opening '{'). Advances r13 past the block WITHOUT running any
  2511                              <1> ; of it, stopping at the matching '}' (not consumed). Only tracks
  2512                              <1> ; brace depth, so it doesn't validate anything inside the block.
  2513                              <1> ; Clobbers rax, rbx, rcx.
  2514                              <1> ; ------------------------------------------------------------
  2515                              <1> party_skip_block:
  2516 00027E46 B901000000          <1>     mov ecx, 1
