 16511                                  ; ============================================================
 16512                                  ;  PS/2 KEYBOARD
 16513                                  ; ============================================================
 16514                                  
 16515                                  ; get_char: blocks until a key is pressed, returns ascii in al.
 16516                                  ; Also handles: Ctrl tracking (make/break of 0x1D, plain or E0-prefixed),
 16517                                  ; E0-prefixed arrow/Home/End/Delete keys (Up=0x48, Down=0x50, Left=0x4B,
 16518                                  ; Right=0x4D, Home=0x47, End=0x4F, Delete=0x53), and Ctrl+Up/Ctrl+Down (or,
 16519                                  ; while edit_active is set, plain Up/Down with no Ctrl needed) driving the
 16520                                  ; on-screen scrollback view. Plain Up/Down (no Ctrl, edit_active clear),
 16521                                  ; Left, Right, Home, End, and Delete are all returned to the caller as
 16522                                  ; sentinel bytes (KEY_UP/KEY_DOWN/KEY_LEFT/KEY_RIGHT/KEY_HOME/KEY_END/
 16523                                  ; KEY_DELETE) instead of an ascii char, so read_line can use them for
 16524                                  ; history and in-line cursor movement/editing. Right before returning any
 16525                                  ; real key (ascii or sentinel) to the caller, if the view is currently
 16526                                  ; scrolled back it snaps back to the live screen first - typing or
 16527                                  ; navigating history always means "I'm done reviewing, back to the prompt".
 16528                                  get_char:
 16529 00070F23 53                          push rbx
 16530                                  .wait:
 16531 00070F24 E464                        in al, 0x64
 16532 00070F26 A801                        test al, 1
 16533 00070F28 74FA                        jz .wait
 16534 00070F2A A820                        test al, 0x20                  ; aux (mouse) byte waiting?
 16535 00070F2C 7413                        jz .kbd_byte
 16536 00070F2E E460                        in al, 0x60
 16537 00070F30 803C25[A4100600]00          cmp byte [mouse_ena], 0
 16538 00070F38 74EA                        je .wait                       ; mouse off: just discard
 16539 00070F3A E873FBFEFF                  call mouse_byte
 16540 00070F3F EBE3                        jmp .wait
 16541                                  .kbd_byte:
 16542 00070F41 E460                        in al, 0x60
 16543 00070F43 88C3                        mov bl, al
 16544                                  
 16545 00070F45 803C25[2A1A0700]00          cmp byte [kbd_ext_flag], 0
 16546 00070F4D 0F842E010000                je .not_ext_cont
 16547                                      ; this byte follows an 0xE0 prefix byte
 16548 00070F53 C60425[2A1A0700]00          mov byte [kbd_ext_flag], 0
 16549 00070F5B F6C380                      test bl, 0x80
 16550 00070F5E 7579                        jnz .ext_break
 16551 00070F60 80FB48                      cmp bl, 0x48                 ; extended Up
 16552 00070F63 0F8497000000                je .ext_up
 16553 00070F69 80FB50                      cmp bl, 0x50                 ; extended Down
 16554 00070F6C 0F84B6000000                je .ext_down
 16555 00070F72 80FB4B                      cmp bl, 0x4B                 ; extended Left
 16556 00070F75 0F84E3000000                je .ext_left
 16557 00070F7B 80FB4D                      cmp bl, 0x4D                 ; extended Right
 16558 00070F7E 0F84E1000000                je .ext_right
 16559 00070F84 80FB47                      cmp bl, 0x47                 ; extended Home
 16560 00070F87 0F84DF000000                je .ext_home
 16561 00070F8D 80FB4F                      cmp bl, 0x4F                 ; extended End
 16562 00070F90 0F84DD000000                je .ext_end
 16563 00070F96 80FB53                      cmp bl, 0x53                 ; extended Delete
 16564 00070F99 0F84DB000000                je .ext_delete
 16565 00070F9F 80FB1D                      cmp bl, 0x1D                 ; right Ctrl make
 16566 00070FA2 7442                        je .ext_ctrl_make
 16567 00070FA4 80FB1C                      cmp bl, 0x1C                 ; keypad Enter
 16568 00070FA7 7414                        je .ext_kp_enter
 16569 00070FA9 80FB35                      cmp bl, 0x35                 ; keypad /
 16570 00070FAC 7416                        je .ext_kp_slash
 16571 00070FAE 80FB4A                      cmp bl, 0x4A                 ; keypad -
 16572 00070FB1 7418                        je .ext_kp_minus
 16573 00070FB3 80FB4E                      cmp bl, 0x4E                 ; keypad +
 16574 00070FB6 741A                        je .ext_kp_plus
 16575 00070FB8 E967FFFFFF                  jmp .wait                    ; ignore any other extended key
 16576                                  .ext_kp_enter:
 16577 00070FBD B00D                        mov al, 13
 16578 00070FBF E980010000                  jmp .snap_and_return
 16579                                  .ext_kp_slash:
 16580 00070FC4 B02F                        mov al, '/'
 16581 00070FC6 E979010000                  jmp .snap_and_return
 16582                                  .ext_kp_minus:
 16583 00070FCB B02D                        mov al, '-'
 16584 00070FCD E972010000                  jmp .snap_and_return
 16585                                  .ext_kp_plus:
 16586 00070FD2 B02B                        mov al, '+'
 16587 00070FD4 E96B010000                  jmp .snap_and_return
 16588                                  .ext_break:
 16589 00070FD9 80E37F                      and bl, 0x7F
 16590 00070FDC 80FB1D                      cmp bl, 0x1D
 16591 00070FDF 7412                        je .ext_ctrl_break
 16592 00070FE1 E93EFFFFFF                  jmp .wait
 16593                                  .ext_ctrl_make:
 16594 00070FE6 C60425[251A0700]01          mov byte [ctrl_state], 1
 16595 00070FEE E931FFFFFF                  jmp .wait
 16596                                  .ext_ctrl_break:
 16597 00070FF3 C60425[251A0700]00          mov byte [ctrl_state], 0
 16598 00070FFB E924FFFFFF                  jmp .wait
 16599                                  .ext_up:
 16600 00071000 803C25[261A0700]00          cmp byte [edit_active], 0
