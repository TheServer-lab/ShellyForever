vars W = 10
vars H = 20
vars b0 = 0
vars b1 = 0
vars b2 = 0
vars px = 0
vars py = 0
vars ptype = 0
vars prot = 0
vars nptype = 0
vars score = 0

func init_board() {
    b0 = arr_new(80)
    b1 = arr_new(80)
    b2 = arr_new(40)
}

func board_get(idx) {
    if (idx < 80) { return arr_get(b0, idx) }
    if (idx < 160) { return arr_get(b1, idx - 80) }
    return arr_get(b2, idx - 160)
}

func board_set(idx, val) {
    if (idx < 80) {
        arr_set(b0, idx, val)
        return
    }
    if (idx < 160) {
        arr_set(b1, idx - 80, val)
        return
    }
    arr_set(b2, idx - 160, val)
}

func pow2(n) {
    vars p = 1
    vars i = 0
    while (i < n) {
        p = p * 2
        i = i + 1
    }
    return p
}

func piece_bit(mask, idx) {
    vars d = pow2(idx)
    return (mask / d) % 2
}

func piece_mask(type, rot) {
    if (type == 0) {
        if (rot == 0) { return 240 }
        if (rot == 1) { return 17476 }
        if (rot == 2) { return 3840 }
        return 8738
    }
    if (type == 1) { return 102 }
    if (type == 2) {
        if (rot == 0) { return 114 }
        if (rot == 1) { return 610 }
        if (rot == 2) { return 624 }
        return 562
    }
    if (type == 3) {
        if (rot == 0) { return 54 }
        if (rot == 1) { return 1122 }
        if (rot == 2) { return 864 }
        return 561
    }
    if (type == 4) {
        if (rot == 0) { return 99 }
        if (rot == 1) { return 612 }
        if (rot == 2) { return 1584 }
        return 306
    }
    if (type == 5) {
        if (rot == 0) { return 113 }
        if (rot == 1) { return 550 }
        if (rot == 2) { return 1136 }
        return 802
    }
    if (rot == 0) { return 116 }
    if (rot == 1) { return 1570 }
    if (rot == 2) { return 368 }
    return 547
}

func can_place(type, rot, px, py) {
    vars mask = piece_mask(type, rot)
    vars idx = 0
    vars col = 0
    vars row = 0
    vars bx = 0
    vars by = 0
    vars cellidx = 0
    while (idx < 16) {
        if (piece_bit(mask, idx) == 1) {
            col = idx % 4
            row = idx / 4
            bx = px + col
            by = py + row
            if (bx < 0) { return 0 }
            if (bx >= W) { return 0 }
            if (by >= H) { return 0 }
            if (by >= 0) {
                cellidx = by * W + bx
                if (board_get(cellidx) != 0) { return 0 }
            }
        }
        idx = idx + 1
    }
    return 1
}

init_board()
vars res = can_place(5, 0, 3, 18)
display "cp18={res}"
res = can_place(5, 0, 3, 19)
display "cp19={res}"
vars t5 = 5
res = can_place(t5, 0, 3, 19)
display "cp_var19={res}"
ptype = 1
prot = 0
px = 3
py = 18
res = can_place(ptype, prot, px, py + 1)
display "cp_game19={res}"
res = can_place(1, 0, 3, 19)
display "cp_lit19={res}"
display "tgeo-done"