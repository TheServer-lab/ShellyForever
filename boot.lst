     1                                  ; ============================================================
     2                                  ;  ShellyForever  --  boot.asm
     3                                  ;  Stage-1 bootloader (fits in one 512-byte sector).
     4                                  ;  1) Loaded by BIOS at 0x7C00 in 16-bit real mode.
     5                                  ;  2) Loads the kernel (kernel.bin) from disk sectors 2..N into
     6                                  ;     memory at 0x8000 using BIOS INT 13h.
     7                                  ;  3) Enables A20, builds a temporary GDT, enters 32-bit
     8                                  ;     protected mode.
     9                                  ;  4) Builds minimal page tables (identity-maps first 2MB using
    10                                  ;     a single 2MB page), enables PAE + long mode + paging.
    11                                  ;  5) Far-jumps into 64-bit long mode straight into the kernel
    12                                  ;     entry point at 0x8000.
    13                                  ; ============================================================
    14                                  
    15                                  BITS 16
    16                                  ORG 0x7C00
    17                                  
    18                                  ; The CPU starts executing at the very first byte of this file (0x7C00).
    19                                  ; dbg16 is placed early so its 'call dbg16' sites below can reach it with a
    20                                  ; cheap near call, but that means we MUST jump over it here - otherwise
    21                                  ; the CPU would fall straight into the subroutine and hit its 'ret' with
    22                                  ; no return address on the stack yet, jumping to garbage.
    23 00000000 EB0E                    jmp start
    24                                  
    25                                  KERNEL_LOAD_SEG   equ 0x0000
    26                                  KERNEL_LOAD_OFF   equ 0x8000
    27                                  KERNEL_SECTORS    equ 1500        ; how many 512B sectors to load. The background-process
    28                                                                    ; scheduler added the per-slot proc_bg_* arrays (ctx
    29                                                                    ; 20226B + src 16KB + stack 8KB + ring 4KB each, x4
    30                                                                    ; slots), which took kernel.bin from ~970 sectors to
    31                                                                    ; ~1373 sectors - so this was bumped from 1100 to 1500
    32                                                                    ; (~768KB) for headroom. Previously bumped from 900 for
    33                                                                    ; the splash data and from 560 for the same reason (see
    34                                                                    ; git history): too little headroom here silently
    35                                                                    ; truncates the kernel's own tail data
    36                                                                    ; (ata_port_base/ata_drive_sel/fs_disk_available
    37                                                                    ; landed around sector 616 last time this bit), so the
    38                                                                    ; ATA driver ran with a zeroed port base and "No disk
    39                                                                    ; detected" even though the drive was fine.
    40                                                                    ; The CHS fallback reads at most 18
    41                                                                    ; sectors per BIOS call (not limited by al directly - see
    42                                                                    ; the .loop chunking below) and this total must stay clear
    43                                                                    ; of the SFFS region - see kernel.asm's FS_LBA_START (now
    44                                                                    ; 1560 to match), and leave real margin, not just enough
    45                                                                    ; for today's build - and <= 2880 (media). If
    46                                                                    ; KERNEL_SECTORS is ever bumped again, bump FS_LBA_START in
    47                                                                    ; kernel.asm to match - the two are not shared constants,
    48                                                                    ; so nothing else will catch a drift between them.
    49                                  
    50                                  ; ---- on-screen checkpoint markers ----
    51                                  ; Each stage of the real->protected->long mode transition writes one
    52                                  ; character to a fixed row near the top of the screen, in column order.
    53                                  ; If boot hangs on real hardware, whichever checkpoint is the last one
    54                                  ; visible tells us exactly which stage failed, instead of guessing blind.
    55                                  ; Row 24 (bottom row) is used so it never collides with the boot messages.
    56                                  ; Implemented as one shared subroutine (not a macro) so the call sites
    57                                  ; don't each pay for their own copy of the setup code - every byte
    58                                  ; matters in a 512-byte sector. Registers are intentionally left clobbered
    59                                  ; (no push/pop): every call site reloads ax/bx/dx itself before relying on
    60                                  ; them again.
    61                                  ; in: bx = byte offset into VGA memory (row*80+col)*2, dl = char to show
    62                                  dbg16:
    63 00000002 B800B8                      mov ax, 0xB800
    64 00000005 8EC0                        mov es, ax
    65 00000007 268817                      mov [es:bx], dl
    66 0000000A 26C647014F                  mov byte [es:bx+1], 0x4F       ; white on red - stands out
    67 0000000F C3                          ret
    68                                  
    69                                  start:
    70 00000010 FA                          cli
    71 00000011 31C0                        xor ax, ax
    72 00000013 8ED8                        mov ds, ax
    73 00000015 8EC0                        mov es, ax
    74 00000017 8ED0                        mov ss, ax
    75 00000019 BC007C                      mov sp, 0x7C00
    76 0000001C FB                          sti
    77                                  
    78                                      ; (The video-mode reset was dropped to fit the chunked kernel reader;
    79                                      ; boot sectors always get an 80x25 text mode from the BIOS/emulator.)
    80                                  
    81 0000001D 8816[F500]                  mov [boot_drive], dl        ; BIOS passes boot drive number in dl - save
    82                                                                   ; it before any checkpoint call clobbers dl
    83                                  
    84 00000021 BB0000                      mov bx, 0                   ; checkpoint 1: boot sector is executing (col 0)
    85 00000024 B231                        mov dl, '1'
    86 00000026 E8D9FF                      call dbg16
    87                                  
    88                                      ; ---- load kernel from disk ----
    89                                      ; The kernel is ~117 sectors (160 with headroom) - more than a floppy
    90                                      ; track (18) and more than some BIOSes accept in one INT 13h call, so a
    91                                      ; single-shot read fails with 'E' right after checkpoint '1' (that's the
    92                                      ; "1E" screen). Fix: check for INT 13h extensions (AH=41h) and use the
    93                                      ; LBA extended read when present; otherwise fall back to CHS. Either way
    94                                      ; read in chunks and advance the buffer. One shared loop does both: the
    95                                      ; read_mode byte picks LBA vs CHS, and the CHS path starts at LBA 0 so
    96                                      ; the boot-sector copy lands harmlessly at 0x7E00 and the kernel still
    97                                      ; begins at 0x8000.
    98 00000029 31FF                        xor di, di                  ; di = sectors read so far
    99 0000002B 66C706[F700]008000-         mov dword [read_lin], 0x8000
    99 00000033 00                 
   100 00000034 B441                        mov ah, 0x41
   101 00000036 BBAA55                      mov bx, 0x55AA
   102 00000039 8A16[F500]                  mov dl, [boot_drive]
   103 0000003D CD13                        int 0x13
   104 0000003F 720D                        jc .chs
   105 00000041 81FB55AA                    cmp bx, 0xAA55
   106 00000045 7507                        jne .chs
   107 00000047 C606[F600]42                mov byte [read_mode], 0x42  ; LBA extended read
   108 0000004C EB11                        jmp .loop
   109                                  .chs:
   110 0000004E C606[F600]02                mov byte [read_mode], 0x02  ; CHS read
   111 00000053 C706[F700]007E              mov word [read_lin], 0x7E00 ; boot-sector copy lands here, kernel at 0x8000
   112 00000059 B500                        mov ch, 0                   ; cylinder
   113 0000005B B600                        mov dh, 0                   ; head
   114 0000005D B101                        mov cl, 1                   ; start at sector 1 of track 0
   115                                  .loop:
   116 0000005F B8DC05                      mov ax, KERNEL_SECTORS
   117 00000062 29F8                        sub ax, di
   118 00000064 7476                        jz read_done                ; everything loaded
   119 00000066 803E[F600]02                cmp byte [read_mode], 0x02
   120 0000006B 750A                        jne .ext_size
   121 0000006D 83F812                      cmp ax, 18                  ; CHS: one full track at a time
   122 00000070 760D                        jbe .have_size
   123 00000072 B81200                      mov ax, 18
   124 00000075 EB08                        jmp .have_size
   125                                  .ext_size:
   126 00000077 83F83F                      cmp ax, 63                  ; LBA: keep calls small for picky BIOSes
   127 0000007A 7603                        jbe .have_size
   128 0000007C B83F00                      mov ax, 63
   129                                  .have_size:
   130 0000007F A3[FE00]                    mov [dap_count], ax
   131 00000082 E88700                      call dap_set_buf
   132 00000085 803E[F600]42                cmp byte [read_mode], 0x42
   133 0000008A 7417                        je .ext_issue
   134 0000008C 8E06[0201]                  mov es, [dap_seg]
   135 00000090 8B1E[0001]                  mov bx, [dap_off]
   136 00000094 A0[FE00]                    mov al, [dap_count]
   137 00000097 B402                        mov ah, 0x02                ; BIOS read sectors
   138 00000099 8A16[F500]                  mov dl, [boot_drive]
   139 0000009D CD13                        int 0x13
   140 0000009F 7248                        jc disk_error
   141 000000A1 EB13                        jmp .advance
   142                                  .ext_issue:
   143 000000A3 89F8                        mov ax, di
   144 000000A5 40                          inc ax                      ; lba = 1 + sectors_done (fits 16 bits)
   145 000000A6 A3[0401]                    mov [dap_lba], ax
   146 000000A9 BE[FC00]                    mov si, dap
   147 000000AC 8A16[F500]                  mov dl, [boot_drive]
   148 000000B0 B442                        mov ah, 0x42                ; BIOS extended read
   149 000000B2 CD13                        int 0x13
   150 000000B4 7233                        jc disk_error
   151                                  .advance:
   152 000000B6 A1[FE00]                    mov ax, [dap_count]
   153 000000B9 01C7                        add di, ax
   154 000000BB 660FB7C0                    movzx eax, ax
   155 000000BF 66C1E009                    shl eax, 9                  ; sectors * 512
   156 000000C3 660106[F700]                add [read_lin], eax
   157 000000C8 803E[F600]42                cmp byte [read_mode], 0x42
   158 000000CD 7490                        je .loop
   159 000000CF FEC6                        inc dh                      ; CHS: next head, then next cylinder
   160 000000D1 80FE02                      cmp dh, 2
   161 000000D4 7289                        jb .loop
   162 000000D6 30F6                        xor dh, dh
   163 000000D8 FEC5                        inc ch
   164 000000DA EB83                        jmp .loop
   165                                  
   166                                  read_done:
   167 000000DC BB0200                      mov bx, 2                   ; checkpoint 2: kernel sectors read OK (col 1)
   168 000000DF B232                        mov dl, '2'
   169 000000E1 E81EFF                      call dbg16
   170                                  
   171                                      ; ---- hand off to kernel.bin, STILL IN REAL MODE ----
   172                                      ; kernel.bin now opens with its own small 16-bit stub (see kernel.asm's
   173                                      ; splash_stub) that shows the boot splash (mode 13h) while BIOS INT 10h/
   174                                      ; INT 16h are still available, then does the A20/GDT/protected-mode/
   175                                      ; long-mode transition itself and finally jumps into kernel_entry. That
   176                                      ; transition code used to live here in boot.asm; it moved to kernel.asm
   177                                      ; so the splash can run before it, and so this sector - already tight -
   178                                      ; doesn't have to grow to fit "set mode 13h, load palette, blit image,
   179                                      ; wait for key, restore text mode" as well as the transition.
   180                                      ; A far jump (not a near jump) so cs:ip is set explicitly to 0000:8000,
   181                                      ; matching KERNEL_LOAD_SEG:KERNEL_LOAD_OFF exactly.
   182 000000E4 EA00800000                  jmp KERNEL_LOAD_SEG:KERNEL_LOAD_OFF
   183                                  
   184                                  disk_error:
   185 000000E9 BB0200                      mov bx, 2                   ; 'E' at col 1 (same spot '2' would use): a real
   186 000000EC B245                        mov dl, 'E'                 ; disk error (carry set), not a hang in INT 13h
   187 000000EE E811FF                      call dbg16
   188 000000F1 FA                          cli
   189 000000F2 F4                          hlt
   190 000000F3 EBFE                    .hang: jmp .hang
   191                                  
   192 000000F5 00                      boot_drive: db 0
   193 000000F6 00                      read_mode: db 0                 ; 0x42 = LBA read, 0x02 = CHS read
   194 000000F7 00800000                read_lin: dd 0x8000              ; linear address of the next free kernel buffer byte
   195                                  
   196                                  ; ---- Disk Address Packet for INT 13h AH=42h (LBA extended read) ----
   197                                  ; Kernel starts right after the boot sector: MBR is LBA 0, so the kernel's
   198                                  ; first sector is LBA 1 (equivalent to the old CHS "cylinder 0, head 0,
   199                                  ; sector 2"). count/off/seg/lba are updated by the chunked reader.
   200 000000FB 90                      ALIGN 4
   201                                  dap:
   202 000000FC 10                          db 0x10                      ; packet size (16 bytes)
   203 000000FD 00                          db 0                         ; reserved
   204                                  dap_count:
   205 000000FE DC05                        dw KERNEL_SECTORS            ; number of sectors to transfer
   206                                  dap_off:
   207 00000100 0080                        dw KERNEL_LOAD_OFF           ; transfer buffer offset
   208                                  dap_seg:
   209 00000102 0000                        dw KERNEL_LOAD_SEG           ; transfer buffer segment
   210                                  dap_lba:
   211 00000104 0100000000000000            dq 1                         ; starting LBA (sector right after MBR)
   212                                  
   213                                  ; ---- turn the 32-bit linear buffer pointer (read_lin) into a 16-bit
   214                                  ; real-mode seg:off pair, since the kernel buffer grows past the 64K
   215                                  ; segment boundary when reading 160 sectors ----
   216                                  dap_set_buf:
   217 0000010C 66A1[F700]                  mov eax, [read_lin]
   218 00000110 6689C2                      mov edx, eax
   219 00000113 6683E00F                    and eax, 0xF
   220 00000117 A3[0001]                    mov [dap_off], ax
   221 0000011A 66C1EA04                    shr edx, 4
   222 0000011E 8916[0201]                  mov [dap_seg], dx
   223 00000122 C3                          ret
   224                                  
   225                                  ; ============================================================
   226                                  ; pad boot sector to 512 bytes, boot signature
   227                                  ; ============================================================
   228 00000123 00<rep DBh>             TIMES 510 - ($ - $$) db 0
   229 000001FE 55AA                    DW 0xAA55
